@page
@model IndexModel
@{
    ViewData["Title"] = "Đăng nhập - Nhà Trọ Bà 5";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng nhập - Nhà Trọ Bà 5</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="~/js/Login.js"></script>
  <style>
    /* =============================================
       BIẾN TOÀN CỤC
       ============================================= */
    :root {
      --xanh:        #1a73e8;
      --xanh-dam:    #0d47a1;
      --xanh-nhat:   #e8f0fe;
      --cam:         #f97316;
      --cam-nhat:    #fff7ed;
      --den:         #1e293b;
      --xam-chu:     #64748b;
      --xam-nen:     #f1f5f9;
      --trang:       #ffffff;
      --vien:        #e2e8f0;
      --bo-goc:      10px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--xam-nen);
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* =============================================
       KHUNG 2 CỘT
       ============================================= */
    .layout {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }

    /* =============================================
       CỘT TRÁI
       ============================================= */
    .col-left {
      flex: 1.1;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      min-height: 100vh;
    }

    .bg-img {
      position: absolute;
      inset: 0;
      background-image: url('');
      background-size: cover;
      background-position: center;
      background-color: #1a3a6e;
    }

    .overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(13,71,161,.55) 0%, rgba(10,30,70,.84) 100%);
    }

    .grid-decor {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    .brand {
      position: absolute;
      top: 32px; left: 36px;
      display: flex; align-items: center; gap: 12px;
      z-index: 10;
    }

    .brand-logo {
      width: 48px; height: 48px;
      border-radius: 12px;
      object-fit: cover;
      background: var(--trang);
      box-shadow: 0 4px 16px rgba(0,0,0,.25);
    }

    .brand-name { display: flex; flex-direction: column; }
    .brand-main  { font-size: 17px; font-weight: 800; color: #fff; letter-spacing: .5px; }
    .brand-sub   { font-size: 11px; color: rgba(255,255,255,.7); font-weight: 400; letter-spacing: 1.5px; text-transform: uppercase; }

    .intro {
      position: relative;
      z-index: 10;
      padding: 0 40px 44px;
    }

    .badge-status {
      display: inline-flex; align-items: center; gap: 7px;
      background: rgba(249,115,22,.15);
      border: 1px solid rgba(249,115,22,.4);
      color: #fdba74;
      font-size: 11.5px; font-weight: 600;
      padding: 6px 14px; border-radius: 20px;
      letter-spacing: 1px; text-transform: uppercase;
      margin-bottom: 16px;
    }

    .dot-live {
      width: 7px; height: 7px;
      background: #4ade80;
      border-radius: 50%;
      animation: blink 1.5s infinite;
    }
    @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    .intro-title {
      font-size: clamp(26px, 3vw, 38px);
      font-weight: 700; color: #fff;
      line-height: 1.25; margin-bottom: 14px;
    }
    .intro-title span { color: #93c5fd; }

    .intro-desc {
      font-size: 14px;
      color: rgba(255,255,255,.75);
      line-height: 1.7;
      margin-bottom: 28px;
      max-width: 400px;
    }

    .img-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 28px;
    }

    .img-cell {
      position: relative;
      border-radius: var(--bo-goc);
      overflow: hidden;
      aspect-ratio: 4/3;
      background: rgba(255,255,255,.1);
      border: 1.5px solid rgba(255,255,255,.15);
      cursor: pointer;
      transition: transform .2s, box-shadow .2s;
    }
    .img-cell:hover { transform: scale(1.03); box-shadow: 0 8px 24px rgba(0,0,0,.3); }

    .img-cell-1 { background-image: url(''); background-size: cover; background-position: center; }
    .img-cell-2 { background-image: url(''); background-size: cover; background-position: center; }
    .img-cell-3 { background-image: url(''); background-size: cover; background-position: center; }

    .img-cell img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; object-position: center; display: block;
    }

    .img-label {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,.7));
      color: #fff;
      font-size: 11px; font-weight: 600;
      padding: 18px 10px 7px;
      letter-spacing: .3px;
    }

    .stats { display: flex; gap: 24px; }
    .stat  { display: flex; flex-direction: column; gap: 2px; }
    .stat-num  { font-size: 24px; font-weight: 800; color: #fff; }
    .stat-text { font-size: 11px; color: rgba(255,255,255,.6); text-transform: uppercase; letter-spacing: .8px; }
    .stat-divider { width: 1px; background: rgba(255,255,255,.2); align-self: stretch; margin: 4px 0; }

    /* =============================================
       CỘT PHẢI — Form đăng nhập
       ============================================= */
    .col-right {
      flex: 0.9;
      display: flex; align-items: center; justify-content: center;
      padding: 40px 32px;
      background: var(--trang);
      position: relative;
      overflow-y: auto;
      min-height: 100vh;
    }

    .decor-tr {
      position: absolute; top: 0; right: 0;
      width: 180px; height: 180px;
      background: radial-gradient(circle at top right, var(--xanh-nhat) 0%, transparent 70%);
      pointer-events: none;
    }

    .decor-bl {
      position: absolute; bottom: 0; left: 0;
      width: 140px; height: 140px;
      background: radial-gradient(circle at bottom left, var(--cam-nhat) 0%, transparent 70%);
      pointer-events: none;
    }

    .form-box {
      width: 100%; max-width: 420px;
      position: relative; z-index: 10;
    }

    .form-header { margin-bottom: 28px; }
    .form-eyebrow {
      font-size: 12.5px; font-weight: 600;
      color: var(--xanh); letter-spacing: 1.5px;
      text-transform: uppercase; margin-bottom: 7px;
    }
    .form-title  { font-size: 28px; font-weight: 700; color: var(--den); line-height: 1.2; margin-bottom: 7px; }
    .form-desc   { font-size: 13.5px; color: var(--xam-chu); line-height: 1.6; }

    /* =============================================
       THÔNG BÁO (id="thong-bao") — dùng cho JS
       ============================================= */
    .thong-bao {
      padding: 11px 15px;
      border-radius: 8px;
      font-size: 13px;
      display: none;               /* JS sẽ set display:'flex' */
      margin-bottom: 16px;
      align-items: center;
      gap: 8px;
      border: 1px solid;
    }

    /* Kiểu: lỗi */
    .thong-bao.loi {
      background: #fef2f2;
      border-color: #fecaca;
      color: #dc2626;
    }

    /* Kiểu: thành công */
    .thong-bao.thanh-cong {
      background: #f0fdf4;
      border-color: #bbf7d0;
      color: #16a34a;
    }

    /* Kiểu: cảnh báo */
    .thong-bao.canh-bao {
      background: #fffbeb;
      border-color: #fde68a;
      color: #d97706;
    }

    /* Icon SVG bên trong thông báo */
    .thong-bao-icon {
      flex-shrink: 0;
      display: flex; align-items: center;
    }
    .thong-bao-icon svg {
      width: 16px; height: 16px;
      stroke: currentColor; stroke-width: 2;
      fill: none; stroke-linecap: round; stroke-linejoin: round;
    }

    /* Nội dung văn bản thông báo */
    .thong-bao-text { flex: 1; line-height: 1.5; }

    /* --- Nhóm trường nhập liệu --- */
    .fields { display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px; }

    .field  { display: flex; flex-direction: column; gap: 6px; }
    .field-label { font-size: 13px; font-weight: 600; color: var(--den); }

    .input-wrap { position: relative; display: flex; align-items: center; }

    .input-icon {
      position: absolute; left: 13px;
      display: flex; align-items: center;
      color: var(--xam-chu);
      pointer-events: none;
      transition: color .2s;
    }
    .input-icon svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }

    .input {
      width: 100%;
      padding: 11px 13px 11px 42px;
      border: 1.5px solid var(--vien);
      border-radius: var(--bo-goc);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 14px; color: var(--den);
      background: var(--trang);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .input::placeholder { color: #c0cdd8; }
    .input:focus {
      border-color: var(--xanh);
      box-shadow: 0 0 0 3px rgba(26,115,232,.12);
    }
    .input:focus ~ .input-icon,
    .input-wrap:focus-within .input-icon { color: var(--xanh); }

    .has-right-icon .input { padding-right: 42px; }

    .btn-eye {
      position: absolute; right: 12px;
      background: none; border: none; cursor: pointer;
      display: flex; align-items: center;
      color: var(--xam-chu); padding: 4px;
      border-radius: 4px;
      transition: color .2s;
    }
    .btn-eye svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .btn-eye:hover { color: var(--xanh); }

    .row-opts {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 22px;
    }
    .checkbox-label {
      display: flex; align-items: center; gap: 7px;
      font-size: 13px; color: var(--xam-chu); cursor: pointer; user-select: none;
    }
    .checkbox-label input { width: 15px; height: 15px; accent-color: var(--xanh); cursor: pointer; }
    .link-forgot { font-size: 13px; color: var(--xanh); font-weight: 600; text-decoration: none; }
    .link-forgot:hover { color: var(--xanh-dam); }

    .btn-submit {
      width: 100%; padding: 13px;
      background: linear-gradient(135deg, var(--xanh), var(--xanh-dam));
      color: #fff; border: none;
      border-radius: var(--bo-goc);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 15px; font-weight: 700;
      cursor: pointer; letter-spacing: .3px;
      box-shadow: 0 4px 16px rgba(26,115,232,.35);
      transition: transform .15s, box-shadow .15s;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-submit:hover  { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(26,115,232,.45); }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit svg    { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }

    /* =============================================
       RESPONSIVE — Màn hình ≤ 900px
       ============================================= */
    @@media (max-width: 900px) {
      .layout { flex-direction: column; }
      .col-left  { min-height: 260px; flex: none; }
      .intro     { padding: 0 24px 28px; }
      .img-grid  { display: none; }
      .col-right { flex: none; min-height: auto; padding: 32px 20px 40px; }
    }
  </style>
</head>
<body>
<!-- CỘT TRÁI -->
  <div class="col-left">
    <div class="bg-img"></div>
    <div class="overlay"></div>
    <div class="grid-decor"></div>

    <div class="brand">
      <img class="brand-logo" src="/images/LogoBaNam.png" alt="Logo Nhà trọ Bà 5" />
      <div class="brand-name">
        <span class="brand-main">NHÀ TRỌ Bà 5</span>
        <span class="brand-sub">Quản lý hệ thống</span>
      </div>
    </div>

    <div class="intro">
      <div class="badge-status">
        <span class="dot-live"></span>
        Đang hoạt động · 48 phòng
      </div>

      <h1 class="intro-title">
        Quản lý nhà trọ<br />
        <span>thông minh &amp; hiện đại</span>
      </h1>

      <p class="intro-desc">
        Hệ thống quản lý phòng trọ toàn diện — theo dõi hóa đơn,
        tiếp nhận sự cố và quản lý người thuê mọi lúc, mọi nơi.
      </p>

      <div class="img-grid">
        <div class="img-cell img-cell-1">
          <img src="/images/phongkhach.png" alt="Phòng khách" />
          <div class="img-label">Phòng khách</div>
        </div>
        <div class="img-cell img-cell-2">
          <img src="/images/khubep.png" alt="Khu bếp" />
          <div class="img-label">Khu bếp</div>
        </div>
        <div class="img-cell img-cell-3">
          <img src="/images/tienich.png" alt="Tiện ích" />
          <div class="img-label">Tiện ích</div>
        </div>
      </div>

      <div class="stats">
        <div class="stat">
          <span class="stat-num">48</span>
          <span class="stat-text">Tổng phòng</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">81%</span>
          <span class="stat-text">Lấp đầy</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">4.8★</span>
          <span class="stat-text">Đánh giá</span>
        </div>
      </div>
    </div>
  </div>

  <!-- CỘT PHẢI -->
  <div class="col-right">
    <div class="decor-tr"></div>
    <div class="decor-bl"></div>

    <div class="form-box">

      <div class="form-header">
        <p class="form-eyebrow">Chào mừng trở lại</p>
        <h2 class="form-title">Đăng nhập hệ thống</h2>
        <p class="form-desc">Nhập thông tin để truy cập bảng điều khiển quản lý.</p>
      </div>

      <!--
        THÔNG BÁO — id="thong-bao" (khớp với hàm hienThiThongBao trong Login.js)
        Cấu trúc bên trong: .thong-bao-icon + .thong-bao-text (bắt buộc đúng class)
        JS sẽ set: el.className = 'thong-bao loi|thanh-cong|canh-bao'
                   el.style.display = 'flex'
      -->
      <div class="thong-bao" id="thong-bao" role="alert">
        <span class="thong-bao-icon">
          <svg viewBox="0 0 24 24"></svg>
        </span>
        <span class="thong-bao-text"></span>
      </div>

      <div class="fields">

        <!-- Tên đăng nhập — id="ten-dang-nhap" (khớp với JS) -->
        <div class="field">
          <label class="field-label" for="ten-dang-nhap">Tên đăng nhập</label>
          <div class="input-wrap">
            <input
              class="input"
              type="text"
              id="ten-dang-nhap"
              name="TenDangNhap"
              placeholder="Nhập tên đăng nhập của bạn"
              autocomplete="username"
            />
            <span class="input-icon">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            </span>
          </div>
        </div>

        <!-- Mật khẩu — id="mat-khau" (khớp với JS) -->
        <div class="field">
          <label class="field-label" for="mat-khau">Mật khẩu</label>
          <div class="input-wrap has-right-icon">
            <input
              class="input"
              type="password"
              id="mat-khau"
              name="MatKhau"
              placeholder="Nhập mật khẩu"
              autocomplete="current-password"
            />
            <span class="input-icon">
              <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <button
              class="btn-eye"
              type="button"
              id="btn-eye"
              onclick="togglePass()"
              title="Hiện/ẩn mật khẩu"
              aria-label="Hiện hoặc ẩn mật khẩu"
            >
              <svg id="eye-icon" viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

      </div>

      <div class="row-opts">
        <label class="checkbox-label">
          <input type="checkbox" name="GhiNho" />
          Ghi nhớ đăng nhập
        </label>
        <a href="#" class="link-forgot">Quên mật khẩu?</a>
      </div>

      <!-- onclick="xuLyDangNhap()" — khớp với tên hàm trong Login.js -->
      <button class="btn-submit" type="button" onclick="xuLyDangNhap()">
        <span>Đăng nhập</span>
        <svg viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>

    </div>
  </div>
<script>
    async function xuLyDangKy() {
    console.log("Hàm xuLyDangKy đã được kích hoạt!"); // Để kiểm tra xem nút có ăn hay không

    const messageDiv = document.getElementById('message');

    // Lấy dữ liệu từ các ô nhập
    const userVal = document.getElementById('username').value;
    const passVal = document.getElementById('password').value;
    const nameVal = document.getElementById('fullName').value;
    const phoneVal = document.getElementById('phone').value;
    const emailVal = document.getElementById('email').value;
    const roleVal = document.getElementById('roles').value;

    // Kiểm tra nhanh xem có bỏ trống trường bắt buộc không
    if (!userVal || !passVal || !nameVal || !phoneVal) {
        alert("Vui lòng điền đầy đủ các thông tin bắt buộc!");
        return;
    }

    const registerData = {
        username: userVal,
        passwords: passVal,
        fullName: nameVal,
        phone: phoneVal,
        email: emailVal,
        roles: roleVal
    };

    try {
        const response = await fetch('/api/Account/Register', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(registerData)
        });

        // Đọc dữ liệu trả về từ server
        const result = await response.json();

        if (response.ok) {
            // Nếu dùng hàm hiển thị thông báo cũ của bạn:
            if (typeof hienThiThongBao === "function") {
                hienThiThongBao('thanh-cong', result.message);
            } else {
                alert("Thành công: " + result.message);
            }
            document.getElementById('registerForm').reset();
        } else {
            if (typeof hienThiThongBao === "function") {
                hienThiThongBao('loi', result.message || "Đăng ký thất bại");
            } else {
                alert("Lỗi: " + (result.message || "Đăng ký thất bại"));
            }
        }
    } catch (error) {
        console.error("Lỗi kết nối:", error);
        alert("Không thể kết nối đến máy chủ. Kiểm tra lại Backend nhé!");
    }
}

    function togglePass() {
    // 1. Lấy các phần tử dựa trên ID bạn đã đặt trong HTML
    const passwordInput = document.getElementById('mat-khau');
    const eyeIcon = document.getElementById('eye-icon');

    // 2. Kiểm tra kiểu của input hiện tại
    if (passwordInput.type === 'password') {
        // Hiện mật khẩu
        passwordInput.type = 'text';
        
        // Thay đổi icon SVG thành mắt gạch chéo (ẩn)
        eyeIcon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
        `;
    } else {
        // Ẩn mật khẩu
        passwordInput.type = 'password';
        
        // Thay đổi icon SVG về lại mắt bình thường (hiện)
        eyeIcon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        `;
    }
}

// Lưu ý: Nếu bạn sử dụng type="module" trong thẻ script, 
// hãy thêm dòng này để "phơi bày" hàm ra ngoài global:
window.togglePass = togglePass;
</script>
<!-- Load file JS bên ngoài — đặt cuối body để DOM đã sẵn sàng -->
<script src="/js/Login.js"></script>

</body>
</html>
