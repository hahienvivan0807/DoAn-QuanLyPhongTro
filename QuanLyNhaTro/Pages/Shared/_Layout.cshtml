@* ================================================================
   _Layout.cshtml — Bố cục chung toàn ứng dụng Quản Lý Khu Nhà Trọ
   Bám sát model thực tế:
     - ACCOUNT      → FullName, Roles ('Admin'|'Manager'|'Tenant'), Avatar
     - DONDV        → TrangThai_DV: 'Chờ xử lý' | 'Đang xử lý' | ...
     - DIENNUOC     → TrangThaiDuyet: 0=Chờ duyệt | 1=Đã duyệt | 2=Từ chối
     - HDTHANG      → TrangThai_TT: 'Chưa đóng' | 'Chờ duyệt' | 'Quá hạn' | ...
     - THONGBAO     → DaDoc (bool), IDUser (nullable = broadcast)
     - THONGKE_TONG → snapshot thống kê tổng hợp
   ================================================================ *@
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // ── Map với ACCOUNT ──────────────────────────────────────────────
    var idUser = HttpContextAccessor.HttpContext?.Session.GetInt32("IDUser") ?? 0;
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Người dùng";
    var roles = HttpContextAccessor.HttpContext?.Session.GetString("Roles") ?? "Manager";
    var avatar = HttpContextAccessor.HttpContext?.Session.GetString("Avatar") ?? "";
    // Chữ viết tắt hiển thị khi không có avatar
    var initials = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "?";
    // Nhãn vai trò tiếng Việt (map ACCOUNT.Roles)
    var nhanVaiTro = roles switch
    {
        "Admin" => "Quản trị viên",
        "Manager" => "Quản lý",
        "Tenant" => "Khách thuê",
        _ => roles
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Nhà Trọ</title>


    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ══════════════════════════════════════════════════════
        BIẾN MÀU
        ══════════════════════════════════════════════════════ */
        :root {
        --mau-sidebar: #0d1b3e;
        --mau-sidebar-dam: #091429;
        }

        /* ══════════════════════════════════════════════════════
        SIDEBAR
        ══════════════════════════════════════════════════════ */
        #thanh-sidebar {
        width: 220px;
        min-width: 220px;
        background: linear-gradient(180deg, var(--mau-sidebar) 0%, var(--mau-sidebar-dam) 100%);
        display: flex;
        flex-direction: column;
        height: 100vh;
        position: relative;
        z-index: 100;
        box-shadow: 4px 0 24px rgba(0,0,0,.18);
        overflow-y: auto;
        transition: width .35s cubic-bezier(.4,0,.2,1), min-width .35s cubic-bezier(.4,0,.2,1);
        }

        #thanh-sidebar.an-sidebar {
        width: 0;
        min-width: 0;
        overflow: hidden;
        }

        /* ── Thu gọn ─────────────────────────────────────────── */
        .nhan-nhom {
        transition: opacity .2s ease, max-height .3s ease;
        max-height: 40px;
        overflow: hidden;
        }

        #thanh-sidebar.thu-gon .nhan-nhom {
        opacity: 0;
        max-height: 0;
        padding: 0;
        }

        .menu-item span:not(.huy-hieu-menu) {
        transition: opacity .2s ease, max-width .35s ease;
        max-width: 160px;
        overflow: hidden;
        display: inline-block;
        }

        #thanh-sidebar.thu-gon .menu-item span:not(.huy-hieu-menu) {
        opacity: 0;
        max-width: 0;
        }

        #thanh-sidebar.thu-gon .huy-hieu-menu {
        opacity: 0;
        width: 0;
        overflow: hidden;
        padding: 0;
        }

        #thanh-sidebar.thu-gon .menu-item {
        padding: 10px 0;
        justify-content: center;
        border-radius: 10px;
        margin: 2px 8px;
        }

        #thanh-sidebar.thu-gon .admin-sidebar {
        justify-content: center;
        }

        /* ── Logo ────────────────────────────────────────────── */
        .logo-sidebar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 28px 20px 24px 20px;
        border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .logo-sidebar .bieu-tuong {
        width: 60px;
        height: 60px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: transparent;
        flex-shrink: 0;
        }

        .logo-sidebar .bieu-tuong img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 10px;
        }

        .logo-sidebar .ten-logo {
        color: #fff;
        }

        .logo-sidebar .ten-logo strong {
        display: block;
        font-size: 13px;
        letter-spacing: .5px;
        }

        .logo-sidebar .ten-logo span {
        font-size: 11px;
        color: rgba(255,255,255,.45);
        }

        /* ── Nhãn nhóm ───────────────────────────────────────── */
        .nhan-nhom {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,.3);
        text-transform: uppercase;
        padding: 18px 20px 6px 20px;
        }

        /* ── Menu item ───────────────────────────────────────── */
        .menu-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 11px 20px;
        color: rgba(255,255,255,.65);
        cursor: pointer;
        border-radius: 0 30px 30px 0;
        margin: 2px 10px 2px 0;
        transition: all .2s;
        font-size: 14px;
        text-decoration: none;
        position: relative;
        }

        .menu-item i {
        width: 20px;
        text-align: center;
        font-size: 15px;
        flex-shrink: 0;
        }

        .menu-item:hover {
        background: rgba(59,130,246,.15);
        color: #fff;
        }

        .menu-item.dang-chon {
        background: linear-gradient(90deg, rgba(26,86,219,.85) 0%, rgba(59,130,246,.6) 100%);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(26,86,219,.3);
        }

        .menu-item.dang-chon::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 70%;
        width: 4px;
        background: #60a5fa;
        border-radius: 0 4px 4px 0;
        }

        /* ── Badge (map TrangThai_DV / TrangThaiDuyet / TrangThai_TT / DaDoc) ── */
        .huy-hieu-menu {
        margin-left: auto;
        background: #ef4444;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        border-radius: 20px;
        padding: 1px 7px;
        min-width: 20px;
        text-align: center;
        transition: opacity .2s ease;
        }

        .huy-hieu-menu[data-so="0"], .huy-hieu-menu:empty {
        display: none;
        }

        /* ── Admin footer ────────────────────────────────────── */
        .admin-sidebar {
        margin-top: auto;
        padding: 18px 16px;
        border-top: 1px solid rgba(255,255,255,.07);
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        }

        .admin-sidebar .anh-admin {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a56db, #60a5fa);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
        border: 2px solid rgba(255,255,255,.2);
        flex-shrink: 0;
        overflow: hidden;
        }

        .admin-sidebar .anh-admin img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        }

        .admin-sidebar .ten-admin strong {
        display: block;
        color: #fff;
        font-size: 10px;
        }

        .admin-sidebar .ten-admin span {
        color: rgba(255,255,255,.45);
        font-size: 11px;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="flex h-screen overflow-hidden bg-gray-100">


    <nav id="thanh-sidebar">

        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>


        <div class="nhan-nhom">Tổng quan</div>

        <a class="menu-item" href="/QuanLy/TrangChu">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </a>

        <div class="nhan-nhom">Quản lý</div>


        <a class="menu-item" href="/QuanLy/Phong">
            <i class="fas fa-door-open"></i>
            <span>Quản lý phòng trọ</span>
        </a>


        <a class="menu-item" href="/QuanLy/HopDong">
            <i class="fas fa-file-signature"></i>
            <span>Hợp đồng thuê phòng</span>
        </a>


        <a class="menu-item" href="/QuanLy/KhachThue">
            <i class="fas fa-users"></i>
            <span>Khách thuê</span>
        </a>

        <div class="nhan-nhom">Vận hành</div>

        <a class="menu-item" href="/QuanLy/DonDV">
            <i class="fas fa-tools"></i>
            <span>Đơn dịch vụ / Sự cố</span>
            <span id="badge-don-dv" class="huy-hieu-menu" data-so="0"></span>
        </a>


        <a class="menu-item" href="/QuanLy/DienNuoc">
            <i class="fas fa-bolt"></i>
            <span>Chỉ số điện &amp; nước</span>
            <span id="badge-dien-nuoc" class="huy-hieu-menu" data-so="0"></span>
        </a>

     
        <a class="menu-item" href="/QuanLy/HoaDon">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Hóa đơn &amp; Thu tiền</span>
            <span id="badge-hoa-don" class="huy-hieu-menu" data-so="0"></span>
        </a>


        <div class="nhan-nhom">Cài đặt</div>

        <a class="menu-item" href="/QuanLy/ConfigGia">
            <i class="fas fa-tags"></i>
            <span>Đơn giá dịch vụ</span>

        @if (roles == "Admin")
        {
            <a class="menu-item" href="/QuanLy/TaiKhoan">
                <i class="fas fa-user-cog"></i>
                <span>Tài khoản hệ thống</span>
            </a>

         
            <a class="menu-item" href="/QuanLy/PhanCongManager">
                <i class="fas fa-sitemap"></i>
                <span>Phân công quản lý</span>
            </a>
        }

        <a class="menu-item" href="/QuanLy/ThongKe">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê &amp; Báo cáo</span>
        </a>


        <a class="menu-item" href="/QuanLy/ThongBao">
            <i class="fas fa-bell"></i>
            <span>Thông báo</span>
            <span id="badge-thong-bao" class="huy-hieu-menu" data-so="0"></span>
        </a>

        {{!-- ══ Admin footer — map ACCOUNT.FullName, Roles, Avatar ══ --}}
        <div class="admin-sidebar" onclick="moThongTinAdmin()">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(avatar))
                {
                    <img src="@avatar" alt="Ảnh đại diện @fullName" />
                }
                else
                {
                    @initials
                }
            </div>
            <div class="ten-admin">
                <strong>@fullName</strong>
                <span>@nhanVaiTro</span>
            </div>
        </div>

    </nav>


    <main class="flex-1 overflow-y-auto p-6">
        @RenderBody()
    </main>


    <script>
        // ── Tự động đánh dấu menu active theo URL ─────────────────────
        (function () {
        var path = window.location.pathname.toLowerCase();
        document.querySelectorAll('#thanh-sidebar .menu-item').forEach(function (el) {
        var href = (el.getAttribute('href') || '').toLowerCase();
        if (href && path.startsWith(href)) {
        el.classList.add('dang-chon');
        }
        });
        })();

        // ── AJAX cập nhật badge — endpoint CountBadges ─────────────────
        // JSON trả về bám sát các trường model:
        //  {
        //    soDonDVChoXuLy:      DONDV.TrangThai_DV IN ('Chờ xử lý','Đang xử lý')
        //    soDienNuocChoDuyet:  DIENNUOC.TrangThaiDuyet = 0
        //    soHoaDonCanDuyet:    HDTHANG.TrangThai_TT IN ('Chờ duyệt','Quá hạn')
        //    soThongBaoChuaDoc:   THONGBAO.DaDoc = false AND (IDUser = me OR IDUser IS NULL)
        //  }
        function capNhatBadge() {
        fetch('/QuanLy/TrangChu?handler=CountBadges', {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (res) {
        if (!res.ok) { console.warn('[Badge] HTTP:', res.status); return null; }
        return res.json();
        })
        .then(function (d) {
        if (!d) return;
        function ganBadge(id, so) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = so > 0 ? so : '';
        el.dataset.so  = so;
        }
        // Map đúng tên trường từ JSON handler
        ganBadge('badge-don-dv',    d.soDonDVChoXuLy      || 0);
        ganBadge('badge-dien-nuoc', d.soDienNuocChoDuyet  || 0);
        ganBadge('badge-hoa-don',   d.soHoaDonCanDuyet    || 0);
        ganBadge('badge-thong-bao', d.soThongBaoChuaDoc   || 0);
        })
        .catch(function (err) {
        console.error('[Badge] Lỗi:', err);
        });
        }

        capNhatBadge();               // Gọi ngay khi tải trang
        setInterval(capNhatBadge, 60000); // Lặp mỗi 60 giây

        // ── Điều hướng tới trang tài khoản cá nhân ─────────────────────
        function moThongTinAdmin() {
        window.location.href = '/QuanLy/TaiKhoan/CaNhan';
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
