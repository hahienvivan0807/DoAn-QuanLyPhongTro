    <!-- =============================================
     JAVASCRIPT
============================================= -->
    <script>
        // ================================================================
        // GLOBAL STATE
        // ================================================================
        let chartDoanhThu = null;
        let chartPie      = null;
        let chartDonutP   = null;
        let chartDonutHD  = null;
        let allData       = [];   // THONGKE_DOANHTHU_THANG[]
        let tongData      = null; // THONGKE_TONG

        // ================================================================
        // INIT
        // ================================================================
        document.addEventListener('DOMContentLoaded', () => {
        khoiTaoNam();
        taiDuLieu();
        taiThongTinAdmin();
        });

        function khoiTaoNam() {
        const sel = document.getElementById('chon-nam');
        const year = new Date().getFullYear();
        for (let y = year; y >= year - 5; y--) {
        const opt = document.createElement('option');
        opt.value = y;
        opt.textContent = `Năm ${y}`;
        if (y === year) opt.selected = true;
        sel.appendChild(opt);
        }
        }

        // ================================================================
        // FETCH ADMIN INFO
        // ================================================================
        async function taiThongTinAdmin() {
        try {
        const res = await fetch('/api/thongke/admin-info');
        if (!res.ok) return;
        const d = await res.json();
        const ten  = d.fullName || 'Chủ Trọ';
        const char = ten.charAt(0).toUpperCase();
        document.getElementById('hd-ten').textContent   = ten;
        document.getElementById('hd-avatar').textContent = char;
        document.getElementById('sb-ten').textContent   = ten;
        document.getElementById('sb-avatar').textContent = char;
        } catch(e) { /* silent */ }
        }

        // ================================================================
        // LOAD ALL DATA
        // ================================================================
        async function taiDuLieu() {
        const nam = document.getElementById('chon-nam').value;
        try {
        // Fetch both endpoints in parallel
        const [resDT, resTong] = await Promise.all([
        fetch(`/api/thongke/doanh-thu?nam=${nam}`),
        fetch('/api/thongke/tong-quan')
        ]);

        if (resDT.ok)   allData   = await resDT.json();
        if (resTong.ok) tongData  = await resTong.json();

        capNhatTrangCap(tongData?.ngayCapNhat);
        renderKPI(tongData);
        renderChartDoanhThu(allData);
        renderPhaVo(allData);
        renderBang(allData);
        renderPie(allData);
        renderDonutPhong(tongData);
        renderDonutHoaDon(tongData);

        } catch(e) {
        hienToast('Lỗi', 'Không thể tải dữ liệu thống kê.', 'fail');
        }
        }

        // ================================================================
        // KPI CARDS
        // ================================================================
        function renderKPI(d) {
        if (!d) return;
        const fmt = (n) => {
        if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
        if (n >= 1_000)     return (n / 1_000).toFixed(0) + 'K';
        return n?.toLocaleString('vi-VN') ?? '0';
        };
        const pct = d.tangTruongDoanhThu ?? 0;
        const pctClass = pct >= 0 ? 'tang' : 'giam';
        const pctText  = (pct >= 0 ? '↑ +' : '↓ ') + Math.abs(pct).toFixed(1) + '% so tháng trước';

        const lapDay = d.tiLeLapDay ?? 0;
        const lapDayClass = lapDay >= 70 ? 'tang' : lapDay >= 50 ? 'trung' : 'giam';

        document.getElementById('hang-kpi').innerHTML = `
        <div class="card-kpi vang">
        <div class="kpi-icon vang"><i class="fas fa-coins"></i></div>
        <div class="kpi-so">${fmt(d.doanhThuThangNay ?? 0)}đ</div>
        <div class="kpi-nhan">Doanh thu tháng này</div>
        <span class="kpi-the ${pctClass}">${pctText}</span>
        </div>
        <div class="card-kpi xanh-bien">
        <div class="kpi-icon xanh-bien"><i class="fas fa-building"></i></div>
        <div class="kpi-so">${d.tongSoPhong ?? 0}</div>
        <div class="kpi-nhan">Tổng số phòng</div>
        <span class="kpi-the ${lapDayClass}">↑ ${lapDay.toFixed(1)}% lấp đầy</span>
        </div>
        <div class="card-kpi xanh-la">
        <div class="kpi-icon xanh-la"><i class="fas fa-door-open"></i></div>
        <div class="kpi-so">${d.phongDangThue ?? 0}</div>
        <div class="kpi-nhan">Phòng đang thuê</div>
        <span class="kpi-the tang">${d.phongConTrong ?? 0} phòng trống</span>
        </div>
        <div class="card-kpi do">
        <div class="kpi-icon do"><i class="fas fa-file-invoice-dollar"></i></div>
        <div class="kpi-so">${d.hoaDonChuaDong ?? 0}</div>
        <div class="kpi-nhan">Hóa đơn chưa đóng</div>
        <span class="kpi-the giam">${d.hoaDonQuaHan ?? 0} hóa đơn quá hạn</span>
        </div>
        <div class="card-kpi tim">
        <div class="kpi-icon tim"><i class="fas fa-tools"></i></div>
        <div class="kpi-so">${d.donDVChoXuLy ?? 0}</div>
        <div class="kpi-nhan">Đơn dịch vụ chờ xử lý</div>
        <span class="kpi-the giam">${d.donDVKhanCap ?? 0} khẩn cấp</span>
        </div>
        `;
        }

        // ================================================================
        // CHART: Bar + Line (Doanh thu & Chi phí)
        // ================================================================
        function renderChartDoanhThu(data) {
        const ctx = document.getElementById('chart-doanh-thu').getContext('2d');
        const labels = data.map(r => `T${r.thang}/${r.nam}`);
        const thu    = data.map(r => r.tongCong ?? 0);
        const chi    = data.map(r => r.chiPhiThang ?? 0);
        const loiNhuan = data.map((r,i) => (r.tongCong ?? 0) - (r.chiPhiThang ?? 0));

        if (chartDoanhThu) chartDoanhThu.destroy();
        chartDoanhThu = new Chart(ctx, {
        type: 'bar',
        data: {
        labels,
        datasets: [
        {
        label: 'Doanh thu',
        data: thu,
        backgroundColor: 'rgba(184,114,10,0.75)',
        borderColor: '#b8720a',
        borderWidth: 1.5,
        borderRadius: 6,
        borderSkipped: false,
        order: 2
        },
        {
        label: 'Chi phí',
        data: chi,
        backgroundColor: 'rgba(220,38,38,0.65)',
        borderColor: '#dc2626',
        borderWidth: 1.5,
        borderRadius: 6,
        borderSkipped: false,
        order: 3
        },
        {
        label: 'Lợi nhuận',
        data: loiNhuan,
        type: 'line',
        borderColor: '#059669',
        backgroundColor: 'rgba(5,150,105,0.12)',
        borderWidth: 2.5,
        pointBackgroundColor: '#059669',
        pointRadius: 4,
        tension: 0.4,
        fill: true,
        order: 1
        }
        ]
        },
        options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toLocaleString('vi-VN')}đ`
        }
        }
        },
        scales: {
        x: { grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { font: { size: 11 } } },
        y: {
        grid: { color: 'rgba(0,0,0,0.04)' },
        ticks: {
        font: { size: 11 },
        callback: v => v >= 1_000_000 ? (v/1_000_000).toFixed(1)+'M' : v.toLocaleString('vi-VN')
        }
        }
        }
        }
        });
        }

        // ================================================================
        // BREAKDOWN PANEL
        // ================================================================
        function renderPhaVo(data) {
        const el = document.getElementById('pha-vo-container');
        if (!data.length) { el.innerHTML = '<div class="trang-loading"><i class="fas fa-chart-bar"></i>Không có dữ liệu</div>'; return; }

        const totalPhong = data.reduce((s,r) => s + (r.tongTienPhong ?? 0), 0);
        const totalDien  = data.reduce((s,r) => s + (r.tongTienDien  ?? 0), 0);
        const totalNuoc  = data.reduce((s,r) => s + (r.tongTienNuoc  ?? 0), 0);
        const totalDV    = data.reduce((s,r) => s + (r.tongTienDV    ?? 0), 0);
        const totalThu   = data.reduce((s,r) => s + (r.tongCong      ?? 0), 0);
        const totalChi   = data.reduce((s,r) => s + (r.chiPhiThang   ?? 0), 0);
        const loiNhuan   = totalThu - totalChi;

        const fmt = n => n.toLocaleString('vi-VN');
        const pct = (n, t) => t > 0 ? ((n/t)*100).toFixed(1) : '0.0';
        const w   = (n, t) => t > 0 ? Math.round((n/t)*100) : 0;

        const items = [
        { ten: 'Tiền phòng',    so: totalPhong, mau: '#b8720a', dot: '#b8720a' },
        { ten: 'Tiền điện',     so: totalDien,  mau: '#2563eb', dot: '#2563eb' },
        { ten: 'Tiền nước',     so: totalNuoc,  mau: '#0891b2', dot: '#0891b2' },
        { ten: 'Dịch vụ khác', so: totalDV,    mau: '#7c3aed', dot: '#7c3aed' },
        ];

        let html = items.map(it => `
        <div class="dong-pha-vo">
        <span class="dot-pv" style="background:${it.dot};box-shadow:0 0 0 3px ${it.dot}33;"></span>
        <span class="ten-pv">${it.ten}</span>
        <div class="bar-pv-wrap">
        <div class="bar-pv-fill" style="width:${w(it.so,totalThu)}%;background:${it.mau};"></div>
        </div>
        <span class="so-pv" style="color:${it.mau};">${fmt(it.so)}đ</span>
        </div>
        `).join('');

        html += `
        <div class="tong-ket-box">
        <div>
        <div class="nhan">Lợi nhuận tích lũy (năm)</div>
        <div style="font-size:10.5px;color:rgba(255,255,255,0.6);margin-top:2px;">
        Thu: ${fmt(totalThu)}đ · Chi: ${fmt(totalChi)}đ
        </div>
        </div>
        <div class="so">${fmt(loiNhuan)}đ ${loiNhuan >= 0 ? '↑' : '↓'}</div>
        </div>
        `;
        el.innerHTML = html;
        }

        // ================================================================
        // TABLE
        // ================================================================
        function renderBang(data) {
        document.getElementById('badge-so-ban-ghi').textContent = `${data.length} bản ghi`;
        const tbody = document.getElementById('tbody-doanh-thu');
        if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:32px;color:var(--mau-chu-phu);">Không có dữ liệu cho năm đã chọn.</td></tr>`;
        return;
        }
        const fmt = n => (n ?? 0).toLocaleString('vi-VN');
        tbody.innerHTML = [...data].reverse().map(r => {
        const loiNhuan = (r.tongCong ?? 0) - (r.chiPhiThang ?? 0);
        const loiClass = loiNhuan >= 0 ? 'so-tien-xanh' : 'so-tien-do';
        return `<tr>
        <td><span class="chip-ky"><i class="fas fa-calendar-alt"></i>T${r.thang}/${r.nam}</span></td>
        <td class="so-tien-vang">${fmt(r.tongTienPhong)}đ</td>
        <td>${fmt(r.tongTienDien)}đ</td>
        <td>${fmt(r.tongTienNuoc)}đ</td>
        <td>${fmt(r.tongTienDV)}đ</td>
        <td class="so-tien-xanh" style="font-weight:800;">${fmt(r.tongCong)}đ</td>
        <td class="so-tien-do">${fmt(r.chiPhiThang)}đ</td>
        <td class="${loiClass}" style="font-weight:800;">${fmt(loiNhuan)}đ</td>
        <td><span style="background:#dcfce7;color:#16a34a;padding:2px 9px;border-radius:9999px;font-size:11px;font-weight:700;">${r.soHoaDonDaDong ?? 0} HĐ</span></td>
        </tr>`;
        }).join('');
        }

        // ================================================================
        // PIE CHART: Revenue structure
        // ================================================================
        function renderPie(data) {
        if (!data.length) return;
        const totalPhong = data.reduce((s,r) => s + (r.tongTienPhong ?? 0), 0);
        const totalDien  = data.reduce((s,r) => s + (r.tongTienDien  ?? 0), 0);
        const totalNuoc  = data.reduce((s,r) => s + (r.tongTienNuoc  ?? 0), 0);
        const totalDV    = data.reduce((s,r) => s + (r.tongTienDV    ?? 0), 0);
        const total      = totalPhong + totalDien + totalNuoc + totalDV;

        const items = [
        { ten: 'Tiền phòng',    val: totalPhong, mau: '#b8720a' },
        { ten: 'Tiền điện',     val: totalDien,  mau: '#2563eb' },
        { ten: 'Tiền nước',     val: totalNuoc,  mau: '#0891b2' },
        { ten: 'Dịch vụ khác', val: totalDV,    mau: '#7c3aed' },
        ];

        const ctx = document.getElementById('chart-pie').getContext('2d');
        if (chartPie) chartPie.destroy();
        chartPie = new Chart(ctx, {
        type: 'doughnut',
        data: {
        labels: items.map(i => i.ten),
        datasets: [{ data: items.map(i => i.val), backgroundColor: items.map(i => i.mau), borderWidth: 2, borderColor: '#fff' }]
        },
        options: {
        responsive: true,
        cutout: '68%',
        plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed.toLocaleString('vi-VN')}đ` } }
        }
        }
        });

        // Custom legend
        document.getElementById('legend-pie').innerHTML = items.map(it => {
        const p = total > 0 ? ((it.val/total)*100).toFixed(1) : '0.0';
        return `<div class="dong-legend">
        <span class="dot-legend" style="background:${it.mau};"></span>
        <span class="ten-legend">${it.ten}</span>
        <span class="so-legend" style="color:${it.mau};">${p}%</span>
        </div>`;
        }).join('');
        }

        // ================================================================
        // DONUT: Room status
        // ================================================================
        function renderDonutPhong(d) {
        if (!d) return;
        const vals  = [d.phongDangThue ?? 0, d.phongConTrong ?? 0, d.phongDangSua ?? 0];
        const maus  = ['#2563eb', '#059669', '#d97706'];
        const labels= ['Đang thuê', 'Còn trống', 'Đang sửa'];
        const total = vals.reduce((a,b) => a+b, 0);

        const ctx = document.getElementById('chart-donut-phong').getContext('2d');
        if (chartDonutP) chartDonutP.destroy();
        chartDonutP = new Chart(ctx, {
        type: 'doughnut',
        data: { labels, datasets: [{ data: vals, backgroundColor: maus, borderWidth: 2, borderColor: '#fff' }] },
        options: { responsive: false, cutout: '68%', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed}` } } } }
        });

        document.getElementById('legend-phong').innerHTML = labels.map((l,i) => `
        <div class="dong-legend">
        <span class="dot-legend" style="background:${maus[i]};"></span>
        <span class="ten-legend">${l}</span>
        <span class="so-legend">${vals[i]}</span>
        <span class="phan-tram-legend">${total > 0 ? ((vals[i]/total)*100).toFixed(0) : 0}%</span>
        </div>
        `).join('');
        }

        // ================================================================
        // DONUT: Invoice status
        // ================================================================
        function renderDonutHoaDon(d) {
        if (!d) return;
        const vals  = [d.hoaDonChuaDong ?? 0, d.hoaDonSapDenHan ?? 0, d.hoaDonQuaHan ?? 0];
        const maus  = ['#059669', '#d97706', '#dc2626'];
        const labels= ['Chưa đóng (còn hạn)', 'Sắp đến hạn', 'Quá hạn'];
        const total = vals.reduce((a,b) => a+b, 0);

        const ctx = document.getElementById('chart-donut-hoadon').getContext('2d');
        if (chartDonutHD) chartDonutHD.destroy();
        chartDonutHD = new Chart(ctx, {
        type: 'doughnut',
        data: { labels, datasets: [{ data: vals, backgroundColor: maus, borderWidth: 2, borderColor: '#fff' }] },
        options: { responsive: false, cutout: '68%', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed}` } } } }
        });

        document.getElementById('legend-hoadon').innerHTML = labels.map((l,i) => `
        <div class="dong-legend">
        <span class="dot-legend" style="background:${maus[i]};"></span>
        <span class="ten-legend">${l}</span>
        <span class="so-legend">${vals[i]}</span>
        <span class="phan-tram-legend">${total > 0 ? ((vals[i]/total)*100).toFixed(0) : 0}%</span>
        </div>
        `).join('');
        }

        // ================================================================
        // HELPERS
        // ================================================================
        function capNhatTrangCap(dt) {
        const el = document.getElementById('txt-cap-nhat');
        if (dt) {
        const d = new Date(dt);
        el.textContent = `Cập nhật lần cuối: ${d.toLocaleString('vi-VN')}`;
        } else {
        el.textContent = 'Dữ liệu thời gian thực từ hệ thống';
        }
        }

        function dongMoSidebar() {
        document.getElementById('thanh-sidebar').classList.toggle('an');
        }

        // Export to CSV
        function xuatCSV() {
        if (!allData.length) { hienToast('Thông báo', 'Không có dữ liệu để xuất.', 'fail'); return; }
        const header = ['Kỳ','Tiền phòng','Tiền điện','Tiền nước','Dịch vụ','Tổng thu','Chi phí','Lợi nhuận','HĐ đã đóng'];
        const rows = allData.map(r => [
        `T${r.thang}/${r.nam}`, r.tongTienPhong, r.tongTienDien, r.tongTienNuoc,
        r.tongTienDV, r.tongCong, r.chiPhiThang,
        (r.tongCong ?? 0) - (r.chiPhiThang ?? 0), r.soHoaDonDaDong
        ]);
        const csv = [header, ...rows].map(r => r.join(',')).join('\n');
        const blob = new Blob(['\uFEFF'+csv], { type: 'text/csv;charset=utf-8;' });
        const url  = URL.createObjectURL(blob);
        const a    = Object.assign(document.createElement('a'), { href: url, download: `thongke_${document.getElementById('chon-nam').value}.csv` });
        a.click(); URL.revokeObjectURL(url);
        hienToast('Thành công', 'Đã xuất file CSV.', 'success');
        }

        // Toast notification
        function hienToast(tieu, msg, loai = 'success') {
        const container = document.getElementById('toastContainer');
        const icons = { success: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#639922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>', fail: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' };
        const div = document.createElement('div');
        div.className = `toast toast-${loai}`;
        div.innerHTML = `<div class="toast-icon-wrap">${icons[loai]}</div><div class="toast-body"><div class="toast-title">${tieu}</div><div class="toast-msg">${msg}</div></div><div class="toast-progress" style="animation-duration:3.5s;"></div>`;
        container.appendChild(div);
        requestAnimationFrame(() => div.classList.add('show'));
        setTimeout(() => { div.classList.add('hide'); setTimeout(() => div.remove(), 260); }, 3500);
        }
    </script>
</body>
</html>
