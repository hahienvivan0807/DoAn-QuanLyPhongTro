                            </th>
                            <th class="nt-col-coc">Tiền cọc</th>
                            <th class="nt-col-hd" onclick="ntSapXep('NgayKetThuc')">
                                Hạn HĐ
                                <i class="fas fa-sort nt-sort-icon" id="sort-NgayKetThuc"></i>
                            </th>
                            <th class="nt-col-trangthai">Trạng thái</th>
                            <th class="nt-col-action">Thao tác</th>
                        </tr>
