@page
@model QuanLyNhaTro.Pages.Admin.QuanLyNguoiThueModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quản Lý Người Thuê – Chủ Trọ</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/ChuTro.css" />
  <link rel="stylesheet" href="/css/QuanLyNguoiThue.css" />
  <script src="/js/ChuTro/ChuTro-ThongBao.js"></script>
  <script src="/js/ChuTro/ChuTro-core.js"></script>
  <script src="/js/ChuTro/ChuTro-quanLy.js"></script>
  <script src="/js/ChuTro/ChuTro-bieuDo.js"></script>
  <script src="/js/ChuTro/ChuTro-cauHinh.js"></script>
  <script src="/js/ChuTro/ChuTro-pheDuyet.js"></script>
  <script src="/js/ChuTro/ChuTro-NguoiThue.js"></script>
  <script src="/js/ChuTro/ChuTro-suaChua.js"></script>
  <script src="/js/ChuTro/QuanLyNguoiThue.js"></script>
  <style>
    @@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap');

    /* =========================================================
       BIẾN MÀU & THIẾT KẾ TOÀN CỤC (from ChuTro)
    ========================================================= */
    :root {
      --mau-chu-de:         #b8720a;
      --mau-chu-de-sang:    #e8971c;
      --mau-chu-de-nhat:    #fdf6e3;
      --mau-chu-de-vien:    rgba(184,114,10,0.15);
      --mau-sidebar:        #0d1b2e;
      --mau-sidebar-dam:    #081020;
      --mau-sidebar-vien:   rgba(255,255,255,0.06);
      --mau-sidebar-hover:  rgba(232,151,28,0.12);
      --mau-sidebar-active: rgba(232,151,28,0.18);
      --mau-nen:            #f0f2f8;
      --mau-nen-card:       #f8f9fd;
      --mau-trang:          #ffffff;
      --mau-chu:            #111827;
      --mau-chu-phu:        #6b7a99;
      --mau-vien:           #e5e9f5;
      --mau-xanh:           #0ea271;
      --mau-xanh-nhat:      #ecfdf5;
      --mau-do:             #e53e3e;
      --mau-do-nhat:        #fff5f5;
      --mau-xanh-bien:      #2563eb;
      --mau-xanh-bien-nhat: #eff6ff;
      --bong-card:          0 2px 12px rgba(13,27,46,0.06), 0 1px 3px rgba(13,27,46,0.04);
      --bong-card-hover:    0 8px 28px rgba(184,114,10,0.14), 0 2px 8px rgba(13,27,46,0.08);
      --bong-sidebar:       6px 0 32px rgba(0,0,0,0.3);
      --bong-header:        0 1px 0 var(--mau-vien), 0 2px 16px rgba(13,27,46,0.04);
      --radius-sm:   8px;
      --radius-md:   12px;
      --radius-lg:   16px;
      --radius-xl:   20px;
      --radius-full: 9999px;
      --white:      var(--mau-trang);
      --border:     var(--mau-vien);
      --bg:         var(--mau-nen);
      --text:       var(--mau-chu);
      --muted:      var(--mau-chu-phu);
      --purple:     #7c3aed;
      --purple-dk:  #5b21b6;
      --purple-pale:#f5f3ff;
      --gold:       var(--mau-chu-de);
      --gold-l:     var(--mau-chu-de-sang);
      --gold-pale:  var(--mau-chu-de-nhat);
      --gold-border:var(--mau-chu-de-vien);
      --r:          var(--radius-sm);
      --r-full:     var(--radius-full);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--mau-nen);
      color: var(--mau-chu);
      display: flex;
      height: 100vh;
      overflow: clip;
      -webkit-font-smoothing: antialiased;
    }

    /* =========================================================
       SIDEBAR
    ========================================================= */
    #thanh-sidebar {
      width: 248px; min-width: 248px;
      background: var(--mau-sidebar);
      display: flex; flex-direction: column;
      height: 100vh; z-index: 100;
      box-shadow: var(--bong-sidebar);
      overflow-y: auto;
      transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
      position: relative;
      border-right: 1px solid rgba(255,255,255,0.04);
    }
    #thanh-sidebar.an { width: 0; min-width: 0; overflow: hidden; }
    .ten-logo, .thong-tin-chu-tro .ten-chu {
      transition: opacity 0.2s, max-width 0.35s;
      max-width: 160px; overflow: hidden;
    }
    .nhan-nhom-menu { transition: opacity 0.2s, max-height 0.3s; }
    #thanh-sidebar.thu-gon .nhan-nhom-menu { opacity: 0; max-height: 0; padding: 0; }
    .muc-menu span:not(.huy-hieu) {
      transition: opacity 0.2s, max-width 0.35s;
      max-width: 160px; overflow: hidden; display: inline-block;
    }
    #thanh-sidebar.thu-gon .muc-menu span:not(.huy-hieu) { opacity: 0; max-width: 0; }
    #thanh-sidebar.thu-gon .huy-hieu { opacity: 0; width: 0; overflow: hidden; padding: 0; }
    #thanh-sidebar.thu-gon .muc-menu { padding: 10px 0; justify-content: center; border-radius: 10px; margin: 2px 8px; width: calc(100% - 12px); }
    #thanh-sidebar.thu-gon .thong-tin-chu-tro { justify-content: center; }
    #thanh-sidebar.thu-gon .muc-menu i { width: auto; font-size: 16px; }
    #thanh-sidebar::-webkit-scrollbar { width: 0; }

    .khu-vuc-logo {
      display: flex; align-items: center; gap: 12px;
      padding: 24px 20px 20px;
      border-bottom: 1px solid var(--mau-sidebar-vien);
    }
    .bieu-tuong-logo {
      width: 40px; height: 40px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; color: #fff;
      box-shadow: 0 4px 14px rgba(184,114,10,0.45);
    }
    .ten-logo strong { display: block; color: #fff; font-size: 13.5px; font-weight: 800; letter-spacing: 0.2px; }
    .ten-logo span   { font-size: 10px; color: rgba(255,255,255,0.32); letter-spacing: 0.3px; }

    .nhan-nhom-menu {
      font-size: 9px; font-weight: 800; letter-spacing: 2px;
      color: rgba(255,255,255,0.22);
      text-transform: uppercase;
      padding: 18px 20px 6px;
    }

    .muc-menu {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 14px 9px 16px;
      color: rgba(255,255,255,0.52);
      cursor: pointer;
      border-radius: 0 var(--radius-full) var(--radius-full) 0;
      margin: 1px 12px 1px 0;
      transition: all 0.18s ease;
      font-size: 13px; font-weight: 500;
      text-decoration: none; position: relative;
    }
    .muc-menu i { width: 18px; text-align: center; font-size: 13px; opacity: 0.75; flex-shrink: 0; transition: opacity 0.18s; }
    .muc-menu:hover { background: var(--mau-sidebar-hover); color: rgba(255,255,255,0.9); }
    .muc-menu:hover i { opacity: 1; }
    .muc-menu.dang-chon { background: var(--mau-sidebar-active); color: #fff; font-weight: 700; }
    .muc-menu.dang-chon i { opacity: 1; color: var(--mau-chu-de-sang); }
    .muc-menu.dang-chon::before {
      content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      height: 60%; width: 3px; background: var(--mau-chu-de-sang); border-radius: 0 3px 3px 0;
    }

    .huy-hieu {
      margin-left: auto; background: rgba(239,68,68,0.85); color: #fff;
      font-size: 9.5px; font-weight: 800; border-radius: var(--radius-full);
      padding: 2px 7px; min-width: 18px; text-align: center;
    }
    .huy-hieu.vang { background: var(--mau-chu-de); }

    .thong-tin-chu-tro {
      margin-top: auto; padding: 14px 16px;
      border-top: 1px solid var(--mau-sidebar-vien);
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; flex-shrink: 0;
      position: sticky; bottom: 0;
      background: var(--mau-sidebar-dam); z-index: 1;
      transition: background 0.18s;
    }
    .thong-tin-chu-tro:hover { background: rgba(255,255,255,0.04); }
    .anh-chu-tro {
      width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 800;
    }
    .ten-chu strong { display: block; color: #fff; font-size: 12.5px; font-weight: 700; }
    .ten-chu span   { color: rgba(255,255,255,0.35); font-size: 10px; }

    /* =========================================================
       KHU VỰC CHÍNH
    ========================================================= */
    #khu-vuc-chinh { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    #thanh-header {
      background: var(--mau-trang); padding: 0 28px; height: 62px;
      display: flex; align-items: center; justify-content: space-between;
      box-shadow: var(--bong-header); flex-shrink: 0; z-index: 50;
    }
    .header-trai { display: flex; align-items: center; gap: 14px; }
    .nut-ham-burger {
      background: none; border: none; cursor: pointer;
      font-size: 18px; color: var(--mau-chu-phu);
      padding: 8px; border-radius: var(--radius-sm); transition: all 0.2s;
      display: flex; align-items: center; justify-content: center;
    }
    .nut-ham-burger:hover { background: var(--mau-chu-de-nhat); color: var(--mau-chu-de); }
    .tieu-de-header { font-size: 14.5px; font-weight: 800; color: var(--mau-chu); font-family: 'Lexend', sans-serif; }
    .duong-dan-header { font-size: 11px; color: var(--mau-chu-phu); margin-top: 1px; }
    .header-phai { display: flex; align-items: center; gap: 10px; }

    .o-tim-kiem {
      display: flex; align-items: center; gap: 8px;
      background: var(--mau-nen); border: 1.5px solid var(--mau-vien);
      border-radius: var(--radius-full); padding: 7px 16px; transition: all 0.2s;
    }
    .o-tim-kiem:focus-within { border-color: var(--mau-chu-de); background: #fff; box-shadow: 0 0 0 3px var(--mau-chu-de-vien); }
    .o-tim-kiem input { border: none; background: none; outline: none; font-size: 12.5px; width: 170px; color: var(--mau-chu); font-family: inherit; }
    .o-tim-kiem input::placeholder { color: var(--mau-chu-phu); }
    .o-tim-kiem i { color: var(--mau-chu-phu); font-size: 12px; }

    .nut-chuong {
      position: relative; background: none; border: none;
      cursor: pointer; font-size: 16px; color: var(--mau-chu-phu);
      padding: 8px; border-radius: var(--radius-full); transition: all 0.2s;
      display: flex; align-items: center; justify-content: center;
      width: 38px; height: 38px;
    }
    .nut-chuong:hover { background: var(--mau-chu-de-nhat); color: var(--mau-chu-de); }
    .so-chuong {
      position: absolute; top: 2px; right: 2px;
      background: var(--mau-do); color: #fff;
      font-size: 8.5px; font-weight: 800; border-radius: var(--radius-full);
      width: 15px; height: 15px;
      display: flex; align-items: center; justify-content: center;
      border: 2px solid #fff;
    }

    .the-chu-tro {
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
      color: #fff; font-size: 9.5px; font-weight: 800;
      padding: 3px 10px; border-radius: var(--radius-full);
      letter-spacing: 0.8px; text-transform: uppercase;
    }

    .khoi-admin-header {
      display: flex; align-items: center; gap: 9px;
      cursor: pointer; padding: 5px 10px; border-radius: var(--radius-full);
      transition: background 0.2s; position: relative;
    }
    .khoi-admin-header:hover { background: var(--mau-chu-de-nhat); }
    .anh-dai-dien-header {
      width: 34px; height: 34px; border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 13px; font-weight: 800;
    }
    .ten-admin-header { font-size: 12.5px; font-weight: 700; }
    .vai-tro-header { font-size: 10px; color: var(--mau-chu-phu); }
    .header-divider { width: 1px; height: 22px; background: var(--mau-vien); margin: 0 2px; }

    /* Admin dropdown */
    .admin-dropdown {
      position: absolute; top: calc(100% + 10px); right: 0; width: 240px;
      background: var(--mau-trang); border-radius: 14px;
      border: 1px solid var(--mau-vien);
      box-shadow: 0 8px 32px rgba(13,27,46,0.12), 0 2px 8px rgba(13,27,46,0.06);
      z-index: 999; transform-origin: top right;
      transform: scale(0.92) translateY(-8px); opacity: 0; pointer-events: none;
      transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1), opacity 0.15s ease;
    }
    .admin-dropdown.show { transform: scale(1) translateY(0); opacity: 1; pointer-events: all; }
    .add-header { padding: 14px 16px 12px; border-bottom: 1px solid var(--mau-vien); display: flex; align-items: center; gap: 10px; }
    .add-header-avatar {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 800;
    }
    .add-header-name { font-size: 13px; font-weight: 700; color: var(--mau-chu); }
    .add-header-email { font-size: 11px; color: var(--mau-chu-phu); margin-top: 2px; }
    .add-header-badge {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 9.5px; font-weight: 800; letter-spacing: 0.4px;
      padding: 2px 8px; border-radius: var(--radius-full); margin-top: 4px;
      background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang)); color: #fff;
    }
    .add-body { padding: 6px; }
    .add-item {
      display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: 9px;
      cursor: pointer; transition: background 0.14s; border: none; background: none;
      width: 100%; font-family: inherit; text-align: left;
    }
    .add-item:hover { background: var(--mau-nen); }
    .add-item-icon { width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; }
    .add-item-icon.vang { background: var(--mau-chu-de-nhat); color: var(--mau-chu-de); }
    .add-item-icon.do   { background: var(--mau-do-nhat); color: var(--mau-do); }
    .add-item-label { font-size: 13px; font-weight: 700; color: var(--mau-chu); }
    .add-item-sub   { font-size: 10.5px; color: var(--mau-chu-phu); margin-top: 1px; }
    .add-item.danger:hover { background: var(--mau-do-nhat); }
    .add-item.danger:hover .add-item-label { color: var(--mau-do); }
    .add-divider { height: 1px; background: var(--mau-vien); margin: 4px 0; }

    /* =========================================================
       NỘI DUNG CHÍNH
    ========================================================= */
    #noi-dung-chinh {
      flex: 1; overflow-y: auto; padding: 24px 28px 32px;
    }
    #noi-dung-chinh::-webkit-scrollbar { width: 5px; }
    #noi-dung-chinh::-webkit-scrollbar-track { background: transparent; }
    #noi-dung-chinh::-webkit-scrollbar-thumb { background: #d4d9e6; border-radius: 3px; }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d4d9e6; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #b0b9ce; }

    @@media (max-width: 768px) {
      #thanh-sidebar { width: 0; min-width: 0; overflow: hidden; }
      #thanh-sidebar.mo { width: 248px; min-width: 248px; }
    }

    /* =========================================================
       QUẢN LÝ NGƯỜI THUÊ — CSS CONTENT
    ========================================================= */
    .nt-page-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 22px; flex-wrap: wrap; gap: 14px;
    }
    .nt-page-title { display: flex; align-items: center; gap: 14px; }
    .nt-page-icon {
      width: 48px; height: 48px; border-radius: var(--radius-md);
      background: linear-gradient(135deg, #0891b2, #06b6d4);
      display: flex; align-items: center; justify-content: center;
      font-size: 19px; color: #fff; flex-shrink: 0;
      box-shadow: 0 6px 18px rgba(8,145,178,0.28);
    }
    .nt-page-heading {
      font-family: 'Lexend', sans-serif; font-size: 20px; font-weight: 900;
      color: var(--mau-chu); letter-spacing: -0.3px; margin: 0;
    }
    .nt-page-desc { font-size: 12px; color: var(--mau-chu-phu); margin: 3px 0 0; }
    .nt-btn-primary {
      background: linear-gradient(135deg, #0891b2, #06b6d4); color: #fff;
      border: none; border-radius: var(--radius-md); padding: 10px 20px;
      font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 4px 14px rgba(8,145,178,0.3); transition: all 0.2s; white-space: nowrap;
    }
    .nt-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(8,145,178,0.42); }
    .nt-btn-primary:active { transform: translateY(0); }

    .nt-kpi-row {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 14px; margin-bottom: 20px;
    }
    .nt-kpi-card {
      background: var(--mau-trang); border-radius: var(--radius-lg);
      padding: 18px 20px 14px; box-shadow: var(--bong-card);
      border: 1.5px solid transparent;
      display: flex; align-items: center; gap: 14px;
      position: relative; overflow: hidden; transition: all 0.22s ease;
    }
    .nt-kpi-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0;
      height: 3px; border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .nt-kpi-card:hover { transform: translateY(-3px); box-shadow: var(--bong-card-hover); }
    .nt-kpi-icon-wrap {
      width: 44px; height: 44px; border-radius: 11px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .nt-kpi-body { flex: 1; display: flex; flex-direction: column; }
    .nt-kpi-num { font-family: 'Lexend', sans-serif; font-size: 26px; font-weight: 900; line-height: 1; color: var(--mau-chu); }
    .nt-kpi-label { font-size: 11.5px; color: var(--mau-chu-phu); margin-top: 4px; font-weight: 600; }
    .nt-kpi-trend { position: absolute; top: 12px; right: 14px; font-size: 10px; font-weight: 700; display: flex; align-items: center; gap: 4px; }

    .nt-kpi-green::before { background: linear-gradient(90deg, #059669, #34d399); }
    .nt-kpi-green { border-color: rgba(5,150,105,0.12); }
    .nt-kpi-green .nt-kpi-icon-wrap { background: #ecfdf5; color: #059669; }
    .nt-kpi-green .nt-kpi-trend { color: #059669; }

    .nt-kpi-blue::before { background: linear-gradient(90deg, #0891b2, #22d3ee); }
    .nt-kpi-blue { border-color: rgba(8,145,178,0.12); }
    .nt-kpi-blue .nt-kpi-icon-wrap { background: #ecfeff; color: #0891b2; }
    .nt-kpi-blue .nt-kpi-trend { color: #0891b2; }

    .nt-kpi-gold::before { background: linear-gradient(90deg, var(--mau-chu-de), var(--mau-chu-de-sang)); }
    .nt-kpi-gold { border-color: var(--mau-chu-de-vien); }
    .nt-kpi-gold .nt-kpi-icon-wrap { background: var(--mau-chu-de-nhat); color: var(--mau-chu-de); }
    .nt-kpi-gold .nt-kpi-trend { color: var(--mau-chu-de); }

    .nt-kpi-gray::before { background: linear-gradient(90deg, #9ca3af, #d1d5db); }
    .nt-kpi-gray { border-color: rgba(156,163,175,0.12); }
    .nt-kpi-gray .nt-kpi-icon-wrap { background: #f3f4f6; color: #9ca3af; }
    .nt-kpi-gray .nt-kpi-trend { color: #9ca3af; }

    .nt-toolbar {
      background: var(--mau-trang); border-radius: var(--radius-md);
      padding: 12px 16px; margin-bottom: 16px; box-shadow: var(--bong-card);
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .nt-search-box {
      display: flex; align-items: center; gap: 8px;
      background: var(--mau-nen); border: 1.5px solid var(--mau-vien);
      border-radius: var(--radius-full); padding: 8px 14px;
      flex: 1; min-width: 220px; max-width: 300px;
      transition: all 0.2s; position: relative;
    }
    .nt-search-box:focus-within { border-color: #06b6d4; background: #fff; box-shadow: 0 0 0 3px rgba(6,182,212,0.1); }
    .nt-search-ico { color: var(--mau-chu-phu); font-size: 12px; flex-shrink: 0; }
    .nt-search-inp { border: none; background: none; outline: none; font-size: 13px; color: var(--mau-chu); font-family: inherit; flex: 1; min-width: 0; }
    .nt-search-inp::placeholder { color: var(--mau-chu-phu); }
