              <i class="fas fa-calendar-check"></i>
              <input class="nt-inp" type="date" id="og-inp-ngay-vao" />
            </div>
            <div class="nt-err" id="og-err-ngay-vao"></div>
          </div>

          <div class="nt-field">
            <label class="nt-lbl">Quan hệ với chủ phòng</label>
            <select class="nt-inp" id="og-inp-quan-he">
              <option value="">-- Chọn quan hệ --</option>
              <option value="Bạn bè">Bạn bè</option>
              <option value="Anh/Em">Anh / Em</option>
              <option value="Vợ/Chồng">Vợ / Chồng</option>
              <option value="Đồng nghiệp">Đồng nghiệp</option>
              <option value="Khác">Khác</option>
            </select>
          </div>

          <div class="nt-field full">
            <label class="nt-lbl">Ghi chú</label>
            <textarea class="nt-inp" id="og-inp-ghi-chu" rows="2"
                      placeholder="Ghi chú thêm về người ở ghép..."
                      maxlength="500"></textarea>
          </div>

        </div>
      </div><!-- /og-buoc-3 -->

    </div><!-- /og-modal-body -->

    <!-- Footer -->
    <div class="nt-modal-ft">
      <div class="nt-ft-note">
        <span id="og-step-label-ft" style="color:var(--mau-chu-phu);font-size:12px;">
          Bước 1 / 3 — Chọn phòng
        </span>
      </div>
      <div class="nt-ft-btns">
        <button class="nt-btn-cancel" onclick="oGhep.dongModal()">
          <i class="fas fa-times"></i> Hủy
        </button>
        <button class="nt-btn-cancel" id="og-btn-back"
                onclick="oGhep.buocTruoc()" style="display:none;">
          <i class="fas fa-arrow-left"></i> Quay lại
        </button>
        <button class="og-btn-next" id="og-btn-next" onclick="oGhep.buocTiep()">
          Tiếp theo <i class="fas fa-arrow-right"></i>
        </button>
        <button class="nt-btn-submit" id="og-btn-submit"
                onclick="oGhep.luuNguoiOGhep()" style="display:none;
                background:linear-gradient(135deg,#7c3aed,#9333ea);
                box-shadow:0 4px 12px rgba(124,58,237,0.28);">
          <i class="fas fa-check"></i> Thêm người ở ghép
        </button>
      </div>
    </div>

  </div>
</div><!-- /og-modal-overlay -->


<!-- ════════════════════════════════════════════════════════════
     MODAL: ROOM PICKER cho người ở ghép
════════════════════════════════════════════════════════════ -->
<div class="nt-overlay" id="og-picker-overlay" onclick="oGhep.dongPickerNeuClick(event)">
  <div class="nt-modal" id="og-picker-box" style="max-width:620px;">

    <div class="nt-modal-hd">
      <div class="nt-modal-hd-left">
        <div class="nt-modal-hd-icon"
             style="background:linear-gradient(135deg,#7c3aed,#9333ea);">
          <i class="fas fa-door-open"></i>
        </div>
        <div>
          <h3 class="nt-modal-title">Chọn phòng đang thuê</h3>
          <p class="nt-modal-sub">Chọn phòng cần thêm người ở ghép</p>
        </div>
      </div>
      <button class="nt-modal-close-btn" onclick="oGhep.dongPicker()">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <!-- Picker toolbar -->
    <div style="padding:12px 20px;border-bottom:1px solid var(--mau-vien);
                display:flex;gap:10px;flex-wrap:wrap;background:#fafbfd;flex-shrink:0;">
      <div class="nt-search-box" style="flex:1;min-width:160px;max-width:none;">
        <i class="fas fa-search nt-search-ico"></i>
        <input type="text" id="og-picker-search" class="nt-search-inp"
               placeholder="Tìm số phòng..." oninput="oGhep.locPicker()" />
      </div>
      <div class="nt-select-wrap">
        <i class="fas fa-circle-dot nt-sel-ico"></i>
        <select class="nt-select" id="og-picker-filter-tt"
                onchange="oGhep.locPicker()" style="min-width:160px;">
          <option value="">Tất cả trạng thái</option>
          <option value="Trống">Phòng trống</option>
          <option value="Đã thuê" selected>Đang có người thuê</option>
          <option value="Đang sửa">Đang sửa chữa</option>
        </select>
      </div>
    </div>

    <!-- Picker content -->
    <div class="nt-modal-body" style="padding:14px 16px;">
      <div id="og-picker-loading"
           style="display:flex;align-items:center;gap:10px;padding:32px;
                  justify-content:center;color:var(--mau-chu-phu);font-size:13px;">
        <div class="nt-spinner"></div> Đang tải...
      </div>

      <!-- Room grid -->
      <div id="og-picker-grid"
           style="display:none;display:grid;
                  grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:10px;">
      </div>

      <!-- Empty state -->
      <div id="og-picker-empty" style="display:none;text-align:center;
           padding:40px 16px;color:var(--mau-chu-phu);">
        <div style="font-size:36px;margin-bottom:10px;"><i class="fas fa-door-closed"></i></div>
        <div style="font-weight:700;font-size:13.5px;color:var(--mau-chu);margin-bottom:4px;">
          Không tìm thấy phòng
        </div>
        <div style="font-size:12px;">Thử thay đổi bộ lọc trạng thái</div>
      </div>
    </div>

    <div class="nt-modal-ft" style="justify-content:flex-end;">
      <button class="nt-btn-cancel" onclick="oGhep.dongPicker()">
        <i class="fas fa-times"></i> Đóng
      </button>
    </div>
  </div>
</div>
<!-- MODAL: Tạo HĐ mới cho người ở ghép -->
<div class="nt-overlay" id="ng-ghep-hd-overlay" onclick="if(event.target===this)ngGhep_dongModalHD()">
  <div class="nt-modal nt-modal-confirm" id="ng-ghep-hd-modal" style="max-width:520px;">

    <div class="nt-modal-hd">
      <div class="nt-modal-hd-left">
        <div class="nt-modal-hd-icon" style="background:linear-gradient(135deg,#059669,#34d399);">
          <i class="fas fa-file-contract"></i>
        </div>
        <div>
          <h3 class="nt-modal-title">Tạo hợp đồng mới</h3>
          <p class="nt-modal-sub">
            Người thuê: <strong id="ng-ghep-hd-ten"></strong> —
            <span id="ng-ghep-hd-phong"></span>
          </p>
        </div>
      </div>
      <button class="nt-modal-close-btn" onclick="ngGhep_dongModalHD()">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="nt-modal-body">
      <div class="nt-form-grid">

        <div class="nt-field">
          <label class="nt-lbl">Ngày bắt đầu <span class="req">*</span></label>
          <input class="nt-inp" type="date" id="ng-ghep-hd-ngay-bat-dau" />
        </div>

        <div class="nt-field">
          <label class="nt-lbl">Ngày kết thúc</label>
          <input class="nt-inp" type="date" id="ng-ghep-hd-ngay-ket-thuc" />
          <span class="nt-hint">Để trống nếu không xác định</span>
        </div>

        <div class="nt-field">
          <label class="nt-lbl">Giá thuê (đ)</label>
          <div class="nt-inp-unit-wrap">
            <input class="nt-inp" type="number" id="ng-ghep-hd-gia"
                   min="0" step="100000" />
            <span class="nt-unit">đ</span>
          </div>
          <span class="nt-hint">Mặc định theo giá phòng hiện tại</span>
        </div>

        <div class="nt-field">
          <label class="nt-lbl">Tiền cọc (đ)</label>
          <div class="nt-inp-unit-wrap">
            <input class="nt-inp" type="number" id="ng-ghep-hd-tien-coc"
                   min="0" step="100000" placeholder="0" />
            <span class="nt-unit">đ</span>
          </div>
        </div>

        <div class="nt-field">
          <label class="nt-lbl">Chỉ số điện đầu kỳ</label>
          <div class="nt-inp-unit-wrap">
            <input class="nt-inp" type="number" id="ng-ghep-hd-dien" min="0" placeholder="0" />
            <span class="nt-unit">kWh</span>
          </div>
        </div>

        <div class="nt-field">
          <label class="nt-lbl">Chỉ số nước đầu kỳ</label>
          <div class="nt-inp-unit-wrap">
            <input class="nt-inp" type="number" id="ng-ghep-hd-nuoc" min="0" placeholder="0" />
            <span class="nt-unit">m³</span>
          </div>
        </div>

        <div class="nt-field full">
          <label class="nt-lbl">Ghi chú</label>
          <textarea class="nt-inp" id="ng-ghep-hd-ghi-chu" rows="2"
                    placeholder="Ghi chú hợp đồng..." maxlength="500"></textarea>
        </div>

      </div>
    </div>

    <div class="nt-modal-ft">
      <div class="nt-ft-note"><span>*</span> Trường bắt buộc</div>
      <div class="nt-ft-btns">
        <button class="nt-btn-cancel" onclick="ngGhep_dongModalHD()">
          <i class="fas fa-times"></i> Hủy
        </button>
        <button class="nt-btn-submit" onclick="ngGhep_luuHopDong()"
                style="background:linear-gradient(135deg,#059669,#34d399);
                       box-shadow:0 4px 12px rgba(5,150,105,0.28);">
          <i class="fas fa-check"></i> Tạo hợp đồng
        </button>
      </div>
    </div>

  </div>
</div>
@await Html.PartialAsync("ModalChung")
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
