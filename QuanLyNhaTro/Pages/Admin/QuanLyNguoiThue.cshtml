        <!-- PHẦN 4B — DẠNG THẺ (GRID VIEW) -->
        <div class="nt-grid-wrap" id="nt-view-grid" style="display:none;">
            <div class="nt-grid" id="nt-grid-body">
                <!-- Render bằng JS -->
            </div>
        </div>

        <!-- PHẦN 5 — PHÂN TRANG -->
        <div class="nt-paging-bar" id="nt-pagination">
            <div class="nt-paging-info" id="nt-page-info">
                Hiển thị <strong>0</strong> trong <strong>0</strong> người thuê
            </div>
            <div class="nt-paging-btns" id="nt-page-btns">
                <!-- Render bằng JS -->
            </div>
        </div>

    </div><!-- /section-nguoi-thue -->

  </main><!-- /noi-dung-chinh -->

</div><!-- /khu-vuc-chinh -->


<!-- ════════════════════════════════════════════════════════════
     MODAL: THÊM / SỬA NGƯỜI THUÊ
════════════════════════════════════════════════════════════ -->
<div class="nt-overlay" id="nt-modal-overlay" onclick="ntDongModal(event)">
    <div class="nt-modal" id="nt-modal-box">

        <!-- Header -->
        <div class="nt-modal-hd">
            <div class="nt-modal-hd-left">
                <div class="nt-modal-hd-icon" id="nt-modal-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div>
                    <h3 class="nt-modal-title" id="nt-modal-tieu-de">Thêm người thuê mới</h3>
                    <p class="nt-modal-sub" id="nt-modal-mo-ta">Điền thông tin để tạo tài khoản và hồ sơ khách thuê</p>
                </div>
            </div>
            <button class="nt-modal-close-btn" onclick="ntDongModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Tabs -->
        <div class="nt-tabs" role="tablist">
            <button class="nt-tab active" data-tab="tab-co-ban" onclick="ntChuyenTab(this)" role="tab" aria-selected="true">
                <i class="fas fa-id-card"></i> Thông tin cơ bản
            </button>
            <button class="nt-tab" data-tab="tab-cu-tru" onclick="ntChuyenTab(this)" role="tab" aria-selected="false">
                <i class="fas fa-map-marker-alt"></i> Cư trú &amp; Tài khoản
            </button>
            <button class="nt-tab" data-tab="tab-phong" onclick="ntChuyenTab(this)" role="tab" aria-selected="false">
                <i class="fas fa-door-open"></i> Phòng &amp; Hợp đồng
            </button>
        </div>

        <!-- Body -->
        <div class="nt-modal-body">

            <!-- Tab 1: Thông tin cơ bản -->
            <div class="nt-tab-panel active" id="tab-co-ban" role="tabpanel">

                <!-- Avatar upload -->
                <div class="nt-avatar-zone">
                    <div class="nt-avatar-preview" id="nt-avatar-preview">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <label class="nt-btn-upload" for="inp-anh-chan-dung">
                            <i class="fas fa-camera"></i> Chọn ảnh đại diện
                        </label>
                        <input type="file" id="inp-anh-chan-dung" accept="image/*"
                               style="display:none;" onchange="ntXemTruocAnh(this)" />
                        <p class="nt-upload-note">JPG, PNG tối đa 2 MB</p>
                    </div>
                </div>

                <div class="nt-form-grid">
                    <div class="nt-field full">
                        <label class="nt-lbl">Họ và tên <span class="req">*</span></label>
                        <input class="nt-inp" type="text" id="inp-ho-ten"
                               placeholder="VD: Nguyễn Văn An" maxlength="100" />
                        <div class="nt-err" id="err-ho-ten"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Số điện thoại <span class="req">*</span></label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-phone"></i>
                            <input class="nt-inp" type="tel" id="inp-so-dien-thoai"
                                   placeholder="0912 345 678" maxlength="15" />
                        </div>
                        <div class="nt-err" id="err-so-dien-thoai"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Email</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-envelope"></i>
                            <input class="nt-inp" type="email" id="inp-email"
                                   placeholder="VD: nguyenvanan@gmail.com" maxlength="100" />
                        </div>
                        <div class="nt-err" id="err-email"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Ngày sinh</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-birthday-cake"></i>
                            <input class="nt-inp" type="date" id="inp-ngay-sinh" />
                        </div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Giới tính</label>
                        <select class="nt-inp" id="inp-gioi-tinh">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="nt-field" id="field-trang-thai" style="display:none;">
                        <label class="nt-lbl">Trạng thái cư trú</label>
                        <select class="nt-inp" id="inp-trang-thai" onchange="ntThayDoiTrangThai(this.value)">
                            <option value="dang-o">🟢 Đang ở</option>
                            <option value="da-roi">⚫ Rời đi</option>
                        </select>
                        <div id="canh-bao-trang-thai" style="display:none; margin-top:8px;">
                            <div class="nt-confirm-alert" style="font-size:12px;">
                                <i class="fas fa-triangle-exclamation"></i>
                                <span>Chuyển sang <strong>Rời đi</strong> sẽ: khóa tài khoản, kết thúc hợp đồng và đặt phòng về <strong>Trống</strong>.</span>
                            </div>
                        </div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Số CCCD / CMND</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-id-card"></i>
                            <input class="nt-inp" type="text" id="inp-so-cccd"
                                   placeholder="VD: 079123456789" maxlength="20" />
                        </div>
                        <div class="nt-err" id="err-so-cccd"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Ngày cấp CCCD</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-calendar-alt"></i>
                            <input class="nt-inp" type="date" id="inp-ngay-cap-cccd" />
                        </div>
                    </div>

                    <div class="nt-field full">
                        <label class="nt-lbl">Nơi cấp CCCD</label>
                        <input class="nt-inp" type="text" id="inp-noi-cap-cccd"
                               placeholder="VD: Cục Cảnh sát QLHC về TTXH" maxlength="200" />
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Nghề nghiệp</label>
                        <input class="nt-inp" type="text" id="inp-nghe-nghiep"
                               placeholder="VD: Sinh viên, Nhân viên văn phòng..." maxlength="100" />
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Tên người liên hệ khẩn</label>
                        <input class="nt-inp" type="text" id="inp-lien-he-khan"
                               placeholder="VD: Nguyễn Thị Mẹ" maxlength="100" />
                    </div>

                    <div class="nt-field full">
                        <label class="nt-lbl">SĐT khẩn</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-phone-volume"></i>
                            <input class="nt-inp" type="tel" id="inp-sdt-khan"
                                   placeholder="0901 234 567" maxlength="15" />
                        </div>
                    </div>
                </div>
            </div><!-- /tab-co-ban -->

            <!-- Tab 2: Cư trú & Tài khoản -->
            <div class="nt-tab-panel" id="tab-cu-tru" role="tabpanel">
                <div class="nt-form-grid">

                    <!-- Địa chỉ thường trú -->
                    <div class="nt-section-divider full">
                        <i class="fas fa-map-marker-alt"></i> Địa chỉ thường trú
                    </div>

                    <div class="nt-field full">
                        <label class="nt-lbl">Địa chỉ đầy đủ</label>
                        <textarea class="nt-inp" id="inp-dia-chi" rows="2"
                                  placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"
                                  maxlength="300"></textarea>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Tỉnh / Thành phố</label>
                        <input class="nt-inp" type="text" id="inp-tinh-thanh"
                               placeholder="VD: TP. Cần Thơ" maxlength="100" />
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Quê quán</label>
                        <input class="nt-inp" type="text" id="inp-que-quan"
                               placeholder="VD: An Giang" maxlength="200" />
                    </div>

                    <div class="nt-field full">
                        <label class="nt-lbl">Ghi chú</label>
                        <textarea class="nt-inp" id="inp-ghi-chu" rows="3"
                                  placeholder="Ghi chú thêm về khách thuê..."
                                  maxlength="500"></textarea>
                    </div>

                    <!-- Tài khoản đăng nhập -->
                    <div class="nt-section-divider full">
                        <i class="fas fa-key"></i> Tài khoản đăng nhập
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Tên đăng nhập <span class="req">*</span></label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-at"></i>
                            <input class="nt-inp" type="text" id="inp-username"
                                   placeholder="VD: nguyenvanan" maxlength="50" />
                        </div>
                        <div class="nt-err" id="err-username"></div>
                        <span class="nt-hint">Dùng để đăng nhập app người thuê</span>
                    </div>

                    <div class="nt-field" id="field-password">
                        <label class="nt-lbl">Mật khẩu <span class="req">*</span></label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-lock"></i>
                            <input class="nt-inp" type="password" id="inp-password"
                                   placeholder="Tối thiểu 6 ký tự" maxlength="100" />
                            <button type="button" class="nt-pw-toggle"
                                    onclick="ntTogglePw('inp-password', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="nt-err" id="err-password"></div>
                    </div>
                </div>
            </div><!-- /tab-cu-tru -->

            <!-- Tab 3: Phòng & Hợp đồng -->
            <div class="nt-tab-panel" id="tab-phong" role="tabpanel">
                <div class="nt-form-grid">
                    <div class="nt-field">
                        <label class="nt-lbl">Ngày vào ở <span class="req">*</span></label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-calendar-check"></i>
                            <input class="nt-inp" type="date" id="inp-ngay-vao-o" />
                        </div>
                        <div class="nt-err" id="err-ngay-vao-o"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Phòng <span class="req">*</span></label>
                        <select class="nt-inp" id="inp-id-phong" onchange="ntXemTruocPhong(this.value)">
                            <option value="">-- Chọn phòng trống --</option>
                        </select>
                        <div class="nt-err" id="err-id-phong"></div>
                        <span class="nt-hint">Chỉ hiện phòng đang trống</span>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Tiền cọc ban đầu</label>
                        <div class="nt-inp-unit-wrap">
                            <input class="nt-inp" type="number" id="inp-tien-coc"
                                   placeholder="VD: 3000000" min="0" step="100000" />
                            <span class="nt-unit">đ</span>
                        </div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Ngày hết hạn hợp đồng</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-calendar-times"></i>
                            <input class="nt-inp" type="date" id="inp-ngay-ket-thuc" />
                        </div>
                        <span class="nt-hint">Để trống nếu không xác định thời hạn</span>
                    </div>

                    <div class="nt-field" id="field-dien-dau-ky">
                        <label class="nt-lbl">Chỉ số điện đầu kỳ</label>
                        <div class="nt-inp-unit-wrap">
                            <input class="nt-inp" type="number" id="inp-dien-dau-ky"
                                   placeholder="VD: 1250" min="0" />
                            <span class="nt-unit">kWh</span>
                        </div>
                    </div>

                    <div class="nt-field"  id="field-nuoc-dau-ky">
                        <label class="nt-lbl">Chỉ số nước đầu kỳ</label>
                        <div class="nt-inp-unit-wrap">
                            <input class="nt-inp" type="number" id="inp-nuoc-dau-ky"
                                   placeholder="VD: 300" min="0" />
                            <span class="nt-unit">m³</span>
                        </div>
                    </div>
                    <div class="nt-field" id="field-trang-thai-hd" style="display:none;">
                        <label class="nt-lbl">Trạng thái hợp đồng</label>
                        <div class="nt-inp" id="hien-thi-trang-thai-hd" 
                       style="background:var(--mau-nen);cursor:default;"></div>
                    </div>

                    <div class="nt-field full">
                        <label class="nt-lbl">Ghi chú hợp đồng</label>
                        <textarea class="nt-inp" id="inp-ghi-chu-hd" rows="2"
                                  placeholder="Điều khoản thêm, thỏa thuận đặc biệt..."
                                  maxlength="500"></textarea>
                    </div>
                </div>

                <!-- Preview phòng được chọn -->
                <div class="nt-room-preview" id="nt-room-preview" style="display:none;">
                    <div class="nt-rp-header">
                        <i class="fas fa-door-open"></i> Thông tin phòng đã chọn
                    </div>
                    <div class="nt-rp-grid" id="nt-rp-body"></div>
                </div>
            </div><!-- /tab-phong -->

        </div><!-- /modal-body -->

        <!-- Footer -->
        <div class="nt-modal-ft">
            <div class="nt-ft-note"><span>*</span> Trường bắt buộc</div>
            <div class="nt-ft-btns">
                <button class="nt-btn-cancel" onclick="ntDongModal()">
                    <i class="fas fa-times"></i> Hủy
                </button>
                <button class="nt-btn-submit" id="nt-btn-submit" onclick="ntLuuNguoiThue()">
                    <i class="fas fa-check"></i>
                    <span id="nt-btn-submit-label">Thêm người thuê</span>
                </button>
            </div>
        </div>

        <!-- Hidden fields -->
        <input type="hidden" id="inp-id-khach-thue" value="" />
        <input type="hidden" id="inp-id-user" value="" />
        <input type="hidden" id="nt-modal-mode" value="them" />

    </div>
</div><!-- /nt-modal-overlay -->

<!-- ════════════════════════════════════════════════════════════
     MODAL: XEM CHI TIẾT NGƯỜI THUÊ
════════════════════════════════════════════════════════════ -->
<div class="nt-overlay" id="nt-detail-overlay" onclick="ntDongModalDetail(event)">
    <div class="nt-modal nt-modal-detail" id="nt-detail-box">

        <div class="nt-modal-hd">
            <div class="nt-modal-hd-left">
                <div class="nt-modal-hd-icon nt-hd-blue">
                    <i class="fas fa-id-badge"></i>
                </div>
                <div>
                    <h3 class="nt-modal-title">Hồ sơ người thuê</h3>
                    <p class="nt-modal-sub" id="nt-detail-mo-ta">Thông tin đầy đủ</p>
                </div>
            </div>
            <button class="nt-modal-close-btn" onclick="ntDongModalDetail()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="nt-modal-body" id="nt-detail-body">
            <!-- Render bằng JS -->
        </div>

        <div class="nt-modal-ft">
            <div></div>
            <div class="nt-ft-btns">
                <button class="nt-btn-cancel" onclick="ntDongModalDetail()">Đóng</button>
                <button class="nt-btn-sua" id="nt-detail-btn-sua">
                    <i class="fas fa-edit"></i> Chỉnh sửa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     MODAL: XÁC NHẬN TRẢ PHÒNG
════════════════════════════════════════════════════════════ -->
<div class="nt-overlay" id="nt-confirm-overlay" onclick="ntDongModalXoa(event)">
    <div class="nt-modal nt-modal-confirm" id="nt-confirm-box">

        <div class="nt-modal-hd">
            <div class="nt-modal-hd-left">
                <div class="nt-modal-hd-icon nt-hd-red">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <div>
                    <h3 class="nt-modal-title" id="nt-xoa-tieu-de">Xác nhận trả phòng</h3>
                    <p class="nt-modal-sub">Hành động này không thể hoàn tác</p>
                </div>
            </div>
        </div>

        <div class="nt-modal-body">
            <div class="nt-confirm-alert">
                <i class="fas fa-triangle-exclamation"></i>
                <p id="nt-xoa-noi-dung"></p>
            </div>
            <div class="nt-field" style="margin-top:14px;">
                <label class="nt-lbl">Lý do trả phòng (tùy chọn)</label>
                <textarea class="nt-inp" id="inp-ly-do-xoa" rows="2"
                          placeholder="VD: Hết hợp đồng, chuyển nơi khác..."></textarea>
            </div>
        </div>

        <div class="nt-modal-ft">
            <div></div>
            <div class="nt-ft-btns">
                <button class="nt-btn-cancel" onclick="ntDongModalXoa()">Hủy</button>
                <button class="nt-btn-danger" id="nt-btn-confirm-xoa" onclick="ntXacNhanXoa()">
                    <i class="fas fa-check"></i> Xác nhận trả phòng
                </button>
            </div>
        </div>

        <input type="hidden" id="inp-xoa-id-khach-thue" value="" />
    </div>
</div>

<!-- Toast container -->
<div class="toast-container" id="toastContainer"></div>

<script>
  // Sidebar toggle
  function dongMoSidebar() {
    const sb = document.getElementById('thanh-sidebar');
    sb.classList.toggle('an');
  }

  // Admin dropdown toggle
  function toggleAdminMenu() {
    const dd = document.getElementById('adminDropdown');
    const ch = document.getElementById('adminChevron');
    dd.classList.toggle('show');
    ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', function(e) {
    const wrap = document.getElementById('adminHeaderWrap');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('adminDropdown').classList.remove('show');
      document.getElementById('adminChevron').style.transform = '';
    }
  });

  function moDoiMatKhau() {
    // Placeholder – implement as needed
    alert('Chức năng đổi mật khẩu');
  }
  function xacNhanDangXuat() {
    if (confirm('Bạn có chắc muốn đăng xuất?')) {
      window.location.href = '/Admin/DangXuat';
    }
  }
</script>
</body>
</html>
