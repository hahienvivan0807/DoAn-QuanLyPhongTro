@page
@model QuanLyNhaTro.Pages.Admin.QuanLyNguoiThueModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quản Lý Người Thuê – Chủ Trọ</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/ChuTro.css" />
  <link rel="stylesheet" href="/css/QuanLyNguoiThue.css" />
  <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <script src="/js/ChuTro/ChuTro-ThongBao.js"></script>
  <script src="/js/ChuTro/ChuTro-core.js"></script>
  <script src="/js/ChuTro/ChuTro-quanLy.js"></script>
  <script src="/js/ChuTro/ChuTro-bieuDo.js"></script>
  <script src="/js/ChuTro/ChuTro-cauHinh.js"></script>
  <script src="/js/ChuTro/ChuTro-pheDuyet.js"></script>
  <script src="/js/ChuTro/ChuTro-NguoiThue.js"></script>
  <script src="/js/ChuTro/ChuTro-suaChua.js"></script>
  <script src="/js/ChuTro/QuanLyNguoiThue.js"></script>
  <link rel="stylesheet" href="~/css/Admin/QuanLyNguoiThue.css" />
</head>
<body>

<!-- =============================================
     SIDEBAR – THANH ĐIỀU HƯỚNG TRÁI
============================================= -->
<nav id="thanh-sidebar">

  <!-- Logo -->
  <div class="khu-vuc-logo">
    <div class="bieu-tuong-logo">
      <i class="fas fa-crown"></i>
    </div>
    <div class="ten-logo">
      <strong>NHÀ TRỌ BÀ NĂM</strong>
      <span>Cổng Chủ Trọ</span>
    </div>
  </div>

  <!-- Nhóm: Tổng quan -->
  <div class="nhan-nhom-menu">Tổng quan</div>
  <a class="muc-menu" href="/Admin/ChuTro">
    <i class="fas fa-home"></i>
    <span>Trang chủ</span>
  </a>

  <!-- Nhóm: Vận hành -->
  <div class="nhan-nhom-menu">Vận hành</div>

  <a class="muc-menu" href="/Admin/QuanLyPhong">
    <i class="fas fa-building"></i>
    <span>Quản lý phòng trọ</span>
  </a>
    <a class="muc-menu" href="/Admin/QuanLyNguoiThue">
    <i class="fas fa-users"></i>
    <span>Người thuê</span>
   </a>
  <a class="muc-menu" href="/Admin/QuanLyHopDong">
    <i class="fas fa-file-contract"></i>
    <span>Hợp đồng</span>
    <span class="huy-hieu vang">2</span>
  </a>

  <!-- Nhóm: Quản trị chủ trọ -->
  <div class="nhan-nhom-menu">Quản trị chủ trọ</div>

  <a class="muc-menu" href="/Admin/TaiKhoanQuanLy">
    <i class="fas fa-user-shield"></i>
    <span>Tài khoản quản lý</span>
  </a>
  <!-- ACTIVE: Quản lý người thuê -->
  <a class="muc-menu dang-chon" href="/Admin/QuanLyNguoiThue">
    <i class="fas fa-users"></i>
    <span>Quản lý người thuê</span>
  </a>
<a class="muc-menu" onclick="window.location.href='/Admin/CauHinhGiaThue' ">
    <i class="fas fa-sliders-h"></i>
    <span>Cấu hình giá thuê</span>
</a>
  <a class="muc-menu" href="/Admin/DichVuThongBao">
    <i class="fas fa-bolt"></i>
    <span>Dịch vụ thông báo</span>
  </a>

  <!-- Nhóm: Hỗ trợ -->
  <div class="nhan-nhom-menu">Hỗ trợ</div>

  <a class="muc-menu" href="/Admin/SuCoBaoTri">
    <i class="fas fa-tools"></i>
    <span>Sự cố / Bảo trì</span>
            <span id="huy-hieu-sua-chua" class="huy-hieu">3</span>
  </a>
  <a class="muc-menu" href="/Admin/ThongKe">
    <i class="fas fa-chart-bar"></i>
    <span>Thống kê & Báo cáo</span>
  </a>
  <a class="muc-menu" href="/Admin/CaiDatHT">
    <i class="fas fa-cog"></i>
    <span>Cài đặt hệ thống</span>
  </a>

  <!-- Thông tin chủ trọ -->
  <div class="thong-tin-chu-tro">
    <div class="anh-chu-tro">C</div>
    <div class="ten-chu">
      <strong id="sidebar-ten-chu">Chủ Trọ</strong>
      <span>Chủ sở hữu</span>
    </div>
  </div>

</nav><!-- Kết thúc SIDEBAR -->


<!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
<div id="khu-vuc-chinh">

  <!-- HEADER -->
  <header id="thanh-header">
    <div class="header-trai">
      <button class="nut-ham-burger" onclick="dongMoSidebar()">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-header">Quản Lý Người Thuê</div>
        <div class="duong-dan-header">Trang chủ / Quản lý người thuê</div>
      </div>
    </div>

    <div class="header-phai">
      <!-- Tìm kiếm -->
      <div class="o-tim-kiem">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
      </div>

      <!-- Chuông -->
      <button class="nut-chuong">
        <i class="fas fa-bell"></i>
        <span class="so-chuong">7</span>
      </button>

      <div class="header-divider"></div>

      <!-- Tag vai trò -->
      <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ</span>

      <!-- Avatar + tên -->
      <div class="khoi-admin-header" id="adminHeaderWrap">
        <button onclick="toggleAdminMenu()" id="adminHeaderBtn"
                style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:5px 10px;border-radius:var(--radius-full);border:none;background:none;font-family:inherit;transition:background 0.2s;"
                onmouseover="this.style.background='var(--mau-chu-de-nhat)'"
                onmouseout="this.style.background='none'">
          <div class="anh-dai-dien-header" id="header-avatar-chu">C</div>
          <div>
            <div class="ten-admin-header" id="header-ten-chu">Nguyễn Văn Chủ</div>
            <div class="vai-tro-header">Chủ sở hữu</div>
          </div>
          <i class="fas fa-chevron-down" id="adminChevron"
             style="font-size:9px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>
        </button>

        <div class="admin-dropdown" id="adminDropdown">
          <div class="add-header">
            <div class="add-header-avatar" id="dd-avatar">C</div>
            <div>
              <div class="add-header-name" id="dd-ten">Nguyễn Văn Chủ</div>
              <div class="add-header-email" id="dd-email">chusonguyen@nhatrobanum.vn</div>
              <span class="add-header-badge">
                <i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ
              </span>
            </div>
          </div>
          <div class="add-body">
            <button class="add-item" onclick="moDoiMatKhau()">
              <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
              <div>
                <div class="add-item-label">Đổi mật khẩu</div>
                <div class="add-item-sub">Cập nhật mật khẩu đăng nhập</div>
              </div>
            </button>
            <div class="add-divider"></div>
            <button class="add-item danger" onclick="xacNhanDangXuat()">
              <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
              <div>
                <div class="add-item-label">Đăng xuất</div>
                <div class="add-item-sub">Thoát khỏi hệ thống</div>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- =============================================
       NỘI DUNG CHÍNH
  ============================================= -->
  <main id="noi-dung-chinh">

    <!-- ═══════════════════════════════════════════════════════════
         SECTION: QUẢN LÝ NGƯỜI THUÊ
    ═══════════════════════════════════════════════════════════ -->
    <div id="section-nguoi-thue">

        <!-- PHẦN 1 — TIÊU ĐỀ TRANG -->
        <div class="nt-page-header">
            <div class="nt-page-title">
                <div class="nt-page-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h2 class="nt-page-heading">Quản Lý Người Thuê</h2>
                    <p class="nt-page-desc">Toàn bộ khách thuê đang ở và đã rời đi trong hệ thống</p>
                </div>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <button class="nt-btn-primary" onclick="ntMoModalThem()">
                    <i class="fas fa-plus"></i>
                    Thêm người thuê
                </button>
                <button class="nt-btn-primary" id="btn-them-o-ghep"
                        onclick="oGhep.moModal()"
                        style="background:linear-gradient(135deg,#7c3aed,#9333ea);
                               box-shadow:0 4px 14px rgba(124,58,237,0.32);">
                    <i class="fas fa-user-plus"></i>
                    Thêm người ở ghép
                </button>
                <button class="nt-btn-primary" id="btn-them-co-san"
                        onclick="prompt_themNguoiCoSan()"
                        style="background:linear-gradient(135deg,#059669,#34d399);
                               box-shadow:0 4px 14px rgba(5,150,105,0.32);">
                    <i class="fas fa-user-check"></i>
                    Thêm người thuê có sẵn
                </button>
            </div>
        </div>

        <!-- PHẦN 2 — 4 KPI CARDS -->
        <div class="nt-kpi-row">
            <!-- KPI 1: Đang ở -->
            <div class="nt-kpi-card nt-kpi-green">
                <div class="nt-kpi-icon-wrap"><i class="fas fa-user-check"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-dang-o">—</span>
                    <span class="nt-kpi-label">Đang ở</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-dang-o">
                    <i class="fas fa-circle" style="font-size:7px;"></i> Hiện tại
                </div>
            </div>
            <!-- KPI 2: Phòng có người -->
            <div class="nt-kpi-card nt-kpi-blue">
                <div class="nt-kpi-icon-wrap"><i class="fas fa-door-open"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-phong">—</span>
                    <span class="nt-kpi-label">Phòng có người</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-phong">
                    <i class="fas fa-circle" style="font-size:7px;"></i> Đang thuê
                </div>
            </div>
            <!-- KPI 3: Tổng cộng -->
            <div class="nt-kpi-card nt-kpi-gold">
                <div class="nt-kpi-icon-wrap"><i class="fas fa-users"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-tong">—</span>
                    <span class="nt-kpi-label">Tổng người thuê</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-tong">
                    <i class="fas fa-circle" style="font-size:7px;"></i> Lịch sử
                </div>
            </div>
            <!-- KPI 4: Đã rời đi -->
            <div class="nt-kpi-card nt-kpi-gray">
                <div class="nt-kpi-icon-wrap"><i class="fas fa-user-slash"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-da-roi">—</span>
                    <span class="nt-kpi-label">Đã rời đi</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-roi">
                    <i class="fas fa-circle" style="font-size:7px;"></i> Trả phòng
                </div>
            </div>
        </div><!-- /nt-kpi-row -->

        <!-- PHẦN 3 — THANH CÔNG CỤ -->
        <div class="nt-toolbar">
            <!-- Search box -->
            <div class="nt-search-box">
                <i class="fas fa-search nt-search-ico"></i>
                <input type="text"
                       id="nt-search-input"
                       class="nt-search-inp"
                       placeholder="Tìm tên, SĐT, CCCD, phòng..."
                       oninput="ntLocDuLieu()" />
                <button class="nt-search-clear" id="nt-btn-clear" onclick="ntXoaSearch()" style="display:none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <!-- Bộ lọc -->
            <div class="nt-filter-group">
                <div class="nt-select-wrap">
                    <i class="fas fa-circle-dot nt-sel-ico"></i>
                    <select class="nt-select" id="nt-filter-trang-thai" onchange="ntLocDuLieu()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="dang-o">Đang ở</option>
                        <option value="sap-het-han">Sắp hết hạn HĐ</option>
                        <option value="da-roi">Đã rời đi</option>
                    </select>
                </div>
                <div class="nt-select-wrap">
                    <i class="fas fa-door-closed nt-sel-ico"></i>
                    <select class="nt-select" id="nt-filter-phong" onchange="ntLocDuLieu()">
                        <option value="">Tất cả phòng</option>
                    </select>
                </div>
                <div class="nt-select-wrap">
                    <i class="fas fa-venus-mars nt-sel-ico"></i>
                    <select class="nt-select" id="nt-filter-gioi-tinh" onchange="ntLocDuLieu()">
                        <option value="">Tất cả giới tính</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="nt-select-wrap">
                    <i class="fas fa-user-friends nt-sel-ico"></i>
                    <select class="nt-select" id="nt-filter-nguoi-ghep" onchange="ntLocDuLieu()">
                        <option value="">Tất cả loại</option>
                        <option value="co-ghep">Có người ở ghép</option>
                        <option value="khong-ghep">Không có người ghép</option>
                    </select>
                </div>
                <button class="nt-btn-reset" onclick="ntDatLaiLoc()" title="Đặt lại bộ lọc">
                    <i class="fas fa-rotate-left"></i>
                    <span>Đặt lại</span>
                </button>
            </div>
            <!-- Chuyển view -->
            <div class="nt-toolbar-right">
                <div class="nt-view-toggle" role="group" aria-label="Chọn kiểu hiển thị">
                    <button class="nt-view-btn active" id="nt-btn-view-table"
                            onclick="ntChuyenView('table')" title="Dạng bảng" aria-pressed="true">
                        <i class="fas fa-table-list"></i>
                    </button>
                    <button class="nt-view-btn" id="nt-btn-view-grid"
                            onclick="ntChuyenView('grid')" title="Dạng thẻ" aria-pressed="false">
                        <i class="fas fa-grip"></i>
                    </button>
                </div>
            </div>
        </div><!-- /nt-toolbar -->

        <!-- PHẦN 4A — BẢNG DANH SÁCH (TABLE VIEW) -->
        <div class="nt-panel" id="nt-view-table">
            <div class="nt-loading" id="nt-loading">
                <div class="nt-spinner"></div>
                <span>Đang tải dữ liệu...</span>
            </div>
            <div class="nt-table-scroll">
                <table class="nt-table" id="nt-table-main">
                    <thead>
                        <tr>
                            <th class="nt-col-stt">STT</th>
                            <th class="nt-col-khach" onclick="ntSapXep('HoTen')">
                                Khách thuê
                                <i class="fas fa-sort nt-sort-icon" id="sort-HoTen"></i>
                            </th>
                            <th class="nt-col-phong" onclick="ntSapXep('SoPhong')">
                                Phòng
                                <i class="fas fa-sort nt-sort-icon" id="sort-SoPhong"></i>
                            </th>
                            <th class="nt-col-lienhe">Liên hệ</th>
                            <th class="nt-col-ngayvao" onclick="ntSapXep('NgayVaoO')">
                                Ngày vào ở
                                <i class="fas fa-sort nt-sort-icon" id="sort-NgayVaoO"></i>
                            </th>
                            <th class="nt-col-coc">Tiền cọc</th>
                            <th class="nt-col-hd" onclick="ntSapXep('NgayKetThuc')">
                                Hạn HĐ
                                <i class="fas fa-sort nt-sort-icon" id="sort-NgayKetThuc"></i>
                            </th>
                            <th class="nt-col-trangthai">Trạng thái</th>
                            <th class="nt-col-action">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="nt-table-body">
                        <!-- Render bằng JS -->
                    </tbody>
                </table>
            </div>
            <!-- Empty state -->
            <div class="nt-empty" id="nt-empty-state" style="display:none;">
                <div class="nt-empty-icon"><i class="fas fa-users-slash"></i></div>
                <h3>Không tìm thấy người thuê nào</h3>
                <p>Thử thay đổi bộ lọc hoặc thêm người thuê mới vào hệ thống</p>
            </div>
        </div><!-- /nt-view-table -->

        <!-- PHẦN 4B — DẠNG THẺ (GRID VIEW) -->
        <div class="nt-grid-wrap" id="nt-view-grid" style="display:none;">
            <div class="nt-grid" id="nt-grid-body">
                <!-- Render bằng JS -->
            </div>
        </div>

        <!-- PHẦN 5 — PHÂN TRANG -->
        <div class="nt-paging-bar" id="nt-pagination">
            <div class="nt-paging-info" id="nt-page-info">
                Hiển thị <strong>0</strong> trong <strong>0</strong> người thuê
            </div>
            <div class="nt-paging-btns" id="nt-page-btns">
                <!-- Render bằng JS -->
            </div>
        </div>

    </div><!-- /section-nguoi-thue -->

  </main><!-- /noi-dung-chinh -->

</div><!-- /khu-vuc-chinh -->


<!-- ════════════════════════════════════════════════════════════
     MODAL: THÊM / SỬA NGƯỜI THUÊ
════════════════════════════════════════════════════════════ -->
<div class="nt-overlay" id="nt-modal-overlay">
    <div class="nt-modal" id="nt-modal-box">
        <!-- Header -->
        <div class="nt-modal-hd">
            <div class="nt-modal-hd-left">
                <div class="nt-modal-hd-icon" id="nt-modal-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div>
                    <h3 class="nt-modal-title" id="nt-modal-tieu-de">Thêm người thuê mới</h3>
                    <p class="nt-modal-sub" id="nt-modal-mo-ta">Điền thông tin để tạo tài khoản và hồ sơ khách thuê</p>
                </div>
            </div>
            <button class="nt-modal-close-btn" onclick="ntDongModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Tabs -->
        <div class="nt-tabs" role="tablist">
            <button class="nt-tab active" data-tab="tab-co-ban" onclick="ntChuyenTab(this)" role="tab" aria-selected="true">
                <i class="fas fa-id-card"></i> Thông tin cơ bản
            </button>
            <button class="nt-tab" data-tab="tab-cu-tru" onclick="ntChuyenTab(this)" role="tab" aria-selected="false">
                <i class="fas fa-map-marker-alt"></i> Cư trú &amp; Tài khoản
            </button>
            <button class="nt-tab" data-tab="tab-phong" onclick="ntChuyenTab(this)" role="tab" aria-selected="false">
                <i class="fas fa-door-open"></i> Phòng &amp; Hợp đồng
            </button>
        </div>

        <!-- Body -->
        <div class="nt-modal-body">

            <!-- Tab 1: Thông tin cơ bản -->
            <div class="nt-tab-panel active" id="tab-co-ban" role="tabpanel">

                <!-- Avatar upload -->
                <div class="nt-avatar-zone">
                    <div class="nt-avatar-preview" id="nt-avatar-preview">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <label class="nt-btn-upload" for="inp-anh-chan-dung">
                            <i class="fas fa-camera"></i> Chọn ảnh đại diện
                        </label>
                        <input type="file" id="inp-anh-chan-dung" accept="image/*"
                               style="display:none;" onchange="ntXemTruocAnh(this)" />
                        <p class="nt-upload-note">JPG, PNG tối đa 2 MB</p>
                    </div>
                </div>

                <div class="nt-form-grid">
                    <div class="nt-field full">
                        <label class="nt-lbl">Họ và tên <span class="req">*</span></label>
                        <input class="nt-inp" type="text" id="inp-ho-ten"
                               placeholder="VD: Nguyễn Văn An" maxlength="100" />
                        <div class="nt-err" id="err-ho-ten"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Số điện thoại <span class="req">*</span></label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-phone"></i>
                            <input class="nt-inp" type="tel" id="inp-so-dien-thoai"
                                   placeholder="0912 345 678" maxlength="15" />
                        </div>
                        <div class="nt-err" id="err-so-dien-thoai"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Email</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-envelope"></i>
                            <input class="nt-inp" type="email" id="inp-email"
                                   placeholder="VD: nguyenvanan@gmail.com" maxlength="100" />
                        </div>
                        <div class="nt-err" id="err-email"></div>
                    </div>

                    <div class="nt-field">
                        <label class="nt-lbl">Ngày sinh</label>
                        <div class="nt-inp-icon-wrap">
                            <i class="fas fa-birthday-cake"></i>
                            <input class="nt-inp" type="date" id="inp-ngay-sinh" />
                        </div>
