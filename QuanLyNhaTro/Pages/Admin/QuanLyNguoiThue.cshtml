                <div class="nt-kpi-icon-wrap"><i class="fas fa-users"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-tong">—</span>
                    <span class="nt-kpi-label">Tổng người thuê</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-tong">
                    <i class="fas fa-circle" style="font-size:7px;"></i> Lịch sử
                </div>
            </div>
            <!-- KPI 4: Đã rời đi -->
            <div class="nt-kpi-card nt-kpi-gray">
                <div class="nt-kpi-icon-wrap"><i class="fas fa-user-slash"></i></div>
                <div class="nt-kpi-body">
                    <span class="nt-kpi-num" id="nt-stat-da-roi">—</span>
                    <span class="nt-kpi-label">Đã rời đi</span>
                </div>
                <div class="nt-kpi-trend" id="nt-trend-roi">
