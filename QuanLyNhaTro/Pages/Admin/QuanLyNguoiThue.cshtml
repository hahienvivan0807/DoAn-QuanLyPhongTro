    .nt-detail-sub { font-size: 12.5px; color: var(--mau-chu-phu); margin-top: 4px; }
    .nt-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .nt-detail-item { background: var(--mau-nen); border-radius: var(--radius-sm); padding: 10px 13px; }
    .nt-detail-item.full { grid-column: 1 / -1; }
    .nt-detail-key { font-size: 10px; color: var(--mau-chu-phu); text-transform: uppercase; letter-spacing: 0.6px; font-weight: 700; margin-bottom: 3px; }
    .nt-detail-val { font-size: 13px; color: var(--mau-chu); font-weight: 600; }
    .nt-detail-sec { font-size: 11.5px; font-weight: 800; color: #0891b2; text-transform: uppercase; letter-spacing: 0.8px; display: flex; align-items: center; gap: 6px; padding: 12px 0 10px; border-bottom: 1px solid var(--mau-vien); margin-bottom: 12px; }

    /* Toast */
    .toast-container { position: fixed; top: 24px; right: 24px; display: flex; flex-direction: column; gap: 10px; z-index: 99999; pointer-events: none; }

    @@media (max-width: 1100px) { .nt-kpi-row { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 900px) {
      .nt-toolbar { flex-direction: column; align-items: flex-start; }
      .nt-search-box { max-width: 100%; width: 100%; }
      .nt-filter-group { width: 100%; }
      .nt-toolbar-right { margin-left: 0; }
      .nt-col-lienhe, .nt-col-coc, .nt-col-hd { display: none; }
      .nt-form-grid { grid-template-columns: 1fr; }
      .nt-detail-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 600px) {
      .nt-kpi-row { grid-template-columns: 1fr 1fr; }
      .nt-kpi-num { font-size: 22px; }
      .nt-tabs { overflow-x: auto; }
      .nt-modal { max-height: 95vh; }
      .nt-page-header { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
