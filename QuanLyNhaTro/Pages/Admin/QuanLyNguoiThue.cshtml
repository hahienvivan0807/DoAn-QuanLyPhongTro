                        <i class="fas fa-table-list"></i>
                    </button>
                    <button class="nt-view-btn" id="nt-btn-view-grid"
                            onclick="ntChuyenView('grid')" title="Dạng thẻ" aria-pressed="false">
                        <i class="fas fa-grip"></i>
                    </button>
                </div>
            </div>
        </div><!-- /nt-toolbar -->

        <!-- PHẦN 4A — BẢNG DANH SÁCH (TABLE VIEW) -->
        <div class="nt-panel" id="nt-view-table">
            <div class="nt-loading" id="nt-loading">
                <div class="nt-spinner"></div>
                <span>Đang tải dữ liệu...</span>
            </div>
