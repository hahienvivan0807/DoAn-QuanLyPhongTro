                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <button class="nt-btn-reset" onclick="ntDatLaiLoc()" title="Đặt lại bộ lọc">
                    <i class="fas fa-rotate-left"></i>
                    <span>Đặt lại</span>
                </button>
