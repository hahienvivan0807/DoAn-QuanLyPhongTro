<script>
    window.hienThiThongBao = function(noiDung, loai = 'success') {
    // Gọi ID bằng tiếng Việt
    const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
    if (!khuVucChua) return;

    // Chuyển đổi tham số type sang class tiếng Việt tương ứng
    let classMauSac = '';
    switch(loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
        case 'error': classMauSac = 'thong-bao-loi'; break;
        default: classMauSac = 'thong-bao-thanh-cong';
    }

    // Tạo phần tử DOM
    const theThongBao = document.createElement('div');
    theThongBao.className = `thong-bao-muc ${classMauSac}`;
    
    // Gắn HTML nội dung và nút X
    theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
    `;

    // Đẩy vào trang
    khuVucChua.appendChild(theThongBao);

    // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
    setTimeout(() => {
        if (theThongBao.parentNode) {
            theThongBao.remove();
        }
    }, 3000);
}
    function prompt_themNguoiCoSan() {
    _tncs_moPickerPhong();
}
async function _tncs_moPickerPhong() {
    // Show a simple confirm-style picker using the existing oGhep picker UI
    // but override the selection callback temporarily
    const overlay = document.getElementById('og-picker-overlay');
    if (!overlay) { hienToast('Không tìm thấy giao diện chọn phòng', 'error'); return; }

    // Set filter to "Đã thuê" and load
    const filterEl = document.getElementById('og-picker-filter-tt');
    if (filterEl) filterEl.value = 'Đã thuê';

    // Override _chonPhong temporarily so selecting a room opens themNguoiCoSan instead
    const _originalChon = oGhep._chonPhong.bind(oGhep);
    oGhep._chonPhong = async function(idPhong) {
        // Restore original immediately
        oGhep._chonPhong = _originalChon;

        // Find the room's active contract IDHopDong
        try {
            const res = await fetch('/api/ChuTroQuanLyNguoiThue/ds-phong-dang-thue');
            const data = await res.json();
            const phong = data.danhSach?.find(p => p.idPhong === idPhong);
            const idHopDong = phong?.hopDong?.idHopDong;
            const soPhong = phong?.soPhong || '';

            if (!idHopDong) {
                hienToast('Phòng này chưa có hợp đồng hiệu lực', 'warning');
                oGhep.dongPicker();
                return;
            }

            oGhep.dongPicker();
            // Small delay so picker closes cleanly before new modal opens
            setTimeout(() => {
                themNguoiCoSan.moModal(idHopDong, idPhong, soPhong);
            }, 200);
        } catch (e) {
            hienToast('Lỗi tải thông tin phòng', 'error');
            oGhep.dongPicker();
        }
    };

    await oGhep.moPickerPhong();
}
  // Sidebar toggle
  function dongMoSidebar() {
    const sb = document.getElementById('thanh-sidebar');
    sb.classList.toggle('an');
  }

  // Admin dropdown toggle
  function toggleAdminMenu() {
    const dd = document.getElementById('adminDropdown');
    const ch = document.getElementById('adminChevron');
    dd.classList.toggle('show');
    ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', function(e) {
    const wrap = document.getElementById('adminHeaderWrap');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('adminDropdown').classList.remove('show');
      document.getElementById('adminChevron').style.transform = '';
    }
  });

  function moDoiMatKhau() {
    // Placeholder – implement as needed
    alert('Chức năng đổi mật khẩu');
