@page
@model QuanLyNhaTro.Pages.Admin.SuCoBaoTriModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Hệ Thống Quản Lý – Sự Cố & Bảo Trì</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/Admin/SuCoBaoTri.css" />
  <script src="~/js/ChuTro/ChuTro-core.js"></script>
</head>
<body>

<!-- =============================================
     SIDEBAR
============================================= -->
<nav id="thanh-sidebar">
  <div class="khu-vuc-logo">
    <div class="bieu-tuong-logo"><i class="fas fa-crown"></i></div>
    <div class="ten-logo">
      <strong>NHÀ TRỌ BÀ NĂM</strong>
      <span>Cổng Chủ Trọ</span>
    </div>
  </div>

  <div class="nhan-nhom-menu">Tổng quan</div>
  <a class="muc-menu" href="/Admin/ChuTro"><i class="fas fa-home"></i><span>Trang chủ</span></a>

  <div class="nhan-nhom-menu">Vận hành</div>
  <a class="muc-menu" href="/Admin/QuanLyPhong"><i class="fas fa-building"></i><span>Quản lý phòng trọ</span></a>
  <a class="muc-menu" href="/Admin/QuanLyNguoiThue"><i class="fas fa-users"></i><span>Người thuê</span></a>
  <a class="muc-menu" href="/Admin/QuanLyHopDong"><i class="fas fa-file-contract"></i><span>Hợp đồng</span><span class="huy-hieu vang">2</span></a>

  <div class="nhan-nhom-menu">Quản trị chủ trọ</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/Taikhoanquanly'">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CauHinhGiaThue'">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/DichVuThongBao'">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </div>

  <div class="nhan-nhom-menu">Hỗ trợ</div>
  <a class="muc-menu dang-chon" href="/Admin/SuCoBaoTri">
    <i class="fas fa-tools"></i><span >Sự cố / Bảo trì</span> 
    <span class="huy-hieu" id="huy-hieu-sua-chua">-</span>
  </a>
  <a class="muc-menu" href="/Admin/ThongKe"><i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span></a>
  <a class="muc-menu" href="/Admin/CaiDatHT"><i class="fas fa-cog"></i><span>Cài đặt hệ thống</span></a>

  <div class="thong-tin-chu-tro">
    <div class="anh-chu-tro">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")</div>
    <div class="ten-chu">
      <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
      <span>Chủ sở hữu</span>
    </div>
  </div>
</nav>

<!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
<div id="khu-vuc-chinh">

  <!-- HEADER -->
  <header id="thanh-header">
    <div class="header-trai">
      <button class="nut-ham-burger" onclick="dongMoSidebar()">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-header">Sự Cố & Bảo Trì – Toàn Hệ Thống</div>
        <div class="duong-dan-header">Trang chủ / Hỗ trợ / Sự cố & Bảo trì</div>
      </div>
    </div>
    <div class="header-phai">
      <div class="o-tim-kiem">
        <i class="fas fa-search"></i>
        <input type="text" id="input-tim-kiem-header" placeholder="Tìm phòng, sự cố..." oninput="timKiem(this.value)" />
      </div>
      <button class="nut-chuong">
        <i class="fas fa-bell"></i>
        <span class="so-chuong">@Model.SoThongBaoChuaDoc</span>
      </button>
      <div class="header-divider"></div>
      <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ</span>
      <div class="khoi-admin-header">
        <button class="khoi-admin-header-btn" onclick="toggleAdminMenu()">
          <div class="anh-dai-dien-header">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")</div>
          <div>
            <div class="ten-admin-header">@(Model.CurrentUser?.FullName ?? "Admin")</div>
            <div class="vai-tro-header">Chủ sở hữu</div>
          </div>
          <i class="fas fa-chevron-down" id="adminChevron" style="font-size:9px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>
        </button>
        <div class="admin-dropdown" id="adminDropdown">
          <div class="add-header">
            <div class="add-header-avatar">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")</div>
            <div>
              <div class="add-header-name">@(Model.CurrentUser?.FullName ?? "Admin")</div>
              <div class="add-header-email">@(Model.CurrentUser?.Email ?? "")</div>
              <span class="add-header-badge"><i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ</span>
            </div>
          </div>
          <div class="add-body">
            <button class="add-item" onclick="">
              <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
              <div>
                <div class="add-item-label">Đổi mật khẩu</div>
                <div class="add-item-sub">Cập nhật mật khẩu đăng nhập</div>
              </div>
            </button>
            <div class="add-divider"></div>
            <button class="add-item danger" onclick="">
              <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
              <div>
                <div class="add-item-label">Đăng xuất</div>
                <div class="add-item-sub">Thoát khỏi hệ thống</div>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- NỘI DUNG CHÍNH -->
  <main id="noi-dung-chinh">

    <!-- Tiêu đề -->
    <div class="dong-tieu-de-trang">
      <div>
        <h2><i class="fas fa-tools" style="color:var(--mau-chu-de);margin-right:10px;font-size:18px;"></i>Quản Lý Sự Cố & Bảo Trì</h2>
        <p id="ngay-gio-hien-tai">Đang tải...</p>
      </div>
    </div>

    <!-- THỐNG KÊ -->
    <div class="luoi-thong-ke">
      <div class="card-thong-ke card-tk-vang">
        <div class="noi-dung-card-tk">
          <div class="icon-tk vang"><i class="fas fa-clipboard-list"></i></div>
          <div class="so-lieu-tk">
            <div class="con-so">@Model.TongSuCo</div>
            <div class="nhan-tk">Tổng sự cố</div>
          </div>
        </div>
      </div>
      <div class="card-thong-ke card-tk-xanh">
        <div class="noi-dung-card-tk">
          <div class="icon-tk xanh"><i class="fas fa-spinner"></i></div>
          <div class="so-lieu-tk">
            <div class="con-so">@Model.ChuaHoanThanh</div>
            <div class="nhan-tk">Chưa hoàn thành</div>
          </div>
        </div>
      </div>
      <div class="card-thong-ke card-tk-hijau">
        <div class="noi-dung-card-tk">
          <div class="icon-tk hijau"><i class="fas fa-check-circle"></i></div>
          <div class="so-lieu-tk">
            <div class="con-so">@Model.DaHoanThanh</div>
            <div class="nhan-tk">Đã hoàn thành</div>
          </div>
        </div>
      </div>
      <div class="card-thong-ke card-tk-do">
        <div class="noi-dung-card-tk">
          <div class="icon-tk do"><i class="fas fa-exclamation-triangle"></i></div>
          <div class="so-lieu-tk">
            <div class="con-so">@Model.KhanCap</div>
            <div class="nhan-tk">Khẩn cấp</div>
          </div>
        </div>
      </div>
    </div>

    <!-- FILTER BAR -->
    <div class="thanh-filter-moi">
      <div class="nhom-pill-filter">
        <!-- Pills lọc trạng thái -->
        <button class="pill-filter active-all" id="pill-tat-ca" onclick="setFilter('tat-ca', this)">
          <i class="fas fa-th-list"></i> Tất cả
          <span class="pill-count" style="font-size:10px;font-weight:800;padding:1px 7px;border-radius:9999px;">@Model.TongSuCo</span>
        </button>
        <button class="pill-filter" id="pill-chua" onclick="setFilter('chua-hoan-thanh', this)">
          <i class="fas fa-hourglass-half"></i> Chưa hoàn thành
          <span id="cnt-chua" class="pill-count" style="font-size:10px;font-weight:800;padding:1px 7px;border-radius:9999px;">@Model.ChuaHoanThanh</span>
        </button>
        <button class="pill-filter" id="pill-xong" onclick="setFilter('da-hoan-thanh', this)">
          <i class="fas fa-check-double"></i> Đã hoàn thành
          <span id="cnt-xong" class="pill-count" style="font-size:10px;font-weight:800;padding:1px 7px;border-radius:9999px;">@Model.DaHoanThanh</span>
        </button>
        <button class="pill-filter" id="pill-khan" onclick="setFilter('khan-cap', this)">
          <i class="fas fa-fire"></i> Khẩn cấp
          <span id="cnt-khan" class="pill-count" style="font-size:10px;font-weight:800;padding:1px 7px;border-radius:9999px;">@Model.KhanCap</span>
        </button>
        <div class="pill-divider"></div>
        <!-- Kho / Archive toggle -->
        <button class="nut-kho" id="nut-kho-toggle" onclick="toggleKho()">
          <i class="fas fa-archive"></i> Kho lưu trữ
          <span class="badge-kho" id="badge-kho-count">@Model.SoLuuTru</span>
        </button>
      </div>
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="o-tim-kiem-nho">
          <i class="fas fa-search"></i>
          <input type="text" id="input-tim-kiem-filter" placeholder="Tìm phòng, mô tả..." oninput="timKiem(this.value)" />
        </div>
        <span class="so-ket-qua-filter" id="so-ket-qua">
          Hiển thị <strong>@Model.TongSuCo</strong> sự cố
        </span>
      </div>
    </div>

    <!-- Banner kho -->
    <div class="banner-kho" id="banner-kho">
      <i class="fas fa-archive"></i>
      <span><strong>Đang xem Kho lưu trữ</strong> — Các sự cố đã được ẩn khỏi danh sách chính. Nhấn "Khôi phục" để đưa trở lại.</span>
    </div>

    <!-- LƯỚI CARD -->
    <div id="luoi-su-co">
       @foreach (var don in Model.DanhSachSuCo)
{
    string mucDoClass = don.MucDo switch
    {
        "Thấp"       => "muc-thap",
        "Trung bình" => "muc-trung",
        "Khẩn cấp"  => "muc-khan",
        _            => "muc-trung"
    };
    string badgeMucDo = don.MucDo switch
    {
        "Thấp"       => "thap",
        "Trung bình" => "trung-binh",
        "Khẩn cấp"  => "khan-cap",
        _            => "trung-binh"
    };
    string badgeTT = don.TrangThai_DV switch
    {
    "Chờ xử lý"      => "cho-xu-ly",
    "Đang xử lý"     => "dang-xu-ly",
    "Chờ thanh toán" => "cho-tt",
    "Chờ duyệt"      => "cho-tt",       
    "Thành công"     => "thanh-cong",
    "Đã hoàn thành"  => "thanh-cong",  
    "Đã hủy"         => "da-huy",
    "Từ chối"        => "da-huy",       
    "Lưu trữ"        => "luu-tru",
    _                => "cho-xu-ly"
    };

    // ── No IsArchived column — derive from TrangThai_DV ──
    bool laLuuTru    = don.TrangThai_DV == "Lưu trữ";
    bool daHoanThanh = don.TrangThai_DV == "Thành công" 
                                            || don.TrangThai_DV == "Đã hủy"
                                            || don.TrangThai_DV == "Đã hoàn thành" 
                                            || don.TrangThai_DV == "Từ chối";

    string filterClass = laLuuTru    ? "luu-tru"
                       : daHoanThanh ? "da-hoan-thanh"
                       : "chua-hoan-thanh";

    if (don.MucDo == "Khẩn cấp" && !daHoanThanh && !laLuuTru)
        filterClass += " khan-cap";

    string tenNguoiGui = don.Tenant?.FullName  ?? "—";
    string soPhong     = don.Phong?.SoPhong    ?? "—";
    string ngayTaoStr  = don.NgayTao.ToString("dd/MM/yyyy HH:mm");
    string noiDung     = don.NoiDung           ?? "(Không có mô tả)";
    string tenHienThi  = noiDung.Length > 45   ? noiDung[..45] + "..." : noiDung;

    <div class="card-su-co @mucDoClass @(laLuuTru ? "da-luu-tru" : "")"
         data-filter="@filterClass"
         data-ten="@(don.NoiDung ?? "")"
         data-phong="@soPhong"
         data-nguoi="@tenNguoiGui"
         data-id="@don.IDDonDV">

        <!-- HEADER -->
        <div class="card-header">
            <div class="card-header-left">
                <div class="icon-loai @(laLuuTru ? "luu-tru" : "hu-hong")">
                    <i class="fas @(laLuuTru ? "fa-archive" : "fa-wrench")"></i>
                </div>
                <div style="min-width:0;">
                    <div class="ten-su-co" title="@noiDung">@tenHienThi</div>
                    <div class="ma-don">#@don.IDDonDV</div>
                </div>
            </div>
            <div class="nhom-badge">
                <span class="badge @badgeMucDo">@don.MucDo</span>
                <span class="badge @badgeTT">@don.TrangThai_DV</span>
            </div>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <div class="mo-ta-ngan">@noiDung</div>
            <div class="luoi-info">
                <div class="hang-info">
                    <i class="fas fa-door-open"></i>
                    <div>
                        <span class="nhan-info">Phòng</span>
                        <span class="val-info">@soPhong</span>
                    </div>
                </div>
                <div class="hang-info">
                    <i class="fas fa-user"></i>
                    <div>
                        <span class="nhan-info">Người gửi</span>
                        <span class="val-info">@tenNguoiGui</span>
                    </div>
                </div>
                @if (don.ManagerXuLy != null)
                {
                    <div class="hang-info">
                        <i class="fas fa-user-cog"></i>
                        <div>
                            <span class="nhan-info">Người xử lý</span>
                            <span class="val-info">@don.ManagerXuLy.FullName</span>
                        </div>
                    </div>
                }
                @if (don.NgayXuLy.HasValue)
                {
                    <div class="hang-info">
                        <i class="fas fa-calendar-check"></i>
                        <div>
                            <span class="nhan-info">Ngày xử lý</span>
                            <span class="val-info">@don.NgayXuLy.Value.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- FOOTER -->
        <div class="card-footer">
            <div class="thoi-gian-tao">
                <i class="fas fa-clock"></i> @ngayTaoStr
            </div>
            <div class="nhom-nut-card">
                @if (laLuuTru)
                {
                    <button class="nut-khoi-phuc"
                            onclick="khucKhoiPhuc(@don.IDDonDV, event)">
                        <i class="fas fa-undo"></i> Khôi phục
                    </button>
                }
                else
                {
                    <button class="nut-an-kho"
                            onclick="anVaoKho(@don.IDDonDV, event)">
                        <i class="fas fa-archive"></i> Lưu trữ
                    </button>
                }
                <button class="nut-xem-ct"
                        onclick="moModal(@don.IDDonDV)">
                    <i class="fas fa-eye"></i> Chi tiết
                </button>
            </div>
        </div>
    </div>
}
    </div>

    <!-- Trạng thái rỗng -->
    <div id="trang-thai-rong">
      <i class="fas fa-search"></i>
      <span>Không tìm thấy sự cố nào phù hợp</span>
    </div>

  </main>
</div>

<!-- =============================================
     MODAL CHI TIẾT
============================================= -->
<div class="lop-phu-modal" id="modal-chi-tiet" onclick="dongModalNgoai(event,'modal-chi-tiet')">
  <div class="hop-modal-ct" onclick="event.stopPropagation()">

    <div class="modal-hd-ct">
      <div class="modal-hd-left">
        <div class="modal-hd-icon"><i class="fas fa-tools"></i></div>
        <div>
          <div class="modal-hd-title">Chi tiết sự cố / bảo trì</div>
          <div class="modal-hd-sub" id="modal-sub-title">Đang tải...</div>
        </div>
      </div>
      <button class="modal-close" onclick="dongModal('modal-chi-tiet')">✕</button>
    </div>

    <div class="modal-body-ct">
      <div id="modal-banner-muc-do" class="banner-muc-do trung"></div>

      <div class="luoi-chi-tiet">
        <div class="o-chi-tiet">
          <div class="nhan">Mã đơn</div>
          <div class="gia-tri noi-bat" id="modal-ma-don">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Trạng thái</div>
          <div id="modal-trang-thai">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Phòng</div>
          <div class="gia-tri" id="modal-phong">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Người gửi</div>
          <div class="gia-tri" id="modal-nguoi-gui">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Mức độ</div>
          <div id="modal-muc-do">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Ngày tạo</div>
          <div class="gia-tri" id="modal-ngay-tao">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Người xử lý</div>
          <div class="gia-tri" id="modal-nguoi-xu-ly">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Ngày xử lý</div>
          <div class="gia-tri" id="modal-ngay-xu-ly">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Ngày hoàn thành</div>
          <div class="gia-tri" id="modal-ngay-ht">—</div>
        </div>
        <div class="o-chi-tiet">
          <div class="nhan">Tổng chi phí</div>
          <div class="gia-tri" id="modal-tong-tien" style="color:#059669;font-weight:800;">—</div>
        </div>
        <div class="o-chi-tiet full">
          <div class="nhan">Mô tả đầy đủ</div>
          <div class="gia-tri" id="modal-noi-dung" style="font-weight:400;line-height:1.6;">—</div>
        </div>
        <div class="o-chi-tiet full" id="nhom-ghi-chu" style="display:none;">
          <div class="nhan">Ghi chú xử lý</div>
          <div class="gia-tri" id="modal-ghi-chu" style="font-weight:400;"></div>
        </div>
        <div class="o-chi-tiet full" id="nhom-ly-do-huy" style="display:none;">
          <div class="nhan">Lý do hủy</div>
          <div class="gia-tri" id="modal-ly-do-huy" style="color:#dc2626;font-weight:400;"></div>
        </div>
      </div>

      <!-- Ảnh biên lai -->
      <div id="nhom-anh-bl" style="display:none;">
        <p style="font-size:12px;font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
          <i class="fas fa-receipt" style="color:var(--mau-chu-de);"></i> Ảnh biên lai
        </p>
        <div class="khung-anh"><img id="modal-anh-bl" src="" alt="Biên lai" /></div>
      </div>

      <!-- Ảnh kết quả -->
      <div id="nhom-anh-kq" style="display:none;">
        <p style="font-size:12px;font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
          <i class="fas fa-image" style="color:var(--mau-chu-de);"></i> Ảnh kết quả
        </p>
        <div class="khung-anh"><img id="modal-anh-kq" src="" alt="Kết quả" /></div>
      </div>

      <div id="khung-anh-empty" class="khung-anh" style="display:none;">
        <div class="anh-placeholder"><i class="fas fa-image"></i><span>Chưa có ảnh đính kèm</span></div>
      </div>

      <!-- Input ghi chú -->
      <div class="nhom-truong" id="nhom-nhap-gc" style="display:none;">
        <label class="nhan-truong">Ghi chú xử lý</label>
        <input type="text" class="truong-nhap" id="input-ghi-chu" placeholder="Nhập ghi chú khi xử lý / hoàn thành..." />
      </div>
    </div>

    <div class="modal-ft-ct">
      <button class="nut-huy-modal" onclick="dongModal('modal-chi-tiet')">
        <i class="fas fa-times"></i> Đóng
      </button>
      <button class="nut-xu-ly" id="nut-bat-dau" onclick="batDauXuLy()" style="display:none;">
        <i class="fas fa-play"></i> Bắt đầu xử lý
      </button>
      <button class="nut-hoan-thanh" id="nut-ht" onclick="hoanThanh()" style="display:none;">
        <i class="fas fa-check-double"></i> Hoàn thành
      </button>
    </div>
  </div>
</div>

<!-- TOAST CONTAINER -->
<div class="toast-container" id="toastContainer"></div>
@Html.AntiForgeryToken()
<!-- =============================================
     DỮ LIỆU RAZOR → JS
============================================= -->
<script>
    window.hienThiThongBao = function(noiDung, loai = 'success') {
    // Gọi ID bằng tiếng Việt
    const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
    if (!khuVucChua) return;

    // Chuyển đổi tham số type sang class tiếng Việt tương ứng
    let classMauSac = '';
    switch(loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
        case 'error': classMauSac = 'thong-bao-loi'; break;
        default: classMauSac = 'thong-bao-thanh-cong';
    }

    // Tạo phần tử DOM
    const theThongBao = document.createElement('div');
    theThongBao.className = `thong-bao-muc ${classMauSac}`;
    
    // Gắn HTML nội dung và nút X
    theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
    `;

    // Đẩy vào trang
    khuVucChua.appendChild(theThongBao);

    // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
    setTimeout(() => {
        if (theThongBao.parentNode) {
            theThongBao.remove();
        }
    }, 3000);
}
  // Inject danh sách đầy đủ từ Model (cả archived) để modal hoạt động phía client
const danhSachSuCo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.DanhSachSuCo.Select(d => new {
          id            = d.IDDonDV,
          noiDung       = d.NoiDung ?? "",
          phong         = d.Phong?.SoPhong ?? "",
          nguoiGui      = d.Tenant?.FullName ?? "",
          nguoiXuLy     = d.ManagerXuLy?.FullName ?? "",
          mucDo         = d.MucDo,
          trangThai     = d.TrangThai_DV,
          ngayTao       = d.NgayTao.ToString("dd/MM/yyyy HH:mm"),
          ngayXuLy      = d.NgayXuLy.HasValue
                            ? d.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "",
          ngayHoanThanh = d.NgayHoanThanh.HasValue
                            ? d.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm") : "",
          tongTien      = d.TongTien > 0 ? d.TongTien.ToString("N0") + " ₫" : "—",
          ghiChuXuLy    = d.GhiChuXuLy ?? "",
          lyDoHuy       = d.LyDoHuy ?? "",
          anhBienLai    = d.AnhBienLai ?? "",
          anhKetQua     = d.AnhKetQua ?? "",
          isArchived    = d.TrangThai_DV == "Lưu trữ"
      })
  ));

  // ===== NGÀY GIỜ =====
  (function() {
    const n = new Date();
    const t = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
    document.getElementById('ngay-gio-hien-tai').textContent =
      `${t[n.getDay()]}, ${n.getDate()} tháng ${n.getMonth()+1} năm ${n.getFullYear()}`;
  })();

  // ===== CẬP NHẬT HUY HIỆU SIDEBAR =====
  (function() {
    const chuaHoanThanh = document.querySelectorAll('.card-su-co[data-filter*="chua-hoan-thanh"]').length;
    const el = document.getElementById('huy-hieu-sua-chua');
    if (el) {
      el.textContent = chuaHoanThanh > 0 ? chuaHoanThanh : '';
      el.style.display = chuaHoanThanh > 0 ? '' : 'none';
    }
  })();

  // ===== TRẠNG THÁI BỘ LỌC =====
  let mucLocHienTai   = 'tat-ca';
  let dangXemKho      = false;
  let tuKhoa          = '';
  let idDangXem       = null;

  // ===== BỘ LỌC PILL =====
  const PILL_CLASS = {
    'tat-ca':          'active-all',
    'chua-hoan-thanh': 'active-chua',
    'da-hoan-thanh':   'active-xong',
    'khan-cap':        'active-khan'
  };

  function setFilter(ten, phanTu) {
    // Nếu đang xem kho thì tắt
    if (dangXemKho) toggleKho();

    // Reset tất cả pill
    document.querySelectorAll('.pill-filter').forEach(b => {
      b.className = 'pill-filter';
    });
    // Gán class active cho pill được chọn
    phanTu.classList.add(PILL_CLASS[ten] || 'active-all');

    mucLocHienTai = ten;
    apDungLoc();
  }

  // ===== TOGGLE KHO =====
  function toggleKho() {
    dangXemKho = !dangXemKho;
    const btn    = document.getElementById('nut-kho-toggle');
    const banner = document.getElementById('banner-kho');

    if (dangXemKho) {
      btn.classList.add('active');
      banner.classList.add('hien');
      // Reset pill filter khi vào kho
      document.querySelectorAll('.pill-filter').forEach(b => b.className = 'pill-filter');
      mucLocHienTai = 'tat-ca';
    } else {
      btn.classList.remove('active');
      banner.classList.remove('hien');
      // Restore pill tất-cả
      document.getElementById('pill-tat-ca').classList.add('active-all');
    }
    apDungLoc();
  }

  // ===== TÌM KIẾM =====
  function timKiem(val) {
    tuKhoa = val.toLowerCase().trim();
    // Sync cả 2 ô tìm kiếm
    const h = document.getElementById('input-tim-kiem-header');
    const f = document.getElementById('input-tim-kiem-filter');
    if (h && h !== document.activeElement) h.value = val;
    if (f && f !== document.activeElement) f.value = val;
    apDungLoc();
  }

  // ===== ÁP DỤNG LỌC =====
  function apDungLoc() {
    const cards = document.querySelectorAll('.card-su-co');
    let soHienThi = 0;

    cards.forEach(card => {
      const filterAttr = card.dataset.filter || '';
      const ten   = (card.dataset.ten   || '').toLowerCase();
      const phong = (card.dataset.phong || '').toLowerCase();
      const nguoi = (card.dataset.nguoi || '').toLowerCase();

      const laLuuTru = filterAttr === 'luu-tru';

      // Điều kiện kho: chỉ hiện archived khi dangXemKho
      let hopKho;
      if (dangXemKho) {
        hopKho = laLuuTru;
      } else {
        hopKho = !laLuuTru;
      }

      // Điều kiện filter (chỉ áp dụng khi KHÔNG ở kho)
      let hopFilter = true;
      if (!dangXemKho) {
        if (mucLocHienTai === 'chua-hoan-thanh') {
          hopFilter = filterAttr.includes('chua-hoan-thanh');
        } else if (mucLocHienTai === 'da-hoan-thanh') {
          hopFilter = filterAttr.includes('da-hoan-thanh');
        } else if (mucLocHienTai === 'khan-cap') {
          hopFilter = filterAttr.includes('khan-cap');
        }
        // 'tat-ca' => hopFilter = true
      }

      // Điều kiện tìm kiếm
      const hopTuKhoa = !tuKhoa ||
        ten.includes(tuKhoa) || phong.includes(tuKhoa) || nguoi.includes(tuKhoa);

      const hienThi = hopKho && hopFilter && hopTuKhoa;
      card.style.display = hienThi ? '' : 'none';
      if (hienThi) soHienThi++;
    });

    document.getElementById('so-ket-qua').innerHTML =
      `Hiển thị <strong>${soHienThi}</strong> sự cố`;
    document.getElementById('trang-thai-rong').style.display =
      soHienThi === 0 ? 'block' : 'none';
  }

  // ===== ẨN VÀO KHO (Soft Archive) =====
 async function anVaoKho(id, evt) {
    if (evt) evt.stopPropagation();
    if (!confirm('Ẩn sự cố này vào kho lưu trữ?')) return;

    const token = getAntiForgeryToken();
    if (!token) {
      hienToast('fail', 'Lỗi bảo mật', 'Không tìm thấy token xác thực. Vui lòng tải lại trang.');
      return;
    }

    try {
      const res = await fetch(`/Admin/SuCoBaoTri?handler=Archive&idDon=${id}`, {
        method:  'POST',
        headers: {
          'RequestVerificationToken': token,
          'Content-Type': 'application/json'
        }
      });

      if (!res.ok) {
        // Log the actual server response to help debug
        const errText = await res.text();
        console.error(`[Archive] Server returned ${res.status}:`, errText);
        throw new Error(`HTTP ${res.status}`);
      }

      // Optimistic UI update
      const card = document.querySelector(`.card-su-co[data-id="${id}"]`);
      if (card) {
        card.dataset.filter = 'luu-tru';
        card.classList.add('da-luu-tru');
        card.style.display = 'none';
      }

      const badgeEl = document.getElementById('badge-kho-count');
      if (badgeEl) badgeEl.textContent = parseInt(badgeEl.textContent || '0') + 1;

      hienToast('success', 'Đã lưu trữ', `Sự cố #${id} đã được ẩn vào kho.`);
      capNhatSoKetQua();

    } catch (err) {
      console.error('[Archive] Fetch error:', err);
      hienToast('fail', 'Lỗi', 'Không thể lưu trữ. Vui lòng thử lại.');
    }
  }

  // ===== KHÔI PHỤC TỪ KHO =====
  async function khucKhoiPhuc(id, evt) {
    if (evt) evt.stopPropagation();

    const token = getAntiForgeryToken();
    if (!token) {
      hienToast('fail', 'Lỗi bảo mật', 'Không tìm thấy token xác thực. Vui lòng tải lại trang.');
      return;
    }

    try {
      const res = await fetch(`/Admin/SuCoBaoTri?handler=Restore&idDon=${id}`, {
        method:  'POST',
        headers: {
          'RequestVerificationToken': token,
          'Content-Type': 'application/json'
        }
      });

      if (!res.ok) {
        const errText = await res.text();
        console.error(`[Restore] Server returned ${res.status}:`, errText);
        throw new Error(`HTTP ${res.status}`);
      }

      const card = document.querySelector(`.card-su-co[data-id="${id}"]`);
      if (card) {
        card.dataset.filter = card.classList.contains('muc-khan')
          ? 'chua-hoan-thanh khan-cap'
          : 'chua-hoan-thanh';
        card.classList.remove('da-luu-tru');
        card.style.display = 'none';
      }

      const badgeEl = document.getElementById('badge-kho-count');
      if (badgeEl) {
        badgeEl.textContent = Math.max(0, parseInt(badgeEl.textContent || '0') - 1);
      }

      hienToast('success', 'Đã khôi phục', `Sự cố #${id} đã được đưa trở lại danh sách.`);
      capNhatSoKetQua();

    } catch (err) {
      console.error('[Restore] Fetch error:', err);
      hienToast('fail', 'Lỗi', 'Không thể khôi phục. Vui lòng thử lại.');
    }
  }

  function capNhatSoKetQua() {
    const soHienThi = [...document.querySelectorAll('.card-su-co')].filter(c => c.style.display !== 'none').length;
    document.getElementById('so-ket-qua').innerHTML = `Hiển thị <strong>${soHienThi}</strong> sự cố`;
    document.getElementById('trang-thai-rong').style.display = soHienThi === 0 ? 'block' : 'none';
  }

  // ===== MỞ MODAL CHI TIẾT =====
  function moModal(id) {
    const don = danhSachSuCo.find(d => d.id === id);
    if (!don) return;
    idDangXem = id;

    document.getElementById('modal-sub-title').textContent = `Phòng ${don.phong} · #${don.id}`;
    document.getElementById('modal-ma-don').textContent    = '#' + don.id;
    document.getElementById('modal-phong').textContent     = don.phong || '—';
    document.getElementById('modal-nguoi-gui').textContent = don.nguoiGui || '—';
    document.getElementById('modal-noi-dung').textContent  = don.noiDung || '(Không có mô tả)';
    document.getElementById('modal-ngay-tao').textContent  = don.ngayTao || '—';
    document.getElementById('modal-nguoi-xu-ly').textContent = don.nguoiXuLy || '—';
    document.getElementById('modal-ngay-xu-ly').textContent  = don.ngayXuLy  || '—';
    document.getElementById('modal-ngay-ht').textContent     = don.ngayHoanThanh || '—';
    document.getElementById('modal-tong-tien').textContent   = don.tongTien || '—';

    const badgeMD = { 'Thấp': 'thap', 'Trung bình': 'trung-binh', 'Khẩn cấp': 'khan-cap' };
    document.getElementById('modal-muc-do').innerHTML =
      `<span class="badge ${badgeMD[don.mucDo] || 'trung-binh'}">${don.mucDo}</span>`;

    const badgeTT = {
    'Chờ xử lý':      'cho-xu-ly',
    'Đang xử lý':     'dang-xu-ly',
    'Chờ thanh toán': 'cho-tt',
    'Chờ duyệt':      'cho-tt',     
    'Thành công':     'thanh-cong',
    'Đã hoàn thành':  'thanh-cong',   
    'Đã hủy':         'da-huy',
    'Từ chối':        'da-huy',      
    'Lưu trữ':        'luu-tru'
    };
    document.getElementById('modal-trang-thai').innerHTML =
      `<span class="badge ${badgeTT[don.trangThai] || 'cho-xu-ly'}">${don.trangThai}</span>`;

    // Banner mức độ
    const bannerCfg = {
      'Thấp':      { cls: 'thap',  ico: 'fa-info-circle',        txt: 'Mức độ thấp – Xử lý trong thời gian bình thường' },
      'Trung bình':{ cls: 'trung', ico: 'fa-exclamation-circle', txt: 'Mức độ trung bình – Cần xử lý sớm' },
      'Khẩn cấp': { cls: 'khan',  ico: 'fa-exclamation-triangle',txt: 'KHẨN CẤP – Cần xử lý ngay lập tức!' }
    };
    const b = bannerCfg[don.mucDo] || bannerCfg['Trung bình'];
    const bannerEl = document.getElementById('modal-banner-muc-do');
    bannerEl.className = `banner-muc-do ${b.cls}`;
    bannerEl.innerHTML = `<i class="fas ${b.ico}"></i> ${b.txt}`;

    // Ghi chú / Lý do hủy
    const elGC  = document.getElementById('nhom-ghi-chu');
    const elHuy = document.getElementById('nhom-ly-do-huy');
    if (don.ghiChuXuLy) {
      elGC.style.display = ''; document.getElementById('modal-ghi-chu').textContent = don.ghiChuXuLy;
    } else { elGC.style.display = 'none'; }
    if (don.lyDoHuy) {
      elHuy.style.display = ''; document.getElementById('modal-ly-do-huy').textContent = don.lyDoHuy;
    } else { elHuy.style.display = 'none'; }

    // Ảnh
    document.getElementById('nhom-anh-bl').style.display = don.anhBienLai ? '' : 'none';
    if (don.anhBienLai) document.getElementById('modal-anh-bl').src = don.anhBienLai;
    document.getElementById('nhom-anh-kq').style.display = don.anhKetQua ? '' : 'none';
    if (don.anhKetQua) document.getElementById('modal-anh-kq').src = don.anhKetQua;
    document.getElementById('khung-anh-empty').style.display =
      (!don.anhBienLai && !don.anhKetQua) ? '' : 'none';

    // Nút hành động
    const nutBD = document.getElementById('nut-bat-dau');
    const nutHT = document.getElementById('nut-ht');
    const nutGC = document.getElementById('nhom-nhap-gc');
    nutBD.style.display = nutHT.style.display = nutGC.style.display = 'none';

    if (!don.isArchived && don.trangThai !== 'Lưu trữ') {
        if (don.trangThai === 'Chờ xử lý') {
            nutBD.style.display = nutGC.style.display = '';
        } else if (don.trangThai === 'Đang xử lý') {
            nutHT.style.display = nutGC.style.display = '';
        }
    }

    document.getElementById('input-ghi-chu').value = '';
    document.getElementById('modal-chi-tiet').classList.add('hien');
  }

  // ===== BẮT ĐẦU XỬ LÝ =====
  async function batDauXuLy() {
    const ghiChu = document.getElementById('input-ghi-chu').value;
    try {
      const res = await fetch(
        `/Admin/SuCoBaoTri?handler=BatDauXuLy&idDon=${idDangXem}&ghiChu=${encodeURIComponent(ghiChu)}`,
        { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } }
      );
      if (!res.ok) throw new Error();
      hienToast('success', 'Đã bắt đầu xử lý', `Sự cố #${idDangXem} chuyển sang Đang xử lý.`);
      dongModal('modal-chi-tiet');
      setTimeout(() => location.reload(), 1200);
    } catch {
      hienToast('fail', 'Lỗi', 'Không thể cập nhật trạng thái.');
    }
  }

  // ===== HOÀN THÀNH =====
  async function hoanThanh() {
    const ghiChu = document.getElementById('input-ghi-chu').value;
    try {
      const res = await fetch(
        `/Admin/SuCoBaoTri?handler=HoanThanh&idDon=${idDangXem}&ghiChu=${encodeURIComponent(ghiChu)}`,
        { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } }
      );
      if (!res.ok) throw new Error();
      hienToast('success', 'Hoàn thành!', `Sự cố #${idDangXem} đã được xử lý xong.`);
      dongModal('modal-chi-tiet');
      setTimeout(() => location.reload(), 1200);
    } catch {
      hienToast('fail', 'Lỗi', 'Không thể hoàn thành.');
    }
  }

  // ===== SIDEBAR =====
  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an');
  }

  // ===== ADMIN DROPDOWN =====
  function toggleAdminMenu() {
    const dd = document.getElementById('adminDropdown');
    const ch = document.getElementById('adminChevron');
    dd.classList.toggle('show');
    ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', e => {
    const wrap = document.querySelector('.khoi-admin-header');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('adminDropdown')?.classList.remove('show');
      const ch = document.getElementById('adminChevron');
      if (ch) ch.style.transform = '';
    }
  });

  // ===== MODAL HELPERS =====
  function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
  function dongModalNgoai(evt, id) { if (evt.target.id === id) dongModal(id); }

  // ===== ANTI-FORGERY TOKEN =====
  function getAntiForgeryToken() {
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    if (el && el.value) return el.value;
    console.error('[AntiForgery] Token input not found — POST will be rejected with 400.');
    return '';
  }

  // ===== TOAST =====
  function hienToast(loai, title, msg, duration = 3500) {
    const container = document.getElementById('toastContainer');
    const icons = {
      success: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#639922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
      fail:    `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`,
      warn:    `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF9F27" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
    };
    const toast = document.createElement('div');
    toast.className = `toast toast-${loai}`;
    toast.innerHTML = `
      <div class="toast-icon-wrap">${icons[loai] || icons.warn}</div>
      <div class="toast-body">
        <div class="toast-title">${title}</div>
        <div class="toast-msg">${msg}</div>
      </div>
      <div class="toast-progress" style="animation-duration:${duration}ms;"></div>`;
    container.appendChild(toast);
    requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.add('show')));
    setTimeout(() => {
      toast.classList.remove('show');
      toast.classList.add('hide');
      setTimeout(() => toast.remove(), 350);
    }, duration);
  }
</script>

