<!-- TOAST CONTAINER -->
<div class="toast-container" id="toastContainer"></div>
@Html.AntiForgeryToken()
<!-- =============================================
     DỮ LIỆU RAZOR → JS
============================================= -->
<script>
  // Inject danh sách đầy đủ từ Model (cả archived) để modal hoạt động phía client
const danhSachSuCo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.DanhSachSuCo.Select(d => new {
          id            = d.IDDonDV,
          noiDung       = d.NoiDung ?? "",
          phong         = d.Phong?.SoPhong ?? "",
          nguoiGui      = d.Tenant?.FullName ?? "",
          nguoiXuLy     = d.ManagerXuLy?.FullName ?? "",
          mucDo         = d.MucDo,
          trangThai     = d.TrangThai_DV,
          ngayTao       = d.NgayTao.ToString("dd/MM/yyyy HH:mm"),
          ngayXuLy      = d.NgayXuLy.HasValue
                            ? d.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "",
          ngayHoanThanh = d.NgayHoanThanh.HasValue
                            ? d.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm") : "",
          tongTien      = d.TongTien > 0 ? d.TongTien.ToString("N0") + " ₫" : "—",
          ghiChuXuLy    = d.GhiChuXuLy ?? "",
          lyDoHuy       = d.LyDoHuy ?? "",
          anhBienLai    = d.AnhBienLai ?? "",
          anhKetQua     = d.AnhKetQua ?? "",
          isArchived    = d.TrangThai_DV == "Lưu trữ"
      })
  ));

  // ===== NGÀY GIỜ =====
  (function() {
    const n = new Date();
    const t = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
    document.getElementById('ngay-gio-hien-tai').textContent =
      `${t[n.getDay()]}, ${n.getDate()} tháng ${n.getMonth()+1} năm ${n.getFullYear()}`;
  })();

  // ===== CẬP NHẬT HUY HIỆU SIDEBAR =====
  (function() {
    const chuaHoanThanh = document.querySelectorAll('.card-su-co[data-filter*="chua-hoan-thanh"]').length;
    const el = document.getElementById('huy-hieu-sua-chua');
    if (el) {
      el.textContent = chuaHoanThanh > 0 ? chuaHoanThanh : '';
      el.style.display = chuaHoanThanh > 0 ? '' : 'none';
    }
  })();

  // ===== TRẠNG THÁI BỘ LỌC =====
  let mucLocHienTai   = 'tat-ca';
  let dangXemKho      = false;
  let tuKhoa          = '';
  let idDangXem       = null;

  // ===== BỘ LỌC PILL =====
  const PILL_CLASS = {
    'tat-ca':          'active-all',
    'chua-hoan-thanh': 'active-chua',
    'da-hoan-thanh':   'active-xong',
    'khan-cap':        'active-khan'
  };

  function setFilter(ten, phanTu) {
    // Nếu đang xem kho thì tắt
    if (dangXemKho) toggleKho();

    // Reset tất cả pill
    document.querySelectorAll('.pill-filter').forEach(b => {
      b.className = 'pill-filter';
    });
    // Gán class active cho pill được chọn
    phanTu.classList.add(PILL_CLASS[ten] || 'active-all');

    mucLocHienTai = ten;
    apDungLoc();
  }

  // ===== TOGGLE KHO =====
  function toggleKho() {
    dangXemKho = !dangXemKho;
    const btn    = document.getElementById('nut-kho-toggle');
    const banner = document.getElementById('banner-kho');

    if (dangXemKho) {
      btn.classList.add('active');
      banner.classList.add('hien');
      // Reset pill filter khi vào kho
      document.querySelectorAll('.pill-filter').forEach(b => b.className = 'pill-filter');
      mucLocHienTai = 'tat-ca';
    } else {
      btn.classList.remove('active');
      banner.classList.remove('hien');
      // Restore pill tất-cả
      document.getElementById('pill-tat-ca').classList.add('active-all');
    }
    apDungLoc();
  }

  // ===== TÌM KIẾM =====
  function timKiem(val) {
    tuKhoa = val.toLowerCase().trim();
    // Sync cả 2 ô tìm kiếm
    const h = document.getElementById('input-tim-kiem-header');
    const f = document.getElementById('input-tim-kiem-filter');
    if (h && h !== document.activeElement) h.value = val;
    if (f && f !== document.activeElement) f.value = val;
    apDungLoc();
  }

  // ===== ÁP DỤNG LỌC =====
  function apDungLoc() {
    const cards = document.querySelectorAll('.card-su-co');
    let soHienThi = 0;

    cards.forEach(card => {
      const filterAttr = card.dataset.filter || '';
      const ten   = (card.dataset.ten   || '').toLowerCase();
      const phong = (card.dataset.phong || '').toLowerCase();
      const nguoi = (card.dataset.nguoi || '').toLowerCase();

      const laLuuTru = filterAttr === 'luu-tru';

      // Điều kiện kho: chỉ hiện archived khi dangXemKho
      let hopKho;
      if (dangXemKho) {
        hopKho = laLuuTru;
      } else {
        hopKho = !laLuuTru;
      }

      // Điều kiện filter (chỉ áp dụng khi KHÔNG ở kho)
      let hopFilter = true;
      if (!dangXemKho) {
        if (mucLocHienTai === 'chua-hoan-thanh') {
          hopFilter = filterAttr.includes('chua-hoan-thanh');
        } else if (mucLocHienTai === 'da-hoan-thanh') {
          hopFilter = filterAttr.includes('da-hoan-thanh');
        } else if (mucLocHienTai === 'khan-cap') {
          hopFilter = filterAttr.includes('khan-cap');
        }
        // 'tat-ca' => hopFilter = true
      }

      // Điều kiện tìm kiếm
      const hopTuKhoa = !tuKhoa ||
        ten.includes(tuKhoa) || phong.includes(tuKhoa) || nguoi.includes(tuKhoa);

      const hienThi = hopKho && hopFilter && hopTuKhoa;
      card.style.display = hienThi ? '' : 'none';
      if (hienThi) soHienThi++;
    });

    document.getElementById('so-ket-qua').innerHTML =
      `Hiển thị <strong>${soHienThi}</strong> sự cố`;
    document.getElementById('trang-thai-rong').style.display =
      soHienThi === 0 ? 'block' : 'none';
  }

  // ===== ẨN VÀO KHO (Soft Archive) =====
 async function anVaoKho(id, evt) {
    if (evt) evt.stopPropagation();
    if (!confirm('Ẩn sự cố này vào kho lưu trữ?')) return;

    const token = getAntiForgeryToken();
    if (!token) {
      hienToast('fail', 'Lỗi bảo mật', 'Không tìm thấy token xác thực. Vui lòng tải lại trang.');
      return;
    }

    try {
      const res = await fetch(`/Admin/SuCoBaoTri?handler=Archive&idDon=${id}`, {
        method:  'POST',
        headers: {
          'RequestVerificationToken': token,
          'Content-Type': 'application/json'
        }
      });

      if (!res.ok) {
        // Log the actual server response to help debug
        const errText = await res.text();
        console.error(`[Archive] Server returned ${res.status}:`, errText);
        throw new Error(`HTTP ${res.status}`);
      }

      // Optimistic UI update
      const card = document.querySelector(`.card-su-co[data-id="${id}"]`);
      if (card) {
        card.dataset.filter = 'luu-tru';
        card.classList.add('da-luu-tru');
        card.style.display = 'none';
      }

      const badgeEl = document.getElementById('badge-kho-count');
      if (badgeEl) badgeEl.textContent = parseInt(badgeEl.textContent || '0') + 1;

      hienToast('success', 'Đã lưu trữ', `Sự cố #${id} đã được ẩn vào kho.`);
      capNhatSoKetQua();

    } catch (err) {
      console.error('[Archive] Fetch error:', err);
      hienToast('fail', 'Lỗi', 'Không thể lưu trữ. Vui lòng thử lại.');
    }
  }

  // ===== KHÔI PHỤC TỪ KHO =====
  async function khucKhoiPhuc(id, evt) {
    if (evt) evt.stopPropagation();

    const token = getAntiForgeryToken();
    if (!token) {
      hienToast('fail', 'Lỗi bảo mật', 'Không tìm thấy token xác thực. Vui lòng tải lại trang.');
      return;
    }

    try {
      const res = await fetch(`/Admin/SuCoBaoTri?handler=Restore&idDon=${id}`, {
        method:  'POST',
        headers: {
          'RequestVerificationToken': token,
          'Content-Type': 'application/json'
        }
      });

      if (!res.ok) {
        const errText = await res.text();
        console.error(`[Restore] Server returned ${res.status}:`, errText);
        throw new Error(`HTTP ${res.status}`);
      }

      const card = document.querySelector(`.card-su-co[data-id="${id}"]`);
      if (card) {
        card.dataset.filter = card.classList.contains('muc-khan')
          ? 'chua-hoan-thanh khan-cap'
          : 'chua-hoan-thanh';
        card.classList.remove('da-luu-tru');
        card.style.display = 'none';
      }

      const badgeEl = document.getElementById('badge-kho-count');
      if (badgeEl) {
        badgeEl.textContent = Math.max(0, parseInt(badgeEl.textContent || '0') - 1);
      }

      hienToast('success', 'Đã khôi phục', `Sự cố #${id} đã được đưa trở lại danh sách.`);
      capNhatSoKetQua();

    } catch (err) {
      console.error('[Restore] Fetch error:', err);
      hienToast('fail', 'Lỗi', 'Không thể khôi phục. Vui lòng thử lại.');
    }
  }

  function capNhatSoKetQua() {
    const soHienThi = [...document.querySelectorAll('.card-su-co')].filter(c => c.style.display !== 'none').length;
    document.getElementById('so-ket-qua').innerHTML = `Hiển thị <strong>${soHienThi}</strong> sự cố`;
    document.getElementById('trang-thai-rong').style.display = soHienThi === 0 ? 'block' : 'none';
  }

  // ===== MỞ MODAL CHI TIẾT =====
  function moModal(id) {
    const don = danhSachSuCo.find(d => d.id === id);
    if (!don) return;
    idDangXem = id;

    document.getElementById('modal-sub-title').textContent = `Phòng ${don.phong} · #${don.id}`;
    document.getElementById('modal-ma-don').textContent    = '#' + don.id;
    document.getElementById('modal-phong').textContent     = don.phong || '—';
    document.getElementById('modal-nguoi-gui').textContent = don.nguoiGui || '—';
    document.getElementById('modal-noi-dung').textContent  = don.noiDung || '(Không có mô tả)';
    document.getElementById('modal-ngay-tao').textContent  = don.ngayTao || '—';
    document.getElementById('modal-nguoi-xu-ly').textContent = don.nguoiXuLy || '—';
    document.getElementById('modal-ngay-xu-ly').textContent  = don.ngayXuLy  || '—';
    document.getElementById('modal-ngay-ht').textContent     = don.ngayHoanThanh || '—';
    document.getElementById('modal-tong-tien').textContent   = don.tongTien || '—';

    const badgeMD = { 'Thấp': 'thap', 'Trung bình': 'trung-binh', 'Khẩn cấp': 'khan-cap' };
    document.getElementById('modal-muc-do').innerHTML =
      `<span class="badge ${badgeMD[don.mucDo] || 'trung-binh'}">${don.mucDo}</span>`;

    const badgeTT = {
    'Chờ xử lý':      'cho-xu-ly',
    'Đang xử lý':     'dang-xu-ly',
    'Chờ thanh toán': 'cho-tt',
    'Chờ duyệt':      'cho-tt',     
    'Thành công':     'thanh-cong',
    'Đã hoàn thành':  'thanh-cong',   
    'Đã hủy':         'da-huy',
    'Từ chối':        'da-huy',      
    'Lưu trữ':        'luu-tru'
    };
    document.getElementById('modal-trang-thai').innerHTML =
      `<span class="badge ${badgeTT[don.trangThai] || 'cho-xu-ly'}">${don.trangThai}</span>`;

    // Banner mức độ
    const bannerCfg = {
      'Thấp':      { cls: 'thap',  ico: 'fa-info-circle',        txt: 'Mức độ thấp – Xử lý trong thời gian bình thường' },
      'Trung bình':{ cls: 'trung', ico: 'fa-exclamation-circle', txt: 'Mức độ trung bình – Cần xử lý sớm' },
      'Khẩn cấp': { cls: 'khan',  ico: 'fa-exclamation-triangle',txt: 'KHẨN CẤP – Cần xử lý ngay lập tức!' }
    };
    const b = bannerCfg[don.mucDo] || bannerCfg['Trung bình'];
    const bannerEl = document.getElementById('modal-banner-muc-do');
    bannerEl.className = `banner-muc-do ${b.cls}`;
    bannerEl.innerHTML = `<i class="fas ${b.ico}"></i> ${b.txt}`;

    // Ghi chú / Lý do hủy
    const elGC  = document.getElementById('nhom-ghi-chu');
    const elHuy = document.getElementById('nhom-ly-do-huy');
    if (don.ghiChuXuLy) {
      elGC.style.display = ''; document.getElementById('modal-ghi-chu').textContent = don.ghiChuXuLy;
    } else { elGC.style.display = 'none'; }
    if (don.lyDoHuy) {
      elHuy.style.display = ''; document.getElementById('modal-ly-do-huy').textContent = don.lyDoHuy;
    } else { elHuy.style.display = 'none'; }

    // Ảnh
    document.getElementById('nhom-anh-bl').style.display = don.anhBienLai ? '' : 'none';
    if (don.anhBienLai) document.getElementById('modal-anh-bl').src = don.anhBienLai;
    document.getElementById('nhom-anh-kq').style.display = don.anhKetQua ? '' : 'none';
    if (don.anhKetQua) document.getElementById('modal-anh-kq').src = don.anhKetQua;
    document.getElementById('khung-anh-empty').style.display =
      (!don.anhBienLai && !don.anhKetQua) ? '' : 'none';

    // Nút hành động
    const nutBD = document.getElementById('nut-bat-dau');
    const nutHT = document.getElementById('nut-ht');
    const nutGC = document.getElementById('nhom-nhap-gc');
    nutBD.style.display = nutHT.style.display = nutGC.style.display = 'none';

    if (!don.isArchived && don.trangThai !== 'Lưu trữ') {
        if (don.trangThai === 'Chờ xử lý') {
            nutBD.style.display = nutGC.style.display = '';
        } else if (don.trangThai === 'Đang xử lý') {
            nutHT.style.display = nutGC.style.display = '';
        }
    }

    document.getElementById('input-ghi-chu').value = '';
    document.getElementById('modal-chi-tiet').classList.add('hien');
  }

  // ===== BẮT ĐẦU XỬ LÝ =====
  async function batDauXuLy() {
    const ghiChu = document.getElementById('input-ghi-chu').value;
    try {
      const res = await fetch(
        `/Admin/SuCoBaoTri?handler=BatDauXuLy&idDon=${idDangXem}&ghiChu=${encodeURIComponent(ghiChu)}`,
        { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } }
      );
      if (!res.ok) throw new Error();
      hienToast('success', 'Đã bắt đầu xử lý', `Sự cố #${idDangXem} chuyển sang Đang xử lý.`);
      dongModal('modal-chi-tiet');
      setTimeout(() => location.reload(), 1200);
    } catch {
      hienToast('fail', 'Lỗi', 'Không thể cập nhật trạng thái.');
    }
  }

  // ===== HOÀN THÀNH =====
  async function hoanThanh() {
    const ghiChu = document.getElementById('input-ghi-chu').value;
    try {
      const res = await fetch(
        `/Admin/SuCoBaoTri?handler=HoanThanh&idDon=${idDangXem}&ghiChu=${encodeURIComponent(ghiChu)}`,
        { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } }
      );
      if (!res.ok) throw new Error();
      hienToast('success', 'Hoàn thành!', `Sự cố #${idDangXem} đã được xử lý xong.`);
      dongModal('modal-chi-tiet');
      setTimeout(() => location.reload(), 1200);
    } catch {
      hienToast('fail', 'Lỗi', 'Không thể hoàn thành.');
    }
  }

  // ===== SIDEBAR =====
  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an');
  }

  // ===== ADMIN DROPDOWN =====
  function toggleAdminMenu() {
    const dd = document.getElementById('adminDropdown');
    const ch = document.getElementById('adminChevron');
    dd.classList.toggle('show');
    ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
  }
  document.addEventListener('click', e => {
    const wrap = document.querySelector('.khoi-admin-header');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('adminDropdown')?.classList.remove('show');
      const ch = document.getElementById('adminChevron');
      if (ch) ch.style.transform = '';
    }
  });

  // ===== MODAL HELPERS =====
  function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
  function dongModalNgoai(evt, id) { if (evt.target.id === id) dongModal(id); }

  // ===== ANTI-FORGERY TOKEN =====
  function getAntiForgeryToken() {
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    if (el && el.value) return el.value;
    console.error('[AntiForgery] Token input not found — POST will be rejected with 400.');
    return '';
  }

  // ===== TOAST =====
  function hienToast(loai, title, msg, duration = 3500) {
    const container = document.getElementById('toastContainer');
    const icons = {
      success: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#639922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
      fail:    `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`,
      warn:    `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF9F27" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
    };
    const toast = document.createElement('div');
    toast.className = `toast toast-${loai}`;
    toast.innerHTML = `
      <div class="toast-icon-wrap">${icons[loai] || icons.warn}</div>
      <div class="toast-body">
        <div class="toast-title">${title}</div>
        <div class="toast-msg">${msg}</div>
      </div>
      <div class="toast-progress" style="animation-duration:${duration}ms;"></div>`;
    container.appendChild(toast);
    requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.add('show')));
    setTimeout(() => {
      toast.classList.remove('show');
      toast.classList.add('hide');
      setTimeout(() => toast.remove(), 350);
    }, duration);
  }
</script>

