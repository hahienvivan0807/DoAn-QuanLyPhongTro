@page
@model QuanLyNhaTro.Pages.Admin.CauHinhGiaThueModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cấu Hình Giá Thuê – Hệ Thống Quản Lý</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/ChuTro.css" />
    <link rel="stylesheet" href="/css/Admin/CauHinhGiaThue.css" />
    <!-- Javascript (giữ nguyên như ChuTro.cshtml) -->
    <script src="/js/ChuTro/ChuTro-CauHinhGia.js"></script>
    <script src="/js/ChuTro/ChuTro-ThongBao.js"></script>
    <script src="/js/ChuTro/ChuTro-core.js"></script>
    <script src="/js/ChuTro/ChuTro-quanLy.js"></script>
    <script src="/js/ChuTro/ChuTro-bieuDo.js"></script>
    <script src="/js/ChuTro/ChuTro-cauHinh.js"></script>
    <script src="/js/ChuTro/ChuTro-pheDuyet.js"></script>
    <script src="/js/ChuTro/ChuTro-NguoiThue.js"></script>
    <script src="/js/ChuTro/ChuTro-suaChua.js"></script>
    <style>

    </style>
</head>
<body>

    <!-- =====================================================================
     SIDEBAR
===================================================================== -->
    <nav id="thanh-sidebar">

        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo"><i class="fas fa-crown"></i></div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <div class="nhan-nhom-menu">Tổng quan</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/ChuTro'">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>
        <div class="nhan-nhom-menu">Vận hành</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyPhong'">
            <i class="fas fa-building"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyHopDong'">
            <i class="fas fa-file-contract"></i><span>Hợp đồng</span>
            <span class="huy-hieu vang">2</span>
        </div>
        <!-- Nhóm: Quản trị chủ trọ -->
        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>

        <div class="muc-menu" onclick="window.location.href='/Admin/Taikhoanquanly'">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </div>
        <!-- *** MỤC ĐANG CHỌN *** -->
        <div class="muc-menu dang-chon">
            <i class="fas fa-sliders-h"></i><span>Cấu hình giá thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/DichVuThongBao'">
            <i class="fas fa-bolt"></i><span>Dịch vụ thông báo</span>
        </div>

        <div class="nhan-nhom-menu">Hỗ trợ</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/SuCoBaoTri'">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span id="huy-hieu-sua-chua" class="huy-hieu">-</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/ThongKe">
            <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CaiDat'">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro">C</div>
            <div class="ten-chu">
                <strong>Chủ Trọ ABC</strong>
                <span>Chủ sở hữu</span>
            </div>
        </div>

    </nav>

    <!-- =====================================================================
     KHU VỰC CHÍNH
===================================================================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER (copy y hệt ChuTro.cshtml) -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Cấu Hình Giá Thuê</div>
                    <div class="duong-dan-header">Trang chủ / Quản trị chủ trọ / Cấu hình giá thuê</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
                </div>
                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">7</span>
                </button>
                <div class="header-divider"></div>
                <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ</span>
                <div class="khoi-admin-header" id="adminHeaderWrap">
                    <button onclick="toggleAdminMenu()" id="adminHeaderBtn"
                            style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:5px 10px;border-radius:var(--radius-full);border:none;background:none;font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-chu-de-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien-header">C</div>
                        <div>
                            <div class="ten-admin-header" id="header-ten-chu">Nguyễn Văn Chủ</div>
                            <div class="vai-tro-header">Chủ sở hữu</div>
                        </div>
                        <i class="fas fa-chevron-down" id="adminChevron" style="font-size:9px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>
                    </button>
                    <div class="admin-dropdown" id="adminDropdown">
                        <div class="add-header">
                            <div class="add-header-avatar" id="dd-avatar">C</div>
                            <div>
                                <div class="add-header-name" id="dd-ten">Nguyễn Văn Chủ</div>
                                <div class="add-header-email" id="dd-email">chusonguyen@nhatrobanum.vn</div>
                                <span class="add-header-badge"><i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ</span>
                            </div>
                        </div>
                        <div class="add-body">
                            <button class="add-item" onclick="moDoiMatKhau()">
                                <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="add-item-label">Đổi mật khẩu</div>
                                    <div class="add-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>
                            <div class="add-divider"></div>
                            <button class="add-item danger" onclick="xacNhanDangXuat()">
                                <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="add-item-label">Đăng xuất</div>
                                    <div class="add-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- =====================================================================
         NỘI DUNG CHÍNH – FULL PAGE CONFIG
    ===================================================================== -->
        <main id="noi-dung-chinh">

            <!-- PAGE BANNER -->
            <div class="page-banner">
                <div class="page-banner-left">
                    <div class="page-banner-icon">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div>
                        <div class="page-banner-title">Cấu hình giá thuê</div>
                        <div class="page-banner-sub">Quản lý đơn giá dịch vụ &amp; thông tin phòng trong toàn hệ thống</div>
                    </div>
                </div>
                <div class="page-banner-stats">
                    <div class="banner-stat">
                        <div class="banner-stat-num" id="bs-so-dv">—</div>
                        <div class="banner-stat-lbl">Dịch vụ</div>
                    </div>
                    <div class="banner-stat">
                        <div class="banner-stat-num" id="bs-so-phong">—</div>
                        <div class="banner-stat-lbl">Tổng phòng</div>
                    </div>
                    <div class="banner-stat">
                        <div class="banner-stat-num" id="bs-phong-trong">—</div>
                        <div class="banner-stat-lbl">Phòng trống</div>
                    </div>
                </div>
            </div>

            <!-- TAB BAR (IDs khớp với ChuTro-cauHinh.js: chgSwitch) -->
            <div class="tab-bar">
                <button class="tab-btn active" id="chg-tab-dv" onclick="chgSwitch('dv')">
                    <i class="fas fa-bolt"></i> Cấu hình Giá Dịch Vụ
                </button>
                <button class="tab-btn" id="chg-tab-phong" onclick="chgSwitch('phong')">
                    <i class="fas fa-door-open"></i> Cấu hình Phòng
                </button>
            </div>

            <!-- ================================================================
             PANEL 1: GIÁ DỊCH VỤ
             (IDs giữ nguyên: dv-ma, dv-ten, dv-gia, dv-donvi, chg-dv-list)
        ================================================================ -->
            <div class="content-panel show" id="chg-panel-dv">

                <div class="info-banner">
                    <i class="fas fa-info-circle"></i>
                    <span>Thiết lập đơn giá cho từng loại dịch vụ. Đơn giá này sẽ được áp dụng khi tính hóa đơn hàng tháng cho tất cả các phòng trong hệ thống.</span>
                </div>

                <div class="two-col">

                    <!-- Card: Thêm / Cập nhật dịch vụ -->
                    <div class="card">
                        <div class="card-title">
                            <div class="card-title-icon"><i class="fas fa-plus-circle"></i></div>
                            Thêm / Cập nhật dịch vụ
                        </div>

                        <div class="sec-lbl">
                            <i class="fas fa-cog"></i> Thông tin dịch vụ
                        </div>

                        <div class="fg2" id="chg-dv-form">
                            <div class="field">
                                <label class="f-lbl">Mã dịch vụ <span class="req">*</span></label>
                                <div style="display:flex; gap:0; position:relative;">
                                    <input class="inp" type="text" id="dv-ma"
                                           placeholder="VD: DIEN, NUOC..."
                                           style="border-radius:8px 0 0 8px; border-right:none;" readonly />
                                    <button type="button" onclick="dvMaMoPopup()"
                                            style="padding:0 14px; border:1.5px solid var(--mau-vien); border-left:none;
                                        border-radius:0 8px 8px 0; background:var(--page-accent); color:#fff;
                                        cursor:pointer; font-size:12px; font-weight:700; font-family:inherit;
                                        display:flex; align-items:center; gap:6px; white-space:nowrap;
                                        transition:background .15s;">
                                        <i class="fas fa-database"></i> Chọn mã
                                    </button>
                                </div>
                                <div class="f-note">Nhấn "Chọn mã" để chọn từ danh sách dịch vụ trong hệ thống.</div>
                            </div>
                            <div class="field">
                                <label class="f-lbl">Tên dịch vụ <span class="req">*</span></label>
                                <input class="inp" type="text" id="dv-ten"
                                       placeholder="VD: Tiền điện, Tiền nước, Internet..." />
                            </div>
                            <div class="field">
                                <label class="f-lbl">Đơn giá <span class="req">*</span></label>
                                <div class="inp-u">
                                    <input class="inp" type="number" id="dv-gia"
                                           placeholder="VD: 3500" min="0" />
                                    <span class="unit">đ</span>
                                </div>
                                <div class="f-note">Đơn giá tính theo đơn vị tương ứng bên dưới</div>
                            </div>
                            <div class="field">
                                <label class="f-lbl">Đơn vị tính <span class="req">*</span></label>
                                <select class="inp" id="dv-donvi">
                                    <option value="">-- Chọn đơn vị --</option>
                                    <option value="kWh">kWh (điện)</option>
                                    <option value="m3">m³ (nước)</option>
                                    <option value="phong/thang">phòng / tháng</option>
                                    <option value="nguoi/thang">người / tháng</option>
                                    <option value="xe/thang">xe / tháng</option>
                                    <option value="lan">lần (dịch vụ theo lần)</option>
                                    <option value="binh">bình (nước bình)</option>
                                    <option value="thang">tháng (khoán)</option>
                                </select>
                            </div>
                        </div>

                        <div class="actions-bar">
                            <div class="req-note"><span>*</span> Trường bắt buộc</div>
                            <div class="actions-btns">
                                <button class="btn-cancel-chg" type="button"
                                        onclick="document.getElementById('dv-ma').value='';document.getElementById('dv-ten').value='';document.getElementById('dv-gia').value='';document.getElementById('dv-donvi').value='';">
                                    Xóa trắng
                                </button>
                                <button class="btn-confirm-chg" id="chg-btn-submit" onclick="luuDichVu()">
                                    <i class="fas fa-check"></i>
                                    <span id="chg-btn-label">Lưu dịch vụ</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Card: Gợi ý nhanh -->
                    <div class="card">
                        <div class="card-title">
                            <div class="card-title-icon"><i class="fas fa-lightbulb"></i></div>
                            Gợi ý thiết lập nhanh
                        </div>
                        <div class="sec-lbl"><i class="fas fa-bolt"></i> Dịch vụ phổ biến</div>

                        <div style="display:flex;flex-direction:column;gap:10px;">
                            <!-- Mỗi quick-fill card — MaDichVu khớp với CONFIG_GIA.MaDichVu -->
                            <!-- DIEN: tính theo kWh (đồng bộ DIENNUOC.SoDienMoi) -->
                            <div onclick="chgQuickFill('DIEN','Tiền điện','3500','kWh')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#fff8ee;display:flex;align-items:center;justify-content:center;color:#d97706;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Tiền điện</div>
                                    <div style="font-size:11px;color:var(--mau-chu-phu);margin-top:1px;">3.500 đ / kWh &nbsp;·&nbsp; Mã: DIEN</div>
                                </div>
                                <i class="fas fa-arrow-right" style="color:var(--page-accent);font-size:12px;opacity:0.5;"></i>
                            </div>

                            <!-- NUOC: tính theo m³ (đồng bộ DIENNUOC.SoNuocMoi) -->
                            <div onclick="chgQuickFill('NUOC','Tiền nước','15000','m3')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#ecfeff;display:flex;align-items:center;justify-content:center;color:#0891b2;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-tint"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Tiền nước</div>
                                    <div style="font-size:11px;color:var(--mau-chu-phu);margin-top:1px;">15.000 đ / m³ &nbsp;·&nbsp; Mã: NUOC</div>
                                </div>
                                <i class="fas fa-arrow-right" style="color:var(--page-accent);font-size:12px;opacity:0.5;"></i>
                            </div>

                            <!-- WIFI: đổi từ 'INET' → 'WIFI' để tránh lỗi "Không tìm thấy dịch vụ 'INET'" -->
                            <div onclick="chgQuickFill('WIFI','Internet (Wi-Fi)','100000','phong/thang')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:#2563eb;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-wifi"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Internet (Wi-Fi)</div>
                                    <div style="font-size:11px;color:var(--mau-chu-phu);margin-top:1px;">100.000 đ / phòng / tháng &nbsp;·&nbsp; Mã: WIFI</div>
                                </div>
                                <i class="fas fa-arrow-right" style="color:var(--page-accent);font-size:12px;opacity:0.5;"></i>
                            </div>

                            <!-- GIU_XE: đổi từ 'GIAM' → 'GIU_XE' (tên rõ nghĩa, tránh nhầm với giảm giá) -->
                            <div onclick="chgQuickFill('GIU_XE','Giữ xe','80000','xe/thang')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#f5f3ff;display:flex;align-items:center;justify-content:center;color:#7c3aed;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-motorcycle"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Giữ xe</div>
                                    <div style="font-size:11px;color:var(--mau-chu-phu);margin-top:1px;">80.000 đ / xe / tháng &nbsp;·&nbsp; Mã: GIU_XE</div>
                                </div>
                                <i class="fas fa-arrow-right" style="color:var(--page-accent);font-size:12px;opacity:0.5;"></i>
                            </div>

                            <!-- RAC: phí rác/vệ sinh theo người (DONDV.LoaiDV = 'Dịch vụ') -->
                            <div onclick="chgQuickFill('RAC','Phí vệ sinh / rác','20000','nguoi/thang')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;color:#16a34a;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-trash-alt"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Phí vệ sinh / rác</div>
                                    <div style="font-size:11px;color:var(--mau-chu-phu);margin-top:1px;">20.000 đ / người / tháng &nbsp;·&nbsp; Mã: RAC</div>
                                </div>
                                <i class="fas fa-arrow-right" style="color:var(--page-accent);font-size:12px;opacity:0.5;"></i>
                            </div>

                            <!-- GIAT_SAY: đồng bộ DONDV.LoaiDV = 'Giặt sấy' -->
                            <div onclick="chgQuickFill('GIAT_SAY','Giặt sấy','25000','lan')"
                                 style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);cursor:pointer;transition:all 0.18s;"
                                 onmouseover="this.style.borderColor='var(--page-accent)';this.style.background='var(--page-accent-pale)'"
                                 onmouseout="this.style.borderColor='var(--mau-vien)';this.style.background='var(--mau-nen)'">
                                <div style="width:36px;height:36px;border-radius:9px;background:#fdf4ff;display:flex;align-items:center;justify-content:center;color:#a21caf;font-size:15px;flex-shrink:0;">
                                    <i class="fas fa-soap"></i>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;">Giặt sấy</div>
