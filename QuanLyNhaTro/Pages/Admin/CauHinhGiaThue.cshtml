                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Search -->
            <div style="padding:10px 14px; border-bottom:1px solid var(--mau-vien);
                background:var(--mau-nen); display:flex; align-items:center; gap:8px;">
                <i class="fas fa-search" style="color:var(--page-accent); font-size:13px;"></i>
