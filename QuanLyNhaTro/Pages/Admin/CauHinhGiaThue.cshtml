                <button onclick="dvMaDongPopup()"
                        style="padding:8px 16px; border:1.5px solid var(--mau-vien); background:none;
                    border-radius:7px; font-size:12px; font-weight:700;
                    color:var(--mau-chu-phu); cursor:pointer; font-family:inherit;">
                    Huỷ
                </button>
                <button id="dvma-btn-ok" onclick="dvMaXacNhan()" disabled
                        style="padding:8px 20px; border:none; background:var(--page-accent); color:#fff;
                    border-radius:7px; font-size:12px; font-weight:700; cursor:pointer;
                    display:flex; align-items:center; gap:6px; font-family:inherit; opacity:.5;">
                    <i class="fas fa-check"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
