    <!-- Toast container (giữ nguyên ID) -->
    <div class="toast-container" id="toastContainer"></div>

    <script>
        window.hienThiThongBao = function(noiDung, loai = 'success') {
        // Gọi ID bằng tiếng Việt
        const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
        if (!khuVucChua) return;

        // Chuyển đổi tham số type sang class tiếng Việt tương ứng
        let classMauSac = '';
        switch(loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
        case 'error': classMauSac = 'thong-bao-loi'; break;
        default: classMauSac = 'thong-bao-thanh-cong';
        }

        // Tạo phần tử DOM
        const theThongBao = document.createElement('div');
        theThongBao.className = `thong-bao-muc ${classMauSac}`;

        // Gắn HTML nội dung và nút X
        theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
        `;

        // Đẩy vào trang
        khuVucChua.appendChild(theThongBao);

        // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
        setTimeout(() => {
        if (theThongBao.parentNode) {
        theThongBao.remove();
        }
        }, 3000);
        }
        // ===========================================================
        //  QUICK FILL – điền nhanh form dịch vụ từ gợi ý
        // ===========================================================
        function chgQuickFill(ma, ten, gia, donvi) {
        document.getElementById('dv-ma').value   = ma;
        document.getElementById('dv-ten').value  = ten;
        document.getElementById('dv-gia').value  = gia;
        document.getElementById('dv-donvi').value = donvi;
        document.getElementById('dv-ma').focus();
        }
        // ===== CẬP NHẬT HUY HIỆU SIDEBAR =====
        (function() {
        const chuaHoanThanh = document.querySelectorAll('.card-su-co[data-filter*="chua-hoan-thanh"]').length;
        const el = document.getElementById('huy-hieu-sua-chua');
        if (el) {
        el.textContent = chuaHoanThanh > 0 ? chuaHoanThanh : '';
        el.style.display = chuaHoanThanh > 0 ? '' : 'none';
        }
        })();
        // ===========================================================
        //  TẢI LẠI DANH SÁCH DỊCH VỤ (gọi hàm từ ChuTro-cauHinh.js)
        // ===========================================================
        function chgTaiLaiDichVu() {
        if (typeof chgLoadDichVu === 'function') {
        chgLoadDichVu();
        } else {
        // Fallback nếu JS chưa load
        document.getElementById('chg-dv-list').innerHTML =
        '<div class="chg-loading"><i class="fas fa-spinner fa-spin"></i>Đang tải...</div>';
        }
        }

        // ===========================================================
        //  ĐỒNG BỘ TAB: override chgSwitch để hoạt động trên full page
        //  (ChuTro-cauHinh.js dùng chg-panel-dv / chg-panel-phong / chg-tab-dv / chg-tab-phong)
        //  Nếu JS gốc đã xử lý .show / .active thì không cần ghi đè.
        //  Đoạn này là fallback phòng trường hợp JS gốc cần #modal wrapper.
        // ===========================================================
        (function patchChgSwitch() {
        // Chờ tất cả JS load xong rồi kiểm tra
        window.addEventListener('load', function() {
        if (typeof chgSwitch !== 'function') {
        window.chgSwitch = function(tab) {
        // Panel visibility
        document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('show'));
        document.getElementById('chg-panel-' + tab).classList.add('show');
        // Tab active
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('chg-tab-' + tab).classList.add('active');
        };
        } else {
        // Nếu JS gốc tồn tại, wrap lại để đổi class sang content-panel
        var _orig = chgSwitch;
        window.chgSwitch = function(tab) {
        _orig(tab);
        // Đảm bảo class .show áp đúng cho content-panel (không phải chg-panel cũ trong modal)
        document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('show'));
        var panel = document.getElementById('chg-panel-' + tab);
        if (panel) panel.classList.add('show');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        var tabBtn = document.getElementById('chg-tab-' + tab);
        if (tabBtn) tabBtn.classList.add('active');
        };
        }
        });
        })();

        // ===========================================================
        //  NGÀY GIỜ (đồng bộ ChuTro.cshtml)
        // ===========================================================
        (function() {
        // không cần hiển thị ở page này, nhưng đảm bảo không lỗi
        var el = document.getElementById('ngay-gio-chu-tro');
        if (el) {
        var ngay = new Date();
        var t = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        el.textContent = t[ngay.getDay()] + ', ' + ngay.getDate() + ' tháng ' + (ngay.getMonth()+1) + ' năm ' + ngay.getFullYear();
        }
        })();

        // ===========================================================
        //  ADMIN DROPDOWN (đồng bộ ChuTro.cshtml)
        // ===========================================================
        function toggleAdminMenu() {
        var dd = document.getElementById('adminDropdown');
        var chevron = document.getElementById('adminChevron');
        if (dd) dd.classList.toggle('show');
        if (chevron) chevron.style.transform = dd && dd.classList.contains('show') ? 'rotate(180deg)' : 'rotate(0deg)';
        }
        document.addEventListener('click', function(e) {
        var wrap = document.getElementById('adminHeaderWrap');
        if (wrap && !wrap.contains(e.target)) {
        var dd = document.getElementById('adminDropdown');
        var chevron = document.getElementById('adminChevron');
        if (dd) dd.classList.remove('show');
        if (chevron) chevron.style.transform = 'rotate(0deg)';
        }
        });
    </script>
    <!--Các mã dịch vụ-->
