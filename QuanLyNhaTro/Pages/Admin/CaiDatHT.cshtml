@page "/Admin/CaiDatHT"
@model QuanLyNhaTro.Pages.Admin.CaiDatModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cài Đặt Hệ Thống – Nhà Trọ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            /* ==========================================================
                       IMPORT FONT – đồng bộ với ChuTro.cshtml
                    ========================================================== */
            @@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap');

            /* ==========================================================
                       BIẾN MÀU & THIẾT KẾ – bản sao từ ChuTro.cshtml
                    ========================================================== */
            :root {
                --mau-chu-de: #b8720a;
                --mau-chu-de-sang: #e8971c;
                --mau-chu-de-nhat: #fdf6e3;
                --mau-chu-de-vien: rgba(184,114,10,0.15);
                --mau-sidebar: #0d1b2e;
                --mau-sidebar-dam: #081020;
                --mau-sidebar-vien: rgba(255,255,255,0.06);
                --mau-sidebar-hover: rgba(232,151,28,0.12);
                --mau-sidebar-active: rgba(232,151,28,0.18);
                --mau-nen: #f0f2f8;
                --mau-trang: #ffffff;
                --mau-chu: #111827;
                --mau-chu-phu: #6b7a99;
                --mau-vien: #e5e9f5;
                --mau-xanh: #0ea271;
                --mau-xanh-nhat: #ecfdf5;
                --mau-do: #e53e3e;
                --mau-do-nhat: #fff5f5;
                --bong-card: 0 2px 12px rgba(13,27,46,0.06), 0 1px 3px rgba(13,27,46,0.04);
                --bong-sidebar: 6px 0 32px rgba(0,0,0,0.3);
                --bong-header: 0 1px 0 #e5e9f5, 0 2px 16px rgba(13,27,46,0.04);
                --radius-sm: 8px;
                --radius-md: 12px;
                --radius-lg: 16px;
                --radius-full: 9999px;
            }

            /* ==========================================================
                       RESET & CƠ BẢN
                    ========================================================== */
            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Be Vietnam Pro', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: clip;
                -webkit-font-smoothing: antialiased;
            }

            /* ==========================================================
                       SIDEBAR – THANH ĐIỀU HƯỚNG TRÁI (đồng bộ ChuTro)
                    ========================================================== */
            #thanh-sidebar {
                width: 248px;
                min-width: 248px;
                background: var(--mau-sidebar);
                display: flex;
                flex-direction: column;
                height: 100vh;
                z-index: 100;
                box-shadow: var(--bong-sidebar);
                overflow-y: auto;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
                position: relative;
                border-right: 1px solid rgba(255,255,255,0.04);
            }

                #thanh-sidebar.an {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

                #thanh-sidebar::-webkit-scrollbar {
                    width: 0;
                }

            /* Logo khu vực trên */
            .khu-vuc-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 24px 20px 20px;
                border-bottom: 1px solid var(--mau-sidebar-vien);
            }

            .bieu-tuong-logo {
                width: 40px;
                height: 40px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                color: #fff;
                box-shadow: 0 4px 14px rgba(184,114,10,0.45);
            }

            .ten-logo strong {
                display: block;
                color: #fff;
                font-size: 13.5px;
                font-weight: 800;
                letter-spacing: 0.2px;
            }

            .ten-logo span {
                font-size: 10px;
                color: rgba(255,255,255,0.32);
                letter-spacing: 0.3px;
            }

            /* Nhãn nhóm menu */
            .nhan-nhom-menu {
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 2px;
                color: rgba(255,255,255,0.22);
                text-transform: uppercase;
                padding: 18px 20px 6px;
            }

            /* Mỗi mục menu */
            .muc-menu {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 14px 9px 16px;
                color: rgba(255,255,255,0.52);
                cursor: pointer;
                border-radius: 0 var(--radius-full) var(--radius-full) 0;
                margin: 1px 12px 1px 0;
                transition: all 0.18s ease;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                position: relative;
            }

                .muc-menu i {
                    width: 18px;
                    text-align: center;
                    font-size: 13px;
                    opacity: 0.75;
                    flex-shrink: 0;
                    transition: opacity 0.18s;
                }

                .muc-menu:hover {
                    background: var(--mau-sidebar-hover);
                    color: rgba(255,255,255,0.9);
                }

                    .muc-menu:hover i {
                        opacity: 1;
                    }

                /* Menu đang chọn */
                .muc-menu.dang-chon {
                    background: var(--mau-sidebar-active);
                    color: #fff;
                    font-weight: 700;
                }

                    .muc-menu.dang-chon i {
                        opacity: 1;
                        color: var(--mau-chu-de-sang);
                    }

                    .muc-menu.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 60%;
                        width: 3px;
                        background: var(--mau-chu-de-sang);
                        border-radius: 0 3px 3px 0;
                    }

            /* Badge số */
            .huy-hieu {
                margin-left: auto;
                background: rgba(239,68,68,0.85);
                color: #fff;
                font-size: 9.5px;
                font-weight: 800;
                border-radius: var(--radius-full);
                padding: 2px 7px;
                min-width: 18px;
                text-align: center;
            }

                .huy-hieu.vang {
                    background: var(--mau-chu-de);
                }

            /* Thông tin chủ trọ dưới đáy sidebar */
            .thong-tin-chu-tro {
                margin-top: auto;
                padding: 14px 16px;
                border-top: 1px solid var(--mau-sidebar-vien);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                flex-shrink: 0;
                position: sticky;
                bottom: 0;
                background: var(--mau-sidebar-dam);
                z-index: 1;
                transition: background 0.18s;
            }

                .thong-tin-chu-tro:hover {
                    background: rgba(255,255,255,0.04);
                }

            .anh-chu-tro {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 15px;
                font-weight: 800;
            }

            .ten-chu strong {
                display: block;
                color: #fff;
                font-size: 12.5px;
                font-weight: 700;
            }

            .ten-chu span {
                color: rgba(255,255,255,0.35);
                font-size: 10px;
            }

            /* ==========================================================
                       KHU VỰC CHÍNH – BÊN PHẢI
                    ========================================================== */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* HEADER */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 62px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: var(--bong-header);
                flex-shrink: 0;
                z-index: 50;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .nut-ham-burger {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: var(--radius-sm);
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .nut-ham-burger:hover {
                    background: var(--mau-chu-de-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-header {
                font-size: 14.5px;
                font-weight: 800;
                color: var(--mau-chu);
                font-family: 'Lexend',sans-serif;
            }

            .duong-dan-header {
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-top: 1px;
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .the-chu-tro {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                font-size: 9.5px;
                font-weight: 800;
                padding: 3px 10px;
                border-radius: var(--radius-full);
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .khoi-admin-header {
                display: flex;
                align-items: center;
                gap: 9px;
            }

            .anh-dai-dien-header {
                width: 34px;
                height: 34px;
                border-radius: var(--radius-sm);
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 13px;
                font-weight: 800;
            }

            .ten-admin-header {
                font-size: 12.5px;
                font-weight: 700;
            }

            .vai-tro-header {
                font-size: 10px;
                color: var(--mau-chu-phu);
            }

            /* ==========================================================
                       NỘI DUNG TRANG CÀI ĐẶT
                    ========================================================== */
            #noi-dung-chinh {
                flex: 1;
                overflow-y: auto;
                padding: 28px 32px 40px;
            }

                #noi-dung-chinh::-webkit-scrollbar {
                    width: 5px;
                }

                #noi-dung-chinh::-webkit-scrollbar-thumb {
                    background: #d4d9e6;
                    border-radius: 3px;
                }

            /* Tiêu đề trang */
            .tieu-de-trang {
                margin-bottom: 28px;
            }

                .tieu-de-trang h2 {
                    font-size: 22px;
                    font-weight: 900;
                    font-family: 'Lexend',sans-serif;
                    color: var(--mau-chu);
                }

                .tieu-de-trang p {
                    font-size: 12px;
                    color: var(--mau-chu-phu);
                    margin-top: 5px;
                }

            /* Lưới 2 cột cài đặt */
            .luoi-cai-dat {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
                max-width: 960px;
            }

            @@media (max-width:768px) {
                .luoi-cai-dat {
                    grid-template-columns: 1fr;
                }
            }

            /* Card cài đặt chung */
            .card-cai-dat {
                background: var(--mau-trang);
                border-radius: var(--radius-lg);
                border: 1.5px solid var(--mau-vien);
                box-shadow: var(--bong-card);
                overflow: hidden;
                transition: box-shadow 0.2s;
            }

                .card-cai-dat:hover {
                    box-shadow: 0 6px 24px rgba(13,27,46,0.09);
                }

            /* Header của mỗi card */
            .dau-card {
                padding: 18px 22px 14px;
                border-bottom: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .bieu-tuong-card {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                color: #fff;
            }

                .bieu-tuong-card.vang {
                    background: linear-gradient(135deg,#b8720a,#e8971c);
                    box-shadow: 0 4px 12px rgba(184,114,10,0.3);
                }

                .bieu-tuong-card.do {
                    background: linear-gradient(135deg,#dc2626,#ef4444);
                    box-shadow: 0 4px 12px rgba(220,38,38,0.3);
                }

                .bieu-tuong-card.xanh-la {
                    background: linear-gradient(135deg,#059669,#10b981);
                    box-shadow: 0 4px 12px rgba(5,150,105,0.3);
                }

            .tieu-de-card h3 {
                font-size: 14px;
                font-weight: 800;
                font-family: 'Lexend',sans-serif;
                color: var(--mau-chu);
            }

            .tieu-de-card p {
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-top: 2px;
            }

            /* Thân card */
            .than-card {
                padding: 20px 22px;
            }

            /* Nhóm nhập liệu */
            .nhom-nhap {
                margin-bottom: 16px;
            }

                .nhom-nhap:last-child {
                    margin-bottom: 0;
                }

            .nhan-nhap {
                display: block;
                font-size: 12px;
                font-weight: 700;
                color: var(--mau-chu);
                margin-bottom: 7px;
            }

                .nhan-nhap .bat-buoc {
                    color: #dc2626;
                    margin-left: 2px;
                }

            /* Ô nhập */
            .o-nhap {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--mau-vien);
                border-radius: var(--radius-md);
                font-size: 13px;
                font-family: inherit;
                color: var(--mau-chu);
                background: var(--mau-nen);
                transition: all 0.2s;
                outline: none;
            }

                .o-nhap:focus {
                    border-color: var(--mau-chu-de);
                    background: #fff;
                    box-shadow: 0 0 0 3px var(--mau-chu-de-vien);
                }

                .o-nhap::placeholder {
                    color: var(--mau-chu-phu);
                }

            /* Wrapper ô mật khẩu có nút mắt */
            .o-mat-khau {
                position: relative;
            }

                .o-mat-khau .o-nhap {
                    padding-right: 42px;
                }

            .nut-hien-mat-khau {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: var(--mau-chu-phu);
                font-size: 13px;
                padding: 2px;
                transition: color 0.2s;
            }

                .nut-hien-mat-khau:hover {
                    color: var(--mau-chu-de);
                }

            /* Thanh mạnh mật khẩu */
            .thanh-mat-khau {
                margin-top: 8px;
            }

            .nhan-mat-khau {
                display: flex;
                justify-content: space-between;
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-bottom: 5px;
            }

            .vach-mat-khau {
                display: flex;
                gap: 4px;
            }

            .doan-mat-khau {
                flex: 1;
                height: 4px;
                border-radius: 2px;
                background: #e5e9f5;
                transition: background 0.35s;
            }

            /* Ghi chú nhỏ */
            .ghi-chu-nhap {
                font-size: 10.5px;
                color: var(--mau-chu-phu);
                margin-top: 5px;
            }

            /* Nút hành động */
            .nut-hanh-dong {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 11px 22px;
                border-radius: var(--radius-md);
                font-size: 13px;
                font-weight: 700;
                font-family: inherit;
                cursor: pointer;
                border: none;
                transition: all 0.2s;
            }

                .nut-hanh-dong.chinh {
                    background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                    color: #fff;
                    box-shadow: 0 4px 14px rgba(184,114,10,0.32);
                    width: 100%;
                    justify-content: center;
                    margin-top: 4px;
                }

                    .nut-hanh-dong.chinh:hover {
                        transform: translateY(-1px);
                        box-shadow: 0 6px 20px rgba(184,114,10,0.44);
                    }

                    .nut-hanh-dong.chinh:active {
                        transform: none;
                    }

                    .nut-hanh-dong.chinh:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                        transform: none;
                    }

                .nut-hanh-dong.nguy-hiem {
                    background: linear-gradient(135deg,#dc2626,#ef4444);
                    color: #fff;
                    box-shadow: 0 4px 14px rgba(220,38,38,0.32);
                    width: 100%;
                    justify-content: center;
                    margin-top: 4px;
                }

                    .nut-hanh-dong.nguy-hiem:hover {
                        transform: translateY(-1px);
                        box-shadow: 0 6px 20px rgba(220,38,38,0.44);
                    }

            /* Đường kẻ phân cách */
            .duong-ke {
                height: 1px;
                background: var(--mau-vien);
                margin: 16px 0;
            }

            /* Card thông tin tài khoản – chỉ đọc */
            .hang-thong-tin {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid var(--mau-vien);
            }

                .hang-thong-tin:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

            .nhan-tt {
                font-size: 11.5px;
                color: var(--mau-chu-phu);
                font-weight: 600;
            }

            .gia-tri-tt {
                font-size: 13px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .the-trang-thai {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 3px 10px;
                border-radius: var(--radius-full);
                font-size: 11px;
                font-weight: 700;
            }

                .the-trang-thai.hoat-dong {
                    background: var(--mau-xanh-nhat);
                    color: #0a7c57;
                }

                .the-trang-thai::before {
                    content: '';
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: currentColor;
                }

            /* Thông báo toast */
            #vung-thong-bao {
                position: fixed;
                top: 24px;
                right: 24px;
                display: flex;
                flex-direction: column;
                gap: 10px;
                z-index: 99999;
            }

            .thong-bao {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 13px 18px;
                border-radius: var(--radius-md);
                font-size: 13px;
                font-weight: 600;
                min-width: 300px;
                box-shadow: 0 8px 28px rgba(13,27,46,0.14);
                animation: truotVao 0.3s ease forwards;
            }

                .thong-bao.thanh-cong {
                    background: #fff;
                    border-left: 4px solid var(--mau-xanh);
                    color: var(--mau-chu);
                }

                .thong-bao.that-bai {
                    background: #fff;
                    border-left: 4px solid var(--mau-do);
                    color: var(--mau-chu);
                }

                .thong-bao i.thanh-cong-icon {
                    color: var(--mau-xanh);
                    font-size: 15px;
                }

                .thong-bao i.that-bai-icon {
                    color: var(--mau-do);
                    font-size: 15px;
                }

            @@keyframes truotVao {
                from {
                    opacity: 0;
                    transform: translateX(30px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes truotRa {
                from {
                    opacity: 1;
                    transform: translateX(0);
                }

                to {
                    opacity: 0;
                    transform: translateX(30px);
                }
            }

            /* Loading spinner nhỏ trong nút */
            .vong-tai {
                display: inline-block;
                width: 14px;
                height: 14px;
                border: 2px solid rgba(255,255,255,0.4);
                border-top-color: #fff;
                border-radius: 50%;
                animation: quay 0.7s linear infinite;
            }

            @@keyframes quay {
                to {
                    transform: rotate(360deg);
                }
            }

            /* Modal xác nhận đăng xuất */
            .lop-phu-modal {
                position: fixed;
                inset: 0;
                background: rgba(13,27,46,0.55);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 9999;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.2s;
            }

                .lop-phu-modal.hien {
                    opacity: 1;
                    pointer-events: all;
                }

            .hop-modal-xac-nhan {
                background: #fff;
                border-radius: var(--radius-lg);
                padding: 28px;
                width: 380px;
                max-width: 90vw;
                box-shadow: 0 20px 60px rgba(13,27,46,0.22);
                transform: scale(0.94) translateY(-8px);
                transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
            }

            .lop-phu-modal.hien .hop-modal-xac-nhan {
                transform: scale(1) translateY(0);
            }

            .bieu-tuong-modal-xac-nhan {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: var(--mau-do-nhat);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: var(--mau-do);
                margin: 0 auto 16px;
            }

            .tieu-de-modal-xac-nhan {
                text-align: center;
                font-size: 16px;
                font-weight: 800;
                font-family: 'Lexend',sans-serif;
            }

            .mo-ta-modal-xac-nhan {
                text-align: center;
                font-size: 12.5px;
                color: var(--mau-chu-phu);
                margin-top: 6px;
                line-height: 1.6;
            }

            .nhom-nut-modal {
                display: flex;
                gap: 10px;
                margin-top: 22px;
            }

            .nut-huy-modal {
                flex: 1;
                padding: 11px;
                border: 1.5px solid var(--mau-vien);
