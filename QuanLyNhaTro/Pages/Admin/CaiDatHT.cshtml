@page "/Admin/CaiDatHT"
@model QuanLyNhaTro.Pages.Admin.CaiDatModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cài Đặt Hệ Thống – Nhà Trọ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/CaiDatHT.css" asp-append-version="true" />
</head>
<body>

    <!-- ==========================================================
         SIDEBAR – THANH ĐIỀU HƯỚNG TRÁI (đồng bộ ChuTro.cshtml)
    ========================================================== -->
    <nav id="thanh-sidebar">

        <!-- Logo -->
        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo">
                <i class="fas fa-crown"></i>
            </div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <!-- Nhóm: Tổng quan -->
        <div class="nhan-nhom-menu">Tổng quan</div>

        <a class="muc-menu" href="/Admin/ChuTro">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </a>

        <!-- Nhóm: Vận hành -->
        <div class="nhan-nhom-menu">Vận hành</div>

        <a class="muc-menu" href="/Admin/QuanLyPhong">
            <i class="fas fa-building"></i>
            <span>Quản lý phòng trọ</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyNguoiThue">
            <i class="fas fa-users"></i>
            <span>Người thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyHopDong">
            <i class="fas fa-file-contract"></i>
            <span>Hợp đồng</span>
            <span class="huy-hieu vang">2</span>
        </a>

        <!-- Nhóm: Quản trị chủ trọ -->
        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>

        <a class="muc-menu" href="/Admin/Taikhoanquanly">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyNguoiThue">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/CauHinhGiaThue">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/DichVuThongBao">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </a>

        <!-- Nhóm: Hỗ trợ -->
        <div class="nhan-nhom-menu">Hỗ trợ</div>

        <a class="muc-menu" href="/Admin/SuCoBaoTri">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            <span class="huy-hieu" id="huy-hieu-sua-chua">-</span>
        </a>
        <a class="muc-menu" href="/Admin/ThongKe">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </a>
        <!-- MỤC CÀI ĐẶT – đang chọn -->
        <a class="muc-menu dang-chon" href="/Admin/CaiDatHT">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </a>

        <!-- Thông tin chủ trọ dưới đáy -->
        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro" id="sidebar-chu-viet-tat">C</div>
            <div class="ten-chu">
                <strong id="sidebar-ten-chu">Đang tải...</strong>
                <span id="sidebar-vai-tro">Chủ sở hữu</span>
            </div>
        </div>

    </nav>
    <!-- Kết thúc SIDEBAR -->
    <!-- ==========================================================
         KHU VỰC CHÍNH – BÊN PHẢI
    ========================================================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Cài Đặt Hệ Thống</div>
                    <div class="duong-dan-header">Trang chủ / Cài đặt</div>
                </div>
            </div>

            <div class="header-phai">
                <span class="the-chu-tro">
                    <i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ
                </span>
                <div class="khoi-admin-header">
                    <div class="anh-dai-dien-header" id="header-chu-viet-tat">C</div>
                    <div>
                        <div class="ten-admin-header" id="header-ten-chu">Đang tải...</div>
                        <div class="vai-tro-header" id="header-vai-tro">Chủ sở hữu</div>
                    </div>
                </div>
            </div>
        </header>
        <!-- Kết thúc HEADER -->
        <!-- ==========================================================
             NỘI DUNG TRANG CÀI ĐẶT
        ========================================================== -->
        <main id="noi-dung-chinh">

            <!-- Tiêu đề trang -->
            <div class="tieu-de-trang">
                <h2>⚙️ Cài đặt hệ thống</h2>
                <p>Quản lý tài khoản và bảo mật đăng nhập của bạn</p>
            </div>

            <!-- Lưới 2 cột: đổi mật khẩu | thông tin tài khoản + đăng xuất -->
            <div class="luoi-cai-dat">

                <!-- ==================================================
                     CỘT TRÁI – CARD ĐỔI MẬT KHẨU
                ================================================== -->
                <div class="card-cai-dat">

                    <!-- Header card -->
                    <div class="dau-card">
                        <div class="bieu-tuong-card vang">
                            <i class="fas fa-key"></i>
                        </div>
                        <div class="tieu-de-card">
                            <h3>Đổi mật khẩu</h3>
                            <p>Cập nhật mật khẩu đăng nhập của bạn</p>
                        </div>
                    </div>

                    <!-- Thân card – form đổi mật khẩu -->
                    <div class="than-card">

                        <!-- Banner gợi ý bảo mật -->
                        <div class="bang-thong-tin-quyen vang">
                            <i class="fas fa-shield-alt" style="color:var(--mau-chu-de);"></i>
                            <span>Mật khẩu được mã hóa bằng <strong>BCrypt</strong> trước khi lưu vào cơ sở dữ liệu. Hãy chọn mật khẩu ít nhất 8 ký tự.</span>
                        </div>

                        <!-- Ô mật khẩu hiện tại -->
                        <div class="nhom-nhap">
                            <label class="nhan-nhap" for="mat-khau-cu">
                                Mật khẩu hiện tại <span class="bat-buoc">*</span>
                            </label>
                            <div class="o-mat-khau">
                                <input class="o-nhap" type="password" id="mat-khau-cu"
                                       placeholder="Nhập mật khẩu hiện tại..." />
                                <button type="button" class="nut-hien-mat-khau"
                                        onclick="batTatMatKhau('mat-khau-cu', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Ô mật khẩu mới -->
                        <div class="nhom-nhap">
                            <label class="nhan-nhap" for="mat-khau-moi">
                                Mật khẩu mới <span class="bat-buoc">*</span>
                            </label>
                            <div class="o-mat-khau">
                                <input class="o-nhap" type="password" id="mat-khau-moi"
                                       placeholder="Tối thiểu 8 ký tự..."
                                       oninput="kiemTraMatKhauMoi(this.value)" />
                                <button type="button" class="nut-hien-mat-khau"
                                        onclick="batTatMatKhau('mat-khau-moi', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <!-- Thanh độ mạnh mật khẩu -->
                            <div class="thanh-mat-khau">
                                <div class="nhan-mat-khau">
                                    <span>Độ mạnh</span>
                                    <span id="nhan-do-manh">Chưa nhập</span>
                                </div>
                                <div class="vach-mat-khau">
                                    <div class="doan-mat-khau" id="doan-1"></div>
                                    <div class="doan-mat-khau" id="doan-2"></div>
                                    <div class="doan-mat-khau" id="doan-3"></div>
                                    <div class="doan-mat-khau" id="doan-4"></div>
                                </div>
                            </div>
                            <div class="ghi-chu-nhap">Nên dùng chữ hoa, chữ thường, số và ký tự đặc biệt</div>
                        </div>

                        <!-- Ô xác nhận mật khẩu mới -->
                        <div class="nhom-nhap">
                            <label class="nhan-nhap" for="xac-nhan-mat-khau">
                                Xác nhận mật khẩu mới <span class="bat-buoc">*</span>
                            </label>
                            <div class="o-mat-khau">
                                <input class="o-nhap" type="password" id="xac-nhan-mat-khau"
                                       placeholder="Nhập lại mật khẩu mới..." />
                                <button type="button" class="nut-hien-mat-khau"
                                        onclick="batTatMatKhau('xac-nhan-mat-khau', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Nút đổi mật khẩu -->
                        <button class="nut-hanh-dong chinh" id="nut-doi-mat-khau" onclick="doiMatKhau()">
                            <i class="fas fa-save"></i>
                            <span id="nhan-nut-doi">Lưu mật khẩu mới</span>
                        </button>

                    </div>
                </div><!-- Kết thúc CARD ĐỔI MẬT KHẨU -->
                <!-- ==================================================
                     CỘT PHẢI – THÔNG TIN TÀI KHOẢN + ĐĂNG XUẤT
                ================================================== -->
                <div style="display:flex; flex-direction:column; gap:24px;">

                    <!-- Card thông tin tài khoản -->
                    <div class="card-cai-dat">

                        <!-- Header card -->
                        <div class="dau-card">
                            <div class="bieu-tuong-card xanh-la">
                                <i class="fas fa-id-badge"></i>
                            </div>
                            <div class="tieu-de-card">
                                <h3>Thông tin tài khoản</h3>
                                <p>Thông tin hiển thị từ cơ sở dữ liệu</p>
                            </div>
                        </div>

                        <!-- Thân card – các hàng thông tin (render từ server) -->
                        <div class="than-card">
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Họ và tên</span>
                                <span class="gia-tri-tt" id="hien-thi-ten">@Model.TenHienThi</span>
                            </div>
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Tên đăng nhập</span>
                                <span class="gia-tri-tt" id="hien-thi-username">@Model.UserName</span>
                            </div>
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Số điện thoại</span>
                                <span class="gia-tri-tt" id="hien-thi-sdt">@Model.SoDienThoai</span>
                            </div>
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Email</span>
                                <span class="gia-tri-tt" id="hien-thi-email">@(Model.Email ?? "Chưa cập nhật")</span>
                            </div>
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Vai trò</span>
                                <span class="gia-tri-tt">@Model.VaiTro</span>
                            </div>
                            <div class="hang-thong-tin">
                                <span class="nhan-tt">Trạng thái</span>
                                <span class="the-trang-thai hoat-dong">Đang hoạt động</span>
                            </div>
                            <div class="hang-thong-tin" style="border-bottom:none;padding-bottom:0;">
                                <span class="nhan-tt">Ngày tạo</span>
                                <span class="gia-tri-tt">@Model.NgayTao.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div><!-- Kết thúc thân card thông tin -->

                    </div><!-- Kết thúc CARD THÔNG TIN TÀI KHOẢN -->
                    <!-- Card đăng xuất -->
                    <div class="card-cai-dat">

                        <!-- Header card -->
                        <div class="dau-card">
                            <div class="bieu-tuong-card do">
                                <i class="fas fa-sign-out-alt"></i>
                            </div>
                            <div class="tieu-de-card">
                                <h3>Đăng xuất hệ thống</h3>
                                <p>Kết thúc phiên làm việc hiện tại</p>
                            </div>
                        </div>

                        <!-- Thân card đăng xuất -->
                        <div class="than-card">
                            <p style="font-size:13px; color:var(--mau-chu-phu); line-height:1.7; margin-bottom:16px;">
                                Bấm nút bên dưới để thoát khỏi hệ thống. Cookie xác thực sẽ bị xóa ngay lập tức và bạn cần đăng nhập lại để tiếp tục sử dụng.
                            </p>
                            <button class="nut-hanh-dong nguy-hiem" onclick="moXacNhanDangXuat()">
                                <i class="fas fa-power-off"></i>
                                Đăng xuất ngay
                            </button>
                        </div><!-- Kết thúc thân card đăng xuất -->

                    </div><!-- Kết thúc CARD ĐĂNG XUẤT -->

                </div><!-- Kết thúc CỘT PHẢI -->

            </div><!-- Kết thúc LƯỚI 2 CỘT -->

        </main><!-- Kết thúc NỘI DUNG CHÍNH -->
    </div><!-- Kết thúc KHU VỰC CHÍNH -->
    <!-- ==========================================================
         MODAL XÁC NHẬN ĐĂNG XUẤT
    ========================================================== -->
    <div class="lop-phu-modal" id="modal-xac-nhan-dang-xuat"
         onclick="dongModalXacNhan(event)">
        <div class="hop-modal-xac-nhan">
            <div class="bieu-tuong-modal-xac-nhan">
                <i class="fas fa-sign-out-alt"></i>
            </div>
            <div class="tieu-de-modal-xac-nhan">Xác nhận đăng xuất?</div>
            <div class="mo-ta-modal-xac-nhan">
                Bạn sắp thoát khỏi hệ thống quản lý. Phiên làm việc hiện tại sẽ kết thúc và mọi thao tác chưa lưu có thể bị mất.
            </div>
            <div class="nhom-nut-modal">
                <button class="nut-huy-modal" onclick="dongModal()">Ở lại</button>
                <button class="nut-xac-nhan-dang-xuat" id="nut-xac-nhan-dang-xuat-chinh" onclick="thucHienDangXuat()">
                    <i class="fas fa-power-off"></i> Đăng xuất
                </button>
            </div>
        </div>
    </div><!-- Kết thúc MODAL XÁC NHẬN ĐĂNG XUẤT -->
    <!-- ==========================================================
         VÙNG THÔNG BÁO TOAST (góc phải trên)
    ========================================================== -->
    <div id="vung-thong-bao"></div>

    <!-- ==========================================================
         JAVASCRIPT XỬ LÝ
    ========================================================== -->
    <script>
            // ===========================================================
            // BIẾN TOÀN CỤC
            // ===========================================================
            const API_GOC = '/api';

            // ===========================================================
            // KHỞi TẠO KHI TẢI TRANG – điền thông tin từ server vào sidebar/header
            // ===========================================================
            (function khoiTaoThongTin() {
                const ten  = document.getElementById('hien-thi-ten')?.textContent?.trim() || '';
                const user = document.getElementById('hien-thi-username')?.textContent?.trim() || '';

                // Lấy chữ cái đầu viết tắt
                const viTat = ten ? ten.charAt(0).toUpperCase() : (user ? user.charAt(0).toUpperCase() : 'U');

                // Cập nhật sidebar
                const sidebarVietTat = document.getElementById('sidebar-chu-viet-tat');
                const sidebarTen     = document.getElementById('sidebar-ten-chu');
                if (sidebarVietTat) sidebarVietTat.textContent = viTat;
                if (sidebarTen)     sidebarTen.textContent     = ten || user;

                // Cập nhật header
                const headerVietTat = document.getElementById('header-chu-viet-tat');
                const headerTen     = document.getElementById('header-ten-chu');
                if (headerVietTat) headerVietTat.textContent = viTat;
                if (headerTen)     headerTen.textContent     = ten || user;
            })();
                        // ===== CẬP NHẬT HUY HIỆU SIDEBAR =====
            (function() {
              const chuaHoanThanh = document.querySelectorAll('.card-su-co[data-filter*="chua-hoan-thanh"]').length;
              const el = document.getElementById('huy-hieu-sua-chua');
              if (el) {
                el.textContent = chuaHoanThanh > 0 ? chuaHoanThanh : '';
                el.style.display = chuaHoanThanh > 0 ? '' : 'none';
              }
            })();

            // ===========================================================
            // TOGGLE SIDEBAR
            // ===========================================================
            function dongMoSidebar() {
                document.getElementById('thanh-sidebar').classList.toggle('an');
            }

            // ===========================================================
            // HIỆN / ẨN MẬT KHẨU
            // ===========================================================
            function batTatMatKhau(idO, nutBam) {
                const o = document.getElementById(idO);
                const icon = nutBam.querySelector('i');
                if (o.type === 'password') {
                    o.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    o.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            }

            // ===========================================================
            // THANH ĐỘ MẠNH MẬT KHẨU
            // ===========================================================
            function kiemTraMatKhauMoi(giaTri) {
                const doan  = [1,2,3,4].map(i => document.getElementById(`doan-${i}`));
                const nhan  = document.getElementById('nhan-do-manh');
                let diem = 0;

                if (giaTri.length >= 8)                              diem++;
                if (/[A-Z]/.test(giaTri) && /[a-z]/.test(giaTri)) diem++;
                if (/\d/.test(giaTri))                               diem++;
                if (/[^A-Za-z0-9]/.test(giaTri))                    diem++;

                const mauSac = ['#ef4444','#f97316','#eab308','#22c55e'];
                const nhanChu = ['Yếu','Trung bình','Khá','Mạnh'];

                doan.forEach((d, i) => {
                    d.style.background = i < diem ? mauSac[diem - 1] : '#e5e9f5';
                });

                if (giaTri.length === 0) {
                    nhan.textContent = 'Chưa nhập';
                    nhan.style.color = 'var(--mau-chu-phu)';
                } else {
                    nhan.textContent  = nhanChu[diem - 1] || 'Yếu';
                    nhan.style.color  = mauSac[diem - 1];
                }
            }

            // ===========================================================
            // ĐỔI MẬT KHẨU – gọi API back-end
            // ===========================================================
            async function doiMatKhau() {
                const matKhauCu      = document.getElementById('mat-khau-cu').value.trim();
                const matKhauMoi     = document.getElementById('mat-khau-moi').value.trim();
                const xacNhanMatKhau = document.getElementById('xac-nhan-mat-khau').value.trim();

                // Kiểm tra phía client
                if (!matKhauCu || !matKhauMoi || !xacNhanMatKhau) {
                    hienThongBao('Vui lòng điền đầy đủ tất cả các trường!', 'that-bai');
                    return;
                }
                if (matKhauMoi.length < 8) {
                    hienThongBao('Mật khẩu mới phải có ít nhất 8 ký tự!', 'that-bai');
                    return;
                }
                if (matKhauMoi !== xacNhanMatKhau) {
                    hienThongBao('Mật khẩu xác nhận không khớp!', 'that-bai');
                    return;
                }

                // Hiển thị trạng thái đang tải
                const nut   = document.getElementById('nut-doi-mat-khau');
                const nhan  = document.getElementById('nhan-nut-doi');
                nut.disabled  = true;
                nhan.innerHTML = '<span class="vong-tai"></span> Đang cập nhật...';

                try {
                    // Gọi API đổi mật khẩu
                    const phanHoi = await fetch(`${API_GOC}/CaiDatTaiKhoan/DoiMatKhau`, {
                        method : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body   : JSON.stringify({
                            matKhauHienTai : matKhauCu,
                            matKhauMoi     : matKhauMoi,
                            xacNhanMatKhau : xacNhanMatKhau
                        })
                    });

                    const ketQua = await phanHoi.json();

                    if (phanHoi.ok) {
                        hienThongBao(ketQua.message || 'Đổi mật khẩu thành công!', 'thanh-cong');
                        // Xóa các ô nhập sau khi thành công
                        ['mat-khau-cu','mat-khau-moi','xac-nhan-mat-khau'].forEach(id => {
                            document.getElementById(id).value = '';
                        });
                        kiemTraMatKhauMoi(''); // reset thanh độ mạnh
                    } else {
                        hienThongBao(ketQua.message || 'Đổi mật khẩu thất bại!', 'that-bai');
                    }
                } catch (loi) {
                    hienThongBao('Lỗi kết nối đến máy chủ. Vui lòng thử lại!', 'that-bai');
                } finally {
                    nut.disabled   = false;
                    nhan.textContent = 'Lưu mật khẩu mới';
                }
            }

            // ===========================================================
            // MỞ MODAL XÁC NHẬN ĐĂNG XUẤT
            // ===========================================================
            function moXacNhanDangXuat() {
                document.getElementById('modal-xac-nhan-dang-xuat').classList.add('hien');
            }

            // ===========================================================
            // ĐÓNG MODAL KHI BẤM RA NGOÀI
            // ===========================================================
            function dongModalXacNhan(su_kien) {
                if (su_kien.target === document.getElementById('modal-xac-nhan-dang-xuat')) {
                    dongModal();
                }
            }
            function dongModal() {
                document.getElementById('modal-xac-nhan-dang-xuat').classList.remove('hien');
            }

            // ===========================================================
            // THỰC HIỆN ĐĂNG XUẤT – gọi API XuLyDangNhap/DangXuat
            // ===========================================================
            async function thucHienDangXuat() {
                const nut = document.getElementById('nut-xac-nhan-dang-xuat-chinh');
                nut.disabled     = true;
                nut.innerHTML    = '<span class="vong-tai"></span> Đang đăng xuất...';

                try {
                    const phanHoi = await fetch('/api/XuLyDangNhap/DangXuat', {
                        method : 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (phanHoi.ok) {
                        // Chuyển hướng về trang đăng nhập sau khi xóa cookie
                        window.location.href = '/DangNhap';
                    } else {
                        hienThongBao('Đăng xuất thất bại. Vui lòng thử lại!', 'that-bai');
                        nut.disabled  = false;
                        nut.innerHTML = '<i class="fas fa-power-off"></i> Đăng xuất';
                        dongModal();
                    }
                } catch (loi) {
                    hienThongBao('Lỗi kết nối. Vui lòng thử lại!', 'that-bai');
                    nut.disabled  = false;
                    nut.innerHTML = '<i class="fas fa-power-off"></i> Đăng xuất';
                    dongModal();
                }
            }

            // ===========================================================
            // HÀM HIỆN TOAST THÔNG BÁO
            // ===========================================================
            function hienThongBao(noiDung, loai) {
                const vung = document.getElementById('vung-thong-bao');
                const hop  = document.createElement('div');
                const icon = loai === 'thanh-cong'
                    ? '<i class="fas fa-check-circle thanh-cong-icon"></i>'
                    : '<i class="fas fa-times-circle that-bai-icon"></i>';

                hop.className   = `thong-bao ${loai}`;
                hop.innerHTML   = `${icon}<span>${noiDung}</span>`;
                vung.appendChild(hop);

                // Tự ẩn sau 3.5 giây
                setTimeout(() => {
                    hop.style.animation = 'truotRa 0.3s ease forwards';
                    setTimeout(() => hop.remove(), 300);
                }, 3500);
            }

            // ===========================================================
            // BẮT PHÍM ENTER TRÊN FORM ĐỔI MẬT KHẨU
            // ===========================================================
            ['mat-khau-cu','mat-khau-moi','xac-nhan-mat-khau'].forEach(id => {
                document.getElementById(id)?.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') doiMatKhau();
                });
            });
                        window.hienThiThongBao = function(noiDung, loai = 'success') {
                // Gọi ID bằng tiếng Việt
                const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
                if (!khuVucChua) return;

                // Chuyển đổi tham số type sang class tiếng Việt tương ứng
                let classMauSac = '';
                switch(loai) {
                    case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
                    case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
                    case 'error': classMauSac = 'thong-bao-loi'; break;
                    default: classMauSac = 'thong-bao-thanh-cong';
                }

                // Tạo phần tử DOM
                const theThongBao = document.createElement('div');
                theThongBao.className = `thong-bao-muc ${classMauSac}`;
    
                // Gắn HTML nội dung và nút X
                theThongBao.innerHTML = `
                    <span>${noiDung}</span>
                    <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
                `;

                // Đẩy vào trang
                khuVucChua.appendChild(theThongBao);

                // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
                setTimeout(() => {
                    if (theThongBao.parentNode) {
                        theThongBao.remove();
                    }
                }, 3000);
            }
    </script>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
