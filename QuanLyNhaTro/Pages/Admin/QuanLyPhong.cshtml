    </nav><!-- Kết thúc SIDEBAR -->
    <!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()" title="Ẩn/hiện sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Quản Lý Phòng Trọ</div>
                    <div class="duong-dan-header">Trang chủ › Vận hành › Quản lý phòng</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm nhanh..." />
                </div>

                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">3</span>
                </button>

                <div class="header-divider"></div>
                <span class="the-chu-tro">CHỦ TRỌ</span>

                <div class="khoi-admin-header" id="adminHeaderWrap" onclick="toggleAdminMenu()">
                    <div class="anh-dai-dien-header">C</div>
                    <div>
                        <div class="ten-admin-header">Chủ Trọ ABC</div>
                        <div class="vai-tro-header">Chủ sở hữu</div>
                    </div>
                    <i class="fas fa-chevron-down" id="adminChevron" style="font-size:11px;color:var(--mau-chu-phu);transition:transform 0.2s;"></i>

                    <!-- Dropdown -->
                    <div class="admin-dropdown" id="adminDropdown">
                        <div class="add-header">
                            <div class="add-header-avatar">C</div>
                            <div>
                                <div class="add-header-name">Chủ Trọ ABC</div>
                                <div class="add-header-email" id="dd-email">admin@example.com</div>
                                <div class="add-header-badge"><i class="fas fa-crown" style="font-size:8px;"></i> CHỦ TRỌ</div>
                            </div>
                        </div>
                        <div class="add-body">
                            <button class="add-item" onclick="moDoiMatKhau()">
                                <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="add-item-label">Đổi mật khẩu</div>
                                    <div class="add-item-sub">Cập nhật thông tin bảo mật</div>
                                </div>
                            </button>
                            <div class="add-divider"></div>
                            <button class="add-item danger" onclick="xacNhanDangXuat()">
                                <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="add-item-label">Đăng xuất</div>
                                    <div class="add-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH -->
        <main id="noi-dung-chinh">

            @* ── TIÊU ĐỀ TRANG ── *@
            <div class="dong-tieu-de-trang">
                <div>
                    <h2><i class="fas fa-door-open" style="color:var(--mau-chu-de);font-size:18px;margin-right:8px;"></i>Quản Lý Phòng</h2>
                    <p>Xem, thêm mới, chỉnh sửa và theo dõi trạng thái toàn bộ phòng trọ</p>
                </div>
                <button class="nut-hanh-dong-chinh" onclick="moModalThemPhong()">
                    <i class="fas fa-plus"></i> Thêm phòng mới
                </button>
            </div>

            @* ── THỐNG KÊ TÓM TẮT ── *@
            <div class="hang-tom-tat-phong">
                <div class="the-tom-tat-phong">
                    <div class="bieu-tuong-tom-tat mau-cam-nhat"><i class="fas fa-layer-group"></i></div>
                    <div class="noi-dung-tom-tat">
                        <div class="con-so" id="ttong-so-phong">@Model.TongSoPhong</div>
                        <div class="mo-ta">Tổng số phòng</div>
                    </div>
                </div>
                <div class="the-tom-tat-phong">
                    <div class="bieu-tuong-tom-tat mau-luc-nhat"><i class="fas fa-door-open"></i></div>
                    <div class="noi-dung-tom-tat">
                        <div class="con-so" style="color:var(--mau-xanh);" id="ttong-phong-trong">@Model.SoPhongTrong</div>
                        <div class="mo-ta">Phòng trống</div>
                    </div>
                </div>
                <div class="the-tom-tat-phong">
                    <div class="bieu-tuong-tom-tat mau-xanh-nhat-icon"><i class="fas fa-user-check"></i></div>
                    <div class="noi-dung-tom-tat">
                        <div class="con-so" style="color:var(--mau-xanh-bien);" id="ttong-phong-thue">@Model.SoPhongDaThue</div>
                        <div class="mo-ta">Đang cho thuê</div>
                    </div>
                </div>
                <div class="the-tom-tat-phong">
                    <div class="bieu-tuong-tom-tat mau-hong-nhat"><i class="fas fa-tools"></i></div>
                    <div class="noi-dung-tom-tat">
                        <div class="con-so" style="color:#d97706;" id="ttong-phong-sua">@Model.SoPhongDangSua</div>
                        <div class="mo-ta">Đang sửa chữa</div>
                    </div>
                </div>
            </div>

            @* ── THANH LỌC ── *@
            <div class="khu-vuc-loc">
                <i class="fas fa-filter" style="color:var(--mau-chu-phu);font-size:13px;"></i>
                <div class="o-tim-phong">
                    <i class="fas fa-search"></i>
                    <input type="text" id="tim-phong-input" placeholder="Tìm theo số phòng, mô tả..." oninput="locDanhSachPhong()" />
                </div>
                <select class="chon-loc" id="loc-trang-thai" onchange="locDanhSachPhong()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Trống">Trống</option>
                    <option value="Đã thuê">Đã thuê</option>
                    <option value="Đang sửa">Đang sửa</option>
                </select>
                <select class="chon-loc" id="loc-tang" onchange="locDanhSachPhong()">
                    <option value="">Tất cả tầng</option>
                    @for (int tang = 1; tang <= Model.SoTangToiDa; tang++)
                    {
                        <option value="@tang">Tầng @tang</option>
                    }
                </select>
                <select class="chon-loc" id="sap-xep-phong" onchange="locDanhSachPhong()">
                    <option value="so-phong-asc">Số phòng (A → Z)</option>
                    <option value="gia-asc">Giá (thấp → cao)</option>
                    <option value="gia-desc">Giá (cao → thấp)</option>
                    <option value="dien-tich-desc">Diện tích (lớn → nhỏ)</option>
                </select>
                <span id="so-ket-qua" style="margin-left:auto;font-size:12px;color:var(--mau-chu-phu);white-space:nowrap;">
                    @Model.DanhSachPhong.Count phòng
                </span>
            </div>

            @* ── BẢNG DANH SÁCH PHÒNG ── *@
            <div class="the-bang-phong">
                <div class="dau-bang" style="padding-bottom:14px;">
                    <h3><i class="fas fa-table"></i> Danh sách phòng</h3>
                </div>

                <div style="overflow-x:auto;">
                    <table class="bang-phong" id="bang-danh-sach-phong">
                        <thead>
                            <tr>
                                <th>Số phòng</th>
                                <th>Tầng</th>
                                <th>Diện tích</th>
                                <th>Giá cố định</th>
                                <th>Trạng thái</th>
                                <th style="text-align:center;">Số người ở</th>
                                <th>Người thuê hiện tại</th>
                                <th>Ngày tạo</th>
                                <th style="text-align:center;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-phong">
                            @foreach (var p in Model.DanhSachPhong)
                            {
                                var hopDong = p.TrangThai != "Trống"
                                    ? p.HopDongs.FirstOrDefault(hd => hd.TrangThaiHD == "Đang hiệu lực")
                                    : null;
                                var tenNguoiThue = hopDong?.Tenant?.FullName ?? "";
                                var sdtNguoiThue = hopDong?.Tenant?.Phone ?? "";
                                var cssThangThai = p.TrangThai switch
                                {
                                    "Trống" => "tt-trong",
                                    "Đã thuê" => "tt-da-thue",
                                    "Đang sửa" => "tt-dang-sua",
                                    _ => "tt-trong"
                                };
                                <tr data-so-phong="@p.SoPhong.ToLower()"
                                    data-trang-thai="@p.TrangThai"
                                    data-tang="@p.Khu">
                                    <td>
                                        <div class="ten-phong-noi-bat">@p.SoPhong</div>
                                    </td>
                                    <td><span style="font-weight:600;">Tầng @p.Khu</span></td>
                                    <td>
                                        @if (p.DienTich.HasValue)
                                        {
                                            <span>@p.DienTich.Value.ToString("0.0") m²</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--mau-chu-phu);font-style:italic;">—</span>
                                        }
                                    </td>
                                    <td><span class="gia-phong-hien">@p.GiaPhongFix.ToString("N0") ₫</span></td>
                                    <td><span class="trang-thai-phong @cssThangThai">@p.TrangThai</span></td>
                                    <td style="text-align:center;">
                                        @if (p.TrangThai == "Trống")
                                        {
                                            <span style="color:var(--mau-chu-phu);font-size:12px;font-style:italic;">— Không có người ở —</span>
                                        }
                                        else
                                        {
                                            <span style="display:inline-flex;align-items:center;gap:5px;font-weight:700;font-size:13px;color:var(--mau-chu);">
                                                <i class="fas fa-users" style="color:var(--mau-chu-phu);font-size:11px;"></i>
                                                @p.soluong người
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tenNguoiThue))
                                        {
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--mau-xanh-bien),#60a5fa);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;flex-shrink:0;">
                                                    @tenNguoiThue[0]
                                                </div>
                                                <div>
                                                    <div style="font-weight:700;font-size:12.5px;">@tenNguoiThue</div>
                                                    <div style="font-size:10.5px;color:var(--mau-chu-phu);">@sdtNguoiThue</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--mau-chu-phu);font-size:12px;font-style:italic;">— Chưa có người thuê —</span>
                                        }
                                    </td>
                                    <td style="color:var(--mau-chu-phu);font-size:12px;">
                                        @p.CreatedAt.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        <div class="nhom-nut-bang" style="justify-content:center;">
                                            <button class="nut-hanh-dong-bang xem" onclick="moModalChiTietPhong(@p.IDPhong)" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="nut-hanh-dong-bang sua" onclick="moModalSuaPhong(@p.IDPhong)" title="Sửa phòng">
                                                <i class="fas fa-pen"></i> Sửa
                                            </button>
                                            @if (p.TrangThai != "Đã thuê")
                                            {
                                                <button class="nut-hanh-dong-bang xoa" onclick="moModalXoaPhong(@p.IDPhong, '@p.SoPhong')" title="Xóa phòng">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Trạng thái rỗng *@
                <div id="bang-rong" style="display:none;text-align:center;padding:40px 20px;">
                    <i class="fas fa-door-closed" style="font-size:36px;color:#d4d9e6;display:block;margin-bottom:12px;"></i>
                    <div style="font-size:14px;font-weight:700;color:var(--mau-chu-phu);">Không tìm thấy phòng nào</div>
                    <div style="font-size:12px;color:var(--mau-chu-phu);margin-top:4px;">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm</div>
                </div>

                @* Phân trang *@
                <div class="phan-trang">
                    <span id="phan-trang-info">Hiển thị 1 – @Math.Min(Model.DanhSachPhong.Count, Model.SoPhongMotTrang) / @Model.DanhSachPhong.Count phòng</span>
                    <div class="nhom-nut-trang" id="nhom-nut-trang">
                        <button class="nut-trang" id="nut-trang-truoc" onclick="chuyenTrang(-1)" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="nut-trang hien-tai" id="nut-trang-1" onclick="denTrang(1)">1</button>
                        <button class="nut-trang" id="nut-trang-tiep" onclick="chuyenTrang(1)">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </main>
    </div><!-- Kết thúc KHU VỰC CHÍNH -->
    <!-- =============================================
     MODAL THÊM PHÒNG
============================================= -->
    <div class="lop-phu-modal" id="modal-them-phong">
        <div class="hop-modal rong">
            <div class="modal-pv-hd">
                <div class="modal-pv-trai">
                    <div class="modal-pv-icon"><i class="fas fa-plus-circle"></i></div>
                    <div>
                        <div class="modal-pv-ten">Thêm phòng mới</div>
                        <div class="modal-pv-phu">Điền đầy đủ thông tin để thêm phòng vào hệ thống</div>
                    </div>
                </div>
                <button class="nut-dong-modal" style="background:rgba(255,255,255,0.2);color:#fff;"
                        onclick="dongModal('modal-them-phong')">
                    ✕
                </button>
            </div>

            <div class="tieu-de-muc-modal"><i class="fas fa-info-circle" style="color:var(--mau-chu-de);"></i> Thông tin cơ bản</div>
            <div class="luoi-form-2" style="margin-bottom:16px;">
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Số phòng <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="text" id="them-so-phong" maxlength="10" placeholder="VD: P101, A01..." />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Tối đa 10 ký tự</div>
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Tầng <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="them-tang" min="1" max="20" value="1" placeholder="VD: 1, 2, 3..." />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Nhập số tầng (1 – 20)</div>
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Số người ở tối đa <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="them-so-luong" min="1" max="20" value="1" placeholder="VD: 2" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Số lượng người được phép ở</div>
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Diện tích (m²)</label>
                    <input class="o-nhap" type="number" id="them-dien-tich" min="1" max="999" step="0.5" placeholder="VD: 25.5" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Không bắt buộc</div>
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Giá phòng cố định (₫) <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="them-gia-phong" min="0" step="100000" placeholder="VD: 3500000" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Giá thuê hàng tháng cố định</div>
                </div>
            </div>

            <div class="nhom-nhap" style="margin-bottom:16px;">
                <label class="nhan-nhap">Trạng thái ban đầu <span style="color:#dc2626;">*</span></label>
                <input type="hidden" id="them-trang-thai" value="Trống" />
                <div class="nhom-chon-trang-thai">
                    <button type="button" class="nut-chon-tt chon-trong" onclick="chonTrangThai('Trống','them')">
                        <i class="fas fa-door-open"></i> Trống
                    </button>
                    <button type="button" class="nut-chon-tt" onclick="chonTrangThai('Đang sửa','them')">
                        <i class="fas fa-tools"></i> Đang sửa
                    </button>
                </div>
            </div>

            <div class="nhom-nhap" style="margin-bottom:20px;">
                <label class="nhan-nhap">Mô tả phòng</label>
                <textarea class="o-nhap" id="them-mo-ta" rows="3" maxlength="500"
                          placeholder="VD: Phòng hướng Nam, có ban công, cửa sổ thoáng, gần thang máy..."></textarea>
                <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Tối đa 500 ký tự</div>
            </div>

            <hr class="duong-ke-modal" />
            <div class="nhom-nut-duoi-modal">
                <button class="nut-huy-modal" onclick="dongModal('modal-them-phong')">Hủy</button>
                <button class="nut-luu-modal" onclick="xacNhanThemPhong()">
                    <i class="fas fa-plus-circle"></i> Thêm phòng
                </button>
            </div>
        </div>
    </div>


    <!-- =============================================
     MODAL SỬA PHÒNG
============================================= -->
    <div class="lop-phu-modal" id="modal-sua-phong"
         onclick="dongModalNhapNgoai(event,'modal-sua-phong')">
        <div class="hop-modal rong">
            <div class="modal-pv-hd" style="background:linear-gradient(135deg,#1d4ed8,#2563eb,#3b82f6);">
                <div class="modal-pv-trai">
                    <div class="modal-pv-icon"><i class="fas fa-pen"></i></div>
                    <div>
                        <div class="modal-pv-ten">Chỉnh sửa phòng</div>
                        <div class="modal-pv-phu" id="sua-phu-tieu-de">Cập nhật thông tin phòng</div>
                    </div>
                </div>
                <button class="nut-dong-modal" style="background:rgba(255,255,255,0.2);color:#fff;"
                        onclick="dongModal('modal-sua-phong')">
                    ✕
                </button>
            </div>

            <input type="hidden" id="sua-id-phong" />

            <div class="tieu-de-muc-modal"><i class="fas fa-pencil-alt" style="color:var(--mau-xanh-bien);"></i> Thông tin phòng</div>
            <div class="luoi-form-2" style="margin-bottom:16px;">
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Số phòng <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="text" id="sua-so-phong" maxlength="10" />
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Tầng <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="sua-tang" min="1" max="20" />
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Số người ở tối đa <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="sua-so-luong" min="1" max="20" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Số lượng người được phép ở</div>
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Diện tích (m²)</label>
                    <input class="o-nhap" type="number" id="sua-dien-tich" min="1" max="999" step="0.5" />
                </div>
                <div class="nhom-nhap">
                    <label class="nhan-nhap">Giá phòng cố định (₫) <span style="color:#dc2626;">*</span></label>
                    <input class="o-nhap" type="number" id="sua-gia-phong" min="0" step="100000" />
                </div>
            </div>

            <div class="nhom-nhap" style="margin-bottom:16px;">
                <label class="nhan-nhap">Trạng thái <span style="color:#dc2626;">*</span></label>
                <input type="hidden" id="sua-trang-thai" value="Trống" />
                <div class="nhom-chon-trang-thai">
                    <button type="button" class="nut-chon-tt" id="sua-tt-trong" onclick="chonTrangThai('Trống','sua')"><i class="fas fa-door-open"></i> Trống</button>
                    <button type="button" class="nut-chon-tt" id="sua-tt-da-thue" onclick="chonTrangThai('Đã thuê','sua')"><i class="fas fa-user-check"></i> Đã thuê</button>
                    <button type="button" class="nut-chon-tt" id="sua-tt-dang-sua" onclick="chonTrangThai('Đang sửa','sua')"><i class="fas fa-tools"></i> Đang sửa</button>
                </div>
            </div>

            <div class="nhom-nhap" style="margin-bottom:20px;">
                <label class="nhan-nhap">Mô tả phòng</label>
                <textarea class="o-nhap" id="sua-mo-ta" rows="3" maxlength="500"></textarea>
                <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">Tối đa 500 ký tự</div>
            </div>

            <hr class="duong-ke-modal" />
            <div class="nhom-nut-duoi-modal">
                <button class="nut-huy-modal" onclick="dongModal('modal-sua-phong')">Hủy</button>
                <button class="nut-luu-modal"
                        style="background:linear-gradient(135deg,#1d4ed8,#2563eb);box-shadow:0 4px 14px rgba(37,99,235,0.3);"
                        onclick="xacNhanSuaPhong()">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>


    <!-- =============================================
     MODAL XÁC NHẬN XÓA PHÒNG
============================================= -->
    <div class="lop-phu-modal" id="modal-xoa-phong"
         onclick="dongModalNhapNgoai(event,'modal-xoa-phong')">
        <div class="hop-modal nho">
            <div class="tieu-de-modal" style="margin-bottom:0;">
                <div></div>
                <button class="nut-dong-modal" onclick="dongModal('modal-xoa-phong')">✕</button>
            </div>
            <input type="hidden" id="xoa-id-phong" />
            <div style="text-align:center;padding:20px 0 10px;">
                <div class="bieu-tuong-xoa"><i class="fas fa-trash-alt"></i></div>
                <div style="font-size:17px;font-weight:900;font-family:'Lexend',sans-serif;color:var(--mau-chu);margin-bottom:8px;">Xóa phòng này?</div>
                <div style="font-size:13px;color:var(--mau-chu-phu);line-height:1.6;">
                    Bạn có chắc muốn xóa phòng <strong id="xoa-ten-phong" style="color:var(--mau-chu);"></strong>?<br />
                    Thao tác này <strong style="color:var(--mau-do);">không thể hoàn tác</strong>.
                </div>
            </div>
            <div style="background:#fff5f5;border:1.5px solid #fca5a5;border-radius:var(--radius-md);padding:11px 14px;margin:14px 0;display:flex;align-items:flex-start;gap:9px;">
                <i class="fas fa-exclamation-triangle" style="color:#dc2626;margin-top:2px;flex-shrink:0;"></i>
                <span style="font-size:12px;color:#991b1b;line-height:1.55;">Chỉ được phép xóa phòng đang ở trạng thái <strong>Trống</strong> hoặc <strong>Đang sửa</strong>. Phòng đang có người thuê không thể xóa.</span>
            </div>
            <div class="nhom-nut-duoi-modal">
                <button class="nut-huy-modal" onclick="dongModal('modal-xoa-phong')">Hủy</button>
                <button class="nut-luu-modal"
                        style="background:linear-gradient(135deg,#dc2626,#ef4444);box-shadow:0 4px 14px rgba(220,38,38,0.3);"
                        onclick="xacNhanXoaPhong()">
                    <i class="fas fa-trash-alt"></i> Xác nhận xóa
                </button>
            </div>
