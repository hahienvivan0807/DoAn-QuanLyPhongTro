    <script>
        window.hienThiThongBao = function(noiDung, loai = 'success') {
        const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
        if (!khuVucChua) return;

        let classMauSac = '';
        switch (loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail':    classMauSac = 'thong-bao-canh-bao';   break;
        case 'error':   classMauSac = 'thong-bao-loi';        break;
        default:        classMauSac = 'thong-bao-thanh-cong';
        }

        const theThongBao = document.createElement('div');
        theThongBao.className = `thong-bao-muc ${classMauSac}`;
        theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>`;
        khuVucChua.appendChild(theThongBao);

        setTimeout(() => {
        if (theThongBao.parentNode) theThongBao.remove();
        }, 3000);
        };
        /* ════════════════════════════════════════════════════════════
        TQL ROOM PICKER — Namespace: tql* (no conflict with NT / oGhep)
        ════════════════════════════════════════════════════════════ */
        let _tqlPickerPhongs = [];
        let _tqlPhongDaChon  = null;

        async function tqlMoPickerPhong() {
        const overlay = document.getElementById('tql-picker-overlay');
        if (overlay) overlay.classList.add('hien');

        document.getElementById('tql-picker-search').value = '';
        document.getElementById('tql-picker-filter-tt').value = 'Trống';

        if (_tqlPickerPhongs.length > 0) {
        tqlPickerLoc();
        return;
        }
        await _tqlTaiPhong();
        }

        function tqlDongPicker() {
        document.getElementById('tql-picker-overlay')?.classList.remove('hien');
        }

        function tqlDongPickerNeuClick(e) {
        if (e && e.target === document.getElementById('tql-picker-overlay')) tqlDongPicker();
        }

        async function _tqlTaiPhong() {
        const loading = document.getElementById('tql-picker-loading');
        const grid    = document.getElementById('tql-picker-grid');
        const empty   = document.getElementById('tql-picker-empty');

        if (loading) loading.style.display = 'flex';
        if (grid)    grid.style.display    = 'none';
        if (empty)   empty.style.display   = 'none';

        try {
        const res  = await fetch('/api/ChuTro/DanhSachPhong');
        const data = await res.json();
        _tqlPickerPhongs = Array.isArray(data) ? data : (data.danhSach || []);
        tqlPickerLoc();
        } catch (err) {
        if (loading) loading.innerHTML =
        '<i class="fas fa-exclamation-triangle" style="color:#e53e3e;"></i>' +
        '&nbsp;Không tải được danh sách phòng';
        }
        }

        function tqlPickerLoc() {
        const kw = (document.getElementById('tql-picker-search')?.value || '').toLowerCase().trim();
        const tt = document.getElementById('tql-picker-filter-tt')?.value || '';

        const filtered = _tqlPickerPhongs.filter(p => {
        const matchTT  = !tt || p.trangThai === tt;
        const matchKey = !kw
        || String(p.soPhong  || '').toLowerCase().includes(kw)
        || String(p.khu      || '').toLowerCase().includes(kw);
        return matchTT && matchKey;
        });
        _tqlRenderPickerGrid(filtered);
        }

        function _tqlRenderPickerGrid(list) {
        const loading = document.getElementById('tql-picker-loading');
        const grid    = document.getElementById('tql-picker-grid');
        const empty   = document.getElementById('tql-picker-empty');

        if (loading) loading.style.display = 'none';

        if (!list.length) {
        if (grid)  grid.style.display  = 'none';
        if (empty) empty.style.display = 'block';
        return;
        }
        if (empty) empty.style.display = 'none';
        if (grid)  grid.style.display  = 'grid';

        const badgeCls = {
        'Trống'    : 'rp-badge-trong',
        'Đã thuê'  : 'rp-badge-datthue',
        'Đang sửa' : 'rp-badge-suachua',
        };

        grid.innerHTML = list.map(p => {
        const isSelected = _tqlPhongDaChon && _tqlPhongDaChon.idPhong === p.idPhong;
        const disabled   = p.trangThai !== 'Trống' ? 'disabled' : '';

        return `
        <div class="rp-card ${isSelected ? 'selected' : ''} ${disabled}"
        onclick="_tqlChonPhong(${p.idPhong})">
        <div class="rp-check"><i class="fas fa-check"></i></div>
        <div class="rp-so-phong">P.${_tqlEsc(p.soPhong)}</div>
        <div class="rp-tang">Khu ${_tqlEsc(String(p.khu ?? ''))}</div>
        <span class="rp-badge ${badgeCls[p.trangThai] || 'rp-badge-trong'}">
        ${_tqlEsc(p.trangThai)}
        </span>
        <div class="rp-gia">${_tqlFmtTien(p.giaPhongFix)}/tháng</div>
        </div>`;
        }).join('');
        }

        function _tqlChonPhong(idPhong) {
        const phong = _tqlPickerPhongs.find(p => p.idPhong === idPhong);
        if (!phong) return;

        _tqlPhongDaChon = phong;

        // Update hidden input
        const inp = document.getElementById('tql-inp-id-phong');
        if (inp) inp.value = idPhong;

        // Update display box
        const txt = document.getElementById('tql-phong-display-text');
        if (txt) {
        txt.textContent = `Phòng ${phong.soPhong} — Khu ${phong.khu}`;
        txt.style.color = 'var(--mau-chu)';
        }

        // Show clear button
        const btnXoa = document.getElementById('tql-btn-xoa-phong');
        if (btnXoa) btnXoa.style.display = '';

        // Render room preview
        const preview = document.getElementById('tql-room-preview');
        const rpBody  = document.getElementById('tql-rp-body');
        if (preview && rpBody) {
        rpBody.innerHTML = [
        { k: 'Số phòng',    v: `Phòng ${phong.soPhong}` },
        { k: 'Khu',         v: `Khu ${phong.khu}` },
        { k: 'Trạng thái',  v: phong.trangThai },
        { k: 'Giá thuê',    v: `${_tqlFmtTien(phong.giaPhongFix)}/tháng` },
        { k: 'Diện tích',   v: phong.dienTich ? `${phong.dienTich} m²` : '—' },
        { k: 'Số người tối đa', v: phong.soNguoiToiDa ?? '—' },
        ].map(item => `
        <div>
        <div style="font-size:10.5px;color:var(--mau-chu-phu);
        text-transform:uppercase;letter-spacing:0.5px;
        font-weight:700;margin-bottom:2px;">${item.k}</div>
        <div style="font-size:13px;font-weight:700;
        color:var(--mau-chu);">${_tqlEsc(String(item.v))}</div>
        </div>`).join('');
        preview.style.display = 'block';
        }

        // Auto-fill ngay-bd-hd if empty
        const ngayBD = document.getElementById('tql-them-ngay-bd-hd');
        if (ngayBD && !ngayBD.value)
        ngayBD.value = new Date().toISOString().split('T')[0];

        tqlDongPicker();
        }

        function tqlXoaChonPhong() {
        _tqlPhongDaChon = null;
        const inp = document.getElementById('tql-inp-id-phong');
        if (inp) inp.value = '';
        const txt = document.getElementById('tql-phong-display-text');
        if (txt) { txt.textContent = '-- Chọn phòng --'; txt.style.color = 'var(--mau-chu-phu)'; }
        const preview = document.getElementById('tql-room-preview');
        if (preview) preview.style.display = 'none';
        const btnXoa = document.getElementById('tql-btn-xoa-phong');
        if (btnXoa) btnXoa.style.display = 'none';
        const ngayBD = document.getElementById('tql-them-ngay-bd-hd');
        if (ngayBD) ngayBD.value = '';
        }

        /* ────────────────────────────────────────────────────────────
        TQL PAYLOAD COLLECTOR — gọi từ themQuanLyFull() hiện có
        Trả về object chứa các field Phòng & HĐ để merge vào payload
        ──────────────────────────────────────────────────────────── */
        function tqlLayPayloadPhongHD() {
        const get = id => (document.getElementById(id)?.value || '').trim();
        return {
        IDPhong         : parseInt(get('tql-inp-id-phong'))        || null,
        NgayBatDauHD    : get('tql-them-ngay-bd-hd')               || null,
        NgayKetThucHD   : get('tql-them-ngay-kt-hd')               || null,
        DienDauKy       : parseInt(get('tql-them-dien-dau-ky'))     || 0,
        NuocDauKy       : parseInt(get('tql-them-nuoc-dau-ky'))     || 0,
        TienCocHD       : parseFloat(get('tql-them-tien-coc'))      || 0,
        GhiChuHD        : get('tql-them-ghi-chu-hd'),
        };
        }

        /* ────────────────────────────────────────────────────────────
        TQL RENDER — Hiển thị thông tin Phòng & HĐ trong bảng hoặc
        sidebar phải (dùng khi click chọn quản lý)
        ──────────────────────────────────────────────────────────── */

        /**
        * Render một card tóm tắt Phòng & HĐ vào container chỉ định.
        * @@param {HTMLElement} container - phần tử sẽ nhận nội dung
        * @@param {Object[]} phongs       - mảng phòng từ data-quan-ly JSON
        */
        function tqlRenderPhongHD(container, phongs) {
        if (!container) return;

        if (!phongs || phongs.length === 0) {
        container.innerHTML = `
        <div style="padding:14px;text-align:center;color:var(--mau-chu-phu);
        font-size:13px;font-style:italic;">
        <i class="fas fa-door-closed" style="margin-right:6px;opacity:.4;"></i>
        Chưa được phân công phòng nào
        </div>`;
        return;
        }

        container.innerHTML = phongs.map(p => {
        const ttClass = {
        'Đã thuê'  : 'badge-active',
        'Trống'    : 'badge-empty',
        'Đang sửa' : 'badge-locked',
        }[p.TrangThai || p.trangThai] || 'badge-empty';

        const soPhong  = p.SoPhong   || p.soPhong   || '—';
        const khu      = p.khu !== undefined ? p.khu : (p.Khu ?? '');
        const trangThai= p.TrangThai || p.trangThai || '—';

        return `
        <div style="display:flex;align-items:center;justify-content:space-between;
        padding:9px 12px;border-radius:var(--radius-sm);
        background:var(--mau-nen);border:1px solid var(--mau-vien);
        margin-bottom:6px;font-size:13px;">
        <div style="display:flex;align-items:center;gap:9px;">
        <div style="width:32px;height:32px;border-radius:8px;flex-shrink:0;
        background:#ede9fe;display:flex;align-items:center;
        justify-content:center;font-size:13px;font-weight:700;
        color:#5b21b6;">
        ${_tqlEsc(String(soPhong))}
        </div>
        <div>
        <div style="font-weight:700;color:var(--mau-chu);">
        Phòng ${_tqlEsc(String(soPhong))}
        ${khu !== '' ? `<span style="font-size:11px;color:var(--mau-chu-phu);
        font-weight:500;"> — Khu ${_tqlEsc(String(khu))}</span>` : ''}
        </div>
        </div>
        </div>
        <span class="badge ${ttClass}" style="font-size:11px;">
        ${_tqlEsc(trangThai)}
        </span>
        </div>`;
        }).join('');
        }

        /**
        * Render block Phòng & HĐ vào sidebar phải khi chọn 1 quản lý.
        * Gọi trong chonQuanLy() hiện có — thêm 2 dòng ở cuối hàm đó:
        *
        *   const phongContent = document.getElementById('phong-content');
        *   tqlRenderPhongHD(phongContent, ql.phongs);
        */

        /* ────────────────────────────────────────────────────────────
        VALIDATE Phòng & HĐ (gọi từ tiepTabThem khi tab = 2)
        ──────────────────────────────────────────────────────────── */
        function tqlValidatePhongHD() {
        const idPhong  = document.getElementById('tql-inp-id-phong')?.value || '';
        const ngayBD   = document.getElementById('tql-them-ngay-bd-hd')?.value || '';
        const ngayKT   = document.getElementById('tql-them-ngay-kt-hd')?.value || '';

        // Phòng & Hợp đồng đều optional — chỉ validate nếu nhập một phần
        if (ngayKT && ngayBD && new Date(ngayKT) <= new Date(ngayBD)) {
        alert('Ngày kết thúc hợp đồng phải sau ngày bắt đầu.');
        return false;
        }
        if ((ngayBD || ngayKT || idPhong) && !idPhong) {
        // Đã nhập ngày nhưng chưa chọn phòng
        const txt = document.getElementById('tql-phong-display-text');
        if (txt) txt.style.color = 'var(--mau-do)';
        alert('Vui lòng chọn phòng khi điền thông tin hợp đồng.');
        return false;
        }
        return true;
        }

        /* ────────────────────────────────────────────────────────────
        RESET panel 2 khi đóng modal Thêm quản lý
        Gọi trong hàm dongModal('modal-them-ql') hiện có
        ──────────────────────────────────────────────────────────── */
        function tqlResetPhongHDPanel() {
        tqlXoaChonPhong();
        ['tql-them-ngay-bd-hd','tql-them-ngay-kt-hd',
        'tql-them-dien-dau-ky','tql-them-nuoc-dau-ky',
        'tql-them-tien-coc','tql-them-ghi-chu-hd']
        .forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
        });
        _tqlPickerPhongs = [];
        }

        /* ────────────────────────────────────────────────────────────
        UTILS (scoped so they don't collide with NT / oGhep)
        ──────────────────────────────────────────────────────────── */
        function _tqlEsc(s) {
        return String(s || '')
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
        function _tqlFmtTien(v) {
        return new Intl.NumberFormat('vi-VN').format(v || 0) + 'đ';
        }
        // ─── Tab stepper cho modal Thêm quản lý ─────────────────────────
        window.__themTab = 0;
        const THEM_TAB_COUNT = 3;

        function moTabThem(i) {
        const n = 2; // Tài khoản (0) + Hồ sơ cá nhân (1)
        for (let j = 0; j < n; j++) {
        document.getElementById('them-panel-' + j)
        ?.classList.toggle('them-panel-on', j === i);
        document.querySelectorAll('#them-tabs .them-tab')[j]
        ?.classList.toggle('them-tab-on', j === i);

        const dot = document.getElementById('them-dot-' + j);
        if (dot) {
        dot.style.width        = j === i ? '18px' : '7px';
        dot.style.borderRadius = j === i ? '4px'  : '50%';
        dot.style.background   = j === i ? '#7c3aed' : 'var(--mau-vien)';
        }
        }

        window.__themTab = i;
        document.getElementById('btn-them-back').style.display = i > 0 ? '' : 'none';

        const nb = document.getElementById('btn-them-next');
        nb.innerHTML = i === n - 1
        ? '<i class="fas fa-user-plus"></i> Tạo tài khoản'
        : 'Tiếp theo <i class="fas fa-arrow-right"></i>';
        }

        function moTabThem(i) {
        for (let j = 0; j < THEM_TAB_COUNT; j++) {
        document.getElementById('them-panel-' + j)
        ?.classList.toggle('them-panel-on', j === i);
        document.querySelectorAll('#them-tabs .them-tab')[j]
        ?.classList.toggle('them-tab-on', j === i);

        const dot = document.getElementById('them-dot-' + j);
        if (dot) {
        dot.style.width        = j === i ? '18px' : '7px';
        dot.style.borderRadius = j === i ? '4px'  : '50%';
        dot.style.background   = j === i ? '#7c3aed' : 'var(--mau-vien)';
        }
        }
        window.__themTab = i;
        document.getElementById('btn-them-back').style.display = i > 0 ? '' : 'none';

        const nb = document.getElementById('btn-them-next');
        nb.innerHTML = i === THEM_TAB_COUNT - 1
        ? '<i class="fas fa-user-plus"></i> Tạo tài khoản'
        : 'Tiếp theo <i class="fas fa-arrow-right"></i>';
        }


        // ─── Toggle sidebar ──────────────────────────────────────────────
        function dongMoSidebar() {
        const sb = document.getElementById('thanh-sidebar');
        sb.classList.toggle('an');
        }
        // Toggle Extra Role chips
        function toggleRoleChip(el, role) {
        el.classList.toggle('selected');
        const hidden = document.getElementById('them-extra-roles');
        const current = hidden.value ? hidden.value.split(',') : [];
        const idx = current.indexOf(role);
        if (idx === -1) current.push(role); else current.splice(idx, 1);
        hidden.value = current.filter(Boolean).join(',');
        }
        function tiepTabThem() {
        if (window.__themTab < THEM_TAB_COUNT - 1) {
        moTabThem(window.__themTab + 1);
        } else {
        themQuanLyFull();
        }
        }

    </script>
    <!-- ════════════════════════════════════════════════════════════
     MODAL: CHỌN PHÒNG cho taikhoanquanly (tql-picker)
════════════════════════════════════════════════════════════ -->
    <div class="lop-phu-modal" id="tql-picker-overlay"
         onclick="tqlDongPickerNeuClick(event)">
        <div class="hop-modal" style="max-width:600px;">

            <div class="modal-header-purple">
                <div style="display:flex;align-items:center;gap:12px;position:relative;z-index:1;">
                    <div class="mh-icon"><i class="fas fa-door-open"></i></div>
                    <div>
                        <div class="mh-title">Chọn phòng</div>
                        <div class="mh-sub">Lọc và chọn phòng để phân công</div>
                    </div>
                </div>
                <button class="mh-close" onclick="tqlDongPicker()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Toolbar -->
            <div style="padding:12px 20px;border-bottom:1px solid var(--mau-vien);
                display:flex;gap:10px;flex-wrap:wrap;background:var(--mau-nen-card);">
                <div class="tql-search-wrap" style="flex:1;min-width:150px;">
                    <i class="fas fa-search"></i>
                    <input type="text" id="tql-picker-search"
                           placeholder="Tìm số phòng, khu..."
                           oninput="tqlPickerLoc()" />
                </div>
                <select class="tql-filter-select" id="tql-picker-filter-tt"
                        onchange="tqlPickerLoc()" style="min-width:160px;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Trống" selected>Phòng trống</option>
                    <option value="Đã thuê">Đang có người thuê</option>
                    <option value="Đang sửa">Đang sửa chữa</option>
                </select>
            </div>

            <!-- Grid -->
            <div class="modal-body" style="padding:14px 16px;max-height:420px;overflow-y:auto;">
                <div id="tql-picker-loading"
                     style="display:flex;align-items:center;gap:10px;padding:32px;
                    justify-content:center;color:var(--mau-chu-phu);font-size:13px;">
                    <div style="width:20px;height:20px;border:3px solid var(--mau-vien);
                    border-top-color:#7c3aed;border-radius:50%;
                    animation:spin .7s linear infinite;flex-shrink:0;"></div>
                    Đang tải...
                </div>
                <div id="tql-picker-grid"
                     style="display:none;display:grid;
                grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
                gap:10px;"></div>
                <div id="tql-picker-empty"
                     style="display:none;text-align:center;padding:40px 16px;
                    color:var(--mau-chu-phu);">
                    <div style="font-size:32px;margin-bottom:10px;">
                        <i class="fas fa-door-closed"></i>
                    </div>
                    <div style="font-weight:700;font-size:13px;color:var(--mau-chu);
                        margin-bottom:4px;">
                        Không tìm thấy phòng
                    </div>
                    <div style="font-size:12px;">Thử thay đổi bộ lọc trạng thái</div>
                </div>
            </div>

            <div class="modal-footer" style="justify-content:flex-end;">
                <button class="btn-huy" onclick="tqlDongPicker()">
                    <i class="fas fa-times"></i> Đóng
                </button>
            </div>
        </div>
    </div>
    <style>
        @@keyframes spin {
        to {
        transform: rotate(360deg);
        }
        }
    </style>
    <!-- MODAL: PHÂN CÔNG PHÒNG INLINE -->
    <div class="lop-phu-modal" id="modal-phan-cong-phong"
         onclick="dongModalNgoai(event,'modal-phan-cong-phong')">
        <div class="hop-modal" style="max-width:680px;">
            <div class="modal-header-purple">
                <div style="display:flex;align-items:center;gap:12px;position:relative;z-index:1;">
                    <div class="mh-icon"><i class="fas fa-map-marked-alt"></i></div>
                    <div>
                        <div class="mh-title">Phân công phòng</div>
                        <div class="mh-sub" id="mpc-sub">Chọn phòng để phân công</div>
                    </div>
                </div>
                <button class="mh-close" onclick="dongModal('modal-phan-cong-phong')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Toolbar -->
            <div style="padding:12px 20px;border-bottom:1px solid var(--mau-vien);
                display:flex;gap:10px;flex-wrap:wrap;background:var(--mau-nen-card);
                align-items:center;">
                <div class="tql-search-wrap" style="flex:1;min-width:150px;">
                    <i class="fas fa-search"></i>
                    <input type="text" id="mpc-search" placeholder="Tìm số phòng, khu..."
                           oninput="mpcLoc()" />
                </div>
                <select class="tql-filter-select" id="mpc-filter-tt" onchange="mpcLoc()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Trống">🟢 Trống</option>
                    <option value="Đã thuê">🔵 Đang thuê</option>
                    <option value="Đang sửa">🟡 Bảo trì</option>
                </select>
                <label style="display:flex;align-items:center;gap:5px;font-size:12px;
                    color:var(--mau-chu-phu);cursor:pointer;white-space:nowrap;">
                    <input type="checkbox" id="mpc-only-mine" style="accent-color:#7c3aed;"
                           onchange="mpcLoc()" />
                    Đang phụ trách
                </label>
                <span id="mpc-count-badge" style="
                    background:#7c3aed;color:#fff;font-size:11px;font-weight:700;
                    border-radius:20px;padding:3px 10px;white-space:nowrap;flex-shrink:0;">
                    0 đã chọn
                </span>
            </div>

            <!-- Grid phòng -->
            <div class="modal-body" style="padding:16px;max-height:420px;overflow-y:auto;">
                <div id="mpc-grid" style="
                    display:grid;
                    grid-template-columns:repeat(auto-fill,minmax(110px,1fr));
                    gap:10px;">
                </div>
                <div id="mpc-empty" style="display:none;text-align:center;
                    padding:40px;color:var(--mau-chu-phu);font-size:13px;">
                    <i class="fas fa-door-closed" style="font-size:28px;opacity:.3;
                    display:block;margin-bottom:10px;"></i>
                    Không tìm thấy phòng nào.
                </div>
            </div>

            <div class="modal-footer" style="justify-content:space-between;">
                <button class="btn-huy" onclick="mpcChonTatCa()">
                    <i class="fas fa-check-double"></i> Chọn tất cả trống
                </button>
                <div style="display:flex;gap:8px;">
                    <button class="btn-huy" onclick="dongModal('modal-phan-cong-phong')">Hủy</button>
                    <button class="btn-luu-modal" id="btn-mpc-luu" onclick="mpcLuu()">
                        <i class="fas fa-check-circle"></i> Lưu phân công
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!--Thông báo-->
    <div class="toast-container" id="toastContainer" style="position:fixed;top:24px;right:24px;display:flex;flex-direction:column;gap:10px;z-index:99999;"></div>
</body>
</html>
