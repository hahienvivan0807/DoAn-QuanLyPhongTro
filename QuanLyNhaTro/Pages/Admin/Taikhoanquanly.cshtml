@page "/Admin/Taikhoanquanly"
@model QuanLyNhaTro.Pages.Admin.TaiKhoanQuanLyModel
@{
    Layout = null;
}

@* ─── Embed dữ liệu server → JS ──────────────────────────────────── *@
<script id="data-quan-ly" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.DanhSachQuanLy.Select(q => new
                    {
                                idUser = q.IDUser,
                                fullName = q.FullName,
                                username = q.Username,
                                phone = q.Phone,
                                email = q.Email,
                                isActive = q.IsActive,
                                createdAt = q.CreatedAt.ToString("dd/MM/yyyy"),
                                permissions = q.Permissions,
                                phongs = q.Phongs.Select(p => new { p.IDPhong, p.SoPhong, khu = (int)p.Khu, p.TrangThai })
                    }),
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }
    ))
</script>
<script id="data-phong" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.TatCaPhong.Select(p => new { p.IDPhong, p.SoPhong, khu = (int)p.Khu, p.TrangThai }),
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }
    ))
</script>

@* Anti-forgery token dùng cho AJAX POST *@
@Html.AntiForgeryToken()

@* ─── Embed thông tin người dùng hiện tại từ ClaimsPrincipal → JS ─── *@
@{
    var _fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
    var _username = User.Identity?.Name ?? "";
    var _roles = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin";
    var _idUser = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";

    // Label vai trò hiển thị
    var _vaiTroLabel = _roles switch
    {
        "Admin" => "Chủ sở hữu",
        "Manager" => "Quản lý",
        _ => "Nhân viên"
    };

    // Chữ cái đầu của tên (lấy từ cuối FullName như trong JS)
    var _nameParts = _fullName.Trim().Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
    var _initials = _nameParts.Length > 0 ? _nameParts[^1][0].ToString().ToUpper() : "?";

    // Tag CHỦ TRỌ / QUẢN LÝ
    var _roleTag = _roles switch
    {
        "Admin" => "CHỦ TRỌ",
        "Manager" => "QUẢN LÝ",
        _ => "NHÂN VIÊN"
    };
    var _roleIcon = _roles switch
    {
        "Admin" => "fa-crown",
        "Manager" => "fa-user-shield",
        _ => "fa-user"
    };
    var _roleGradient = _roles switch
    {
        "Admin" => "linear-gradient(135deg,#b8720a,#e8971c)",
        "Manager" => "linear-gradient(135deg,#7c3aed,#a78bfa)",
        _ => "linear-gradient(135deg,#2563eb,#60a5fa)"
    };
}
<script id="data-chu-tro" type="application/json">
    {
      "idUser":    @_idUser,
      "fullName":  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_fullName)),
      "username":  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_username)),
      "roles":     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_roles)),
      "vaiTroLabel": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_vaiTroLabel)),
      "initials":  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_initials)),
      "roleTag":   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_roleTag)),
      "roleIcon":  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_roleIcon)),
      "roleGradient": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_roleGradient))
    }
</script>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ Thống Quản Lý – Tài Khoản Quản Lý</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/ChuTro.css" />
    <script src="/js/ChuTro/ChuTro-core.js" defer></script>
    <script src="/js/ChuTro/ChuTro-quanLy.js" defer></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/Admin/taikhoanquanly.css" />
    <style>
    </style>
</head>
<body>

    <!-- =============================================
     SIDEBAR – đồng bộ từ ChuTro.cshtml
============================================= -->
    <nav id="thanh-sidebar">

        <!-- Logo -->
        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo">
                <i class="fas fa-crown"></i>
            </div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <!-- Nhóm: Tổng quan -->
        <div class="nhan-nhom-menu">Tổng quan</div>

        <a class="muc-menu" href="/Admin/ChuTro">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </a>

        <!-- Nhóm: Vận hành -->
        <div class="nhan-nhom-menu">Vận hành</div>

        <a class="muc-menu" href="/Admin/QuanLyPhong"">
            <i class="fas fa-building"></i>
            <span>Quản lý phòng trọ</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyNguoiThue">
            <i class="fas fa-users"></i>
            <span>Người thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyHopDong">
            <i class="fas fa-file-contract"></i>
            <span>Hợp đồng</span>
            <span class="huy-hieu vang">2</span>
        </a>

        <!-- Nhóm: Quản trị chủ trọ -->
        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>

        <a class="muc-menu dang-chon" href="/Admin/Taikhoanquanly">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </a>
        <a class="muc-menu" href="/Admin/QuanLyNguoiThue">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/CauHinhGiaThue">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </a>
        <a class="muc-menu" href="/Admin/DichVuThongBao">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </a>

        <!-- Nhóm: Hỗ trợ -->
        <div class="nhan-nhom-menu">Hỗ trợ</div>

        <a class="muc-menu" href="/Admin/SuCoBaoTri">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            <span class="huy-hieu" id="huy-hieu-sua-chua">3</span>
        </a>
        <a class="muc-menu" href="/Admin/ChuTro#ThongKe">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </a>
        <a class="muc-menu" href="/Admin/ChuTro#CaiDatHT">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </a>

        <!-- Thông tin chủ trọ – render từ ClaimsPrincipal -->
        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro">@_initials</div>
            <div class="ten-chu">
                <strong>@_fullName</strong>
                <span>@_vaiTroLabel</span>
            </div>
        </div>

    </nav><!-- Kết thúc SIDEBAR -->
    <!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Tài Khoản Quản Lý</div>
                    <div class="duong-dan-header">Bảng điều khiển / Quản trị / Tài khoản quản lý</div>
                </div>
            </div>

            <div class="header-phai">
                <!-- Tìm kiếm -->
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
                </div>

                <!-- Chuông -->
                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">0</span>
                </button>

                <div class="header-divider"></div>

                <!-- Tag vai trò – render từ ClaimsPrincipal -->
                <span class="the-chu-tro" style="background:@_roleGradient">
                    <i class="fas @_roleIcon" style="margin-right:4px;font-size:8px;"></i>@_roleTag
                </span>

                <!-- Avatar + tên – render từ ClaimsPrincipal -->
                <div style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:5px 10px;border-radius:var(--radius-full);">
                    <div class="anh-dai-dien-header">@_initials</div>
                    <div>
                        <div class="ten-admin-header">@_fullName</div>
                        <div class="vai-tro-header">@_vaiTroLabel</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH -->
        <div id="noi-dung-chinh">

            <!-- ============================================================
         PAGE HEADER
    ============================================================ -->
            <div class="tql-page-header">
                <div class="tql-page-header-left">
                    <div class="breadcrumb">
                        <span>Bảng điều khiển</span>
                        <i class="fas fa-chevron-right"></i>
                        <span>Quản trị</span>
                        <i class="fas fa-chevron-right"></i>
                        <span style="color:#7c3aed;font-weight:600;">Tài khoản quản lý</span>
                    </div>
                    <h1>
                        <span class="icon-wrap"><i class="fas fa-users-cog"></i></span>
                        Tài khoản quản lý
                    </h1>
                    <p>Quản lý tài khoản, phân quyền và phân công phòng cho đội ngũ quản lý.</p>
                </div>
                <button class="btn-them-ql" onclick="moModalDanhSachQuanLy()">
                    <i class="fas fa-user-plus"></i>
                    Thêm quản lý mới
                </button>
            </div>

            <!-- ============================================================
         STAT CARDS
    ============================================================ -->
            <div class="tql-stats-grid">
                <div class="stat-card purple">
                    <div class="stat-icon"><i class="fas fa-users-cog"></i></div>
                    <div class="stat-body">
                        <div class="stat-label">Tổng quản lý</div>
                        <div class="stat-value" id="stat-tong">@Model.TongQuanLy</div>
                        <div class="stat-sub">Tất cả tài khoản Manager</div>
                    </div>
                </div>
                <div class="stat-card green">
                    <div class="stat-icon"><i class="fas fa-user-check"></i></div>
                    <div class="stat-body">
                        <div class="stat-label">Đang hoạt động</div>
                        <div class="stat-value" id="stat-active">@Model.QuanLyHoatDong</div>
                        <div class="stat-sub"><span class="up">●</span> Tài khoản mở khóa</div>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-icon"><i class="fas fa-door-open"></i></div>
                    <div class="stat-body">
                        <div class="stat-label">Phòng chưa phân công</div>
                        <div class="stat-value" id="stat-unassigned">@Model.PhongChuaPhanCong</div>
                        <div class="stat-sub"><span class="down">●</span> Cần phân quản lý</div>
                    </div>
                </div>
                <div class="stat-card blue">
                    <div class="stat-icon"><i class="fas fa-door-closed"></i></div>
                    <div class="stat-body">
                        <div class="stat-label">Tổng phòng</div>
                        <div class="stat-value" id="stat-phong">@Model.TongPhong</div>
                        <div class="stat-sub">Toàn bộ khu nhà trọ</div>
                    </div>
                </div>
            </div>

            <!-- ============================================================
         MAIN GRID: bảng + sidebar
    ============================================================ -->
            <div class="tql-main-grid">

                <!-- ── CỘT TRÁI: BẢNG QUẢN LÝ ── -->
                <div>
                    <div class="tql-card">
                        <div class="tql-toolbar">
                            <div class="tql-search-wrap">
                                <i class="fas fa-search"></i>
                                <input type="text" id="inp-search"
                                       placeholder="Tìm theo tên, SĐT, username..."
                                       oninput="timKiemQL(this.value)" />
                            </div>
                            <select class="tql-filter-select" id="sel-filter" onchange="locTrangThai(this.value)">
                                <option value="">Tất cả trạng thái</option>
                                <option value="active">Hoạt động</option>
                                <option value="locked">Bị khóa</option>
                            </select>
                        </div>

                        <div class="tql-table-wrap">
                            <table class="tql-table" id="bang-quan-ly">
                                <thead>
                                    <tr>
                                        <th style="width:36px; padding-left:20px;">
                                            <input type="checkbox" id="chk-all"
                                                   style="accent-color:#7c3aed; cursor:pointer;"
                                                   onchange="chonTatCa(this.checked)" />
                                        </th>
                                        <th>Quản lý</th>
                                        <th>Số điện thoại</th>
                                        <th>Trạng thái</th>
                                        <th>Phòng phụ trách</th>
                                        <th>Ngày tạo</th>
                                        <th style="text-align:center;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-quan-ly">
                                    @foreach (var ql in Model.DanhSachQuanLy)
                                    {
                                        var bg = TaiKhoanQuanLyModel.GradientPool[ql.IDUser % TaiKhoanQuanLyModel.GradientPool.Length];
                                        var initials = (ql.FullName ?? ql.Username ?? "?").Trim().Split(' ').Last()[0].ToString().ToUpper();
                                        var phongShow = ql.Phongs.Take(3).ToList();
                                        var phongMore = ql.Phongs.Count - 3;
                                        var tenEsc = ql.FullName.Replace("'", "\\'");
                                        <tr data-id="@ql.IDUser"
                                            data-name="@ql.FullName.ToLower()"
                                            data-phone="@ql.Phone"
                                            data-status="@(ql.IsActive ? "active" : "locked")"
                                            onclick="chonQuanLy(@ql.IDUser)">
                                            <td style="padding-left:20px;" onclick="event.stopPropagation()">
                                                <input type="checkbox" class="chk-row" data-id="@ql.IDUser"
                                                       style="accent-color:#7c3aed; cursor:pointer;" />
                                            </td>
                                            <td>
                                                <div class="tbl-avatar-wrap">
                                                    <div class="tbl-avatar" style="background:@bg">@initials</div>
                                                    <div>
                                                        <div class="tbl-avatar-name">@ql.FullName</div>
                                                        <div class="tbl-avatar-user">@@@ql.Username</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@ql.Phone</td>
                                            <td>
                                                @if (ql.IsActive)
                                                {
                                                    <span class="badge badge-active"><i class="fas fa-circle" style="font-size:6px;"></i> Hoạt động</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-locked"><i class="fas fa-lock" style="font-size:9px;"></i> Bị khóa</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="room-chips">
                                                    @foreach (var p in phongShow)
                                                    {
                                                        <span class="room-chip">@p.SoPhong</span>
                                                    }
                                                    @if (phongMore > 0)
                                                    {
                                                        <span class="room-chip more">+@phongMore</span>
                                                    }
                                                    @if (!ql.Phongs.Any())
                                                    {
                                                        <span class="badge badge-empty">Chưa phân công</span>
                                                    }
                                                </div>
                                            </td>
                                            <td style="font-size:12px; color:var(--mau-chu-phu);">
                                                @ql.CreatedAt.ToString("dd/MM/yyyy")
                                            </td>
                                            <td onclick="event.stopPropagation()">
                                                <div class="tbl-actions">
                                                    <button class="btn-icon btn-icon-edit" title="Chỉnh sửa"
                                                            onclick="moModalSuaQuanLy(@ql.IDUser)">
                                                        <i class="fas fa-pen"></i>
                                                    </button>
                                                    <button class="btn-icon btn-icon-assign" title="Phân công phòng"
                                                            onclick="moModalPhanCong(@ql.IDUser, event)">
                                                        <i class="fas fa-door-open"></i>
                                                    </button>
                                                    @if (ql.IsActive)
                                                    {
                                                        <button class="btn-icon btn-icon-lock" title="Khóa tài khoản"
                                                                onclick="khoaTaiKhoan(@ql.IDUser, '@tenEsc', true)">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn-icon btn-icon-unlock" title="Mở khóa"
                                                                onclick="khoaTaiKhoan(@ql.IDUser, '@tenEsc', false)">
                                                            <i class="fas fa-lock-open"></i>
                                                        </button>
                                                    }
                                                    <button class="btn-icon btn-icon-delete" title="Xóa tài khoản"
                                                            onclick="xoaQuanLy(@ql.IDUser, '@tenEsc')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (!Model.DanhSachQuanLy.Any())
                            {
                                <div class="tql-empty">
                                    <i class="fas fa-user-slash"></i>
                                    <p>
                                        Chưa có tài khoản quản lý nào.<br />
                                        Nhấn <strong>Thêm quản lý mới</strong> để bắt đầu.
                                    </p>
                                </div>
                            }
                        </div>

                        <div class="tql-pagination">
                            <span>Hiển thị <strong id="pg-count">@Model.DanhSachQuanLy.Count</strong> quản lý</span>
                            <div id="pg-btns"></div>
                        </div>
                    </div>
                </div><!-- /col-left -->
                <!-- ── CỘT PHẢI: QUYỀN + PHÂN PHÒNG ── -->
                <div class="tql-sidebar-right">

                    <!-- CARD: PHÂN QUYỀN -->
                    <div class="tql-card">
                        <div class="tql-card-header">
                            <div class="tql-card-title">
                                <i class="fas fa-shield-alt" style="color:#7c3aed;"></i>
                                Phân quyền chi tiết
                            </div>
                        </div>
                        <div class="tql-card-body">
                            <div class="no-selection-hint" id="quyen-no-selection">
                                <i class="fas fa-hand-pointer"></i>
                                Chọn một quản lý từ bảng bên trái để chỉnh sửa quyền.
                            </div>
                            <div id="quyen-content" style="display:none;">
                                <div class="selected-manager-banner">
                                    <div class="sm-avatar" id="sel-avatar">?</div>
                                    <div>
                                        <div class="sm-name" id="sel-name">—</div>
                                        <div class="sm-hint">Đang chỉnh quyền</div>
                                    </div>
                                </div>

                                <div class="permission-group-title">
                                    <i class="fas fa-file-contract" style="color:#7c3aed;"></i> Hợp đồng
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-plus-circle"></i>
                                        <div class="permission-label-text">
                                            <strong>Tạo hợp đồng</strong>
                                            <small>Thêm hợp đồng thuê mới</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-tao-hd" /></div>
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-times-circle"></i>
                                        <div class="permission-label-text">
                                            <strong>Hủy / Kết thúc hợp đồng</strong>
                                            <small>Chỉnh trạng thái hợp đồng</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-huy-hd" /></div>
                                </div>

                                <div class="permission-group-title">
                                    <i class="fas fa-money-bill-wave" style="color:#7c3aed;"></i> Tài chính
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-file-invoice-dollar"></i>
                                        <div class="permission-label-text">
                                            <strong>Thu hóa đơn</strong>
                                            <small>Xác nhận thanh toán</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-thu-hd" /></div>
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-tachometer-alt"></i>
                                        <div class="permission-label-text">
                                            <strong>Nhập điện nước</strong>
                                            <small>Ghi chỉ số điện / nước</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-dien-nuoc" /></div>
                                </div>

                                <div class="permission-group-title">
                                    <i class="fas fa-tools" style="color:#7c3aed;"></i> Vận hành
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-wrench"></i>
                                        <div class="permission-label-text">
                                            <strong>Xử lý sửa chữa</strong>
                                            <small>Duyệt đơn dịch vụ / sửa chữa</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-sua-chua" /></div>
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-bell"></i>
                                        <div class="permission-label-text">
                                            <strong>Gửi thông báo</strong>
                                            <small>Thông báo toàn khu / phòng</small>
                                        </div>
                                    </div>
                                    <div class="toggle-wrap"><input type="checkbox" id="perm-thong-bao" /></div>
                                </div>
                                <div class="permission-item">
                                    <div class="permission-label">
                                        <i class="fas fa-user-times"></i>
                                        <div class="permission-label-text">
                                            <strong>Quản lý khách thuê</strong>
