        height: 42px;
        border-radius: 12px;
        background: rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
        }

        .psc-hd-title {
        font-size: 15px;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.2px;
        }

