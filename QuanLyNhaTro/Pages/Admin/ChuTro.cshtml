        }

        .psc-room-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11.5px;
        font-weight: 800;
        color: #1e3a5f;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        padding: 2px 9px;
        border-radius: 9999px;
        }

        .psc-type-tag {
        font-size: 10.5px;
        font-weight: 700;
        color: #6b7a99;
        background: #f0f2f8;
        padding: 2px 8px;
        border-radius: 9999px;
        }

        /* badges */
        .psc-badge {
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 9999px;
        white-space: nowrap;
        }

        .psc-badge--urgent {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fca5a5;
        }

        .psc-badge--medium {
        background: #fef3c7;
        color: #d97706;
        border: 1px solid #fcd34d;
        }

        .psc-badge--low {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #86efac;
        }

        .psc-item-title {
        font-size: 13.5px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 5px;
        line-height: 1.35;
        }

        .psc-item-body {
        font-size: 12.5px;
        color: #6b7a99;
        line-height: 1.6;
        margin-bottom: 10px;
        }

        .psc-item-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        }

        .psc-item-info-row {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        }

        .psc-info-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 9999px;
        white-space: nowrap;
        }

        .psc-info-chip--person {
        background: #f5f3ff;
        color: #6d28d9;
        border: 1px solid #ddd6fe;
        }

        .psc-info-chip--time {
        background: #f0f2f8;
        color: #6b7a99;
        border: 1px solid #e5e9f5;
        }

        .psc-cost-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11.5px;
        font-weight: 800;
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        padding: 3px 10px;
        border-radius: 9999px;
        white-space: nowrap;
        }

        /* action buttons */
        .psc-item-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        }

        .psc-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 13px;
        border-radius: 9999px;
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        border: 1.5px solid transparent;
        font-family: inherit;
        transition: all 0.18s;
        white-space: nowrap;
        }

        .psc-btn--approve {
        background: #dcfce7;
        color: #16a34a;
        border-color: #86efac;
        }

        .psc-btn--approve:hover {
        background: #16a34a;
        color: #fff;
        border-color: #16a34a;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(22,163,74,0.3);
        }

        .psc-btn--reject {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fca5a5;
        }

        .psc-btn--reject:hover {
        background: #dc2626;
        color: #fff;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(220,38,38,0.3);
        }

        .psc-btn--view {
        background: #f0f2f8;
        color: #1d4ed8;
        border-color: #bfdbfe;
        }

        .psc-btn--view:hover {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #93c5fd;
        transform: translateY(-1px);
        }

        /* ── EMPTY STATE ── */
        .psc-empty {
        text-align: center;
        padding: 40px 20px;
        color: #9ca3af;
        font-size: 13px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        }

        /* ── FOOTER ── */
        .psc-ft {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 24px 16px;
        border-top: 1px solid #e5e9f5;
        background: #f8f9fd;
        }

        .psc-ft-count {
        font-size: 11.5px;
        color: #6b7a99;
        }

        .psc-ft-count strong {
        color: #111827;
        font-weight: 800;
        }

        .psc-ft-btns {
        display: flex;
        gap: 8px;
        }

        .psc-btn-cancel {
        padding: 9px 18px;
        border-radius: 10px;
        border: 1.5px solid #e5e9f5;
        background: transparent;
        font-size: 12.5px;
        font-weight: 700;
        color: #6b7a99;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.15s;
        }

        .psc-btn-cancel:hover {
        background: #f0f2f8;
        }

        .psc-btn-approve-all {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 20px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff;
        font-size: 12.5px;
        font-weight: 800;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 14px rgba(5,150,105,0.32);
        transition: all 0.2s;
        }

        .psc-btn-approve-all:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(5,150,105,0.44);
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 640px) {
        .psc-box {
        max-height: 95vh;
        border-radius: 16px;
        }

        .psc-stats {
        flex-wrap: wrap;
        gap: 10px;
        }

        .psc-stat-div {
        display: none;
        }

        .psc-item-footer {
        flex-direction: column;
        align-items: flex-start;
        }

        .psc-toolbar {
        flex-direction: column;
        }

        .psc-search-wrap {
        width: 100%;
        }
        }

        #tb-badge-muc-do.muc-canh-bao {
        background: #fef3c7;
        color: #d97706;
        border-color: #fcd34d;
        }

        #tb-badge-muc-do.muc-khan-cap {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fca5a5;
        }

        #tb-badge-muc-do.muc-thong-tin {
        background: #dbeafe;
        color: #1d4ed8;
        border-color: #bfdbfe;
        }
        /* =========================================================
        ADMIN HEADER DROPDOWN
        ========================================================= */
        .khoi-admin-header {
        position: relative;
        }

        .admin-dropdown {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 240px;
        background: var(--mau-trang);
        border-radius: 14px;
        border: 1px solid var(--mau-vien);
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(13,27,46,0.12), 0 2px 8px rgba(13,27,46,0.06);
        z-index: 999;
        transform-origin: top right;
        transform: scale(0.92) translateY(-8px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1), opacity 0.15s ease;
        }

        .admin-dropdown.show {
        transform: scale(1) translateY(0);
        opacity: 1;
        pointer-events: all;
        }

        .add-header {
        padding: 14px 16px 12px;
        border-bottom: 1px solid var(--mau-vien);
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .add-header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        flex-shrink: 0;
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        font-weight: 800;
        }

        .add-header-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--mau-chu);
        }

        .add-header-email {
        font-size: 11px;
        color: var(--mau-chu-phu);
        margin-top: 2px;
        }

        .add-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.4px;
        padding: 2px 8px;
        border-radius: var(--radius-full);
        margin-top: 4px;
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        color: #fff;
        }

        .add-body {
        padding: 6px;
        }

        .add-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 12px;
        border-radius: 9px;
        cursor: pointer;
        transition: background 0.14s;
        border: none;
        background: none;
        width: 100%;
        font-family: inherit;
        text-align: left;
        }

        .add-item:hover {
        background: var(--mau-nen);
        }

        .add-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        }

        .add-item-icon.vang {
        background: var(--mau-chu-de-nhat);
        color: var(--mau-chu-de);
        }

        .add-item-icon.do {
        background: var(--mau-do-nhat);
        color: var(--mau-do);
        }

        .add-item-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--mau-chu);
        }

        .add-item-sub {
        font-size: 10.5px;
        color: var(--mau-chu-phu);
        margin-top: 1px;
        }

        .add-item.danger:hover {
        background: var(--mau-do-nhat);
        }

        .add-item.danger:hover .add-item-label {
        color: var(--mau-do);
        }

        .add-divider {
        height: 1px;
        background: var(--mau-vien);
        margin: 4px 0;
        }
    </style>
</head>
<body>

