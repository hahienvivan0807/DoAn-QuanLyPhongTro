</nav><!-- Kết thúc SIDEBAR -->


<!-- =============================================
     KHU VỰC CHÍNH: HEADER + NỘI DUNG
============================================= -->
<div id="khu-vuc-chinh">

  <!-- ===== HEADER TRÊN CÙNG ===== -->
  <header id="thanh-header">
    <div class="header-trai">
      <!-- Nút ≡ bật/tắt sidebar -->
      <button class="nut-ham-burger" onclick="dongMoSidebar()">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-header">Cổng Chủ Trọ – Toàn Quyền Quản Lý</div>
        <div class="duong-dan-header">Trang chủ / Tổng quan</div>
      </div>
    </div>

    <div class="header-phai">
      <!-- Ô tìm kiếm -->
      <div class="o-tim-kiem">
        <i class="fas fa-search"></i>
        <!-- ⚙️ BACKEND: Kết nối API tìm kiếm -->
        <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
      </div>

      <!-- Chuông thông báo -->
      <button class="nut-chuong">
        <i class="fas fa-bell"></i>
        <!-- ⚙️ BACKEND: Lấy số thông báo chưa đọc -->
        <span class="so-chuong">7</span>
      </button>

      <!-- Thẻ vai trò chủ trọ -->
      <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;"></i>CHỦ TRỌ</span>

      <!-- Avatar + tên chủ trọ header -->
      <div class="khoi-admin-header">
        <div class="anh-dai-dien-header">C</div>
        <div>
          <!-- ⚙️ BACKEND: Lấy tên chủ trọ từ session đăng nhập -->
          <div class="ten-admin-header">Nguyễn Văn Chủ</div>
          <div class="vai-tro-header">Chủ sở hữu</div>
        </div>
        <i class="fas fa-chevron-down" style="font-size:10px;color:var(--mau-chu-phu);margin-left:2px;"></i>
      </div>
    </div>
  </header><!-- Kết thúc HEADER -->


  <!-- =============================================
       NỘI DUNG DASHBOARD CHÍNH
  ============================================= -->
  <main id="noi-dung-chinh">

    <!-- Dòng tiêu đề + nút thêm mới -->
    <div class="dong-tieu-de-trang">
      <div>
        <h2>Xin chào, Chủ Trọ! 👑</h2>
        <!-- ⚙️ BACKEND: Ngày giờ thực -->
        <p id="ngay-gio-chu-tro">Đang tải...</p>
      </div>
    </div>

    <!-- =============================================
         HÀNG 1 – 4 CARD THỐNG KÊ TỔNG QUAN
         (Tổng phòng | Doanh thu | Phòng trống | Sự cố)
    ============================================= -->
    <div class="hang-thong-ke-tong-quan">

      <!-- Card 1: Doanh thu tháng này -->
      <div class="card-thong-ke mau-vang">
        <div class="noi-dung-card-thong-ke">
          <div class="bieu-tuong-card"><i class="fas fa-coins"></i></div>
          <div class="so-lieu-card">
            <div class="con-so" style="font-size:22px;">
              <!-- ⚙️ BACKEND: Tổng doanh thu tháng hiện tại -->
              58.5M
            </div>
            <div class="nhan-card">Doanh thu tháng 5</div>
            <span class="the-ty-le tang">↑ +12% tháng trước</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Tổng phòng -->
      <div class="card-thong-ke mau-xanh-bien">
        <div class="noi-dung-card-thong-ke">
          <div class="bieu-tuong-card"><i class="fas fa-building"></i></div>
          <div class="so-lieu-card">
            <div class="con-so">
              <!-- ⚙️ BACKEND: Tổng số phòng trong DB -->
              48
            </div>
            <div class="nhan-card">Tổng số phòng</div>
            <span class="the-ty-le tang">↑ 81% lấp đầy</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Lợi nhuận ròng -->
      <div class="card-thong-ke mau-xanh-la">
        <div class="noi-dung-card-thong-ke">
          <div class="bieu-tuong-card"><i class="fas fa-chart-line"></i></div>
          <div class="so-lieu-card">
            <div class="con-so" style="font-size:22px;">
              <!-- ⚙️ BACKEND: Lợi nhuận = Thu - Chi -->
              44.2M
            </div>
            <div class="nhan-card">Lợi nhuận ròng</div>
            <span class="the-ty-le tang">↑ +8% tháng trước</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Chờ phê duyệt -->
      <div class="card-thong-ke mau-do">
        <div class="noi-dung-card-thong-ke">
          <div class="bieu-tuong-card"><i class="fas fa-clock"></i></div>
          <div class="so-lieu-card">
            <div class="con-so">
              <!-- ⚙️ BACKEND: Tổng yêu cầu chờ phê duyệt -->
              5
            </div>
            <div class="nhan-card">Chờ phê duyệt</div>
            <span class="the-ty-le giam">↑ 2 hợp đồng, 3 sửa chữa</span>
          </div>
        </div>
      </div>

    </div><!-- Kết thúc HÀNG 1 -->


    <!-- =============================================
         HÀNG 2 – CÁC TÍNH NĂNG ĐẶC BIỆT CỦA CHỦ TRỌ
         (6 card icon lớn, mỗi cái mở modal riêng)
