@page
@model QuanLyNhaTro.Pages.Admin.ChuTroModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ Thống Quản Lý – Chủ Trọ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/ChuTro.css" />
    <link rel="stylesheet" href="/css/Admin/ChuTro.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Javascript-->
    <script src="/js/ChuTro/ChuTro-ThongBao.js"></script>
    <script src="/js/ChuTro/ChuTro-core.js"></script>
    <script src="/js/ChuTro/ChuTro-quanLy.js"></script>
    <script src="/js/ChuTro/ChuTro-bieuDo.js"></script>
    <script src="/js/ChuTro/ChuTro-cauHinh.js"></script>
    <script src="/js/ChuTro/ChuTro-pheDuyet.js"></script>
    <script src="/js/ChuTro/ChuTro-NguoiThue.js"></script>
    <script src="/js/ChuTro/ChuTro-suaChua.js"></script>
</head>
<body>

    <!-- =============================================
     SIDEBAR – THANH ĐIỀU HƯỚNG TRÁI
============================================= -->
    <nav id="thanh-sidebar">

        <!-- Logo -->
        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo">
                <i class="fas fa-crown"></i>
            </div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <!-- Nhóm: Tổng quan -->
        <div class="nhan-nhom-menu">Tổng quan</div>

        <div class="muc-menu dang-chon" onclick="chuyenMenu('trang-chu', this)">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </div>

        <!-- Nhóm: Vận hành -->
        <div class="nhan-nhom-menu">Vận hành</div>

        <div class="muc-menu" onclick="chuyenMenu('quan-ly-phong', this)">
            <i class="fas fa-building"></i>
            <span>Quản lý phòng trọ</span>
        </div>
            <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
                <i class="fas fa-users"></i>
                <span>Người thuê</span>
            </div>
        <div class="muc-menu" onclick="chuyenMenu('hop-dong', this)">
            <i class="fas fa-file-contract"></i>
            <span>Hợp đồng</span>
            <span class="huy-hieu vang">2</span>
        </div>

        <!-- Nhóm: Quản trị chủ trọ -->
        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>

        <div class="muc-menu" onclick="window.location.href='/Admin/Taikhoanquanly'">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'"">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CauHinhGiaThue'">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/DichVuThongBao'">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </div>

        <!-- Nhóm: Hỗ trợ -->
        <div class="nhan-nhom-menu">Hỗ trợ</div>

        <div class="muc-menu" onclick="chuyenMenu('sua-chua', this)">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            <span id="huy-hieu-sua-chua" class="huy-hieu">-</span>
        </div>
        <div class="muc-menu" onclick="chuyenMenu('bao-cao', this)">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </div>
        <div class="muc-menu" onclick="chuyenMenu('cai-dat', this)">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </div>

        <!-- Thông tin chủ trọ -->
        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro">C</div>
            <div class="ten-chu">
                <strong>Chủ Trọ ABC</strong>
                <span>Chủ sở hữu</span>
            </div>
        </div>

    </nav><!-- Kết thúc SIDEBAR -->
    <!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Cổng Chủ Trọ – Toàn Quyền Quản Lý</div>
                    <div class="duong-dan-header">Trang chủ / Tổng quan</div>
                </div>
            </div>

            <div class="header-phai">
                <!-- Tìm kiếm -->
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
                </div>

                <!-- Chuông -->
                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">7</span>
                </button>

                <div class="header-divider"></div>

                <!-- Tag vai trò -->
                <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ</span>

                <!-- Avatar + tên -->
                <div class="khoi-admin-header" id="adminHeaderWrap">
                    <button onclick="toggleAdminMenu()" id="adminHeaderBtn"
                            style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:5px 10px;border-radius:var(--radius-full);border:none;background:none;font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-chu-de-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien-header">C</div>
                        <div>
                            <div class="ten-admin-header" id="header-ten-chu">Nguyễn Văn Chủ</div>
                            <div class="vai-tro-header">Chủ sở hữu</div>
                        </div>
                        <i class="fas fa-chevron-down" id="adminChevron"
                           style="font-size:9px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>
                    </button>

                    <div class="admin-dropdown" id="adminDropdown">
                        <div class="add-header">
                            <div class="add-header-avatar" id="dd-avatar">C</div>
                            <div>
                                <div class="add-header-name" id="dd-ten">Nguyễn Văn Chủ</div>
                                <div class="add-header-email" id="dd-email">chusonguyen@nhatrobanum.vn</div>
                                <span class="add-header-badge">
                                    <i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ
                                </span>
                            </div>
                        </div>

                        <div class="add-body">
                            <button class="add-item" onclick="moDoiMatKhau()">
                                <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="add-item-label">Đổi mật khẩu</div>
                                    <div class="add-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>

                            <div class="add-divider"></div>

                            <button class="add-item danger" onclick="xacNhanDangXuat()">
                                <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="add-item-label">Đăng xuất</div>
                                    <div class="add-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- =============================================
       NỘI DUNG DASHBOARD
  ============================================= -->
        <main id="noi-dung-chinh">

            <!-- Tiêu đề trang -->
            <div class="dong-tieu-de-trang">
                <div>
                    <h2>Xin chào, Chủ Trọ! 👑</h2>
                    <p id="ngay-gio-chu-tro">Đang tải...</p>
                </div>
            </div>

            <!-- =============================================
         HÀNG 1 – 4 CARD THỐNG KÊ
    ============================================= -->
            <div class="hang-thong-ke-tong-quan">

                <!-- Card 1: Doanh thu -->
                <div class="card-thong-ke mau-vang">
                    <div class="noi-dung-card-thong-ke">
                        <div class="bieu-tuong-card"><i class="fas fa-coins"></i></div>
                        <div class="so-lieu-card">
                            <div class="con-so" id="hien-thi-doanh-thu" style="font-size:22px;">0M</div>
                            <div class="nhan-card" id="hien-thi-thang">Doanh thu tháng...</div>
                            <span class="the-ty-le tang" id="hien-thi-ty-le">Đang tải...</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Tổng phòng -->
                <div class="card-thong-ke mau-xanh-bien card-phong">
                    <div class="noi-dung-card-thong-ke">
                        <div class="bieu-tuong-card"><i class="fas fa-building"></i></div>
                        <div class="so-lieu-card">
                            <div class="con-so">48</div>
                            <div class="nhan-card">Tổng số phòng</div>
                            <span class="the-ty-le tang">↑ 81% lấp đầy</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Lợi nhuận -->
                <div class="card-thong-ke mau-xanh-la">
                    <div class="noi-dung-card-thong-ke">
                        <div class="bieu-tuong-card"><i class="fas fa-chart-line"></i></div>
                        <div class="so-lieu-card">
                            <div class="con-so" style="font-size:22px;">44.2M</div>
                            <div class="nhan-card">Lợi nhuận ròng</div>
                            <span class="the-ty-le tang">↑ +8% tháng trước</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Chờ phê duyệt -->
                <div class="card-thong-ke mau-do">
                    <div class="noi-dung-card-thong-ke">
                        <div class="bieu-tuong-card"><i class="fas fa-clock"></i></div>
                        <div class="so-lieu-card">
                            <div class="con-so">5</div>
                            <div class="nhan-card">Chờ phê duyệt</div>
                            <span class="the-ty-le giam">↑ 2 HĐ, 3 sửa chữa</span>
                        </div>
                    </div>
                </div>

            </div><!-- Kết thúc HÀNG 1 -->
            <!-- =============================================
         HÀNG 2 – TÍNH NĂNG CHỦ TRỌ
    ============================================= -->
            <div class="hang-tinh-nang-chu-tro">

                <div class="card-tinh-nang" onclick="moModal('modal-tai-khoan-quan-ly')">
                    <div class="dau-tinh-nang mau-cam-nhat"><i class="fas fa-user-shield"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Cấp lại mật khẩu mới</div>
                        <div class="mo-ta-tinh-nang">Cấp lại mật khẩu cho người thuê khi quên mật khẩu.</div>
                    </div>
                    <span class="the-tinh-nang">Không cấp lại mật khẩu cũ</span>
                </div>

                <div class="card-tinh-nang" onclick="moModalQuanLyNguoiThue()">
                    <div class="dau-tinh-nang mau-tim-nhat"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Quản lý người thuê</div>
                        <div class="mo-ta-tinh-nang">Quản lý danh sách người thuê và thông tin phòng.</div>
                    </div>
                    <span class="the-tinh-nang">Xem danh sách người thuê</span>
                </div>

                <div class="card-tinh-nang" onclick="moModal('modal-cau-hinh-gia-v2')">
                    <div class="dau-tinh-nang mau-cyan-nhat"><i class="fas fa-tags"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Cấu hình giá thuê</div>
                        <div class="mo-ta-tinh-nang">Đặt giá thuê mặc định theo loại phòng. Áp dụng cho toàn bộ hệ thống.</div>
                    </div>
                    <span class="the-tinh-nang">3 mức giá đang áp dụng</span>
                </div>

                <div class="card-tinh-nang" onclick="moModalThongBao()">
                    <div class="dau-tinh-nang mau-luc-nhat"><i class="fas fa-bell"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Gửi thông báo</div>
                        <div class="mo-ta-tinh-nang">Gửi thông báo đến người thuê theo phòng hoặc toàn bộ.</div>
                    </div>
                    <span class="the-tinh-nang">Gửi ngay hoặc hẹn giờ</span>
                </div>

                <div class="card-tinh-nang" onclick="moModal('modal-dat-coc')">
                    <div class="dau-tinh-nang mau-hong-nhat"><i class="fas fa-hand-holding-usd"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Quy định đặt cọc</div>
                        <div class="mo-ta-tinh-nang">Thiết lập tỷ lệ đặt cọc, thời hạn hoàn trả và điều kiện khấu trừ.</div>
                    </div>
                    <span class="the-tinh-nang">Cọc = 2 tháng tiền thuê</span>
                </div>

                <div class="card-tinh-nang" onclick="moModalPheDouyetSuaChua()">
                    <div class="dau-tinh-nang mau-xanh-nhat-icon"><i class="fas fa-hammer"></i></div>
                    <div>
                        <div class="ten-tinh-nang">Phê duyệt sửa chữa lớn</div>
                        <div class="mo-ta-tinh-nang">Xem xét và phê duyệt các yêu cầu sửa chữa có chi phí vượt ngưỡng.</div>
                    </div>
                    <span class="the-tinh-nang" style="background:#fee2e2;color:#dc2626;border-color:#fecaca;">3 yêu cầu chờ duyệt</span>
                </div>

            </div><!-- Kết thúc HÀNG 2 -->
            <!-- =============================================
         HÀNG 3 – BIỂU ĐỒ + BÁO CÁO
    ============================================= -->
            <div class="hang-bieu-do-tai-chinh">

                <!-- Biểu đồ doanh thu -->
                <div class="card-bieu-do-lon">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-chart-area"></i> Doanh thu & Chi phí theo tháng</h3>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <select class="o-nhap o-chon" style="padding:5px 10px;font-size:12px;width:90px;">
                                <option>2025</option>
                                <option>2024</option>
                            </select>
                            <button class="nut-xem-them" onclick="moModal('modal-bao-cao-chi-tiet')">Chi tiết</button>
                        </div>
                    </div>
                    <canvas id="bieu-do-chu-tro" height="115"></canvas>
                </div>

                <!-- Báo cáo thu/chi tháng -->
                <div class="card-bao-cao-tai-chinh">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-balance-scale" style="color:#059669;"></i> Báo cáo tháng 5/2025</h3>
                        <button class="nut-xem-them" onclick="moModal('modal-bao-cao-chi-tiet')">Chi tiết</button>
                    </div>

                    <div class="dong-tai-chinh" onclick="moModal('modal-bao-cao-chi-tiet')">
                        <div class="nhan-tai-chinh">
                            <div class="dot-tai-chinh dot-xanh"></div>
                            <div>
                                <div class="ten-dong">Tiền thuê phòng</div>
                                <div class="phu-dong">39 phòng × trung bình 1.5M</div>
                            </div>
                        </div>
                        <div class="so-tien-dong thu">+58.5M</div>
                    </div>

                    <div class="dong-tai-chinh" onclick="moModal('modal-bao-cao-chi-tiet')">
                        <div class="nhan-tai-chinh">
                            <div class="dot-tai-chinh dot-do"></div>
                            <div>
                                <div class="ten-dong">Chi phí điện, nước</div>
                                <div class="phu-dong">Điện: 5.2M · Nước: 1.8M</div>
                            </div>
                        </div>
                        <div class="so-tien-dong chi">−7.0M</div>
                    </div>

                    <div class="dong-tai-chinh" onclick="moModal('modal-bao-cao-chi-tiet')">
                        <div class="nhan-tai-chinh">
                            <div class="dot-tai-chinh dot-do"></div>
                            <div>
                                <div class="ten-dong">Chi phí sửa chữa</div>
                                <div class="phu-dong">4 phòng bảo trì trong tháng</div>
                            </div>
                        </div>
                        <div class="so-tien-dong chi">−3.8M</div>
                    </div>

                    <div class="dong-tai-chinh" onclick="moModal('modal-bao-cao-chi-tiet')">
                        <div class="nhan-tai-chinh">
                            <div class="dot-tai-chinh dot-vang"></div>
                            <div>
                                <div class="ten-dong">Tiền đặt cọc mới</div>
                                <div class="phu-dong">2 hợp đồng mới ký tháng 5</div>
                            </div>
                        </div>
                        <div class="so-tien-dong thu">+7.0M</div>
                    </div>

                    <div class="dong-tai-chinh" onclick="moModal('modal-bao-cao-chi-tiet')">
                        <div class="nhan-tai-chinh">
                            <div class="dot-tai-chinh dot-do"></div>
                            <div>
                                <div class="ten-dong">Chi phí quản lý / lương</div>
                                <div class="phu-dong">3 quản lý + vệ sinh chung</div>
                            </div>
                        </div>
                        <div class="so-tien-dong chi">−10.5M</div>
                    </div>

                    <div class="tong-ket-tai-chinh">
                        <div>
                            <div class="nhan">Lợi nhuận ròng tháng 5</div>
                            <div style="font-size:10.5px;color:rgba(255,255,255,0.6);margin-top:2px;">Thu: 65.5M · Chi: 21.3M</div>
                        </div>
                        <div class="so">44.2M ↑</div>
                    </div>

                </div>

            </div><!-- Kết thúc HÀNG 3 -->
            <!-- =============================================
         HÀNG 4 – PHÊ DUYỆT + QUẢN LÝ NHÂN SỰ
    ============================================= -->
            <div class="hang-phe-duyet-quan-ly">

                <!-- Card phê duyệt hợp đồng -->
                <div class="card-phe-duyet vien-do">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-file-contract" style="color:#dc2626;"></i> Phê duyệt hợp đồng</h3>
                        <button class="nut-xem-them" onclick="chuyenMenu('hop-dong', null)">Xem tất cả</button>
                    </div>

                    <div class="dong-phe-duyet">
                        <div class="bieu-tuong-phe-duyet mau-hong-nhat">
                            <i class="fas fa-file-times" style="color:#e11d48;"></i>
                        </div>
                        <div class="noi-dung-phe-duyet" style="flex:1;">
                            <div class="tieu-de-phe-duyet">Yêu cầu xóa HĐ – Phòng 302</div>
                            <div class="mo-ta-phe-duyet">Trần Thị Mai · Lý do: chuyển công tác</div>
                            <div class="nhom-nut-phe-duyet">
                                <button class="nut-duyet" onclick="pheDuyet('HD-302', 'xoa')">✓ Duyệt xóa</button>
                                <button class="nut-tu-choi" onclick="tuChoi('HD-302')">✕ Từ chối</button>
                                <button class="nut-xem-chi-tiet-pd" onclick="moModal('modal-chi-tiet-hop-dong')">Xem HĐ</button>
                            </div>
                        </div>
                        <div class="tieu-de-phe-duyet-muc">2 giờ trước</div>
                    </div>

                    <div class="dong-phe-duyet">
                        <div class="bieu-tuong-phe-duyet mau-cyan-nhat">
                            <i class="fas fa-redo" style="color:#0891b2;"></i>
                        </div>
                        <div class="noi-dung-phe-duyet" style="flex:1;">
                            <div class="tieu-de-phe-duyet">Yêu cầu gia hạn HĐ – Phòng 105</div>
                            <div class="mo-ta-phe-duyet">Nguyễn Văn Bình · Thêm 6 tháng</div>
                            <div class="nhom-nut-phe-duyet">
                                <button class="nut-duyet" onclick="pheDuyet('HD-105', 'gia-han')">✓ Phê duyệt</button>
                                <button class="nut-tu-choi" onclick="tuChoi('HD-105')">✕ Từ chối</button>
                                <button class="nut-xem-chi-tiet-pd" onclick="moModal('modal-chi-tiet-hop-dong')">Xem HĐ</button>
                            </div>
                        </div>
                        <div class="tieu-de-phe-duyet-muc">5 giờ trước</div>
                    </div>

                    <div class="dong-phe-duyet" style="background:var(--mau-nen);border-radius:10px;padding:12px;border:1.5px solid var(--mau-vien);margin-top:4px;">
                        <i class="fas fa-hammer" style="color:#7c3aed;font-size:18px;"></i>
                        <div style="flex:1;margin-left:12px;">
                            <div style="font-size:12.5px;font-weight:700;">Sửa chữa lớn đang chờ duyệt</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">3 yêu cầu · Chi phí ước tính: 12.5M</div>
                        </div>
                        <button class="nut-hanh-dong-chinh" style="font-size:12px;padding:7px 14px;" onclick="moModalPheDouyetSuaChua()">
                            Xem duyệt
                        </button>
