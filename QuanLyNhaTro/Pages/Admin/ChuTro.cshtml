                            </button>
                            <span class="room-btn-icon-chg"><i class="fas fa-door-open"></i></span>

                            <div class="room-panel-chg" id="chgRoomPanel">
                                <!-- Search -->
                                <div class="rpc-search">
                                    <i class="fas fa-search"></i>
                                    <input type="text" id="chg-rp-q"
                                           placeholder="Tìm số phòng, tầng..."
                                           oninput="chgRenderRooms()" />
                                </div>
                                <!-- Filters -->
                                <div class="rpc-filters">
                                    <button class="rfc ra" id="chg-rf-all"
                                            onclick="chgSetFilter('all',this)">
                                        Tất cả
                                    </button>
                                    <button class="rfc rt" id="chg-rf-trong"
                                            onclick="chgSetFilter('Trống',this)">
                                        Trống
                                    </button>
                                    <button class="rfc rr" id="chg-rf-datthue"
                                            onclick="chgSetFilter('Đã thuê',this)">
                                        Đã thuê
                                    </button>
                                    <button class="rfc rs" id="chg-rf-dangsua"
                                            onclick="chgSetFilter('Đang sửa',this)">
                                        Đang sửa
                                    </button>
                                </div>
                                <!-- Room list -->
                                <div class="rpc-list" id="chgRpList">
                                    <!-- Gọi API lấy danh sách phòng tại đây -->
                                </div>
                            </div>
                        </div>
                        <div class="f-note">Có thể chỉnh sửa phòng ở bất kỳ trạng thái nào.</div>
                    </div>

                    <div class="mdiv" style="margin-top:0;"></div>
                    <div class="chg-sec"><i class="fas fa-edit"></i> Thông tin phòng</div>

                    <!-- Fields group – bị lock khi chưa chọn phòng -->
                    <div class="fields-group locked" id="chg-phong-fields">

                        <div class="fg2">
                            <!-- SoPhong -->
                            <div class="field">
                                <label class="f-lbl">Số phòng <span class="req">*</span></label>
                                <input class="inp" type="text" id="phong-so"
                                       placeholder="VD: 101" disabled />
                            </div>
                            <!-- Tang -->
                            <div class="field">
                                <label class="f-lbl">Tầng <span class="req">*</span></label>
                                <input class="inp" type="number" id="phong-tang"
                                       placeholder="VD: 1" min="1" disabled />
                            </div>
                            <!-- TrangThai -->
                            <div class="field">
                                <label class="f-lbl">Trạng thái <span class="req">*</span></label>
                                <select class="inp" id="phong-trang-thai" disabled>
                                    <option value="Trống">Trống</option>
                                    <option value="Đã thuê">Đã thuê</option>
                                    <option value="Đang sửa">Đang sửa</option>
                                </select>
                            </div>
                            <!-- DienTich -->
                            <div class="field">
                                <label class="f-lbl">Diện tích (m²) <span class="req">*</span></label>
                                <div class="inp-u">
                                    <input class="inp" type="number" id="phong-dien-tich"
                                           placeholder="VD: 22" min="1" disabled />
                                    <span class="unit">m²</span>
                                </div>
                            </div>
                            <!-- GiaPhongFix -->
                            <div class="field" style="grid-column:1/-1;">
                                <label class="f-lbl">Giá phòng cố định (GiaPhongFix)</label>
                                <div class="inp-u">
                                    <input class="inp" type="number" id="phong-gia-fix"
                                           placeholder="Để trống = dùng giá mặc định hệ thống"
                                           min="0" disabled />
                                    <span class="unit">đ/tháng</span>
                                </div>
                                <div class="f-note">
                                    Nếu đặt giá riêng, giá này sẽ ưu tiên cao hơn cấu hình mặc định.
                                    Để trống để dùng giá chung.
                                </div>
                            </div>
                        </div>

                        <!-- MoTa – textarea -->
                        <div class="field" style="margin-bottom:6px;">
                            <label class="f-lbl">Mô tả phòng</label>
                            <textarea class="inp" id="phong-mo-ta" rows="3"
                                      placeholder="VD: Phòng gần cầu thang, có ban công, máy lạnh 2 chiều..."
                                      disabled></textarea>
                            <div class="f-note">Thông tin thêm về tiện ích, vị trí, đặc điểm phòng.</div>
                        </div>

                    </div><!-- /fields-group -->
                    <!-- hint khi chưa chọn phòng -->
                    <div id="chg-phong-hint"
                         style="text-align:center;padding:24px 0 8px;color:#6b7a99;font-size:12.5px;">
                        <i class="fas fa-hand-pointer"
                           style="font-size:22px;display:block;margin-bottom:8px;color:#0891b2;opacity:0.6;"></i>
                        Hãy chọn một phòng ở trên để bắt đầu chỉnh sửa.
                    </div>

                </div><!-- /panel-phong -->

            </div><!-- /chg-body -->
            <!-- ── FOOTER ── -->
            <div class="chg-ft">
                <div class="ft-note"><span>*</span> Trường bắt buộc</div>
                <div class="ft-btns">
                    <button class="btn-cancel-chg" onclick="chgDong()">Hủy</button>
                    <button class="btn-confirm-chg" id="chg-btn-submit"
                            onclick="chgSubmit()">
                        <i class="fas fa-check"></i>
                        <span id="chg-btn-label">Xác nhận thay đổi</span>
                    </button>
                </div>
            </div>

        </div><!-- /chg-box -->
    </div><!-- /modal -->
    <!-- Thông báo-->
    <div class="toast-container" id="toastContainer" style="position:fixed;top:24px;right:24px;display:flex;flex-direction:column;gap:10px;z-index:99999;"></div>
    <!-- MODAL: THÊM TÀI KHOẢN QUẢN LÝ -->
    <div class="lop-phu-modal" id="modal-them-quan-ly"
         onclick="dongModalNhapNgoai(event,'modal-them-quan-ly')">
        <div class="hop-modal" style="width:560px;">

            <!-- Header tím -->
            <div style="display:flex;align-items:center;justify-content:space-between;
                padding:18px 24px 16px;flex-shrink:0;
                background:linear-gradient(135deg,#5b21b6,#7c3aed,#8b5cf6);
                border-radius:16px 16px 0 0;margin:-28px -28px 20px;
                position:relative;overflow:hidden;">
                <div style="position:absolute;top:-30px;right:-30px;width:110px;height:110px;
                border-radius:50%;background:rgba(255,255,255,0.07);pointer-events:none;"></div>
                <div style="position:absolute;bottom:-20px;right:70px;width:70px;height:70px;
                border-radius:50%;background:rgba(255,255,255,0.05);pointer-events:none;"></div>
                <div style="display:flex;align-items:center;gap:12px;position:relative;z-index:1;">
                    <div style="width:40px;height:40px;border-radius:12px;background:rgba(255,255,255,0.2);
                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas fa-user-plus" style="font-size:16px;color:#fff;"></i>
                    </div>
                    <div>
                        <div style="font-size:15px;font-weight:800;color:#fff;font-family:'Lexend',sans-serif;">
                            Thêm tài khoản quản lý
                        </div>
                        <div style="font-size:11px;color:rgba(255,255,255,0.62);margin-top:2px;">
                            Tạo tài khoản mới với quyền Manager
                        </div>
                    </div>
                </div>
                <button class="nut-dong-modal"
                        style="background:rgba(255,255,255,0.18);color:#fff;"
                        onclick="dongModal('modal-them-quan-ly')">
                    ✕
                </button>
            </div>

            <!-- Banner thông tin -->
            <div style="display:flex;align-items:flex-start;gap:9px;padding:10px 13px;
                background:#f5f3ff;border-left:3px solid #7c3aed;
                border-radius:0 10px 10px 0;font-size:12.5px;color:#3c3489;
                line-height:1.55;margin-bottom:18px;">
                <i class="fas fa-info-circle" style="color:#7c3aed;margin-top:2px;flex-shrink:0;"></i>
                <span>
                    Tài khoản sẽ được cấp quyền <strong>Manager</strong> – có thể quản lý phòng,
                    người thuê và hóa đơn. Mật khẩu được mã hóa BCrypt trước khi lưu.
                </span>
            </div>

            <!-- Section label -->
            <div class="tieu-de-muc-modal" style="color:#7c3aed;">
                <i class="fas fa-id-badge"></i> Thông tin tài khoản
            </div>

            <!-- Form 2 cột -->
            <div class="luoi-form-2">
                <!-- Họ và tên -->
                <div class="nhom-nhap">
                    <label class="nhan-nhap">
                        Họ và tên <span style="color:#dc2626;">*</span>
                    </label>
                    <input class="o-nhap" type="text" id="fullname-moi"
                           placeholder="VD: Nguyễn Văn Quản Lý" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">
                        Chỉ chữ cái và khoảng trắng, không ký tự đặc biệt
                    </div>
                </div>
                <!-- Username -->
                <div class="nhom-nhap">
                    <label class="nhan-nhap">
                        Username <span style="color:#dc2626;">*</span>
                    </label>
                    <input class="o-nhap" type="text" id="username-moi"
                           placeholder="VD: nguyenvanql" maxlength="50" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">
                        Chỉ chữ và số, tối đa 50 ký tự
                    </div>
                </div>
                <!-- Số điện thoại -->
                <div class="nhom-nhap">
                    <label class="nhan-nhap">
                        Số điện thoại <span style="color:#dc2626;">*</span>
                    </label>
                    <input class="o-nhap" type="tel" id="phone-moi"
                           placeholder="VD: 0901234567" maxlength="10" />
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">
                        Đúng 10 chữ số
                    </div>
                </div>
                <!-- Mật khẩu -->
                <div class="nhom-nhap">
                    <label class="nhan-nhap">
                        Mật khẩu <span style="color:#dc2626;">*</span>
                    </label>
                    <div style="position:relative;">
                        <input class="o-nhap" type="password" id="password-moi"
                               placeholder="Tối thiểu 6 ký tự"
                               style="padding-right:40px;" />
                        <button type="button"
                                onclick="
                            const i=document.getElementById('password-moi');
                            const c=this.querySelector('i');
                            if(i.type==='password'){i.type='text';c.className='fas fa-eye-slash';}
                            else{i.type='password';c.className='fas fa-eye';}
                            "
                                style="position:absolute;right:10px;top:50%;transform:translateY(-50%);
                            background:none;border:none;cursor:pointer;
                            color:var(--mau-chu-phu);font-size:13px;">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">
                        Sẽ được mã hóa BCrypt
                    </div>
                </div>
            </div>

            <!-- Vai trò cố định (readonly) -->
            <div class="nhom-nhap" style="margin-top:14px;">
                <label class="nhan-nhap">Vai trò</label>
                <input type="hidden" id="role-moi" value="Manager" />
                <div style="display:flex;align-items:center;gap:9px;padding:10px 13px;
                    border:1.5px solid var(--mau-vien);border-radius:var(--radius-md);
                    background:var(--mau-nen);">
                    <i class="fas fa-shield-alt" style="color:#7c3aed;font-size:14px;flex-shrink:0;"></i>
                    <span style="font-size:13px;font-weight:700;flex:1;">Manager</span>
                    <span style="font-size:9.5px;font-weight:700;padding:2px 9px;border-radius:9999px;
                        background:#f5f3ff;color:#3c3489;border:1px solid #afa9ec;">
                        Cố định
                    </span>
                </div>
                <div style="font-size:10.5px;color:var(--mau-chu-phu);margin-top:4px;">
                    Giá trị <code style="font-size:10.5px;">Manager</code> được gửi tự động lên API
                </div>
            </div>

            <!-- Footer -->
            <div class="nhom-nut-duoi-modal" style="margin-top:22px;">
                <button class="nut-huy-modal"
                        onclick="dongModal('modal-them-quan-ly')">
                    Hủy
                </button>
                <button class="nut-luu-modal"
                        style="background:linear-gradient(135deg,#5b21b6,#7c3aed);
                    box-shadow:0 4px 14px rgba(124,58,237,0.32);"
                        onclick="ThemUser()">
                    <i class="fas fa-user-plus"></i> Tạo tài khoản
                </button>
            </div>

        </div>
    </div>
    <script>
        // ===== CẬP NHẬT NGÀY GIỜ =====
        (function capNhatNgayGio() {    
        const ngay = new Date();
        const t = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        document.getElementById('ngay-gio-chu-tro').textContent =
        `${t[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
        })();
        // ===== CẬP NHẬT HUY HIỆU SIDEBAR =====
        (function() {
        const chuaHoanThanh = document.querySelectorAll('.card-su-co[data-filter*="chua-hoan-thanh"]').length;
        const el = document.getElementById('huy-hieu-sua-chua');
        if (el) {
        el.textContent = chuaHoanThanh > 0 ? chuaHoanThanh : '';
        el.style.display = chuaHoanThanh > 0 ? '' : 'none';
        }
        })();
    </script>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
