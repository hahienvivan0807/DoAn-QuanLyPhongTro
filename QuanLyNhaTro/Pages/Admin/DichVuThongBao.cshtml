        .o-nhap {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--mau-vien);
        border-radius: var(--radius-md);
        font-size: 13px;
        outline: none;
        transition: all 0.2s;
        color: var(--mau-chu);
        font-family: inherit;
        background: #fff;
        }

        .o-nhap:focus {
        border-color: var(--mau-chu-de);
        box-shadow: 0 0 0 3px var(--mau-chu-de-vien);
        }

        .nhan-nhap {
        display: block;
        font-size: 11.5px;
        font-weight: 700;
        margin-bottom: 7px;
        color: var(--mau-chu);
        }

