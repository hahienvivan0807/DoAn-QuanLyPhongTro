        background: #fff;
        box-shadow: 0 0 0 3px rgba(8,145,178,0.1);
        }

        .ls-search-wrap i {
        color: var(--mau-chu-phu);
        font-size: 12px;
        flex-shrink: 0;
        }

        .ls-search-wrap input {
        border: none;
        background: none;
        outline: none;
        font-size: 12.5px;
        color: var(--mau-chu);
        font-family: inherit;
        width: 100%;
        }

        .ls-search-wrap input::placeholder {
