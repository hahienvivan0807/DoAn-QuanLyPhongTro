        font-weight: 800;
        color: #fff;
        font-family: 'Lexend', sans-serif;
        position: relative;
        z-index: 1;
        }

        .card-gui-hd p {
        font-size: 11px;
        color: rgba(255,255,255,0.65);
        margin-top: 2px;
        position: relative;
        z-index: 1;
        }

        .card-gui-body {
        padding: 24px;
        }

        .form-section-lbl {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 9.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: var(--mau-chu-phu);
        margin: 0 0 14px;
        padding-bottom: 9px;
        border-bottom: 1.5px solid var(--mau-vien);
        }

        .form-section-lbl i {
