        .btn-gui-tb:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(8,145,178,0.48);
        }

        /* Preview người nhận */
        #tb-preview-nguoi-nhan {
        display: none;
        padding: 10px 14px;
        background: #f0f9ff;
        border-left: 3px solid #0891b2;
        border-radius: 0 10px 10px 0;
        font-size: 12.5px;
        color: #0c4a6e;
        margin-top: 10px;
        line-height: 1.6;
        }

        /* ============================================================
        PANEL PHẢI – THÔNG BÁO TỰ ĐỘNG
        ============================================================ */
        .right-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
        }

        .card-tu-dong {
        background: var(--mau-trang);
        border-radius: var(--radius-xl);
        box-shadow: var(--bong-card);
        border: 1.5px solid var(--mau-vien);
        overflow: hidden;
        }

        .card-tu-dong-hd {
        padding: 16px 20px;
        border-bottom: 1px solid var(--mau-vien);
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .card-tu-dong-hd .hd-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        }

        .card-tu-dong-hd h4 {
        font-size: 13.5px;
        font-weight: 800;
        font-family: 'Lexend', sans-serif;
        }

        .card-tu-dong-hd p {
        font-size: 11px;
        color: var(--mau-chu-phu);
        margin-top: 1px;
        }

        .tu-dong-body {
        padding: 8px 0;
        }

        /* Toggle rows */
        .toggle-row {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        border-bottom: 1px solid var(--mau-vien);
        gap: 12px;
        transition: background 0.15s;
        }

        .toggle-row:last-child {
        border-bottom: none;
        }

        .toggle-row:hover {
        background: var(--mau-nen);
        }

        .toggle-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
        }

        .toggle-txt {
        flex: 1;
        }

        .toggle-name {
        font-size: 12.5px;
        font-weight: 700;
        }

        .toggle-sub {
        font-size: 10.5px;
        color: var(--mau-chu-phu);
        margin-top: 1px;
        }

        /* iOS-style toggle switch */
        .toggle-switch {
        position: relative;
        width: 38px;
        height: 22px;
        flex-shrink: 0;
        }

        .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
        }

        .toggle-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #d1d5db;
        border-radius: 11px;
        transition: background 0.25s;
        }

        .toggle-slider::before {
        content: '';
        position: absolute;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #fff;
        left: 3px;
        top: 3px;
        transition: transform 0.25s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }

        .toggle-switch input:checked + .toggle-slider {
        background: #0891b2;
        }

        .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(16px);
        }

        /* ============================================================
        LỊCH SỬ THÔNG BÁO
        ============================================================ */
        .card-lich-su {
        background: var(--mau-trang);
