                    <button onclick="luuCaiDatTuDong()"
                            style="width:100%;background:linear-gradient(135deg,#0f52ba,#0891b2);color:#fff;border:none;border-radius:var(--radius-md);padding:12px;font-size:13px;font-weight:800;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 14px rgba(8,145,178,0.32);transition:all 0.2s;"
                            onmouseover="this.style.transform='translateY(-2px)'"
                            onmouseout="this.style.transform='none'">
                        <i class="fas fa-save"></i> Lưu cài đặt thông báo tự động
                    </button>

                </div>
            </div>

            <!-- LỊCH SỬ THÔNG BÁO -->
            <div class="card-lich-su">

                <div class="lich-su-hd">
                    <h3><i class="fas fa-history"></i> Lịch sử thông báo</h3>
                    <button class="btn-xem-them-ls" onclick="taiThemLichSu()">
                        <i class="fas fa-redo"></i> Tải lại
                    </button>
                </div>

                <!-- Toolbar filter -->
                <div class="lich-su-toolbar">
                    <div class="ls-search-wrap">
                        <i class="fas fa-search"></i>
                        <input type="text" id="ls-search-input"
                               placeholder="Tìm theo tiêu đề, người nhận..."
                               oninput="locLichSuThongBao(this.value)" />
                    </div>
                    <div class="ls-filter-chips">
                        <button class="ls-chip active" id="ls-chip-all"
                                onclick="setLsChip('all', this)">
                            Tất cả
                        </button>
                        <button class="ls-chip" id="ls-chip-da-gui"
                                onclick="setLsChip('da-gui', this)">
                            ✓ Đã gửi
                        </button>
                        <button class="ls-chip" id="ls-chip-hen-gio"
                                onclick="setLsChip('hen-gio', this)">
                            ⏰ Hẹn giờ
                        </button>
                        <button class="ls-chip" id="ls-chip-that-bai"
                                onclick="setLsChip('that-bai', this)">
                            ✕ Thất bại
                        </button>
                    </div>
                </div>

                <!-- Bảng dữ liệu -->
                <div class="lich-su-table-wrap">
                    <table class="lich-su-table">
                        <thead>
                            <tr>
                                <th>Tiêu đề / Người nhận</th>
                                <th>Mức độ</th>
                                <th>Loại</th>
                                <th>Ngày gửi</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="lich-su-tb-body">
                            <!-- JS inject dữ liệu từ API vào đây -->
                            <tr id="ls-loading-row">
                                <td colspan="6" style="text-align:center;padding:36px;color:var(--mau-chu-phu);">
                                    <i class="fas fa-spinner fa-spin" style="font-size:20px;display:block;margin-bottom:8px;color:#0891b2;"></i>
                                    Đang tải lịch sử thông báo...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="lich-su-ft">
                    <div class="ls-ft-count">
                        Hiển thị <strong id="ls-result-count">—</strong> thông báo
                    </div>
                    <button class="btn-xem-them-ls" onclick="taiThemLichSu()">
                        <i class="fas fa-plus"></i> Xem thêm
                    </button>
                </div>

            </div><!-- /card-lich-su -->

        </main>
    </div>

    <!-- =============================================
 TOAST CONTAINER
============================================= -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- =============================================
 MODAL: CHI TIẾT THÔNG BÁO (xem lại)
============================================= -->
    <div class="lop-phu-modal" id="modal-chi-tiet-thong-bao"
         onclick="dongModalNhapNgoai(event, 'modal-chi-tiet-thong-bao')">
        <div class="hop-modal" style="width:480px;">
            <div class="tieu-de-modal">
                <h3>
                    <span style="width:32px;height:32px;background:linear-gradient(135deg,#0f52ba,#0891b2);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:14px;">
                        <i class="fas fa-bell"></i>
                    </span>
                    Chi tiết thông báo
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet-thong-bao')">✕</button>
            </div>
            <div id="noi-dung-chi-tiet-thong-bao" style="font-size:13px;color:var(--mau-chu);line-height:1.7;">
                <!-- JS inject -->
            </div>
            <div class="nhom-nut-duoi-modal">
                <button class="nut-huy-modal" onclick="dongModal('modal-chi-tiet-thong-bao')">Đóng</button>
            </div>
        </div>
    </div>

    <!-- =============================================
 SCRIPTS
============================================= -->
    <script>
        // ── Ngày giờ header ──────────────────────────────────────────────
        (function() {
        const d = new Date();
        const days = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        // Có thể gán vào breadcrumb nếu cần
        })();

        // ── Đặt giá trị mặc định datetime-local = bây giờ ───────────────
        (function () {
        const el = document.getElementById('tb-ngay-gui');
        if (el) {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        el.value = now.toISOString().slice(0, 16);
        }
        })();

        // ── Admin dropdown toggle (kế thừa từ ChuTro) ───────────────────
        function toggleAdminMenu() {
        const dd = document.getElementById('adminDropdown');
        const ch = document.getElementById('adminChevron');
        if (!dd) return;
        dd.classList.toggle('show');
        if (ch) ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
        }
        document.addEventListener('click', function(e) {
        const wrap = document.getElementById('adminHeaderWrap');
        const dd = document.getElementById('adminDropdown');
        if (wrap && dd && !wrap.contains(e.target)) {
        dd.classList.remove('show');
        const ch = document.getElementById('adminChevron');
        if (ch) ch.style.transform = '';
        }
        });

        // ── Sidebar toggle ───────────────────────────────────────────────
        function dongMoSidebar() {
        const sb = document.getElementById('thanh-sidebar');
        if (!sb) return;
        if (window.innerWidth <= 768) {
        sb.classList.toggle('mo');
        } else {
        sb.classList.toggle('an');
        }
        }

        // ── Modal helpers (giữ nguyên ID/tên hàm cho JS backend) ────────
        function moModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('hien');
        }
        function dongModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('hien');
        }
        function dongModalNhapNgoai(e, id) {
        if (e.target === document.getElementById(id)) dongModal(id);
        }

        // ── Bảng mức độ badge (giữ nguyên ID: tb-badge-muc-do) ──────────
        // Hàm tbCapNhatMucDo được gọi bởi ChuTro-ThongBao.js;
        // nếu file JS đó không tự cập nhật class, dùng fallback sau:
        if (typeof tbCapNhatMucDo === 'undefined') {
        window.tbCapNhatMucDo = function(val) {
        const badge = document.getElementById('tb-badge-muc-do');
        if (!badge) return;
        badge.className = 'muc-do-badge';
        if (val === 'canh-bao') {
        badge.classList.add('canh-bao');
        badge.textContent = '🟡 Quan trọng';
        } else if (val === 'khan-cap') {
        badge.classList.add('khan-cap');
        badge.textContent = '🔴 Khẩn cấp';
        } else {
        badge.classList.add('thong-tin');
        badge.textContent = '🔵 Thông tin thông thường';
        }
        };
        }

        // ── Hiện/ẩn selector phòng / người thuê ─────────────────────────
        // Hàm tbChuyenLoaiNguoiNhan được gọi bởi ChuTro-ThongBao.js;
        // fallback:
        if (typeof tbChuyenLoaiNguoiNhan === 'undefined') {
        window.tbChuyenLoaiNguoiNhan = function(val) {
        document.getElementById('tb-chon-phong').style.display = val === 'phong' ? '' : 'none';
        document.getElementById('tb-chon-nguoi').style.display = val === 'nguoi' ? '' : 'none';
        const prev = document.getElementById('tb-preview-nguoi-nhan');
        const txt = document.getElementById('tb-preview-text');
        if (prev && txt) {
        prev.style.display = '';
        txt.textContent = val === 'phong' ? 'Sẽ gửi đến tất cả người thuê trong phòng đã chọn'
        : val === 'nguoi' ? 'Sẽ gửi đến người thuê cụ thể'
        : 'Sẽ gửi đến tất cả người thuê';
        }
        };
        }

        // ── Lọc lịch sử thông báo ────────────────────────────────────────
        let _lsCurrentChip = 'all';
        function setLsChip(val, btn) {
        _lsCurrentChip = val;
        document.querySelectorAll('.ls-chip').forEach(c => c.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderLichSu();
        }
        function locLichSuThongBao(q) { renderLichSu(q); }

        // ── Render lịch sử (mock cho đến khi API sẵn sàng) ──────────────
        const MOCK_LICH_SU = [
        { id:1, tieu_de:'Thông báo cắt điện tầng 2', nguoi_nhan:'Tất cả người thuê', muc_do:'canh-bao', loai:'Thủ công', ngay_gui:'2025-05-10 09:30', trang_thai:'da-gui' },
        { id:2, tieu_de:'Nhắc tiền thuê tháng 5', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Tự động', ngay_gui:'2025-05-01 07:00', trang_thai:'da-gui' },
        { id:3, tieu_de:'Hóa đơn tháng 5', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Tự động', ngay_gui:'2025-05-01 06:00', trang_thai:'da-gui' },
        { id:4, tieu_de:'Sửa chữa ống nước phòng 204', nguoi_nhan:'Phòng 204', muc_do:'khan-cap', loai:'Thủ công', ngay_gui:'2025-04-28 14:00', trang_thai:'da-gui' },
        { id:5, tieu_de:'Nhắc hết hạn HĐ phòng 110', nguoi_nhan:'Phòng 110', muc_do:'canh-bao', loai:'Tự động', ngay_gui:'2025-06-01 08:00', trang_thai:'hen-gio' },
        { id:6, tieu_de:'Thông báo nội quy mới', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Thủ công', ngay_gui:'2025-04-20 10:00', trang_thai:'that-bai' },
        ];

        function renderLichSu(q) {
        const body = document.getElementById('lich-su-tb-body');
        const countEl = document.getElementById('ls-result-count');
        if (!body) return;

        const query = (q || document.getElementById('ls-search-input')?.value || '').toLowerCase();
        let data = MOCK_LICH_SU.filter(r => {
        const matchQ = !query || r.tieu_de.toLowerCase().includes(query) || r.nguoi_nhan.toLowerCase().includes(query);
        const matchChip = _lsCurrentChip === 'all' || r.trang_thai === _lsCurrentChip;
        return matchQ && matchChip;
        });

        if (countEl) countEl.textContent = data.length;

        if (data.length === 0) {
        body.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px;color:var(--mau-chu-phu);">
        <i class="fas fa-inbox" style="font-size:24px;display:block;margin-bottom:8px;opacity:0.4;"></i>
        Không tìm thấy thông báo nào
        </td></tr>`;
        return;
        }

        const muDoBadge = { 'thong-tin':'thong-tin', 'canh-bao':'canh-bao', 'khan-cap':'khan-cap' };
        const muDoTxt = { 'thong-tin':'🔵 Bình thường', 'canh-bao':'🟡 Quan trọng', 'khan-cap':'🔴 Khẩn cấp' };
        const tsTxt = { 'da-gui':'✓ Đã gửi', 'hen-gio':'⏰ Hẹn giờ', 'that-bai':'✕ Thất bại' };

        body.innerHTML = data.map(r => `
        <tr>
        <td>
        <div class="tb-title-cell">${r.tieu_de}</div>
        <div class="tb-nguoi-cell"><i class="fas fa-user" style="margin-right:4px;font-size:10px;"></i>${r.nguoi_nhan}</div>
        </td>
        <td><span class="badge-muc-do ${muDoBadge[r.muc_do]}">${muDoTxt[r.muc_do]}</span></td>
        <td style="font-size:12px;color:var(--mau-chu-phu);font-weight:600;">${r.loai}</td>
        <td style="font-size:12px;color:var(--mau-chu-phu);white-space:nowrap;">${r.ngay_gui}</td>
        <td><span class="badge-trang-thai ${r.trang_thai}">${tsTxt[r.trang_thai]}</span></td>
        <td>
        <button class="btn-icon-sm" title="Xem chi tiết" onclick="xemChiTietThongBao(${r.id})">
        <i class="fas fa-eye"></i>
        </button>
        ${r.trang_thai === 'hen-gio' ? `<button class="btn-icon-sm" title="Hủy hẹn giờ" onclick="huyHenGio(${r.id})"><i class="fas fa-times-circle" style="color:#d97706;"></i></button>` : ''}
        ${r.trang_thai === 'that-bai' ? `<button class="btn-icon-sm" title="Gửi lại" onclick="guiLai(${r.id})"><i class="fas fa-redo" style="color:#0891b2;"></i></button>` : ''}
        </td>
        </tr>`).join('');
        }

        // ── Cập nhật stats (mock) ────────────────────────────────────────
        function capNhatStats() {
        const total = MOCK_LICH_SU.length;
        const success = MOCK_LICH_SU.filter(r => r.trang_thai === 'da-gui').length;
        const scheduled = MOCK_LICH_SU.filter(r => r.trang_thai === 'hen-gio').length;
        const failed = MOCK_LICH_SU.filter(r => r.trang_thai === 'that-bai').length;
        document.getElementById('stat-tong-gui').textContent = total;
        document.getElementById('stat-thanh-cong').textContent = success;
        document.getElementById('stat-hen-gio').textContent = scheduled;
        document.getElementById('stat-that-bai').textContent = failed;
        }

        // ── Các hàm action (mock – backend sẽ override qua JS files) ────
        function xemChiTietThongBao(id) {
        const r = MOCK_LICH_SU.find(x => x.id === id);
        if (!r) return;
        const muDoTxt = { 'thong-tin':'🔵 Bình thường', 'canh-bao':'🟡 Quan trọng', 'khan-cap':'🔴 Khẩn cấp' };
        const tsTxt = { 'da-gui':'✓ Đã gửi', 'hen-gio':'⏰ Hẹn giờ', 'that-bai':'✕ Thất bại' };
        document.getElementById('noi-dung-chi-tiet-thong-bao').innerHTML = `
        <div style="background:var(--mau-nen);border-radius:12px;padding:16px;margin-bottom:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Tiêu đề</div><div style="font-weight:800;margin-top:3px;">${r.tieu_de}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Người nhận</div><div style="font-weight:800;margin-top:3px;">${r.nguoi_nhan}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Mức độ</div><div style="font-weight:800;margin-top:3px;">${muDoTxt[r.muc_do]}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Trạng thái</div><div style="font-weight:800;margin-top:3px;">${tsTxt[r.trang_thai]}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Loại</div><div style="font-weight:800;margin-top:3px;">${r.loai}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Ngày gửi</div><div style="font-weight:800;margin-top:3px;">${r.ngay_gui}</div></div>
        </div>`;
        moModal('modal-chi-tiet-thong-bao');
        }

        function huyHenGio(id) {
        const idx = MOCK_LICH_SU.findIndex(x => x.id === id);
        if (idx >= 0) {
        MOCK_LICH_SU.splice(idx, 1);
        renderLichSu();
        capNhatStats();
        hienToast('success', 'Đã hủy', 'Đã hủy thông báo hẹn giờ thành công.');
        }
        }

        function guiLai(id) {
        hienToast('info', 'Đang gửi lại', 'Hệ thống đang thử gửi lại thông báo...');
        }

        function lamMoiBieuDo() {
        renderLichSu();
        capNhatStats();
        hienToast('success', 'Đã làm mới', 'Dữ liệu đã được cập nhật.');
        }

        function taiThemLichSu() { renderLichSu(); }

        function xuatLichSuThongBao() {
        hienToast('info', 'Đang xuất', 'Đang tạo file báo cáo lịch sử thông báo...');
        }

        function luuCaiDatTuDong() {
        hienToast('success', 'Đã lưu', 'Cài đặt thông báo tự động đã được cập nhật.');
        }

        // ── guiThongBao fallback (nếu ChuTro-ThongBao.js chưa tải) ──────
        if (typeof guiThongBao === 'undefined') {
        window.guiThongBao = function() {
        const tieu_de = document.getElementById('tb-tieu-de')?.value?.trim();
        const noi_dung = document.getElementById('tb-noi-dung')?.value?.trim();
        const ngay_gui = document.getElementById('tb-ngay-gui')?.value;
        if (!tieu_de) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng nhập tiêu đề thông báo.'); return; }
        if (!noi_dung) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng nhập nội dung thông báo.'); return; }
        if (!ngay_gui) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng chọn ngày gửi.'); return; }
        hienToast('info', 'Đang xử lý', 'Đang gửi thông báo...');
        };
        }

        // ── Toast helper ─────────────────────────────────────────────────
        function hienToast(type, title, msg, duration) {
        if (typeof showToast === 'function') { showToast(type, title, msg, duration); return; }
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const dur = duration || 4000;
        const icons = { success:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#639922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>', fail:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>', warn:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF9F27" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>', info:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#378ADD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' };
        const toast = document.createElement('div');
        toast.className = `toast toast-${type === 'error' ? 'fail' : type}`;
        toast.innerHTML = `<div class="toast-icon-wrap">${icons[type] || icons.info}</div><div class="toast-body"><div class="toast-title">${title}</div><div class="toast-msg">${msg}</div></div><button class="toast-close" onclick="this.closest('.toast').remove()">✕</button><div class="toast-progress" style="animation-duration:${dur}ms;"></div>`;
        container.appendChild(toast);
        requestAnimationFrame(() => { requestAnimationFrame(() => toast.classList.add('show')); });
        setTimeout(() => { toast.classList.add('hide'); setTimeout(() => toast.remove(), 300); }, dur);
        }

        // ── Đăng xuất placeholder ────────────────────────────────────────
        if (typeof xacNhanDangXuat === 'undefined') {
        window.xacNhanDangXuat = function() {
        if (confirm('Bạn có chắc muốn đăng xuất?')) window.location.href = '/logout';
        };
        }
        if (typeof moDoiMatKhau === 'undefined') {
        window.moDoiMatKhau = function() { hienToast('info','Đổi mật khẩu','Chức năng đang phát triển.'); };
        }

        // ── Init ─────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function() {
        capNhatStats();
        renderLichSu();
        });
    </script>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
