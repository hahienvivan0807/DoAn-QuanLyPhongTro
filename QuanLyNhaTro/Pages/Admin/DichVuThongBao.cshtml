        color: #0891b2;
        }

        .fg2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
        }

        .f-span2 {
        grid-column: 1/-1;
        }

        .field {
