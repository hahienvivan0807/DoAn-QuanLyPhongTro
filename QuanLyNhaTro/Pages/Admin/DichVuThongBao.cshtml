        background: linear-gradient(135deg, #0f52ba 0%, #0891b2 55%, #06b6d4 100%);
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        overflow: hidden;
        }

        .card-gui-hd::before {
        content: '';
