        /* ============================================================
        TOAST
        ============================================================ */
        .toast-container {
        position: fixed;
        top: 24px;
        right: 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        z-index: 99999;
        pointer-events: none;
        }

        .toast {
        pointer-events: all;
        min-width: 280px;
        max-width: 340px;
        background: #fff;
        border: 0.5px solid #e5e9f5;
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        transform: translateX(120%);
        opacity: 0;
        transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.25s ease;
        position: relative;
        overflow: hidden;
        }

        .toast.show {
        transform: translateX(0);
        opacity: 1;
        }

        .toast.hide {
        transform: translateX(120%);
        opacity: 0;
        transition: transform 0.25s ease, opacity 0.2s ease;
        }

        .toast-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        }

        .toast-body {
        flex: 1;
        }

        .toast-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 2px;
        }

        .toast-msg {
        font-size: 12px;
        color: #6b7a99;
        line-height: 1.5;
        }

        .toast-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #6b7a99;
        font-size: 14px;
        padding: 2px;
        }

        .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2.5px;
        animation: progress linear forwards;
        }

        @@keyframes progress {
        from {
        width: 100%;
        }

        to {
        width: 0%;
        }
        }

        .toast-success .toast-icon-wrap {
        background: #EAF3DE;
        }

        .toast-fail .toast-icon-wrap {
        background: #FCEBEB;
        }

        .toast-warn .toast-icon-wrap {
        background: #FAEEDA;
        }

        .toast-info .toast-icon-wrap {
        background: #E6F1FB;
        }

        .toast-success .toast-progress {
        background: #639922;
        }

        .toast-fail .toast-progress {
        background: #E24B4A;
        }

        .toast-warn .toast-progress {
        background: #EF9F27;
        }

        .toast-info .toast-progress {
        background: #378ADD;
        }

        /* ============================================================
        MODAL DÙNG CHUNG (KẾ THỪA)
        ============================================================ */
        .lop-phu-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10,20,40,0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(6px);
        }

        .lop-phu-modal.hien {
        display: flex;
        }

        .hop-modal {
        background: var(--mau-trang);
        border-radius: var(--radius-xl);
        padding: 28px;
        width: 540px;
        max-width: 96vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 24px 64px rgba(0,0,0,0.2),0 2px 12px rgba(0,0,0,0.08);
        animation: hien-modal 0.3s cubic-bezier(0.34,1.56,0.64,1);
        border: 1px solid rgba(255,255,255,0.8);
        }

        @@keyframes hien-modal {
        from {
        opacity: 0;
        transform: scale(0.9) translateY(-20px);
        }

        to {
        opacity: 1;
        transform: none;
        }
        }

        .tieu-de-modal {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        }

        .tieu-de-modal h3 {
