@page
@model QuanLyNhaTro.Pages.Admin.DichVuThongBaoModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ Thống Quản Lý – Dịch Vụ Thông Báo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/ChuTro.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/Admin/DichVuThongBao.css" />
    <!-- Javascript -->
    <script src="/js/ChuTro/ChuTro-ThongBao.js"></script>
    <script src="/js/ChuTro/ChuTro-core.js"></script>
    <script src="/js/ChuTro/ChuTro-quanLy.js"></script>
    <script src="/js/ChuTro/ChuTro-NguoiThue.js"></script>
</head>
<body>

    <!-- =============================================
 SIDEBAR
============================================= -->
    <nav id="thanh-sidebar">

        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo"><i class="fas fa-crown"></i></div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <div class="nhan-nhom-menu">Tổng quan</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/ChuTro'">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>

        <div class="nhan-nhom-menu">Vận hành</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyPhong'">
            <i class="fas fa-building"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyHopDong'">
            <i class="fas fa-file-contract"></i><span>Hợp đồng</span>
            <span class="huy-hieu vang">2</span>
        </div>

        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/Taikhoanquanly'">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'" ">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CauHinhGiaThue' ">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </div>
        <div class="muc-menu dang-chon" onclick="window.location.href='/Admin/DichVuThongBao'">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </div>
        <div class="nhan-nhom-menu">Hỗ trợ</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/SuCoBaoTri'">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span id="huy-hieu-sua-chua" class="huy-hieu">3</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/ThongKe'">
            <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CaiDatHT'">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro">C</div>
            <div class="ten-chu">
                <strong>Chủ Trọ ABC</strong>
                <span>Chủ sở hữu</span>
            </div>
        </div>
    </nav>

    <!-- =============================================
 KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Dịch Vụ Thông Báo</div>
                    <div class="duong-dan-header">Trang chủ / Quản trị / Dịch vụ thông báo</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê, HĐ..." />
                </div>
                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">7</span>
                </button>
                <div class="header-divider"></div>
                <span class="the-chu-tro"><i class="fas fa-crown" style="margin-right:4px;font-size:8px;"></i>CHỦ TRỌ</span>

                <div class="khoi-admin-header" id="adminHeaderWrap">
                    <button onclick="toggleAdminMenu()" id="adminHeaderBtn"
                            style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:5px 10px;border-radius:var(--radius-full);border:none;background:none;font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-chu-de-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien-header">C</div>
                        <div>
                            <div class="ten-admin-header" id="header-ten-chu">Nguyễn Văn Chủ</div>
                            <div class="vai-tro-header">Chủ sở hữu</div>
                        </div>
                        <i class="fas fa-chevron-down" id="adminChevron"
                           style="font-size:9px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>
                    </button>

                    <div class="admin-dropdown" id="adminDropdown">
                        <div class="add-header">
                            <div class="add-header-avatar" id="dd-avatar">C</div>
                            <div>
                                <div class="add-header-name" id="dd-ten">Nguyễn Văn Chủ</div>
                                <div class="add-header-email" id="dd-email">chusonguyen@nhatrobanum.vn</div>
                                <span class="add-header-badge">
                                    <i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ
                                </span>
                            </div>
                        </div>
                        <div class="add-body">
                            <button class="add-item" onclick="moDoiMatKhau()">
                                <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="add-item-label">Đổi mật khẩu</div>
                                    <div class="add-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>
                            <div class="add-divider"></div>
                            <button class="add-item danger" onclick="xacNhanDangXuat()">
                                <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="add-item-label">Đăng xuất</div>
                                    <div class="add-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- =============================================
     NỘI DUNG DASHBOARD
    ============================================= -->
        <main id="noi-dung-chinh">

            <!-- PAGE HERO BANNER -->
            <div class="page-hero">
                <div class="page-hero-left">
                    <div class="page-hero-icon"><i class="fas fa-paper-plane"></i></div>
                    <h1>Dịch vụ thông báo</h1>
                    <p>
                        Quản lý thông báo thủ công, tự động hóa cảnh báo hệ thống và<br />
                        theo dõi toàn bộ lịch sử gửi thông báo đến người thuê.
                    </p>
                </div>
                <div class="page-hero-actions">
                    <button class="hero-btn-primary" onclick="lamMoiBieuDo()">
                        <i class="fas fa-sync-alt"></i> Làm mới
                    </button>
                    <button class="hero-btn-outline" onclick="xuatLichSuThongBao()">
                        <i class="fas fa-file-export"></i> Xuất báo cáo
                    </button>
                </div>
            </div>

            <!-- STATS ROW -->
            <div class="hang-stats-tb">
                <div class="stat-tb-card c-blue">
                    <div class="stat-tb-icon"><i class="fas fa-paper-plane"></i></div>
                    <div>
                        <div class="stat-tb-num" id="stat-tong-gui">—</div>
                        <div class="stat-tb-lbl">Tổng đã gửi (tháng này)</div>
                    </div>
                </div>
                <div class="stat-tb-card c-green">
                    <div class="stat-tb-icon"><i class="fas fa-check-circle"></i></div>
                    <div>
                        <div class="stat-tb-num" id="stat-thanh-cong">—</div>
                        <div class="stat-tb-lbl">Gửi thành công</div>
                    </div>
                </div>
                <div class="stat-tb-card c-amber">
                    <div class="stat-tb-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <div class="stat-tb-num" id="stat-hen-gio">—</div>
                        <div class="stat-tb-lbl">Hẹn giờ chờ gửi</div>
                    </div>
                </div>
                <div class="stat-tb-card c-red">
                    <div class="stat-tb-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    <div>
                        <div class="stat-tb-num" id="stat-that-bai">—</div>
                        <div class="stat-tb-lbl">Gửi thất bại</div>
                    </div>
                </div>
            </div>

            <!-- GRID CHÍNH: Form gửi + Panel tự động -->
            <div class="grid-main">

                <!-- FORM GỬI THÔNG BÁO (kế thừa ID từ ChuTro-ThongBao.js) -->
                <div class="card-gui">
                    <div class="card-gui-hd">
                        <div class="card-gui-hd-icon"><i class="fas fa-edit"></i></div>
                        <div>
                            <h3>Soạn &amp; gửi thông báo</h3>
                            <p>Gửi ngay hoặc hẹn giờ đến người thuê</p>
                        </div>
                    </div>
                    <div class="card-gui-body">

                        <!-- NỘI DUNG -->
                        <div class="form-section-lbl">
                            <i class="fas fa-heading"></i> Nội dung thông báo
                        </div>

                        <div class="field f-span2" style="margin-bottom:14px;">
                            <label class="f-lbl">Tiêu đề <span class="req">*</span></label>
                            <input class="inp" type="text" id="tb-tieu-de"
                                   placeholder="VD: Thông báo lịch cắt điện tháng 6..." maxlength="200" />
                            <div class="f-note">Tối đa 200 ký tự</div>
                        </div>

                        <div class="field f-span2" style="margin-bottom:18px;">
                            <label class="f-lbl">Nội dung <span class="req">*</span></label>
                            <textarea class="inp" id="tb-noi-dung" rows="5"
                                      placeholder="Nhập nội dung thông báo chi tiết..." maxlength="500"></textarea>
                            <div class="f-note">Tối đa 500 ký tự</div>
                        </div>

                        <div class="mdiv"></div>

                        <!-- NGƯỜI NHẬN -->
                        <div class="form-section-lbl">
                            <i class="fas fa-users"></i> Người nhận
                        </div>

                        <div class="fg2">
                            <div class="field">
                                <label class="f-lbl">Loại người nhận <span class="req">*</span></label>
                                <select class="inp" id="tb-loai-nguoi-nhan"
                                        onchange="tbChuyenLoaiNguoiNhan(this.value)">
                                    <option value="all">Tất cả người thuê</option>
                                    <option value="quan-ly">Các quản lý</option>
                                    <option value="phong">Theo phòng</option>
                                    <option value="nguoi">Theo người thuê cụ thể</option>
                                </select>
                            </div>

                            <!-- Chọn phòng (ẩn/hiện theo JS) -->
                            <div class="field" id="tb-chon-phong" style="display:none;">
                                <label class="f-lbl">Chọn phòng <span class="req">*</span></label>
                                <select class="inp" id="tb-phong-id">
                                    <option value="">-- Đang tải danh sách phòng... --</option>
                                </select>
                            </div>

                            <!-- Chọn người thuê (ẩn/hiện theo JS) -->
                            <div class="field" id="tb-chon-nguoi" style="display:none;">
                                <label class="f-lbl">Chọn người thuê <span class="req">*</span></label>
                                <select class="inp" id="tb-user-id">
                                    <option value="">-- Đang tải danh sách người thuê... --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Preview người nhận (hiện/ẩn theo JS) -->
                        <div id="tb-preview-nguoi-nhan">
                            <i class="fas fa-info-circle" style="margin-right:6px;color:#0891b2;"></i>
                            <span id="tb-preview-text">Sẽ gửi đến tất cả người thuê</span>
                        </div>

                        <div class="mdiv"></div>

                        <!-- CÀI ĐẶT -->
                        <div class="form-section-lbl">
                            <i class="fas fa-cog"></i> Cài đặt gửi
                        </div>

                        <div class="fg2" style="margin-bottom:12px;">
                            <div class="field">
                                <label class="f-lbl">Mức độ thông báo <span class="req">*</span></label>
                                <select class="inp" id="tb-muc-do" onchange="tbCapNhatMucDo(this.value)">
                                    <option value="thong-tin">🔵 Bình thường</option>
                                    <option value="canh-bao">🟡 Quan trọng</option>
                                    <option value="khan-cap">🔴 Khẩn cấp</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="f-lbl">Ngày gửi <span class="req">*</span></label>
                                <input class="inp" type="datetime-local" id="tb-ngay-gui" />
                            </div>
                        </div>

                        <!-- Badge preview mức độ -->
                        <div style="margin-bottom:20px;">
                            <span id="tb-badge-muc-do" class="muc-do-badge thong-tin">
                                🔵 Thông tin thông thường
                            </span>
                        </div>

                        <button class="btn-gui-tb" id="tb-btn-gui" onclick="guiThongBao()">
                            <i class="fas fa-paper-plane"></i> Gửi thông báo
                        </button>

                    </div>
                </div>

                <!-- CỘT PHẢI -->
                <div class="right-col">

                    <!-- THÔNG BÁO TỰ ĐỘNG: Hóa đơn & Nhắc nhở -->
                    <div class="card-tu-dong">
                        <div class="card-tu-dong-hd">
                            <div class="hd-icon" style="background:#eff6ff;color:#1d4ed8;">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div>
                                <h4>Thông báo tự động</h4>
                                <p>Hóa đơn, nhắc tiền thuê, hết hạn HĐ</p>
                            </div>
                        </div>
                        <div class="tu-dong-body">
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#eff6ff;color:#1d4ed8;">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Tạo hóa đơn hàng tháng</div>
                                    <div class="toggle-sub">Gửi tự động vào ngày 1 hàng tháng</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-hoa-don" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#fef3c7;color:#d97706;">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Nhắc tiền thuê sắp đến hạn</div>
                                    <div class="toggle-sub">Trước 3 ngày đến hạn thanh toán</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-nhac-tien" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#fee2e2;color:#dc2626;">
                                    <i class="fas fa-exclamation-circle"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Cảnh báo quá hạn thanh toán</div>
                                    <div class="toggle-sub">Sau 5 ngày quá hạn chưa đóng</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-qua-han" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#f5f3ff;color:#7c3aed;">
                                    <i class="fas fa-file-contract"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Nhắc hết hạn hợp đồng</div>
                                    <div class="toggle-sub">Trước 30 ngày hết hạn HĐ</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-het-han-hd" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- CẢNH BÁO HỆ THỐNG -->
                    <div class="card-tu-dong">
                        <div class="card-tu-dong-hd">
                            <div class="hd-icon" style="background:#fff8ee;color:#d97706;">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div>
                                <h4>Cảnh báo hệ thống</h4>
                                <p>Sự cố, sửa chữa, an ninh nhà trọ</p>
                            </div>
                        </div>
                        <div class="tu-dong-body">
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#fff8ee;color:#d97706;">
                                    <i class="fas fa-tools"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Thông báo sự cố mới</div>
                                    <div class="toggle-sub">Khi người thuê báo sự cố cần xử lý</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-su-co" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#ecfdf5;color:#059669;">
                                    <i class="fas fa-check-double"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Xác nhận phê duyệt sửa chữa</div>
                                    <div class="toggle-sub">Gửi kết quả phê duyệt cho quản lý</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-phe-duyet" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="toggle-row">
                                <div class="toggle-icon" style="background:#f0f2f8;color:#6b7a99;">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="toggle-txt">
                                    <div class="toggle-name">Chào mừng người thuê mới</div>
                                    <div class="toggle-sub">Gửi hướng dẫn khi thêm người thuê</div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="auto-chao-mung" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- NÚT LƯU CÀI ĐẶT TỰ ĐỘNG -->
                    <button onclick="luuCaiDatTuDong()"
                            style="width:100%;background:linear-gradient(135deg,#0f52ba,#0891b2);color:#fff;border:none;border-radius:var(--radius-md);padding:12px;font-size:13px;font-weight:800;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 14px rgba(8,145,178,0.32);transition:all 0.2s;"
                            onmouseover="this.style.transform='translateY(-2px)'"
                            onmouseout="this.style.transform='none'">
                        <i class="fas fa-save"></i> Lưu cài đặt thông báo tự động
                    </button>

                </div>
            </div>

            <!-- LỊCH SỬ THÔNG BÁO -->
            <div class="card-lich-su">

                <div class="lich-su-hd">
                    <h3><i class="fas fa-history"></i> Lịch sử thông báo</h3>
                    <button class="btn-xem-them-ls" onclick="taiThemLichSu()">
                        <i class="fas fa-redo"></i> Tải lại
                    </button>
                </div>

                <!-- Toolbar filter -->
                <div class="lich-su-toolbar">
                    <div class="ls-search-wrap">
                        <i class="fas fa-search"></i>
                        <input type="text" id="ls-search-input"
                               placeholder="Tìm theo tiêu đề, người nhận..."
                               oninput="locLichSuThongBao(this.value)" />
                    </div>
                    <div class="ls-filter-chips">
                        <button class="ls-chip active" id="ls-chip-all"
                                onclick="setLsChip('all', this)">
                            Tất cả
                        </button>
                        <button class="ls-chip" id="ls-chip-da-gui"
                                onclick="setLsChip('da-gui', this)">
                            ✓ Đã gửi
                        </button>
                        <button class="ls-chip" id="ls-chip-hen-gio"
                                onclick="setLsChip('hen-gio', this)">
                            ⏰ Hẹn giờ
                        </button>
                        <button class="ls-chip" id="ls-chip-that-bai"
                                onclick="setLsChip('that-bai', this)">
                            ✕ Thất bại
                        </button>
                    </div>
                </div>

                <!-- Bảng dữ liệu -->
                <div class="lich-su-table-wrap">
                    <table class="lich-su-table">
                        <thead>
                            <tr>
                                <th>Tiêu đề / Người nhận</th>
                                <th>Mức độ</th>
                                <th>Loại</th>
                                <th>Ngày gửi</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="lich-su-tb-body">
                            <!-- JS inject dữ liệu từ API vào đây -->
                            <tr id="ls-loading-row">
                                <td colspan="6" style="text-align:center;padding:36px;color:var(--mau-chu-phu);">
                                    <i class="fas fa-spinner fa-spin" style="font-size:20px;display:block;margin-bottom:8px;color:#0891b2;"></i>
                                    Đang tải lịch sử thông báo...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="lich-su-ft">
                    <div class="ls-ft-count">
                        Hiển thị <strong id="ls-result-count">—</strong> thông báo
                    </div>
                    <button class="btn-xem-them-ls" onclick="taiThemLichSu()">
                        <i class="fas fa-plus"></i> Xem thêm
                    </button>
                </div>

            </div><!-- /card-lich-su -->

        </main>
    </div>

    <!-- =============================================
 TOAST CONTAINER
============================================= -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- =============================================
 MODAL: CHI TIẾT THÔNG BÁO (xem lại)
============================================= -->
    <div class="lop-phu-modal" id="modal-chi-tiet-thong-bao"
         onclick="dongModalNhapNgoai(event, 'modal-chi-tiet-thong-bao')">
        <div class="hop-modal" style="width:480px;">
            <div class="tieu-de-modal">
                <h3>
                    <span style="width:32px;height:32px;background:linear-gradient(135deg,#0f52ba,#0891b2);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:14px;">
                        <i class="fas fa-bell"></i>
                    </span>
                    Chi tiết thông báo
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet-thong-bao')">✕</button>
            </div>
            <div id="noi-dung-chi-tiet-thong-bao" style="font-size:13px;color:var(--mau-chu);line-height:1.7;">
                <!-- JS inject -->
            </div>
            <div class="nhom-nut-duoi-modal">
                <button class="nut-huy-modal" onclick="dongModal('modal-chi-tiet-thong-bao')">Đóng</button>
            </div>
        </div>
    </div>

    <!-- =============================================
 SCRIPTS
============================================= -->
    <script>
        window.hienThiThongBao = function(noiDung, loai = 'success') {
        // Gọi ID bằng tiếng Việt
        const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
        if (!khuVucChua) return;

        // Chuyển đổi tham số type sang class tiếng Việt tương ứng
        let classMauSac = '';
        switch(loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
        case 'error': classMauSac = 'thong-bao-loi'; break;
        default: classMauSac = 'thong-bao-thanh-cong';
        }

        // Tạo phần tử DOM
        const theThongBao = document.createElement('div');
        theThongBao.className = `thong-bao-muc ${classMauSac}`;
    
        // Gắn HTML nội dung và nút X
        theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
        `;

        // Đẩy vào trang
        khuVucChua.appendChild(theThongBao);

        // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
        setTimeout(() => {
        if (theThongBao.parentNode) {
        theThongBao.remove();
        }
        }, 3000);
        }
        // ── Ngày giờ header ──────────────────────────────────────────────
        (function() {
        const d = new Date();
        const days = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        // Có thể gán vào breadcrumb nếu cần
        })();

        // ── Đặt giá trị mặc định datetime-local = bây giờ ───────────────
        (function () {
        const el = document.getElementById('tb-ngay-gui');
        if (el) {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        el.value = now.toISOString().slice(0, 16);
        }
        })();

        // ── Admin dropdown toggle (kế thừa từ ChuTro) ───────────────────
        function toggleAdminMenu() {
        const dd = document.getElementById('adminDropdown');
        const ch = document.getElementById('adminChevron');
        if (!dd) return;
        dd.classList.toggle('show');
        if (ch) ch.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
        }
        document.addEventListener('click', function(e) {
        const wrap = document.getElementById('adminHeaderWrap');
        const dd = document.getElementById('adminDropdown');
        if (wrap && dd && !wrap.contains(e.target)) {
        dd.classList.remove('show');
        const ch = document.getElementById('adminChevron');
        if (ch) ch.style.transform = '';
        }
        });

        // ── Sidebar toggle ───────────────────────────────────────────────
        function dongMoSidebar() {
        const sb = document.getElementById('thanh-sidebar');
        if (!sb) return;
        if (window.innerWidth <= 768) {
        sb.classList.toggle('mo');
        } else {
        sb.classList.toggle('an');
        }
        }

        // ── Modal helpers (giữ nguyên ID/tên hàm cho JS backend) ────────
        function moModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('hien');
        }
        function dongModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('hien');
        }
        function dongModalNhapNgoai(e, id) {
        if (e.target === document.getElementById(id)) dongModal(id);
        }

        // ── Bảng mức độ badge (giữ nguyên ID: tb-badge-muc-do) ──────────
        // Hàm tbCapNhatMucDo được gọi bởi ChuTro-ThongBao.js;
        // nếu file JS đó không tự cập nhật class, dùng fallback sau:
        if (typeof tbCapNhatMucDo === 'undefined') {
        window.tbCapNhatMucDo = function(val) {
        const badge = document.getElementById('tb-badge-muc-do');
        if (!badge) return;
        badge.className = 'muc-do-badge';
        if (val === 'canh-bao') {
        badge.classList.add('canh-bao');
        badge.textContent = '🟡 Quan trọng';
        } else if (val === 'khan-cap') {
        badge.classList.add('khan-cap');
        badge.textContent = '🔴 Khẩn cấp';
        } else {
        badge.classList.add('thong-tin');
        badge.textContent = '🔵 Thông tin thông thường';
        }
        };
        }

        // ── Hiện/ẩn selector phòng / người thuê ─────────────────────────
        // Hàm tbChuyenLoaiNguoiNhan được gọi bởi ChuTro-ThongBao.js;
        // fallback:
        if (typeof tbChuyenLoaiNguoiNhan === 'undefined') {
        window.tbChuyenLoaiNguoiNhan = function(val) {
        document.getElementById('tb-chon-phong').style.display = val === 'phong' ? '' : 'none';
        document.getElementById('tb-chon-nguoi').style.display = val === 'nguoi' ? '' : 'none';
        const prev = document.getElementById('tb-preview-nguoi-nhan');
        const txt = document.getElementById('tb-preview-text');
        if (prev && txt) {
        prev.style.display = '';
        txt.textContent = val === 'phong' ? 'Sẽ gửi đến tất cả người thuê trong phòng đã chọn'
        : val === 'nguoi' ? 'Sẽ gửi đến người thuê cụ thể'
        : 'Sẽ gửi đến tất cả người thuê';
        }
        };
        }

        // ── Lọc lịch sử thông báo ────────────────────────────────────────
        let _lsCurrentChip = 'all';
        function setLsChip(val, btn) {
        _lsCurrentChip = val;
        document.querySelectorAll('.ls-chip').forEach(c => c.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderLichSu();
        }
        function locLichSuThongBao(q) { renderLichSu(q); }

        // ── Render lịch sử (mock cho đến khi API sẵn sàng) ──────────────
        const MOCK_LICH_SU = [
        { id:1, tieu_de:'Thông báo cắt điện tầng 2', nguoi_nhan:'Tất cả người thuê', muc_do:'canh-bao', loai:'Thủ công', ngay_gui:'2025-05-10 09:30', trang_thai:'da-gui' },
        { id:2, tieu_de:'Nhắc tiền thuê tháng 5', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Tự động', ngay_gui:'2025-05-01 07:00', trang_thai:'da-gui' },
        { id:3, tieu_de:'Hóa đơn tháng 5', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Tự động', ngay_gui:'2025-05-01 06:00', trang_thai:'da-gui' },
        { id:4, tieu_de:'Sửa chữa ống nước phòng 204', nguoi_nhan:'Phòng 204', muc_do:'khan-cap', loai:'Thủ công', ngay_gui:'2025-04-28 14:00', trang_thai:'da-gui' },
        { id:5, tieu_de:'Nhắc hết hạn HĐ phòng 110', nguoi_nhan:'Phòng 110', muc_do:'canh-bao', loai:'Tự động', ngay_gui:'2025-06-01 08:00', trang_thai:'hen-gio' },
        { id:6, tieu_de:'Thông báo nội quy mới', nguoi_nhan:'Tất cả người thuê', muc_do:'thong-tin', loai:'Thủ công', ngay_gui:'2025-04-20 10:00', trang_thai:'that-bai' },
        ];

        function renderLichSu(q) {
        const body = document.getElementById('lich-su-tb-body');
        const countEl = document.getElementById('ls-result-count');
        if (!body) return;

        const query = (q || document.getElementById('ls-search-input')?.value || '').toLowerCase();
        let data = MOCK_LICH_SU.filter(r => {
        const matchQ = !query || r.tieu_de.toLowerCase().includes(query) || r.nguoi_nhan.toLowerCase().includes(query);
        const matchChip = _lsCurrentChip === 'all' || r.trang_thai === _lsCurrentChip;
        return matchQ && matchChip;
        });

        if (countEl) countEl.textContent = data.length;

        if (data.length === 0) {
        body.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px;color:var(--mau-chu-phu);">
        <i class="fas fa-inbox" style="font-size:24px;display:block;margin-bottom:8px;opacity:0.4;"></i>
        Không tìm thấy thông báo nào
        </td></tr>`;
        return;
        }

        const muDoBadge = { 'thong-tin':'thong-tin', 'canh-bao':'canh-bao', 'khan-cap':'khan-cap' };
        const muDoTxt = { 'thong-tin':'🔵 Bình thường', 'canh-bao':'🟡 Quan trọng', 'khan-cap':'🔴 Khẩn cấp' };
        const tsTxt = { 'da-gui':'✓ Đã gửi', 'hen-gio':'⏰ Hẹn giờ', 'that-bai':'✕ Thất bại' };

        body.innerHTML = data.map(r => `
        <tr>
        <td>
        <div class="tb-title-cell">${r.tieu_de}</div>
        <div class="tb-nguoi-cell"><i class="fas fa-user" style="margin-right:4px;font-size:10px;"></i>${r.nguoi_nhan}</div>
        </td>
        <td><span class="badge-muc-do ${muDoBadge[r.muc_do]}">${muDoTxt[r.muc_do]}</span></td>
        <td style="font-size:12px;color:var(--mau-chu-phu);font-weight:600;">${r.loai}</td>
        <td style="font-size:12px;color:var(--mau-chu-phu);white-space:nowrap;">${r.ngay_gui}</td>
        <td><span class="badge-trang-thai ${r.trang_thai}">${tsTxt[r.trang_thai]}</span></td>
        <td>
        <button class="btn-icon-sm" title="Xem chi tiết" onclick="xemChiTietThongBao(${r.id})">
        <i class="fas fa-eye"></i>
        </button>
        ${r.trang_thai === 'hen-gio' ? `<button class="btn-icon-sm" title="Hủy hẹn giờ" onclick="huyHenGio(${r.id})"><i class="fas fa-times-circle" style="color:#d97706;"></i></button>` : ''}
        ${r.trang_thai === 'that-bai' ? `<button class="btn-icon-sm" title="Gửi lại" onclick="guiLai(${r.id})"><i class="fas fa-redo" style="color:#0891b2;"></i></button>` : ''}
        </td>
        </tr>`).join('');
        }

        // ── Cập nhật stats (mock) ────────────────────────────────────────
        function capNhatStats() {
        const total = MOCK_LICH_SU.length;
        const success = MOCK_LICH_SU.filter(r => r.trang_thai === 'da-gui').length;
        const scheduled = MOCK_LICH_SU.filter(r => r.trang_thai === 'hen-gio').length;
        const failed = MOCK_LICH_SU.filter(r => r.trang_thai === 'that-bai').length;
        document.getElementById('stat-tong-gui').textContent = total;
        document.getElementById('stat-thanh-cong').textContent = success;
        document.getElementById('stat-hen-gio').textContent = scheduled;
        document.getElementById('stat-that-bai').textContent = failed;
        }

        // ── Các hàm action (mock – backend sẽ override qua JS files) ────
        function xemChiTietThongBao(id) {
        const r = MOCK_LICH_SU.find(x => x.id === id);
        if (!r) return;
        const muDoTxt = { 'thong-tin':'🔵 Bình thường', 'canh-bao':'🟡 Quan trọng', 'khan-cap':'🔴 Khẩn cấp' };
        const tsTxt = { 'da-gui':'✓ Đã gửi', 'hen-gio':'⏰ Hẹn giờ', 'that-bai':'✕ Thất bại' };
        document.getElementById('noi-dung-chi-tiet-thong-bao').innerHTML = `
        <div style="background:var(--mau-nen);border-radius:12px;padding:16px;margin-bottom:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Tiêu đề</div><div style="font-weight:800;margin-top:3px;">${r.tieu_de}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Người nhận</div><div style="font-weight:800;margin-top:3px;">${r.nguoi_nhan}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Mức độ</div><div style="font-weight:800;margin-top:3px;">${muDoTxt[r.muc_do]}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Trạng thái</div><div style="font-weight:800;margin-top:3px;">${tsTxt[r.trang_thai]}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Loại</div><div style="font-weight:800;margin-top:3px;">${r.loai}</div></div>
        <div><div style="font-size:11px;color:var(--mau-chu-phu);font-weight:600;">Ngày gửi</div><div style="font-weight:800;margin-top:3px;">${r.ngay_gui}</div></div>
        </div>`;
        moModal('modal-chi-tiet-thong-bao');
        }

        function huyHenGio(id) {
        const idx = MOCK_LICH_SU.findIndex(x => x.id === id);
        if (idx >= 0) {
        MOCK_LICH_SU.splice(idx, 1);
        renderLichSu();
        capNhatStats();
        hienToast('success', 'Đã hủy', 'Đã hủy thông báo hẹn giờ thành công.');
        }
        }

        function guiLai(id) {
        hienToast('info', 'Đang gửi lại', 'Hệ thống đang thử gửi lại thông báo...');
        }

        function lamMoiBieuDo() {
        renderLichSu();
        capNhatStats();
        hienToast('success', 'Đã làm mới', 'Dữ liệu đã được cập nhật.');
        }

        function taiThemLichSu() { renderLichSu(); }

        function xuatLichSuThongBao() {
        hienToast('info', 'Đang xuất', 'Đang tạo file báo cáo lịch sử thông báo...');
        }

        function luuCaiDatTuDong() {
        hienToast('success', 'Đã lưu', 'Cài đặt thông báo tự động đã được cập nhật.');
        }

        // ── guiThongBao fallback (nếu ChuTro-ThongBao.js chưa tải) ──────
        if (typeof guiThongBao === 'undefined') {
        window.guiThongBao = function() {
        const tieu_de = document.getElementById('tb-tieu-de')?.value?.trim();
        const noi_dung = document.getElementById('tb-noi-dung')?.value?.trim();
        const ngay_gui = document.getElementById('tb-ngay-gui')?.value;
        if (!tieu_de) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng nhập tiêu đề thông báo.'); return; }
        if (!noi_dung) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng nhập nội dung thông báo.'); return; }
        if (!ngay_gui) { hienToast('warn', 'Thiếu thông tin', 'Vui lòng chọn ngày gửi.'); return; }
        hienToast('info', 'Đang xử lý', 'Đang gửi thông báo...');
        };
        }

        // ── Toast helper ─────────────────────────────────────────────────
        function hienToast(type, title, msg, duration) {
        if (typeof showToast === 'function') { showToast(type, title, msg, duration); return; }
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const dur = duration || 4000;
        const icons = { success:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#639922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>', fail:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>', warn:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF9F27" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>', info:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#378ADD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' };
        const toast = document.createElement('div');
        toast.className = `toast toast-${type === 'error' ? 'fail' : type}`;
        toast.innerHTML = `<div class="toast-icon-wrap">${icons[type] || icons.info}</div><div class="toast-body"><div class="toast-title">${title}</div><div class="toast-msg">${msg}</div></div><button class="toast-close" onclick="this.closest('.toast').remove()">✕</button><div class="toast-progress" style="animation-duration:${dur}ms;"></div>`;
        container.appendChild(toast);
        requestAnimationFrame(() => { requestAnimationFrame(() => toast.classList.add('show')); });
        setTimeout(() => { toast.classList.add('hide'); setTimeout(() => toast.remove(), 300); }, dur);
        }

        // ── Đăng xuất placeholder ────────────────────────────────────────
        if (typeof xacNhanDangXuat === 'undefined') {
        window.xacNhanDangXuat = function() {
        if (confirm('Bạn có chắc muốn đăng xuất?')) window.location.href = '/logout';
        };
        }
        if (typeof moDoiMatKhau === 'undefined') {
        window.moDoiMatKhau = function() { hienToast('info','Đổi mật khẩu','Chức năng đang phát triển.'); };
        }

        // ── Init ─────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function() {
        capNhatStats();
        renderLichSu();
        });
    </script>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
