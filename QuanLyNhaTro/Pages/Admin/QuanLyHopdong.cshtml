@page
@model QuanLyNhaTro.Pages.Admin.QuanLyHopdongcshtmlModel
@{
    ViewData["Title"] = "Quản lý Hợp đồng";
    Layout = null; // Thay bằng layout chính của bạn
}
<script src="~/js/ChuTro/ChuTro-HopDong.js"></script>
<!-- ==================== CSS BỔ SUNG ==================== -->
<style>
    /* ===== VARIABLES – khớp dashboard gốc ===== */
    :root {
        --bg-page:       #f4f6f9;
        --bg-card:       #ffffff;
        --border:        #e8ecf0;
        --shadow-sm:     0 2px 8px rgba(0,0,0,.06);
        --shadow-md:     0 4px 20px rgba(0,0,0,.10);
        --radius-lg:     14px;
        --radius-md:     10px;
        --radius-sm:     7px;

        --primary:       #f5a623;   /* cam vàng – màu chủ đạo dashboard */
        --primary-soft:  #fff8ec;
        --blue:          #4a90e2;
        --blue-soft:     #eef4fd;
        --green:         #27ae60;
        --green-soft:    #eafaf1;
        --red:           #e74c3c;
        --red-soft:      #fdf0ef;
        --purple:        #8e44ad;
        --purple-soft:   #f5eefb;
        --gray:          #95a5a6;
        --gray-soft:     #f0f2f5;

        --text-dark:     #2c3e50;
        --text-mid:      #5d6d7e;
        --text-light:    #95a5a6;

        --font:          'Segoe UI', 'SVN-Gilroy', sans-serif;
    }

    /* ===== LAYOUT ===== */
    .hd-page {
        background: var(--bg-page);
        min-height: 100vh;
        padding: 24px 28px 48px;
        font-family: var(--font);
        color: var(--text-dark);
    }

    /* ===== HEADER ===== */
    .hd-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }
    .hd-header-left h1 {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 2px;
    }
    .hd-breadcrumb {
        font-size: 12px;
        color: var(--text-light);
    }
    .hd-breadcrumb span { color: var(--primary); font-weight: 600; }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity .2s, transform .15s;
        text-decoration: none;
    }
    .btn-add:hover { opacity: .88; transform: translateY(-1px); }

    /* ===== STAT CARDS ===== */
    .hd-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    @@media(max - width:900px){ .hd-stats { grid-template-columns: repeat(2,1fr); } }
    @@media(max - width:500px){ .hd-stats { grid-template-columns: 1fr; } }

    .stat-card {
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        padding: 18px 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid var(--border);
        transition: box-shadow .2s;
    }
    .stat-card:hover { box-shadow: var(--shadow-md); }
    .stat-icon {
        width: 46px; height: 46px;
        border-radius: var(--radius-md);
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; flex-shrink: 0;
    }
    .stat-icon.blue   { background: var(--blue-soft);   color: var(--blue);   }
    .stat-icon.green  { background: var(--green-soft);  color: var(--green);  }
    .stat-icon.orange { background: var(--primary-soft);color: var(--primary);}
    .stat-icon.red    { background: var(--red-soft);    color: var(--red);    }
    .stat-info p { margin: 0; font-size: 12px; color: var(--text-light); }
    .stat-info h3 { margin: 2px 0 0; font-size: 22px; font-weight: 700; }

    /* ===== FILTER BAR ===== */
    .hd-filter-bar {
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }
    .filter-search {
        flex: 1; min-width: 200px;
        position: relative;
    }
    .filter-search input {
        width: 100%;
        padding: 9px 12px 9px 38px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        outline: none;
        background: var(--gray-soft);
        color: var(--text-dark);
        transition: border-color .2s;
        box-sizing: border-box;
    }
    .filter-search input:focus { border-color: var(--primary); background: #fff; }
    .filter-search .search-icon {
        position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
        color: var(--text-light); font-size: 15px;
    }
    .filter-select {
        padding: 9px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        background: var(--gray-soft);
        color: var(--text-dark);
        outline: none;
        cursor: pointer;
        transition: border-color .2s;
    }
    .filter-select:focus { border-color: var(--primary); }
    .filter-divider { width: 1px; height: 32px; background: var(--border); }
    .filter-info { font-size: 13px; color: var(--text-light); margin-left: auto; }
    .filter-info strong { color: var(--text-dark); }

    /* ===== TABLE CARD ===== */
    .hd-table-card {
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }
    .table-header-bar {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
    }
    .table-header-bar h2 { font-size: 15px; font-weight: 700; margin: 0; }
    .table-header-bar .view-toggle { display: flex; gap: 6px; }
    .toggle-btn {
        padding: 6px 10px; border: 1.5px solid var(--border); background: none;
        border-radius: var(--radius-sm); cursor: pointer; color: var(--text-light);
        font-size: 14px; transition: all .15s;
    }
    .toggle-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }

    /* TABLE */
    .hd-table-wrap { overflow-x: auto; }
    .hd-table {
        width: 100%; border-collapse: collapse;
        font-size: 13.5px;
    }
    .hd-table thead tr {
        background: var(--gray-soft);
        border-bottom: 1.5px solid var(--border);
    }
    .hd-table thead th {
        padding: 11px 16px; text-align: left;
        font-size: 11.5px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: var(--text-mid); white-space: nowrap;
    }
    .hd-table thead th.sortable { cursor: pointer; user-select: none; }
    .hd-table thead th.sortable:hover { color: var(--primary); }
    .hd-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }
    .hd-table tbody tr:last-child { border-bottom: none; }
    .hd-table tbody tr:hover { background: var(--primary-soft); }
    .hd-table td { padding: 13px 16px; vertical-align: middle; }

    .contract-id {
        font-weight: 700; color: var(--blue);
        cursor: pointer; text-decoration: none;
    }
    .contract-id:hover { text-decoration: underline; }

    .tenant-info { display: flex; align-items: center; gap: 10px; }
    .avatar {
        width: 34px; height: 34px; border-radius: 50%;
        background: var(--primary); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 700; flex-shrink: 0;
    }
    .tenant-name { font-weight: 600; font-size: 13.5px; }
    .tenant-phone { font-size: 11.5px; color: var(--text-light); margin-top: 1px; }

    .room-badge {
        background: var(--blue-soft); color: var(--blue);
        padding: 3px 10px; border-radius: 20px;
        font-size: 12px; font-weight: 700; display: inline-block;
    }

    .date-cell { font-size: 13px; color: var(--text-mid); white-space: nowrap; }
    .date-cell small { display: block; font-size: 11px; color: var(--text-light); }

    /* STATUS BADGES */
    .status-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 11px; border-radius: 20px;
        font-size: 11.5px; font-weight: 700; white-space: nowrap;
    }
    .status-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
    .badge-active   { background: var(--green-soft); color: var(--green); }
    .badge-active::before   { background: var(--green); }
    .badge-expiring { background: #fff8e1; color: #f57c00; }
    .badge-expiring::before { background: #f57c00; }
    .badge-expired  { background: var(--red-soft);  color: var(--red);   }
    .badge-expired::before  { background: var(--red); }
    .badge-settled  { background: var(--gray-soft);  color: var(--gray);  }
    .badge-settled::before  { background: var(--gray); }

    /* ACTION BUTTONS */
    .action-btns { display: flex; gap: 6px; align-items: center; }
    .btn-icon {
        width: 32px; height: 32px; border-radius: var(--radius-sm);
        border: none; cursor: pointer; display: flex;
        align-items: center; justify-content: center;
        font-size: 14px; transition: all .15s;
    }
    .btn-view  { background: var(--blue-soft);   color: var(--blue);   }
    .btn-edit  { background: var(--primary-soft); color: var(--primary); }
    .btn-del   { background: var(--red-soft);    color: var(--red);    }
    .btn-icon:hover { transform: translateY(-1px); filter: brightness(.93); }

    /* GRID VIEW */
    .hd-grid-view {
        display: none;
        grid-template-columns: repeat(auto-fill, minmax(280px,1fr));
        gap: 16px;
        padding: 20px;
    }
    .hd-grid-view.active { display: grid; }
    .contract-card {
        border: 1.5px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px;
        cursor: pointer;
        transition: box-shadow .2s, transform .15s;
        position: relative;
    }
    .contract-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .cc-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .cc-id  { font-size: 12px; font-weight: 700; color: var(--blue); }
    .cc-tenant { font-weight: 700; font-size: 15px; margin-bottom: 3px; }
    .cc-phone  { font-size: 12px; color: var(--text-light); }
    .cc-divider { border: none; border-top: 1px solid var(--border); margin: 12px 0; }
    .cc-row { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 7px; }
    .cc-row .label { color: var(--text-light); }
    .cc-row .value { font-weight: 600; }
    .cc-actions { display: flex; gap: 8px; margin-top: 14px; }
    .cc-btn {
        flex: 1; padding: 7px 0; border: none; border-radius: var(--radius-sm);
        font-size: 12.5px; font-weight: 600; cursor: pointer; transition: opacity .15s;
    }
    .cc-btn:hover { opacity: .85; }
    .cc-btn-edit { background: var(--primary-soft); color: var(--primary); }
    .cc-btn-del  { background: var(--red-soft);     color: var(--red);     }

    /* PAGINATION */
    .hd-pagination {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 10px;
    }
    .page-info { font-size: 13px; color: var(--text-light); }
    .page-btns { display: flex; gap: 5px; }
    .page-btn {
        min-width: 34px; height: 34px; padding: 0 10px;
        border: 1.5px solid var(--border);
        background: none; border-radius: var(--radius-sm);
        font-size: 13px; cursor: pointer; color: var(--text-mid);
        transition: all .15s;
    }
    .page-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; font-weight: 700; }
    .page-btn:hover:not(.active):not(:disabled) { border-color: var(--primary); color: var(--primary); }
    .page-btn:disabled { opacity: .4; cursor: not-allowed; }

    /* ===== LOADING / EMPTY STATE ===== */
    .loading-state, .empty-state {
        text-align: center; padding: 60px 20px;
        color: var(--text-light);
    }
    .loading-state .spinner {
        width: 36px; height: 36px; border: 3px solid var(--border);
        border-top-color: var(--primary); border-radius: 50%;
        animation: spin .7s linear infinite; margin: 0 auto 14px;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; }
    .empty-state p { font-size: 14px; }

    /* ===== MODAL ===== */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.45); z-index: 1000;
        align-items: center; justify-content: center;
        padding: 20px;
        backdrop-filter: blur(2px);
    }
    .modal-overlay.open { display: flex; animation: fadeIn .2s ease; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-box {
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        width: 100%; max-width: 680px;
        max-height: 90vh; overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
        animation: slideUp .25s ease;
    }
    @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal-head {
        padding: 20px 24px 16px;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        position: sticky; top: 0; background: var(--bg-card); z-index: 1;
    }
    .modal-head h2 { font-size: 16px; font-weight: 700; margin: 0; }
    .modal-close {
        width: 32px; height: 32px; border: none; background: var(--gray-soft);
        border-radius: var(--radius-sm); cursor: pointer; font-size: 16px;
        color: var(--text-mid); display: flex; align-items: center; justify-content: center;
        transition: background .15s;
    }
    .modal-close:hover { background: var(--red-soft); color: var(--red); }

    .modal-body { padding: 22px 24px; }
    .modal-section-title {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .8px; color: var(--text-light);
        margin: 0 0 14px; padding-bottom: 8px;
        border-bottom: 1.5px solid var(--border);
    }
    .detail-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 22px;
    }
    @@media(max - width:480px){ .detail-grid { grid-template-columns: 1fr; } }
    .detail-item label {
        display: block; font-size: 11.5px; color: var(--text-light); margin-bottom: 3px;
    }
    .detail-item .val {
        font-size: 14px; font-weight: 600; color: var(--text-dark);
    }
    .detail-item .val.highlight { color: var(--primary); font-size: 16px; }

    .modal-foot {
        padding: 16px 24px;
        border-top: 1px solid var(--border);
        display: flex; gap: 10px; justify-content: flex-end;
    }
    .btn-secondary {
        padding: 9px 20px; border: 1.5px solid var(--border); background: none;
        border-radius: var(--radius-sm); cursor: pointer; font-size: 14px;
        color: var(--text-mid); font-weight: 600; transition: all .15s;
    }
    .btn-secondary:hover { border-color: var(--text-mid); color: var(--text-dark); }
    .btn-primary-gold {
        padding: 9px 20px; background: var(--primary); border: none;
        border-radius: var(--radius-sm); cursor: pointer; font-size: 14px;
        color: #fff; font-weight: 600; transition: opacity .15s;
    }
    .btn-primary-gold:hover { opacity: .87; }
    .btn-danger {
        padding: 9px 20px; background: var(--red-soft); border: none;
        border-radius: var(--radius-sm); cursor: pointer; font-size: 14px;
        color: var(--red); font-weight: 600; transition: opacity .15s;
    }
    .btn-danger:hover { background: var(--red); color: #fff; }

    /* ===== CONFIRM DIALOG ===== */
    .confirm-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.5); z-index: 1100;
        align-items: center; justify-content: center; padding: 20px;
    }
    .confirm-overlay.open { display: flex; }
    .confirm-box {
        background: var(--bg-card); border-radius: var(--radius-lg);
        padding: 30px; width: 100%; max-width: 380px; text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
    }
    .confirm-icon { font-size: 46px; margin-bottom: 14px; }
    .confirm-box h3 { margin: 0 0 8px; font-size: 17px; }
    .confirm-box p  { margin: 0 0 20px; font-size: 13.5px; color: var(--text-mid); }
    .confirm-btns   { display: flex; gap: 10px; justify-content: center; }

    /* ===== NOTIFICATION TOAST ===== */
    #toast {
        position: fixed; bottom: 28px; right: 28px; z-index: 2000;
        background: var(--text-dark); color: #fff;
        padding: 12px 20px; border-radius: var(--radius-md);
        font-size: 13.5px; font-weight: 500;
        box-shadow: var(--shadow-md);
        transform: translateY(80px); opacity: 0;
        transition: all .3s cubic-bezier(.175,.885,.32,1.275);
        max-width: 320px;
    }
    #toast.show { transform: translateY(0); opacity: 1; }
    #toast.success { background: var(--green); }
    #toast.error   { background: var(--red); }

    /* ===== RESPONSIVE ===== */
    @@media(max - width:768px){
        .hd-page { padding: 16px 14px 40px; }
        .hd-table { font-size: 12.5px; }
        .hd-table td, .hd-table th { padding: 10px 11px; }
        .filter-divider { display: none; }
        .filter-info { display: none; }
    }
</style>

<!-- ==================== HTML ==================== -->
<div class="hd-page">

    <!-- HEADER -->
    <div class="hd-header">
        <div class="hd-header-left">
            <h1>📄 Quản lý Hợp đồng</h1>
            <div class="hd-breadcrumb">Trang chủ / Vận hành / <span>Hợp đồng</span></div>
        </div>
        <button class="btn-add" onclick="openAddModal()">
            ＋ Thêm hợp đồng
        </button>
    </div>

    <!-- STAT CARDS -->
    <div class="hd-stats">
        <div class="stat-card">
            <div class="stat-icon blue">📋</div>
            <div class="stat-info">
                <p>Tổng hợp đồng</p>
                <h3 id="stat-total">—</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">✅</div>
            <div class="stat-info">
                <p>Đang hiệu lực</p>
                <h3 id="stat-active">—</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">⏳</div>
            <div class="stat-info">
                <p>Sắp hết hạn</p>
                <h3 id="stat-expiring">—</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red">🔴</div>
            <div class="stat-info">
                <p>Đã thanh lý</p>
                <h3 id="stat-settled">—</h3>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="hd-filter-bar">
        <div class="filter-search">
            <span class="search-icon">🔍</span>
            <input type="text" id="searchInput" placeholder="Tìm mã HĐ, tên khách thuê, phòng..." oninput="handleSearch()" />
        </div>
        <select class="filter-select" id="statusFilter" onchange="handleSearch()">
            <option value="">Tất cả trạng thái</option>
            <option value="active">✅ Đang hiệu lực</option>
            <option value="expiring">⏳ Sắp hết hạn</option>
            <option value="expired">🔴 Đã hết hạn</option>
            <option value="settled">⚪ Đã thanh lý</option>
        </select>
        <select class="filter-select" id="roomFilter" onchange="handleSearch()">
            <option value="">Tất cả phòng</option>
        </select>
        <div class="filter-divider"></div>
        <div class="filter-info">Hiển thị: <strong id="filter-count">0</strong> hợp đồng</div>
    </div>

    <!-- TABLE CARD -->
    <div class="hd-table-card">
        <div class="table-header-bar">
            <h2>Danh sách Hợp đồng</h2>
            <div class="view-toggle">
                <button class="toggle-btn active" id="btnTable" onclick="switchView('table')" title="Dạng bảng">☰</button>
                <button class="toggle-btn" id="btnGrid" onclick="switchView('grid')" title="Dạng lưới">⊞</button>
            </div>
        </div>

        <!-- TABLE VIEW -->
        <div id="tableView" class="hd-table-wrap">
            <table class="hd-table">
                <thead>
                    <tr>
                        <th class="sortable" onclick="sortTable('contractCode')">Mã HĐ ↕</th>
                        <th>Khách thuê</th>
                        <th class="sortable" onclick="sortTable('roomName')">Phòng ↕</th>
                        <th class="sortable" onclick="sortTable('startDate')">Ngày BĐ ↕</th>
                        <th class="sortable" onclick="sortTable('endDate')">Ngày KT ↕</th>
                        <th>Tiền thuê</th>
                        <th>Trạng thái</th>
                        <th style="text-align:center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="contractTableBody">
                    <tr><td colspan="8"><div class="loading-state"><div class="spinner"></div><p>Đang tải dữ liệu...</p></div></td></tr>
                </tbody>
            </table>
        </div>

        <!-- GRID VIEW -->
        <div id="gridView" class="hd-grid-view"></div>

        <!-- PAGINATION -->
        <div class="hd-pagination">
            <div class="page-info" id="pageInfo">Trang 1 / 1</div>
            <div class="page-btns" id="pageBtns"></div>
        </div>
    </div>
</div>

<!-- ===== MODAL CHI TIẾT / THÊM / SỬA HỢP ĐỒNG ===== -->
<div class="modal-overlay" id="contractModal">
    <div class="modal-box">
        <div class="modal-head">
            <h2 id="modalTitle">Chi tiết Hợp đồng</h2>
