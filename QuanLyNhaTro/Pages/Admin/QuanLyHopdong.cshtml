            .btn-view {
                background: var(--blue-soft);
                color: var(--blue);
            }

            .btn-edit {
                background: var(--primary-soft);
                color: var(--primary);
            }

            .btn-del {
                background: var(--red-soft);
                color: var(--red);
            }

            .btn-icon:hover {
                transform: translateY(-1px);
                filter: brightness(.93);
