            .cc-id {
                font-size: 12px;
                font-weight: 700;
                color: var(--blue);
            }

            .cc-tenant {
                font-weight: 700;
                font-size: 15px;
                margin-bottom: 3px;
            }

            .cc-phone {
                font-size: 12px;
                color: var(--text-light);
