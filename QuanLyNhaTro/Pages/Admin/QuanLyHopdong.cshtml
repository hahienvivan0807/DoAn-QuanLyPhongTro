@page "/Admin/QuanLyHopDong"
@model QuanLyNhaTro.Pages.Admin.QuanLyHopdongcshtmlModel
@{
    ViewData["Title"] = "Quản lý Hợp đồng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Hợp đồng – Nhà Trọ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- FIX: Script chuyển xuống cuối <body> để DOM load xong mới chạy JS -->

    <style>
            /* ==========================================================
                 IMPORT FONT
              ========================================================== */
            @@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap');

            /* ==========================================================
                 BIẾN MÀU & THIẾT KẾ TOÀN CỤC
              ========================================================== */
            :root {
                /* Màu chủ đề – vàng đồng sang trọng */
                --mau-chu-de: #b8720a;
                --mau-chu-de-sang: #e8971c;
                --mau-chu-de-nhat: #fdf6e3;
                --mau-chu-de-vien: rgba(184,114,10,0.15);
                /* Sidebar */
                --mau-sidebar: #0d1b2e;
                --mau-sidebar-dam: #081020;
                --mau-sidebar-vien: rgba(255,255,255,0.06);
                --mau-sidebar-hover: rgba(232,151,28,0.12);
                --mau-sidebar-active: rgba(232,151,28,0.18);
                /* Nền & nội dung */
                --mau-nen: #f0f2f8;
                --mau-nen-card: #f8f9fd;
                --mau-trang: #ffffff;
                --mau-chu: #111827;
                --mau-chu-phu: #6b7a99;
                --mau-vien: #e5e9f5;
                /* Trạng thái */
                --mau-xanh: #0ea271;
                --mau-xanh-nhat: #ecfdf5;
                --mau-do: #e53e3e;
                --mau-do-nhat: #fff5f5;
                --mau-xanh-bien: #2563eb;
                --mau-xanh-bien-nhat: #eff6ff;
                /* Bóng đổ */
                --bong-card: 0 2px 12px rgba(13,27,46,0.06), 0 1px 3px rgba(13,27,46,0.04);
                --bong-card-hover: 0 8px 28px rgba(184,114,10,0.14), 0 2px 8px rgba(13,27,46,0.08);
                --bong-sidebar: 6px 0 32px rgba(0,0,0,0.3);
                --bong-header: 0 1px 0 var(--mau-vien), 0 2px 16px rgba(13,27,46,0.04);
                /* Bo góc */
                --radius-sm: 8px;
                --radius-md: 12px;
                --radius-lg: 16px;
                --radius-xl: 20px;
                --radius-full: 9999px;
                --white: var(--mau-trang);
                --border: var(--mau-vien);
                --bg: var(--mau-nen);
                --text: var(--mau-chu);
                --muted: var(--mau-chu-phu);
                --gold: var(--mau-chu-de);
                --gold-l: var(--mau-chu-de-sang);
                --gold-pale: var(--mau-chu-de-nhat);
                --gold-border: var(--mau-chu-de-vien);
                --r: var(--radius-sm);
                --r-full: var(--radius-full);
                /* ── Biến riêng trang HĐ ── */
                --bg-page: #f4f6f9;
                --bg-card: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0,0,0,.06);
                --shadow-md: 0 4px 20px rgba(0,0,0,.10);
                --primary: #f5a623;
                --primary-soft: #fff8ec;
                --blue: #4a90e2;
                --blue-soft: #eef4fd;
                --green: #27ae60;
                --green-soft: #eafaf1;
                --red: #e74c3c;
                --red-soft: #fdf0ef;
                --purple: #8e44ad;
                --purple-soft: #f5eefb;
                --gray: #95a5a6;
                --gray-soft: #f0f2f5;
                --text-dark: #2c3e50;
                --text-mid: #5d6d7e;
                --text-light: #95a5a6;
                --font: 'Be Vietnam Pro', 'Segoe UI', sans-serif;
            }

            /* ==========================================================
                 RESET & CƠ BẢN
              ========================================================== */
            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Be Vietnam Pro', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: clip;
                -webkit-font-smoothing: antialiased;
            }

            /* ==========================================================
                 SIDEBAR
              ========================================================== */
            #thanh-sidebar {
                width: 248px;
                min-width: 248px;
                background: var(--mau-sidebar);
                display: flex;
                flex-direction: column;
                height: 100vh;
                z-index: 100;
                box-shadow: var(--bong-sidebar);
                overflow-y: auto;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
                position: relative;
                border-right: 1px solid rgba(255,255,255,0.04);
            }

                #thanh-sidebar.an {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            .ten-logo, .thong-tin-chu-tro .ten-chu {
                transition: opacity 0.2s, max-width 0.35s;
                max-width: 160px;
                overflow: hidden;
            }

            .nhan-nhom-menu {
                transition: opacity 0.2s, max-height 0.3s;
            }

            #thanh-sidebar.thu-gon .nhan-nhom-menu {
                opacity: 0;
                max-height: 0;
                padding: 0;
            }

            .muc-menu span:not(.huy-hieu) {
                transition: opacity 0.2s, max-width 0.35s;
                max-width: 160px;
                overflow: hidden;
                display: inline-block;
            }

            #thanh-sidebar.thu-gon .muc-menu span:not(.huy-hieu) {
                opacity: 0;
                max-width: 0;
            }

            #thanh-sidebar.thu-gon .huy-hieu {
                opacity: 0;
                width: 0;
                overflow: hidden;
                padding: 0;
            }

            #thanh-sidebar.thu-gon .muc-menu {
                padding: 10px 0;
                justify-content: center;
                border-radius: 10px;
                margin: 2px 8px;
                width: calc(100% - 12px);
            }

            #thanh-sidebar.thu-gon .thong-tin-chu-tro {
                justify-content: center;
            }

            #thanh-sidebar.thu-gon .muc-menu i {
                width: auto;
                font-size: 16px;
            }

            #thanh-sidebar::-webkit-scrollbar {
                width: 0;
            }

            .khu-vuc-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 24px 20px 20px;
                border-bottom: 1px solid var(--mau-sidebar-vien);
            }

            .bieu-tuong-logo {
                width: 40px;
                height: 40px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                color: #fff;
                box-shadow: 0 4px 14px rgba(184,114,10,0.45);
            }

            .ten-logo strong {
                display: block;
                color: #fff;
                font-size: 13.5px;
                font-weight: 800;
                letter-spacing: 0.2px;
            }

            .ten-logo span {
                font-size: 10px;
                color: rgba(255,255,255,0.32);
                letter-spacing: 0.3px;
            }

            .nhan-nhom-menu {
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 2px;
                color: rgba(255,255,255,0.22);
                text-transform: uppercase;
                padding: 18px 20px 6px;
            }

            .muc-menu {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 14px 9px 16px;
                color: rgba(255,255,255,0.52);
                cursor: pointer;
                border-radius: 0 var(--radius-full) var(--radius-full) 0;
                margin: 1px 12px 1px 0;
                transition: all 0.18s ease;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                position: relative;
            }

                .muc-menu i {
                    width: 18px;
                    text-align: center;
                    font-size: 13px;
                    opacity: 0.75;
                    flex-shrink: 0;
                    transition: opacity 0.18s;
                }

                .muc-menu:hover {
                    background: var(--mau-sidebar-hover);
                    color: rgba(255,255,255,0.9);
                }

                    .muc-menu:hover i {
                        opacity: 1;
                    }

                .muc-menu.dang-chon {
                    background: var(--mau-sidebar-active);
                    color: #fff;
                    font-weight: 700;
                }

                    .muc-menu.dang-chon i {
                        opacity: 1;
                        color: var(--mau-chu-de-sang);
                    }

                    .muc-menu.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 60%;
                        width: 3px;
                        background: var(--mau-chu-de-sang);
                        border-radius: 0 3px 3px 0;
                    }

            .huy-hieu {
                margin-left: auto;
                background: rgba(239,68,68,0.85);
                color: #fff;
                font-size: 9.5px;
                font-weight: 800;
                border-radius: var(--radius-full);
                padding: 2px 7px;
                min-width: 18px;
                text-align: center;
            }

                .huy-hieu.vang {
                    background: var(--mau-chu-de);
                }

            .thong-tin-chu-tro {
                margin-top: auto;
                padding: 14px 16px;
                border-top: 1px solid var(--mau-sidebar-vien);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                flex-shrink: 0;
                position: sticky;
                bottom: 0;
                background: var(--mau-sidebar-dam);
                z-index: 1;
                transition: background 0.18s;
            }

                .thong-tin-chu-tro:hover {
                    background: rgba(255,255,255,0.04);
                }

            .anh-chu-tro {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 15px;
                font-weight: 800;
            }

            .ten-chu strong {
                display: block;
                color: #fff;
                font-size: 12.5px;
                font-weight: 700;
            }

            .ten-chu span {
                color: rgba(255,255,255,0.35);
                font-size: 10px;
            }

            /* ==========================================================
                 KHU VỰC CHÍNH
              ========================================================== */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* HEADER */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 62px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: var(--bong-header);
                flex-shrink: 0;
                z-index: 50;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .nut-ham-burger {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: var(--radius-sm);
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .nut-ham-burger:hover {
                    background: var(--mau-chu-de-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-header {
                font-size: 14.5px;
                font-weight: 800;
                color: var(--mau-chu);
                font-family: 'Lexend', sans-serif;
            }

            .duong-dan-header {
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-top: 1px;
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .o-tim-kiem {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1.5px solid var(--mau-vien);
                border-radius: var(--radius-full);
                padding: 7px 16px;
                transition: all 0.2s;
            }

                .o-tim-kiem:focus-within {
                    border-color: var(--mau-chu-de);
                    background: #fff;
                    box-shadow: 0 0 0 3px var(--mau-chu-de-vien);
                }

                .o-tim-kiem input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 12.5px;
                    width: 170px;
                    color: var(--mau-chu);
                    font-family: inherit;
                }

                    .o-tim-kiem input::placeholder {
                        color: var(--mau-chu-phu);
                    }

                .o-tim-kiem i {
                    color: var(--mau-chu-phu);
                    font-size: 12px;
                }

            .nut-chuong {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 16px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: var(--radius-full);
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
            }

                .nut-chuong:hover {
                    background: var(--mau-chu-de-nhat);
                    color: var(--mau-chu-de);
                }

            .so-chuong {
                position: absolute;
                top: 2px;
                right: 2px;
                background: var(--mau-do);
                color: #fff;
                font-size: 8.5px;
                font-weight: 800;
                border-radius: var(--radius-full);
                width: 15px;
                height: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            .the-chu-tro {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                font-size: 9.5px;
                font-weight: 800;
                padding: 3px 10px;
                border-radius: var(--radius-full);
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .khoi-admin-header {
                display: flex;
                align-items: center;
                gap: 9px;
                cursor: pointer;
                padding: 5px 10px;
                border-radius: var(--radius-full);
                transition: background 0.2s;
                position: relative;
            }

                .khoi-admin-header:hover {
                    background: var(--mau-chu-de-nhat);
                }

            .anh-dai-dien-header {
                width: 34px;
                height: 34px;
                border-radius: var(--radius-sm);
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 13px;
                font-weight: 800;
            }

            .ten-admin-header {
                font-size: 12.5px;
                font-weight: 700;
            }

            .vai-tro-header {
                font-size: 10px;
                color: var(--mau-chu-phu);
            }

            .header-divider {
                width: 1px;
                height: 22px;
                background: var(--mau-vien);
                margin: 0 2px;
            }

            .admin-dropdown {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                width: 240px;
                background: var(--mau-trang);
                border-radius: 14px;
                border: 1px solid var(--mau-vien);
                overflow: hidden;
                box-shadow: 0 8px 32px rgba(13,27,46,0.12), 0 2px 8px rgba(13,27,46,0.06);
                z-index: 999;
                transform-origin: top right;
                transform: scale(0.92) translateY(-8px);
                opacity: 0;
                pointer-events: none;
                transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1), opacity 0.15s ease;
            }

                .admin-dropdown.show {
                    transform: scale(1) translateY(0);
                    opacity: 1;
                    pointer-events: all;
                }

            .add-header {
                padding: 14px 16px 12px;
                border-bottom: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .add-header-avatar {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 15px;
                font-weight: 800;
            }

            .add-header-name {
                font-size: 13px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .add-header-email {
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-top: 2px;
            }

            .add-header-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 9.5px;
                font-weight: 800;
                letter-spacing: 0.4px;
                padding: 2px 8px;
                border-radius: var(--radius-full);
                margin-top: 4px;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
            }

            .add-body {
                padding: 6px;
            }

            .add-item {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 9px 12px;
                border-radius: 9px;
                cursor: pointer;
                transition: background 0.14s;
                border: none;
                background: none;
                width: 100%;
                font-family: inherit;
                text-align: left;
            }

                .add-item:hover {
                    background: var(--mau-nen);
                }

            .add-item-icon {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

                .add-item-icon.vang {
                    background: var(--mau-chu-de-nhat);
                    color: var(--mau-chu-de);
                }

                .add-item-icon.do {
                    background: var(--mau-do-nhat);
                    color: var(--mau-do);
                }

            .add-item-label {
                font-size: 13px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .add-item-sub {
                font-size: 10.5px;
                color: var(--mau-chu-phu);
                margin-top: 1px;
            }

            .add-item.danger:hover {
                background: var(--mau-do-nhat);
            }

                .add-item.danger:hover .add-item-label {
                    color: var(--mau-do);
                }

            .add-divider {
                height: 1px;
                background: var(--mau-vien);
                margin: 4px 0;
            }

            /* ==========================================================
                 NỘI DUNG TRANG
              ========================================================== */
            #noi-dung-chinh {
                flex: 1;
                overflow-y: auto;
                padding: 0;
            }

                #noi-dung-chinh::-webkit-scrollbar {
                    width: 5px;
                }

                #noi-dung-chinh::-webkit-scrollbar-track {
                    background: transparent;
                }

                #noi-dung-chinh::-webkit-scrollbar-thumb {
                    background: #d4d9e6;
                    border-radius: 3px;
                }

            /* ==========================================================
                 CSS TRANG HỢP ĐỒNG
              ========================================================== */
            .hd-page {
                background: var(--bg-page);
                min-height: 100%;
                padding: 24px 28px 48px;
                font-family: var(--font);
                color: var(--text-dark);
            }

            .hd-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 24px;
            }

            .hd-header-left h1 {
                font-size: 22px;
                font-weight: 700;
                margin: 0 0 2px;
            }

            .hd-breadcrumb {
                font-size: 12px;
                color: var(--text-light);
            }

                .hd-breadcrumb span {
                    color: var(--primary);
                    font-weight: 600;
                }

            .btn-add {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: var(--primary);
                color: #fff;
                border: none;
                border-radius: var(--radius-sm);
                padding: 9px 18px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: opacity .2s, transform .15s;
                text-decoration: none;
            }

                .btn-add:hover {
                    opacity: .88;
                    transform: translateY(-1px);
                }

            .hd-stats {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 16px;
                margin-bottom: 24px;
            }

            @@media(max-width:900px) {
                .hd-stats {
                    grid-template-columns: repeat(2,1fr);
                }
            }

            @@media(max-width:500px) {
                .hd-stats {
                    grid-template-columns: 1fr;
                }
            }

            .stat-card {
                background: var(--bg-card);
                border-radius: var(--radius-lg);
                padding: 18px 20px;
                box-shadow: var(--shadow-sm);
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid var(--border);
                transition: box-shadow .2s;
            }

                .stat-card:hover {
                    box-shadow: var(--shadow-md);
                }

            .stat-icon {
                width: 46px;
                height: 46px;
                border-radius: var(--radius-md);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

                .stat-icon.blue {
                    background: var(--blue-soft);
                    color: var(--blue);
                }

                .stat-icon.green {
                    background: var(--green-soft);
                    color: var(--green);
                }

                .stat-icon.orange {
                    background: var(--primary-soft);
                    color: var(--primary);
                }

                .stat-icon.red {
                    background: var(--red-soft);
                    color: var(--red);
                }

            .stat-info p {
                margin: 0;
                font-size: 12px;
                color: var(--text-light);
            }

            .stat-info h3 {
                margin: 2px 0 0;
                font-size: 22px;
                font-weight: 700;
            }

            .hd-filter-bar {
                background: var(--bg-card);
                border-radius: var(--radius-lg);
