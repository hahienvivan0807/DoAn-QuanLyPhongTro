                    opacity: .87;
                }

            .btn-danger {
                padding: 9px 20px;
                background: var(--red-soft);
                border: none;
                border-radius: var(--radius-sm);
                cursor: pointer;
                font-size: 14px;
                color: var(--red);
                font-weight: 600;
                transition: opacity .15s;
            }

                .btn-danger:hover {
                    background: var(--red);
                    color: #fff;
                }

            .confirm-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.5);
                z-index: 1100;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

                .confirm-overlay.open {
                    display: flex;
                }

            .confirm-box {
                background: var(--bg-card);
                border-radius: var(--radius-lg);
                padding: 30px;
                width: 100%;
                max-width: 380px;
                text-align: center;
                box-shadow: 0 20px 60px rgba(0,0,0,.18);
            }

            .confirm-icon {
                font-size: 46px;
                margin-bottom: 14px;
            }

            .confirm-box h3 {
                margin: 0 0 8px;
                font-size: 17px;
            }

            .confirm-box p {
                margin: 0 0 20px;
                font-size: 13.5px;
                color: var(--text-mid);
            }

            .confirm-btns {
                display: flex;
                gap: 10px;
                justify-content: center;
            }

            #toast {
                position: fixed;
                bottom: 28px;
                right: 28px;
                z-index: 2000;
                background: var(--text-dark);
                color: #fff;
                padding: 12px 20px;
                border-radius: var(--radius-md);
                font-size: 13.5px;
                font-weight: 500;
                box-shadow: var(--shadow-md);
                transform: translateY(80px);
                opacity: 0;
                transition: all .3s cubic-bezier(.175,.885,.32,1.275);
                max-width: 320px;
            }

                #toast.show {
                    transform: translateY(0);
                    opacity: 1;
                }

                #toast.success {
                    background: var(--green);
                }

                #toast.error {
                    background: var(--red);
                }

            @@media(max-width:768px) {
                .hd-page {
                    padding: 16px 14px 40px;
                }

                .hd-table {
                    font-size: 12.5px;
                }

                    .hd-table td, .hd-table th {
                        padding: 10px 11px;
                    }

                .filter-divider {
                    display: none;
                }

                .filter-info {
                    display: none;
                }
            }
    </style>
</head>
