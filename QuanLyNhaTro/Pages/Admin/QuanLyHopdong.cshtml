            .badge-active {
                background: var(--green-soft);
                color: var(--green);
            }

                .badge-active::before {
                    background: var(--green);
                }

            .badge-expiring {
                background: #fff8e1;
                color: #f57c00;
            }

                .badge-expiring::before {
                    background: #f57c00;
                }

            .badge-expired {
                background: var(--red-soft);
                color: var(--red);
            }

                .badge-expired::before {
                    background: var(--red);
                }

            .badge-settled {
                background: var(--gray-soft);
                color: var(--gray);
            }

                .badge-settled::before {
                    background: var(--gray);
