                padding: 16px 24px;
                border-top: 1px solid var(--border);
                display: flex;
                gap: 10px;
                justify-content: flex-end;
            }

            .btn-secondary {
                padding: 9px 20px;
                border: 1.5px solid var(--border);
                background: none;
                border-radius: var(--radius-sm);
                cursor: pointer;
                font-size: 14px;
                color: var(--text-mid);
                font-weight: 600;
                transition: all .15s;
            }

                .btn-secondary:hover {
                    border-color: var(--text-mid);
                    color: var(--text-dark);
                }

