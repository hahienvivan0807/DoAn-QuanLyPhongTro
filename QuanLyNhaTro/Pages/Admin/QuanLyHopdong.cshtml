@page "/Admin/QuanLyHopDong"
@model QuanLyNhaTro.Pages.Admin.QuanLyHopdongcshtmlModel
@{
    ViewData["Title"] = "Quản lý Hợp đồng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Hợp đồng – Nhà Trọ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
   <link rel="stylesheet" href="~/css/Admin/QuanLyHopDong.css" />
</head>
<body>

    <!-- =============================================
     SIDEBAR
============================================= -->
    <nav id="thanh-sidebar">

        <div class="khu-vuc-logo">
            <div class="bieu-tuong-logo">
                <i class="fas fa-crown"></i>
            </div>
            <div class="ten-logo">
                <strong>NHÀ TRỌ BÀ NĂM</strong>
                <span>Cổng Chủ Trọ</span>
            </div>
        </div>

        <div class="nhan-nhom-menu">Tổng quan</div>
        <div class="muc-menu" onclick="chuyenMenu('trang-chu', this)">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </div>

        <div class="nhan-nhom-menu">Vận hành</div>
        <div class="muc-menu" onclick="chuyenMenu('quan-ly-phong', this)">
            <i class="fas fa-building"></i>
            <span>Quản lý phòng trọ</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Người thuê</span>
        </div>
        <div class="muc-menu dang-chon">
            <i class="fas fa-file-contract"></i>
            <span>Hợp đồng</span>
            <span class="huy-hieu vang" id="badge-hop-dong">2</span>
        </div>

        <div class="nhan-nhom-menu">Quản trị chủ trọ</div>
        <div class="muc-menu" onclick="window.location.href='/Admin/Taikhoanquanly'">
            <i class="fas fa-user-shield"></i>
            <span>Tài khoản quản lý</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/QuanLyNguoiThue'">
            <i class="fas fa-users"></i>
            <span>Quản lý người thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/CauHinhGiaThue'">
            <i class="fas fa-sliders-h"></i>
            <span>Cấu hình giá thuê</span>
        </div>
        <div class="muc-menu" onclick="window.location.href='/Admin/DichVuThongBao'">
            <i class="fas fa-bolt"></i>
            <span>Dịch vụ thông báo</span>
        </div>

        <div class="nhan-nhom-menu">Hỗ trợ</div>
        <div class="muc-menu" onclick="chuyenMenu('sua-chua', this)">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            <span id="huy-hieu-sua-chua" class="huy-hieu">3</span>
        </div>
        <div class="muc-menu" onclick="chuyenMenu('bao-cao', this)">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </div>
        <div class="muc-menu" onclick="chuyenMenu('cai-dat', this)">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </div>

        <div class="thong-tin-chu-tro">
            <div class="anh-chu-tro" id="sidebar-avatar">C</div>
            <div class="ten-chu">
                <strong id="sidebar-ten">Chủ Trọ ABC</strong>
                <span>Chủ sở hữu</span>
            </div>
        </div>

    </nav><!-- /SIDEBAR -->
    <!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-burger" onclick="dongMoSidebar()" title="Mở/Đóng menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-header">Quản lý Hợp đồng</div>
                    <div class="duong-dan-header">Trang chủ / Vận hành / Hợp đồng</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm nhanh..." />
                </div>

                <button class="nut-chuong">
                    <i class="fas fa-bell"></i>
                    <span class="so-chuong">2</span>
                </button>

                <span class="the-chu-tro">Chủ trọ</span>

                <div class="header-divider"></div>

                <div class="khoi-admin-header" id="adminHeaderWrap" onclick="toggleAdminMenu()">
                    <div class="anh-dai-dien-header"><i class="fas fa-user"></i></div>
                    <div>
                        <div class="ten-admin-header" id="ten-admin-header">Admin</div>
                        <div class="vai-tro-header">Chủ sở hữu</div>
                    </div>
                    <i class="fas fa-chevron-down" id="adminChevron"
                       style="font-size:11px;color:var(--mau-chu-phu);margin-left:2px;transition:transform 0.2s;"></i>

                    <div class="admin-dropdown" id="adminDropdown">
                        <div class="add-header">
                            <div class="add-header-avatar"><i class="fas fa-user"></i></div>
                            <div>
                                <div class="add-header-name" id="dd-name">Admin</div>
                                <div class="add-header-email" id="dd-email">—</div>
                                <div class="add-header-badge"><i class="fas fa-crown" style="font-size:8px;"></i> Chủ trọ</div>
                            </div>
                        </div>
                        <div class="add-body">
                            <button class="add-item" onclick="moDoiMatKhau()">
                                <div class="add-item-icon vang"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="add-item-label">Đổi mật khẩu</div>
                                    <div class="add-item-sub">Cập nhật bảo mật tài khoản</div>
                                </div>
                            </button>
                            <div class="add-divider"></div>
                            <button class="add-item danger" onclick="xacNhanDangXuat()">
                                <div class="add-item-icon do"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="add-item-label">Đăng xuất</div>
                                    <div class="add-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header><!-- /HEADER -->
        <!-- NỘI DUNG CHÍNH -->
        <main id="noi-dung-chinh">
            <div class="hd-page">

                <!-- HEADER TRANG -->
                <div class="hd-header">
                    <div class="hd-header-left">
                        <h1>📄 Quản lý Hợp đồng</h1>
                        <div class="hd-breadcrumb">Trang chủ / Vận hành / <span>Hợp đồng</span></div>
                    </div>
                    <button class="btn-add" onclick="openAddModal()">
                        ＋ Thêm hợp đồng
                    </button>
                </div>

                <!-- STAT CARDS -->
                <div class="hd-stats">
                    <div class="stat-card">
                        <div class="stat-icon blue">📋</div>
                        <div class="stat-info">
                            <p>Tổng hợp đồng</p>
                            <h3 id="stat-total">—</h3>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">✅</div>
                        <div class="stat-info">
                            <p>Đang hiệu lực</p>
                            <h3 id="stat-active">—</h3>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">⏳</div>
                        <div class="stat-info">
                            <p>Sắp hết hạn</p>
                            <h3 id="stat-expiring">—</h3>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon red">🔴</div>
                        <div class="stat-info">
                            <p>Đã thanh lý / Hết hạn</p>
                            <h3 id="stat-settled">—</h3>
                        </div>
                    </div>
                </div>

                <!-- FILTER BAR -->
                <div class="hd-filter-bar">
                    <div class="filter-search">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" placeholder="Tìm mã HĐ, tên khách thuê, phòng..." oninput="handleSearch()" />
                    </div>
                    <select class="filter-select" id="statusFilter" onchange="handleSearch()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active">✅ Đang hiệu lực</option>
                        <option value="expiring">⏳ Sắp hết hạn</option>
                        <option value="expired">🔴 Đã hết hạn</option>
                        <option value="settled">⚪ Đã thanh lý</option>
                    </select>
                    <select class="filter-select" id="roomFilter" onchange="handleSearch()">
                        <option value="">Tất cả phòng</option>
                    </select>
                    <div class="filter-divider"></div>
                    <div class="filter-info">Hiển thị: <strong id="filter-count">0</strong> hợp đồng</div>
                </div>

                <!-- TABLE CARD -->
                <div class="hd-table-card">
                    <div class="table-header-bar">
                        <h2>Danh sách Hợp đồng</h2>
                        <div class="view-toggle">
                            <button class="toggle-btn active" id="btnTable" onclick="switchView('table')" title="Dạng bảng">☰</button>
                            <button class="toggle-btn" id="btnGrid" onclick="switchView('grid')" title="Dạng lưới">⊞</button>
                        </div>
                    </div>

                    <!-- TABLE VIEW -->
                    <div id="tableView" class="hd-table-wrap">
                        <table class="hd-table">
                            <thead>
                                <tr>
                                    <th class="sortable" onclick="sortTable('contractCode')">Mã HĐ ↕</th>
                                    <th>Khách thuê</th>
                                    <th class="sortable" onclick="sortTable('roomName')">Phòng ↕</th>
                                    <th class="sortable" onclick="sortTable('startDate')">Ngày BĐ ↕</th>
                                    <th class="sortable" onclick="sortTable('endDate')">Ngày KT ↕</th>
                                    <th>Tiền thuê</th>
                                    <th>Trạng thái</th>
                                    <th style="text-align:center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="contractTableBody">
                                <tr>
                                    <td colspan="8">
                                        <div class="loading-state">
                                            <div class="spinner"></div>
                                            <p>Đang tải dữ liệu...</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- GRID VIEW -->
                    <div id="gridView" class="hd-grid-view"></div>

                    <!-- PAGINATION -->
                    <div class="hd-pagination">
                        <div class="page-info" id="pageInfo">Trang 1 / 1</div>
                        <div class="page-btns" id="pageBtns"></div>
                    </div>
                </div>

            </div><!-- /hd-page -->
        </main><!-- /noi-dung-chinh -->

    </div><!-- /khu-vuc-chinh -->
    <!-- ===== MODAL CHI TIẾT / THÊM / SỬA HỢP ĐỒNG ===== -->
    <div class="modal-overlay" id="contractModal">
        <div class="modal-box">
            <div class="modal-head">
                <h2 id="modalTitle">Chi tiết Hợp đồng</h2>
                <button class="modal-close" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Nội dung được render động qua JS -->
            </div>
            <div class="modal-foot" id="modalFoot"></div>
        </div>
    </div>

    <!-- ===== CONFIRM XÓA ===== -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-box">
            <div class="confirm-icon">🗑️</div>
            <h3>Xác nhận xóa</h3>
            <p id="confirmMsg">Bạn có chắc muốn xóa hợp đồng này?<br>Hành động này không thể hoàn tác.</p>
            <div class="confirm-btns">
                <button class="btn-secondary" onclick="closeConfirm()">Hủy</button>
                <button class="btn-danger" id="confirmOkBtn">Xóa hợp đồng</button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast"></div>

    <!-- FIX: Script đặt cuối <body> để DOM đã sẵn sàng khi JS chạy -->
    <script src="/js/ChuTro/ChuTro-core.js"></script>
    <script src="~/js/ChuTro/ChuTro-HopDong.js"></script>

    <script>
        window.hienThiThongBao = function(noiDung, loai = 'success') {
        // Gọi ID bằng tiếng Việt
        const khuVucChua = document.getElementById('khu-vuc-thong-bao-nha-tro');
        if (!khuVucChua) return;

        // Chuyển đổi tham số type sang class tiếng Việt tương ứng
        let classMauSac = '';
        switch(loai) {
        case 'success': classMauSac = 'thong-bao-thanh-cong'; break;
        case 'fail': classMauSac = 'thong-bao-canh-bao'; break;
        case 'error': classMauSac = 'thong-bao-loi'; break;
        default: classMauSac = 'thong-bao-thanh-cong';
        }

        // Tạo phần tử DOM
        const theThongBao = document.createElement('div');
        theThongBao.className = `thong-bao-muc ${classMauSac}`;
    
        // Gắn HTML nội dung và nút X
        theThongBao.innerHTML = `
        <span>${noiDung}</span>
        <button class="nut-tat-thong-bao" onclick="this.parentElement.remove()">×</button>
        `;

        // Đẩy vào trang
        khuVucChua.appendChild(theThongBao);

        // Xóa thẻ DOM hoàn toàn sau đúng 3000ms (3 giây)
        setTimeout(() => {
        if (theThongBao.parentNode) {
        theThongBao.remove();
        }
        }, 3000);
        }
        document.addEventListener('DOMContentLoaded', () => {
        if (typeof HienThiProfile === 'function') HienThiProfile();
        });
    </script>
    <!--Thông báo-->
    <div id="khu-vuc-thong-bao-nha-tro" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>
</body>
</html>
