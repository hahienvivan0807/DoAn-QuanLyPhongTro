                        <i class="fas fa-arrow-left" style="margin-right:5px;"></i>Quay lại
                    </button>
                    <button class="btn-modal-gui" id="modal-btn-gui" onclick="guiXacNhan()">
                        <i class="fas fa-paper-plane"></i> Gửi xác nhận thanh toán
                    </button>
                </div>
            </div>

            <div class="modal-success" id="modal-success">
                <div class="success-icon"><i class="fas fa-check-circle"></i></div>
                <h4>Thanh toán đã được xác nhận!</h4>
                <p>
                    Cảm ơn bạn đã sử dụng dịch vụ.<br />
                    Đơn sẽ được xác nhận trong vòng <strong>15 phút</strong>.
                </p>
                <button class="btn-ve-trang" onclick="dongModal()">
                    <i class="fas fa-arrow-left" style="margin-right:6px;"></i>Tiếp tục
                </button>
            </div>

        </div>
    </div>


    @* =============================================
     JAVASCRIPT
  ============================================= *@
    @* Token chống CSRF — dùng cho các POST fetch trong JS *@
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <input type="hidden" name="__RequestVerificationToken"
           value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

    <script src="~/js/Khach/DichVu.js"></script>
    <script>
        // ── Hủy cộng nợ DV vào hóa đơn → chuyển sang thanh toán riêng ──
        async function huyNoDV(donId, loai) {
        const btnId = loai === 'gs' ? 'gs-btn-huy-no-dv' : 'nuoc-btn-huy-no-dv';
        const btn   = document.getElementById(btnId);
        if (!btn) return;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

        const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
        try {
        const res = await fetch('?handler=HuyNoDV', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ donId })
        });
        if (!res.ok) throw new Error(await res.text());

        // Ẩn banner, mở modal thanh toán riêng
        const banner = document.getElementById(loai === 'gs' ? 'gs-no-dv-banner' : 'nuoc-no-dv-banner');
        if (banner) banner.style.display = 'none';

        // Cập nhật badge về "Chờ thanh toán"
        const badgeEl = document.getElementById(loai === 'gs' ? 'gs-badge' : 'nuoc-badge');
        if (badgeEl) {
        badgeEl.className = 'dv-status-badge dsb-pay';
        badgeEl.innerHTML = '<span class="dsb-dot"></span>Chờ thanh toán';
        }

        // Hiện nút thanh toán riêng
        const btnTT = document.getElementById(loai === 'gs' ? 'gs-btn-thanh-toan' : 'nuoc-btn-thanh-toan');
        if (btnTT) btnTT.style.display = 'flex';

        // Hiện form (nếu đang ẩn)
        const formWrap = document.getElementById(loai === 'gs' ? 'gs-form' : 'nuoc-form');
        if (formWrap) formWrap.classList.add('hien');

        const btnOpen = document.getElementById(loai === 'gs' ? 'gs-btn-open' : 'nuoc-btn-open');
        if (btnOpen) btnOpen.style.display = 'none';

        } catch (e) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-credit-card"></i> Thanh toán riêng — hủy khoản cộng vào hóa đơn';
        alert('Có lỗi: ' + e.message);
        }
        }

        // ── Cập nhật badge khi polling nhận duocCongVaoTro = true ──
        // Override hàm capNhatBadge từ DichVu.js nếu cần
        window.xuLyNoDVTuPolling = function(loai, don) {
        if (!don || !don.duocCongVaoTro) return false;
        const badgeEl  = document.getElementById(loai === 'gs' ? 'gs-badge' : 'nuoc-badge');
        const bannerEl = document.getElementById(loai === 'gs' ? 'gs-no-dv-banner' : 'nuoc-no-dv-banner');
        const btnTT    = document.getElementById(loai === 'gs' ? 'gs-btn-thanh-toan' : 'nuoc-btn-thanh-toan');

        if (badgeEl) {
        badgeEl.className = 'dv-status-badge dsb-no-dv';
        badgeEl.innerHTML = '<i class="fas fa-exclamation-triangle" style="font-size:10px;"></i>Nợ – Cộng vào hóa đơn';
        }
        // Ẩn nút thanh toán riêng nếu đang hiện
        if (btnTT) btnTT.style.display = 'none';

        // Nếu banner chưa có (server render chưa kịp) thì tạo động
        if (!bannerEl) {
        const card = document.getElementById(loai === 'gs' ? 'gs-form' : 'nuoc-form')?.closest('.dv-card-body');
        if (card) {
        const openBtn = document.getElementById(loai === 'gs' ? 'gs-btn-open' : 'nuoc-btn-open');
        const html = `
        <div class="no-dv-banner" id="${loai}-no-dv-banner">
        <div class="no-dv-banner-header">
        <div class="no-dv-banner-icon"><i class="fas fa-file-invoice-dollar"></i></div>
        <div>
        <div class="no-dv-banner-title">Tiền chưa thanh toán đã cộng vào hóa đơn tháng</div>
        <div class="no-dv-banner-sub">Đơn dịch vụ quá hạn 7 ngày chưa thanh toán. Khoản này đã được gộp vào hóa đơn tháng.</div>
        </div>
        </div>
        <div class="no-dv-amount-row">
        <span class="no-dv-amount-label">Số tiền đã cộng vào hóa đơn</span>
        <span class="no-dv-amount-val">${Number(don.tongTien).toLocaleString('vi-VN')} đ</span>
        </div>
        <button class="btn-huy-no-dv" id="${loai}-btn-huy-no-dv"
        onclick="huyNoDV(${don.id}, '${loai}')">
        <i class="fas fa-credit-card"></i>
        Thanh toán riêng — hủy khoản cộng vào hóa đơn
        </button>
        </div>`;
        if (openBtn) openBtn.insertAdjacentHTML('beforebegin', html);
        }
        } else {
        bannerEl.style.display = '';
        }
        return true;
        };

    </script>
</body>
</html>
