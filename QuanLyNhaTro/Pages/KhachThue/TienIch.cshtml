@page "/KhachThue/TienIch"
@model QuanLyNhaTro.Pages.KhachThue.TienIchModel
@{
    ViewData["title"] = "Dịch Vụ & Tiện Ích";
    Layout = null;

    // Badge giặt sấy
    string gsBadgeClass = "dv-status-badge dsb-none";
    string gsBadgeHtml = "<span class=\"dsb-dot\"></span>Chưa đặt";
    if (Model.DonGiatSayCongVaoTro != null)
    {
        gsBadgeClass = "dv-status-badge dsb-no-dv";
        gsBadgeHtml = "<i class=\"fas fa-exclamation-triangle\" style=\"font-size:10px;\"></i>Nợ – Cộng vào hóa đơn";
    }
    else if (Model.DonGiatSay != null)
    {
        gsBadgeClass = Model.DonGiatSay.TrangThai_DV == "Chờ xử lý" ? "dv-status-badge dsb-pending"
                     : Model.DonGiatSay.TrangThai_DV == "Đang xử lý" ? "dv-status-badge dsb-active"
                     : Model.DonGiatSay.TrangThai_DV == "Chờ thanh toán" ? "dv-status-badge dsb-pay"
                     : "dv-status-badge dsb-none";
        gsBadgeHtml = $"<span class=\"dsb-dot\"></span>{Model.DonGiatSay.TrangThai_DV}";
    }

    // Badge nước bình
    string nuocBadgeClass = "dv-status-badge dsb-none";
    string nuocBadgeHtml = "<span class=\"dsb-dot\"></span>Chưa đặt";
    if (Model.DonNuocBinhCongVaoTro != null)
    {
        nuocBadgeClass = "dv-status-badge dsb-no-dv";
        nuocBadgeHtml = "<i class=\"fas fa-exclamation-triangle\" style=\"font-size:10px;\"></i>Nợ – Cộng vào hóa đơn";
    }
    else if (Model.DonNuocBinh != null)
    {
        nuocBadgeClass = Model.DonNuocBinh.TrangThai_DV == "Chờ xử lý" ? "dv-status-badge dsb-pending"
                       : Model.DonNuocBinh.TrangThai_DV == "Đang xử lý" ? "dv-status-badge dsb-active"
                       : Model.DonNuocBinh.TrangThai_DV == "Chờ thanh toán" ? "dv-status-badge dsb-pay"
                       : "dv-status-badge dsb-none";
        nuocBadgeHtml = $"<span class=\"dsb-dot\"></span>{Model.DonNuocBinh.TrangThai_DV}";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tiện Ích – Nhà Trọ Bà Năm</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/KhachThue/TienIch.css"  rel="stylesheet" />
</head>
<body>

    @* =============================================
     SIDEBAR
  ============================================= *@
    <nav id="thanh-sidebar">
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Cổng khách thuê</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <a href="/KhachThue/KhachThue" class="menu-item">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </a>
        <a href="/Manager/Manager" class="menu-item">
            <i class="fas fa-home"></i><span>Trang Quản Lý</span>
        </a>
        <div class="nhan-nhom">Dịch vụ</div>
        <a href="/KhachThue/ThanhToan" class="menu-item">
            <i class="fas fa-credit-card"></i><span>Thanh toán</span>
        </a>
        <a href="/KhachThue/TienIch" class="menu-item dang-chon">
            <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
        </a>
        <a href="/KhachThue/BaoSuCo" class="menu-item">
            <i class="fas fa-tools"></i><span>Báo sự cố</span>
        </a>

        <div class="nhan-nhom">Cá nhân</div>
        <a href="/KhachThue/ThongBao" class="menu-item">
            <i class="fas fa-bell"></i><span>Thông báo</span>
            @if (Model.SoThongBaoChuaDoc > 0)
            {
                <span class="huy-hieu-menu">@Model.SoThongBaoChuaDoc</span>
            }
        </a>
        <a href="/KhachThue/HoSo" class="menu-item">
            <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
        </a>
        <a href="/KhachThue/CaiDat" class="menu-item">
            <i class="fas fa-cog"></i><span>Cài đặt</span>
        </a>

        <div class="sidebar-footer">
            <div class="anh-khach">@Model.ChuVietTat</div>
            <div class="ten-khach">
                <strong>@Model.TenKhach</strong>
                <span>@Model.SoPhong · @Model.TangPhong</span>
            </div>
        </div>
    </nav>

    @* =============================================
     KHU VỰC CHÍNH
  ============================================= *@
    <div id="khu-vuc-chinh">

        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()" aria-label="Toggle menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Dịch Vụ &amp; Tiện Ích</div>
                    <div class="duong-dan">
                        <a href="/KhachThue/KhachThue">Trang chủ</a>
                        &nbsp;/&nbsp; Tiện ích
                    </div>
                </div>
            </div>
            <div class="header-phai">
                <div class="hdr-date" id="headerDate"></div>
                <button class="nut-thong-bao" aria-label="Thông báo">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>
                <div class="thong-tin-khach">
                    <div class="anh-dai-dien">@Model.ChuVietTat</div>
                    <div>
                        <div class="ten">@Model.TenKhach</div>
                        <div class="phong-so">@Model.SoPhong</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>

        <main id="noi-dung-chinh">

            <div class="page-heading">
                <div>
                    <h2><i class="fas fa-concierge-bell"></i> Dịch vụ &amp; Tiện ích</h2>
                    <p>Đặt dịch vụ tiện ích ngay tại trang — @Model.SoPhong &nbsp;·&nbsp; @Model.TenKhach</p>
                </div>
            </div>

            @* ==========================================
         LƯỚI DỊCH VỤ
      ========================================== *@
            <div class="dv-grid">

                @* ==========================================
           DỊCH VỤ 1 — GIẶT SẤY
        ========================================== *@
                <div class="dv-card">
                    <div class="dv-accent tim"></div>
                    <div class="dv-card-header">
                        <div class="dv-header-left">
                            <div class="dv-icon-wrap tim"><i class="fas fa-tshirt"></i></div>
                            <div>
                                <h3>Giặt Sấy</h3>
                                <div class="sub">Giao nhận tại phòng · Xử lý trong ngày</div>
                            </div>
                        </div>
                        <div class="@gsBadgeClass" id="gs-badge">
                            @Html.Raw(gsBadgeHtml)
                        </div>
                        @if (Model.DonGiatSay != null && Model.DonGiatSay.NgayHetHan.HasValue
                             && Model.DonGiatSay.TrangThai_DV == "Chờ thanh toán")
                        {
                            var conHanGs = (Model.DonGiatSay.NgayHetHan.Value - DateTime.Now).Days;
                            <div class="han-tt-badge @(conHanGs <= 1 ? "han-do" : conHanGs <= 3 ? "han-cam" : "han-xanh")">
                                <i class="fas fa-clock"></i>
                                @(conHanGs > 0 ? $"Hạn thanh toán: còn {conHanGs} ngày ({Model.DonGiatSay.NgayHetHan.Value:dd/MM})"
                                               : "Đã quá hạn thanh toán — sẽ cộng vào hóa đơn tháng")
                            </div>
                        }
                    </div>

                    <div class="dv-card-body">
                        <div class="dv-desc-box" id="gs-desc">
                            <div class="dv-feature-row">
                                <i class="fas fa-clock" style="color:#7c3aed;"></i>
                                <span>Khung giờ giao nhận: <strong>7:00–8:30</strong> và <strong>18:00–20:00</strong></span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-soap" style="color:#7c3aed;"></i>
                                <span>Giặt thường, giặt sấy, ủi — giá theo kg</span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-money-bill-wave" style="color:#7c3aed;"></i>
                                <span>Quản lý báo giá sau khi nhận đồ</span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-calendar-check" style="color:#7c3aed;"></i>
                                <span>Nhận lại đồ sau 1–2 ngày làm việc</span>
                            </div>
                        </div>

                        <div class="dv-form-wrap" id="gs-form">
                            <div class="form-group">
                                <label class="form-label"><i class="fas fa-door-open"></i>Số phòng</label>
                                <input class="form-input disabled" type="text" id="gs-so-phong"
                                       value="@Model.SoPhong" readonly />
                            </div>

                            <div class="form-group">
                                <label class="form-label"><i class="fas fa-tshirt"></i>Loại dịch vụ</label>
                                <select class="form-input" id="gs-loai">
                                    <option value="">-- Chọn loại --</option>
                                    <option value="giat">Giặt thường</option>
                                    <option value="giat-say">Giặt + Sấy</option>
                                    <option value="giat-say-ui">Giặt + Sấy + Ủi</option>
                                </select>
                            </div>

                            <div>
                                <div class="form-label" style="margin-bottom:8px;">
                                    <i class="fas fa-info-circle" style="color:#7c3aed;"></i>
                                    Khung giờ giao nhận (cố định)
                                </div>
                                <div class="gs-info-grid">
                                    <div class="gs-info-item">
                                        <div class="gs-info-label">Buổi sáng</div>
                                        <div class="gs-info-val">7:00 – 8:30</div>
                                    </div>
                                    <div class="gs-info-item">
                                        <div class="gs-info-label">Buổi tối</div>
                                        <div class="gs-info-val">18:00 – 20:00</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label"><i class="fas fa-comment"></i>Ghi chú (tuỳ chọn)</label>
                                <textarea class="form-input" id="gs-ghi-chu" rows="2"
                                          placeholder="VD: 2 áo trắng cần giặt riêng..."></textarea>
                            </div>

                            <div class="waiting-box" id="gs-waiting">
                                <i class="fas fa-hourglass-half"></i>
                                <div class="wb-text">
                                    Đơn đã được gửi! Quản lý sẽ <strong>báo tổng tiền</strong> sau khi
                                    nhận và cân đồ của bạn. Vui lòng chờ thông báo.
                                </div>
                            </div>

                            <div class="gs-price-box" id="gs-price-box">
                                <div style="font-size:13px;font-weight:800;color:#065f46;display:flex;align-items:center;gap:7px;">
                                    <i class="fas fa-tag" style="color:#059669;"></i>
                                    Quản lý đã báo giá đơn giặt sấy
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <span style="font-size:12px;color:var(--mau-chu-phu);">Tổng tiền cần thanh toán</span>
                                    <span style="font-size:20px;font-weight:800;color:var(--mau-xanh-la);" id="gs-gia-tien">
                                        @(Model.DonGiatSay?.TongTien > 0
                                            ? Model.DonGiatSay.TongTien.ToString("N0") + " đ"
                                            : "— đ")
                                    </span>
                                </div>
                            </div>

                            @* Nút Thanh toán Giặt sấy — hiện sau khi quản lý báo giá *@
                            <button class="dv-btn-thanh-toan tim" id="gs-btn-thanh-toan"
                                    onclick="moThanhToanGS()"
                                    style="@(Model.DonGiatSay?.TrangThai_DV == "Chờ thanh toán" ? "display:flex;" : "display:none;")">
                                <i class="fas fa-qrcode"></i> Thanh toán Giặt Sấy
                            </button>

                            <div id="gs-btn-group" style="display:flex;flex-direction:column;gap:8px;">
                                <button class="dv-btn-submit tim" onclick="guiDonGS()">
                                    <i class="fas fa-paper-plane"></i> Đặt dịch vụ giặt sấy
                                </button>
                                <button class="dv-btn-cancel" onclick="dongFormGS()">
                                    <i class="fas fa-times"></i> Huỷ
                                </button>
                            </div>
                        </div>

                        @* ── Banner: Tiền GS đã cộng vào hóa đơn tháng ── *@
                        @if (Model.DonGiatSayCongVaoTro != null)
                        {
                            <div class="no-dv-banner" id="gs-no-dv-banner">
                                <div class="no-dv-banner-header">
                                    <div class="no-dv-banner-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                                    <div>
                                        <div class="no-dv-banner-title">Tiền chưa thanh toán đã cộng vào hóa đơn tháng</div>
                                        <div class="no-dv-banner-sub">
                                            Đơn giặt sấy quá hạn @((DateTime.Now - Model.DonGiatSayCongVaoTro.NgayTao).Days) ngày
                                            chưa thanh toán. Khoản này đã được gộp vào hóa đơn tháng của bạn.
                                        </div>
                                    </div>
                                </div>
                                <div class="no-dv-amount-row">
                                    <span class="no-dv-amount-label">Số tiền đã cộng vào hóa đơn</span>
                                    <span class="no-dv-amount-val">@Model.DonGiatSayCongVaoTro.TongTien.ToString("N0") đ</span>
                                </div>
                                <button class="btn-huy-no-dv" id="gs-btn-huy-no-dv"
                                        onclick="huyNoDV(@Model.DonGiatSayCongVaoTro.IDDonDV, 'gs')">
                                    <i class="fas fa-credit-card"></i>
                                    Thanh toán riêng — hủy khoản cộng vào hóa đơn
                                </button>
                            </div>
                        }

                        <button class="dv-btn-open tim" id="gs-btn-open" onclick="moFormGS()">
                            <i class="fas fa-plus-circle"></i> Đặt dịch vụ giặt sấy
                        </button>
                    </div>
                </div>
                @* -- kết thúc dịch vụ giặt sấy -- *@


                @* ==========================================
           DỊCH VỤ 2 — GIAO BÌNH NƯỚC
        ========================================== *@
                <div class="dv-card">
                    <div class="dv-accent cyan"></div>
                    <div class="dv-card-header">
                        <div class="dv-header-left">
                            <div class="dv-icon-wrap cyan"><i class="fas fa-tint"></i></div>
                            <div>
                                <h3>Giao Bình Nước</h3>
                                <div class="sub">Bình 20L · Giao tận phòng</div>
                            </div>
                        </div>
                        <div class="@nuocBadgeClass" id="nuoc-badge">
                            @Html.Raw(nuocBadgeHtml)
                        </div>
                    </div>
                    @if (Model.DonNuocBinh != null && Model.DonNuocBinh.NgayHetHan.HasValue
                         && Model.DonNuocBinh.TrangThai_DV == "Chờ thanh toán")
                    {
                        var conHanNuoc = (Model.DonNuocBinh.NgayHetHan.Value - DateTime.Now).Days;
                        <div class="han-tt-badge @(conHanNuoc <= 1 ? "han-do" : conHanNuoc <= 3 ? "han-cam" : "han-xanh")" style="margin: 0 22px 12px;">
                            <i class="fas fa-clock"></i>
                            @(conHanNuoc > 0 ? $"Hạn thanh toán: còn {conHanNuoc} ngày ({Model.DonNuocBinh.NgayHetHan.Value:dd/MM})"
                                             : "Đã quá hạn thanh toán — sẽ cộng vào hóa đơn tháng")
                        </div>
                    }

                    <div class="dv-card-body">
                        <div class="dv-desc-box cyan-bg" id="nuoc-desc">
                            <div class="dv-feature-row">
                                <i class="fas fa-water" style="color:#0891b2;"></i>
                                <span>Bình nước 20L tinh khiết — <strong>15,000 đ/bình</strong></span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-truck" style="color:#0891b2;"></i>
                                <span>Giao trong vòng 30–60 phút sau khi đặt</span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-check-circle" style="color:#0891b2;"></i>
                                <span>Xác nhận nhận hàng &amp; thanh toán trực tiếp</span>
                            </div>
                            <div class="dv-feature-row">
                                <i class="fas fa-redo" style="color:#0891b2;"></i>
                                <span>Trả vỏ bình cũ — giảm 5,000 đ/bình</span>
                            </div>
                        </div>

                        <div class="dv-form-wrap" id="nuoc-form">
                            <div class="form-group">
                                <label class="form-label"><i class="fas fa-door-open"></i>Số phòng</label>
                                <input class="form-input disabled" type="text" id="nuoc-so-phong"
                                       value="@Model.SoPhong" readonly />
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label"><i class="fas fa-sort-numeric-up"></i>Số lượng bình</label>
                                    <input class="form-input" type="number" id="nuoc-so-luong"
                                           min="1" max="10" value="1" oninput="tinhTienNuoc()" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"><i class="fas fa-redo"></i>Trả vỏ bình cũ</label>
                                    <select class="form-input" id="nuoc-tra-vo" onchange="tinhTienNuoc()">
                                        <option value="0">Không</option>
                                        <option value="1">Có (–5,000đ/bình)</option>
                                    </select>
                                </div>
                            </div>

                            <div style="background:#f0fdff;border:1.5px solid #a5f3fc;border-radius:12px;padding:12px 16px;
                                display:flex;justify-content:space-between;align-items:center;">
                                <span style="font-size:12px;font-weight:600;color:#164e63;">Dự tính tiền thanh toán</span>
                                <span style="font-size:18px;font-weight:800;color:#0891b2;" id="nuoc-du-tinh">15,000 đ</span>
                            </div>

                            <div class="form-group">
                                <label class="form-label"><i class="fas fa-comment"></i>Ghi chú (tuỳ chọn)</label>
                                <textarea class="form-input" id="nuoc-ghi-chu" rows="2"
                                          placeholder="VD: Để trước cửa phòng nếu không có nhà..."></textarea>
                            </div>

                            <div class="delivery-track" id="nuoc-track" style="display:none;">
                                <div class="dt-title"><i class="fas fa-shipping-fast"></i> Trạng thái giao hàng</div>
                                <div class="dt-steps" id="dt-steps-wrap">
                                    <div class="dt-progress-line" id="dt-progress" style="width:0%;"></div>
                                    <div class="dt-step done" id="dt-step-1">
                                        <div class="dt-dot"><i class="fas fa-check"></i></div>
                                        <div class="dt-lbl">Đã đặt</div>
                                    </div>
                                    <div class="dt-step" id="dt-step-2">
                                        <div class="dt-dot"><i class="fas fa-box"></i></div>
                                        <div class="dt-lbl">Đang chuẩn bị</div>
                                    </div>
                                    <div class="dt-step" id="dt-step-3">
                                        <div class="dt-dot"><i class="fas fa-truck"></i></div>
                                        <div class="dt-lbl">Đang giao</div>
                                    </div>
                                    <div class="dt-step" id="dt-step-4">
                                        <div class="dt-dot"><i class="fas fa-home"></i></div>
                                        <div class="dt-lbl">Đã giao</div>
                                    </div>
                                </div>
                            </div>

                            <div class="nuoc-confirm-box" id="nuoc-confirm">
                                <div class="ncb-title">
                                    <i class="fas fa-truck-loading" style="color:#059669;"></i>
                                    Quản lý đã giao bình nước đến phòng bạn!
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <span style="font-size:12px;color:#065f46;font-weight:600;">Tổng tiền thanh toán</span>
                                    <span class="ncb-amount" id="nuoc-tong-tien">
                                        @(Model.DonNuocBinh?.TongTien > 0
                                            ? Model.DonNuocBinh.TongTien.ToString("N0") + " đ"
                                            : "30,000 đ")
                                    </span>
                                </div>
                                <div style="display:flex;gap:8px;">
                                    <button class="btn-xac-nhan-hang" id="nuoc-btn-xac-nhan-nhan"
                                            onclick="xacNhanNhanNuoc()" style="flex:1;">
                                        <i class="fas fa-check-double"></i> Xác nhận đã nhận
                                    </button>
                                </div>
                                <div id="nuoc-cho-manager" style="display:none;align-items:center;gap:10px;
                                    background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;padding:12px 16px;">
                                    <i class="fas fa-hourglass-half" style="color:#1a56db;font-size:18px;flex-shrink:0;"></i>
                                    <div style="font-size:12.5px;color:#1e40af;font-weight:600;line-height:1.5;">
                                        Ảnh đã được gửi! <strong>Quản lý đang xem xét</strong> và sẽ xác nhận thanh toán sớm.
                                    </div>
                                </div>
                            </div>

                            @* Nút Thanh toán Bình Nước — hiện sau khi quản lý đã giao *@
