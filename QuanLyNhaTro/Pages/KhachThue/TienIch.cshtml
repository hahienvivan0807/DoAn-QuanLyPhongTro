@page "/KhachThue/TienIch"
@model QuanLyNhaTro.Pages.KhachThue.TienIchModel
@{
    ViewData["title"] = "Dịch Vụ & Tiện Ích";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tiện Ích – Nhà Trọ Bà Năm</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>

    /* =============================================
       BIẾN MÀU — đồng bộ KhachThue / ThanhToan
    ============================================= */
    :root {
      --mau-sidebar:        #0d1b3e;
      --mau-sidebar-dam:    #091429;
      --mau-chu-de:         #1a56db;
      --mau-chu-de-sang:    #3b82f6;
      --mau-nen:            #f0f4f8;
      --mau-trang:          #ffffff;
      --mau-chu:            #1e293b;
      --mau-chu-phu:        #64748b;
      --mau-vien:           #e2e8f0;
      --mau-xanh-nhat:      #eff6ff;
      --mau-xanh-trung:     #dbeafe;
      --mau-xanh-la:        #059669;
      --mau-xanh-la-nhat:   #d1fae5;
      --mau-cam:            #d97706;
      --mau-cam-nhat:       #fef3c7;
      --mau-do:             #dc2626;
      --mau-do-nhat:        #fee2e2;
      --mau-tim:            #7c3aed;
      --mau-tim-nhat:       #ede9fe;
      --mau-cyan:           #0891b2;
      --mau-cyan-nhat:      #cffafe;
      --bong-card:          0 4px 24px rgba(26,86,219,0.10);
      --bong-card-hover:    0 8px 32px rgba(26,86,219,0.18);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Be Vietnam Pro', 'Segoe UI', sans-serif;
      background: var(--mau-nen);
      color: var(--mau-chu);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* =============================================
       SIDEBAR — giống KhachThue.cshtml
    ============================================= */
    #thanh-sidebar {
      width: 220px; min-width: 220px;
      background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
      display: flex; flex-direction: column;
      height: 100vh; z-index: 100;
      box-shadow: 4px 0 24px rgba(0,0,0,0.18);
      overflow-y: auto; overflow-x: hidden;
      transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s;
      flex-shrink: 0;
    }
    #thanh-sidebar.an-sidebar { width: 0; min-width: 0; overflow: hidden; }

    .logo-sidebar {
      display: flex; align-items: center; gap: 12px;
      padding: 28px 20px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      white-space: nowrap;
    }
    .logo-sidebar .bieu-tuong {
      width: 42px; height: 42px;
      background: var(--mau-chu-de); border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; color: #fff; font-weight: 800; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(26,86,219,0.4);
    }
    .logo-sidebar .ten-logo strong { display: block; font-size: 15px; color: #fff; }
    .logo-sidebar .ten-logo span  { font-size: 11px; color: rgba(255,255,255,0.45); }

    .nhan-nhom {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.5px; color: rgba(255,255,255,0.3);
      text-transform: uppercase;
      padding: 18px 20px 6px; white-space: nowrap;
    }
    .menu-item {
      display: flex; align-items: center; gap: 13px;
      padding: 11px 20px; color: rgba(255,255,255,0.65);
      cursor: pointer; border-radius: 0 30px 30px 0;
      margin: 2px 10px 2px 0; transition: all 0.2s;
      font-size: 13.5px; font-weight: 600;
      text-decoration: none; position: relative; white-space: nowrap;
    }
    .menu-item i { width: 20px; text-align: center; font-size: 15px; flex-shrink: 0; }
    .menu-item:hover { background: rgba(59,130,246,0.15); color: #fff; }
    .menu-item.dang-chon {
      background: linear-gradient(90deg, rgba(26,86,219,0.85), rgba(59,130,246,0.6));
      color: #fff; font-weight: 700;
      box-shadow: 0 4px 16px rgba(26,86,219,0.3);
    }
    .menu-item.dang-chon::before {
      content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      height: 70%; width: 4px; background: #60a5fa; border-radius: 0 4px 4px 0;
    }
    .huy-hieu-menu {
      margin-left: auto; background: #ef4444; color: #fff;
      font-size: 10px; font-weight: 700; border-radius: 20px; padding: 1px 7px;
    }
    .sidebar-footer {
      margin-top: auto; padding: 18px 16px;
      border-top: 1px solid rgba(255,255,255,0.07);
      display: flex; align-items: center; gap: 10px; white-space: nowrap;
    }
    .sidebar-footer .anh-khach {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 800;
      border: 2px solid rgba(255,255,255,0.2); flex-shrink: 0;
      position: relative;
    }
    .sidebar-footer .anh-khach::after {
      content: ''; position: absolute; bottom: 1px; right: 1px;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #091429;
    }
    .sidebar-footer .ten-khach strong { display: block; color: #fff; font-size: 13px; }
    .sidebar-footer .ten-khach span  { color: rgba(255,255,255,0.45); font-size: 11px; }

    /* =============================================
       KHU VỰC CHÍNH
    ============================================= */
    #khu-vuc-chinh { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    #thanh-header {
      background: var(--mau-trang); padding: 0 28px; height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--mau-vien);
      box-shadow: 0 2px 8px rgba(0,0,0,0.05); flex-shrink: 0;
    }
    .header-trai { display: flex; align-items: center; gap: 16px; }
    .nut-ham-menu {
      background: none; border: none; cursor: pointer;
      font-size: 20px; color: var(--mau-chu-phu);
      padding: 6px; border-radius: 8px; transition: background 0.2s;
    }
    .nut-ham-menu:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .tieu-de-trang { font-size: 16px; font-weight: 800; }
    .duong-dan { font-size: 12px; color: var(--mau-chu-phu); }
    .duong-dan a { color: var(--mau-chu-de); text-decoration: none; font-weight: 600; }
    .header-phai { display: flex; align-items: center; gap: 14px; }
    .hdr-date {
      font-size: 12px; font-weight: 600; color: var(--mau-chu-phu);
      background: var(--mau-nen); padding: 6px 12px;
      border-radius: 20px; border: 1px solid var(--mau-vien);
    }
    .nut-thong-bao {
      position: relative; background: none; border: none;
      cursor: pointer; font-size: 18px; color: var(--mau-chu-phu);
      padding: 8px; border-radius: 50%; transition: all 0.2s;
    }
    .nut-thong-bao:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .so-thong-bao {
      position: absolute; top: 2px; right: 2px;
      background: #ef4444; color: #fff; font-size: 9px; font-weight: 700;
      border-radius: 50%; width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center; border: 2px solid #fff;
    }
    .thong-tin-khach {
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; padding: 6px 12px; border-radius: 24px; transition: background 0.2s;
    }
    .thong-tin-khach:hover { background: var(--mau-xanh-nhat); }
    .thong-tin-khach .anh-dai-dien {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 14px; font-weight: 800; position: relative;
    }
    .thong-tin-khach .anh-dai-dien::after {
      content: ''; position: absolute; bottom: 0; right: 0;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #fff;
    }
    .thong-tin-khach .ten     { font-size: 13px; font-weight: 700; }
    .thong-tin-khach .phong-so{ font-size: 11px; color: var(--mau-chu-phu); }

    /* =============================================
       NỘI DUNG CUỘN
    ============================================= */
    #noi-dung-chinh { flex: 1; overflow-y: auto; padding: 28px 32px; }

    .page-heading {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 24px;
    }
    .page-heading h2 {
      font-size: 22px; font-weight: 800; color: var(--mau-chu);
      display: flex; align-items: center; gap: 10px;
    }
    .page-heading h2 i { color: var(--mau-tim); font-size: 20px; }
    .page-heading p { font-size: 13px; color: var(--mau-chu-phu); margin-top: 4px; }

    /* =============================================
       LƯỚI 2 DỊCH VỤ
    ============================================= */
    .dv-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 24px; animation: fadeUp 0.4s ease both;
    }
    @@keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* =============================================
       CARD DỊCH VỤ
    ============================================= */
    .dv-card {
      background: var(--mau-trang); border-radius: 20px;
      border: 1px solid var(--mau-vien); box-shadow: var(--bong-card);
      overflow: hidden; display: flex; flex-direction: column;
      transition: box-shadow 0.25s;
    }
    .dv-card:hover { box-shadow: var(--bong-card-hover); }

    .dv-accent { height: 5px; border-radius: 20px 20px 0 0; }
    .dv-accent.tim   { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
    .dv-accent.cyan  { background: linear-gradient(90deg, #0891b2, #22d3ee); }

    .dv-card-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 22px 16px;
      border-bottom: 1px solid var(--mau-vien);
    }
    .dv-header-left { display: flex; align-items: center; gap: 12px; }
    .dv-icon-wrap {
      width: 46px; height: 46px; border-radius: 13px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; flex-shrink: 0;
    }
    .dv-icon-wrap.tim  { background: var(--mau-tim-nhat); color: var(--mau-tim); }
    .dv-icon-wrap.cyan { background: var(--mau-cyan-nhat); color: var(--mau-cyan); }
    .dv-card-header h3 { font-size: 15px; font-weight: 800; color: var(--mau-chu); }
    .dv-card-header .sub { font-size: 11.5px; color: var(--mau-chu-phu); margin-top: 2px; }

    /* Badge trạng thái đơn */
    .dv-status-badge {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 11px; font-weight: 700; padding: 5px 12px;
      border-radius: 20px;
    }
    .dsb-none    { background: #f1f5f9; color: #64748b; }
    .dsb-pending { background: var(--mau-cam-nhat); color: var(--mau-cam); }
    .dsb-active  { background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la); }
    .dsb-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor;
               box-shadow: 0 0 0 2px rgba(0,0,0,0.06); }

    .dv-card-body { padding: 20px 22px; flex: 1; display: flex; flex-direction: column; gap: 14px; }

    /* =============================================
       MÔ TẢ DỊCH VỤ (hiển thị khi chưa mở form)
    ============================================= */
    .dv-desc-box {
      background: #f8faff; border: 1.5px dashed #c7d2fe;
      border-radius: 14px; padding: 18px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .dv-desc-box.cyan-bg { background: #f0fdff; border-color: #a5f3fc; }

    .dv-feature-row {
      display: flex; align-items: center; gap: 10px;
      font-size: 12.5px; color: var(--mau-chu);
    }
    .dv-feature-row i { width: 22px; text-align: center; font-size: 14px; flex-shrink: 0; }

    /* Nút mở form */
    .dv-btn-open {
      width: 100%; padding: 13px;
      border: none; border-radius: 13px; cursor: pointer;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 14px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; gap: 9px;
      transition: all 0.22s; position: relative; overflow: hidden;
    }
    .dv-btn-open.tim {
      background: linear-gradient(135deg, #7c3aed, #a78bfa);
      color: #fff; box-shadow: 0 5px 18px rgba(124,58,237,0.35);
    }
    .dv-btn-open.tim:hover {
      transform: translateY(-2px); box-shadow: 0 8px 24px rgba(124,58,237,0.45);
    }
    .dv-btn-open.cyan {
      background: linear-gradient(135deg, #0891b2, #22d3ee);
      color: #fff; box-shadow: 0 5px 18px rgba(8,145,178,0.35);
    }
    .dv-btn-open.cyan:hover {
      transform: translateY(-2px); box-shadow: 0 8px 24px rgba(8,145,178,0.45);
    }

    /* =============================================
       FORM DỊCH VỤ (ẩn mặc định)
    ============================================= */
    .dv-form-wrap { display: none; flex-direction: column; gap: 14px; animation: slideDown 0.3s ease; }
    .dv-form-wrap.hien { display: flex; }
    @@keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Trường nhập */
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label {
      font-size: 12px; font-weight: 700; color: var(--mau-chu);
      display: flex; align-items: center; gap: 6px;
    }
    .form-label i { color: var(--mau-chu-phu); font-size: 11px; }
    .form-input {
      padding: 10px 14px; border: 1.5px solid var(--mau-vien);
      border-radius: 10px; font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 13px; color: var(--mau-chu);
      background: #fff; transition: border-color 0.18s, box-shadow 0.18s;
      width: 100%;
    }
    .form-input:focus {
      outline: none; border-color: var(--mau-chu-de);
      box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
    }
    .form-input.disabled { background: #f8faff; color: var(--mau-chu-phu); cursor: not-allowed; }

    /* 2 cột nhỏ */
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    /* Thông tin cố định giặt sấy */
    .gs-info-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    }
    .gs-info-item {
      background: var(--mau-tim-nhat); border-radius: 10px;
      padding: 10px 12px;
    }
    .gs-info-item.cyan-theme { background: var(--mau-cyan-nhat); }
    .gs-info-label { font-size: 10.5px; font-weight: 600; color: var(--mau-chu-phu); margin-bottom: 3px; }
    .gs-info-val   { font-size: 13px; font-weight: 800; color: var(--mau-chu); }

    /* Thanh trạng thái giao hàng */
    .delivery-track {
      background: #f8faff; border: 1.5px solid #e0f2fe;
      border-radius: 14px; padding: 16px;
    }
    .dt-title { font-size: 12px; font-weight: 700; color: var(--mau-chu); margin-bottom: 14px;
                display: flex; align-items: center; gap: 7px; }
    .dt-title i { color: var(--mau-cyan); }

    .dt-steps { display: flex; align-items: flex-start; position: relative; }
    .dt-steps::before {
      content: ''; position: absolute; top: 18px; left: 18px;
      right: 18px; height: 3px;
      background: #e2e8f0; border-radius: 2px; z-index: 0;
    }
    .dt-progress-line {
      position: absolute; top: 18px; left: 18px;
      height: 3px; background: linear-gradient(90deg, #0891b2, #22d3ee);
      border-radius: 2px; z-index: 1;
      transition: width 0.6s ease;
    }

    .dt-step {
      flex: 1; display: flex; flex-direction: column; align-items: center;
      gap: 7px; position: relative; z-index: 2;
    }
    .dt-dot {
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; border: 3px solid #e2e8f0;
      background: #fff; color: #94a3b8;
      transition: all 0.3s;
    }
    .dt-step.done .dt-dot   { border-color: var(--mau-cyan); background: var(--mau-cyan); color: #fff; }
    .dt-step.active .dt-dot { border-color: var(--mau-cyan); background: #fff; color: var(--mau-cyan);
                               box-shadow: 0 0 0 4px rgba(8,145,178,0.18); animation: pulse-cyan 1.8s infinite; }
    @@keyframes pulse-cyan {
      0%,100% { box-shadow: 0 0 0 4px rgba(8,145,178,0.18); }
      50%      { box-shadow: 0 0 0 8px rgba(8,145,178,0.06); }
    }
    .dt-lbl { font-size: 10.5px; font-weight: 700; color: var(--mau-chu-phu); text-align: center; line-height: 1.3; }
    .dt-step.done .dt-lbl, .dt-step.active .dt-lbl { color: var(--mau-cyan); }

    /* Khu vực xác nhận nhận hàng + thanh toán */
    .nuoc-confirm-box {
      background: var(--mau-xanh-la-nhat); border: 1.5px solid #6ee7b7;
      border-radius: 13px; padding: 14px 16px;
      display: none; flex-direction: column; gap: 12px;
      animation: fadeUp 0.3s ease;
    }
    .nuoc-confirm-box.hien { display: flex; }

    .ncb-title { font-size: 13px; font-weight: 800; color: #065f46;
                 display: flex; align-items: center; gap: 7px; }
    .ncb-amount { font-size: 20px; font-weight: 800; color: var(--mau-xanh-la); }

    /* Nút xác nhận nhận hàng */
    .btn-xac-nhan-hang {
      padding: 11px 18px; background: linear-gradient(135deg, #059669, #10b981);
      color: #fff; border: none; border-radius: 10px;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 13px; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; gap: 7px; transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(5,150,105,0.3);
    }
    .btn-xac-nhan-hang:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(5,150,105,0.4); }

    /* Thông báo chờ quản lý gửi tiền (giặt sấy) */
    .waiting-box {
      display: none; align-items: center; gap: 12px;
      background: var(--mau-cam-nhat); border: 1.5px solid #fcd34d;
      border-radius: 13px; padding: 14px 16px;
    }
    .waiting-box.hien { display: flex; }
    .waiting-box i { font-size: 22px; color: var(--mau-cam); flex-shrink: 0; }
    .wb-text { font-size: 12.5px; color: #92400e; font-weight: 600; line-height: 1.5; }
    .wb-text strong { color: var(--mau-cam); }

    /* Box giá gửi từ quản lý (giặt sấy) */
    .gs-price-box {
      display: none; flex-direction: column; gap: 12px;
      background: #f0fdf4; border: 1.5px solid #6ee7b7;
      border-radius: 13px; padding: 16px;
    }
    .gs-price-box.hien { display: flex; animation: fadeUp 0.3s ease; }

    /* Nút gửi form */
    .dv-btn-submit {
      width: 100%; padding: 13px;
      border: none; border-radius: 13px; cursor: pointer;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 14px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; gap: 9px;
      transition: all 0.22s;
    }
    .dv-btn-submit.tim {
      background: linear-gradient(135deg, #7c3aed, #a78bfa);
      color: #fff; box-shadow: 0 5px 18px rgba(124,58,237,0.3);
    }
    .dv-btn-submit.tim:hover { transform: translateY(-2px); }
    .dv-btn-submit.cyan {
      background: linear-gradient(135deg, #0891b2, #22d3ee);
      color: #fff; box-shadow: 0 5px 18px rgba(8,145,178,0.3);
    }
    .dv-btn-submit.cyan:hover { transform: translateY(-2px); }

    /* Nút huỷ form */
    .dv-btn-cancel {
      width: 100%; padding: 11px;
      background: #f1f5f9; color: #475569;
      border: 1.5px solid var(--mau-vien); border-radius: 13px;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 13px; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.18s;
    }
    .dv-btn-cancel:hover { background: var(--mau-vien); }

    /* =============================================
       MODAL THANH TOÁN (dùng chung / riêng lẻ)
    ============================================= */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(9,20,41,0.72);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity 0.28s ease;
    }
    .modal-overlay.hien { opacity: 1; pointer-events: auto; }

    .modal-box {
      background: #fff; border-radius: 24px;
      width: 100%; max-width: 460px; margin: 16px;
      box-shadow: 0 24px 64px rgba(9,20,41,0.35);
      overflow: hidden;
      transform: translateY(20px) scale(0.97);
      transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
    }
    .modal-overlay.hien .modal-box { transform: translateY(0) scale(1); }

    .modal-accent { height: 6px; }
    .modal-accent.xanh-la { background: linear-gradient(90deg, #059669, #34d399); }
    .modal-accent.chung   { background: linear-gradient(90deg, #7c3aed, #0891b2, #34d399); }

    .modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 22px 14px; border-bottom: 1px solid #f1f5f9;
    }
    .modal-header-left { display: flex; align-items: center; gap: 12px; }
    .modal-icon-badge {
      width: 42px; height: 42px; border-radius: 11px;
      display: flex; align-items: center; justify-content: center; font-size: 18px;
    }
    .modal-icon-badge.xanh-la { background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la); }
    .modal-icon-badge.chung   { background: var(--mau-tim-nhat); color: var(--mau-tim); }
    .modal-title { font-size: 15px; font-weight: 800; color: #1e293b; }
    .modal-sub   { font-size: 11.5px; color: #64748b; margin-top: 2px; }
    .modal-close {
      width: 32px; height: 32px; border-radius: 50%;
      background: #f1f5f9; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: #64748b; transition: all 0.18s;
    }
    .modal-close:hover { background: #fee2e2; color: #dc2626; }

    .modal-body { padding: 18px 22px; }

    .modal-amount-bar {
      display: flex; align-items: center; justify-content: space-between;
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      border: 1.5px solid #bfdbfe; border-radius: 14px;
      padding: 14px 18px; margin-bottom: 16px;
    }
    .modal-amount-label { font-size: 12px; font-weight: 600; color: #64748b; }
    .modal-amount-val   { font-size: 22px; font-weight: 800; color: #1a56db; letter-spacing: -0.5px; }
    .modal-wallet-icon {
      width: 42px; height: 42px; border-radius: 11px;
      background: linear-gradient(135deg, #1a56db, #3b82f6);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; color: #fff; box-shadow: 0 4px 12px rgba(26,86,219,0.3);
    }

    /* Chi tiết từng dịch vụ trong hoá đơn chung */
    .modal-dv-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
    .modal-dv-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 14px; border-radius: 10px; border: 1px solid var(--mau-vien);
    }
    .modal-dv-item.tim-bg  { background: #faf5ff; border-color: #ddd6fe; }
    .modal-dv-item.cyan-bg { background: #f0fdff; border-color: #a5f3fc; }
    .mdi-left { display: flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; }
    .mdi-left i { font-size: 14px; }
    .mdi-price { font-size: 14px; font-weight: 800; color: var(--mau-chu); }

    /* QR section trong modal */
    .qr-section {
      background: #f8faff; border: 2px solid #e2e8f0;
      border-radius: 16px; padding: 16px; text-align: center; margin-bottom: 14px;
    }
    #modal-qr-img {
      width: 160px; height: 160px; object-fit: contain;
      border-radius: 8px; display: block; margin: 0 auto 10px;
    }
    .qr-fallback {
      width: 160px; height: 160px; border-radius: 8px;
      border: 2px dashed #bfdbfe; background: #f8faff;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      margin: 0 auto 10px; gap: 6px;
      font-size: 12px; font-weight: 600; color: #94a3b8;
    }
    .qr-bank-rows { display: flex; flex-direction: column; gap: 5px; }
    .qr-br { display: flex; justify-content: space-between; font-size: 12px; }
    .qr-br .lbl { color: #64748b; }
    .qr-br .val { font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 5px; }
    .copy-btn {
      background: none; border: none; cursor: pointer;
      font-size: 11px; color: #1a56db; padding: 1px 5px;
      border-radius: 5px; transition: background 0.15s;
    }
    .copy-btn:hover { background: #eff6ff; }

    .noi-dung-ck {
      display: flex; align-items: center; justify-content: space-between;
      background: #fefce8; border: 1px solid #fde68a;
      border-radius: 10px; padding: 10px 14px; margin-bottom: 10px;
      font-size: 12.5px;
    }
    .noi-dung-ck .nd-label { color: #92400e; font-weight: 600; }
    .noi-dung-ck .nd-val   { font-weight: 800; color: #b45309; }

    /* Upload bill trong modal */
    .upload-zone {
      border: 2px dashed #bfdbfe; border-radius: 12px;
      background: #f8faff; padding: 16px; text-align: center;
      cursor: pointer; transition: all 0.22s; position: relative; margin-bottom: 14px;
    }
    .upload-zone:hover { border-color: #1a56db; }
    .upload-zone.drag-over { border-color: #1a56db; background: #eff6ff; transform: scale(1.01); }
    .upload-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .upload-icon  { font-size: 28px; color: #93c5fd; display: block; margin-bottom: 6px; }
    .upload-title { font-size: 12.5px; font-weight: 700; color: var(--mau-chu); margin-bottom: 3px; }
    .upload-hint  { font-size: 11px; color: var(--mau-chu-phu); }
    .upload-hint span { color: var(--mau-chu-de); font-weight: 700; }
    .upload-preview { display: none; position: relative; }
    .upload-preview img {
      width: 100%; max-height: 140px; object-fit: cover;
      border-radius: 8px; border: 1.5px solid var(--mau-vien); display: block;
    }
    .btn-remove-img {
      position: absolute; top: 5px; right: 5px;
      background: rgba(220,38,38,0.9); color: #fff; border: none;
      border-radius: 50%; width: 26px; height: 26px; font-size: 11px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .upload-fname { font-size: 11px; color: var(--mau-chu-phu); margin-top: 5px; font-style: italic; }

    .modal-footer { padding: 0 22px 22px; display: flex; gap: 10px; }
    .btn-modal-huy {
      flex: 1; padding: 12px; background: #f1f5f9; color: #475569;
      border: 1.5px solid #e2e8f0; border-radius: 12px;
      font-family: 'Be Vietnam Pro', sans-serif; font-size: 13.5px; font-weight: 700;
      cursor: pointer; transition: background 0.18s;
    }
    .btn-modal-huy:hover { background: #e2e8f0; }
    .btn-modal-gui {
      flex: 2; padding: 12px;
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Be Vietnam Pro', sans-serif; font-size: 13.5px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 4px 14px rgba(5,150,105,0.3); transition: all 0.18s;
      opacity: 0.45; pointer-events: none;
    }
    .btn-modal-gui.active { opacity: 1; pointer-events: auto; }
    .btn-modal-gui.active:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(5,150,105,0.4); }

    /* Trạng thái thành công */
    .modal-success {
      display: none; flex-direction: column; align-items: center;
      text-align: center; gap: 10px; padding: 32px 24px;
    }
    .modal-success.hien { display: flex; animation: fadeUp 0.4s ease; }
    .success-icon { font-size: 52px; color: #059669; animation: bounce-in 0.5s ease; }
    @@keyframes bounce-in {
      0%  { transform: scale(0); }
      70% { transform: scale(1.15); }
      100%{ transform: scale(1); }
    }
    .modal-success h4 { font-size: 17px; font-weight: 800; }
    .modal-success p  { font-size: 12.5px; color: var(--mau-chu-phu); line-height: 1.7; }
    .btn-ve-trang {
      margin-top: 6px; padding: 10px 24px;
      background: var(--mau-xanh-nhat); color: var(--mau-chu-de);
      border: 1.5px solid var(--mau-xanh-trung); border-radius: 10px;
      font-family: 'Be Vietnam Pro', sans-serif; font-size: 13px; font-weight: 700;
      cursor: pointer; transition: background 0.2s;
    }
    .btn-ve-trang:hover { background: var(--mau-xanh-trung); }

    /* =============================================
       THANH TOÁN THỐNG NHẤT (tt-bar)
    ============================================= */
    .tt-bar {
      margin-top: 24px;
      background: var(--mau-trang);
      border: 1.5px solid var(--mau-vien);
      border-radius: 18px;
      padding: 16px 22px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      box-shadow: 0 6px 28px rgba(26,86,219,0.10);
      animation: fadeUp 0.35s ease;
    }
    .tt-bar-left  { display: flex; align-items: center; gap: 14px; }
    .tt-bar-icon  {
      width: 46px; height: 46px; border-radius: 13px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 20px;
      background: linear-gradient(135deg, #1a56db, #3b82f6); color: #fff;
      box-shadow: 0 4px 14px rgba(26,86,219,0.30);
    }
    .tt-bar-icon.gop {
      background: linear-gradient(135deg, #7c3aed, #0891b2);
    }
    .tt-bar-label {
      font-size: 14px; font-weight: 800; color: var(--mau-chu);
    }
    .tt-bar-breakdown {
      font-size: 11.5px; color: var(--mau-chu-phu); margin-top: 3px;
    }
    .tt-bar-right { display: flex; align-items: center; gap: 18px; flex-shrink: 0; }
    .tt-bar-total {
      font-size: 22px; font-weight: 800; color: var(--mau-chu-de); letter-spacing: -0.5px;
    }
    .tt-bar-btn {
      padding: 11px 22px;
      background: linear-gradient(135deg, #1a56db, #3b82f6);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Be Vietnam Pro', sans-serif; font-size: 14px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; gap: 8px;
      box-shadow: 0 5px 18px rgba(26,86,219,0.30); transition: all 0.22s;
      white-space: nowrap;
    }
    .tt-bar-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26,86,219,0.40); }

    /* Scrollbar
    ============================================= */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }

    /* =============================================
       RESPONSIVE
    ============================================= */
    @@media (max-width: 1000px) { .dv-grid { grid-template-columns: 1fr; } }
    @@media (max-width: 768px) {
      #thanh-sidebar { width: 0; min-width: 0; }
      #noi-dung-chinh { padding: 16px; }
    }

  </style>
</head>
<body>

  @* =============================================
     SIDEBAR
  ============================================= *@
  <nav id="thanh-sidebar">
    <div class="logo-sidebar">
      <div class="bieu-tuong">A</div>
      <div class="ten-logo">
        <strong>NHÀ TRỌ ABC</strong>
        <span>Cổng khách thuê</span>
      </div>
    </div>

    <div class="nhan-nhom">Tổng quan</div>
    <a href="/KhachThue/KhachThue" class="menu-item">
      <i class="fas fa-home"></i><span>Trang chủ</span>
    </a>

    <div class="nhan-nhom">Dịch vụ</div>
    <a href="/KhachThue/ThanhToan" class="menu-item">
      <i class="fas fa-credit-card"></i><span>Thanh toán</span>
    </a>
    <a href="/KhachThue/TienIch" class="menu-item dang-chon">
      <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
    </a>
    <a href="/KhachThue/BaoSuCo" class="menu-item">
      <i class="fas fa-tools"></i><span>Báo sự cố</span>
    </a>

    <div class="nhan-nhom">Cá nhân</div>
    <a href="/KhachThue/ThongBao" class="menu-item">
      <i class="fas fa-bell"></i><span>Thông báo</span>
      <span class="huy-hieu-menu">4</span>
    </a>
    <a href="/KhachThue/HoSo" class="menu-item">
      <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
    </a>
    <a href="/KhachThue/CaiDat" class="menu-item">
      <i class="fas fa-cog"></i><span>Cài đặt</span>
    </a>

    <div class="sidebar-footer">
      <div class="anh-khach">T</div>
      <div class="ten-khach">
        <strong>Trần Duy Hơn</strong>
        <span>Phòng 201 · Tầng 2</span>
      </div>
    </div>
  </nav>

  @* =============================================
     KHU VỰC CHÍNH
  ============================================= *@
  <div id="khu-vuc-chinh">

    <header id="thanh-header">
      <div class="header-trai">
        <button class="nut-ham-menu" onclick="dongMoSidebar()" aria-label="Toggle menu">
          <i class="fas fa-bars"></i>
        </button>
        <div>
          <div class="tieu-de-trang">Dịch Vụ &amp; Tiện Ích</div>
          <div class="duong-dan">
            <a href="/KhachThue/KhachThue">Trang chủ</a>
            &nbsp;/&nbsp; Tiện ích
          </div>
        </div>
      </div>
      <div class="header-phai">
        <div class="hdr-date" id="headerDate"></div>
        <button class="nut-thong-bao" aria-label="Thông báo">
          <i class="fas fa-bell"></i>
          <span class="so-thong-bao">4</span>
        </button>
        <div class="thong-tin-khach">
          <div class="anh-dai-dien">T</div>
          <div>
            <div class="ten">Trần Duy Hơn</div>
            <div class="phong-so">Phòng 201</div>
          </div>
          <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
        </div>
      </div>
    </header>

    <main id="noi-dung-chinh">

      <div class="page-heading">
        <div>
          <h2><i class="fas fa-concierge-bell"></i> Dịch vụ &amp; Tiện ích</h2>
          <p>Đặt dịch vụ tiện ích ngay tại trang — Phòng 201 &nbsp;·&nbsp; Trần Duy Hơn</p>
        </div>
      </div>

      @* ==========================================
         LƯỚI 2 DỊCH VỤ NẰM KẾ NHAU
      ========================================== *@
      <div class="dv-grid">

        @* ==========================================
           DỊCH VỤ 1 — GIẶT SẤY
        ========================================== *@
        <div class="dv-card">
          <div class="dv-accent tim"></div>
          <div class="dv-card-header">
            <div class="dv-header-left">
              <div class="dv-icon-wrap tim"><i class="fas fa-tshirt"></i></div>
              <div>
                <h3>Giặt Sấy</h3>
                <div class="sub">Giao nhận tại phòng · Xử lý trong ngày</div>
              </div>
            </div>
            <div class="dv-status-badge dsb-none" id="gs-badge">
              <span class="dsb-dot"></span>Chưa đặt
            </div>
          </div>

          <div class="dv-card-body">

            @* Mô tả hiển thị trước khi mở form *@
            <div class="dv-desc-box" id="gs-desc">
              <div class="dv-feature-row">
                <i class="fas fa-clock" style="color:#7c3aed;"></i>
                <span>Khung giờ giao nhận: <strong>7:00–8:30</strong> và <strong>18:00–20:00</strong></span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-soap" style="color:#7c3aed;"></i>
                <span>Giặt thường, giặt sấy, ủi — giá theo kg</span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-money-bill-wave" style="color:#7c3aed;"></i>
                <span>Quản lý báo giá sau khi nhận đồ</span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-calendar-check" style="color:#7c3aed;"></i>
                <span>Nhận lại đồ sau 1–2 ngày làm việc</span>
              </div>
            </div>

            @* Form đặt giặt sấy (ẩn mặc định) *@
            <div class="dv-form-wrap" id="gs-form">

              @* Số phòng (readonly — bind từ SQL: @Model.SoPhong) *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-door-open"></i>Số phòng</label>
                @* TODO: value="@Model.SoPhong" *@
                <input class="form-input disabled" type="text" id="gs-so-phong"
                       value="Phòng 201" readonly />
              </div>

              @* Loại dịch vụ *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-tshirt"></i>Loại dịch vụ</label>
                <select class="form-input" id="gs-loai">
                  <option value="">-- Chọn loại --</option>
                  <option value="giat">Giặt thường</option>
                  <option value="giat-say">Giặt + Sấy</option>
                  <option value="giat-say-ui">Giặt + Sấy + Ủi</option>
                </select>
              </div>

              @* Thông tin cố định giờ giao nhận *@
              <div>
                <div class="form-label" style="margin-bottom:8px;">
                  <i class="fas fa-info-circle" style="color:#7c3aed;"></i>
                  Khung giờ giao nhận (cố định)
                </div>
                <div class="gs-info-grid">
                  <div class="gs-info-item">
                    <div class="gs-info-label">🌅 Buổi sáng</div>
                    <div class="gs-info-val">7:00 – 8:30</div>
                  </div>
                  <div class="gs-info-item">
                    <div class="gs-info-label">🌆 Buổi tối</div>
                    <div class="gs-info-val">18:00 – 20:00</div>
                  </div>
                </div>
              </div>

              @* Khách thuê chọn khung giờ nhận lại đồ *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-clock"></i>Bạn muốn nhận lại đồ vào khung giờ nào?</label>
                <select class="form-input" id="gs-khung-gio">
                  <option value="">-- Chọn khung giờ --</option>
                  <option value="sang">Buổi sáng (7:00 – 8:30)</option>
                  <option value="toi">Buổi tối (18:00 – 20:00)</option>
                </select>
              </div>

              @* Ngày nhận lại *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-calendar-alt"></i>Ngày nhận lại đồ</label>
                <input class="form-input" type="date" id="gs-ngay-nhan" />
              </div>

              @* Ghi chú *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-comment"></i>Ghi chú (tuỳ chọn)</label>
                <textarea class="form-input" id="gs-ghi-chu" rows="2"
                          placeholder="VD: 2 áo trắng cần giặt riêng..."></textarea>
              </div>

              @* Thông báo chờ quản lý báo giá *@
              <div class="waiting-box" id="gs-waiting">
                <i class="fas fa-hourglass-half"></i>
                <div class="wb-text">
                  Đơn đã được gửi! Quản lý sẽ <strong>báo tổng tiền</strong> sau khi
                  nhận và cân đồ của bạn. Vui lòng chờ thông báo.
                </div>
              </div>

              @* Box hiện khi quản lý gửi giá — JS toggle khi nhận từ API *@
              <div class="gs-price-box" id="gs-price-box">
                <div style="font-size:13px;font-weight:800;color:#065f46;display:flex;align-items:center;gap:7px;">
                  <i class="fas fa-tag" style="color:#059669;"></i>
                  Quản lý đã báo giá đơn giặt sấy
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:12px;color:var(--mau-chu-phu);">Tổng tiền cần thanh toán</span>
                  <span style="font-size:20px;font-weight:800;color:var(--mau-xanh-la);" id="gs-gia-tien">— đ</span>
                </div>
              </div>

              @* Nút gửi đơn + huỷ *@
              <div id="gs-btn-group" style="display:flex;flex-direction:column;gap:8px;">
                <button class="dv-btn-submit tim" onclick="guiDonGS()">
                  <i class="fas fa-paper-plane"></i> Đặt dịch vụ giặt sấy
                </button>
                <button class="dv-btn-cancel" onclick="dongFormGS()">
                  <i class="fas fa-times"></i> Huỷ
                </button>
              </div>

            </div>
            @* -- kết thúc gs-form -- *@

            @* Nút mở form (ẩn khi form mở) *@
            <button class="dv-btn-open tim" id="gs-btn-open" onclick="moFormGS()">
              <i class="fas fa-plus-circle"></i> Đặt dịch vụ giặt sấy
            </button>

          </div>
        </div>
        @* -- kết thúc dịch vụ giặt sấy -- *@


        @* ==========================================
           DỊCH VỤ 2 — GIAO BÌNH NƯỚC
        ========================================== *@
        <div class="dv-card">
          <div class="dv-accent cyan"></div>
          <div class="dv-card-header">
            <div class="dv-header-left">
              <div class="dv-icon-wrap cyan"><i class="fas fa-tint"></i></div>
              <div>
                <h3>Giao Bình Nước</h3>
                <div class="sub">Bình 20L · Giao tận phòng</div>
              </div>
            </div>
            <div class="dv-status-badge dsb-none" id="nuoc-badge">
              <span class="dsb-dot"></span>Chưa đặt
            </div>
          </div>

          <div class="dv-card-body">

            @* Mô tả *@
            <div class="dv-desc-box cyan-bg" id="nuoc-desc">
              <div class="dv-feature-row">
                <i class="fas fa-water" style="color:#0891b2;"></i>
                <span>Bình nước 20L tinh khiết — <strong>30,000 đ/bình</strong></span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-truck" style="color:#0891b2;"></i>
                <span>Giao trong vòng 30–60 phút sau khi đặt</span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-check-circle" style="color:#0891b2;"></i>
                <span>Xác nhận nhận hàng &amp; thanh toán trực tiếp</span>
              </div>
              <div class="dv-feature-row">
                <i class="fas fa-redo" style="color:#0891b2;"></i>
                <span>Trả vỏ bình cũ — giảm 5,000 đ/bình</span>
              </div>
            </div>

            @* Form đặt nước (ẩn mặc định) *@
            <div class="dv-form-wrap" id="nuoc-form">

              @* Số phòng (readonly) *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-door-open"></i>Số phòng</label>
                @* TODO: value="@Model.SoPhong" *@
                <input class="form-input disabled" type="text" id="nuoc-so-phong"
                       value="Phòng 201" readonly />
              </div>

              @* Số lượng bình *@
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label"><i class="fas fa-sort-numeric-up"></i>Số lượng bình</label>
                  <input class="form-input" type="number" id="nuoc-so-luong"
                         min="1" max="10" value="1" oninput="tinhTienNuoc()" />
                </div>
                <div class="form-group">
                  <label class="form-label"><i class="fas fa-redo"></i>Trả vỏ bình cũ</label>
                  <select class="form-input" id="nuoc-tra-vo" onchange="tinhTienNuoc()">
                    <option value="0">Không</option>
                    <option value="1">Có (–5,000đ/bình)</option>
                  </select>
                </div>
              </div>

              @* Dự tính tiền *@
              <div style="background:#f0fdff;border:1.5px solid #a5f3fc;border-radius:12px;padding:12px 16px;
                          display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:12px;font-weight:600;color:#164e63;">Dự tính tiền thanh toán</span>
                <span style="font-size:18px;font-weight:800;color:#0891b2;" id="nuoc-du-tinh">30,000 đ</span>
              </div>

              @* Ghi chú *@
              <div class="form-group">
                <label class="form-label"><i class="fas fa-comment"></i>Ghi chú (tuỳ chọn)</label>
                <textarea class="form-input" id="nuoc-ghi-chu" rows="2"
                          placeholder="VD: Để trước cửa phòng nếu không có nhà..."></textarea>
              </div>

              @* Thanh trạng thái giao hàng (ẩn trước khi đặt) *@
              <div class="delivery-track" id="nuoc-track" style="display:none;">
                <div class="dt-title"><i class="fas fa-shipping-fast"></i> Trạng thái giao hàng</div>
                <div class="dt-steps" id="dt-steps-wrap">
                  <div class="dt-progress-line" id="dt-progress" style="width:0%;"></div>
                  <div class="dt-step done" id="dt-step-1">
                    <div class="dt-dot"><i class="fas fa-check"></i></div>
                    <div class="dt-lbl">Đã đặt</div>
                  </div>
                  <div class="dt-step" id="dt-step-2">
                    <div class="dt-dot"><i class="fas fa-box"></i></div>
                    <div class="dt-lbl">Đang chuẩn bị</div>
                  </div>
                  <div class="dt-step" id="dt-step-3">
                    <div class="dt-dot"><i class="fas fa-truck"></i></div>
                    <div class="dt-lbl">Đang giao</div>
                  </div>
                  <div class="dt-step" id="dt-step-4">
                    <div class="dt-dot"><i class="fas fa-home"></i></div>
                    <div class="dt-lbl">Đã giao</div>
                  </div>
                </div>
              </div>

              @* Khu xác nhận nhận hàng + thanh toán *@
              <div class="nuoc-confirm-box" id="nuoc-confirm">
                <div class="ncb-title">
                  <i class="fas fa-truck-loading" style="color:#059669;"></i>
                  Quản lý đã giao bình nước đến phòng bạn!
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:12px;color:#065f46;font-weight:600;">Tổng tiền thanh toán</span>
                  <span class="ncb-amount" id="nuoc-tong-tien">30,000 đ</span>
                </div>
                <div style="display:flex;gap:8px;">
                  <button class="btn-xac-nhan-hang" onclick="xacNhanNhanNuoc()" style="flex:1;">
                    <i class="fas fa-check-double"></i> Xác nhận đã nhận
                  </button>
                </div>
              </div>

              @* Nhóm nút gửi + huỷ *@
              <div id="nuoc-btn-group" style="display:flex;flex-direction:column;gap:8px;">
                <button class="dv-btn-submit cyan" onclick="guiDonNuoc()">
                  <i class="fas fa-paper-plane"></i> Đặt bình nước
                </button>
                <button class="dv-btn-cancel" onclick="dongFormNuoc()">
                  <i class="fas fa-times"></i> Huỷ
                </button>
              </div>

            </div>
            @* -- kết thúc nuoc-form -- *@

            @* Nút mở form *@
            <button class="dv-btn-open cyan" id="nuoc-btn-open" onclick="moFormNuoc()">
              <i class="fas fa-plus-circle"></i> Đặt bình nước
            </button>

          </div>
        </div>
        @* -- kết thúc dịch vụ nước -- *@

      </div>
      @* -- kết thúc dv-grid -- *@

      @* ==========================================
         THANH TOÁN THỐNG NHẤT — hiển thị khi có ≥1 dịch vụ cần TT
      ========================================== *@
      <div class="tt-bar" id="tt-bar" style="display:none;">
        <div class="tt-bar-left">
          <div class="tt-bar-icon" id="tt-bar-icon">
            <i class="fas fa-credit-card"></i>
          </div>
          <div>
            <div class="tt-bar-label" id="tt-bar-label">Thanh toán dịch vụ</div>
            <div class="tt-bar-breakdown" id="tt-bar-breakdown"></div>
          </div>
        </div>
        <div class="tt-bar-right">
          <div class="tt-bar-total" id="tt-bar-total">0 đ</div>
          <button class="tt-bar-btn" id="tt-bar-btn" onclick="moThanhToanTongHop()">
            <i class="fas fa-arrow-right"></i> Thanh toán ngay
          </button>
        </div>
      </div>

    </main>
  </div>


  @* =============================================
     MODAL THANH TOÁN
     - thanh-toan-le  : thanh toán riêng lẻ 1 dịch vụ
     - thanh-toan-chung: thanh toán gộp 2 dịch vụ cùng lúc
  ============================================= *@
  <div class="modal-overlay" id="modal-overlay" onclick="dongModalNeuNgoai(event)">
    <div class="modal-box" role="dialog" aria-modal="true">

      <div class="modal-accent" id="modal-accent"></div>

      <div class="modal-header">
        <div class="modal-header-left">
          <div class="modal-icon-badge" id="modal-icon-badge">
            <i class="fas fa-credit-card"></i>
          </div>
          <div>
            <div class="modal-title" id="modal-title">Thanh toán</div>
            <div class="modal-sub"  id="modal-sub">Xác nhận &amp; chuyển khoản</div>
          </div>
        </div>
        <button class="modal-close" onclick="dongModal()"><i class="fas fa-times"></i></button>
      </div>

      @* --- Nội dung thanh toán (ẩn khi thành công) --- *@
      <div id="modal-pay-body">
        <div class="modal-body">

          @* Số tiền *@
          <div class="modal-amount-bar">
            <div>
              <div class="modal-amount-label">Tổng tiền cần thanh toán</div>
              <div class="modal-amount-val" id="modal-tong-tien">—</div>
            </div>
            <div class="modal-wallet-icon"><i class="fas fa-wallet"></i></div>
          </div>

          @* Chi tiết từng dịch vụ (chỉ hiện khi gộp 2) *@
          <div class="modal-dv-list" id="modal-dv-list" style="display:none;">
            <div class="modal-dv-item tim-bg">
              <div class="mdi-left" style="color:#7c3aed;">
                <i class="fas fa-tshirt"></i> Giặt Sấy
              </div>
              <div class="mdi-price" id="modal-gs-price">—</div>
            </div>
            <div class="modal-dv-item cyan-bg">
              <div class="mdi-left" style="color:#0891b2;">
                <i class="fas fa-tint"></i> Bình Nước
              </div>
              <div class="mdi-price" id="modal-nuoc-price">—</div>
            </div>
          </div>

          @* QR code *@
          <div class="qr-section">
            <img id="modal-qr-img" src="" alt="Mã QR chuyển khoản"
                 onerror="this.style.display='none';document.getElementById('qr-fallback-box').style.display='flex';" />
            <div id="qr-fallback-box" class="qr-fallback">
              <i class="fas fa-image" style="font-size:32px;color:#bfdbfe;"></i>
              Chờ kết nối dữ liệu
            </div>
            <div class="qr-bank-rows">
              <div class="qr-br">
                <span class="lbl">Ngân hàng</span>
                <span class="val" id="qr-ngan-hang">— —</span>
              </div>
              <div class="qr-br">
                <span class="lbl">Số tài khoản</span>
                <span class="val">
                  <span id="qr-so-tk">— — — —</span>
                  <button class="copy-btn" onclick="saoChep('qr-so-tk')"><i class="fas fa-copy"></i></button>
                </span>
              </div>
              <div class="qr-br">
                <span class="lbl">Chủ tài khoản</span>
                <span class="val" id="qr-chu-tk">— — — —</span>
              </div>
            </div>
          </div>

          @* Nội dung CK *@
          <div class="noi-dung-ck">
            <div>
              <div class="nd-label">Nội dung chuyển khoản</div>
              <div class="nd-val" id="modal-nd-ck">P201 TIEN ICH</div>
            </div>
            <button class="copy-btn" onclick="saoChep('modal-nd-ck')"><i class="fas fa-copy"></i></button>
          </div>

          @* Upload bill *@
          <div class="upload-zone" id="modal-upload-zone"
               ondragover="upDragOver(event)" ondragleave="upDragLeave(event)" ondrop="upDrop(event)"
               onclick="document.getElementById('modal-file-input').click()">
            <input type="file" class="upload-input" id="modal-file-input"
                   accept="image/*" onchange="upFileChosen(this)" />
            <div id="modal-upload-prompt">
              <i class="fas fa-cloud-upload-alt upload-icon"></i>
              <div class="upload-title">Tải ảnh bill chuyển khoản lên</div>
              <div class="upload-hint">Kéo thả hoặc <span>nhấn để chọn</span> · JPG, PNG – tối đa 10MB</div>
            </div>
            <div class="upload-preview" id="modal-preview">
              <img src="" alt="Preview bill" id="modal-preview-img" />
              <button class="btn-remove-img" type="button" onclick="upXoaAnh(event)">
                <i class="fas fa-times"></i>
              </button>
              <div class="upload-fname" id="modal-fname"></div>
            </div>
          </div>

        </div>

        <div class="modal-footer">
          <button class="btn-modal-huy" onclick="dongModal()">
            <i class="fas fa-arrow-left" style="margin-right:5px;"></i>Quay lại
          </button>
          <button class="btn-modal-gui active" id="modal-btn-gui" onclick="guiXacNhan()">
            <i class="fas fa-paper-plane"></i> Gửi xác nhận thanh toán
          </button>
        </div>
      </div>

      @* Trạng thái thành công *@
      <div class="modal-success" id="modal-success">
        <div class="success-icon"><i class="fas fa-check-circle"></i></div>
        <h4>Thanh toán đã được xác nhận!</h4>
        <p>
          Cảm ơn bạn đã sử dụng dịch vụ.<br />
          Đơn sẽ được xác nhận trong vòng <strong>15 phút</strong>.
        </p>
        <button class="btn-ve-trang" onclick="dongModal()">
          <i class="fas fa-arrow-left" style="margin-right:6px;"></i>Tiếp tục
        </button>
      </div>

    </div>
  </div>


  @* =============================================
     JAVASCRIPT
  ============================================= *@
  <script src="~/js/Khach/DichVu.js"></script>

</body>
</html>
