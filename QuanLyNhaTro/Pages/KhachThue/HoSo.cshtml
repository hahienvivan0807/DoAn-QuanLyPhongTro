<!-- =============================================
     JAVASCRIPT – LOGIC TRANG HỒ SƠ
============================================= -->
<script>
  // -------- Ngày giờ header --------
  function capNhatNgayGio() {
    const days = ['CN','T2','T3','T4','T5','T6','T7'];
    const now = new Date();
    const dd = String(now.getDate()).padStart(2,'0');
    const mm = String(now.getMonth()+1).padStart(2,'0');
    const yy = now.getFullYear();
    document.getElementById('headerDate').textContent =
      `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;
  }
  capNhatNgayGio();

  // -------- Toggle sidebar --------
  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
  }

  // -------- Chuyển trang --------
  function chuyenTrang(tenTrang, phanTu) {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
    if (phanTu) phanTu.classList.add('dang-chon');
    const bang = {
      'trang-chu':  '/KhachThue/KhachThue',
      'thanh-toan': '/KhachThue/ThanhToan',
      'tien-ich':   '/KhachThue/TienIch',
      'bao-su-co':  '/KhachThue/BaoSuCo',
      'thong-bao':  '/KhachThue/ThongBao',
      'ho-so':      '/KhachThue/HoSo',
      'cai-dat':    '/KhachThue/CaiDat',
    };
    if (bang[tenTrang]) window.location.href = bang[tenTrang];
  }

  // -------- Mở modal xác nhận lưu --------
  function moXacNhanLuu() {
    // Kiểm tra trường bắt buộc trước khi mở modal
    const hoTen = document.getElementById('truong-ho-ten').value.trim();
    const sdt   = document.getElementById('truong-sdt').value.trim();
    if (!hoTen || !sdt) {
      hienToast('⚠️ Vui lòng điền đầy đủ họ tên và số điện thoại!', false);
      return;
    }
    document.getElementById('modal-xac-nhan-luu').classList.add('hien');
  }

  // -------- Xử lý lưu hồ sơ (gọi API/Form post sau này) --------
  function luuHoSo() {
    dongModal('modal-xac-nhan-luu');
    // TODO: gọi Model.OnPostAsync() hoặc fetch('/KhachThue/HoSo', { method:'POST', body:... })
    hienToast('✅ Hồ sơ đã được lưu thành công!', true);
  }

  // -------- Toast thông báo --------
  function hienToast(noiDung, thanhCong) {
    const toast = document.getElementById('toast-luu');
    toast.textContent = noiDung;
    toast.className = 'toast-thong-bao' + (thanhCong ? ' thanh-cong' : '');
    setTimeout(() => toast.classList.add('hien'), 10);
    setTimeout(() => toast.classList.remove('hien'), 3500);
  }

  // -------- Modal helpers --------
  function dongModal(id)  { document.getElementById(id).classList.remove('hien'); }
  function dongModalNeuNhanNgoai(e, id) { if (e.target.id === id) dongModal(id); }
</script>

</body>
</html>
