@page "/KhachThue/HoSo"
@model QuanLyNhaTro.Pages.KhachThue.HoSoModel
@{
    ViewData["title"] = "Hồ Sơ Cá Nhân";
    Layout = null;

    var kt     = Model.KhachThue;
    var hd     = Model.HopDong;
    var phong  = Model.Phong;
    var tenViet = Model.HoTen ?? "";
    var chuCai  = tenViet.Length > 0 ? tenViet[0].ToString() : "?";
    var soPhongHienThi = phong != null ? $"Phòng {phong.SoPhong} · Tầng {phong.Khu}" : "";

    string NhanTrangThaiHD(string trangThai) => trangThai switch {
        "Đang hiệu lực" => "nhan-xanh-la",
        "Đã kết thúc"   => "nhan-do",
        _               => "nhan-cam"
    };
    string NhanTrangThaiPhong(string trangThai) => trangThai switch {
        "Đã thuê"  => "nhan-xanh",
        "Đang sửa" => "nhan-cam",
        _          => "nhan-do"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nhà Trọ Bà Năm – Hồ Sơ</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ===== BIẾN MÀU TOÀN CỤC ===== */
    :root {
      --mau-sidebar:       #0d1b3e;
      --mau-sidebar-dam:   #091429;
      --mau-chu-de:        #1a56db;
      --mau-chu-de-sang:   #3b82f6;
      --mau-nen:           #f0f4f8;
      --mau-trang:         #ffffff;
      --mau-chu:           #1e293b;
      --mau-chu-phu:       #64748b;
      --mau-vien:          #e2e8f0;
      --mau-xanh-nhat:     #eff6ff;
      --mau-xanh-trung:    #dbeafe;
      --mau-xanh-la:       #059669;
      --mau-xanh-la-nhat:  #d1fae5;
      --mau-cam:           #d97706;
      --mau-cam-nhat:      #fef3c7;
      --mau-do:            #dc2626;
      --mau-do-nhat:       #fee2e2;
      --mau-tim:           #7c3aed;
      --mau-tim-nhat:      #ede9fe;
      --bong-card:         0 4px 24px rgba(26,86,219,0.10);
      --bong-card-hover:   0 8px 32px rgba(26,86,219,0.18);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Be Vietnam Pro', 'Segoe UI', sans-serif;
      background: var(--mau-nen);
      color: var(--mau-chu);
      display: flex; height: 100vh; overflow: hidden;
    }

    /* =============================================
       SIDEBAR
    ============================================= */
    #thanh-sidebar {
      width: 220px; min-width: 220px;
      background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
      display: flex; flex-direction: column;
      height: 100vh; position: relative; z-index: 100;
      box-shadow: 4px 0 24px rgba(0,0,0,0.18);
      overflow-y: auto; overflow-x: hidden;
      transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
    }
    #thanh-sidebar.an-sidebar { width: 0; min-width: 0; overflow: hidden; }

    .nhan-nhom {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.5px; color: rgba(255,255,255,0.3);
      text-transform: uppercase; padding: 18px 20px 6px 20px; white-space: nowrap;
    }
    .logo-sidebar {
      display: flex; align-items: center; gap: 12px;
      padding: 28px 20px 24px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.07); white-space: nowrap;
    }
    .logo-sidebar .logo-img { width: 42px; height: 42px; border-radius: 10px; object-fit: cover; flex-shrink: 0; box-shadow: 0 4px 12px rgba(26,86,219,0.4); display: block; }
    .logo-sidebar .ten-logo strong { display: block; font-size: 15px; color: #fff; letter-spacing: 0.5px; }
    .logo-sidebar .ten-logo span { font-size: 11px; color: rgba(255,255,255,0.45); }

    .menu-item {
      display: flex; align-items: center; gap: 13px;
      padding: 11px 20px; color: rgba(255,255,255,0.65);
      cursor: pointer; border-radius: 0 30px 30px 0;
      margin: 2px 10px 2px 0; transition: all 0.2s;
      font-size: 13.5px; font-weight: 600;
      text-decoration: none; position: relative; white-space: nowrap;
    }
    .menu-item i { width: 20px; text-align: center; font-size: 15px; flex-shrink: 0; }
    .menu-item:hover { background: rgba(59,130,246,0.15); color: #fff; }
    .menu-item.dang-chon {
      background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
      color: #fff; font-weight: 700; box-shadow: 0 4px 16px rgba(26,86,219,0.3);
    }
    .menu-item.dang-chon::before {
      content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      height: 70%; width: 4px; background: #60a5fa; border-radius: 0 4px 4px 0;
    }
    .huy-hieu-menu {
      margin-left: auto; background: #ef4444; color: #fff;
      font-size: 10px; font-weight: 700; border-radius: 20px;
      padding: 1px 7px; min-width: 20px; text-align: center;
    }
    .khach-thue-footer {
      margin-top: auto; padding: 18px 16px;
      border-top: 1px solid rgba(255,255,255,0.07);
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; white-space: nowrap;
    }
    .khach-thue-footer .anh-khach {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 800;
      border: 2px solid rgba(255,255,255,0.2); flex-shrink: 0;
    }
    .khach-thue-footer .ten-khach strong { display: block; color: #fff; font-size: 12px; }
    .khach-thue-footer .ten-khach span { color: rgba(255,255,255,0.45); font-size: 11px; }
    .online-badge { position: relative; }
    .online-badge::after {
      content: ''; position: absolute; bottom: 1px; right: 1px;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #091429;
    }

    /* =============================================
       KHU VỰC CHÍNH
    ============================================= */
    #khu-vuc-chinh { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    /* ===== HEADER ===== */
    #thanh-header {
      background: var(--mau-trang); padding: 0 28px; height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--mau-vien);
      box-shadow: 0 2px 8px rgba(0,0,0,0.05); flex-shrink: 0;
    }
    .header-trai { display: flex; align-items: center; gap: 16px; }
    .nut-ham-menu {
      background: none; border: none; cursor: pointer; font-size: 20px;
      color: var(--mau-chu-phu); padding: 6px; border-radius: 8px; transition: background 0.2s;
    }
    .nut-ham-menu:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .tieu-de-trang { font-size: 16px; font-weight: 800; color: var(--mau-chu); }
    .duong-dan { font-size: 12px; color: var(--mau-chu-phu); }
    .header-phai { display: flex; align-items: center; gap: 14px; }
    .hdr-date {
      font-size: 12px; font-weight: 600; color: var(--mau-chu-phu);
      background: var(--mau-nen); padding: 6px 12px;
      border-radius: 20px; border: 1px solid var(--mau-vien);
    }
    .nut-thong-bao {
      position: relative; background: none; border: none;
      cursor: pointer; font-size: 18px; color: var(--mau-chu-phu);
      padding: 8px; border-radius: 50%; transition: all 0.2s;
    }
    .nut-thong-bao:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .so-thong-bao {
      position: absolute; top: 2px; right: 2px;
      background: #ef4444; color: #fff; font-size: 9px; font-weight: 700;
      border-radius: 50%; width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center; border: 2px solid #fff;
    }
    .thong-tin-khach {
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; padding: 6px 12px; border-radius: 24px; transition: background 0.2s;
    }
    .thong-tin-khach:hover { background: var(--mau-xanh-nhat); }
    .thong-tin-khach .anh-dai-dien {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 14px; font-weight: 800; position: relative;
    }
    .thong-tin-khach .anh-dai-dien::after {
      content: ''; position: absolute; bottom: 0; right: 0;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #fff;
    }
    .thong-tin-khach .ten { font-size: 13px; font-weight: 700; }
    .thong-tin-khach .phong-so { font-size: 11px; color: var(--mau-chu-phu); }

    /* =============================================
       NỘI DUNG CHÍNH
    ============================================= */
    #noi-dung-chinh { flex: 1; overflow-y: auto; padding: 24px 28px; }

    /* ===== TIÊU ĐỀ TRANG ===== */
    .hang-tieu-de-trang {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 22px;
    }
    .hang-tieu-de-trang h2 { font-size: 20px; font-weight: 800; }
    .hang-tieu-de-trang p { font-size: 13px; color: var(--mau-chu-phu); margin-top: 3px; }

    /* ===== LƯỚI 2 CỘT: ẢNH ĐẠI DIỆN | THÔNG TIN NHANH ===== */
    .luoi-ho-so { display: grid; grid-template-columns: 280px 1fr; gap: 20px; margin-bottom: 20px; }

    /* ===== CARD CHUNG ===== */
    .card-ho-so {
      background: var(--mau-trang);
      border: 1px solid var(--mau-vien);
      border-radius: 16px;
      box-shadow: var(--bong-card);
      overflow: hidden;
      transition: box-shadow 0.2s;
    }
    .card-ho-so:hover { box-shadow: var(--bong-card-hover); }

    .duong-mau-card { height: 4px; }
    .mau-xanh { background: linear-gradient(90deg, #1a56db, #60a5fa); }
    .mau-xanh-la { background: linear-gradient(90deg, #059669, #34d399); }
    .mau-tim { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
    .mau-cam { background: linear-gradient(90deg, #d97706, #fbbf24); }

    .tieu-de-card-ho-so {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px 12px;
      border-bottom: 1px solid var(--mau-vien);
    }
    .tieu-de-card-ho-so h3 {
      font-size: 14px; font-weight: 700;
      display: flex; align-items: center; gap: 8px; color: var(--mau-chu);
    }
    .tieu-de-card-ho-so h3 i { color: var(--mau-chu-de); }
    .nhan-trang-thai-nho {
      font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px;
    }
    .nhan-xanh-la { background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la); }
    .nhan-cam { background: var(--mau-cam-nhat); color: var(--mau-cam); }
    .nhan-do { background: var(--mau-do-nhat); color: var(--mau-do); }
    .nhan-xanh { background: var(--mau-xanh-trung); color: var(--mau-chu-de); }

    .than-card { padding: 18px 20px; }

    /* ===== CARD TRÁI: ẢNH ĐẠI DIỆN & TRẠNG THÁI ===== */
    .khung-anh-dai-dien {
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; padding: 24px 20px 20px; text-align: center;
    }
    .anh-dai-dien-lon {
      width: 90px; height: 90px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      font-size: 34px; font-weight: 800; color: #fff;
      border: 4px solid var(--mau-xanh-trung);
      box-shadow: 0 6px 20px rgba(26,86,219,0.25);
      position: relative; flex-shrink: 0;
    }
    .dot-online {
      position: absolute; bottom: 4px; right: 4px;
      width: 14px; height: 14px; border-radius: 50%;
      background: #10b981; border: 3px solid #fff;
    }
    .ten-chinh { font-size: 18px; font-weight: 800; color: var(--mau-chu); }
    .dong-phong {
      font-size: 12px; color: var(--mau-chu-phu);
      background: var(--mau-nen); padding: 4px 12px;
      border-radius: 20px; border: 1px solid var(--mau-vien);
    }
    .hang-trang-thai-khach {
      display: flex; align-items: center; gap: 6px;
      background: var(--mau-xanh-la-nhat);
      color: var(--mau-xanh-la); font-size: 12px; font-weight: 700;
      padding: 5px 14px; border-radius: 20px;
    }
    .dot-nhip {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--mau-xanh-la);
      box-shadow: 0 0 0 3px rgba(5,150,105,0.2);
      animation: nhip 2s ease-in-out infinite;
    }
    @@keyframes nhip {
      0%,100% { box-shadow: 0 0 0 3px rgba(5,150,105,0.2); }
      50%      { box-shadow: 0 0 0 6px rgba(5,150,105,0.06); }
    }

    .luoi-mini-stat { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 0 20px 20px; }
    .o-mini-stat {
      background: var(--mau-nen); border: 1px solid var(--mau-vien);
      border-radius: 10px; padding: 10px 8px; text-align: center;
    }
    .ms-so { font-size: 17px; font-weight: 800; color: var(--mau-chu-de); }
    .ms-nhan { font-size: 10px; color: var(--mau-chu-phu); margin-top: 2px; font-weight: 600; }

    /* ===== CARD PHẢI: CÁC TRƯỜNG THÔNG TIN (CHỈ ĐỌC) ===== */
    .luoi-truong { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .luoi-truong.mot-cot { grid-template-columns: 1fr; }

    .nhom-truong { display: flex; flex-direction: column; gap: 5px; }
    .nhan-truong {
      font-size: 11.5px; font-weight: 700; color: var(--mau-chu-phu);
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .truong-chi-doc {
      background: var(--mau-nen); border: 1.5px solid var(--mau-vien);
      border-radius: 10px; padding: 10px 14px;
      font-size: 13.5px; font-weight: 600; color: var(--mau-chu);
      display: flex; align-items: center; gap: 8px;
    }
    .truong-chi-doc i { color: var(--mau-chu-de); font-size: 12px; flex-shrink: 0; }

    .nhan-khoa {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 10px; font-weight: 700;
      color: var(--mau-chu-phu); background: var(--mau-vien);
      padding: 2px 7px; border-radius: 20px; margin-left: 6px;
    }
    .nhan-khoa i { font-size: 9px; }

    .ghi-chu-chi-doc {
      font-size: 11px; color: var(--mau-chu-phu);
      display: flex; align-items: center; gap: 5px; margin-top: 4px;
    }
    .ghi-chu-chi-doc i { color: var(--mau-cam); font-size: 10px; }

    .duong-phan-cach { height: 1px; background: var(--mau-vien); margin: 16px 0; }

    /* ===== HÀNG DƯỚI: HỢP ĐỒNG + PHÒNG ===== */
    .luoi-duoi { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    .hang-thong-tin {
      display: flex; align-items: center; justify-content: space-between;
      padding: 11px 0; border-bottom: 1px solid var(--mau-vien);
      font-size: 13px;
    }
    .hang-thong-tin:last-child { border-bottom: none; }
    .nhan-truong-bang { color: var(--mau-chu-phu); font-weight: 600; display: flex; align-items: center; gap: 7px; }
    .nhan-truong-bang i { font-size: 12px; color: var(--mau-chu-de); width: 14px; text-align: center; }
    .gia-tri-truong-bang { font-weight: 700; color: var(--mau-chu); text-align: right; }
    .gia-tri-lon { font-size: 15px; font-weight: 800; color: var(--mau-chu-de); }

    /* ===== TOAST ===== */
    .toast-thong-bao {
      position: fixed; bottom: 24px; right: 24px;
      background: #1e293b; color: #fff;
      padding: 12px 20px; border-radius: 12px;
      font-size: 13px; font-weight: 600;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      display: flex; align-items: center; gap: 8px;
      transform: translateY(80px); opacity: 0;
      transition: all 0.3s; z-index: 9999;
    }
    .toast-thong-bao.hien { transform: translateY(0); opacity: 1; }
    .toast-thong-bao.thanh-cong { background: var(--mau-xanh-la); }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1000px) {
      .luoi-ho-so { grid-template-columns: 1fr; }
      .luoi-duoi { grid-template-columns: 1fr; }
    }
    @@media (max-width: 768px) {
      #thanh-sidebar { width: 0; min-width: 0; overflow: hidden; }
      #thanh-sidebar.mo { width: 220px; min-width: 220px; }
      #noi-dung-chinh { padding: 16px; }
      .luoi-truong { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- =============================================
     SIDEBAR
============================================= -->
<nav id="thanh-sidebar">

  <div class="logo-sidebar">
    <img src="~/images/logo.png" alt="Logo Nhà Trọ Bà Năm" class="logo-img" />
    <div class="ten-logo">
      <strong>Nhà Trọ Bà Năm</strong>
      <span>Cổng khách thuê</span>
    </div>
  </div>

  <div class="nhan-nhom">Tổng quan</div>
  <a href="/KhachThue/KhachThue" class="menu-item" onclick="chuyenTrang('trang-chu', this); return false;">
    <i class="fas fa-home"></i><span>Trang chủ</span>
  </a>
    <a href="/Manager/Manager" class="menu-item" onclick="chuyenTrang('trang-quan-ly', this); return false;">
        <i class="fas fa-home"></i><span>Trang Quản Lý</span>
    </a>
  <div class="nhan-nhom">Dịch vụ</div>
  <a href="/KhachThue/ThanhToan" class="menu-item" onclick="chuyenTrang('thanh-toan', this); return false;">
    <i class="fas fa-credit-card"></i><span>Thanh toán</span>
    @if (Model.SoHoaDonChuaDong > 0)
    {
      <span class="huy-hieu-menu">@Model.SoHoaDonChuaDong</span>
    }
  </a>
  <a href="/KhachThue/TienIch" class="menu-item" onclick="chuyenTrang('tien-ich', this); return false;">
    <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
  </a>
  <a href="/KhachThue/BaoSuCo" class="menu-item" onclick="chuyenTrang('bao-su-co', this); return false;">
    <i class="fas fa-tools"></i><span>Báo sự cố</span>
  </a>

  <div class="nhan-nhom">Cá nhân</div>
  <a href="/KhachThue/ThongBao" class="menu-item" onclick="chuyenTrang('thong-bao', this); return false;">
    <i class="fas fa-bell"></i><span>Thông báo</span>
    @if (Model.SoThongBaoChuaDoc > 0)
    {
      <span class="huy-hieu-menu">@Model.SoThongBaoChuaDoc</span>
    }
  </a>
  <a href="/KhachThue/HoSo" class="menu-item dang-chon" onclick="chuyenTrang('ho-so', this); return false;">
    <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
  </a>
  <a href="/KhachThue/CaiDat" class="menu-item" onclick="chuyenTrang('cai-dat', this); return false;">
    <i class="fas fa-cog"></i><span>Cài đặt</span>
  </a>

  <div class="khach-thue-footer">
    <div class="anh-khach online-badge">@chuCai</div>
    <div class="ten-khach">
      <strong>@tenViet</strong>
      <span>@soPhongHienThi</span>
    </div>
  </div>
</nav>


<!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
<div id="khu-vuc-chinh">

  <header id="thanh-header">
    <div class="header-trai">
      <button class="nut-ham-menu" onclick="dongMoSidebar()" title="Ẩn/hiện menu">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-trang">Hồ Sơ Cá Nhân</div>
        <div class="duong-dan">Trang chủ / Hồ sơ</div>
      </div>
    </div>

    <div class="header-phai">
      <div class="hdr-date" id="headerDate"></div>
      <button class="nut-thong-bao" onclick="chuyenTrang('thong-bao', null)" title="Thông báo">
        <i class="fas fa-bell"></i>
        @if (Model.SoThongBaoChuaDoc > 0)
        {
          <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
        }
      </button>
      <div class="thong-tin-khach">
        <div class="anh-dai-dien">@chuCai</div>
        <div>
          <div class="ten">@tenViet</div>
          <div class="phong-so">Phòng @(phong?.SoPhong ?? "-")</div>
        </div>
        <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
      </div>
    </div>
  </header>

  <main id="noi-dung-chinh">

    <div class="hang-tieu-de-trang">
      <div>
        <h2><i class="fas fa-user-circle" style="color:var(--mau-chu-de);margin-right:8px;"></i>Hồ Sơ Cá Nhân</h2>
        <p>Xem thông tin cá nhân của bạn</p>
      </div>
    </div>

    <!-- HÀNG TRÊN: ẢNH ĐẠI DIỆN + THÔNG TIN CÁ NHÂN -->
    <div class="luoi-ho-so">

      <!-- CỘT TRÁI: ẢNH ĐẠI DIỆN & TRẠNG THÁI -->
      <div class="card-ho-so">
        <div class="duong-mau-card mau-xanh"></div>

        <div class="khung-anh-dai-dien">
          <div class="anh-dai-dien-lon">
            @chuCai
            <div class="dot-online"></div>
          </div>
          <div class="ten-chinh">@tenViet</div>
          <div class="dong-phong">
            <i class="fas fa-door-open" style="color:var(--mau-chu-de);margin-right:4px;"></i>
            @soPhongHienThi
          </div>
          <div class="hang-trang-thai-khach">
            <div class="dot-nhip"></div>
            Đang hoạt động
          </div>
        </div>

        <!-- Mini stats -->
        <div class="luoi-mini-stat">
          <div class="o-mini-stat">
            <div class="ms-so">@Model.SoThangThue</div>
            <div class="ms-nhan">Tháng thuê</div>
          </div>
          <div class="o-mini-stat">
            <div class="ms-so">@Model.SoHoaDonDaDong</div>
            <div class="ms-nhan">HĐ đã đóng</div>
          </div>
          <div class="o-mini-stat">
            <div class="ms-so">@Model.SoSuCoDaBao</div>
            <div class="ms-nhan">Sự cố báo</div>
          </div>
          <div class="o-mini-stat">
            <div class="ms-so" style="color:var(--mau-cam);">@Model.SoNgayHDConLai</div>
            <div class="ms-nhan">Ngày HĐ còn</div>
          </div>
        </div>
      </div><!-- /card trái -->

      <!-- CỘT PHẢI: THÔNG TIN CÁ NHÂN (CHỈ ĐỌC) -->
      <div class="card-ho-so">
        <div class="duong-mau-card mau-xanh"></div>
        <div class="tieu-de-card-ho-so">
          <h3><i class="fas fa-id-card"></i> Thông tin cá nhân</h3>
          <span class="nhan-trang-thai-nho nhan-xanh-la">● Đã xác minh</span>
        </div>

        <div class="than-card">
          <div class="luoi-truong">

            <!-- Họ và tên -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Họ và tên
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-user"></i>
                @(string.IsNullOrWhiteSpace(Model.HoTen) ? "Chưa cập nhật" : Model.HoTen)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Số điện thoại -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Số điện thoại
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-phone"></i>
                @(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Email -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Email
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-envelope"></i>
                @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Ngày sinh -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Ngày sinh
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-birthday-cake"></i>
                @(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Giới tính -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Giới tính
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-venus-mars"></i>
                @(string.IsNullOrWhiteSpace(Model.GioiTinh) ? "Chưa cập nhật" : Model.GioiTinh)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Số CCCD / CMND – CHỈ ĐỌC, lấy từ bảng KHACH_THUE -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Số CCCD / CMND
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-id-card"></i>
                @(string.IsNullOrWhiteSpace(Model.SoCCCD) ? "Chưa cập nhật" : Model.SoCCCD)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

            <!-- Quê quán – CHỈ ĐỌC, lấy từ bảng KHACH_THUE -->
            <div class="nhom-truong">
              <label class="nhan-truong">
                Quê quán
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-map-marker-alt"></i>
                @(string.IsNullOrWhiteSpace(Model.QueQuan) ? "Chưa cập nhật" : Model.QueQuan)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>

          </div><!-- /luoi-truong -->

          <div class="duong-phan-cach"></div>

          <!-- Địa chỉ thường trú – CHỈ ĐỌC, lấy từ bảng KHACH_THUE -->
          <div class="luoi-truong mot-cot">
            <div class="nhom-truong">
              <label class="nhan-truong">
                Địa chỉ thường trú
                <span class="nhan-khoa"><i class="fas fa-lock"></i> Chỉ đọc</span>
              </label>
              <div class="truong-chi-doc">
                <i class="fas fa-home"></i>
                @(string.IsNullOrWhiteSpace(Model.DiaChiThuongTru) ? "Chưa cập nhật" : Model.DiaChiThuongTru)
              </div>
              <span class="ghi-chu-chi-doc">
                <i class="fas fa-info-circle"></i> Liên hệ chủ nhà để thay đổi.
              </span>
            </div>
          </div>

        </div><!-- /than-card -->
      </div><!-- /card phải -->
    </div><!-- /luoi-ho-so -->


    <!-- HÀNG DƯỚI: HỢP ĐỒNG + PHÒNG -->
    <div class="luoi-duoi">

      <!-- CARD: THÔNG TIN HỢP ĐỒNG -->
      <div class="card-ho-so">
        <div class="duong-mau-card mau-xanh-la"></div>
        <div class="tieu-de-card-ho-so">
          <h3><i class="fas fa-file-contract"></i> Thông tin hợp đồng</h3>
          @if (hd != null)
          {
            <span class="nhan-trang-thai-nho @NhanTrangThaiHD(hd.TrangThaiHD)">● @hd.TrangThaiHD</span>
          }
        </div>

        <div class="than-card">

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-hashtag"></i> Mã hợp đồng</span>
            <span class="gia-tri-truong-bang" style="font-family:monospace;color:var(--mau-chu-de);">
              HD-@(hd?.IDHopDong.ToString("D4") ?? "-")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-user"></i> Khách thuê</span>
            <span class="gia-tri-truong-bang">@tenViet</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-door-open"></i> Phòng thuê</span>
            <span class="gia-tri-truong-bang">Phòng @(phong?.SoPhong ?? "-")</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-calendar-plus"></i> Ngày bắt đầu</span>
            <span class="gia-tri-truong-bang">
              @(hd?.NgayBatDau.ToString("dd/MM/yyyy") ?? "-")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-calendar-times"></i> Ngày kết thúc</span>
            <span class="gia-tri-truong-bang" style="color:var(--mau-cam);">
              @(hd?.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "Không xác định")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-bolt"></i> Điện đầu kỳ</span>
            <span class="gia-tri-truong-bang">@(hd?.DienDauKy.ToString("N0") ?? "0") kWh</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-tint"></i> Nước đầu kỳ</span>
            <span class="gia-tri-truong-bang">@(hd?.NuocDauKy.ToString("N0") ?? "0") m³</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-hand-holding-usd"></i> Tiền cọc</span>
            <span class="gia-tri-truong-bang gia-tri-lon">
              @(hd?.TienCocBanDau.ToString("N0") ?? "0") đ
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-info-circle"></i> Trạng thái HĐ</span>
            @if (hd != null)
            {
              <span class="nhan-trang-thai-nho @NhanTrangThaiHD(hd.TrangThaiHD)">● @hd.TrangThaiHD</span>
            }
          </div>

        </div><!-- /than-card -->
      </div><!-- /card hợp đồng -->


      <!-- CARD: THÔNG TIN PHÒNG -->
      <div class="card-ho-so">
        <div class="duong-mau-card mau-tim"></div>
        <div class="tieu-de-card-ho-so">
          <h3><i class="fas fa-building"></i> Thông tin phòng</h3>
          @if (phong != null)
          {
            <span class="nhan-trang-thai-nho @NhanTrangThaiPhong(phong.TrangThai)">@phong.TrangThai</span>
          }
        </div>

        <div class="than-card">

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-hashtag"></i> Mã phòng</span>
            <span class="gia-tri-truong-bang" style="font-family:monospace;color:var(--mau-tim);">
              P-@(phong?.IDPhong.ToString("D3") ?? "-")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-door-open"></i> Số phòng</span>
            <span class="gia-tri-truong-bang">@(phong?.SoPhong ?? "-")</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-layer-group"></i> Tầng</span>
            <span class="gia-tri-truong-bang">Tầng @(phong?.Khu.ToString() ?? "-")</span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-money-bill-wave"></i> Giá phòng cố định</span>
            <span class="gia-tri-truong-bang gia-tri-lon">
              @(phong?.GiaPhongFix.ToString("N0") ?? "0") đ/tháng
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-ruler-combined"></i> Diện tích</span>
            <span class="gia-tri-truong-bang">
              @(phong?.DienTich.HasValue == true ? phong.DienTich.Value.ToString("N0") + " m²" : "N/A")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-couch"></i> Tiện nghi</span>
            <span class="gia-tri-truong-bang" style="text-align:right;font-size:12px;">
              @(phong?.MoTa ?? "-")
            </span>
          </div>

          <div class="hang-thong-tin">
            <span class="nhan-truong-bang"><i class="fas fa-circle"></i> Trạng thái phòng</span>
            @if (phong != null)
            {
              <span class="nhan-trang-thai-nho @NhanTrangThaiPhong(phong.TrangThai)">● @phong.TrangThai</span>
            }
          </div>

        </div><!-- /than-card -->
      </div><!-- /card phòng -->

    </div><!-- /luoi-duoi -->

  </main>
</div><!-- /khu-vuc-chinh -->


<!-- JAVASCRIPT -->
<script>
  function capNhatNgayGio() {
    const days = ['CN','T2','T3','T4','T5','T6','T7'];
    const now = new Date();
    const dd = String(now.getDate()).padStart(2,'0');
    const mm = String(now.getMonth()+1).padStart(2,'0');
    const yy = now.getFullYear();
    document.getElementById('headerDate').textContent =
      `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;
  }
  capNhatNgayGio();

  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
  }

  function chuyenTrang(tenTrang, phanTu) {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
    if (phanTu) phanTu.classList.add('dang-chon');
    const bang = {
      'trang-chu':  '/KhachThue/KhachThue',
      'thanh-toan': '/KhachThue/ThanhToan',
      'tien-ich':   '/KhachThue/TienIch',
      'bao-su-co':  '/KhachThue/BaoSuCo',
      'thong-bao':  '/KhachThue/ThongBao',
      'ho-so':      '/KhachThue/HoSo',
      'cai-dat':    '/KhachThue/CaiDat',
      'trang-quan-ly':'/Manager/Manager',
    };
    if (bang[tenTrang]) window.location.href = bang[tenTrang];
  }
</script>

</body>
</html>
