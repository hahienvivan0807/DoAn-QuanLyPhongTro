@page "/KhachThue/ThanhToan"
@model QuanLyNhaTro.Pages.KhachThue.ThanhToanModel
@{
    ViewData["title"] = "Thanh Toán";
    Layout = null;
    var hd = Model.HoaDon;           // HDTHANG
    var dn = Model.DienNuoc;         // DIENNUOC (có thể null)
    var khach = Model.KhachThue;        // ACCOUNT (tenant)
    var phong = Model.Phong;            // PHONG
    var ct = Model.ChuTro;           // ACCOUNT (manager – có QR_Link)

    // Tính số ngày còn lại đến hạn
    int soNgayCon = hd != null ? (hd.HanDong - DateTime.Today).Days : 0;

    // Chỉ số điện/nước
    int soKwh = (dn != null) ? (dn.SoDienMoi - dn.SoDienCu) : 0;
    int soKhoi = (dn != null) ? (dn.SoNuocMoi - dn.SoNuocCu) : 0;

    // Đơn giá điện/nước lấy từ CONFIG
    decimal donGiaDien = Model.DonGiaDien;   // decimal từ CONFIG_GIA
    decimal donGiaNuoc = Model.DonGiaNuoc;

    // Nội dung chuyển khoản tự động
    string noiDungCK = hd != null
        ? $"P{phong?.SoPhong} THANG {hd.KyThanhToan.Replace("/", " ")}"
        : "";

    // Chữ cái đầu tên khách (avatar fallback)
    string avatarChar = khach?.FullName?.Length > 0
        ? khach.FullName.Substring(0, 1).ToUpper()
        : "?";

    // Tên ngân hàng / số tài khoản — lưu tạm trong FullName của manager
    // (Xem ghi chú SQL bên dưới để biết cách mở rộng bảng ACCOUNT)
    // Lấy QR_Link từ DB; nếu chưa có thì dùng ảnh tĩnh mặc định
    string qrUrl = !string.IsNullOrEmpty(ct?.QR_Link)
                         ? ct!.QR_Link
                         : "/images/qr/qrchutro.jpg";
    string nganHang = Model.NganHang;       // string từ PageModel (xem ghi chú)
    string soTaiKhoan = Model.SoTaiKhoan;
    string chuTaiKhoan = ct?.FullName ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh Toán – @(phong?.SoPhong ?? "")</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/KhachThue/ThanhToan.css" rel="stylesheet" />
</head>
<body>

    @* =============================================
     SIDEBAR
  ============================================= *@
    <nav id="thanh-sidebar">

        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Cổng khách thuê</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <a href="/KhachThue/KhachThue" class="menu-item" onclick="chuyenTrang('trang-chu', this); return false;">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </a>
        <a href="/Manager/Manager" class="menu-item" onclick="chuyenTrang('trang-quan-ly', this); return false;">
            <i class="fas fa-home"></i><span>Trang Quản Lý</span>
        </a>
        <div class="nhan-nhom">Dịch vụ</div>
        <a href="/KhachThue/ThanhToan" class="menu-item dang-chon" onclick="chuyenTrang('thanh-toan', this); return false;">
            <i class="fas fa-credit-card"></i><span>Thanh toán</span>
        </a>
        <a href="/KhachThue/TienIch" class="menu-item" onclick="chuyenTrang('tien-ich', this); return false;">
            <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
        </a>
        <a href="/KhachThue/BaoSuCo" class="menu-item" onclick="chuyenTrang('bao-su-co', this); return false;">
            <i class="fas fa-tools"></i><span>Báo sự cố</span>
        </a>

        <div class="nhan-nhom">Cá nhân</div>
        <a href="/KhachThue/ThongBao" class="menu-item" onclick="chuyenTrang('thong-bao', this); return false;">
            <i class="fas fa-bell"></i><span>Thông báo</span>
            @if (Model.SoThongBaoChua > 0)
            {
                <span class="huy-hieu-menu">@Model.SoThongBaoChua</span>
            }
        </a>
        <a href="/KhachThue/HoSo" class="menu-item" onclick="chuyenTrang('ho-so', this); return false;">
            <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
        </a>
        <a href="/KhachThue/CaiDat" class="menu-item" onclick="chuyenTrang('cai-dat', this); return false;">
            <i class="fas fa-cog"></i><span>Cài đặt</span>
        </a>

        <div class="sidebar-footer">
            <div class="anh-khach">@avatarChar</div>
            <div class="ten-khach">
                <strong>@khach?.FullName</strong>
                <span>Phòng @phong?.SoPhong · Khu @phong?.Khu</span>
            </div>
        </div>
    </nav>

    @* =============================================
     KHU VỰC CHÍNH
  ============================================= *@
    <div id="khu-vuc-chinh">

        @* HEADER *@
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()" aria-label="Toggle menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Thanh Toán</div>
                    <div class="duong-dan">
                        <a href="/KhachThue/KhachThue">Trang chủ</a>
                        &nbsp;/&nbsp; Thanh toán
                    </div>
                </div>
            </div>
            <div class="header-phai">
                <div class="hdr-date" id="headerDate"></div>
                <button class="nut-thong-bao" aria-label="Thông báo">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChua > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChua</span>
                    }
                </button>
                <div class="thong-tin-khach">
                    <div class="anh-dai-dien">@avatarChar</div>
                    <div>
                        <div class="ten">@khach?.FullName</div>
                        <div class="phong-so">Phòng @phong?.SoPhong</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>

        @* NỘI DUNG CUỘN *@
        <main id="noi-dung-chinh">

            @* Tiêu đề trang *@
            <div class="page-heading">
                <div>
                    <h2>
                        <i class="fas fa-file-invoice-dollar"></i>
                        Hóa đơn tháng @(hd?.KyThanhToan ?? "—")
                    </h2>
                    <p>
                        Phòng @phong?.SoPhong &nbsp;·&nbsp;
                        @khach?.FullName &nbsp;·&nbsp;
                        Nhà Trọ Bà Năm
                    </p>
                </div>
                <div class="badge-chua-tt">
                    <div class="badge-dot"></div>
                    @(hd?.TrangThai_TT ?? "Chưa đóng")
                </div>
            </div>

            @* LƯỚI 2 KHỐI *@
            <div class="tt-grid">

                @* ----------------------------------------
           KHỐI 1: CHI TIẾT HÓA ĐƠN
        ---------------------------------------- *@
                <div class="tt-card">
                    <div class="tt-accent xanh"></div>
                    <div class="tt-card-header">
                        <div class="tt-icon-wrap xanh">
                            <i class="fas fa-file-invoice-dollar"></i>
                        </div>
                        <div>
                            <h3>Chi tiết hóa đơn</h3>
                            <div class="sub">
                                Tháng @(hd?.KyThanhToan ?? "—") &nbsp;·&nbsp; Phòng @phong?.SoPhong
                            </div>
                        </div>
                    </div>

                    <div class="tt-invoice-body">

                        @* --- Tiền phòng --- *@
                        <div class="tt-row">
                            <div class="tt-row-left">
                                <span class="tt-dot dot-blue"></span>
                                <div>
                                    <div class="tt-label-name">
                                        <i class="fas fa-home" style="color:#1a56db;"></i>Tiền phòng
                                    </div>
                                    <div class="tt-label-sub">
                                        Giá cố định · @Model.GiaPhongCoDinh.ToString("N0") đ/tháng
                                    </div>
                                </div>
                            </div>
                            <div class="tt-amount">
                                @(hd != null ? (hd.TienPhong ?? 0).ToString("N0") + " đ" : "—")
                            </div>
                        </div>

                        @* --- Tiền điện --- *@
                        <div class="tt-row">
                            <div class="tt-row-left">
                                <span class="tt-dot dot-yellow"></span>
                                <div>
                                    <div class="tt-label-name">
                                        <i class="fas fa-bolt" style="color:#f59e0b;"></i>Tiền điện
                                    </div>
                                    @if (dn != null)
                                    {
                                        <div class="tt-label-sub">
                                            @soKwh kWh &times; @donGiaDien.ToString("N0") đ/kWh
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="tt-amount">
                                @(hd != null ? (hd.TienDienSum ?? 0).ToString("N0") + " đ" : "—")
                            </div>
                        </div>

                        @* --- Tiền nước --- *@
                        <div class="tt-row">
                            <div class="tt-row-left">
                                <span class="tt-dot dot-cyan"></span>
                                <div>
                                    <div class="tt-label-name">
                                        <i class="fas fa-tint" style="color:#0ea5e9;"></i>Tiền nước
                                    </div>
                                    @if (dn != null)
                                    {
                                        <div class="tt-label-sub">
                                            @soKhoi khối &times; @donGiaNuoc.ToString("N0") đ/khối
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="tt-amount">
                                @(hd != null ? (hd.TienNuocSum ?? 0).ToString("N0") + " đ" : "—")
                            </div>
                        </div>

                        @* --- Internet (lấy từ TienDV nếu > 0, hoặc CONFIG_GIA) --- *@
                        <div class="tt-row">
                            <div class="tt-row-left">
                                <span class="tt-dot dot-purple"></span>
                                <div>
                                    <div class="tt-label-name">
                                        <i class="fas fa-wifi" style="color:#8b5cf6;"></i>Internet
                                    </div>
                                    <div class="tt-label-sub">Gói cố định hàng tháng</div>
                                </div>
                            </div>
                            <div class="tt-amount mien-phi">Miễn phí</div>
                        </div>

                        @* --- Phí vệ sinh / rác (miễn phí hoặc từ CONFIG_GIA) --- *@
                        <div class="tt-row">
                            <div class="tt-row-left">
                                <span class="tt-dot dot-green"></span>
                                <div>
                                    <div class="tt-label-name">
                                        <i class="fas fa-recycle" style="color:#10b981;"></i>Phí vệ sinh / rác
                                    </div>
                                    <div class="tt-label-sub">Dịch vụ chung Khu trọ</div>
                                </div>
                            </div>
                            <div class="tt-amount mien-phi">Miễn phí</div>
                        </div>


                        @* --- Phí dịch vụ đặt đúng hạn (TienDV) --- *@
                        @if (hd != null && hd.TienDV.GetValueOrDefault() > 0)
                        {
                            <div class="tt-row">
                                <div class="tt-row-left">
                                    <span class="tt-dot" style="background:#6366f1;box-shadow:0 0 0 3px #ede9fe;"></span>
                                    <div>
                                        <div class="tt-label-name">
                                            <i class="fas fa-concierge-bell" style="color:#6366f1;"></i>Phí dịch vụ
                                        </div>
                                        <div class="tt-label-sub">Dịch vụ đặt trong tháng</div>
                                    </div>
                                </div>
                                <div class="tt-amount">
                                    @((hd.TienDV ?? 0).ToString("N0")) đ
                                </div>
                            </div>
                        }

                        @* --- Nợ dịch vụ quá hạn 7 ngày bị cộng vào hóa đơn (TienNoDV) --- *@
                        @if (hd != null && hd.TienNoDV.GetValueOrDefault() > 0)
                        {
                            <div class="tt-row">
                                <div class="tt-row-left">
                                    <span class="tt-dot" style="background:#ef4444;box-shadow:0 0 0 3px #fee2e2;"></span>
                                    <div>
                                        <div class="tt-label-name">
                                            <i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i>Nợ dịch vụ quá hạn
                                        </div>
                                        <div class="tt-label-sub">Dịch vụ chưa thanh toán sau 7 ngày</div>
                                    </div>
                                </div>
                                <div class="tt-amount" style="color:#dc2626;">
                                    +@((hd.TienNoDV ?? 0).ToString("N0")) đ
                                </div>
                            </div>
                        }
                        <div class="tt-hr"></div>

                        <div class="tt-total">
                            <div class="tt-total-label">
                                <i class="fas fa-receipt"></i>
                                Tổng tiền cần thanh toán
                            </div>
                            <div class="tt-total-amount">
                                @(hd != null ? hd.TongCong.ToString("N0") + " đ" : "—")
                            </div>
                        </div>

                        @* Hạn thanh toán *@
                        @if (hd != null)
                        {
                            <div class="tt-deadline">
                                <i class="fas fa-clock"></i>
                                Hạn thanh toán:
                                <strong>@hd.HanDong.ToString("dd/MM/yyyy")</strong>
                                <span class="tt-days-left">
                                    @if (soNgayCon > 0)
                                    {
                                        <text>Còn @soNgayCon ngày</text>
                                    }
                                    else if (soNgayCon == 0)
                                    {

                                        <text>Hôm nay</text>
                                    }
                                    else
                                    {

                                        <text>Quá hạn @(-soNgayCon) ngày</text>
                                    }
                                </span>
                            </div>
                        }

                    </div>
                </div>
                @* -- KẾT THÚC KHỐI 1 -- *@


                @* ----------------------------------------
           KHỐI 2: HÀNH ĐỘNG THANH TOÁN + UPLOAD
        ---------------------------------------- *@
                <div class="tt-card">
                    <div class="tt-accent xanh-la"></div>
                    <div class="tt-card-header">
                        <div class="tt-icon-wrap xanh-la">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div>
                            <h3>Thanh toán hóa đơn</h3>
                            <div class="sub">Chuyển khoản &amp; xác nhận ngay</div>
                        </div>
                    </div>

                    @* CSRF token — dùng cho fetch() upload bill *@
                    @Html.AntiForgeryToken()

                    @* Body thanh toán — ẩn khi thành công *@
                    <div class="tt-pay-body" id="tt-pay-body">

                        @* Tóm tắt số tiền *@
                        <div class="tt-summary">
                            <div>
                                <div class="tt-sum-label">Số tiền cần thanh toán</div>
                                <div class="tt-sum-amount">
                                    @(hd != null ? hd.TongCong.ToString("N0") + " đ" : "—")
                                </div>
                            </div>
                            <div class="tt-sum-icon">
                                <i class="fas fa-wallet"></i>
                            </div>
                        </div>

                        @* Nút THANH TOÁN NHANH — mở modal QR *@
                        <button class="tt-btn-pay" onclick="ttMoQR()">
                            <i class="fas fa-qrcode"></i>
                            Thanh toán nhanh
                        </button>

                        <div class="tt-sep">hoặc đính kèm ảnh xác nhận chuyển khoản</div>

                        @* -----------------------------------------
               FORM UPLOAD ẢNH BILL
               ─────────────────────────────────────────
               [GHI CHÚ] Ảnh bill được submit qua OnPost
               bằng IFormFile BillImage, sau đó lưu vào:
                 wwwroot/uploads/bills/{IDHDThang}_{timestamp}.jpg
               Đường dẫn ghi vào: HDTHANG.AnhChuyenKhoan
               SQL:
                 UPDATE HDTHANG
                 SET AnhChuyenKhoan = @duongDan,
                     TrangThai_TT   = 'Chờ duyệt',
                     UpdatedAt      = GETDATE()
                 WHERE IDHDThang = @id
               Xem hướng dẫn đầy đủ trong ThanhToan.cshtml.cs
            ----------------------------------------- *@
                        <div class="tt-upload-zone"
                             id="tt-upload-zone"
                             ondragover="ttDragOver(event)"
                             ondragleave="ttDragLeave(event)"
                             ondrop="ttDrop(event)">

                            <input type="file"
                                   class="tt-file-input"
                                   id="tt-file-input"
                                   accept="image/*"
                                   onchange="ttFileChosen(this)" />

                            <div id="tt-upload-prompt">
                                <i class="fas fa-cloud-upload-alt tt-upload-icon"></i>
                                <div class="tt-upload-title">Kéo &amp; thả ảnh vào đây</div>
                                <div class="tt-upload-hint">
                                    hoặc <span>nhấn để chọn từ thiết bị</span><br />
                                    JPG, PNG, HEIC — tối đa 10 MB
                                </div>
                            </div>

                            <div class="tt-preview" id="tt-preview">
                                <img src="" alt="Ảnh bill chuyển khoản" id="tt-preview-img" />
                                <button class="tt-btn-remove" type="button"
                                        title="Xóa ảnh" onclick="ttXoaAnh(event)">
                                    <i class="fas fa-times"></i>
                                </button>
                                <div class="tt-file-name" id="tt-file-name"></div>
                            </div>
                        </div>

                        @* Nút GỬI XÁC NHẬN *@
                        <button class="tt-btn-send" id="tt-btn-send" onclick="ttGuiXacNhan()">
                            <i class="fas fa-paper-plane"></i>
                            Gửi xác nhận thanh toán
                        </button>

                    </div>
                    @* -- KẾT THÚC .tt-pay-body -- *@

                    @* Trạng thái thành công *@
                    <div class="tt-success" id="tt-success">
                        <div class="tt-success-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h4>Đã gửi xác nhận thành công!</h4>
                        <p>
                            Chúng tôi đã nhận được ảnh bill chuyển khoản.<br />
                            Hóa đơn sẽ được cập nhật trong vòng <strong>15 phút</strong>.
                        </p>
                        <button class="tt-btn-back" onclick="window.location.href='/KhachThue/KhachThue'">
                            <i class="fas fa-arrow-left" style="margin-right:6px;"></i>Về trang chủ
                        </button>
                    </div>

                </div>
                @* -- KẾT THÚC KHỐI 2 -- *@

            </div>
            @* -- KẾT THÚC .tt-grid -- *@

        </main>
    </div>
    @* -- KẾT THÚC #khu-vuc-chinh -- *@


    @* =============================================
     MODAL THANH TOÁN NHANH — QR CODE
     ─────────────────────────────────────────────
     [GHI CHÚ] ẢNH QR CODE + THÔNG TIN NGÂN HÀNG
     Razor bind từ Model.QuanLy.QR_Link (ACCOUNT.QR_Link)
     Thông tin ngân hàng (NganHang, SoTaiKhoan) cần thêm
     2 cột mới vào bảng ACCOUNT — xem ThanhToan.cshtml.cs
  ============================================= *@
    <div class="qr-modal-overlay" id="qr-modal-overlay" onclick="ttDongQR(event)">
        <div class="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title">

            <div class="qr-modal-accent"></div>

            <div class="qr-modal-header">
                <div class="qr-modal-header-left">
                    <div class="qr-icon-badge"><i class="fas fa-qrcode"></i></div>
                    <div>
                        <div class="qr-modal-title" id="qr-modal-title">Thanh toán nhanh</div>
                        <div class="qr-modal-sub">Quét mã QR để chuyển khoản ngay</div>
                    </div>
                </div>
                <button class="qr-modal-close" onclick="ttDongQRBtn()" aria-label="Đóng">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="qr-modal-body">

                @* Số tiền *@
                <div class="qr-amount-bar">
                    <div>
                        <div class="qr-amount-label">Số tiền cần chuyển</div>
                        <div class="qr-amount-value" id="qr-so-tien">
                            @(hd != null ? hd.TongCong.ToString("N0") + " đ" : "—")
                        </div>
                    </div>
                    <div class="qr-amount-icon"><i class="fas fa-wallet"></i></div>
                </div>

                @* Khung QR *@
                <div class="qr-image-wrap">

                    @* ─── ẢNH QR ─── bind từ ACCOUNT.QR_Link; fallback về ảnh tĩnh *@
                    <img id="qr-img"
                         src="@qrUrl"
                         alt="Mã QR chuyển khoản của quản lý"
                         width="200"
                         height="200"
                         data-quan-ly-id="@ct?.IDUser"
                         onerror="this.src='/images/qr/qrchutro.jpg';" />

                    @* Thông tin tài khoản ngân hàng *@
                    <div class="qr-bank-info">
                        <div class="qr-bank-row">
                            <span class="lbl">Ngân hàng</span>
                            <span class="val" id="qr-ngan-hang">@(nganHang ?? "— —")</span>
                        </div>
                        <div class="qr-bank-row">
                            <span class="lbl">Số tài khoản</span>
                            <span class="val">
                                <span id="qr-so-tk">@(soTaiKhoan ?? "— — — —")</span>
                                <button class="qr-copy-btn" onclick="ttCopy('qr-so-tk')" title="Sao chép số TK">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </span>
                        </div>
                        <div class="qr-bank-row">
                            <span class="lbl">Chủ tài khoản</span>
                            <span class="val" id="qr-chu-tk">@(chuTaiKhoan ?? "— — — —")</span>
                        </div>
                    </div>
                </div>

                @* Nội dung chuyển khoản *@
                <div class="qr-noi-dung">
                    <div>
                        <div class="nd-label">Nội dung CK</div>
                        <div class="nd-val" id="qr-nd-ck">@noiDungCK</div>
                    </div>
                    <button class="nd-copy" onclick="ttCopy('qr-nd-ck')" title="Sao chép">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>

                @* Hướng dẫn *@
                <div class="qr-guide">
                    <i class="fas fa-circle-info"></i>
                    Mở app ngân hàng → Chuyển tiền → Quét mã QR hoặc nhập số tài khoản.
                    Sau khi chuyển, hãy tải ảnh bill lên bên dưới để xác nhận.
                </div>

            </div>

            <div class="qr-modal-footer">
                <button class="qr-btn-dong" onclick="ttDongQRBtn()">
                    <i class="fas fa-arrow-left" style="margin-right:6px;"></i>Quay lại
                </button>
                <button class="qr-btn-xac-nhan" onclick="ttDongVaUpload()">
                    <i class="fas fa-upload"></i>
                    Đã chuyển – Tải bill lên
                </button>
            </div>

        </div>
    </div>

    @* =============================================
     JAVASCRIPT
  ============================================= *@
    <script>
            /* --- Cập nhật ngày giờ header --- */
            (function () {
              const days = ['CN','T2','T3','T4','T5','T6','T7'];
              const now  = new Date();
              const dd   = String(now.getDate()).padStart(2, '0');
              const mm   = String(now.getMonth() + 1).padStart(2, '0');
              const yy   = now.getFullYear();
              const el   = document.getElementById('headerDate');
              if (el) el.textContent = `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;
            })();

            /* --- Toggle sidebar --- */
            function dongMoSidebar() {
              document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            /* --- Chuyển trang --- */
            function chuyenTrang(tenTrang, phanTu) {
              document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
              phanTu.classList.add('dang-chon');
              const bang = {
                'trang-chu':  '/KhachThue/KhachThue',
                'thanh-toan': '/KhachThue/ThanhToan',
                'tien-ich':   '/KhachThue/TienIch',
                'bao-su-co':  '/KhachThue/BaoSuCo',
                'thong-bao':  '/KhachThue/ThongBao',
                'ho-so':      '/KhachThue/HoSo',
                'cai-dat':    '/KhachThue/CaiDat',
                'trang-quan-ly':'/Manager/Manager',
              };
              if (bang[tenTrang]) window.location.href = bang[tenTrang];
            }

            /* ==============================================
               UPLOAD ẢNH BILL
            ============================================== */
            let ttSelectedFile = null;

            function ttFileChosen(input) {
              const file = input.files && input.files[0];
              ttXuLyFile(file);
            }

            function ttDragOver(event) {
              event.preventDefault();
              document.getElementById('tt-upload-zone').classList.add('drag-over');
            }

            function ttDragLeave(event) {
              document.getElementById('tt-upload-zone').classList.remove('drag-over');
            }

            function ttDrop(event) {
              event.preventDefault();
              document.getElementById('tt-upload-zone').classList.remove('drag-over');
              const file = event.dataTransfer.files && event.dataTransfer.files[0];
              ttXuLyFile(file);
            }

            function ttXuLyFile(file) {
              if (!file) return;
              if (!file.type.startsWith('image/')) {
                alert('Vui lòng chọn file ảnh (JPG, PNG, HEIC...)!');
                return;
              }
              if (file.size > 10 * 1024 * 1024) {
                alert('File quá lớn! Vui lòng chọn ảnh nhỏ hơn 10 MB.');
                return;
              }
              ttSelectedFile = file;
              const reader = new FileReader();
              reader.onload = function (e) {
                document.getElementById('tt-preview-img').src = e.target.result;
                document.getElementById('tt-file-name').textContent  = file.name;
                document.getElementById('tt-upload-prompt').style.display = 'none';
                document.getElementById('tt-preview').style.display  = 'block';
              };
              reader.readAsDataURL(file);
              document.getElementById('tt-btn-send').classList.add('active');
            }

            function ttXoaAnh(event) {
              event.stopPropagation();
              ttSelectedFile = null;
              document.getElementById('tt-file-input').value    = '';
              document.getElementById('tt-preview').style.display       = 'none';
              document.getElementById('tt-upload-prompt').style.display = 'block';
              document.getElementById('tt-preview-img').src             = '';
              document.getElementById('tt-file-name').textContent       = '';
              document.getElementById('tt-btn-send').classList.remove('active');
            }

            /* ==============================================
               GỬI XÁC NHẬN THANH TOÁN
               Thay setTimeout bằng fetch() thật:

               const fd = new FormData();
               fd.append('BillImage', ttSelectedFile);
               fd.append('InvoiceId', '@(hd?.IDHDThang)');
               const res = await fetch('?handler=GuiXacNhan', {
                 method: 'POST',
                 headers: { 'RequestVerificationToken':
                   document.querySelector('[name=__RequestVerificationToken]').value },
                 body: fd
               });
               if (!res.ok) throw new Error('Lỗi server');
            ============================================== */
            async function ttGuiXacNhan() {
              if (!ttSelectedFile) return;

              const btn = document.getElementById('tt-btn-send');
              const invoiceId = '@(hd?.IDHDThang ?? 0)';

              if (!invoiceId || invoiceId === '0') {
                alert('Không tìm thấy hóa đơn. Vui lòng tải lại trang.');
                return;
              }

              // Lấy CSRF token
              const token = document.querySelector('input[name="__RequestVerificationToken"]');
              if (!token) {
                alert('Lỗi bảo mật: không tìm thấy token. Vui lòng tải lại trang.');
                return;
              }

              btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang gửi...';
              btn.disabled = true;
              btn.classList.remove('active');

              try {
                const fd = new FormData();
                fd.append('BillImage', ttSelectedFile);
                fd.append('InvoiceId', invoiceId);

                const res = await fetch('?handler=GuiXacNhan', {
                  method: 'POST',
                  headers: { 'RequestVerificationToken': token.value },
                  body: fd
                });

                if (!res.ok) {
                  const text = await res.text();
                  throw new Error('Lỗi ' + res.status + ': ' + (text || res.statusText));
                }

                const json = await res.json();
                if (!json.success) throw new Error('Server trả về lỗi không xác định.');

                // Thành công — hiện màn hình xác nhận
                document.getElementById('tt-pay-body').style.display = 'none';
                document.getElementById('tt-success').style.display  = 'flex';

              } catch (err) {
                alert('Gửi xác nhận thất bại! Vui lòng thử lại.\n(' + err.message + ')');
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi xác nhận thanh toán';
                btn.disabled = false;
                btn.classList.add('active');
              }
            }

            /* ==============================================
               MODAL QR CODE
            ============================================== */
            function ttMoQR() {
              const overlay = document.getElementById('qr-modal-overlay');
              overlay.classList.add('hien');
              document.body.style.overflow = 'hidden';
            }

            function ttDongQR(e) {
              if (e.target === document.getElementById('qr-modal-overlay')) {
                ttDongQRBtn();
              }
            }

            function ttDongQRBtn() {
              document.getElementById('qr-modal-overlay').classList.remove('hien');
              document.body.style.overflow = '';
            }

            function ttDongVaUpload() {
              ttDongQRBtn();
              setTimeout(function () {
                const zone = document.getElementById('tt-upload-zone');
                if (zone) zone.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }, 320);
            }

            function ttCopy(elementId) {
              const el = document.getElementById(elementId);
              if (!el) return;
              navigator.clipboard.writeText(el.textContent.trim()).then(function () {
                const btn = el.nextElementSibling || el.parentElement.querySelector('.qr-copy-btn, .nd-copy');
                if (btn) {
                  const orig = btn.innerHTML;
                  btn.innerHTML = '<i class="fas fa-check" style="color:#059669"></i>';
                  setTimeout(function () { btn.innerHTML = orig; }, 1400);
                }
              });
            }

            document.addEventListener('keydown', function (e) {
              if (e.key === 'Escape') ttDongQRBtn();
            });
    </script>

</body>
</html>
