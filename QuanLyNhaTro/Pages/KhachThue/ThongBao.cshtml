@page "/KhachThue/ThongBao"
@model QuanLyNhaTro.Pages.KhachThue.ThongBaoModel
@{
    ViewData["title"] = "Thông Báo";
    Layout = null;
}<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nhà Trọ Bà Năm – Thông Báo</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ===== BIẾN MÀU TOÀN CỤC ===== */
    :root {
      --mau-sidebar:       #0d1b3e;
      --mau-sidebar-dam:   #091429;
      --mau-chu-de:        #1a56db;
      --mau-chu-de-sang:   #3b82f6;
      --mau-nen:           #f0f4f8;
      --mau-trang:         #ffffff;
      --mau-chu:           #1e293b;
      --mau-chu-phu:       #64748b;
      --mau-vien:          #e2e8f0;
      --mau-xanh-nhat:     #eff6ff;
      --mau-xanh-trung:    #dbeafe;
      --mau-xanh-la:       #059669;
      --mau-xanh-la-nhat:  #d1fae5;
      --mau-cam:           #d97706;
      --mau-cam-nhat:      #fef3c7;
      --mau-do:            #dc2626;
      --mau-do-nhat:       #fee2e2;
      --mau-tim:           #7c3aed;
      --mau-tim-nhat:      #ede9fe;
      --bong-card:         0 4px 24px rgba(26,86,219,0.10);
      --bong-card-hover:   0 8px 32px rgba(26,86,219,0.18);
    }

    /* ===== RESET & CƠ BẢN ===== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Be Vietnam Pro', 'Segoe UI', sans-serif;
      background: var(--mau-nen);
      color: var(--mau-chu);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* =============================================
       SIDEBAR – GIỮ NGUYÊN TỪ KHACHTHUE
    ============================================= */
    #thanh-sidebar {
      width: 220px;
      min-width: 220px;
      background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: relative;
      z-index: 100;
      box-shadow: 4px 0 24px rgba(0,0,0,0.18);
      overflow-y: auto;
      overflow-x: hidden;
      transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
    }
    #thanh-sidebar.an-sidebar { width: 0; min-width: 0; overflow: hidden; }

    .nhan-nhom {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.5px; color: rgba(255,255,255,0.3);
      text-transform: uppercase;
      padding: 18px 20px 6px 20px;
      white-space: nowrap;
    }
    .logo-sidebar {
      display: flex; align-items: center; gap: 12px;
      padding: 28px 20px 24px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      white-space: nowrap;
    }
    .logo-sidebar .logo-img {
      width: 42px; height: 42px; border-radius: 10px;
      object-fit: cover; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(26,86,219,0.4); display: block;
    }
    .logo-sidebar .ten-logo strong { display: block; font-size: 15px; color: #fff; letter-spacing: 0.5px; }
    .logo-sidebar .ten-logo span { font-size: 11px; color: rgba(255,255,255,0.45); }

    .menu-item {
      display: flex; align-items: center; gap: 13px;
      padding: 11px 20px;
      color: rgba(255,255,255,0.65);
      cursor: pointer;
      border-radius: 0 30px 30px 0;
      margin: 2px 10px 2px 0;
      transition: all 0.2s;
      font-size: 13.5px; font-weight: 600;
      text-decoration: none;
      position: relative; white-space: nowrap;
    }
    .menu-item i { width: 20px; text-align: center; font-size: 15px; flex-shrink: 0; }
    .menu-item:hover { background: rgba(59,130,246,0.15); color: #fff; }
    .menu-item.dang-chon {
      background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
      color: #fff; font-weight: 700;
      box-shadow: 0 4px 16px rgba(26,86,219,0.3);
    }
    .menu-item.dang-chon::before {
      content: '';
      position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      height: 70%; width: 4px;
      background: #60a5fa;
      border-radius: 0 4px 4px 0;
    }
    .huy-hieu-menu {
      margin-left: auto;
      background: #ef4444; color: #fff;
      font-size: 10px; font-weight: 700;
      border-radius: 20px; padding: 1px 7px;
      min-width: 20px; text-align: center;
    }
    .khach-thue-footer {
      margin-top: auto;
      padding: 18px 16px;
      border-top: 1px solid rgba(255,255,255,0.07);
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; white-space: nowrap;
    }
    .khach-thue-footer .anh-khach {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 15px; font-weight: 800;
      border: 2px solid rgba(255,255,255,0.2); flex-shrink: 0;
    }
    .khach-thue-footer .ten-khach strong { display: block; color: #fff; font-size: 13px; }
    .khach-thue-footer .ten-khach span { color: rgba(255,255,255,0.45); font-size: 11px; }
    .online-badge { position: relative; }
    .online-badge::after {
      content: ''; position: absolute; bottom: 1px; right: 1px;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #091429;
    }

    /* =============================================
       KHU VỰC CHÍNH
    ============================================= */
    #khu-vuc-chinh { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    /* ===== HEADER ===== */
    #thanh-header {
      background: var(--mau-trang);
      padding: 0 28px; height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--mau-vien);
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      flex-shrink: 0;
    }
    .header-trai { display: flex; align-items: center; gap: 16px; }
    .nut-ham-menu {
      background: none; border: none; cursor: pointer;
      font-size: 20px; color: var(--mau-chu-phu);
      padding: 6px; border-radius: 8px; transition: background 0.2s;
    }
    .nut-ham-menu:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .tieu-de-trang { font-size: 16px; font-weight: 800; color: var(--mau-chu); }
    .duong-dan { font-size: 12px; color: var(--mau-chu-phu); }
    .header-phai { display: flex; align-items: center; gap: 14px; }
    .hdr-date {
      font-size: 12px; font-weight: 600; color: var(--mau-chu-phu);
      background: var(--mau-nen); padding: 6px 12px;
      border-radius: 20px; border: 1px solid var(--mau-vien);
    }
    .nut-thong-bao {
      position: relative; background: none; border: none;
      cursor: pointer; font-size: 18px; color: var(--mau-chu-phu);
      padding: 8px; border-radius: 50%; transition: all 0.2s;
    }
    .nut-thong-bao:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
    .so-thong-bao {
      position: absolute; top: 2px; right: 2px;
      background: #ef4444; color: #fff;
      font-size: 9px; font-weight: 700; border-radius: 50%;
      width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center;
      border: 2px solid #fff;
    }
    .thong-tin-khach {
      display: flex; align-items: center; gap: 10px;
      cursor: pointer; padding: 6px 12px; border-radius: 24px;
      transition: background 0.2s;
    }
    .thong-tin-khach:hover { background: var(--mau-xanh-nhat); }
    .thong-tin-khach .anh-dai-dien {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, #1a56db, #60a5fa);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 14px; font-weight: 800; position: relative;
    }
    .thong-tin-khach .anh-dai-dien::after {
      content: ''; position: absolute; bottom: 0; right: 0;
      width: 10px; height: 10px; border-radius: 50%;
      background: #10b981; border: 2px solid #fff;
    }
    .thong-tin-khach .ten { font-size: 13px; font-weight: 700; }
    .thong-tin-khach .phong-so { font-size: 11px; color: var(--mau-chu-phu); }

    /* =============================================
       NỘI DUNG CHÍNH
    ============================================= */
    #noi-dung-chinh { flex: 1; overflow-y: auto; padding: 24px 28px; }

    /* ===== TIÊU ĐỀ TRANG ===== */
    .hang-tieu-de-trang {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 22px;
    }
    .hang-tieu-de-trang h2 { font-size: 20px; font-weight: 800; }
    .hang-tieu-de-trang p { font-size: 13px; color: var(--mau-chu-phu); margin-top: 3px; }

    /* ===== THANH BỘ LỌC & TÌM KIẾM THÔNG BÁO ===== */
    .thanh-bo-loc {
      display: flex; align-items: center; gap: 10px;
      background: var(--mau-trang);
      border: 1px solid var(--mau-vien);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 18px;
      flex-wrap: wrap;
      box-shadow: var(--bong-card);
    }
    .o-tim-kiem {
      flex: 1; min-width: 200px;
      display: flex; align-items: center; gap: 8px;
      background: var(--mau-nen);
      border: 1.5px solid var(--mau-vien);
      border-radius: 10px; padding: 8px 14px;
      transition: border-color 0.2s;
    }
    .o-tim-kiem:focus-within { border-color: var(--mau-chu-de-sang); }
    .o-tim-kiem i { color: var(--mau-chu-phu); font-size: 13px; }
    .o-tim-kiem input {
      border: none; background: none; outline: none;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 13px; color: var(--mau-chu); width: 100%;
    }
    .nhom-nut-loc { display: flex; gap: 8px; flex-wrap: wrap; }
    .nut-loc {
      padding: 7px 14px; border-radius: 20px;
      font-size: 12px; font-weight: 700;
      border: 1.5px solid var(--mau-vien);
      background: var(--mau-trang); color: var(--mau-chu-phu);
      cursor: pointer; transition: all 0.2s;
      font-family: 'Be Vietnam Pro', sans-serif;
    }
    .nut-loc:hover, .nut-loc.dang-chon-loc {
      background: var(--mau-chu-de); color: #fff;
      border-color: var(--mau-chu-de);
    }
    .nut-danh-dau-het {
      padding: 7px 14px; border-radius: 20px;
      font-size: 12px; font-weight: 700;
      border: 1.5px solid var(--mau-xanh-la);
      background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la);
      cursor: pointer; transition: all 0.2s; margin-left: auto;
      font-family: 'Be Vietnam Pro', sans-serif; white-space: nowrap;
    }
    .nut-danh-dau-het:hover { background: var(--mau-xanh-la); color: #fff; }

    /* ===== KHU VỰC DANH SÁCH THÔNG BÁO ===== */
    .khu-vuc-danh-sach-thong-bao {
      display: flex; flex-direction: column; gap: 12px;
    }

    /* ===== ITEM THÔNG BÁO ===== */
    .item-thong-bao {
      background: var(--mau-trang);
      border: 1.5px solid var(--mau-vien);
      border-radius: 14px;
      padding: 16px 18px;
      display: flex; align-items: flex-start; gap: 14px;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
      box-shadow: var(--bong-card);
    }
    .item-thong-bao:hover { box-shadow: var(--bong-card-hover); transform: translateY(-2px); }
    .item-thong-bao.chua-doc {
      border-left: 4px solid var(--mau-chu-de);
      background: var(--mau-xanh-nhat);
    }
    .item-thong-bao.chua-doc.loai-canh-bao { border-left-color: var(--mau-cam); background: #fffbeb; }
    .item-thong-bao.chua-doc.loai-nguy-hiem { border-left-color: var(--mau-do); background: #fff5f5; }
    .item-thong-bao.chua-doc.loai-thanh-cong { border-left-color: var(--mau-xanh-la); background: #f0fdf4; }

    .bieu-tuong-thong-bao {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .bt-thong-tin  { background: var(--mau-xanh-trung); color: var(--mau-chu-de); }
    .bt-canh-bao   { background: var(--mau-cam-nhat);   color: var(--mau-cam); }
    .bt-nguy-hiem  { background: var(--mau-do-nhat);    color: var(--mau-do); }
    .bt-thanh-cong { background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la); }
    .bt-he-thong   { background: var(--mau-tim-nhat);   color: var(--mau-tim); }

    .noi-dung-thong-bao { flex: 1; min-width: 0; }
    .dong-tren-thong-bao {
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px; margin-bottom: 4px;
    }
    .tieu-de-thong-bao {
      font-size: 14px; font-weight: 700; color: var(--mau-chu);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .item-thong-bao.chua-doc .tieu-de-thong-bao { color: var(--mau-chu-de); }
    .thoi-gian-thong-bao {
      font-size: 11px; color: var(--mau-chu-phu);
      white-space: nowrap; flex-shrink: 0;
    }
    .noi-dung-tom-tat {
      font-size: 13px; color: var(--mau-chu-phu);
      line-height: 1.55; margin-bottom: 8px;
    }
    .dong-duoi-thong-bao { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .the-loai-thong-bao {
      font-size: 10.5px; font-weight: 700;
      padding: 3px 10px; border-radius: 20px;
    }
    .the-loai-thong-tin  { background: var(--mau-xanh-trung); color: var(--mau-chu-de); }
    .the-loai-canh-bao   { background: var(--mau-cam-nhat);   color: var(--mau-cam); }
    .the-loai-nguy-hiem  { background: var(--mau-do-nhat);    color: var(--mau-do); }
    .the-loai-thanh-cong { background: var(--mau-xanh-la-nhat); color: var(--mau-xanh-la); }
    .the-loai-he-thong   { background: var(--mau-tim-nhat);   color: var(--mau-tim); }
    .cham-chua-doc {
      position: absolute; top: 14px; right: 16px;
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--mau-chu-de);
      box-shadow: 0 0 0 3px var(--mau-xanh-trung);
    }
    .nut-xem-chi-tiet {
      margin-left: auto;
      font-size: 11.5px; font-weight: 700;
      color: var(--mau-chu-de);
      background: none; border: none; cursor: pointer;
      padding: 3px 8px; border-radius: 8px;
      transition: background 0.2s;
      font-family: 'Be Vietnam Pro', sans-serif;
    }
    .nut-xem-chi-tiet:hover { background: var(--mau-xanh-nhat); }

    /* ===== NHÓM NGÀY (HEADER NHÓM) ===== */
    .nhan-nhom-ngay {
      font-size: 11px; font-weight: 800;
      color: var(--mau-chu-phu);
      letter-spacing: 1px; text-transform: uppercase;
      padding: 8px 0 6px;
      display: flex; align-items: center; gap: 10px;
    }
    .nhan-nhom-ngay::after {
      content: ''; flex: 1; height: 1px;
      background: var(--mau-vien);
    }

    /* ===== TRỐNG – KHI KHÔNG CÓ THÔNG BÁO ===== */
    .khung-trong {
      text-align: center; padding: 60px 20px;
      color: var(--mau-chu-phu);
    }
    .khung-trong i { font-size: 48px; margin-bottom: 14px; color: #cbd5e1; }
    .khung-trong p { font-size: 14px; font-weight: 600; }

    /* ===== MODAL CHI TIẾT THÔNG BÁO ===== */
    .lop-che-modal {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.5); z-index: 999;
      align-items: center; justify-content: center;
      backdrop-filter: blur(4px);
    }
    .lop-che-modal.hien { display: flex; }
    .hop-modal {
      background: var(--mau-trang); border-radius: 20px;
      padding: 28px; width: 540px; max-width: 95vw;
      box-shadow: 0 20px 60px rgba(0,0,0,0.2);
      animation: hienModal 0.3s ease;
    }
    @@keyframes hienModal {
      from { opacity:0; transform:scale(0.9) translateY(-20px); }
      to   { opacity:1; transform:none; }
    }
    .tieu-de-modal {
      display: flex; align-items: center;
      justify-content: space-between; margin-bottom: 20px;
    }
    .tieu-de-modal h3 { font-size: 17px; font-weight: 800; display: flex; align-items: center; gap: 9px; }
    .nut-dong-modal {
      background: none; border: none; font-size: 20px; cursor: pointer;
      color: var(--mau-chu-phu); border-radius: 50%;
      width: 34px; height: 34px;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .nut-dong-modal:hover { background: var(--mau-nen); color: var(--mau-chu); }
    .noi-dung-modal { font-size: 13.5px; line-height: 1.7; color: var(--mau-chu); }
    .nhom-nut-modal { display: flex; gap: 10px; justify-content: flex-end; margin-top: 22px; }
    .nut-huy {
      background: var(--mau-nen); color: var(--mau-chu-phu);
      border: none; padding: 10px 20px; border-radius: 10px;
      cursor: pointer; font-size: 13px; font-weight: 600;
      transition: all 0.2s; font-family: 'Be Vietnam Pro', sans-serif;
    }
    .nut-huy:hover { background: var(--mau-vien); }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
      #thanh-sidebar { width: 0; min-width: 0; overflow: hidden; }
      #thanh-sidebar.mo { width: 220px; min-width: 220px; }
      #noi-dung-chinh { padding: 16px; }
      .thanh-bo-loc { flex-direction: column; align-items: stretch; }
    }
  </style>
</head>
<body>

<!-- SIDEBAR -->
<nav id="thanh-sidebar">

  <!-- Logo nhà trọ – giữ nguyên -->
  <div class="logo-sidebar">
    <img src="~/images/logo.png" alt="Logo Nhà Trọ Bà Năm" class="logo-img" />
    <div class="ten-logo">
      <strong>Nhà Trọ Bà Năm</strong>
      <span>Cổng khách thuê</span>
    </div>
  </div>

  <!-- Nhóm Tổng quan -->
  <div class="nhan-nhom">Tổng quan</div>
  <a href="/KhachThue/KhachThue" class="menu-item" onclick="chuyenTrang('trang-chu', this); return false;">
    <i class="fas fa-home"></i><span>Trang chủ</span>
  </a>

  <!-- Nhóm Dịch vụ -->
  <div class="nhan-nhom">Dịch vụ</div>
  <a href="/KhachThue/ThanhToan" class="menu-item" onclick="chuyenTrang('thanh-toan', this); return false;">
    <i class="fas fa-credit-card"></i><span>Thanh toán</span>
    <span class="huy-hieu-menu">1</span>
  </a>
  <a href="/KhachThue/TienIch" class="menu-item" onclick="chuyenTrang('tien-ich', this); return false;">
    <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
  </a>
  <a href="/KhachThue/BaoSuCo" class="menu-item" onclick="chuyenTrang('bao-su-co', this); return false;">
    <i class="fas fa-tools"></i><span>Báo sự cố</span>
  </a>

  <!-- Nhóm Cá nhân -->
  <div class="nhan-nhom">Cá nhân</div>
  <a href="/KhachThue/ThongBao" class="menu-item dang-chon" onclick="chuyenTrang('thong-bao', this); return false;">
    <i class="fas fa-bell"></i><span>Thông báo</span>
    <span class="huy-hieu-menu" id="so-chua-doc-sidebar">@Model.SoChuaDoc</span>
  </a>
  <a href="/KhachThue/HoSo" class="menu-item" onclick="chuyenTrang('ho-so', this); return false;">
    <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
  </a>
  <a href="/KhachThue/CaiDat" class="menu-item" onclick="chuyenTrang('cai-dat', this); return false;">
    <i class="fas fa-cog"></i><span>Cài đặt</span>
  </a>

  <!-- Footer sidebar -->
  <div class="khach-thue-footer">
    <div class="anh-khach online-badge">@Model.KhachThue.FullName[0]</div>
    <div class="ten-khach">
      <strong>@Model.KhachThue.FullName</strong>
      <span>Phòng @Model.SoPhong · Tầng @Model.Tang</span>
    </div>
  </div>
</nav>


<!-- KHU VỰC CHÍNH -->
<div id="khu-vuc-chinh">

  <!-- HEADER -->
  <header id="thanh-header">
    <div class="header-trai">
      <button class="nut-ham-menu" onclick="dongMoSidebar()" title="Ẩn/hiện menu">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-trang">Thông Báo</div>
        <div class="duong-dan">Trang chủ / Thông báo</div>
      </div>
    </div>

    <div class="header-phai">
      <div class="hdr-date" id="headerDate"></div>
      <button class="nut-thong-bao" title="Thông báo">
        <i class="fas fa-bell"></i>
        <span class="so-thong-bao" id="so-chua-doc-header">@Model.SoChuaDoc</span>
      </button>
      <div class="thong-tin-khach" onclick="chuyenTrang('ho-so', this)">
        <div class="anh-dai-dien">@Model.KhachThue.FullName[0]</div>
        <div>
          <div class="ten">@Model.KhachThue.FullName</div>
          <div class="phong-so">Phòng @Model.SoPhong</div>
        </div>
        <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
      </div>
    </div>
  </header>

  <!-- NỘI DUNG CHÍNH -->
  <main id="noi-dung-chinh">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="hang-tieu-de-trang">
      <div>
        <h2><i class="fas fa-bell" style="color:var(--mau-chu-de);margin-right:8px;"></i>Thông Báo</h2>
        <p>Tổng <strong id="tong-thong-bao">@Model.TongThongBao</strong> thông báo · <strong id="so-chua-doc-text" style="color:var(--mau-chu-de);">@Model.SoChuaDoc chưa đọc</strong></p>
      </div>
    </div>

    <!-- THANH BỘ LỌC -->
    <div class="thanh-bo-loc">
      <div class="o-tim-kiem">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Tìm kiếm thông báo..." id="o-nhap-tim-kiem" />
      </div>
      <div class="nhom-nut-loc">
        <button class="nut-loc dang-chon-loc" onclick="locThongBao('tat-ca', this)">Tất cả</button>
        <button class="nut-loc" onclick="locThongBao('chua-doc', this)">Chưa đọc</button>
        <button class="nut-loc" onclick="locThongBao('thong-tin', this)">Thông tin</button>
        <button class="nut-loc" onclick="locThongBao('canh-bao', this)">Cảnh báo</button>
        <button class="nut-loc" onclick="locThongBao('thanh-toan', this)">Thanh toán</button>
      </div>
      <button class="nut-danh-dau-het" onclick="danhDauHetDaDoc()">
        <i class="fas fa-check-double"></i> Đánh dấu tất cả đã đọc
      </button>
    </div>

    <!-- DANH SÁCH THÔNG BÁO -->
    <div class="khu-vuc-danh-sach-thong-bao" id="danh-sach-thong-bao">

      @if (!Model.DanhSachThongBao.Any())
      {
        <div class="khung-trong">
          <i class="fas fa-bell-slash"></i>
          <p>Không có thông báo nào</p>
        </div>
      }
      else
      {
        @* Nhóm: Hôm nay *@
        var homNay = Model.DanhSachThongBao.Where(tb => tb.NgayTao.Date == DateTime.Today).ToList();
        if (homNay.Any())
        {
          <div class="nhan-nhom-ngay">Hôm nay</div>
          foreach (var tb in homNay)
          {
            <div class="item-thong-bao @Model.GetItemChuaDocClass(tb)"
                 data-loai="@tb.LoaiTB"
                 data-da-doc="@(tb.DaDoc ? "true" : "false")"
                 onclick="moChiTietThongBao(this, '@tb.IDThongBao')">
              <div class="bieu-tuong-thong-bao @Model.GetBieuTuongClass(tb.LoaiTB)">
                <i class="@Model.GetIconClass(tb.LoaiTB)"></i>
              </div>
              <div class="noi-dung-thong-bao">
                <div class="dong-tren-thong-bao">
                  <span class="tieu-de-thong-bao">@tb.TieuDe</span>
                  <span class="thoi-gian-thong-bao">@Model.FormatThoiGian(tb.NgayTao)</span>
                </div>
                <p class="noi-dung-tom-tat">@tb.NoiDung</p>
                <div class="dong-duoi-thong-bao">
                  <span class="the-loai-thong-bao @Model.GetLoaiClass(tb.LoaiTB)">@Model.GetLoaiNhan(tb.LoaiTB)</span>
                  <button class="nut-xem-chi-tiet">Xem chi tiết →</button>
                </div>
              </div>
              @if (!tb.DaDoc) { <div class="cham-chua-doc"></div> }
            </div>
          }
        }

        @* Nhóm: Hôm qua *@
        var homQua = Model.DanhSachThongBao.Where(tb => tb.NgayTao.Date == DateTime.Today.AddDays(-1)).ToList();
        if (homQua.Any())
        {
          <div class="nhan-nhom-ngay">Hôm qua</div>
          foreach (var tb in homQua)
          {
            <div class="item-thong-bao @Model.GetItemChuaDocClass(tb)"
                 data-loai="@tb.LoaiTB"
                 data-da-doc="@(tb.DaDoc ? "true" : "false")"
                 onclick="moChiTietThongBao(this, '@tb.IDThongBao')">
              <div class="bieu-tuong-thong-bao @Model.GetBieuTuongClass(tb.LoaiTB)">
                <i class="@Model.GetIconClass(tb.LoaiTB)"></i>
              </div>
              <div class="noi-dung-thong-bao">
                <div class="dong-tren-thong-bao">
                  <span class="tieu-de-thong-bao">@tb.TieuDe</span>
                  <span class="thoi-gian-thong-bao">@Model.FormatThoiGian(tb.NgayTao)</span>
                </div>
                <p class="noi-dung-tom-tat">@tb.NoiDung</p>
                <div class="dong-duoi-thong-bao">
                  <span class="the-loai-thong-bao @Model.GetLoaiClass(tb.LoaiTB)">@Model.GetLoaiNhan(tb.LoaiTB)</span>
                  <button class="nut-xem-chi-tiet">Xem chi tiết →</button>
                </div>
              </div>
              @if (!tb.DaDoc) { <div class="cham-chua-doc"></div> }
            </div>
          }
        }

        @* Nhóm: Tuần trước *@
        var tuanTruoc = Model.DanhSachThongBao
          .Where(tb => tb.NgayTao.Date < DateTime.Today.AddDays(-1) && tb.NgayTao.Date >= DateTime.Today.AddDays(-7))
          .ToList();
        if (tuanTruoc.Any())
        {
          <div class="nhan-nhom-ngay">Tuần trước</div>
          foreach (var tb in tuanTruoc)
          {
            <div class="item-thong-bao @Model.GetItemChuaDocClass(tb)"
                 data-loai="@tb.LoaiTB"
                 data-da-doc="@(tb.DaDoc ? "true" : "false")"
                 onclick="moChiTietThongBao(this, '@tb.IDThongBao')">
              <div class="bieu-tuong-thong-bao @Model.GetBieuTuongClass(tb.LoaiTB)">
                <i class="@Model.GetIconClass(tb.LoaiTB)"></i>
              </div>
              <div class="noi-dung-thong-bao">
                <div class="dong-tren-thong-bao">
                  <span class="tieu-de-thong-bao">@tb.TieuDe</span>
                  <span class="thoi-gian-thong-bao">@Model.FormatThoiGian(tb.NgayTao)</span>
                </div>
                <p class="noi-dung-tom-tat">@tb.NoiDung</p>
                <div class="dong-duoi-thong-bao">
                  <span class="the-loai-thong-bao @Model.GetLoaiClass(tb.LoaiTB)">@Model.GetLoaiNhan(tb.LoaiTB)</span>
                  <button class="nut-xem-chi-tiet">Xem chi tiết →</button>
                </div>
              </div>
              @if (!tb.DaDoc) { <div class="cham-chua-doc"></div> }
            </div>
          }
        }

        @* Nhóm: Cũ hơn *@
        var cuHon = Model.DanhSachThongBao
          .Where(tb => tb.NgayTao.Date < DateTime.Today.AddDays(-7))
          .ToList();
        if (cuHon.Any())
        {
          <div class="nhan-nhom-ngay">Cũ hơn</div>
          foreach (var tb in cuHon)
          {
            <div class="item-thong-bao @Model.GetItemChuaDocClass(tb)"
                 data-loai="@tb.LoaiTB"
                 data-da-doc="@(tb.DaDoc ? "true" : "false")"
                 onclick="moChiTietThongBao(this, '@tb.IDThongBao')">
              <div class="bieu-tuong-thong-bao @Model.GetBieuTuongClass(tb.LoaiTB)">
                <i class="@Model.GetIconClass(tb.LoaiTB)"></i>
              </div>
              <div class="noi-dung-thong-bao">
                <div class="dong-tren-thong-bao">
                  <span class="tieu-de-thong-bao">@tb.TieuDe</span>
                  <span class="thoi-gian-thong-bao">@Model.FormatThoiGian(tb.NgayTao)</span>
                </div>
                <p class="noi-dung-tom-tat">@tb.NoiDung</p>
                <div class="dong-duoi-thong-bao">
                  <span class="the-loai-thong-bao @Model.GetLoaiClass(tb.LoaiTB)">@Model.GetLoaiNhan(tb.LoaiTB)</span>
                  <button class="nut-xem-chi-tiet">Xem chi tiết →</button>
                </div>
              </div>
              @if (!tb.DaDoc) { <div class="cham-chua-doc"></div> }
            </div>
          }
        }
      }

    </div><!-- /khu-vuc-danh-sach-thong-bao -->

  </main>
</div>


<!-- MODAL CHI TIẾT THÔNG BÁO -->
<div class="lop-che-modal" id="modal-chi-tiet-thong-bao"
     onclick="dongModalNeuNhanNgoai(event, 'modal-chi-tiet-thong-bao')">
  <div class="hop-modal">
    <div class="tieu-de-modal">
      <h3 id="modal-tieu-de">
        <i class="fas fa-bell" style="color:var(--mau-chu-de);"></i>
        <span id="modal-ten-thong-bao">Tiêu đề thông báo</span>
      </h3>
      <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet-thong-bao')">✕</button>
    </div>
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;">
      <span id="modal-the-loai" class="the-loai-thong-bao the-loai-thong-tin">Thông tin</span>
      <span style="font-size:11px;color:var(--mau-chu-phu);" id="modal-thoi-gian">Thời gian</span>
    </div>
    <div class="noi-dung-modal" id="modal-noi-dung"></div>
    <div class="nhom-nut-modal">
      <button class="nut-huy" onclick="dongModal('modal-chi-tiet-thong-bao')">Đóng</button>
    </div>
  </div>
</div>


<script>
  // Dữ liệu thông báo từ Model – dùng cho modal chi tiết
  const duLieuThongBao = {
    @foreach (var tb in Model.DanhSachThongBao)
    {
      <text>
      '@tb.IDThongBao': {
        ten: '@Html.Raw(tb.TieuDe.Replace("'", "\\'"))',
        loaiClass: '@Model.GetLoaiClass(tb.LoaiTB)',
        loaiNhan: '@Model.GetLoaiNhan(tb.LoaiTB)',
        thoiGian: '@tb.NgayTao.ToString("dd/MM/yyyy, HH:mm")',
        noiDung: '@Html.Raw((tb.NoiDung ?? "").Replace("'", "\\'").Replace("\n", "\\n"))'
      },
      </text>
    }
  };

  // -------- Ngày giờ header --------
  function capNhatNgayGio() {
    const days = ['CN','T2','T3','T4','T5','T6','T7'];
    const now = new Date();
    const dd = String(now.getDate()).padStart(2,'0');
    const mm = String(now.getMonth()+1).padStart(2,'0');
    const yy = now.getFullYear();
    document.getElementById('headerDate').textContent =
      `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;
  }
  capNhatNgayGio();

  // -------- Toggle sidebar --------
  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
  }

  // -------- Chuyển trang --------
  function chuyenTrang(tenTrang, phanTu) {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
    if (phanTu) phanTu.classList.add('dang-chon');
    const bang = {
      'trang-chu':  '/KhachThue/KhachThue',
      'thanh-toan': '/KhachThue/ThanhToan',
      'tien-ich':   '/KhachThue/TienIch',
      'bao-su-co':  '/KhachThue/BaoSuCo',
      'thong-bao':  '/KhachThue/ThongBao',
      'ho-so':      '/KhachThue/HoSo',
      'cai-dat':    '/KhachThue/CaiDat',
    };
    if (bang[tenTrang]) window.location.href = bang[tenTrang];
  }

  // -------- Mở modal chi tiết thông báo --------
  function moChiTietThongBao(phanTuItem, idThongBao) {
    phanTuItem.classList.remove('chua-doc','loai-canh-bao','loai-nguy-hiem','loai-thanh-cong');
    const cham = phanTuItem.querySelector('.cham-chua-doc');
    if (cham) cham.remove();
    phanTuItem.dataset.daDoc = 'true';
    capNhatSoChuaDoc();

    const data = duLieuThongBao[idThongBao];
    if (!data) return;
    document.getElementById('modal-ten-thong-bao').textContent = data.ten;
    document.getElementById('modal-the-loai').className = 'the-loai-thong-bao ' + data.loaiClass;
   document.getElementById('modal-the-loai').innerHTML = data.loaiNhan;

    document.getElementById('modal-thoi-gian').textContent = data.thoiGian;
    document.getElementById('modal-noi-dung').innerHTML = data.noiDung;

    document.getElementById('modal-chi-tiet-thong-bao').classList.add('hien');
  }

  function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
  function dongModalNeuNhanNgoai(e, id) { if (e.target.id === id) dongModal(id); }

  // -------- Đánh dấu tất cả đã đọc --------
  function danhDauHetDaDoc() {
    document.querySelectorAll('.item-thong-bao.chua-doc').forEach(el => {
      el.classList.remove('chua-doc','loai-canh-bao','loai-nguy-hiem','loai-thanh-cong');
      el.dataset.daDoc = 'true';
      const cham = el.querySelector('.cham-chua-doc');
      if (cham) cham.remove();
    });
    capNhatSoChuaDoc();
  }

  // -------- Cập nhật số chưa đọc trên UI --------
  function capNhatSoChuaDoc() {
    const soChuaDoc = document.querySelectorAll('.item-thong-bao[data-da-doc="false"]').length;
    document.getElementById('so-chua-doc-text').textContent = soChuaDoc + ' chưa đọc';
    document.getElementById('so-chua-doc-header').textContent = soChuaDoc;
    document.getElementById('so-chua-doc-sidebar').textContent = soChuaDoc;
    if (soChuaDoc === 0) {
      document.getElementById('so-chua-doc-header').style.display = 'none';
      document.getElementById('so-chua-doc-sidebar').style.display = 'none';
    }
  }

  // -------- Lọc thông báo --------
  function locThongBao(loai, nut) {
    document.querySelectorAll('.nut-loc').forEach(b => b.classList.remove('dang-chon-loc'));
    nut.classList.add('dang-chon-loc');

    document.querySelectorAll('.item-thong-bao').forEach(el => {
      const dataLoai = el.dataset.loai;
      const daDoc = el.dataset.daDoc;
      if (loai === 'tat-ca') {
        el.style.display = '';
      } else if (loai === 'chua-doc') {
        el.style.display = daDoc === 'false' ? '' : 'none';
      } else {
        el.style.display = dataLoai === loai ? '' : 'none';
      }
    });
  }
</script>

</body>
</html>
