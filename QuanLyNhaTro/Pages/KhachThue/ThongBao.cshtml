  function moChiTietThongBao(phanTuItem, idThongBao) {
    // Đánh dấu đã đọc
    phanTuItem.classList.remove('chua-doc','loai-canh-bao','loai-nguy-hiem','loai-thanh-cong');
    const cham = phanTuItem.querySelector('.cham-chua-doc');
    if (cham) cham.remove();
    phanTuItem.dataset.daDoc = 'true';
    capNhatSoChuaDoc();

    // Nạp nội dung vào modal
    const data = duLieuThongBao[idThongBao];
    if (!data) return;
    document.getElementById('modal-ten-thong-bao').textContent = data.ten;
    document.getElementById('modal-the-loai').className = 'the-loai-thong-bao ' + data.loaiClass;
    document.getElementById('modal-the-loai').textContent = data.loaiNhan;
    document.getElementById('modal-thoi-gian').textContent = data.thoiGian;
    document.getElementById('modal-noi-dung').innerHTML = data.noiDung;

    document.getElementById('modal-chi-tiet-thong-bao').classList.add('hien');
  }

  function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
  function dongModalNeuNhanNgoai(e, id) { if (e.target.id === id) dongModal(id); }

  // -------- Đánh dấu tất cả đã đọc --------
  function danhDauHetDaDoc() {
    document.querySelectorAll('.item-thong-bao.chua-doc').forEach(el => {
      el.classList.remove('chua-doc','loai-canh-bao','loai-nguy-hiem','loai-thanh-cong');
      el.dataset.daDoc = 'true';
      const cham = el.querySelector('.cham-chua-doc');
      if (cham) cham.remove();
    });
    capNhatSoChuaDoc();
  }

  // -------- Cập nhật số chưa đọc trên UI --------
  function capNhatSoChuaDoc() {
    const soChuaDoc = document.querySelectorAll('.item-thong-bao[data-da-doc="false"]').length;
    document.getElementById('so-chua-doc-text').textContent = soChuaDoc + ' chưa đọc';
    document.getElementById('so-chua-doc-header').textContent = soChuaDoc;
    document.getElementById('so-chua-doc-sidebar').textContent = soChuaDoc;
    if (soChuaDoc === 0) {
      document.getElementById('so-chua-doc-header').style.display = 'none';
      document.getElementById('so-chua-doc-sidebar').style.display = 'none';
    }
  }

  // -------- Lọc thông báo --------
  function locThongBao(loai, nut) {
    document.querySelectorAll('.nut-loc').forEach(b => b.classList.remove('dang-chon-loc'));
    nut.classList.add('dang-chon-loc');

    document.querySelectorAll('.item-thong-bao').forEach(el => {
      const dataLoai = el.dataset.loai;
      const daDoc = el.dataset.daDoc;
      if (loai === 'tat-ca') {
        el.style.display = '';
      } else if (loai === 'chua-doc') {
        el.style.display = daDoc === 'false' ? '' : 'none';
      } else {
        el.style.display = dataLoai === loai ? '' : 'none';
      }
    });
  }
</script>

