@page "/KhachThue/BaoSuCo"
@model QuanLyNhaTro.Pages.KhachThue.BaoCaoSuCoModel
@{
    ViewData["title"] = "Báo Sự Cố";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nhà Trọ Bà Năm – Báo Sự Cố</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
   <link href="~/css/KhachThue/BaoSuCo.css" rel="stylesheet" />
</head>
<body>

<!-- =============================================
     SIDEBAR
============================================= -->
<nav id="thanh-sidebar">
  <div class="logo-sidebar">
    <img src="~/images/logo.png" alt="Logo" class="logo-img" />
    <div class="ten-logo">
      <strong>Nhà Trọ Bà Năm</strong>
      <span>Cổng khách thuê</span>
    </div>
  </div>

  <div class="nhan-nhom">Tổng quan</div>
  <a href="/KhachThue/KhachThue" class="menu-item" onclick="chuyenTrang('trang-chu', this); return false;">
    <i class="fas fa-home"></i><span>Trang chủ</span>
  </a>
    <a href="/Manager/Manager" class="menu-item" onclick="chuyenTrang('trang-quan-ly', this); return false;">
    <i class="fas fa-home"></i><span>Trang Quản Lý</span>
    </a>

  <div class="nhan-nhom">Dịch vụ</div>
  <a href="/KhachThue/ThanhToan" class="menu-item" onclick="chuyenTrang('thanh-toan', this); return false;">
    <i class="fas fa-credit-card"></i><span>Thanh toán</span>
    @* Số hóa đơn chưa đóng: Model.SoHoaDonChuaDong từ HDTHANG *@
    @if (Model.SoHoaDonChuaDong > 0)
    {
      <span class="huy-hieu-menu">@Model.SoHoaDonChuaDong</span>
    }
  </a>
  <a href="/KhachThue/TienIch" class="menu-item" onclick="chuyenTrang('tien-ich', this); return false;">
    <i class="fas fa-bolt"></i><span>Dịch vụ & Tiện ích</span>
  </a>
  <a href="/KhachThue/BaoSuCo" class="menu-item dang-chon" onclick="chuyenTrang('bao-su-co', this); return false;">
    <i class="fas fa-tools"></i><span>Báo sự cố</span>
  </a>

  <div class="nhan-nhom">Cá nhân</div>
  <a href="/KhachThue/ThongBao" class="menu-item" onclick="chuyenTrang('thong-bao', this); return false;">
    <i class="fas fa-bell"></i><span>Thông báo</span>
    @* Số thông báo chưa đọc: Model.SoThongBaoChuaDoc từ THONGBAO *@
    @if (Model.SoThongBaoChuaDoc > 0)
    {
      <span class="huy-hieu-menu">@Model.SoThongBaoChuaDoc</span>
    }
  </a>
  <a href="/KhachThue/HoSo" class="menu-item" onclick="chuyenTrang('ho-so', this); return false;">
    <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
  </a>
  <a href="/KhachThue/CaiDat" class="menu-item" onclick="chuyenTrang('cai-dat', this); return false;">
    <i class="fas fa-cog"></i><span>Cài đặt</span>
  </a>

  <div class="khach-thue-footer" onclick="moHoSo()">
    <div class="anh-khach online-badge">@Model.KhachThue.FullName[0]</div>
    <div class="ten-khach">
      <strong>@Model.KhachThue.FullName</strong>
      <span>Phòng @Model.SoPhongHienTai · Tầng @Model.TangHienTai</span>
    </div>
  </div>
</nav>

<!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
<div id="khu-vuc-chinh">

  <!-- HEADER -->
  <header id="thanh-header">
    <div class="header-trai">
      <button class="nut-ham-menu" onclick="dongMoSidebar()">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <div class="tieu-de-trang">Báo Sự Cố</div>
        <div class="duong-dan">Trang chủ / Báo sự cố</div>
      </div>
    </div>
    <div class="header-phai">
      <div class="hdr-date" id="headerDate"></div>
      <button class="nut-thong-bao" onclick="alert('@Model.SoThongBaoChuaDoc thông báo chưa đọc')">
        <i class="fas fa-bell"></i>
        @if (Model.SoThongBaoChuaDoc > 0)
        {
          <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
        }
      </button>
      <div class="thong-tin-khach" onclick="moHoSo()">
        <div class="anh-dai-dien">@Model.KhachThue.FullName[0]</div>
        <div>
          <div class="ten">@Model.KhachThue.FullName</div>
          <div class="phong-so">Phòng @Model.SoPhongHienTai</div>
        </div>
        <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
      </div>
    </div>
  </header>

  <!-- NỘI DUNG CHÍNH -->
  <main id="noi-dung-chinh">

    <!-- Tiêu đề trang -->
    <div class="hang-tieu-de-trang">
      <div>
        <h2>🚨 Báo Sự Cố</h2>
        <p>Gửi báo cáo sự cố đến quản lý và chủ trọ nhanh chóng</p>
      </div>
    </div>

    <!-- Thống kê nhanh: đếm từ DONDV theo IDUser + TrangThai_DV -->
    <div class="hang-thong-ke">
      <div class="card-thong-ke mau-cam">
        <div class="bieu-tuong-card"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="so-lieu">
          <div class="con-so">@Model.TongSuCoDaGui</div>
          <div class="ten-thong-ke">Sự cố đã gửi</div>
        </div>
      </div>
      <div class="card-thong-ke mau-xanh">
        <div class="bieu-tuong-card"><i class="fas fa-spinner"></i></div>
        <div class="so-lieu">
          <div class="con-so">@Model.SuCoDangXuLy</div>
          <div class="ten-thong-ke">Đang xử lý</div>
        </div>
      </div>
      <div class="card-thong-ke mau-xanh-la">
        <div class="bieu-tuong-card"><i class="fas fa-check-circle"></i></div>
        <div class="so-lieu">
          <div class="con-so">@Model.SuCoHoanTat</div>
          <div class="ten-thong-ke">Đã hoàn tất</div>
        </div>
      </div>
    </div>

    <!-- Layout 2 cột -->
    <div class="layout-2-cot">

      <!-- CỘT TRÁI: FORM BÁO CÁO -->
      <div>

        <!-- Ghi chú quan trọng -->
        <div class="hop-ghi-chu">
          <div class="tieu-de-gc"><i class="fas fa-info-circle"></i> Lưu ý khi báo sự cố</div>
          <ul>
            <li>Báo cáo sẽ được gửi đến <strong>quản lý</strong> và <strong>chủ trọ</strong> ngay lập tức.</li>
            <li>Vui lòng mô tả <strong>chi tiết, rõ ràng</strong> để được hỗ trợ nhanh nhất.</li>
            <li>Trường hợp khẩn cấp, vui lòng gọi trực tiếp số điện thoại quản lý.</li>
          </ul>
        </div>

        <div class="card accent-do">
          <div class="card-header">
            <div class="icon-header"><i class="fas fa-file-alt"></i></div>
            <h3>Form Báo Cáo Sự Cố</h3>
          </div>
          <div class="card-body">

            <!-- TABS CHỌN LOẠI -->
            <div class="tabs-loai">
              <button class="tab-btn tab-dich-vu active" onclick="chonLoai('dich-vu', this)">
                <span class="tab-icon">🔔</span>
                <span>Báo cáo Dịch vụ</span>
              </button>
              <button class="tab-btn tab-hu-hong" onclick="chonLoai('hu-hong', this)">
                <span class="tab-icon">🔧</span>
                <span>Báo cáo Hư hỏng</span>
              </button>
            </div>

            <!-- MÔ TẢ LOẠI 1 -->
            <div class="mo-ta-tab hien" id="mo-ta-dich-vu">
              <strong>📋 Báo cáo Dịch vụ:</strong> Dành cho các trường hợp quản lý không thực hiện đúng dịch vụ như <strong>giao nước</strong>, <strong>thu đồ giặt</strong>, <strong>trả đồ giặt</strong> hoặc các dịch vụ đã cam kết khác.
            </div>
            <!-- MÔ TẢ LOẠI 2 -->
            <div class="mo-ta-tab loai-hu-hong" id="mo-ta-hu-hong">
              <strong>🔧 Báo cáo Hư hỏng:</strong> Dành cho các hư hỏng cơ sở vật chất trong phòng hoặc khu vực chung như <strong>vòi nước</strong>, <strong>đường điện</strong>, <strong>cửa khóa</strong>, thiết bị hư hỏng,...
            </div>

            <!-- =========================================
                 PHẦN FORM DỊCH VỤ (Loại 1)
                 POST → OnPostDichVu()
                 Lưu vào DONDV: LoaiDV='Dịch vụ', IDUser, IDPhong, NoiDung, MucDo
                 AnhBienLai → lưu file vào wwwroot/uploads/su-co/ (xem hướng dẫn cuối file)
            ========================================= -->
            <div class="phan-form hien" id="form-dich-vu">

              <!-- Số phòng: cố định theo phòng đang thuê của khách -->
              <div class="hang-form-2">
                <div class="nhom-truong">
                  <label class="nhan-truong">Số phòng <span class="bat-buoc">*</span></label>
                  <input type="text" class="truong-nhap" id="phong-dich-vu-hien-thi"
                    value="Phòng @Model.SoPhongHienTai" readonly
                    style="background:#f8fafc;color:var(--mau-chu);cursor:not-allowed;font-weight:600;" />
                  <input type="hidden" id="phong-dich-vu" name="PhongDichVu" value="@Model.IDPhongHienTai" />
                </div>
                <div class="nhom-truong">
                  <label class="nhan-truong">Ngày xảy ra <span class="bat-buoc">*</span></label>
                  <input type="date" class="truong-nhap" id="ngay-dich-vu" name="NgayDichVu" />
                </div>
              </div>

              <!-- Dịch vụ vi phạm -->
              <div class="hang-form-1">
                <label class="nhan-truong">Dịch vụ không được thực hiện <span class="bat-buoc">*</span></label>
                <div class="nhom-dich-vu-vi-pham">
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 'nuoc')">
                    <i class="fas fa-tint"></i> Giao nước uống
                  </div>
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 'thu-giat')">
                    <i class="fas fa-tshirt"></i> Thu đồ giặt
                  </div>
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 'tra-giat')">
                    <i class="fas fa-box-open"></i> Trả đồ giặt
                  </div>
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 've-sinh')">
                    <i class="fas fa-broom"></i> Vệ sinh hành lang
                  </div>
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 'rac')">
                    <i class="fas fa-trash"></i> Thu gom rác
                  </div>
                  <div class="chip-dich-vu" onclick="chonDichVu(this, 'khac-dv')">
                    <i class="fas fa-ellipsis-h"></i> Dịch vụ khác
                  </div>
                </div>
                <input type="hidden" id="dich-vu-da-chon" name="DichVuDaChon" value="" />
              </div>

              <!-- Buổi không thực hiện -->
              <div class="hang-form-2">
                <div class="nhom-truong">
                  <label class="nhan-truong">Buổi không thực hiện</label>
                  <select class="truong-nhap" id="buoi-dich-vu" name="BuoiDichVu">
                    <option value="">-- Chọn buổi --</option>
                    <option>Sáng (6h–12h)</option>
                    <option>Chiều (12h–18h)</option>
                    <option>Tối (18h–22h)</option>
                    <option>Cả ngày</option>
                  </select>
                </div>
                <div class="nhom-truong">
                  <label class="nhan-truong">Đã nhắc nhở quản lý?</label>
                  <select class="truong-nhap" id="da-nhac" name="DaNhac">
                    <option value="chua">Chưa nhắc</option>
                    <option value="roi">Đã nhắc nhưng chưa xử lý</option>
                    <option value="nhieu-lan">Đã nhắc nhiều lần</option>
                  </select>
                </div>
              </div>

              <!-- Mô tả chi tiết -->
              <div class="hang-form-1">
                <label class="nhan-truong">Mô tả chi tiết <span class="bat-buoc">*</span></label>
                <textarea class="truong-nhap" rows="4" id="mo-ta-dich-vu-text" name="MoTaDichVu"
                  placeholder="Ví dụ: Hôm nay ngày 10/05, quản lý không giao nước dù đã đặt từ hôm qua. Tôi đã nhắn tin lúc 8h sáng nhưng không có phản hồi..."></textarea>
              </div>

              <!-- Mức độ -->
              <div class="hang-form-1">
                <label class="nhan-truong">Mức độ ảnh hưởng <span class="bat-buoc">*</span></label>
                <div class="nhom-muc-do">
                  <button type="button" class="chip-muc-do" onclick="chonMucDo(this,'thap','dich-vu')">
                    🟢 Thấp
                  </button>
                  <button type="button" class="chip-muc-do chon-trung" onclick="chonMucDo(this,'trung','dich-vu')">
                    🟡 Trung bình
                  </button>
                  <button type="button" class="chip-muc-do" onclick="chonMucDo(this,'khan-cap','dich-vu')">
                    🔴 Khẩn cấp
                  </button>
                </div>
                <input type="hidden" id="muc-do-dich-vu" name="MucDoDichVu" value="trung" />
              </div>

              <!-- Ảnh đính kèm -->
              <div class="hang-form-1">
                <label class="nhan-truong">Ảnh minh chứng (nếu có)</label>
                <div class="khu-anh-dinh-kem" onclick="document.getElementById('file-anh-dv').click()">
                  <i class="fas fa-cloud-upload-alt"></i>
                  <p>Nhấn để tải ảnh lên hoặc kéo thả vào đây</p>
                  <span>PNG, JPG, WEBP · Tối đa 5MB mỗi ảnh</span>
                  <div class="xem-truoc-anh" id="xem-truoc-dv"></div>
                </div>
                @* Upload ảnh → lưu vào DONDV.AnhBienLai (xem hướng dẫn SQL + File cuối trang) *@
                <input type="file" id="file-anh-dv" name="FileAnhDichVu" accept="image/*" multiple style="display:none"
                  onchange="xemTruocAnh(this,'xem-truoc-dv')" />
              </div>

              <div class="nhom-nut-gui">
                <button type="button" class="nut-huy" onclick="datLaiForm('dich-vu')">
                  <i class="fas fa-redo"></i> Đặt lại
                </button>
                <button type="button" class="nut-gui-dich-vu" onclick="guiBaoCao('dich-vu')">
                  <i class="fas fa-paper-plane"></i> Gửi báo cáo dịch vụ
                </button>
              </div>
            </div>

            <!-- =========================================
                 PHẦN FORM HƯ HỎNG (Loại 2)
                 POST → OnPostHuHong()
                 Lưu vào DONDV: LoaiDV='Hư hỏng', IDUser, IDPhong, NoiDung, MucDo
                 AnhBienLai → lưu file vào wwwroot/uploads/su-co/ (xem hướng dẫn cuối file)
            ========================================= -->
            <div class="phan-form" id="form-hu-hong">

              <!-- Số phòng: cố định theo phòng đang thuê của khách -->
              <div class="hang-form-2">
                <div class="nhom-truong">
                  <label class="nhan-truong">Số phòng <span class="bat-buoc">*</span></label>
                  <input type="text" class="truong-nhap" id="phong-hu-hong-hien-thi"
                    value="Phòng @Model.SoPhongHienTai" readonly
                    style="background:#f8fafc;color:var(--mau-chu);cursor:not-allowed;font-weight:600;" />
                  <input type="hidden" id="phong-hu-hong" name="PhongHuHong" value="@Model.IDPhongHienTai" />
                </div>
                <div class="nhom-truong">
                  <label class="nhan-truong">Ngày phát hiện <span class="bat-buoc">*</span></label>
                  <input type="date" class="truong-nhap" id="ngay-hu-hong" name="NgayHuHong" />
                </div>
              </div>

              <!-- Loại hư hỏng -->
              <div class="hang-form-2">
                <div class="nhom-truong">
                  <label class="nhan-truong">Loại hư hỏng <span class="bat-buoc">*</span></label>
                  <select class="truong-nhap" id="loai-hu-hong" name="LoaiHuHong">
                    <option value="">-- Chọn loại --</option>
                    <optgroup label="Hệ thống nước">
                      <option>Vòi nước bị rỉ / hỏng</option>
                      <option>Đường ống nước bị tắc</option>
                      <option>Bồn cầu hỏng</option>
                      <option>Bồn rửa thoát chậm</option>
                    </optgroup>
                    <optgroup label="Hệ thống điện">
                      <option>Điện bị mất trong phòng</option>
                      <option>Ổ cắm / công tắc hỏng</option>
                      <option>Bóng đèn hỏng</option>
                      <option>Quạt / điều hòa hỏng</option>
                    </optgroup>
                    <optgroup label="Cửa & Khóa">
                      <option>Khóa cửa hỏng</option>
                      <option>Cửa bị kẹt / khó đóng</option>
                      <option>Cửa sổ hỏng</option>
                    </optgroup>
                    <optgroup label="Thiết bị khác">
                      <option>Máy nước nóng hỏng</option>
                      <option>Tường bị thấm nước / mốc</option>
                      <option>Trần nhà bị dột</option>
                      <option>Sàn nhà bị hỏng</option>
                    </optgroup>
                    <option value="khac">Hư hỏng khác</option>
                  </select>
                </div>
                <div class="nhom-truong">
                  <label class="nhan-truong">Vị trí hư hỏng</label>
                  <select class="truong-nhap" id="vi-tri-hu-hong" name="ViTriHuHong">
                    <option value="">-- Chọn vị trí --</option>
                    <option>Trong phòng</option>
                    <option>Nhà vệ sinh / phòng tắm</option>
                    <option>Hành lang</option>
                    <option>Cầu thang</option>
                    <option>Khu vực chung</option>
                    <option>Mái / sân thượng</option>
                  </select>
                </div>
              </div>

              <!-- Mô tả -->
              <div class="hang-form-1">
                <label class="nhan-truong">Mô tả hư hỏng chi tiết <span class="bat-buoc">*</span></label>
                <textarea class="truong-nhap" rows="4" id="mo-ta-hu-hong-text" name="MoTaHuHong"
                  placeholder="Mô tả cụ thể hư hỏng bạn phát hiện. Ví dụ: Vòi nước trong phòng tắm bị rỉ liên tục từ 2 ngày nay, nước chảy không tắt được dù đã vặn chặt..."></textarea>
              </div>

              <!-- Mức độ nghiêm trọng -->
              <div class="hang-form-1">
                <label class="nhan-truong">Mức độ nghiêm trọng <span class="bat-buoc">*</span></label>
                <div class="nhom-muc-do">
                  <button type="button" class="chip-muc-do" onclick="chonMucDo(this,'thap','hu-hong')">
                    🟢 Nhẹ
                  </button>
                  <button type="button" class="chip-muc-do chon-trung" onclick="chonMucDo(this,'trung','hu-hong')">
                    🟡 Vừa
                  </button>
                  <button type="button" class="chip-muc-do" onclick="chonMucDo(this,'khan-cap','hu-hong')">
                    🔴 Nghiêm trọng
                  </button>
                </div>
                <input type="hidden" id="muc-do-hu-hong" name="MucDoHuHong" value="trung" />
              </div>

              <!-- Ảnh hư hỏng -->
              <div class="hang-form-1">
                <label class="nhan-truong">Ảnh hư hỏng <span style="color:var(--mau-chu-phu);font-weight:500;">(rất khuyến khích)</span></label>
                <div class="khu-anh-dinh-kem" onclick="document.getElementById('file-anh-hh').click()">
                  <i class="fas fa-camera"></i>
                  <p>Chụp ảnh hoặc tải ảnh hư hỏng lên</p>
                  <span>PNG, JPG, WEBP · Tối đa 5MB mỗi ảnh · Tối đa 5 ảnh</span>
                  <div class="xem-truoc-anh" id="xem-truoc-hh"></div>
                </div>
                @* Upload ảnh → lưu vào DONDV.AnhBienLai (xem hướng dẫn SQL + File cuối trang) *@
                <input type="file" id="file-anh-hh" name="FileAnhHuHong" accept="image/*" multiple style="display:none"
                  onchange="xemTruocAnh(this,'xem-truoc-hh')" />
              </div>

              <div class="nhom-nut-gui">
                <button type="button" class="nut-huy" onclick="datLaiForm('hu-hong')">
                  <i class="fas fa-redo"></i> Đặt lại
                </button>
                <button type="button" class="nut-gui-hu-hong" onclick="guiBaoCao('hu-hong')">
                  <i class="fas fa-paper-plane"></i> Gửi báo cáo hư hỏng
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- CỘT PHẢI: LỊCH SỬ + LIÊN HỆ -->
      <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Lịch sử báo cáo: load từ DONDV theo IDUser, sắp xếp NgayTao DESC -->
        <div class="card accent-xanh">
          <div class="card-header">
            <div class="icon-header"><i class="fas fa-history"></i></div>
            <h3>Lịch sử báo cáo</h3>
          </div>
          <div class="card-body" style="padding-top:8px;">
            <ul class="ds-lich-su">
              @foreach (var don in Model.LichSuBaoCao)
              {
                <li class="item-lich-su">
                  <div class="dot-loai @(don.TrangThai_DV == "Thành công" ? "hoan-tat" : don.TrangThai_DV == "Đã hủy" ? "huy" : "dich-vu")">
                    <i class="fas @(don.TrangThai_DV == "Thành công" ? "fa-check" : don.TrangThai_DV == "Đã hủy" ? "fa-times" : "fa-tint")"></i>
                  </div>
                  <div style="flex:1">
                    <div class="ten-su-co">@don.NoiDung</div>
                    <div class="ngay-su-co">@don.LoaiDV · @don.NgayTao.ToString("dd/MM/yyyy")</div>
                  </div>
                  <span class="badge-trang-thai @(don.TrangThai_DV == "Thành công" ? "hoan-tat" : don.TrangThai_DV == "Đang xử lý" ? "dang-xu-ly" : don.TrangThai_DV == "Đã hủy" ? "da-huy" : "cho-xu-ly")">
                    @don.TrangThai_DV
                  </span>
                </li>
              }
            </ul>
            <div style="text-align:center;padding-top:10px;">
              <button class="nut-huy" style="font-size:12px;padding:7px 16px;">
                <i class="fas fa-list"></i> Xem tất cả
              </button>
            </div>
          </div>
        </div>

        <!-- Liên hệ trực tiếp: load từ ACCOUNT (Roles='Manager') qua PHONG_MANAGER -->
        <div class="card accent-cam">
          <div class="card-header">
            <div class="icon-header"><i class="fas fa-phone-alt"></i></div>
            <h3>Liên hệ trực tiếp</h3>
          </div>
          <div class="card-body" style="padding-top:10px;">
            <div class="hop-lien-he">
              <div class="tieu-de-lh"><i class="fas fa-user-shield"></i> Thông tin liên hệ</div>
              <div class="hang-lh">
                <i class="fas fa-user"></i>
                <span class="lh-nhan">Quản lý:</span>
                <span class="lh-gia-tri">@Model.ThongTinQuanLy.FullName</span>
              </div>
              <div class="hang-lh">
                <i class="fas fa-phone"></i>
                <span class="lh-nhan">Điện thoại:</span>
                <span class="lh-gia-tri">@Model.ThongTinQuanLy.Phone</span>
              </div>
              <div class="hang-lh">
                <i class="fas fa-home"></i>
                <span class="lh-nhan">Chủ trọ:</span>
                <span class="lh-gia-tri">@Model.ThongTinChuTro.FullName</span>
              </div>
              <div class="hang-lh">
                <i class="fas fa-phone"></i>
                <span class="lh-nhan">Điện thoại:</span>
                <span class="lh-gia-tri">@Model.ThongTinChuTro.Phone</span>
              </div>
              <div class="hang-lh">
                <i class="fas fa-clock"></i>
                <span class="lh-nhan">Giờ làm:</span>
                <span class="lh-gia-tri">7h–21h hàng ngày</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div><!-- end layout-2-cot -->
  </main>
</div><!-- end khu-vuc-chinh -->


<!-- =============================================
     MODAL: GỬI THÀNH CÔNG
============================================= -->
<div class="lop-che-modal" id="modal-thanh-cong">
  <div class="hop-modal-thanh-cong">
    <div class="bieu-tuong-thanh-cong xanh-la">
      <i class="fas fa-check-circle"></i>
    </div>
    <h3>Đã gửi báo cáo thành công!</h3>
    <p id="noi-dung-thanh-cong">
      Báo cáo của bạn đã được gửi đến quản lý và chủ trọ.<br>
      Chúng tôi sẽ xử lý trong thời gian sớm nhất.
    </p>
    <div class="ma-bao-cao" id="ma-bao-cao-hien-thi">#SC-2025-0010</div>
    <button class="nut-dong-thanh-cong" onclick="dongThanhCong()">
      <i class="fas fa-check"></i> Đã hiểu
    </button>
  </div>
</div>


<!-- =============================================
     MODAL: HỒ SƠ CÁ NHÂN
============================================= -->
<div class="lop-che-modal-ho-so" id="modal-ho-so" onclick="if(event.target.id==='modal-ho-so') this.classList.remove('hien')">
  <div class="hop-modal">
    <div class="tieu-de-modal">
      <h3><i class="fas fa-user-circle" style="color:var(--mau-chu-de);"></i> Hồ sơ cá nhân</h3>
      <button class="nut-dong-modal" onclick="document.getElementById('modal-ho-so').classList.remove('hien')">✕</button>
    </div>
    <div style="display:flex;align-items:center;gap:16px;padding:14px 0 18px;border-bottom:1px solid var(--mau-vien);margin-bottom:16px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#1a56db,#60a5fa);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;color:#fff;border:3px solid #dbeafe;">
        @Model.KhachThue.FullName[0]
      </div>
      <div>
        <div style="font-size:18px;font-weight:800;">@Model.KhachThue.FullName</div>
        <div style="font-size:12px;color:var(--mau-chu-phu);margin-top:3px;">Phòng @Model.SoPhongHienTai · Nhà Trọ Bà Năm</div>
        <span style="display:inline-block;background:#dcfce7;color:#16a34a;font-size:11px;font-weight:700;padding:2px 10px;border-radius:20px;margin-top:5px;">● Đang hoạt động</span>
      </div>
    </div>
    <div class="hang-form">
      <div class="nhom-truong-nhap">
        <label class="nhan-truong-nhap">Họ và tên</label>
        <input class="truong-nhap-modal" type="text" value="@Model.KhachThue.FullName" />
      </div>
      <div class="nhom-truong-nhap">
        <label class="nhan-truong-nhap">Số điện thoại</label>
        <input class="truong-nhap-modal" type="text" value="@Model.KhachThue.Phone" />
      </div>
    </div>
    <div class="nhom-nut-modal">
      <button class="nut-huy-modal" onclick="document.getElementById('modal-ho-so').classList.remove('hien')">Hủy</button>
      <button class="nut-luu" onclick="alert('Đã lưu!'); document.getElementById('modal-ho-so').classList.remove('hien')">
        <i class="fas fa-save"></i> Lưu thay đổi
      </button>
    </div>
  </div>
</div>


<!-- =============================================
     JAVASCRIPT
============================================= -->
<script>
  // ===== NGÀY GIỜ =====
  (function() {
    const days = ['CN','T2','T3','T4','T5','T6','T7'];
    const now = new Date();
    const dd = String(now.getDate()).padStart(2,'0');
    const mm = String(now.getMonth()+1).padStart(2,'0');
    const yy = now.getFullYear();
    document.getElementById('headerDate').textContent = `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;

    // Set default date = today
    const todayStr = `${yy}-${mm}-${dd}`;
    document.getElementById('ngay-dich-vu').value = todayStr;
    document.getElementById('ngay-hu-hong').value = todayStr;
  })();

  // ===== SIDEBAR =====
  function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
  }

  // ===== CHUYỂN TRANG =====
  function chuyenTrang(tenTrang, phanTu) {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
    phanTu.classList.add('dang-chon');
    const bang = {
      'trang-chu':  '/KhachThue/KhachThue',
      'thanh-toan': '/KhachThue/ThanhToan',
      'tien-ich':   '/KhachThue/TienIch',
      'bao-su-co':  '/KhachThue/BaoSuCo',
      'thong-bao':  '/KhachThue/ThongBao',
      'ho-so':      '/KhachThue/HoSo',
      'cai-dat':    '/KhachThue/CaiDat',
        'trang-quan-ly':'/Manager/Manager',
    };
    if (bang[tenTrang]) {
      window.location.href = bang[tenTrang];
    }
  }

  // ===== CHỌN LOẠI BÁO CÁO =====
  function chonLoai(loai, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('mo-ta-dich-vu').classList.remove('hien');
    document.getElementById('mo-ta-hu-hong').classList.remove('hien');
    document.getElementById('mo-ta-' + loai).classList.add('hien');
    document.querySelectorAll('.phan-form').forEach(f => f.classList.remove('hien'));
    document.getElementById('form-' + loai).classList.add('hien');
  }

  // ===== CHỌN DỊCH VỤ VI PHẠM =====
  var dichVuDaChon = [];
  function chonDichVu(el, ma) {
    if (el.classList.contains('chon')) {
      el.classList.remove('chon');
      dichVuDaChon = dichVuDaChon.filter(v => v !== ma);
    } else {
      el.classList.add('chon');
      dichVuDaChon.push(ma);
    }
    document.getElementById('dich-vu-da-chon').value = dichVuDaChon.join(',');
  }

  // ===== CHỌN MỨC ĐỘ =====
  function chonMucDo(el, mucDo, loai) {
    const parent = el.parentElement;
    parent.querySelectorAll('.chip-muc-do').forEach(c => {
      c.classList.remove('chon-thap','chon-trung','chon-khan-cap');
    });
    el.classList.add('chon-' + mucDo);
    document.getElementById('muc-do-' + loai).value = mucDo;
  }

  // ===== XEM TRƯỚC ẢNH =====
  function xemTruocAnh(input, containerId) {
    const container = document.getElementById(containerId);
    container.innerHTML = '';
    const files = Array.from(input.files).slice(0, 5);
    files.forEach(file => {
      const reader = new FileReader();
      reader.onload = e => {
        const img = document.createElement('img');
        img.src = e.target.result;
        img.className = 'thumb-anh';
        container.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  }

  // ===== GỬI BÁO CÁO (AJAX POST) =====
  async function guiBaoCao(loai) {
    let isValid = true;

    if (loai === 'dich-vu') {
      const phong = document.getElementById('phong-dich-vu').value;
      const ngay  = document.getElementById('ngay-dich-vu').value;
      const moTa  = document.getElementById('mo-ta-dich-vu-text').value.trim();
      const dv    = document.getElementById('dich-vu-da-chon').value;

      if (!phong) { alert('Vui lòng chọn số phòng!'); return; }
      if (!ngay)  { alert('Vui lòng chọn ngày xảy ra!'); return; }
      if (!dv)    { alert('Vui lòng chọn dịch vụ không được thực hiện!'); return; }
      if (!moTa)  { alert('Vui lòng mô tả chi tiết sự cố!'); return; }
    } else {
      const phong   = document.getElementById('phong-hu-hong').value;
      const ngay    = document.getElementById('ngay-hu-hong').value;
      const loaiHH  = document.getElementById('loai-hu-hong').value;
      const moTa    = document.getElementById('mo-ta-hu-hong-text').value.trim();

      if (!phong)   { alert('Vui lòng chọn số phòng!'); return; }
      if (!ngay)    { alert('Vui lòng chọn ngày phát hiện!'); return; }
      if (!loaiHH)  { alert('Vui lòng chọn loại hư hỏng!'); return; }
      if (!moTa)    { alert('Vui lòng mô tả hư hỏng chi tiết!'); return; }
    }

    // Build FormData để gửi kèm file ảnh
    const formData = new FormData();
    formData.append('loai', loai);

    if (loai === 'dich-vu') {
      formData.append('PhongDichVu',    document.getElementById('phong-dich-vu').value);
      formData.append('NgayDichVu',     document.getElementById('ngay-dich-vu').value);
      formData.append('DichVuDaChon',   document.getElementById('dich-vu-da-chon').value);
      formData.append('BuoiDichVu',     document.getElementById('buoi-dich-vu').value);
      formData.append('DaNhac',         document.getElementById('da-nhac').value);
      formData.append('MoTaDichVu',     document.getElementById('mo-ta-dich-vu-text').value);
      formData.append('MucDoDichVu',    document.getElementById('muc-do-dich-vu').value);
      const filesDV = document.getElementById('file-anh-dv').files;
      for (let f of filesDV) formData.append('FileAnhDichVu', f);
    } else {
      formData.append('PhongHuHong',    document.getElementById('phong-hu-hong').value);
      formData.append('NgayHuHong',     document.getElementById('ngay-hu-hong').value);
      formData.append('LoaiHuHong',     document.getElementById('loai-hu-hong').value);
      formData.append('ViTriHuHong',    document.getElementById('vi-tri-hu-hong').value);
      formData.append('MoTaHuHong',     document.getElementById('mo-ta-hu-hong-text').value);
      formData.append('MucDoHuHong',    document.getElementById('muc-do-hu-hong').value);
      const filesHH = document.getElementById('file-anh-hh').files;
      for (let f of filesHH) formData.append('FileAnhHuHong', f);
    }

    formData.append('__RequestVerificationToken',
      document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');

    try {
      const res  = await fetch('?handler=GuiBaoCao', { method: 'POST', body: formData });
      const data = await res.json();

      if (data.success) {
        const loaiText = loai === 'dich-vu' ? 'dịch vụ' : 'hư hỏng';
        document.getElementById('noi-dung-thanh-cong').innerHTML =
          `Báo cáo <strong>${loaiText}</strong> của bạn đã được gửi đến quản lý và chủ trọ.<br>Chúng tôi sẽ xử lý trong vòng <strong>24 giờ</strong>.`;
        document.getElementById('ma-bao-cao-hien-thi').textContent = data.maBaoCao;
        document.getElementById('modal-thanh-cong').classList.add('hien');
      } else {
        alert('Gửi thất bại: ' + data.message);
      }
    } catch (err) {
      alert('Có lỗi xảy ra, vui lòng thử lại!');
    }
  }

  function dongThanhCong() {
    document.getElementById('modal-thanh-cong').classList.remove('hien');
    window.location.reload();
  }

  // ===== ĐẶT LẠI FORM =====
  function datLaiForm(loai) {
    if (loai === 'dich-vu') {
      document.getElementById('mo-ta-dich-vu-text').value = '';
      document.getElementById('buoi-dich-vu').value = '';
      document.getElementById('da-nhac').value = 'chua';
      document.getElementById('xem-truoc-dv').innerHTML = '';
      dichVuDaChon = [];
      document.getElementById('dich-vu-da-chon').value = '';
      document.querySelectorAll('.chip-dich-vu').forEach(c => c.classList.remove('chon'));
      document.querySelectorAll('#form-dich-vu .chip-muc-do').forEach(c => {
        c.classList.remove('chon-thap','chon-trung','chon-khan-cap');
      });
      document.querySelector('#form-dich-vu .chip-muc-do:nth-child(2)').classList.add('chon-trung');
      document.getElementById('muc-do-dich-vu').value = 'trung';
    } else {
      document.getElementById('loai-hu-hong').value = '';
      document.getElementById('vi-tri-hu-hong').value = '';
      document.getElementById('mo-ta-hu-hong-text').value = '';
      document.getElementById('xem-truoc-hh').innerHTML = '';
      document.querySelectorAll('#form-hu-hong .chip-muc-do').forEach(c => {
        c.classList.remove('chon-thap','chon-trung','chon-khan-cap');
      });
      document.querySelector('#form-hu-hong .chip-muc-do:nth-child(2)').classList.add('chon-trung');
      document.getElementById('muc-do-hu-hong').value = 'trung';
    }
  }

  // ===== HỒ SƠ =====
  function moHoSo() {
    document.getElementById('modal-ho-so').classList.add('hien');
  }
</script>

@Html.AntiForgeryToken()

</body>
</html>
