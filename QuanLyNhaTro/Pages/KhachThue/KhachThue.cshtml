    <script>
            // Chuyển sang trang Tiện Ích
            function chuyenTienIch(event) {
                if (event) event.preventDefault();
                window.location.href = '/TienIch';
            }

            // Chuyển sang trang Thanh Toán / Hóa đơn
            function chuyenThanhToan(event) {
                if (event) event.preventDefault();
                window.location.href = '/ThanhToan';
            }

            // Chuyển sang trang Sự Cố / Báo Trì
            function chuyenSuCo(event) {
                if (event) event.preventDefault();
                window.location.href = '/SuCo';
            }

            // Chuyển sang trang Cài Đặt (thay CSKH)
            function chuyenCaiDat(event) {
                if (event) event.preventDefault();
                window.location.href = '/CaiDat';
            }

            // Mở trang Thông Báo
            function chuyenThongBao(event) {
                if (event) event.preventDefault();
                window.location.href = '/ThongBao';
                return false;
            }

            // Mở trang Hồ Sơ cá nhân
            function moHoSo() {
                window.location.href = '/HoSo';
            }

            // Mở dropdown thông báo (tùy chỉnh logic thêm)
            function moThongBao() {
                window.location.href = '/ThongBao';
            }

            // Mở dropdown tài khoản (tùy chỉnh logic thêm)
            function moTaiKhoan() {
                window.location.href = '/CaiDat';
            }
    </script>

