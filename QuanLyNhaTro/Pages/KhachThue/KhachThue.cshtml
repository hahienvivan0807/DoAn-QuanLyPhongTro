@page
@model QuanLyNhaTro.Pages.KhachThue.KhachThueModel
@{
    ViewData["title"] = "Trang khách thuê";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nhà Trọ ABC – Trang Chủ</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* =============================================
       BIẾN CSS TOÀN CỤC (Design Tokens)
    ============================================= */
    :root {
      --primary:       #2563eb;
      --primary-dark:  #1e3a8a;
      --primary-soft:  #eff6ff;
      --primary-light: #bfdbfe;

      --green:         #059669;
      --green-soft:    #d1fae5;
      --amber:         #d97706;
      --amber-soft:    #fef3c7;
      --red:           #dc2626;
      --red-soft:      #fee2e2;
      --purple-soft:   #ede9fe;

      --text-900:      #0f172a;
      --text-600:      #475569;
      --text-400:      #94a3b8;

      --border:        #e2e8f0;
      --bg-page:       #f8fafc;
      --bg-card:       #ffffff;

      --sidebar-w:     230px;
      --header-h:      58px;
      --radius-lg:     14px;
      --radius-md:     10px;
      --radius-sm:     7px;

      --shadow-sm:     0 1px 3px rgba(0,0,0,0.07), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md:     0 4px 20px rgba(37,99,235,0.10);
      --shadow-card:   0 2px 8px rgba(15,23,42,0.06);

      --font:          'Be Vietnam Pro', sans-serif;
      --speed:         0.24s;
    }

    /* =============================================
       RESET & BASE
    ============================================= */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font);
      background: var(--bg-page);
      color: var(--text-900);
      min-height: 100vh;
      overflow-x: hidden;
    }


    /* =============================================
       LAYOUT CHÍNH: SIDEBAR + HEADER + MAIN
    ============================================= */
    .layout {
      display: flex;
      min-height: 100vh;
    }


    /* =============================================
       SIDEBAR – Thanh điều hướng bên trái
    ============================================= */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--primary-dark);
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: width var(--speed) cubic-bezier(.4,0,.2,1),
                  transform var(--speed) cubic-bezier(.4,0,.2,1);
    }
    .sidebar.closed { width: 0; overflow: hidden; }

    /* Logo trong sidebar */
    .sidebar-logo {
      padding: 18px 16px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: var(--sidebar-w);
    }
    .logo-icon {
      width: 38px; height: 38px;
      background: var(--primary);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; font-weight: 800; color: #fff;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(37,99,235,0.4);
    }
    .logo-name { font-size: 13px; font-weight: 800; color: #fff; letter-spacing: -0.2px; }
    .logo-sub  { font-size: 10px; color: rgba(255,255,255,0.38); margin-top: 1px; }

    /* Nhãn nhóm menu */
    .nav-label {
      padding: 14px 16px 4px;
      font-size: 9.5px; font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.28);
      min-width: var(--sidebar-w);
    }

    /* Item menu */
    .nav-item {
      display: flex; align-items: center; gap: 9px;
      margin: 1px 8px;
      padding: 8px 11px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      text-decoration: none;
      color: rgba(255,255,255,0.60);
      font-size: 12.5px; font-weight: 600;
      transition: background .16s, color .16s;
      min-width: calc(var(--sidebar-w) - 16px);
      white-space: nowrap;
    }
    .nav-item:hover  { background: rgba(255,255,255,0.08); color: #fff; }
    .nav-item.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 3px 12px rgba(37,99,235,0.4);
    }
    .nav-icon { font-size: 15px; width: 20px; text-align: center; flex-shrink: 0; }
    .nav-badge {
      margin-left: auto;
      background: var(--red);
      color: #fff;
      font-size: 9px; font-weight: 700;
      padding: 1px 6px;
      border-radius: 20px;
    }

    /* Thông tin user ở cuối sidebar */
    .sidebar-footer {
      margin-top: auto;
      padding: 11px 14px;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex; align-items: center; gap: 9px;
      min-width: var(--sidebar-w);
    }
    .ava-sm {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #93c5fd);
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 800; color: #fff;
      flex-shrink: 0;
    }
    .footer-name { font-size: 11.5px; font-weight: 700; color: #fff; }
    .footer-role { font-size: 10px; color: rgba(255,255,255,0.38); }


    /* =============================================
       HEADER – Thanh trên cùng cố định
    ============================================= */
    .header {
      position: fixed;
      top: 0;
      left: var(--sidebar-w);
      right: 0;
      height: var(--header-h);
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center;
      justify-content: space-between;
      padding: 0 22px;
      z-index: 100;
      box-shadow: var(--shadow-sm);
      transition: left var(--speed) cubic-bezier(.4,0,.2,1);
    }
    .header.wide { left: 0; }

    .header-left { display: flex; align-items: center; gap: 12px; }

    /* Nút hamburger mở/đóng sidebar */
    .hamburger {
      width: 34px; height: 34px;
      border: none; background: var(--primary-soft);
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 4px;
      transition: background .18s;
    }
    .hamburger:hover { background: var(--primary-light); }
    .hline {
      display: block; width: 15px; height: 2px;
      background: var(--primary-dark); border-radius: 2px;
      transition: transform var(--speed), opacity var(--speed);
    }
    .hamburger.open .hline:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .hamburger.open .hline:nth-child(2) { opacity: 0; }
    .hamburger.open .hline:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .page-title { font-size: 15px; font-weight: 800; color: var(--text-900); }
    .breadcrumb { font-size: 10.5px; color: var(--text-400); margin-top: 1px; }

    .header-right { display: flex; align-items: center; gap: 10px; }

    .hdr-date {
      font-size: 11.5px; font-weight: 600; color: var(--text-600);
      background: var(--bg-page);
      padding: 5px 10px; border-radius: var(--radius-sm);
      border: 1px solid var(--border);
    }
    .hdr-bell {
      position: relative;
      width: 34px; height: 34px;
      border: none; background: var(--primary-soft);
      border-radius: var(--radius-sm);
      cursor: pointer; font-size: 15px;
      display: flex; align-items: center; justify-content: center;
      transition: background .18s;
    }
    .hdr-bell:hover { background: var(--primary-light); }
    .bell-dot {
      position: absolute; top: 6px; right: 6px;
      width: 7px; height: 7px;
      background: var(--red); border-radius: 50%;
      border: 1.5px solid white;
    }
    .hdr-user {
      display: flex; align-items: center; gap: 8px;
      padding: 5px 10px; border-radius: var(--radius-sm);
      cursor: pointer; transition: background .18s;
    }
    .hdr-user:hover { background: var(--bg-page); }
    .ava-md {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #93c5fd);
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 800; color: #fff;
    }
    .hdr-uname { font-size: 11.5px; font-weight: 700; color: var(--text-900); }
    .hdr-urole { font-size: 10px; color: var(--text-400); }


    /* =============================================
       MAIN CONTENT – Vùng nội dung chính
    ============================================= */
    .main {
      margin-left: var(--sidebar-w);
      margin-top: var(--header-h);
      padding: 18px 22px;
      min-height: calc(100vh - var(--header-h));
      transition: margin-left var(--speed) cubic-bezier(.4,0,.2,1);
    }
    .main.wide { margin-left: 0; }


    /* =============================================
       GREETING BAR – Dòng chào đầu trang
    ============================================= */
    .greeting {
      display: flex; align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }
    .greeting-title { font-size: 18px; font-weight: 800; color: var(--text-900); letter-spacing: -0.3px; }
    .greeting-sub   { font-size: 12px; color: var(--text-600); margin-top: 2px; }
    .status-pill {
      display: flex; align-items: center; gap: 6px;
      background: var(--green-soft); color: var(--green);
      font-size: 11.5px; font-weight: 700;
      padding: 5px 13px; border-radius: 20px;
    }
    .status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 2px rgba(5,150,105,0.25);
    }


    /* =============================================
       STATS STRIP – Hàng số liệu nhanh
    ============================================= */
    .stats-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: var(--shadow-card);
      transition: box-shadow .2s, transform .2s;
    }
    .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .stat-icon-wrap {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .stat-info {}
    .stat-num  { font-size: 22px; font-weight: 800; line-height: 1; }
    .stat-desc { font-size: 11px; color: var(--text-400); margin-top: 2px; }


    /* =============================================
       GRID CHÍNH – 3 cột nội dung
    ============================================= */
    .content-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr 0.9fr;
      gap: 14px;
      margin-bottom: 14px;
    }


    /* =============================================
       CARD CHUNG – Khung thẻ tái sử dụng
    ============================================= */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      display: flex; flex-direction: column;
      overflow: hidden;
      transition: box-shadow .2s, transform .2s;
    }
    .card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }

    /* Đầu card */
    .card-head {
      display: flex; align-items: center; gap: 9px;
      padding: 13px 16px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }
    .chead-icon {
      width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; flex-shrink: 0;
    }
    .card-title { font-size: 12.5px; font-weight: 800; color: var(--text-900); }
    .card-action {
      margin-left: auto;
      font-size: 11px; font-weight: 700; color: var(--primary);
      background: var(--primary-soft);
      padding: 3px 9px; border-radius: 6px;
      cursor: pointer; text-decoration: none;
      transition: background .18s;
    }
    .card-action:hover { background: var(--primary-light); }

    /* Thân card */
    .card-body { padding: 14px 16px; flex: 1; }


    /* =============================================
       CARD: THÔNG TIN CÁ NHÂN
    ============================================= */
    .profile-wrap {
      display: flex; align-items: flex-start; gap: 13px;
      margin-bottom: 12px;
    }
    .ava-xl {
      width: 56px; height: 56px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, #60a5fa 100%);
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; font-weight: 800; color: #fff;
      flex-shrink: 0;
      border: 3px solid var(--primary-light);
      position: relative;
    }
    .online-ring {
      position: absolute; bottom: 1px; right: 1px;
      width: 12px; height: 12px; border-radius: 50%;
      background: var(--green);
      border: 2px solid white;
    }
    .profile-meta {}
    .pname { font-size: 14px; font-weight: 800; color: var(--text-900); }
    .pbadge {
      display: inline-block;
      background: var(--primary-soft); color: var(--primary);
      font-size: 10.5px; font-weight: 700;
      padding: 2px 8px; border-radius: 20px;
      margin: 5px 0 7px;
    }
    .prow {
      display: flex; align-items: center; gap: 6px;
      font-size: 11px; color: var(--text-600); margin-bottom: 4px;
    }
    .prow-icon { font-size: 13px; width: 16px; text-align: center; }
    .btn-profile {
      width: 100%; padding: 8px;
      background: var(--primary); color: #fff;
      border: none; border-radius: var(--radius-sm);
      font-family: var(--font); font-size: 12px; font-weight: 700;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(37,99,235,0.28);
      transition: background .18s, box-shadow .18s;
      margin-bottom: 12px;
    }
    .btn-profile:hover { background: #1d4ed8; }
    .divider { height: 1px; background: var(--border); margin-bottom: 12px; }

    /* Mini stats trong card profile */
    .mini-stats { display: flex; gap: 8px; }
    .mini-stat {
      flex: 1; background: var(--bg-page);
      border-radius: var(--radius-sm);
      padding: 8px 6px; text-align: center;
    }
    .ms-num { font-size: 17px; font-weight: 800; color: var(--text-900); }
    .ms-lbl { font-size: 9.5px; color: var(--text-400); margin-top: 1px; }


    /* =============================================
       CARD: THÔNG BÁO
    ============================================= */
    .notif-list { list-style: none; }
    .notif-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
    }
    .notif-item:last-child { border-bottom: none; }
    .ndot {
      width: 7px; height: 7px; border-radius: 50%;
      flex-shrink: 0; margin-top: 5px;
    }
    .nd-blue  { background: var(--primary); }
    .nd-amber { background: var(--amber); }
    .nd-green { background: var(--green); }
    .nd-red   { background: var(--red); }
    .notif-text { font-size: 11.5px; font-weight: 600; color: var(--text-900); line-height: 1.4; }
    .notif-time { font-size: 10px; color: var(--text-400); margin-top: 2px; }


    /* =============================================
       CARD: TIỆN ÍCH NHANH
    ============================================= */
    .quick-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .quick-item {
      display: flex; flex-direction: column; align-items: flex-start; gap: 5px;
      padding: 11px 11px;
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      text-decoration: none; cursor: pointer;
      transition: background .18s, box-shadow .18s, transform .18s;
    }
    .quick-item:hover {
      background: var(--primary-soft);
      box-shadow: var(--shadow-sm);
      transform: translateY(-1px);
    }
    .qi-icon {
      width: 32px; height: 32px; border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px;
    }
    .qi-name { font-size: 11.5px; font-weight: 700; color: var(--text-900); }
    .qi-desc { font-size: 10px; color: var(--text-400); line-height: 1.3; }


    /* =============================================
       CARD: LIÊN HỆ NHÀ TRỌ – Full width bên dưới
    ============================================= */
    .contact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: box-shadow .2s;
    }
    .contact-card:hover { box-shadow: var(--shadow-md); }

    /* Nội dung bên trong contact card */
    .contact-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      padding: 14px 16px;
    }
    .contact-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .crow {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 11px;
      background: var(--bg-page);
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
    }
    .crow-icon {
      width: 28px; height: 28px; border-radius: 7px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; flex-shrink: 0;
    }
    .crow-label { font-size: 10px; color: var(--text-400); font-weight: 600; }
    .crow-value { font-size: 12px; font-weight: 700; color: var(--text-900); margin-top: 1px; }

    /* Ô bản đồ giả */
    .map-box {
      width: 185px;
      background: linear-gradient(135deg, var(--primary-soft) 0%, var(--purple-soft) 100%);
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 5px; padding: 14px; text-align: center;
    }
    .map-emoji { font-size: 30px; }
    .map-title { font-size: 12px; font-weight: 700; color: var(--primary-dark); }
    .map-addr  { font-size: 10.5px; color: var(--text-600); line-height: 1.4; }


    /* =============================================
       RESPONSIVE – Mobile
    ============================================= */
    @@media (max-width: 900px) {
      .content-grid { grid-template-columns: 1fr 1fr; }
      .stats-strip  { grid-template-columns: 1fr 1fr 1fr; }
      .contact-rows { grid-template-columns: 1fr; }
    }
    @@media (max-width: 620px) {
      .content-grid { grid-template-columns: 1fr; }
      .stats-strip  { grid-template-columns: 1fr 1fr; }
      .sidebar { width: 0; }
      .main, .header { margin-left: 0; left: 0; }
      .map-box { display: none; }
    }
  </style>
</head>
<body>

<!-- =============================================
     LAYOUT WRAPPER – Bọc toàn bộ trang
============================================= -->
<div class="layout">

  <!-- =============================================
       SIDEBAR – Thanh điều hướng bên trái
  ============================================= -->
  <aside class="sidebar" id="sidebar">

    <!-- Logo thương hiệu -->
    <div class="sidebar-logo">
      <div class="logo-icon">A</div>
      <div>
        <div class="logo-name">Nhà Trọ ABC</div>
        <div class="logo-sub">Khách thuê</div>
      </div>
    </div>

    <!-- Nhóm menu Chính -->
    <div class="nav-label">Chính</div>
    <a href="#" class="nav-item active">
      <span class="nav-icon">🏠</span> Trang chủ
    </a>
    <a href="#" class="nav-item">
      <span class="nav-icon">💳</span> Thanh toán
      <span class="nav-badge">1</span>
    </a>
    <a href="#" class="nav-item">
      <span class="nav-icon">⚡</span> Tiện ích
    </a>
    <a href="#" class="nav-item">
      <span class="nav-icon">🔧</span> Báo sự cố
    </a>

    <!-- Nhóm menu Khác -->
    <div class="nav-label">Khác</div>
    <a href="#" class="nav-item">
      <span class="nav-icon">🔔</span> Thông báo
      <span class="nav-badge">4</span>
    </a>
    <a href="#" class="nav-item">
      <span class="nav-icon">👤</span> Hồ sơ
    </a>
    <a href="#" class="nav-item">
      <span class="nav-icon">⚙️</span> Cài đặt
    </a>

    <!-- Thông tin người dùng cuối sidebar -->
    <div class="sidebar-footer">
      <div class="ava-sm">T</div>
      <div>
        <div class="footer-name">Trần Duy Hơn</div>
        <div class="footer-role">Khách thuê</div>
      </div>
    </div>

  </aside>
  <!-- /SIDEBAR -->


  <!-- =============================================
       HEADER – Thanh tiêu đề cố định trên cùng
  ============================================= -->
  <header class="header" id="header">

    <!-- Bên trái: nút mở sidebar + tiêu đề trang -->
    <div class="header-left">
      <button class="hamburger open" id="hamburger" onclick="toggleSidebar()">
        <span class="hline"></span>
        <span class="hline"></span>
        <span class="hline"></span>
      </button>
      <div>
        <div class="page-title">Tổng quan</div>
        <div class="breadcrumb">Trang chủ / Dashboard</div>
      </div>
    </div>

    <!-- Bên phải: ngày, chuông, avatar -->
    <div class="header-right">
      <div class="hdr-date" id="headerDate"></div>
      <button class="hdr-bell" onclick="alert('Thông báo')">
        🔔 <span class="bell-dot"></span>
      </button>
      <div class="hdr-user" onclick="alert('Hồ sơ')">
        <div class="ava-md">T</div>
        <div>
          <div class="hdr-uname">Trần Duy Hơn</div>
          <div class="hdr-urole">Phòng 201</div>
        </div>
      </div>
    </div>

  </header>
  <!-- /HEADER -->


  <!-- =============================================
       MAIN – Vùng nội dung chính
  ============================================= -->
  <main class="main" id="main">

    <!-- Dòng chào và trạng thái -->
    <div class="greeting">
      <div>
        <div class="greeting-title">Xin chào, Duy Hơn 👋</div>
