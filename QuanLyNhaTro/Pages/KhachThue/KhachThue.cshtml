    @page "/KhachThue/KhachThue"
    @model QuanLyNhaTro.Pages.KhachThue.KhachThueModel
    @{
        ViewData["title"] = "Trang khách thuê";
        Layout = null;

        // Helpers dùng trong view — tất cả đều null-safe
        string tenHienThi = Model.TenantInfo?.FullName ?? "Khách thuê";
        string tenVietTat = tenHienThi.Trim().Length > 0
            ? tenHienThi.Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[0].ToString().ToUpper()
            : "?";
        string tenNgan = tenHienThi.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? tenHienThi;
        string soPhongHienThi = Model.PhongHienTai?.SoPhong ?? "---";
        string tangHienThi = Model.PhongHienTai != null ? $"Khu {Model.PhongHienTai.Khu}" : "";
    }
    <!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Nhà Trọ Bà Năm – Khách Thuê</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
        <script src="/js/Khach/KhachThue.js"></script>
        <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link href="~/css/KhachThue/KhachThue.css" rel="stylesheet" />
    </head>
    <body>

        <!-- SIDEBAR -->
        <nav id="thanh-sidebar">
            <div class="logo-sidebar">
                <img src="~/images/logo.png" alt="Logo Nhà Trọ ABC" class="logo-img" />
                <div class="ten-logo">
                    <strong>Nhà Trọ Bà Năm</strong>
                    <span>Cổng khách thuê</span>
                </div>
            </div>

            <div class="nhan-nhom">Tổng quan</div>
            <a href="/KhachThue/KhachThue" class="menu-item dang-chon" onclick="chuyenTrang('trang-chu', this); return false;">
                <i class="fas fa-home"></i><span>Trang chủ</span>
            </a>
            <a href="/Manager/Manager" class="menu-item" onclick="chuyenTrang('trang-quan-ly', this); return false;">
                <i class="fas fa-home"></i><span>Trang Quản Lý</span>
            </a>

            <div class="nhan-nhom">Dịch vụ</div>
            <a href="/KhachThue/ThanhToan" class="menu-item" onclick="chuyenTrang('thanh-toan', this); return false;">
                <i class="fas fa-credit-card"></i><span>Thanh toán</span>
                @if (Model.SoHoaDonTreHan > 0)
                {
                    <span class="huy-hieu-menu">@Model.SoHoaDonTreHan</span>
                }
            </a>
            <a href="/KhachThue/TienIch" class="menu-item" onclick="chuyenTrang('tien-ich', this); return false;">
                <i class="fas fa-bolt"></i><span>Dịch vụ &amp; Tiện ích</span>
            </a>
            <a href="/KhachThue/BaoSuCo" class="menu-item" onclick="chuyenTrang('bao-su-co', this); return false;">
                <i class="fas fa-tools"></i><span>Báo sự cố</span>
            </a>

            <div class="nhan-nhom">Cá nhân</div>
            <a href="/KhachThue/ThongBao" class="menu-item" onclick="chuyenTrang('thong-bao', this); return false;">
                <i class="fas fa-bell"></i><span>Thông báo</span>
                @if (Model.SoThongBaoChuaDoc > 0)
                {
                    <span class="huy-hieu-menu">@Model.SoThongBaoChuaDoc</span>
                }
            </a>
            <a href="/KhachThue/HoSo" class="menu-item" onclick="chuyenTrang('ho-so', this); return false;">
                <i class="fas fa-user-circle"></i><span>Hồ sơ</span>
            </a>
            <a href="/KhachThue/CaiDat" class="menu-item" onclick="chuyenTrang('cai-dat', this); return false;">
                <i class="fas fa-cog"></i><span>Cài đặt</span>
            </a>

            <div class="khach-thue-footer">
                <div class="anh-khach online-badge">@tenVietTat</div>
                <div class="ten-khach">
                    <strong>@tenHienThi</strong>
                    <span>Phòng @soPhongHienThi · @tangHienThi</span>
                </div>
            </div>
        </nav>

        <!-- KHU VỰC CHÍNH -->
        <div id="khu-vuc-chinh">

            <!-- HEADER -->
            <header id="thanh-header">
                <div class="header-trai">
                    <button class="nut-ham-menu" onclick="dongMoSidebar()">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <div class="tieu-de-trang">Trang Khách Thuê</div>
                        <div class="duong-dan">Trang chủ / Tổng quan</div>
                    </div>
                </div>

                <div class="header-phai">
                    <div class="hdr-date" id="headerDate"></div>
                    <button class="nut-thong-bao" onclick="moThongBao()">
                        <i class="fas fa-bell"></i>
                        @if (Model.SoThongBaoChuaDoc > 0)
                        {
                            <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                        }
                    </button>
                    <div class="thong-tin-khach" id="ktHeaderWrap">
                        <button onclick="ktToggleMenu()" id="ktHeaderBtn"
                                style="display:flex;align-items:center;gap:10px;cursor:pointer;
                                        padding:6px 12px;border-radius:24px;border:none;background:none;
                                        font-family:'Be Vietnam Pro',sans-serif;transition:background 0.2s;"
                                onmouseover="this.style.background='var(--mau-xanh-nhat)'"
                                onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien">@tenVietTat</div>
                        <div>
                            <div class="ten">@tenHienThi</div>
                            <div class="phong-so">Phòng @soPhongHienThi</div>
                        </div>
                        <i class="fas fa-chevron-down" id="ktChevron"
                            style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;transition:transform 0.2s;"></i>
                        </button>

                        <div class="kt-dropdown" id="ktDropdown">

                        <div class="kt-dd-header">
                            <div class="kt-dd-top">
                            <div class="kt-dd-ava">@tenVietTat</div>
                            <div>
                                <div class="kt-dd-name">@tenHienThi</div>
                                <div class="kt-dd-sub">@(Model.TenantInfo?.Email ?? "Chưa cập nhật")</div>
                                <span class="kt-dd-status">
                                <span class="kt-status-dot"></span>
                                Đang hoạt động
                                </span>
                            </div>
                            </div>
                            <div class="kt-dd-room">
                            <i class="fas fa-door-open"></i>
                            <div>
                                <div class="kt-dd-room-label">Phòng đang thuê</div>
                                <div class="kt-dd-room-val">Phòng @soPhongHienThi · @tangHienThi</div>
                            </div>
                            </div>
                        </div><!---->

                        <div class="kt-dd-body">
                            <button class="kt-item" onclick="ktMoDoiMatKhau()">
                            <div class="kt-item-icon blue"><i class="fas fa-key"></i></div>
                            <div>
                                <div class="kt-item-label">Đổi mật khẩu</div>
                                <div class="kt-item-sub">Cập nhật mật khẩu đăng nhập</div>
                            </div>
                            </button>
                            <div class="kt-divider"></div>
                            <button class="kt-item danger" onclick="ktXacNhanDangXuat()">
                            <div class="kt-item-icon red"><i class="fas fa-sign-out-alt"></i></div>
                            <div>
                                <div class="kt-item-label">Đăng xuất</div>
                                <div class="kt-item-sub">Thoát khỏi hệ thống</div>
                            </div>
                            </button>
                        </div>

                        </div>
                    </div>
                </div>
            </header>

            <!-- NỘI DUNG CHÍNH -->
            <main id="noi-dung-chinh">

                <!-- Dòng chào -->
                <div class="hang-chao-mung">
                    <div>
                        <h2>Xin chào, @tenNgan! 👋</h2>
                        <p id="ngay-gio-hien-tai">Đang tải...</p>
                    </div>
                    <div class="trang-thai-pill">
                        <div class="trang-thai-dot"></div>
                        Phòng @soPhongHienThi · Đang hoạt động
                    </div>
                </div>

                <!-- HÀNG 1: 3 CARD THỐNG KÊ -->
                <div class="hang-thong-ke">

                    <div class="card-thong-ke mau-xanh">
                        <div class="card-noi-dung">
                            <div class="bieu-tuong-card"><i class="fas fa-calendar-check"></i></div>
                            <div class="so-lieu">
                                <div class="con-so" style="color:var(--mau-chu-de);">@Model.SoThangDaThue</div>
                                <div class="ten-thong-ke">Tháng đã thuê</div>
                                <span class="nhan-trang-thai tot">✓ Hợp đồng còn hiệu lực</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-thong-ke mau-do">
                        <div class="card-noi-dung">
                            <div class="bieu-tuong-card"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div class="so-lieu">
                                <div class="con-so" style="color:var(--mau-do);">@Model.SoHoaDonTreHan</div>
                                <div class="ten-thong-ke">Hóa đơn trễ hạn</div>
                                @if (Model.SoHoaDonTreHan == 0)
                                {
                                    <span class="nhan-trang-thai tot">✓ Không có hóa đơn quá hạn</span>
                                }
                                else
                                {
                                    <span class="nhan-trang-thai nguy-hiem">⚠ Có @Model.SoHoaDonTreHan hóa đơn quá hạn</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-thong-ke mau-cam">
                        <div class="card-noi-dung">
                            <div class="bieu-tuong-card">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="so-lieu">
                                <div class="con-so" style="color: var(--mau-cam);">@Model.SoSuCo</div>
                                <div class="ten-thong-ke">Sự cố đã ghi nhận</div>

                                <div class="khu-vuc-nhan" style="margin-top: 8px;">
                                    @if (Model.SoSuCoDangXuLy > 0)
                                    {
                                        <span class="nhan-trang-thai canh-bao">
                                            <i class="fas fa-sync-alt fa-spin" style="margin-right: 4px;"></i>
                                            @Model.SoSuCoDangXuLy đang xử lý
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nhan-trang-thai tot">
                                            <i class="fas fa-check" style="margin-right: 4px;"></i>
                                            Không có sự cố
                                        </span>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- HÀNG 2: THÔNG TIN CÁ NHÂN + THÔNG BÁO -->
                <div class="hang-giua">

                    <!-- Card Thông tin cá nhân -->
                    <div class="card accent-xanh">
                        <div class="tieu-de-card">
                            <h3><i class="fas fa-user-circle"></i> Thông tin cá nhân</h3>
                            <button class="nut-xem-them" onclick="moHoSo()">Xem hồ sơ</button>
                        </div>
                        <div class="card-body">
                            <div class="profile-wrap">
                                <div class="ava-xl">@tenVietTat</div>
                                <div>
                                    <div class="pname">@tenHienThi</div>
                                    <div class="pbadge">📍 Phòng @soPhongHienThi · @tangHienThi</div>
                                    <div class="prow"><i class="fas fa-envelope"></i> @(Model.TenantInfo?.Email ?? "—")</div>
                                    <div class="prow"><i class="fas fa-phone"></i> @(Model.TenantInfo?.Phone ?? "—")</div>
                                    @if (Model.HopDongHienTai != null)
                                    {
                                        <div class="prow">
                                            <i class="fas fa-calendar-alt"></i>
                                            Vào ở: @Model.HopDongHienTai.NgayBatDau.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                </div>
                            </div>

                            <button class="btn-profile" onclick="moHoSo()">
                                <i class="fas fa-id-card"></i> &nbsp;Xem hồ sơ đầy đủ
                            </button>

                            <div class="divider"></div>

                            <div class="mini-stats">
                                <div class="mini-stat">
                                    <div class="ms-num" style="color:var(--mau-chu-de);">@Model.SoThangDaThue</div>
                                    <div class="ms-lbl">Tháng ở</div>
                                </div>
                                <div class="mini-stat">
                                    <div class="ms-num" style="color:#16a34a;">@Model.SoHoaDonTreHan</div>
                                    <div class="ms-lbl">Hóa đơn trễ</div>
                                </div>
                                <div class="mini-stat">
                                    <div class="ms-num" style="color:var(--mau-cam);">@Model.SoSuCo</div>
                                    <div class="ms-lbl">Sự cố</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Thông báo -->
                    <div class="card accent-vang">
                        <div class="tieu-de-card">
                            <h3><i class="fas fa-bell" style="color:#d97706;"></i> Thông báo</h3>
                            <button class="nut-xem-them" onclick="moThongBao()">Xem tất cả</button>
                        </div>
                        <div class="card-body" style="padding-top:10px;">
                            <ul class="notif-list">
                                @foreach (var tb in Model.DanhSachThongBao)
                                {
                                    <li class="notif-item">
                                        <span class="ndot @tb.LoaiDot"></span>
                                        <div>
                                            <div class="notif-text">@tb.NoiDung</div>
                                            <div class="notif-time">@tb.ThoiGian</div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                </div>

                <!-- HÀNG 3: TIỆN ÍCH NHANH -->
                <div class="hang-tien-ich">
                    <div class="card accent-tim">
                        <div class="tieu-de-card">
                            <h3><i class="fas fa-th-large" style="color:#7c3aed;"></i> Tiện ích nhanh</h3>
                        </div>
                        <div class="quick-grid">
                            <a class="quick-item" href="#" onclick="moThanhToan(); return false;">
                                <div class="qi-icon" style="background:#dbeafe;color:#1a56db;"><i class="fas fa-credit-card"></i></div>
                                <div class="qi-name">Thanh toán</div>
                                <div class="qi-desc">Xem &amp; thanh toán hóa đơn tháng này</div>
                            </a>
                            <a class="quick-item" href="#" onclick="moTienIch(); return false;">
                                <div class="qi-icon" style="background:#dcfce7;color:#059669;"><i class="fas fa-bolt"></i></div>
                                <div class="qi-name">Dịch vụ</div>
                                <div class="qi-desc">Điện, nước, internet, chỉ số tiêu thụ</div>
                            </a>
                            <a class="quick-item" href="#" onclick="moBaoSuCo(); return false;">
                                <div class="qi-icon" style="background:#ffedd5;color:#d97706;"><i class="fas fa-tools"></i></div>
                                <div class="qi-name">Báo sự cố</div>
                                <div class="qi-desc">Ghi nhận vấn đề cần sửa chữa</div>
                            </a>
                            <a class="quick-item" href="#" onclick="moHoSo(); return false;">
                                <div class="qi-icon" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-cog"></i></div>
                                <div class="qi-name">Cài đặt</div>
                                <div class="qi-desc">Tùy chỉnh tài khoản &amp; thông báo</div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- HÀNG 4: LIÊN HỆ NHÀ TRỌ -->
                <div class="hang-lien-he">
                    <div class="card accent-xanh-la">
                        <div class="tieu-de-card">
                            <h3><i class="fas fa-phone-alt" style="color:#059669;"></i> Thông tin liên hệ nhà trọ</h3>
                        </div>
                        <div class="contact-inner">
                            <div class="contact-rows">
                                <div class="crow">
                                    <div class="crow-icon" style="background:#dbeafe;color:#1a56db;"><i class="fas fa-map-marker-alt"></i></div>
                                    <div>
                                        <div class="crow-label">Địa chỉ</div>
                                        <div class="crow-value">@Model.DiaChi</div>
                                    </div>
                                </div>
                                <div class="crow">
                                    <div class="crow-icon" style="background:#dcfce7;color:#059669;"><i class="fas fa-phone"></i></div>
                                    <div>
                                        <div class="crow-label">Số điện thoại</div>
                                        <div class="crow-value">@Model.SoDienThoai</div>
                                    </div>
                                </div>
                                <div class="crow">
                                    <div class="crow-icon" style="background:#ffedd5;color:#d97706;"><i class="fas fa-envelope"></i></div>
                                    <div>
                                        <div class="crow-label">Email</div>
                                        <div class="crow-value">@Model.EmailNhaTro</div>
                                    </div>
                                </div>
                                <div class="crow">
                                    <div class="crow-icon" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-clock"></i></div>
                                    <div>
                                        <div class="crow-label">Giờ làm việc</div>
                                        <div class="crow-value">@Model.GioLamViec</div>
                                    </div>
                                </div>
                            </div>
                            <div class="map-box" onclick="alert('Mở bản đồ Google Maps')">
                                <div class="map-emoji">🗺️</div>
                                <div class="map-title">Bản đồ vị trí</div>
                                <div class="map-addr">@Model.DiaChi</div>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>


        <!-- MODAL: THANH TOÁN HÓA ĐƠN -->
        <div class="lop-che-modal" id="modal-thanh-toan" onclick="dongModalNeuNhanNgoai(event, 'modal-thanh-toan')">
            <div class="hop-modal">
                <div class="tieu-de-modal">
                    @{
                        string kyHD = Model.HoaDonThangNay?.KyThanhToan ?? "—";
                    }
                    <h3><i class="fas fa-credit-card" style="color:var(--mau-chu-de);"></i> Hóa đơn tháng @kyHD</h3>
                    <button class="nut-dong-modal" onclick="dongModal('modal-thanh-toan')">✕</button>
                </div>
                @if (Model.HoaDonThangNay != null)
                {
                    var hd = Model.HoaDonThangNay;
                    <div class="info-row-modal"><span class="label-modal">Phòng</span><span class="value-modal">Phòng @soPhongHienThi</span></div>
                    <div class="info-row-modal"><span class="label-modal">Người thuê</span><span class="value-modal">@tenHienThi</span></div>
                    <div class="info-row-modal"><span class="label-modal">Tiền phòng</span><span class="value-modal">@((hd.TienPhong ?? 0).ToString("N0")) đ</span></div>
                    <div class="info-row-modal"><span class="label-modal">Tiền điện</span><span class="value-modal">@((hd.TienDienSum ?? 0).ToString("N0")) đ</span></div>
                    <div class="info-row-modal"><span class="label-modal">Tiền nước</span><span class="value-modal">@((hd.TienNuocSum ?? 0).ToString("N0")) đ</span></div>
                    <div class="info-row-modal"><span class="label-modal">Dịch vụ</span><span class="value-modal">@((hd.TienDV ?? 0).ToString("N0")) đ</span></div>
                    <div class="info-row-modal" style="border-top:2px solid var(--mau-chu-de);margin-top:6px;padding-top:12px;">
                        <span class="label-modal" style="font-size:14px;font-weight:800;color:var(--mau-chu);">Tổng cộng</span>
                        <span class="value-modal" style="font-size:16px;color:var(--mau-chu-de);">@hd.TongCong.ToString("N0") đ</span>
                    </div>
                    <div class="info-row-modal">
                        <span class="label-modal">Hạn thanh toán</span>
                        <span class="value-modal" style="color:var(--mau-do);">@hd.HanDong.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                else
                {
                    <p style="text-align:center;color:var(--mau-chu-phu);padding:20px 0;">Chưa có hóa đơn tháng này.</p>
                }
                <div class="nhom-nut-modal">
                    <button class="nut-huy" onclick="dongModal('modal-thanh-toan')">Đóng</button>
                    @if (Model.HoaDonThangNay != null)
                    {
                        <button class="nut-luu" onclick="alert('Đang chuyển đến cổng thanh toán...'); dongModal('modal-thanh-toan')">
                            <i class="fas fa-check-circle"></i> Thanh toán ngay
                        </button>
                    }
                </div>
            </div>
        </div>


        <!-- MODAL: BÁO SỰ CỐ -->
        <div class="lop-che-modal" id="modal-bao-su-co" onclick="dongModalNeuNhanNgoai(event, 'modal-bao-su-co')">
            <div class="hop-modal">
                <div class="tieu-de-modal">
                    <h3><i class="fas fa-tools" style="color:#ef4444;"></i> Báo sự cố phòng</h3>
                    <button class="nut-dong-modal" onclick="dongModal('modal-bao-su-co')">✕</button>
                </div>
                <div class="hang-form">
                    <div class="nhom-truong-nhap">
                        <label class="nhan-truong-nhap">Loại sự cố *</label>
                        <select class="truong-nhap chon-lua" id="loai-su-co">
                            <option>-- Chọn loại --</option>
                            <option>Điện</option>
                            <option>Nước</option>
                            <option>Cửa / Khóa</option>
                            <option>Thiết bị</option>
                            <option>Khác</option>
                        </select>
                    </div>
                    <div class="nhom-truong-nhap">
                        <label class="nhan-truong-nhap">Mức độ *</label>
                        <select class="truong-nhap chon-lua" id="muc-do-su-co">
                            <option>Thấp</option>
                            <option>Trung bình</option>
                            <option>Khẩn cấp</option>
                        </select>
                    </div>
                </div>
                <div class="nhom-truong-nhap" style="margin-top:14px;">
                    <label class="nhan-truong-nhap">Mô tả chi tiết *</label>
                    <textarea class="truong-nhap" rows="4" id="mo-ta-su-co" placeholder="Mô tả vấn đề bạn gặp phải..."></textarea>
                </div>
                <div class="nhom-nut-modal">
                    <button class="nut-huy" onclick="dongModal('modal-bao-su-co')">Hủy</button>
                    <button class="nut-luu" style="background:linear-gradient(135deg,#ef4444,#f97316);" onclick="luuSuCo()">
                        <i class="fas fa-paper-plane"></i> Gửi báo cáo
                    </button>
                </div>
            </div>
        </div>


        <!-- MODAL: HỒ SƠ CÁ NHÂN -->
        <div class="lop-che-modal" id="modal-ho-so" onclick="dongModalNeuNhanNgoai(event, 'modal-ho-so')">
            <div class="hop-modal">
                <div class="tieu-de-modal">
                    <h3><i class="fas fa-user-circle" style="color:var(--mau-chu-de);"></i> Hồ sơ cá nhân</h3>
                    <button class="nut-dong-modal" onclick="dongModal('modal-ho-so')">✕</button>
                </div>
                <div style="display:flex;align-items:center;gap:16px;padding:14px 0 18px;border-bottom:1px solid var(--mau-vien);margin-bottom:16px;">
                    <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#1a56db,#60a5fa);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;color:#fff;border:3px solid #dbeafe;">@tenVietTat</div>
                    <div>
                        <div style="font-size:18px;font-weight:800;">@tenHienThi</div>
                        <div style="font-size:12px;color:var(--mau-chu-phu);margin-top:3px;">Phòng @soPhongHienThi · Nhà Trọ ABC</div>
                        <span style="display:inline-block;background:#dcfce7;color:#16a34a;font-size:11px;font-weight:700;padding:2px 10px;border-radius:20px;margin-top:5px;">● Đang hoạt động</span>
                    </div>
                </div>
                <div class="hang-form">
                    <div class="nhom-truong-nhap">
                        <label class="nhan-truong-nhap">Họ và tên</label>
                        <input class="truong-nhap" type="text" value="@tenHienThi" />
                    </div>
                    <div class="nhom-truong-nhap">
                        <label class="nhan-truong-nhap">Số điện thoại</label>
                        <input class="truong-nhap" type="text" value="@(Model.TenantInfo?.Phone ?? "")" />
                    </div>
                    <div class="nhom-truong-nhap">
                        <label class="nhan-truong-nhap">Email</label>
                        <input class="truong-nhap" type="email" value="@(Model.TenantInfo?.Email ?? "")" />
                    </div>
                </div>
                <div class="nhom-nut-modal">
                    <button class="nut-huy" onclick="dongModal('modal-ho-so')">Hủy</button>
                    <button class="nut-luu" onclick="alert('Đã lưu thông tin hồ sơ!'); dongModal('modal-ho-so')">
                        <i class="fas fa-save"></i> Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>


        <!-- JAVASCRIPT -->
        <script>
                function capNhatNgayGio() {
                  const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
                  const now = new Date();
                  document.getElementById('ngay-gio-hien-tai').textContent =
                    `${tuan[now.getDay()]}, ${now.getDate()} tháng ${now.getMonth()+1} năm ${now.getFullYear()}`;
                  const days = ['CN','T2','T3','T4','T5','T6','T7'];
                  const dd = String(now.getDate()).padStart(2,'0');
                  const mm = String(now.getMonth()+1).padStart(2,'0');
                  const yy = now.getFullYear();
                  document.getElementById('headerDate').textContent = `${days[now.getDay()]}, ${dd}/${mm}/${yy}`;
                }
                capNhatNgayGio();

                function dongMoSidebar() {
                  document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
                }

                function chuyenTrang(tenTrang, phanTu) {
                  document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
                  phanTu.classList.add('dang-chon');
                  const bang = {
                    'trang-chu':  '/KhachThue/KhachThue',
                    'thanh-toan': '/KhachThue/ThanhToan',
                    'tien-ich':   '/KhachThue/TienIch',
                    'bao-su-co':  '/KhachThue/BaoSuCo',
                    'thong-bao':  '/KhachThue/ThongBao',
                    'ho-so':      '/KhachThue/HoSo',
                    'cai-dat':    '/KhachThue/CaiDat',
                    'trang-quan-ly':'/Manager/Manager',
                  };
                  if (bang[tenTrang]) window.location.href = bang[tenTrang];
                }

                function moThanhToan() { document.getElementById('modal-thanh-toan').classList.add('hien'); }
                function moBaoSuCo()   { document.getElementById('modal-bao-su-co').classList.add('hien'); }
                function moHoSo()      { document.getElementById('modal-ho-so').classList.add('hien'); }
                function moTienIch()   { alert('Trang dịch vụ & tiện ích: Điện, nước, internet...'); }
                function moThongBao()  { alert('Danh sách thông báo (@Model.SoThongBaoChuaDoc chưa đọc)'); }

                function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
                function dongModalNeuNhanNgoai(e, id) { if (e.target.id === id) dongModal(id); }

                function luuSuCo() {
                  const moTa = document.getElementById('mo-ta-su-co').value;
                  if (!moTa) { alert('Vui lòng mô tả sự cố!'); return; }
                  alert('Đã gửi báo cáo sự cố thành công! Chúng tôi sẽ xử lý sớm nhất có thể.');
                  dongModal('modal-bao-su-co');
                }
        </script>

    </body>
    </html>
