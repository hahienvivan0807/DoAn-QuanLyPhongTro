<!-- ===================================================================
     JAVASCRIPT
=================================================================== -->
<script>
    // ===== PHÂN TRANG =====
    class TablePager {
    constructor(tbodyId, containerId, pageSize = 10) {
    this.tbody      = document.getElementById(tbodyId);
    this.container  = document.getElementById(containerId);
    this.pageSize   = pageSize;
    this.currentPage = 1;
    if (this.tbody && this.container) this.refresh();
    }

    // Call after any filter/search changes visibility of rows
    refresh() {
    this.visibleRows = Array.from(this.tbody.querySelectorAll('tr'))
    .filter(r => r.style.display !== 'none');
    this.totalPages = Math.max(1, Math.ceil(this.visibleRows.length / this.pageSize));
    if (this.currentPage > this.totalPages) this.currentPage = 1;
    this._applyPage();
    this._render();
    }

    goTo(page) {
    this.currentPage = page;
    this._applyPage();
    this._render();
    }

    _applyPage() {
    // First hide ALL rows, then show only the current page slice
    Array.from(this.tbody.querySelectorAll('tr')).forEach(r => {
    if (r.style.display !== 'none') r.dataset.pagerVisible = '1';
    });
    this.visibleRows.forEach((r, i) => {
    const inPage = i >= (this.currentPage - 1) * this.pageSize
    && i <   this.currentPage       * this.pageSize;
    r.style.display = inPage ? '' : 'none';
    });
    }

    _render() {
    const total  = this.visibleRows.length;
    const start  = total === 0 ? 0 : (this.currentPage - 1) * this.pageSize + 1;
    const end    = Math.min(this.currentPage * this.pageSize, total);

    // Build page number buttons (show max 5 around current)
    let btns = '';
    const range = 2;
    for (let p = 1; p <= this.totalPages; p++) {
    if (p === 1 || p === this.totalPages
    || (p >= this.currentPage - range && p <= this.currentPage + range)) {
    btns += `<button class="pt-btn${p === this.currentPage ? ' active' : ''}"
    onclick="this.closest('.phan-trang').__pager.goTo(${p})">${p}</button>`;
    } else if (p === this.currentPage - range - 1
    || p === this.currentPage + range + 1) {
    btns += `<button class="pt-btn" disabled>…</button>`;
    }
    }

    this.container.innerHTML = `
    <span>Hiển thị <strong>${start}–${end}</strong> / ${total} bản ghi</span>
    <div class="phan-trang-buttons">
    <button class="pt-btn" ${this.currentPage === 1 ? 'disabled' : ''}
    onclick="this.closest('.phan-trang').__pager.goTo(${this.currentPage - 1})">
    <i class="fas fa-chevron-left"></i>
    </button>
    ${btns}
    <button class="pt-btn" ${this.currentPage === this.totalPages ? 'disabled' : ''}
    onclick="this.closest('.phan-trang').__pager.goTo(${this.currentPage + 1})">
    <i class="fas fa-chevron-right"></i>
    </button>
    </div>`;
    // Attach reference so onclick can find this instance
    this.container.__pager = this;
    }
    }

    const pagerNuoc = new TablePager('tbodyNuoc', 'phan-trang-nuoc', 10);
    const pagerGS   = new TablePager('tbodyGS',   'phan-trang-gs',   10);
    const pagerDN   = new TablePager('tbodyDN',   'phan-trang-dn',   10);
    const pagerNo   = new TablePager('tbodyNo',   'phan-trang-no',   10);
    // ===== SIDEBAR =====
    function dongMoSidebar() {
    document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
    }

    function chuyenTrang(ten, el) {
    const map = {
    'trang-chu':      '/Manager/Manager',
    'quan-ly-phong':  '/Manager/ChiTietPhong',
    'quan-ly-dich-vu':'/Manager/QuanLyDichVu',
    'hoa-don':        '/Manager/HoaDon',
    'su-co':          '/Manager/SuCoBaoTri',
    'bao-cao':        '/Manager/ThongKe',
    'cai-dat':        '/Manager/CaiDat',
    };
    if (map[ten]) window.location.href = map[ten];
    }

    // ===== TABS =====
    function chonTab(tabId, btnEl) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('panel-' + tabId).classList.add('active');
    (btnEl || document.querySelector(`[data-tab="${tabId}"]`)).classList.add('active');
    }

    // ===== MODAL =====
    function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
    function dongModalNeuNhanNgoai(e, id) { if (e.target.id === id) dongModal(id); }

    // Đơn giá nước bình từ config (load 1 lần khi trang khởi động)
    let donGiaNuocBinh = 0;
    (async function loadDonGiaNuoc() {
    try {
    const res = await fetch('/api/ConfigGia?ma=NUOC_BINH');
    if (res.ok) {
    const d = await res.json();
    donGiaNuocBinh = d.donGia || 0;
    }
    } catch (e) {
    // Nếu không có API, sẽ dùng giá từ server-side
    donGiaNuocBinh = 0;
    }
    })();

    function moModalXacNhanGiao(id, phong, khach, noiDung, tienHienTai) {
    document.getElementById('nuoc_idDonDV').value = id;
    document.getElementById('nuoc_noiDung').value = noiDung;
    document.getElementById('subNuoc').textContent = `Phòng ${phong} | Khách: ${khach}`;
    // Hiển thị giá: ưu tiên từ API, fallback sang giá đơn hiện tại
    const gia = donGiaNuocBinh > 0 ? donGiaNuocBinh : tienHienTai;
    document.getElementById('nuoc_hienThiGia').textContent =
    gia > 0 ? gia.toLocaleString('vi-VN') + ' đ/bình' : 'Theo cấu hình hệ thống';
    document.getElementById('modal-nhap-gia-nuoc').classList.add('hien');
    }

    function xemAnhBienLai(url, id, phong, khach) {
    document.getElementById('anhCKPreview').src = url;
    document.getElementById('ck_idDonDV').value = id;
    document.getElementById('subAnhCK').textContent = `Phòng ${phong} | Khách: ${khach}`;
    document.getElementById('modal-xem-anh-ck').classList.add('hien');
    }

    // Giữ lại tên cũ để tương thích nếu có chỗ nào còn gọi
    function moModalNhapGiaNuoc(id, phong, khach, noiDung, tienHienTai) {
    moModalXacNhanGiao(id, phong, khach, noiDung, tienHienTai);
    }

    function moModalNhapGiaGS(id, phong, khach, noiDung) {
    document.getElementById('gs_idDonDV').value  = id;
    document.getElementById('gs_noiDung').value  = noiDung;
    document.getElementById('subGS').textContent = `Phòng ${phong} | Khách: ${khach}`;
    document.getElementById('modal-nhap-gia-gs').classList.add('hien');
    }

    function xemAnhDienNuoc(urlDien, urlNuoc, id, phong, dienCu, dienMoi, nuocCu, nuocMoi) {
    document.getElementById('anhDN_idGhiNhan').value = id;
    document.getElementById('subAnhDN').textContent  = `Phòng ${phong}`;

    // ── Cập nhật chỉ số ──────────────────────────────────────────────────
    document.getElementById('anhDN_dienCu').textContent    = dienCu;
    document.getElementById('anhDN_dienMoi').textContent   = dienMoi;
    document.getElementById('anhDN_dienTieu').textContent  = (parseInt(dienMoi) - parseInt(dienCu)) + ' số';
    document.getElementById('anhDN_nuocCu').textContent    = nuocCu;
    document.getElementById('anhDN_nuocMoi').textContent   = nuocMoi;
    document.getElementById('anhDN_nuocTieu').textContent  = (parseInt(nuocMoi) - parseInt(nuocCu)) + ' số';

    // ── Ảnh đồng hồ điện ─────────────────────────────────────────────────
    var imgDien   = document.getElementById('anhDienPreview');
    var noDien    = document.getElementById('anhDN_noimg_dien');
    if (urlDien) {
    imgDien.src             = urlDien;
    imgDien.style.display   = 'block';
    noDien.style.display    = 'none';
    } else {
    imgDien.src             = '';
    imgDien.style.display   = 'none';
    noDien.style.display    = 'flex';
    }

    // ── Ảnh đồng hồ nước ─────────────────────────────────────────────────
    var imgNuoc   = document.getElementById('anhNuocPreview');
    var noNuoc    = document.getElementById('anhDN_noimg_nuoc');
    if (urlNuoc) {
    imgNuoc.src             = urlNuoc;
    imgNuoc.style.display   = 'block';
    noNuoc.style.display    = 'none';
    } else {
    imgNuoc.src             = '';
    imgNuoc.style.display   = 'none';
    noNuoc.style.display    = 'flex';
    }

    document.getElementById('modal-xem-anh-dn').classList.add('hien');
    }

    function moModalTuChoiDN(id, phong) {
    document.getElementById('tcDN_idGhiNhan').value     = id;
    document.getElementById('subTuChoiDN').textContent  = phong ? `Phòng ${phong}` : '';
    document.getElementById('modal-tu-choi-dn').classList.add('hien');
    }

    function moModalCauHinhGia() {
    document.getElementById('modal-cau-hinh-gia').classList.add('hien');
    }

    // ===== FILTER: ĐƠN NƯỚC =====
    let filterNuoc = '';
    function locDonNuoc(tt, btn) {
    filterNuoc = tt;
    document.querySelectorAll('#panel-don-nuoc .filter-pill').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    apDungFilter('tbodyNuoc', filterNuoc, document.getElementById('searchNuoc').value);
    }

    // ===== FILTER: GIẶT SẤY =====
    let filterGS = '';
    function locDonGS(tt, btn) {
    filterGS = tt;
    document.querySelectorAll('#panel-giat-say .filter-pill').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    apDungFilter('tbodyGS', filterGS, document.getElementById('searchGS').value);
    }

    function apDungFilter(tbodyId, tt, kw) {
    const rows = document.querySelectorAll(`#${tbodyId} tr`);
    rows.forEach(r => {
    const matchTT = !tt || r.dataset.trangthai === tt;
    const matchKW = !kw || r.dataset.search.toLowerCase().includes(kw.toLowerCase());
    r.style.display = matchTT && matchKW ? '' : 'none';
    });
    if (tbodyId === 'tbodyNuoc') pagerNuoc.refresh();
    if (tbodyId === 'tbodyGS')   pagerGS.refresh();
    }

    function timKiemDon(loai) {
    if (loai === 'nuoc') apDungFilter('tbodyNuoc', filterNuoc, document.getElementById('searchNuoc').value);
    else                 apDungFilter('tbodyGS',   filterGS,   document.getElementById('searchGS').value);
    }

    // ===== FILTER: ĐIỆN NƯỚC =====
    let filterDN = 255;
    function locDienNuoc(tt, btn) {
    filterDN = tt;
    document.querySelectorAll('#panel-dien-nuoc .filter-pill').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    timKiemDienNuoc();
    }

    function timKiemDienNuoc() {
    const kw = document.getElementById('searchDN').value.toLowerCase();
    document.querySelectorAll('#tbodyDN tr').forEach(r => {
    const matchTT = filterDN === 255 || parseInt(r.dataset.tt) === filterDN;
    const matchKW = !kw || r.dataset.search.toLowerCase().includes(kw);
    r.style.display = matchTT && matchKW ? '' : 'none';
    });
    pagerDN.refresh();
    }

    // ===== TOAST =====
    function hienToast(msg, loai) {
    const icons = { success: 'fa-check-circle', danger: 'fa-times-circle', warning: 'fa-exclamation-triangle' };
    const wrap  = document.getElementById('toastWrap');
    const t     = document.createElement('div');
    t.className = `toast ${loai}`;
    t.innerHTML = `<i class="fas ${icons[loai] || icons.success}"></i>${msg}`;
    wrap.appendChild(t);
    setTimeout(() => t.remove(), 4000);
    }

    // ===== ĐỒNG BỘ BADGE SIDEBAR =====
    (async function loadBadgeSidebar() {
    try {
    const res = await fetch('/Api/BadgeCounts?scopeManager=true');
    if (!res.ok) return;
    const data = await res.json();
    const badgeDV = document.getElementById('badge-dichvu');
    const badgeSC = document.getElementById('badge-suco');
    if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
    if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
    } catch (e) { console.warn('Không thể load badge sidebar:', e); }
    })();
</script>
</body>
