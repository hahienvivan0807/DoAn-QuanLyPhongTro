<div class="modal-overlay" id="modal-cau-hinh-gia" onclick="dongModalNeuNhanNgoai(event,'modal-cau-hinh-gia')">
    <div class="modal modal-lg">
        <div class="modal-header">
            <div>
                <h3><i class="fas fa-sliders-h" style="color:var(--mau-chu-de);margin-right:8px;"></i>Cấu hình đơn giá dịch vụ</h3>
