                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Đơn giá (đ)</label>
                        <input class="inp" type="number" name="donGia" min="0" placeholder="25000" required />
                    </div>
                    <div class="form-group">
                        <label>Đơn vị</label>
                        <input class="inp" type="text" name="donVi" placeholder="bình / kg / lần" required />
