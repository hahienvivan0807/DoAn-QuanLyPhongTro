                                {
                                    <span class="badge tu-choi">Vô hiệu</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="DoiTrangThaiConfig" style="display:inline;">
                                    <input type="hidden" name="idConfig" value="@cf.IDConfig" />
                                    <input type="hidden" name="isActive" value="@cf.IsActive" />
                                    <button type="submit" class="btn @(cf.IsActive ? "btn-warning" : "btn-success") btn-sm">
                                        @(cf.IsActive ? "Vô hiệu" : "Kích hoạt")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Form thêm cấu hình mới -->
        <div style="border-top:1px solid var(--mau-vien);padding-top:16px;">
            <div style="font-size:12px;font-weight:700;color:var(--mau-chu-phu);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;">Thêm đơn giá mới</div>
