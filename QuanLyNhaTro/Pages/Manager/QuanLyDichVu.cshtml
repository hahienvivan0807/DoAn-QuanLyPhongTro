    <!-- =============================================
         MODAL: XEM ĐỒNG HỒ + DUYỆT ĐIỆN NƯỚC
         (Dùng cho Tab Duyệt điện nước)
         Hiển thị AnhChupDongHo + SoDienMoi/SoNuocMoi
         + Nút [Duyệt] hoặc [Từ chối]
    ============================================= -->
    <div class="lop-che-modal" id="modal-dien-nuoc" onclick="dongModalNeuNhanNgoai(event, 'modal-dien-nuoc')">
        <div class="hop-modal lon">
            <!-- Tiêu đề modal -->
            <div class="tieu-de-modal">
                <h3>
                    <i class="fas fa-bolt"></i>
                    Duyệt chỉ số điện nước
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-dien-nuoc')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Thông tin phòng + kỳ ghi nhận -->
            <div class="hang-thong-tin-modal">
                <div class="o-thong-tin">
                    <div class="nhan">Phòng</div>
                    <div class="gia-tri" id="modal-dn-phong">—</div>
                </div>
                <div class="o-thong-tin">
                    <div class="nhan">Khách thuê</div>
                    <div class="gia-tri" id="modal-dn-khach">—</div>
                </div>
                <div class="o-thong-tin">
                    <div class="nhan">Kỳ ghi nhận</div>
                    <div class="gia-tri noi-bat" id="modal-dn-ky">—</div>
                </div>
                <div class="o-thong-tin">
                    <div class="nhan">ID ghi nhận</div>
                    <div class="gia-tri" id="modal-dn-id" style="color:var(--mau-chu-phu);">—</div>
                </div>
            </div>

            <!-- Chỉ số điện & nước mới/cũ (SoDienMoi, SoNuocMoi, SoDienCu, SoNuocCu) -->
            <div class="phan-tach-dien-nuoc">
                <!-- Ô chỉ số điện -->
                <div class="o-chi-so dien">
                    <div class="loai"><i class="fas fa-bolt"></i> Điện</div>
                    <div class="hang">
                        <span class="ten">Số mới:</span>
                        <span class="so-moi" id="modal-dn-dien-moi">—</span>
                    </div>
                    <div class="hang">
                        <span class="ten">Số cũ:</span>
                        <span class="so-cu" id="modal-dn-dien-cu">—</span>
                    </div>
                    <div class="tieu-thu" style="color:#1d4ed8;" id="modal-dn-tieu-thu-dien">Tiêu thụ: — kWh</div>
                </div>

                <!-- Ô chỉ số nước -->
                <div class="o-chi-so nuoc">
                    <div class="loai"><i class="fas fa-tint"></i> Nước</div>
                    <div class="hang">
                        <span class="ten">Số mới:</span>
                        <span class="so-moi" id="modal-dn-nuoc-moi">—</span>
                    </div>
                    <div class="hang">
                        <span class="ten">Số cũ:</span>
                        <span class="so-cu" id="modal-dn-nuoc-cu">—</span>
                    </div>
                    <div class="tieu-thu" style="color:#15803d;" id="modal-dn-tieu-thu-nuoc">Tiêu thụ: — m³</div>
                </div>
            </div>

            <!-- Ảnh chụp đồng hồ (AnhChupDongHo từ DIENNUOC) -->
            <p style="font-size:12px;font-weight:600;margin-bottom:8px;color:var(--mau-chu);">
                <i class="fas fa-camera" style="color:var(--mau-chu-de);margin-right:5px;"></i>
                Ảnh chụp đồng hồ do khách gửi:
            </p>
            <div class="khung-anh-modal">
                <!-- ⚙️ BACKEND: src="@@Model.DienNuoc.AnhChupDongHo" -->
                <img id="modal-dn-anh" src="" alt="Ảnh chụp đồng hồ điện nước" />
            </div>

            <!-- Ghi chú duyệt (GhiChuDuyet) -->
            <div class="nhom-truong-nhap">
                <label class="nhan-truong-nhap">Ghi chú (khi từ chối cần ghi rõ lý do)</label>
                <input type="text" class="truong-nhap" id="modal-dn-ghi-chu" placeholder="VD: Số liệu hợp lệ / Ảnh mờ, cần gửi lại..." />
            </div>

            <!-- Nhóm nút hành động: [Từ chối] + [Duyệt] -->
            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-dien-nuoc')">
                    <i class="fas fa-times"></i> Đóng
                </button>
                <!-- Nút [Từ chối]: TrangThaiDuyet = 2 -->
                <button class="nut-luu do" onclick="duyetDienNuoc(false)">
                    <i class="fas fa-ban"></i> Từ chối
                </button>
                <!-- Nút [Duyệt]: TrangThaiDuyet = 1 -->
                <button class="nut-luu xanh-la" onclick="duyetDienNuoc(true)">
                    <i class="fas fa-check-circle"></i> Duyệt chỉ số
                </button>
            </div>
        </div>
    </div>
    <!-- Kết thúc MODAL ĐIỆN NƯỚC -->
    <!-- Toast thông báo nhanh -->
    <div id="toast-thong-bao">
        <i class="fas fa-check-circle"></i>
        <span id="toast-noi-dung">Thao tác thành công!</span>
    </div>


    <!-- =============================================
         JAVASCRIPT - XỬ LÝ TƯƠNG TÁC
    ============================================= -->
    <script>
            // ===== CẬP NHẬT NGÀY GIỜ =====
            (function capNhatNgayGio() {
                const ngay = new Date();
                const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
                document.getElementById('ngay-gio-hien-tai').textContent =
                    `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
            })();

            // ===== BIẾN TRẠNG THÁI MODAL (lưu context đang thao tác) =====
            let idDonDangXuLy   = null; // IDDonDV đang xử lý trong modal biên lai
            let idDienNuocDangXuLy = null; // IDGhiNhan đang xử lý trong modal điện nước

            // =============================================
            // CHỨC NĂNG TABS
            // =============================================

            // Chuyển tab theo id tab nội dung
            function chuyenTab(idTab, phanTu) {
                // Ẩn tất cả nội dung tab
                document.querySelectorAll('.noi-dung-tab').forEach(t => t.classList.remove('dang-hien'));
                // Bỏ active tất cả nút tab
                document.querySelectorAll('.tab-nut').forEach(b => b.classList.remove('dang-chon-tab'));
                // Hiện tab được chọn
                document.getElementById(idTab).classList.add('dang-hien');
                // Active nút tab được chọn
                phanTu.classList.add('dang-chon-tab');
            }

            // =============================================
            // CHỨC NĂNG: XÁC NHẬN ĐÃ GIAO (Đặt nước bình)
            // Chuyển TrangThai_DV: 'Chờ xử lý'/'Đang xử lý' → 'Chờ thanh toán'
            // =============================================
            function xacNhanGiao(idDon, idDong, idBadge) {
                // Lấy nút và hàng đang thao tác
                const badge = document.getElementById(idBadge);
                const dong  = document.getElementById(idDong);

                // Cập nhật badge trạng thái sang "Chờ thanh toán"
                badge.className = 'badge cho-thanh-toan';
                badge.textContent = 'Chờ thanh toán';

                // Ẩn nút [Xác nhận đã giao] sau khi bấm
                const nutGiao = dong.querySelector('.nut-hanh-dong');
                if (nutGiao) {
                    nutGiao.disabled = true;
                    nutGiao.style.opacity = '0.4';
                    nutGiao.style.pointerEvents = 'none';
                    nutGiao.innerHTML = '<i class="fas fa-check"></i> Đã giao';
                }

                // ⚙️ BACKEND: Gọi API PATCH /api/don-dv/{idDon}/xac-nhan-giao
                // fetch(`/api/don-dv/${idDon}/xac-nhan-giao`, { method: 'PATCH' })
                hienToast('Đã xác nhận giao hàng! Chờ khách xác nhận & thanh toán.', 'thanh-cong');

                // Chuyển dòng sang bảng "Chờ thanh toán" bên dưới (Demo mockup)
                const tbodyChoTT = document.getElementById('ds-nuoc-cho-thanh-toan');
                const tenPhong   = dong.querySelector('.ten-phong-bang')?.textContent || '';
                const tenKhach   = dong.querySelector('.ten-nguoi-thue')?.textContent || '';
                const noiDung    = dong.querySelectorAll('td')[2]?.textContent || '';
                const donHangRow = `
                    <tr id="don-dang-cho-${idDon}">
                        <td style="font-weight:700;color:var(--mau-chu-de);">#${idDon}</td>
                        <td>
                            <div class="thong-tin-phong">
                                <span class="ten-phong-bang">${tenPhong}</span>
                                <span class="ten-nguoi-thue">${tenKhach}</span>
                            </div>
                        </td>
                        <td>${noiDung}</td>
                        <td style="font-weight:700;color:#059669;">—</td>
                        <td style="font-size:12px;color:var(--mau-chu-phu);">Vừa giao</td>
                        <td><span class="badge cho-thanh-toan">Chờ thanh toán</span></td>
                    </tr>`;
                tbodyChoTT.insertAdjacentHTML('beforeend', donHangRow);
            }

            // =============================================
            // CHỨC NĂNG: GỬI BÁO GIÁ (Giặt sấy)
            // Cập nhật TongTien + chuyển TrangThai_DV sang 'Đang xử lý'
            // =============================================
            function guiBaoGia(idDon, idInput) {
                const inputEl = document.getElementById(idInput);
                const soTien  = parseFloat(inputEl.value);

                // Kiểm tra đã nhập số tiền hợp lệ
                if (!soTien || soTien <= 0) {
                    hienToast('Vui lòng nhập số tiền báo giá hợp lệ!', 'loi');
                    inputEl.focus();
                    return;
                }

                // Format tiền VND
                const tienFormatted = new Intl.NumberFormat('vi-VN').format(soTien) + ' ₫';

                // ⚙️ BACKEND: Gọi API PATCH /api/don-dv/{idDon}/bao-gia
                // fetch(`/api/don-dv/${idDon}/bao-gia`, {
                //   method: 'PATCH',
                //   body: JSON.stringify({ tongTien: soTien })
                // })

                // Cập nhật UI: thay input + nút bằng giá đã gửi
                const nhomBaoGia = inputEl.closest('.nhom-nhap-bao-gia');
                if (nhomBaoGia) {
                    nhomBaoGia.innerHTML = `<span style="font-weight:700;color:#d97706;">${tienFormatted}</span>`;
                }

                // Ẩn nút [Gửi báo giá] và hiển thị trạng thái đã gửi
                const dong = inputEl.closest('tr') || document.querySelector(`[onclick*="guiBaoGia(${idDon}"]`)?.closest('tr');
                if (dong) {
                    const nutGia = dong.querySelector('.nut-hanh-dong.cam');
                    if (nutGia) {
                        nutGia.disabled = true;
                        nutGia.style.opacity = '0.4';
                        nutGia.style.pointerEvents = 'none';
                        nutGia.innerHTML = '<i class="fas fa-check"></i> Đã gửi';
                    }
                }

                hienToast(`Đã gửi báo giá ${tienFormatted} cho đơn #${idDon}`, 'thanh-cong');
            }

            // =============================================
            // CHỨC NĂNG: MỞ MODAL BIÊN LAI (Xác nhận thanh toán)
            // Điền thông tin và hiển thị AnhBienLai
            // =============================================
            function moModalBienLai(idDon, tenPhong, tenKhach, loaiDV, soTien, urlAnh) {
                idDonDangXuLy = idDon;

                // Điền thông tin vào modal
                document.getElementById('modal-bl-ma-don').textContent = `#${idDon}`;
                document.getElementById('modal-bl-phong').textContent   = tenPhong;
                document.getElementById('modal-bl-khach').textContent   = tenKhach;
                document.getElementById('modal-bl-tien').textContent    = new Intl.NumberFormat('vi-VN').format(soTien) + ' ₫';
                document.getElementById('modal-bl-ghi-chu').value        = '';

                // Load ảnh biên lai (AnhBienLai từ DONDV)
                const anhEl = document.getElementById('modal-bl-anh');
                anhEl.src   = urlAnh;
                anhEl.alt   = `Biên lai thanh toán - ${tenPhong} - ${tenKhach}`;

                // Hiện modal
                document.getElementById('modal-bien-lai').classList.add('hien');
            }

            // =============================================
            // CHỨC NĂNG: HOÀN THÀNH ĐƠN DV (Sau khi duyệt biên lai)
            // Cập nhật TrangThai_DV = 'Thành công'
            // =============================================
            function hoanThanhDonDV() {
                const ghiChu = document.getElementById('modal-bl-ghi-chu').value;

                // ⚙️ BACKEND: Gọi API PATCH /api/don-dv/{idDonDangXuLy}/hoan-thanh
                // fetch(`/api/don-dv/${idDonDangXuLy}/hoan-thanh`, {
                //   method: 'PATCH',
                //   body: JSON.stringify({ ghiChuXuLy: ghiChu, ngayHoanThanh: new Date() })
                // })

                dongModal('modal-bien-lai');
                hienToast(`Đơn #${idDonDangXuLy} đã hoàn thành! Thanh toán được xác nhận.`, 'thanh-cong');

                // Xoá dòng khỏi bảng (Demo mockup - thực tế reload từ API)
                const dongCu = document.querySelector(`[onclick*="moModalBienLai(${idDonDangXuLy},"]`)?.closest('tr');
                if (dongCu) {
                    dongCu.style.transition = 'opacity 0.4s';
                    dongCu.style.opacity = '0';
                    setTimeout(() => dongCu.remove(), 400);
                }
            }

            // =============================================
            // CHỨC NĂNG: MỞ MODAL ĐIỆN NƯỚC (Duyệt chỉ số)
            // Điền SoDienMoi, SoNuocMoi, SoDienCu, SoNuocCu, AnhChupDongHo
            // =============================================
            function moModalDienNuoc(idGhiNhan, tenPhong, tenKhach, kyGhiNhan, dienMoi, nuocMoi, dienCu, nuocCu, urlAnh) {
                idDienNuocDangXuLy = idGhiNhan;

                // Điền thông tin phòng + kỳ
                document.getElementById('modal-dn-id').textContent    = `#${idGhiNhan}`;
                document.getElementById('modal-dn-phong').textContent  = tenPhong;
                document.getElementById('modal-dn-khach').textContent  = tenKhach;
                document.getElementById('modal-dn-ky').textContent     = kyGhiNhan;

                // Điền chỉ số điện (SoDienMoi, SoDienCu)
                document.getElementById('modal-dn-dien-moi').textContent = dienMoi.toLocaleString('vi-VN') + ' kWh';
                document.getElementById('modal-dn-dien-cu').textContent  = dienCu.toLocaleString('vi-VN') + ' kWh';
                document.getElementById('modal-dn-tieu-thu-dien').textContent = `Tiêu thụ: ${(dienMoi - dienCu).toLocaleString('vi-VN')} kWh`;

                // Điền chỉ số nước (SoNuocMoi, SoNuocCu)
                document.getElementById('modal-dn-nuoc-moi').textContent = nuocMoi.toLocaleString('vi-VN') + ' m³';
                document.getElementById('modal-dn-nuoc-cu').textContent  = nuocCu.toLocaleString('vi-VN') + ' m³';
                document.getElementById('modal-dn-tieu-thu-nuoc').textContent = `Tiêu thụ: ${(nuocMoi - nuocCu).toLocaleString('vi-VN')} m³`;

                // Load ảnh đồng hồ (AnhChupDongHo từ DIENNUOC)
                const anhEl = document.getElementById('modal-dn-anh');
                anhEl.src   = urlAnh;
                anhEl.alt   = `Ảnh đồng hồ điện nước - ${tenPhong} - ${kyGhiNhan}`;

                // Reset ghi chú
                document.getElementById('modal-dn-ghi-chu').value = '';

                // Hiện modal
                document.getElementById('modal-dien-nuoc').classList.add('hien');
            }

            // =============================================
            // CHỨC NĂNG: DUYỆT / TỪ CHỐI ĐIỆN NƯỚC
            // Cập nhật TrangThaiDuyet: 1 = Đã duyệt | 2 = Từ chối
            // =============================================
            function duyetDienNuoc(chapNhan) {
                const ghiChu = document.getElementById('modal-dn-ghi-chu').value;
                const trangThai = chapNhan ? 1 : 2; // 1=Đã duyệt, 2=Từ chối

                if (!chapNhan && !ghiChu.trim()) {
                    hienToast('Vui lòng ghi lý do từ chối!', 'loi');
                    document.getElementById('modal-dn-ghi-chu').focus();
                    return;
                }

                // ⚙️ BACKEND: Gọi API PATCH /api/dien-nuoc/{idDienNuocDangXuLy}/duyet
                // fetch(`/api/dien-nuoc/${idDienNuocDangXuLy}/duyet`, {
                //   method: 'PATCH',
                //   body: JSON.stringify({
                //     trangThaiDuyet: trangThai,
                //     ghiChuDuyet: ghiChu,
                //     ngayDuyet: new Date()
                //   })
                // })

                dongModal('modal-dien-nuoc');

                if (chapNhan) {
                    hienToast(`Đã duyệt chỉ số điện nước phòng #${idDienNuocDangXuLy}!`, 'thanh-cong');
                } else {
                    hienToast(`Đã từ chối chỉ số điện nước. Khách sẽ được yêu cầu gửi lại.`, 'loi');
                }

                // Xoá dòng khỏi bảng sau khi duyệt (Demo mockup)
                const nutSoiAnh = document.querySelector(`[onclick*="moModalDienNuoc(${idDienNuocDangXuLy},"]`);
                if (nutSoiAnh) {
                    const dong = nutSoiAnh.closest('tr');
                    if (dong) {
                        const tdTrangThai = dong.querySelectorAll('td')[5];
                        if (tdTrangThai) {
                            if (chapNhan) {
                                tdTrangThai.innerHTML = '<span class="badge da-duyet">Đã duyệt</span>';
                            } else {
                                tdTrangThai.innerHTML = '<span class="badge tu-choi">Từ chối</span>';
                            }
                        }
                        // Ẩn nút soi ảnh
                        nutSoiAnh.disabled = true;
                        nutSoiAnh.style.opacity = '0.4';
                        nutSoiAnh.style.pointerEvents = 'none';
                        nutSoiAnh.innerHTML = '<i class="fas fa-check"></i> Đã xử lý';
                    }
                }
            }

            // =============================================
            // HÀM TIỆN ÍCH CHUNG
            // =============================================

            // Đóng modal theo id
            function dongModal(idModal) {
                document.getElementById(idModal).classList.remove('hien');
            }

            // Đóng modal khi nhấn vùng tối bên ngoài
            function dongModalNeuNhanNgoai(event, idModal) {
                if (event.target.id === idModal) dongModal(idModal);
            }

            // Hiển thị toast thông báo nhanh
            function hienToast(noiDung, loai = '') {
                const toast = document.getElementById('toast-thong-bao');
                const span  = document.getElementById('toast-noi-dung');
                span.textContent = noiDung;
                toast.className  = 'hien ' + loai;
                setTimeout(() => { toast.className = loai; }, 3000);
            }

            // Đóng/mở sidebar trên mobile
            function dongMoSidebar() {
                document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            // Chuyển trang khi click menu sidebar
            function chuyenTrang(tenTrang, phanTu) {
                document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
                phanTu.classList.add('dang-chon');
                const bangDieuHuong = {
                    'trang-chu':           '/Manager/Manager',
                    'quan-ly-phong':       '/Manager/ChiTietPhong',
                    'quan-ly-nguoi-thue':  '/Manager/QuanLyDichVu',
                    'hoa-don':             '/Manager/HoaDon',
                    'dich-vu-dien-nuoc':   '/DieuHanhDichVuDienNuoc',
                    'su-co-bao-tri':       '/SuCoBaoTri',
                    'bao-cao':             '/BaoCao',
                    'cai-dat':             '/CaiDat',
                };
                const duongDan = bangDieuHuong[tenTrang];
                if (duongDan) window.location.href = duongDan;
            }

            // Tìm kiếm (kết nối backend sau)
            function timKiem(tuKhoa) {
                // ⚙️ BACKEND: fetch(`/api/don-dv/tim-kiem?q=${tuKhoa}`) rồi render kết quả
                console.log('Tìm kiếm:', tuKhoa);
            }

            function moThongBao()   { alert('Mở danh sách thông báo'); }
            function moMenuAdmin()  { alert('Menu tài khoản: Đổi mật khẩu / Đăng xuất'); }
            function moThongTinAdmin() { alert('Thông tin quản trị viên'); }
    </script>
</body>
</html>