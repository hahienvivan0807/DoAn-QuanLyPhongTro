@page "/Manager/QuanLyDichVu"
@model QuanLyNhaTro.Pages.Manager.QuanLyDichVuModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Điều Hành Dịch Vụ & Điện Nước</title>
    <!-- Font Awesome - hiển thị icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
            /* ===== BIẾN MÀU TOÀN CỤC (kế thừa từ Manager.cshtml) ===== */
            :root {
                --mau-sidebar: #0d1b3e;
                --mau-sidebar-dam: #091429;
                --mau-chu-de: #1a56db;
                --mau-chu-de-sang: #3b82f6;
                --mau-nen: #f0f4f8;
                --mau-trang: #ffffff;
                --mau-chu: #1e293b;
                --mau-chu-phu: #64748b;
                --mau-vien: #e2e8f0;
                --mau-xanh-nhat: #eff6ff;
                --mau-xanh-trung: #dbeafe;
                --bong-card: 0 4px 24px rgba(26,86,219,0.10);
                --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
            }

            /* ===== RESET & CƠ BẢN ===== */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* =============================================
                                                                       SIDEBAR - THANH ĐIỀU HƯỚNG BÊN TRÁI
                                                                    ============================================= */
            #thanh-sidebar {
                width: 220px;
                min-width: 220px;
                background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
                display: flex;
                flex-direction: column;
                height: 100vh;
                position: relative;
                z-index: 100;
                box-shadow: 4px 0 24px rgba(0,0,0,0.18);
                overflow-y: auto;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
            }

                #thanh-sidebar.an-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            /* Ẩn nhãn nhóm khi thu gọn */
            .nhan-nhom {
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
            }

            #thanh-sidebar.thu-gon .nhan-nhom {
                opacity: 0;
                max-height: 0;
                padding: 0;
            }

            /* Ẩn text trong menu item khi thu gọn */
            .menu-item span:not(.huy-hieu-menu) {
                transition: opacity 0.2s ease, max-width 0.35s ease;
                max-width: 160px;
                overflow: hidden;
                display: inline-block;
            }

            #thanh-sidebar.thu-gon .menu-item span:not(.huy-hieu-menu) {
                opacity: 0;
                max-width: 0;
            }

            #thanh-sidebar.thu-gon .huy-hieu-menu {
                opacity: 0;
                width: 0;
                overflow: hidden;
                padding: 0;
            }

            #thanh-sidebar.thu-gon .menu-item {
                padding: 10px 0;
                justify-content: center;
                border-radius: 10px;
                margin: 2px 8px;
            }

            #thanh-sidebar.thu-gon .admin-sidebar {
                justify-content: center;
            }

            /* Logo khu vực trên cùng sidebar */
            .logo-sidebar {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 28px 20px 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .logo-sidebar .bieu-tuong {
                    width: 60px;
                    height: 60px;
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background: transparent;
                }

                    .logo-sidebar .bieu-tuong img {
                        width: 100%;
                        height: 100%;
                        object-fit: contain;
                        border-radius: 10px;
                    }

                .logo-sidebar .ten-logo {
                    color: #fff;
                }

                    .logo-sidebar .ten-logo strong {
                        display: block;
                        font-size: 13px;
                        letter-spacing: 0.5px;
                    }

                    .logo-sidebar .ten-logo span {
                        font-size: 11px;
                        color: rgba(255,255,255,0.45);
                    }

            /* Nhãn nhóm menu */
            .nhan-nhom {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                padding: 18px 20px 6px 20px;
            }

            /* Mỗi mục menu trong sidebar */
            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 11px 20px;
                color: rgba(255,255,255,0.65);
                cursor: pointer;
                border-radius: 0 30px 30px 0;
                margin: 2px 10px 2px 0;
                transition: all 0.2s;
                font-size: 14px;
                text-decoration: none;
                position: relative;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(59,130,246,0.15);
                    color: #fff;
                }

                /* Menu đang được chọn (active) */
                .menu-item.dang-chon {
                    background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
                    color: #fff;
                    font-weight: 600;
                    box-shadow: 0 4px 16px rgba(26,86,219,0.3);
                }

                    .menu-item.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 70%;
                        width: 4px;
                        background: #60a5fa;
                        border-radius: 0 4px 4px 0;
                    }

            /* Badge số thông báo nhỏ trên menu */
            .huy-hieu-menu {
                margin-left: auto;
                background: #ef4444;
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 1px 7px;
                min-width: 20px;
                text-align: center;
            }

            /* Thông tin admin dưới đáy sidebar */
            .admin-sidebar {
                margin-top: auto;
                padding: 18px 16px;
                border-top: 1px solid rgba(255,255,255,0.07);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
            }

                .admin-sidebar .anh-admin {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 16px;
                    border: 2px solid rgba(255,255,255,0.2);
                }

                .admin-sidebar .ten-admin strong {
                    display: block;
                    color: #fff;
                    font-size: 10px;
                }

                .admin-sidebar .ten-admin span {
                    color: rgba(255,255,255,0.45);
                    font-size: 11px;
                }

            /* =============================================
                                                                       KHU VỰC CHÍNH (HEADER + NỘI DUNG)
                                                                    ============================================= */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* ===== HEADER TRÊN CÙNG ===== */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid var(--mau-vien);
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                flex-shrink: 0;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .nut-ham-menu {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 20px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: background 0.2s;
            }

                .nut-ham-menu:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-trang {
                font-size: 16px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .duong-dan {
                font-size: 12px;
                color: var(--mau-chu-phu);
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            /* Ô tìm kiếm trên header */
            .o-tim-kiem {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1px solid var(--mau-vien);
                border-radius: 24px;
                padding: 7px 16px;
                transition: all 0.2s;
            }

                .o-tim-kiem:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                }

                .o-tim-kiem input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 180px;
                    color: var(--mau-chu);
                }

                .o-tim-kiem i {
                    color: var(--mau-chu-phu);
                    font-size: 13px;
                }

            /* Nút chuông thông báo */
            .nut-thong-bao {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: 50%;
                transition: all 0.2s;
            }

                .nut-thong-bao:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .so-thong-bao {
                position: absolute;
                top: 2px;
                right: 2px;
                background: #ef4444;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            /* Khu vực avatar + tên admin trên header */
            .thong-tin-admin {
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                padding: 6px 12px;
                border-radius: 24px;
                transition: background 0.2s;
            }

                .thong-tin-admin:hover {
                    background: var(--mau-xanh-nhat);
                }

                .thong-tin-admin .anh-dai-dien {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 14px;
                    font-weight: 700;
                }

                .thong-tin-admin .ten {
                    font-size: 13px;
                    font-weight: 600;
                }

                .thong-tin-admin .chuc-vu {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                }

            /* =============================================
                                                                       NỘI DUNG TRANG ĐIỀU HÀNH
                                                                    ============================================= */
            #noi-dung-trang {
                flex: 1;
                overflow-y: auto;
                padding: 24px 28px;
            }

            /* Dòng tiêu đề đầu trang */
            .hang-chao-mung {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
            }

                .hang-chao-mung h2 {
                    font-size: 20px;
                    font-weight: 800;
                }

                .hang-chao-mung p {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            /* =============================================
                                                                       TABS CHUYỂN PHẦN
                                                                    ============================================= */
            .khu-vuc-tabs {
                display: flex;
                gap: 4px;
                background: var(--mau-trang);
                border: 1px solid var(--mau-vien);
                border-radius: 14px;
                padding: 6px;
                margin-bottom: 22px;
                box-shadow: var(--bong-card);
                width: fit-content;
            }

            .tab-nut {
                padding: 9px 20px;
                border-radius: 10px;
                border: none;
                background: none;
                font-size: 13px;
                font-weight: 600;
                color: var(--mau-chu-phu);
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 7px;
            }

                .tab-nut:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

                .tab-nut.dang-chon-tab {
                    background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                }

                .tab-nut .huy-hieu-tab {
                    background: rgba(255,255,255,0.3);
                    font-size: 10px;
                    font-weight: 700;
                    border-radius: 20px;
                    padding: 1px 6px;
                    min-width: 18px;
                    text-align: center;
                }

                .tab-nut:not(.dang-chon-tab) .huy-hieu-tab {
                    background: #ef4444;
                    color: #fff;
                }

            /* Khu vực nội dung mỗi tab - ẩn/hiện */
            .noi-dung-tab {
                display: none;
            }

                .noi-dung-tab.dang-hien {
                    display: block;
                }

            /* =============================================
                                                                       CARD KHUNG CHỨA BẢNG
                                                                    ============================================= */
            .card-bang {
                background: var(--mau-trang);
                border-radius: 16px;
                padding: 22px;
                box-shadow: var(--bong-card);
                border: 1px solid var(--mau-vien);
                position: relative;
                overflow: hidden;
                margin-bottom: 20px;
            }
                /* Vệt sáng gradient trên đầu card */
                .card-bang.viet-xanh::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #1a56db, #60a5fa);
                    border-radius: 16px 16px 0 0;
                }

                .card-bang.viet-xanh-la::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #059669, #34d399);
                    border-radius: 16px 16px 0 0;
                }

                .card-bang.viet-cam::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #f59e0b, #fbbf24);
                    border-radius: 16px 16px 0 0;
                }

                .card-bang.viet-tim::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #7c3aed, #a78bfa);
                    border-radius: 16px 16px 0 0;
                }

            /* Tiêu đề card */
            .tieu-de-card {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 18px;
            }

                .tieu-de-card h3 {
                    font-size: 15px;
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                    .tieu-de-card h3 i {
                        color: var(--mau-chu-de);
                        font-size: 14px;
                    }

            /* =============================================
                                                                       BẢNG DỮ LIỆU CHUNG
                                                                    ============================================= */
            .bang-du-lieu {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .bang-du-lieu th {
                    text-align: left;
                    padding: 8px 12px;
                    color: var(--mau-chu-phu);
                    font-weight: 600;
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    border-bottom: 2px solid var(--mau-vien);
                    white-space: nowrap;
                }

                .bang-du-lieu td {
                    padding: 11px 12px;
                    border-bottom: 1px solid var(--mau-vien);
                    vertical-align: middle;
                }

                .bang-du-lieu tr:last-child td {
                    border-bottom: none;
                }

                .bang-du-lieu tr:hover td {
                    background: var(--mau-xanh-nhat);
                }

            /* =============================================
                                                                       BADGE TRẠNG THÁI
                                                                    ============================================= */
            .badge {
                padding: 3px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
                white-space: nowrap;
                display: inline-block;
            }

                .badge.cho-xu-ly {
                    background: #fef3c7;
                    color: #d97706;
                }

                .badge.dang-xu-ly {
                    background: #dbeafe;
                    color: #1d4ed8;
                }

                .badge.cho-thanh-toan {
                    background: #ede9fe;
                    color: #7c3aed;
                }

                .badge.thanh-cong {
                    background: #dcfce7;
                    color: #16a34a;
                }

                .badge.da-huy {
                    background: #fee2e2;
                    color: #dc2626;
                }

                .badge.cho-duyet {
                    background: #fef3c7;
                    color: #d97706;
                }

                .badge.da-duyet {
                    background: #dcfce7;
                    color: #16a34a;
                }

                .badge.tu-choi {
                    background: #fee2e2;
                    color: #dc2626;
                }

                .badge.khan-cap {
                    background: #fee2e2;
                    color: #dc2626;
                }

                .badge.trung-binh {
                    background: #fef3c7;
                    color: #d97706;
                }

                .badge.thap {
                    background: #f0fdf4;
                    color: #16a34a;
                }

            /* =============================================
                                                                       NÚT HÀNH ĐỘNG
                                                                    ============================================= */
            .nut-hanh-dong {
                background: none;
                border: 1px solid var(--mau-vien);
                border-radius: 8px;
                padding: 5px 12px;
                font-size: 11px;
                cursor: pointer;
                color: var(--mau-chu-de);
                font-weight: 600;
                transition: all 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                white-space: nowrap;
            }

                .nut-hanh-dong:hover {
                    background: var(--mau-xanh-nhat);
                    border-color: var(--mau-chu-de-sang);
                }

                .nut-hanh-dong.xanh-la {
                    color: #059669;
                    border-color: #a7f3d0;
                }

                    .nut-hanh-dong.xanh-la:hover {
                        background: #ecfdf5;
                    }

                .nut-hanh-dong.cam {
                    color: #d97706;
                    border-color: #fde68a;
                }

                    .nut-hanh-dong.cam:hover {
                        background: #fffbeb;
                    }

                .nut-hanh-dong.do {
                    color: #dc2626;
                    border-color: #fecaca;
                }

                    .nut-hanh-dong.do:hover {
                        background: #fff1f2;
                    }

                .nut-hanh-dong.tim {
                    background: linear-gradient(135deg, #7c3aed, #a78bfa);
                    color: #fff;
                    border: none;
                    box-shadow: 0 2px 8px rgba(124,58,237,0.3);
                }

                    .nut-hanh-dong.tim:hover {
                        transform: translateY(-1px);
                        box-shadow: 0 4px 14px rgba(124,58,237,0.4);
                    }

            /* Nút chính (Primary) */
            .nut-chinh {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 9px 18px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 7px;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
            }

                .nut-chinh:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            /* =============================================
                                                                       THÔNG TIN PHI PHÒNG TRONG BẢNG
                                                                    ============================================= */
            .thong-tin-phong {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .ten-phong-bang {
                font-weight: 700;
                font-size: 13px;
            }

            .ten-nguoi-thue {
                font-size: 11px;
                color: var(--mau-chu-phu);
            }

            /* =============================================
                                                                       INPUT INLINE TRONG BẢNG (Báo giá giặt sấy)
                                                                    ============================================= */
            .nhom-nhap-bao-gia {
                display: flex;
                gap: 6px;
                align-items: center;
            }

            .input-bao-gia {
                width: 110px;
                padding: 6px 10px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 8px;
                font-size: 12px;
                outline: none;
                transition: border-color 0.2s;
                color: var(--mau-chu);
            }

                .input-bao-gia:focus {
                    border-color: var(--mau-chu-de-sang);
                    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
                }

            /* =============================================
                                                                       MODAL POPUP (dùng chung)
                                                                    ============================================= */
            .lop-che-modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(4px);
            }

                .lop-che-modal.hien {
                    display: flex;
                }

            .hop-modal {
                background: var(--mau-trang);
                border-radius: 16px;
                padding: 20px;
                width: 460px;
                max-width: 95vw;
                max-height: 90vh;
                overflow-y: auto;
                box-shadow: 0 20px 60px rgba(0,0,0,0.2);
                animation: hienModal 0.3s ease;
            }

                .hop-modal.lon {
                    width: 520px;
                }

            @@keyframes hienModal {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            .tieu-de-modal {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 14px;
            }

                .tieu-de-modal h3 {
                    font-size: 15px;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                    .tieu-de-modal h3 i {
                        color: var(--mau-chu-de);
                    }

            .nut-dong-modal {
                background: none;
                border: none;
                font-size: 20px;
                cursor: pointer;
                color: var(--mau-chu-phu);
                border-radius: 50%;
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
            }

                .nut-dong-modal:hover {
                    background: var(--mau-nen);
                    color: var(--mau-chu);
                }

            /* Hàng thông tin trong modal */
            .hang-thong-tin-modal {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                margin-bottom: 12px;
            }

            .o-thong-tin {
                background: var(--mau-nen);
                border-radius: 8px;
                padding: 8px 12px;
            }

                .o-thong-tin .nhan {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 4px;
                }

                .o-thong-tin .gia-tri {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--mau-chu);
                }

                    .o-thong-tin .gia-tri.noi-bat {
                        color: var(--mau-chu-de);
                        font-size: 16px;
                    }

            /* Ảnh trong modal */
            .khung-anh-modal {
                border-radius: 10px;
                overflow: hidden;
                border: 2px solid var(--mau-vien);
                margin-bottom: 12px;
                background: var(--mau-nen);
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 150px;
                max-height: 200px;
            }

                .khung-anh-modal img {
                    width: 100%;
                    max-height: 200px;
                    object-fit: cover;
                    border-radius: 8px;
                }

            .anh-placeholder {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 10px;
                padding: 40px;
                color: var(--mau-chu-phu);
            }

                .anh-placeholder i {
                    font-size: 48px;
                    opacity: 0.3;
                }

                .anh-placeholder span {
                    font-size: 13px;
                }

            /* Ô ghi chú trong modal */
            .nhom-truong-nhap {
                margin-bottom: 10px;
            }

            .nhan-truong-nhap {
                display: block;
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 6px;
                color: var(--mau-chu);
            }

            .truong-nhap {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                font-size: 13px;
                outline: none;
                transition: border-color 0.2s;
                color: var(--mau-chu);
            }

                .truong-nhap:focus {
                    border-color: var(--mau-chu-de-sang);
                    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
                }

            /* Nhóm nút cuối modal */
            .nhom-nut-modal {
                display: flex;
                gap: 10px;
                justify-content: flex-end;
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid var(--mau-vien);
            }

            .nut-huy {
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                border: none;
                padding: 10px 20px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.2s;
            }

                .nut-huy:hover {
                    background: var(--mau-vien);
                }

            .nut-luu {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                padding: 10px 24px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }

                .nut-luu:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

                .nut-luu.xanh-la {
                    background: linear-gradient(135deg, #059669, #10b981);
                    box-shadow: 0 4px 12px rgba(5,150,105,0.3);
                }

                    .nut-luu.xanh-la:hover {
                        box-shadow: 0 6px 20px rgba(5,150,105,0.4);
                    }

                .nut-luu.do {
                    background: linear-gradient(135deg, #dc2626, #ef4444);
                    box-shadow: 0 4px 12px rgba(220,38,38,0.3);
                }

                    .nut-luu.do:hover {
                        box-shadow: 0 6px 20px rgba(220,38,38,0.4);
                    }

            /* Đường kẻ phân cách thông tin điện nước trong modal */
            .phan-tach-dien-nuoc {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                margin-bottom: 12px;
            }

            .o-chi-so {
                background: linear-gradient(135deg, #eff6ff, #dbeafe);
                border: 1.5px solid #bfdbfe;
                border-radius: 10px;
                padding: 10px;
            }

                .o-chi-so.nuoc {
                    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
                    border-color: #86efac;
                }

                .o-chi-so .loai {
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 8px;
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

                .o-chi-so.dien .loai {
                    color: #1d4ed8;
                }

                .o-chi-so.nuoc .loai {
                    color: #15803d;
                }

                .o-chi-so .hang {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 4px;
                }

                    .o-chi-so .hang .ten {
                        font-size: 12px;
                        color: var(--mau-chu-phu);
                    }

                    .o-chi-so .hang .so-moi {
                        font-size: 15px;
                        font-weight: 800;
                    }

                .o-chi-so.dien .hang .so-moi {
                    color: #1d4ed8;
                }

                .o-chi-so.nuoc .hang .so-moi {
                    color: #15803d;
                }

                .o-chi-so .hang .so-cu {
                    font-size: 12px;
                    color: var(--mau-chu-phu);
                }

                .o-chi-so .tieu-thu {
                    font-size: 11px;
                    font-weight: 600;
                    margin-top: 6px;
                    padding-top: 6px;
                    border-top: 1px solid rgba(0,0,0,0.07);
                }

            /* =============================================
                                                                       SCROLLBAR TÙY CHỈNH
                                                                    ============================================= */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* =============================================
                                                                       RESPONSIVE
                                                                    ============================================= */
            @@media (max-width: 1100px) {
                .hang-thong-tin-modal {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 768px) {
                #thanh-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

                    #thanh-sidebar.mo {
                        width: 220px;
                        min-width: 220px;
                    }

                #noi-dung-trang {
                    padding: 16px;
                }

                .khu-vuc-tabs {
                    flex-wrap: wrap;
                    width: 100%;
                }
            }

            /* =============================================
                                                                       TRẠNG THÁI RỖNG (Không có dữ liệu)
                                                                    ============================================= */
            .trang-thai-rong {
                text-align: center;
                padding: 40px 20px;
                color: var(--mau-chu-phu);
            }

                .trang-thai-rong i {
                    font-size: 40px;
                    opacity: 0.2;
                    display: block;
                    margin-bottom: 10px;
                }

                .trang-thai-rong span {
                    font-size: 13px;
                }

            /* Toast thông báo nhanh */
            #toast-thong-bao {
                position: fixed;
                bottom: 28px;
                right: 28px;
                background: #1e293b;
                color: #fff;
                padding: 12px 20px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 600;
                box-shadow: 0 8px 24px rgba(0,0,0,0.2);
                z-index: 9999;
                opacity: 0;
                transform: translateY(20px);
                transition: all 0.3s;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                #toast-thong-bao.hien {
                    opacity: 1;
                    transform: translateY(0);
                }

                #toast-thong-bao.thanh-cong {
                    background: #059669;
                }

                #toast-thong-bao.loi {
                    background: #dc2626;
                }
    </style>
</head>
<body>

    <!-- =============================================
         SIDEBAR - THANH ĐIỀU HƯỚNG BÊN TRÁI
    ============================================= -->
    <nav id="thanh-sidebar">

        <!-- Logo + Tên hệ thống -->
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <!-- ===== NHÓM MENU CHÍNH ===== -->
        <div class="nhan-nhom">Tổng quan</div>

        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </div>

        <!-- ===== NHÓM QUẢN LÝ ===== -->
        <div class="nhan-nhom">Quản lý</div>

        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i>
            <span>Quản lý phòng trọ</span>
        </div>

        <div class="menu-item dang-chon" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i>
            <span>Quản lý dịch vụ và tiện ích</span>
            @if (Model.SoDonDVChoXuLy > 0)
            {
                <span class="huy-hieu-menu">@Model.SoDonDVChoXuLy</span>
            }
        </div>

        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Hóa đơn & Thu tiền</span>
        </div>

        <!-- ===== NHÓM HỖ TRỢ ===== -->
        <div class="nhan-nhom">Hỗ trợ</div>

        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            @if (Model.SoDonBaoTriChoXuLy > 0)
            {
                <span class="huy-hieu-menu">@Model.SoDonBaoTriChoXuLy</span>
            }
        </div>

        <div class="menu-item" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </div>

        <!-- Thông tin admin dưới đáy sidebar -->
        <div class="admin-sidebar" onclick="moThongTinAdmin()">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    @(Model.TenNguoiDung?.Length > 0 ? Model.TenNguoiDung[0].ToString().ToUpper() : "A")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.TenNguoiDung ?? "Admin")</strong>
                <span>@(Model.ChucVu ?? "Quản trị viên")</span>
            </div>
        </div>

    </nav><!-- Kết thúc SIDEBAR -->
    <!-- =============================================
         KHU VỰC CHÍNH
    ============================================= -->
    <div id="khu-vuc-chinh">

        <!-- ===== HEADER TRÊN CÙNG ===== -->
        <header id="thanh-header">
            <div class="header-trai">
                <!-- Nút ≡ đóng/mở sidebar trên mobile -->
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Điều Hành Dịch Vụ & Điện Nước</div>
                    <div class="duong-dan">Trang chủ / Dịch vụ & Điện nước</div>
                </div>
            </div>

            <div class="header-phai">
                <!-- Ô tìm kiếm -->
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <!-- ⚙️ BACKEND: Kết nối API tìm kiếm đơn dịch vụ -->
                    <input type="text" placeholder="Tìm phòng, đơn dịch vụ..." oninput="timKiem(this.value)" />
                </div>

                <!-- Chuông thông báo -->
                <button class="nut-thong-bao" onclick="moThongBao()">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>

                <!-- Avatar + tên admin -->
                <div class="thong-tin-admin" onclick="moMenuAdmin()">
                    <div class="anh-dai-dien">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                        }
                        else
                        {
                            @(Model.TenNguoiDung?.Length > 0 ? Model.TenNguoiDung[0].ToString().ToUpper() : "A")
                        }
                    </div>
                    <div>
                        <div class="ten">@(Model.TenNguoiDung ?? "Admin")</div>
                        <div class="chuc-vu">@(Model.ChucVu ?? "Quản trị viên")</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>
        <!-- Kết thúc HEADER -->
        <!-- =============================================
             NỘI DUNG TRANG ĐIỀU HÀNH
        ============================================= -->
        <div id="noi-dung-trang">

            <!-- Tiêu đề trang -->
            <div class="hang-chao-mung">
                <div>
                    <h2><i class="fas fa-concierge-bell" style="color:var(--mau-chu-de);margin-right:10px;"></i>Điều Hành Dịch Vụ & Điện Nước</h2>
                    <p id="ngay-gio-hien-tai">Đang tải ngày giờ...</p>
                </div>
            </div>

            <!-- =============================================
                 TABS CHUYỂN PHẦN: Đặt nước | Giặt sấy | Thanh toán | Điện nước
            ============================================= -->
            <div class="khu-vuc-tabs">
                <!-- Tab 1: Đặt nước bình -->
                <button class="tab-nut dang-chon-tab" onclick="chuyenTab('tab-nuoc-binh', this)">
                    <i class="fas fa-tint"></i>
                    <span>Đặt nước bình</span>
                    <!-- ⚙️ BACKEND: Số đơn chờ xử lý lấy từ API -->
                    <span class="huy-hieu-tab">3</span>
                </button>

                <!-- Tab 2: Giặt sấy -->
                <button class="tab-nut" onclick="chuyenTab('tab-giat-say', this)">
                    <i class="fas fa-tshirt"></i>
                    <span>Giặt sấy</span>
                    <span class="huy-hieu-tab">2</span>
                </button>

                <!-- Tab 3: Xác nhận thanh toán -->
                <button class="tab-nut" onclick="chuyenTab('tab-thanh-toan', this)">
                    <i class="fas fa-receipt"></i>
                    <span>Xác nhận thanh toán</span>
                    <span class="huy-hieu-tab">4</span>
                </button>

                <!-- Tab 4: Duyệt điện nước -->
                <button class="tab-nut" onclick="chuyenTab('tab-dien-nuoc', this)">
                    <i class="fas fa-bolt"></i>
                    <span>Duyệt điện nước</span>
                    <span class="huy-hieu-tab">5</span>
                </button>
            </div>


            <!-- =============================================
                 TAB 1: QUẢN LÝ ĐẶT NƯỚC BÌNH
                 (Bảng DONDV, LoaiDV = 'Nước bình')
            ============================================= -->
            <div id="tab-nuoc-binh" class="noi-dung-tab dang-hien">

                <!-- Card bảng đơn đặt nước đang chờ giao -->
                <div class="card-bang viet-xanh">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-tint"></i> Đơn đặt nước bình — Chờ xử lý</h3>
                        <!-- ⚙️ BACKEND: Lọc DONDV WHERE LoaiDV='Nước bình' AND TrangThai_DV IN ('Chờ xử lý','Đang xử lý') -->
                    </div>

                    <table class="bang-du-lieu" id="bang-nuoc-binh">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Phòng / Khách</th>
                                <th>Nội dung</th>
                                <th>Mức độ</th>
                                <th>Ngày đặt</th>
                                <th>Trạng thái</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="ds-don-nuoc">
                            <!-- =============================================
                                 MOCK DATA: Đơn đặt nước bình
                                 Khớp với model DONDV:
                                   IDDonDV, IDPhong, IDUser, LoaiDV='Nước bình',
                                   NoiDung, MucDo, TrangThai_DV, NgayTao
                            ============================================= -->
                            <tr id="don-nuoc-101">
                                <td style="font-weight:700;color:var(--mau-chu-de);">#101</td>
                                <td>
                                    <div class="thong-tin-phong">
                                        <span class="ten-phong-bang">Phòng 201</span>
                                        <span class="ten-nguoi-thue">Nguyễn Thị Lan</span>
                                    </div>
                                </td>
                                <td>Đặt 2 bình nước loại 20L</td>
                                <td><span class="badge trung-binh">Trung bình</span></td>
                                <td style="font-size:12px;color:var(--mau-chu-phu);">14/07/2025 09:15</td>
                                <td><span class="badge cho-xu-ly" id="tt-don-nuoc-101">Chờ xử lý</span></td>
                                <td>
                                    <!-- Nút xác nhận giao: chuyển sang "Chờ khách xác nhận & Thanh toán" -->
                                    <button class="nut-hanh-dong xanh-la" onclick="xacNhanGiao(101, 'don-nuoc-101', 'tt-don-nuoc-101')">
                                        <i class="fas fa-truck"></i> Xác nhận đã giao
                                    </button>
                                </td>
                            </tr>
                            <tr id="don-nuoc-102">
                                <td style="font-weight:700;color:var(--mau-chu-de);">#102</td>
                                <td>
                                    <div class="thong-tin-phong">
                                        <span class="ten-phong-bang">Phòng 305</span>
                                        <span class="ten-nguoi-thue">Trần Minh Khoa</span>
                                    </div>
                                </td>
                                <td>Đặt 1 bình nước loại 19L (Lavie)</td>
                                <td><span class="badge khan-cap">Khẩn cấp</span></td>
                                <td style="font-size:12px;color:var(--mau-chu-phu);">14/07/2025 10:30</td>
                                <td><span class="badge cho-xu-ly" id="tt-don-nuoc-102">Chờ xử lý</span></td>
                                <td>
                                    <button class="nut-hanh-dong xanh-la" onclick="xacNhanGiao(102, 'don-nuoc-102', 'tt-don-nuoc-102')">
                                        <i class="fas fa-truck"></i> Xác nhận đã giao
                                    </button>
                                </td>
                            </tr>
                            <tr id="don-nuoc-103">
                                <td style="font-weight:700;color:var(--mau-chu-de);">#103</td>
                                <td>
                                    <div class="thong-tin-phong">
                                        <span class="ten-phong-bang">Phòng 102</span>
                                        <span class="ten-nguoi-thue">Lê Thị Hoa</span>
                                    </div>
                                </td>
                                <td>Đặt 3 bình nước loại 20L</td>
                                <td><span class="badge thap">Thấp</span></td>
                                <td style="font-size:12px;color:var(--mau-chu-phu);">13/07/2025 16:45</td>
                                <td><span class="badge dang-xu-ly" id="tt-don-nuoc-103">Đang xử lý</span></td>
                                <td>
                                    <button class="nut-hanh-dong xanh-la" onclick="xacNhanGiao(103, 'don-nuoc-103', 'tt-don-nuoc-103')">
                                        <i class="fas fa-truck"></i> Xác nhận đã giao
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Card bảng đơn đã giao - Chờ khách xác nhận -->
                <div class="card-bang viet-tim">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-clock"></i> Đã giao — Chờ khách xác nhận & Thanh toán</h3>
                        <!-- ⚙️ BACKEND: Lọc DONDV WHERE LoaiDV='Nước bình' AND TrangThai_DV='Chờ thanh toán' -->
                    </div>

                    <table class="bang-du-lieu">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Phòng / Khách</th>
                                <th>Nội dung</th>
                                <th>Tổng tiền</th>
                                <th>Ngày giao</th>
                                <th>Trạng thái</th>
                            </tr>
