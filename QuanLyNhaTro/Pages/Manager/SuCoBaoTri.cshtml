@page "/Manager/SuCoBaoTri"
@model QuanLyNhaTro.Pages.Manager.SuCoBaoTriModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sự Cố & Bảo Trì</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="~/js/QuanLy/QuanLy-core.js"></script>
    <style>
        /* ===== BIẾN MÀU (kế thừa từ QuanLyDichVu.cshtml) ===== */
        :root {
        --mau-sidebar: #0d1b3e;
        --mau-sidebar-dam: #091429;
        --mau-chu-de: #1a56db;
        --mau-chu-de-sang: #3b82f6;
        --mau-nen: #f0f4f8;
        --mau-trang: #ffffff;
        --mau-chu: #1e293b;
        --mau-chu-phu: #64748b;
        --mau-vien: #e2e8f0;
        --mau-xanh-nhat: #eff6ff;
        --mau-xanh-trung: #dbeafe;
        --bong-card: 0 4px 24px rgba(26,86,219,0.10);
        --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
        }

        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        body {
        font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
        background: var(--mau-nen);
        color: var(--mau-chu);
        display: flex;
        height: 100vh;
        overflow: hidden;
        }

        /* ====================== SIDEBAR ====================== */
        #thanh-sidebar {
        width: 220px;
        min-width: 220px;
        background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
        display: flex;
        flex-direction: column;
        height: 100vh;
        position: relative;
        z-index: 100;
        box-shadow: 4px 0 24px rgba(0,0,0,0.18);
        overflow-y: auto;
        transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
        }

        #thanh-sidebar.an-sidebar {
        width: 0;
        min-width: 0;
        overflow: hidden;
        }

        .nhan-nhom {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        padding: 18px 20px 6px 20px;
        }

        .logo-sidebar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 28px 20px 24px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .logo-sidebar .bieu-tuong {
        width: 60px;
        height: 60px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: transparent;
        }

        .logo-sidebar .bieu-tuong img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 10px;
        }

        .logo-sidebar .ten-logo strong {
        display: block;
        font-size: 13px;
        letter-spacing: 0.5px;
        color: #fff;
        }

        .logo-sidebar .ten-logo span {
        font-size: 11px;
        color: rgba(255,255,255,0.45);
        }

        .menu-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 11px 20px;
        color: rgba(255,255,255,0.65);
        cursor: pointer;
        border-radius: 0 30px 30px 0;
        margin: 2px 10px 2px 0;
        transition: all 0.2s;
        font-size: 14px;
        text-decoration: none;
        position: relative;
        }

        .menu-item i {
        width: 20px;
        text-align: center;
        font-size: 15px;
        }

        .menu-item:hover {
        background: rgba(59,130,246,0.15);
        color: #fff;
        }

        .menu-item.dang-chon {
        background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(26,86,219,0.3);
        }

        .menu-item.dang-chon::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 70%;
        width: 4px;
        background: #60a5fa;
        border-radius: 0 4px 4px 0;
        }

        .huy-hieu-menu {
        margin-left: auto;
        background: #ef4444;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        border-radius: 20px;
        padding: 1px 7px;
        min-width: 20px;
        text-align: center;
        }

        .admin-sidebar {
        margin-top: auto;
        padding: 11px 16px;
        border-top: 1px solid rgba(255,255,255,0.07);
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        }

        .admin-sidebar .anh-admin {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a56db, #60a5fa);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
        border: 2px solid rgba(255,255,255,0.2);
        }

        .admin-sidebar .ten-admin strong {
        display: block;
        color: #fff;
        font-size: 13px;
        }

        .admin-sidebar .ten-admin span {
        color: rgba(255,255,255,0.45);
        font-size: 11px;
        }

        /* ====================== HEADER ====================== */
        #khu-vuc-chinh {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        }

        #thanh-header {
        background: var(--mau-trang);
        padding: 0 28px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--mau-vien);
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        flex-shrink: 0;
        }

        .header-trai {
        display: flex;
        align-items: center;
        gap: 16px;
        }

        .nut-ham-menu {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 20px;
        color: var(--mau-chu-phu);
        padding: 6px;
        border-radius: 8px;
        transition: background 0.2s;
        }

        .nut-ham-menu:hover {
        background: var(--mau-xanh-nhat);
        color: var(--mau-chu-de);
        }

        .tieu-de-trang {
        font-size: 16px;
        font-weight: 700;
        color: var(--mau-chu);
        }

        .duong-dan {
        font-size: 12px;
        color: var(--mau-chu-phu);
        }

        .header-phai {
        display: flex;
        align-items: center;
        gap: 16px;
        }

        .o-tim-kiem {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--mau-nen);
        border: 1px solid var(--mau-vien);
        border-radius: 24px;
        padding: 7px 16px;
        transition: all 0.2s;
        }

        .o-tim-kiem:focus-within {
        border-color: var(--mau-chu-de-sang);
        background: #fff;
        }

        .o-tim-kiem input {
        border: none;
        background: none;
        outline: none;
        font-size: 13px;
        width: 200px;
        color: var(--mau-chu);
        }

        .o-tim-kiem i {
        color: var(--mau-chu-phu);
        font-size: 13px;
        }

        .nut-thong-bao {
        position: relative;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        color: var(--mau-chu-phu);
        padding: 8px;
        border-radius: 50%;
        transition: all 0.2s;
        }

        .nut-thong-bao:hover {
        background: var(--mau-xanh-nhat);
        color: var(--mau-chu-de);
        }

        .so-thong-bao {
        position: absolute;
        top: 2px;
        right: 2px;
        background: #ef4444;
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        }

        .thong-tin-admin {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        padding: 6px 12px;
        border-radius: 24px;
        transition: background 0.2s;
        }

        .thong-tin-admin:hover {
        background: var(--mau-xanh-nhat);
        }

        .thong-tin-admin .anh-dai-dien {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a56db, #60a5fa);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        }

        .thong-tin-admin .ten {
        font-size: 13px;
        font-weight: 600;
        }

        .thong-tin-admin .chuc-vu {
        font-size: 11px;
        color: var(--mau-chu-phu);
        }

        /* ====================== NỘI DUNG ====================== */
        #noi-dung-trang {
        flex: 1;
        overflow-y: auto;
        padding: 24px 28px;
        }

        .hang-chao-mung {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        }

        .hang-chao-mung h2 {
        font-size: 20px;
        font-weight: 800;
        }

        .hang-chao-mung p {
        font-size: 13px;
        color: var(--mau-chu-phu);
        margin-top: 2px;
        }

        /* ====================== THỐNG KÊ BOXES ====================== */
        .luoi-thong-ke {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
        }

        .card-thong-ke {
        background: var(--mau-trang);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--bong-card);
        border: 1px solid var(--mau-vien);
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        }

        .card-thong-ke:hover {
        transform: translateY(-2px);
        box-shadow: var(--bong-card-hover);
        }

        .card-thong-ke::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: 16px 16px 0 0;
        }

        .card-thong-ke.xanh::after {
        background: linear-gradient(90deg, #1a56db, #3b82f6);
        }

        .card-thong-ke.cam::after {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
        }

        .card-thong-ke.xanh-la::after {
        background: linear-gradient(90deg, #059669, #34d399);
        }

        .card-thong-ke.do::after {
        background: linear-gradient(90deg, #dc2626, #ef4444);
        }

        .bieu-tuong-thongke {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
        }

        .bieu-tuong-thongke.xanh {
        background: #eff6ff;
        color: #1a56db;
        }

        .bieu-tuong-thongke.cam {
        background: #fffbeb;
        color: #d97706;
        }

        .bieu-tuong-thongke.xanh-la {
        background: #f0fdf4;
        color: #059669;
        }

        .bieu-tuong-thongke.do {
        background: #fff1f2;
        color: #dc2626;
        }

        .noi-dung-thongke .so-lieu {
        font-size: 28px;
        font-weight: 800;
        line-height: 1.1;
        }

        .noi-dung-thongke .so-lieu.xanh {
        color: #1a56db;
        }

        .noi-dung-thongke .so-lieu.cam {
        color: #d97706;
        }

        .noi-dung-thongke .so-lieu.xanh-la {
        color: #059669;
        }

        .noi-dung-thongke .so-lieu.do {
        color: #dc2626;
        }

        .noi-dung-thongke .nhan-thongke {
        font-size: 12px;
        color: var(--mau-chu-phu);
        margin-top: 3px;
        font-weight: 500;
        }

        /* ====================== FILTER + TÌM KIẾM ====================== */
        .thanh-cong-cu {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        }

        .nhom-filter {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        }

        .nut-filter {
        padding: 8px 18px;
        border-radius: 24px;
        border: 1.5px solid var(--mau-vien);
        background: var(--mau-trang);
        font-size: 12px;
        font-weight: 600;
        color: var(--mau-chu-phu);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
        }

        .nut-filter:hover {
        border-color: var(--mau-chu-de-sang);
        color: var(--mau-chu-de);
        background: var(--mau-xanh-nhat);
        }

        .nut-filter.dang-loc {
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(26,86,219,0.3);
        }

        .nut-filter.loc-thap.dang-loc {
        background: linear-gradient(135deg, #059669, #10b981);
        box-shadow: 0 4px 12px rgba(5,150,105,0.3);
        }

        .nut-filter.loc-trung.dang-loc {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        box-shadow: 0 4px 12px rgba(217,119,6,0.3);
        }

        .nut-filter.loc-khan.dang-loc {
        background: linear-gradient(135deg, #dc2626, #ef4444);
        box-shadow: 0 4px 12px rgba(220,38,38,0.3);
        }

        .so-ket-qua {
        font-size: 12px;
        color: var(--mau-chu-phu);
        padding: 8px 0;
        }

        /* ====================== LƯỚI CARD ====================== */
        #luoi-su-co {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
        }

        .card-su-co {
        background: var(--mau-trang);
        border-radius: 16px;
        border: 1.5px solid var(--mau-vien);
        box-shadow: var(--bong-card);
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        position: relative;
        }

        .card-su-co:hover {
        transform: translateY(-3px);
        box-shadow: var(--bong-card-hover);
        border-color: var(--mau-chu-de-sang);
        }

        /* Sọc màu trái card theo mức độ */
        .card-su-co::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        border-radius: 16px 0 0 16px;
        }

        .card-su-co.muc-thap::before {
        background: #10b981;
        }

        .card-su-co.muc-trung::before {
        background: #f59e0b;
        }

        .card-su-co.muc-khan::before {
        background: #ef4444;
        }

        .card-su-co-header {
        padding: 16px 18px 12px 22px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--mau-vien);
        }

        .card-su-co-header .tieu-de-nhom {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 0;
        }

        .bieu-tuong-loai {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        }

        .bieu-tuong-loai.hu-hong {
        background: #fff1f2;
        color: #dc2626;
        }

        .ten-su-co {
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--mau-chu);
        }

        .ma-don {
        font-size: 11px;
        color: var(--mau-chu-phu);
        margin-top: 2px;
        }

        .nhom-badge {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
        flex-shrink: 0;
        }

        .card-su-co-body {
        padding: 14px 18px 14px 22px;
        }

        .mo-ta-ngan {
        font-size: 12px;
        color: var(--mau-chu-phu);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 12px;
        min-height: 38px;
        }

        .thong-tin-nho {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 12px;
        }

        .hang-thong-tin {
        display: flex;
        align-items: center;
        gap: 6px;
        }

        .hang-thong-tin i {
        font-size: 11px;
        color: var(--mau-chu-phu);
        width: 14px;
        text-align: center;
        flex-shrink: 0;
        }

        .hang-thong-tin span {
        font-size: 12px;
        color: var(--mau-chu);
        }

        .hang-thong-tin .nhan-hang {
        font-size: 10px;
        color: var(--mau-chu-phu);
        display: block;
        }

        .card-su-co-footer {
        padding: 10px 18px 14px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        }

        .thoi-gian-tao {
        font-size: 11px;
        color: var(--mau-chu-phu);
        display: flex;
        align-items: center;
        gap: 5px;
        }

        .nut-xem-chitiet {
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 7px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 3px 10px rgba(26,86,219,0.3);
        transition: all 0.2s;
        }

        .nut-xem-chitiet:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 16px rgba(26,86,219,0.4);
        }

        /* ====================== BADGE ====================== */
        .badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
        }

        .badge.cho-xu-ly {
        background: #fef3c7;
        color: #d97706;
        }

        .badge.dang-xu-ly {
        background: #dbeafe;
        color: #1d4ed8;
        }

        .badge.thanh-cong {
        background: #dcfce7;
        color: #16a34a;
        }

        .badge.da-huy {
        background: #fee2e2;
        color: #dc2626;
        }

        .badge.khan-cap {
        background: #fee2e2;
        color: #dc2626;
        }

        .badge.trung-binh {
        background: #fef3c7;
        color: #d97706;
        }

        .badge.thap {
        background: #f0fdf4;
        color: #16a34a;
        }

        .badge.cho-thanh-toan {
        background: #ede9fe;
        color: #7c3aed;
        }

        /* ====================== TRANG THÁI RỖNG ====================== */
        #trang-thai-rong {
        display: none;
        text-align: center;
        padding: 60px 20px;
        color: var(--mau-chu-phu);
        background: var(--mau-trang);
        border-radius: 16px;
        border: 1.5px dashed var(--mau-vien);
        }

        #trang-thai-rong i {
        font-size: 48px;
        opacity: 0.2;
        display: block;
        margin-bottom: 12px;
        }

        #trang-thai-rong span {
        font-size: 14px;
        }

        /* ====================== MODAL CHI TIẾT ====================== */
        .lop-che-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 999;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
        }

        .lop-che-modal.hien {
        display: flex;
        }

        .hop-modal {
        background: var(--mau-trang);
        border-radius: 20px;
        padding: 24px;
        width: 580px;
        max-width: 95vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        animation: hienModal 0.3s ease;
        }

        @@keyframes hienModal {
        from {
        opacity: 0;
        transform: scale(0.92) translateY(-16px);
        }

        to {
        opacity: 1;
        transform: none;
        }
        }

        .tieu-de-modal {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        }

        .tieu-de-modal h3 {
        font-size: 16px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .tieu-de-modal h3 i {
        color: var(--mau-chu-de);
        }

        .nut-dong-modal {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--mau-chu-phu);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        }

        .nut-dong-modal:hover {
        background: var(--mau-nen);
        color: var(--mau-chu);
        }

        /* Banner mức độ trong modal */
        .banner-muc-do {
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 700;
        }

        .banner-muc-do.khan {
        background: #fff1f2;
        color: #dc2626;
        border: 1.5px solid #fecaca;
        }

        .banner-muc-do.trung {
        background: #fffbeb;
        color: #d97706;
        border: 1.5px solid #fde68a;
        }

        .banner-muc-do.thap {
        background: #f0fdf4;
        color: #059669;
        border: 1.5px solid #a7f3d0;
        }

        .luoi-chi-tiet {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 14px;
        }

        .o-chi-tiet {
        background: var(--mau-nen);
        border-radius: 10px;
        padding: 10px 14px;
        }

        .o-chi-tiet.full {
        grid-column: 1 / -1;
        }

        .o-chi-tiet .nhan {
        font-size: 10px;
        color: var(--mau-chu-phu);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
        }

        .o-chi-tiet .gia-tri {
        font-size: 13px;
        font-weight: 600;
        color: var(--mau-chu);
        }

        .o-chi-tiet .gia-tri.noi-bat {
        color: var(--mau-chu-de);
        font-size: 15px;
        }

        /* Ảnh trong modal */
        .nhan-anh {
        font-size: 12px;
        font-weight: 600;
        color: var(--mau-chu);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        }

        .nhan-anh i {
        color: var(--mau-chu-de);
        }

        .khung-anh {
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid var(--mau-vien);
        margin-bottom: 14px;
        background: var(--mau-nen);
        min-height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        }

        .khung-anh img {
        width: 100%;
        max-height: 240px;
        object-fit: cover;
        border-radius: 10px;
        }

        .anh-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 40px;
        color: var(--mau-chu-phu);
        }

        .anh-placeholder i {
        font-size: 40px;
        opacity: 0.2;
        }

        .anh-placeholder span {
        font-size: 12px;
        }

        /* Nhóm nút modal */
        .nhom-nut-modal {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--mau-vien);
        }

        .nut-huy {
        background: var(--mau-nen);
        color: var(--mau-chu-phu);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s;
        }

        .nut-huy:hover {
        background: var(--mau-vien);
        }

        .nut-xu-ly {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(217,119,6,0.3);
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        }

        .nut-xu-ly:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(217,119,6,0.4);
        }

        .nut-hoan-thanh {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(5,150,105,0.3);
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        }

        .nut-hoan-thanh:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(5,150,105,0.4);
        }

        /* Ô ghi chú xử lý trong modal */
        .nhom-truong-nhap {
        margin-bottom: 10px;
        }

        .nhan-truong-nhap {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--mau-chu);
        }

        .truong-nhap {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--mau-vien);
        border-radius: 10px;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
        color: var(--mau-chu);
        }

        .truong-nhap:focus {
        border-color: var(--mau-chu-de-sang);
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

        /* ====================== TOAST ====================== */
        #toast-thong-bao {
        position: fixed;
        bottom: 28px;
        right: 28px;
        background: #1e293b;
        color: #fff;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        z-index: 9999;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 10px;
        }

        #toast-thong-bao.hien {
        opacity: 1;
        transform: translateY(0);
        }

        #toast-thong-bao.thanh-cong {
        background: #059669;
        }

        #toast-thong-bao.loi {
        background: #dc2626;
        }

        /* ====================== SCROLLBAR ====================== */
        ::-webkit-scrollbar {
        width: 6px;
        }

        ::-webkit-scrollbar-track {
        background: transparent;
        }

        ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
        }

        /* ====================== RESPONSIVE ====================== */
        @@media (max-width: 1200px) {
        .luoi-thong-ke {
        grid-template-columns: repeat(2, 1fr);
        }
        }

        @@media (max-width: 900px) {
        #luoi-su-co {
        grid-template-columns: 1fr;
        }
        }

        @@media (max-width: 768px) {
        #thanh-sidebar {
        width: 0;
        min-width: 0;
        overflow: hidden;
        }

        #thanh-sidebar.mo {
        width: 220px;
        min-width: 220px;
        }

        #noi-dung-trang {
        padding: 16px;
        }

        .luoi-thong-ke {
        grid-template-columns: repeat(2, 1fr);
        }

        .thanh-cong-cu {
        flex-direction: column;
        align-items: flex-start;
        }
        }

        @@media (max-width: 480px) {
        .luoi-thong-ke {
        grid-template-columns: 1fr;
        }
        }
        /* =========================================================
        ADMIN HEADER DROPDOWN – REUSE từ Manager
        ========================================================= */
        .thong-tin-admin {
        position: relative;
        }

        .mgr-dropdown {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 240px;
        background: var(--mau-trang);
        border-radius: 14px;
        border: 1px solid var(--mau-vien);
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(13,27,62,0.14), 0 2px 8px rgba(13,27,62,0.06);
        z-index: 999;
        transform-origin: top right;
        transform: scale(0.92) translateY(-8px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1), opacity 0.15s ease;
        }

        .mgr-dropdown.show {
        transform: scale(1) translateY(0);
        opacity: 1;
        pointer-events: all;
        }

        .mgr-dd-header {
        padding: 14px 16px 12px;
        border-bottom: 1px solid var(--mau-vien);
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .mgr-dd-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        flex-shrink: 0;
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        border: 2px solid rgba(255,255,255,0.2);
        }

        .mgr-dd-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--mau-chu);
        }

        .mgr-dd-sub {
        font-size: 11px;
        color: var(--mau-chu-phu);
        margin-top: 2px;
        }

        .mgr-dd-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        padding: 2px 8px;
        border-radius: 9999px;
        margin-top: 4px;
        background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
        color: #fff;
        }

        .mgr-dd-body {
        padding: 6px;
        }

        .mgr-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 12px;
        border-radius: 9px;
        cursor: pointer;
        transition: background 0.14s;
        border: none;
        background: none;
        width: 100%;
        font-family: inherit;
        text-align: left;
        }

        .mgr-item:hover {
        background: var(--mau-nen);
        }

        .mgr-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        }

        .mgr-item-icon.blue {
        background: var(--mau-xanh-nhat);
        color: var(--mau-chu-de);
        }

        .mgr-item-icon.red {
        background: #fef2f2;
        color: #dc2626;
        }

        .mgr-item-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--mau-chu);
        }

        .mgr-item-sub {
        font-size: 10.5px;
        color: var(--mau-chu-phu);
        margin-top: 1px;
        }

        .mgr-item.danger:hover {
        background: #fef2f2;
        }

        .mgr-item.danger:hover .mgr-item-label {
        color: #dc2626;
        }

        .mgr-divider {
        height: 1px;
        background: var(--mau-vien);
        margin: 4px 0;
        }

        /* Đổi mật khẩu input fields */
        .mk-input-wrap {
        position: relative;
        }

        .mk-eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--mau-chu-phu);
        font-size: 13px;
        }

        .mk-alert {
        display: none;
        margin-bottom: 14px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        }

        .inp-mk {
        width: 100%;
        padding: 10px 40px 10px 14px;
        border: 1.5px solid var(--mau-vien);
        border-radius: 10px;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
        color: var(--mau-chu);
        font-family: inherit;
        background: #fff;
        }

        .inp-mk:focus {
        border-color: var(--mau-chu-de-sang);
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }
    </style>
</head>
<body>

    <!-- ====================== SIDEBAR ====================== -->
    <nav id="thanh-sidebar">
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>

        <div class="nhan-nhom">Quản lý</div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i><span>Dịch vụ & Tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn & Thu tiền</span>
        </div>

        <div class="nhan-nhom">Hỗ trợ</div>
        <div class="menu-item dang-chon" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="admin-sidebar">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
                {
                    <img src="@Model.CurrentUser.Avatar" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="Avatar" />
                }
                else
                {
                    @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
                <span>@(Model.CurrentUser?.Roles ?? "Quản trị viên")</span>
            </div>
        </div>
    </nav>

    <!-- ====================== KHU VỰC CHÍNH ====================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Quản Lý Sự Cố & Bảo Trì</div>
                    <div class="duong-dan">Trang chủ / Hỗ trợ / Sự cố & Bảo trì</div>
                </div>
            </div>
            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" id="input-tim-kiem"
                           placeholder="Tìm tên sự cố, phòng, người gửi..."
                           oninput="timKiem(this.value)" />
                </div>
                <button class="nut-thong-bao">
                    <i class="fas fa-bell"></i>
                    <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                </button>
                <div class="thong-tin-admin">
                    <div class="anh-dai-dien">
                        @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div>
                        <div class="ten">@(Model.CurrentUser?.FullName ?? "Admin")</div>
                        <div class="chuc-vu">@(Model.CurrentUser?.Roles ?? "Quản trị viên")</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG TRANG -->
        <div id="noi-dung-trang">

            <!-- Tiêu đề -->
            <div class="hang-chao-mung">
                <div>
                    <h2><i class="fas fa-tools" style="color:var(--mau-chu-de);margin-right:10px;"></i>Quản Lý Sự Cố & Bảo Trì</h2>
                    <p id="ngay-gio-hien-tai">Đang tải...</p>
                </div>
            </div>

            <!-- ====== THỐNG KÊ ====== -->
            <div class="luoi-thong-ke">
                <div class="card-thong-ke xanh">
                    <div class="bieu-tuong-thongke xanh">
                        <i class="fas fa-clipboard-list"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu xanh">@Model.TongSuCo</div>
                        <div class="nhan-thongke">Tổng sự cố</div>
                    </div>
                </div>
                <div class="card-thong-ke cam">
                    <div class="bieu-tuong-thongke cam">
                        <i class="fas fa-spinner"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu cam">@Model.DangXuLy</div>
                        <div class="nhan-thongke">Đang xử lý</div>
                    </div>
                </div>
                <div class="card-thong-ke xanh-la">
                    <div class="bieu-tuong-thongke xanh-la">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu xanh-la">@Model.DaXuLy</div>
                        <div class="nhan-thongke">Đã xử lý</div>
                    </div>
                </div>
                <div class="card-thong-ke do">
                    <div class="bieu-tuong-thongke do">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu do">@Model.KhanCap</div>
                        <div class="nhan-thongke">Khẩn cấp</div>
                    </div>
                </div>
            </div>

            <!-- ====== FILTER + TÌM KIẾM ====== -->
            <div class="thanh-cong-cu">
                <div class="nhom-filter">
                    <button class="nut-filter dang-loc" id="filter-tat-ca" onclick="loc('tat-ca', this)">
                        <i class="fas fa-th-list"></i> Tất cả
                    </button>
                    <button class="nut-filter loc-thap" id="filter-thap" onclick="loc('Thấp', this)">
                        <i class="fas fa-circle" style="color:#10b981;font-size:8px;"></i> Thấp
                    </button>
                    <button class="nut-filter loc-trung" id="filter-trung" onclick="loc('Trung bình', this)">
                        <i class="fas fa-circle" style="color:#f59e0b;font-size:8px;"></i> Trung bình
                    </button>
                    <button class="nut-filter loc-khan" id="filter-khan" onclick="loc('Khẩn cấp', this)">
                        <i class="fas fa-circle" style="color:#ef4444;font-size:8px;"></i> Khẩn cấp
                    </button>
                </div>
                <div class="so-ket-qua" id="so-ket-qua">
                    Hiển thị <strong>@Model.DanhSachSuCo.Count()</strong> sự cố
                </div>
            </div>

            <!-- ====== LƯỚI CARD SỰ CỐ ====== -->
            <div id="luoi-su-co">
                @foreach (var don in Model.DanhSachSuCo)
                {
                    // Xác định CSS class theo mức độ
                    string mucDoClass = don.MucDo switch
                    {
                        "Thấp" => "muc-thap",
                        "Trung bình" => "muc-trung",
                        "Khẩn cấp" => "muc-khan",
                        _ => "muc-trung"
                    };
                    string badgeMucDo = don.MucDo switch
                    {
                        "Thấp" => "thap",
                        "Trung bình" => "trung-binh",
                        "Khẩn cấp" => "khan-cap",
                        _ => "trung-binh"
                    };
                    string badgeTrangThai = don.TrangThai_DV switch
                    {
                        "Chờ xử lý" => "cho-xu-ly",
                        "Đang xử lý" => "dang-xu-ly",
                        "Chờ thanh toán" => "cho-thanh-toan",
                        "Thành công" => "thanh-cong",
                        "Đã hủy" => "da-huy",
                        _ => "cho-xu-ly"
                    };
                    // Null-safe
                    string tenNguoiGui = don.Tenant?.FullName ?? "—";
                    string soPhong = don.Phong?.SoPhong ?? "—";
                    string ngayTaoStr = don.NgayTao.ToString("dd/MM/yyyy HH:mm");
                    string noiDungHienThi = don.NoiDung ?? "(Không có mô tả)";

                    <div class="card-su-co @mucDoClass"
                         data-muc-do="@don.MucDo"
                         data-ten="@(don.NoiDung ?? "")"
                         data-phong="@soPhong"
                         data-nguoi="@tenNguoiGui">

                        <!-- HEADER CARD -->
                        <div class="card-su-co-header">
                            <div class="tieu-de-nhom">
                                <div class="bieu-tuong-loai hu-hong">
                                    <i class="fas fa-wrench"></i>
                                </div>
                                <div style="min-width:0;">
                                    <div class="ten-su-co" title="@noiDungHienThi">
                                        @(noiDungHienThi.Length > 40 ? noiDungHienThi.Substring(0, 40) + "..." : noiDungHienThi)
                                    </div>
                                    <div class="ma-don">#@don.IDDonDV</div>
                                </div>
                            </div>
                            <div class="nhom-badge">
                                <span class="badge @badgeMucDo">@don.MucDo</span>
                                <span class="badge @badgeTrangThai">@don.TrangThai_DV</span>
                            </div>
                        </div>

                        <!-- BODY CARD -->
                        <div class="card-su-co-body">
                            <div class="mo-ta-ngan">@noiDungHienThi</div>
                            <div class="thong-tin-nho">
                                <div class="hang-thong-tin">
                                    <i class="fas fa-door-open"></i>
                                    <div>
                                        <span class="nhan-hang">Phòng</span>
                                        <span>@soPhong</span>
                                    </div>
                                </div>
                                <div class="hang-thong-tin">
                                    <i class="fas fa-user"></i>
                                    <div>
                                        <span class="nhan-hang">Người gửi</span>
                                        <span>@tenNguoiGui</span>
                                    </div>
                                </div>
                                @if (don.ManagerXuLy != null)
                                {
                                    <div class="hang-thong-tin">
                                        <i class="fas fa-user-cog"></i>
                                        <div>
                                            <span class="nhan-hang">Người xử lý</span>
                                            <span>@don.ManagerXuLy.FullName</span>
                                        </div>
                                    </div>
                                }
                                @if (don.NgayXuLy.HasValue)
                                {
                                    <div class="hang-thong-tin">
                                        <i class="fas fa-calendar-check"></i>
                                        <div>
                                            <span class="nhan-hang">Ngày xử lý</span>
                                            <span>@don.NgayXuLy.Value.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- FOOTER CARD -->
                        <div class="card-su-co-footer">
                            <div class="thoi-gian-tao">
                                <i class="fas fa-clock"></i>
                                @ngayTaoStr
                            </div>
                            <button class="nut-xem-chitiet"
                                    onclick="moModalChiTiet(@don.IDDonDV)">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Trạng thái rỗng khi filter không có kết quả -->
            <div id="trang-thai-rong">
                <i class="fas fa-search"></i>
                <span>Không tìm thấy sự cố nào phù hợp</span>
            </div>

        </div><!-- Kết thúc noi-dung-trang -->
    </div><!-- Kết thúc khu-vuc-chinh -->
    <!-- ====================== MODAL CHI TIẾT ====================== -->
    <div class="lop-che-modal" id="modal-chi-tiet" onclick="dongModalNeuNhanNgoai(event, 'modal-chi-tiet')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3><i class="fas fa-tools"></i> Chi tiết sự cố / bảo trì</h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Banner mức độ -->
            <div id="modal-banner-muc-do" class="banner-muc-do"></div>

            <!-- Thông tin chi tiết từ DONDV model -->
            <div class="luoi-chi-tiet">
                <div class="o-chi-tiet">
                    <div class="nhan">Mã đơn</div>
                    <div class="gia-tri noi-bat" id="modal-ma-don">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Trạng thái</div>
                    <div id="modal-trang-thai">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Phòng</div>
                    <div class="gia-tri" id="modal-phong">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Người gửi</div>
                    <div class="gia-tri" id="modal-nguoi-gui">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Mức độ khẩn cấp</div>
                    <div id="modal-muc-do">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày tạo</div>
                    <div class="gia-tri" id="modal-ngay-tao">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Người xử lý</div>
                    <div class="gia-tri" id="modal-nguoi-xu-ly">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày xử lý</div>
                    <div class="gia-tri" id="modal-ngay-xu-ly">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày hoàn thành</div>
                    <div class="gia-tri" id="modal-ngay-hoan-thanh">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Tổng chi phí</div>
                    <div class="gia-tri" id="modal-tong-tien" style="color:#059669;">—</div>
                </div>
                <div class="o-chi-tiet full">
                    <div class="nhan">Mô tả đầy đủ</div>
                    <div class="gia-tri" id="modal-noi-dung" style="font-weight:400;line-height:1.6;">—</div>
                </div>
                <div class="o-chi-tiet full" id="nhom-ghi-chu-xu-ly" style="display:none;">
                    <div class="nhan">Ghi chú xử lý</div>
                    <div class="gia-tri" id="modal-ghi-chu-xu-ly" style="font-weight:400;"></div>
                </div>
                <div class="o-chi-tiet full" id="nhom-ly-do-huy" style="display:none;">
                    <div class="nhan">Lý do hủy</div>
                    <div class="gia-tri" id="modal-ly-do-huy" style="color:#dc2626;font-weight:400;"></div>
                </div>
            </div>

            <!-- Ảnh biên lai (AnhBienLai) -->
            <div id="nhom-anh-bien-lai" style="display:none;">
                <p class="nhan-anh"><i class="fas fa-receipt"></i> Ảnh biên lai / chứng từ</p>
                <div class="khung-anh">
                    <img id="modal-anh-bien-lai" src="" alt="Ảnh biên lai" />
                </div>
            </div>

            <!-- Ảnh kết quả (AnhKetQua) -->
            <div id="nhom-anh-ket-qua" style="display:none;">
                <p class="nhan-anh"><i class="fas fa-image"></i> Ảnh kết quả xử lý</p>
                <div class="khung-anh">
                    <img id="modal-anh-ket-qua" src="" alt="Ảnh kết quả" />
                </div>
            </div>

            <!-- Không có ảnh nào -->
            <div id="khung-anh-placeholder" class="khung-anh" style="display:none;">
                <div class="anh-placeholder">
                    <i class="fas fa-image"></i>
                    <span>Chưa có ảnh đính kèm</span>
                </div>
            </div>

            <!-- Ghi chú xử lý (input để manager nhập) -->
            <div class="nhom-truong-nhap" id="nhom-nhap-ghi-chu" style="display:none;">
                <label class="nhan-truong-nhap">Ghi chú xử lý</label>
                <input type="text" class="truong-nhap" id="input-ghi-chu-xu-ly"
                       placeholder="Nhập ghi chú khi xử lý / hoàn thành..." />
            </div>

            <!-- Nhóm nút -->
            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-chi-tiet')">
                    <i class="fas fa-times"></i> Đóng
                </button>
                <button class="nut-xu-ly" id="nut-bat-dau-xu-ly" onclick="batDauXuLy()" style="display:none;">
                    <i class="fas fa-play"></i> Bắt đầu xử lý
                </button>
                <button class="nut-hoan-thanh" id="nut-hoan-thanh" onclick="hoanThanhXuLy()" style="display:none;">
                    <i class="fas fa-check-double"></i> Hoàn thành
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast-thong-bao">
        <i class="fas fa-check-circle"></i>
        <span id="toast-noi-dung">Thao tác thành công!</span>
    </div>

    <!-- ====================== DỮ LIỆU RAZOR → JS ====================== -->
    <!--
        Inject danh sách từ Model vào JS để modal hoạt động phía client
        mà không cần gọi thêm API.
        Controller cần Include: .Include(d => d.Tenant).Include(d => d.Phong).Include(d => d.ManagerXuLy)
    -->
    @Html.AntiForgeryToken()
    <script>
        // [LỖI 3 ĐÃ SỬA] Lấy CSRF token để gửi kèm các POST request
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // Dữ liệu được inject từ Razor Model
        // Dùng Html.Raw + Json.Serialize để tránh HTML-encode ký tự tiếng Việt
        const danhSachSuCo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.DanhSachSuCo.Select(don => new
                            {
                                id = don.IDDonDV,
                                noiDung = don.NoiDung ?? "",
                                phong = don.Phong?.SoPhong ?? "",
                                nguoiGui = don.Tenant?.FullName ?? "",
                                nguoiXuLy = don.ManagerXuLy?.FullName ?? "",
                                mucDo = don.MucDo,
                                trangThai = don.TrangThai_DV,
                                ngayTao = don.NgayTao.ToString("dd/MM/yyyy HH:mm"),
                                ngayXuLy = don.NgayXuLy.HasValue ? don.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "",
                                ngayHoanThanh = don.NgayHoanThanh.HasValue ? don.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm") : "",
                                tongTien = don.TongTien > 0 ? don.TongTien.ToString("N0") + " ₫" : "—",
                                ghiChuXuLy = don.GhiChuXuLy ?? "",
                                lyDoHuy = don.LyDoHuy ?? "",
                                anhBienLai = don.AnhBienLai ?? "",
                                anhKetQua = don.AnhKetQua ?? ""
                            })
                        ));

        // ====== NGÀY GIỜ HIỆN TẠI ======
        (function() {
        const ngay = new Date();
        const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        document.getElementById('ngay-gio-hien-tai').textContent =
        `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
        })();

        // ====== BIẾN TRẠNG THÁI ======
        let idDangXuLy = null;
        let mucLocHienTai = 'tat-ca';
        let tuKhoaHienTai = '';

        // ====== LỌC THEO MỨC ĐỘ ======
        function loc(mucDo, phanTu) {
        // Xóa active tất cả nút filter
        document.querySelectorAll('.nut-filter').forEach(b => b.classList.remove('dang-loc'));
        phanTu.classList.add('dang-loc');
        mucLocHienTai = mucDo;
        apDungLoc();
        }

        // ====== TÌM KIẾM ======
        function timKiem(tuKhoa) {
        tuKhoaHienTai = tuKhoa.toLowerCase().trim();
        apDungLoc();
        }

        // ====== ÁP DỤNG LỌC + TÌM KIẾM ======
        function apDungLoc() {
        const cards = document.querySelectorAll('.card-su-co');
        let soHienThi = 0;

        cards.forEach(card => {
        const mucDo   = card.dataset.mucDo  || '';
        const ten     = card.dataset.ten    || '';
        const phong   = card.dataset.phong  || '';
        const nguoi   = card.dataset.nguoi  || '';

        const hopMucDo = mucLocHienTai === 'tat-ca' || mucDo === mucLocHienTai;
        const hopTuKhoa = !tuKhoaHienTai ||
        ten.toLowerCase().includes(tuKhoaHienTai) ||
        phong.toLowerCase().includes(tuKhoaHienTai) ||
        nguoi.toLowerCase().includes(tuKhoaHienTai);

        const hienThi = hopMucDo && hopTuKhoa;
        card.style.display = hienThi ? '' : 'none';
        if (hienThi) soHienThi++;
        });

        // Cập nhật số kết quả
        document.getElementById('so-ket-qua').innerHTML =
        `Hiển thị <strong>${soHienThi}</strong> sự cố`;

        // Hiện trạng thái rỗng nếu không có kết quả
        document.getElementById('trang-thai-rong').style.display =
        soHienThi === 0 ? 'block' : 'none';
        }

        // ====== MỞ MODAL CHI TIẾT ======
        function moModalChiTiet(id) {
        const don = danhSachSuCo.find(d => d.id === id);
        if (!don) return;

        idDangXuLy = id;

        // Điền thông tin
        document.getElementById('modal-ma-don').textContent    = '#' + don.id;
        document.getElementById('modal-phong').textContent     = don.phong || '—';
        document.getElementById('modal-nguoi-gui').textContent  = don.nguoiGui || '—';
        document.getElementById('modal-noi-dung').textContent   = don.noiDung || '(Không có mô tả)';
        document.getElementById('modal-ngay-tao').textContent   = don.ngayTao || '—';
        document.getElementById('modal-nguoi-xu-ly').textContent = don.nguoiXuLy || '—';
        document.getElementById('modal-ngay-xu-ly').textContent  = don.ngayXuLy || '—';
        document.getElementById('modal-ngay-hoan-thanh').textContent = don.ngayHoanThanh || '—';
        document.getElementById('modal-tong-tien').textContent  = don.tongTien || '—';

        // Badge mức độ
        const badgeMucDo = {
        'Thấp':     '<span class="badge thap">Thấp</span>',
        'Trung bình': '<span class="badge trung-binh">Trung bình</span>',
        'Khẩn cấp': '<span class="badge khan-cap">Khẩn cấp</span>'
        };
        document.getElementById('modal-muc-do').innerHTML = badgeMucDo[don.mucDo] || don.mucDo;

        // Badge trạng thái
        const badgeTT = {
        'Chờ xử lý':    '<span class="badge cho-xu-ly">Chờ xử lý</span>',
        'Đang xử lý':   '<span class="badge dang-xu-ly">Đang xử lý</span>',
        'Chờ thanh toán': '<span class="badge cho-thanh-toan">Chờ thanh toán</span>',
        'Thành công':   '<span class="badge thanh-cong">Thành công</span>',
        'Đã hủy':       '<span class="badge da-huy">Đã hủy</span>'
        };
        document.getElementById('modal-trang-thai').innerHTML = badgeTT[don.trangThai] || don.trangThai;

        // Banner mức độ
        const bannerEl = document.getElementById('modal-banner-muc-do');
        const bannerMap = {
        'Thấp':      { cls: 'thap',  icon: 'fa-info-circle',           text: 'Mức độ thấp — Xử lý trong thời gian bình thường' },
        'Trung bình':{ cls: 'trung', icon: 'fa-exclamation-circle',     text: 'Mức độ trung bình — Cần xử lý sớm' },
        'Khẩn cấp':  { cls: 'khan', icon: 'fa-exclamation-triangle',    text: 'KHẨN CẤP — Cần xử lý ngay lập tức!' }
        };
        const b = bannerMap[don.mucDo] || bannerMap['Trung bình'];
        bannerEl.className = `banner-muc-do ${b.cls}`;
        bannerEl.innerHTML = `<i class="fas ${b.icon}"></i> ${b.text}`;

        // Ghi chú xử lý
        if (don.ghiChuXuLy) {
        document.getElementById('nhom-ghi-chu-xu-ly').style.display = '';
        document.getElementById('modal-ghi-chu-xu-ly').textContent = don.ghiChuXuLy;
        } else {
        document.getElementById('nhom-ghi-chu-xu-ly').style.display = 'none';
        }

        // Lý do hủy
        if (don.lyDoHuy) {
        document.getElementById('nhom-ly-do-huy').style.display = '';
        document.getElementById('modal-ly-do-huy').textContent = don.lyDoHuy;
        } else {
        document.getElementById('nhom-ly-do-huy').style.display = 'none';
        }

        // Ảnh biên lai
        const coAnhBL = !!don.anhBienLai;
        document.getElementById('nhom-anh-bien-lai').style.display = coAnhBL ? '' : 'none';
        if (coAnhBL) document.getElementById('modal-anh-bien-lai').src = don.anhBienLai;

        // Ảnh kết quả
        const coAnhKQ = !!don.anhKetQua;
        document.getElementById('nhom-anh-ket-qua').style.display = coAnhKQ ? '' : 'none';
        if (coAnhKQ) document.getElementById('modal-anh-ket-qua').src = don.anhKetQua;

        // Placeholder nếu không có ảnh nào
        document.getElementById('khung-anh-placeholder').style.display =
        (!coAnhBL && !coAnhKQ) ? '' : 'none';

        // Hiện/ẩn nút hành động theo trạng thái
        const nutBatDau   = document.getElementById('nut-bat-dau-xu-ly');
        const nutHoanThanh = document.getElementById('nut-hoan-thanh');
        const nutNhapGC   = document.getElementById('nhom-nhap-ghi-chu');

        nutBatDau.style.display    = 'none';
        nutHoanThanh.style.display = 'none';
        nutNhapGC.style.display    = 'none';

        if (don.trangThai === 'Chờ xử lý') {
        nutBatDau.style.display  = '';
        nutNhapGC.style.display  = '';
        } else if (don.trangThai === 'Đang xử lý') {
        nutHoanThanh.style.display = '';
        nutNhapGC.style.display    = '';
        }

        document.getElementById('input-ghi-chu-xu-ly').value = '';
        document.getElementById('modal-chi-tiet').classList.add('hien');
        }

        // ====== BẮT ĐẦU XỬ LÝ ======
        // [LỖI 3 ĐÃ SỬA] Gọi backend thực sự thay vì chỉ cập nhật UI
        async function batDauXuLy() {
        const ghiChu = document.getElementById('input-ghi-chu-xu-ly').value;
        try {
        const res = await fetch('?handler=BatDauXuLy', {
        method: 'POST',
        headers: {'Content-Type':'application/json','RequestVerificationToken':csrfToken},
        body: JSON.stringify({ idDon: idDangXuLy, ghiChu })
        });
        const data = await res.json().catch(()=>({}));
        if (!res.ok) { hienToast(data.message||'Lỗi xử lý.','loi'); return; }
        } catch(e) { hienToast('Mất kết nối máy chủ.','loi'); return; }
        hienToast('Đã bắt đầu xử lý sự cố #'+idDangXuLy,'thanh-cong');
        dongModal('modal-chi-tiet');
        capNhatCardTrangThai(idDangXuLy,'Đang xử lý');
        }

        // ====== HOÀN THÀNH XỬ LÝ ======
        // [LỖI 3 ĐÃ SỬA] Gọi backend thực sự thay vì chỉ cập nhật UI
        async function hoanThanhXuLy() {
        const ghiChu = document.getElementById('input-ghi-chu-xu-ly').value;
        try {
        const res = await fetch('?handler=HoanThanh', {
        method: 'POST',
        headers: {'Content-Type':'application/json','RequestVerificationToken':csrfToken},
        body: JSON.stringify({ idDon: idDangXuLy, ghiChu })
        });
        const data = await res.json().catch(()=>({}));
        if (!res.ok) { hienToast(data.message||'Lỗi hoàn thành.','loi'); return; }
        } catch(e) { hienToast('Mất kết nối máy chủ.','loi'); return; }
        hienToast('Sự cố #'+idDangXuLy+' đã xử lý thành công!','thanh-cong');
        dongModal('modal-chi-tiet');
        capNhatCardTrangThai(idDangXuLy,'Thành công');
        }

        // Cập nhật badge trạng thái trên card ngay sau action (UI optimistic)
        function capNhatCardTrangThai(id, trangThaiMoi) {
        const badgeTT = {
        'Đang xử lý': 'dang-xu-ly',
        'Thành công':  'thanh-cong'
        };
        document.querySelectorAll('.card-su-co').forEach(card => {
        const nut = card.querySelector(`[onclick*="moModalChiTiet(${id})"]`);
        if (nut) {
        const badges = card.querySelectorAll('.badge');
        badges.forEach(b => {
        if (['cho-xu-ly','dang-xu-ly','thanh-cong','da-huy'].some(c => b.classList.contains(c))) {
        b.className = 'badge ' + (badgeTT[trangThaiMoi] || 'cho-xu-ly');
        b.textContent = trangThaiMoi;
        }
        });
        }
        });
        }

        // ====== HÀM TIỆN ÍCH ======
        function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
        function dongModalNeuNhanNgoai(event, id) { if (event.target.id === id) dongModal(id); }
        function hienToast(noiDung, loai = '') {
        const toast = document.getElementById('toast-thong-bao');
        document.getElementById('toast-noi-dung').textContent = noiDung;
        toast.className = 'hien ' + loai;
        setTimeout(() => { toast.className = loai; }, 3000);
        }
        function dongMoSidebar() {
        const sb = document.getElementById('thanh-sidebar');
        sb.classList.toggle('an-sidebar');
        sb.classList.toggle('mo');
        }
        function chuyenTrang(ten, el) {
        document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
        el.classList.add('dang-chon');
        const map = {
        'trang-chu':          '/Manager/Manager',
        'quan-ly-phong':      '/Manager/ChiTietPhong',
        'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
        'hoa-don':            '/Manager/HoaDon',
        'su-co-bao-tri':      '/Manager/SuCoBaoTri',
        'bao-cao':            '/Manager/ThongKe',
        'cai-dat':            '/Manager/CaiDat',
        };
        if (map[ten]) window.location.href = map[ten];
        }

        // ===== ĐỒNG BỘ BADGE SIDEBAR =====
        (async function loadBadgeSidebar() {
        try {
        const res = await fetch('/Api/BadgeCounts');
        if (!res.ok) return;
        const data = await res.json();
        const badgeDV = document.getElementById('badge-dichvu');
        const badgeSC = document.getElementById('badge-suco');
        if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
        if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
        } catch (e) { console.warn('Không thể load badge sidebar:', e); }
        })();
    </script>
</body>
</html>
