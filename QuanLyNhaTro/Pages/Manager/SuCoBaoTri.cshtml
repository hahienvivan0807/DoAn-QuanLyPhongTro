@page "/Manager/SuCoBaoTri"
@model QuanLyNhaTro.Pages.Manager.SuCoBaoTriModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sự Cố & Bảo Trì</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="~/js/QuanLy/QuanLy-core.js"></script>
    <link rel="stylesheet" href="~/css/Manager/SuCoBaoTri.css" />
</head>
<body>

    <!-- ====================== SIDEBAR ====================== -->
    <nav id="thanh-sidebar">
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('phong-cua-toi', this)">
            <i class="fas fa-door-open"></i>
            <span>Phòng của tôi</span>
        </div>

        <div class="nhan-nhom">Quản lý</div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i><span>Dịch vụ & Tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn & Thu tiền</span>
        </div>

        <div class="nhan-nhom">Hỗ trợ</div>
        <div class="menu-item dang-chon" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="admin-sidebar">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
                {
                    <img src="@Model.CurrentUser.Avatar" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="Avatar" />
                }
                else
                {
                    @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
                <span>@(Model.CurrentUser?.Roles ?? "Quản trị viên")</span>
            </div>
        </div>
    </nav>

    <!-- ====================== KHU VỰC CHÍNH ====================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Quản Lý Sự Cố & Bảo Trì</div>
                    <div class="duong-dan">Trang chủ / Hỗ trợ / Sự cố & Bảo trì</div>
                </div>
            </div>
            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" id="input-tim-kiem"
                           placeholder="Tìm tên sự cố, phòng, người gửi..."
                           oninput="timKiem(this.value)" />
                </div>
                <button class="nut-thong-bao">
                    <i class="fas fa-bell"></i>
                    <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                </button>
                <div class="thong-tin-admin">
                    <div class="anh-dai-dien">
                        @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div>
                        <div class="ten">@(Model.CurrentUser?.FullName ?? "Admin")</div>
                        <div class="chuc-vu">@(Model.CurrentUser?.Roles ?? "Quản trị viên")</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG TRANG -->
        <div id="noi-dung-trang">

            <!-- Tiêu đề -->
            <div class="hang-chao-mung">
                <div>
                    <h2><i class="fas fa-tools" style="color:var(--mau-chu-de);margin-right:10px;"></i>Quản Lý Sự Cố & Bảo Trì</h2>
                    <p id="ngay-gio-hien-tai">Đang tải...</p>
                </div>
            </div>

            <!-- ====== THỐNG KÊ ====== -->
            <div class="luoi-thong-ke">
                <div class="card-thong-ke xanh">
                    <div class="bieu-tuong-thongke xanh">
                        <i class="fas fa-clipboard-list"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu xanh">@Model.TongSuCo</div>
                        <div class="nhan-thongke">Tổng sự cố</div>
                    </div>
                </div>
                <div class="card-thong-ke cam">
                    <div class="bieu-tuong-thongke cam">
                        <i class="fas fa-spinner"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu cam">@Model.DangXuLy</div>
                        <div class="nhan-thongke">Đang xử lý</div>
                    </div>
                </div>
                <div class="card-thong-ke xanh-la">
                    <div class="bieu-tuong-thongke xanh-la">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu xanh-la">@Model.DaXuLy</div>
                        <div class="nhan-thongke">Đã xử lý</div>
                    </div>
                </div>
                <div class="card-thong-ke do">
                    <div class="bieu-tuong-thongke do">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="noi-dung-thongke">
                        <div class="so-lieu do">@Model.KhanCap</div>
                        <div class="nhan-thongke">Khẩn cấp</div>
                    </div>
                </div>
            </div>

            <!-- ====== FILTER + TÌM KIẾM ====== -->
            <div class="thanh-cong-cu">
                <div class="nhom-filter">
                    <button class="nut-filter dang-loc" id="filter-tat-ca" onclick="loc('tat-ca', this)">
                        <i class="fas fa-th-list"></i> Tất cả
                    </button>
                    <button class="nut-filter loc-thap" id="filter-thap" onclick="loc('Thấp', this)">
                        <i class="fas fa-circle" style="color:#10b981;font-size:8px;"></i> Thấp
                    </button>
                    <button class="nut-filter loc-trung" id="filter-trung" onclick="loc('Trung bình', this)">
                        <i class="fas fa-circle" style="color:#f59e0b;font-size:8px;"></i> Trung bình
                    </button>
                    <button class="nut-filter loc-khan" id="filter-khan" onclick="loc('Khẩn cấp', this)">
                        <i class="fas fa-circle" style="color:#ef4444;font-size:8px;"></i> Khẩn cấp
                    </button>
                </div>
                <div class="so-ket-qua" id="so-ket-qua">
                    Hiển thị <strong>@Model.DanhSachSuCo.Count()</strong> sự cố
                </div>
            </div>

            <!-- ====== LƯỚI CARD SỰ CỐ ====== -->
            <div id="luoi-su-co">
                @foreach (var don in Model.DanhSachSuCo)
                {
                    // Xác định CSS class theo mức độ
                    string mucDoClass = don.MucDo switch
                    {
                        "Thấp" => "muc-thap",
                        "Trung bình" => "muc-trung",
                        "Khẩn cấp" => "muc-khan",
                        _ => "muc-trung"
                    };
                    string badgeMucDo = don.MucDo switch
                    {
                        "Thấp" => "thap",
                        "Trung bình" => "trung-binh",
                        "Khẩn cấp" => "khan-cap",
                        _ => "trung-binh"
                    };
                    string badgeTrangThai = don.TrangThai_DV switch
                    {
                        "Chờ xử lý" => "cho-xu-ly",
                        "Đang xử lý" => "dang-xu-ly",
                        "Chờ thanh toán" => "cho-thanh-toan",
                        "Thành công" => "thanh-cong",
                        "Đã hủy" => "da-huy",
                        _ => "cho-xu-ly"
                    };
                    // Null-safe
                    string tenNguoiGui = don.Tenant?.FullName ?? "—";
                    string soPhong = don.Phong?.SoPhong ?? "—";
                    string ngayTaoStr = don.NgayTao.ToString("dd/MM/yyyy HH:mm");
                    string noiDungHienThi = don.NoiDung ?? "(Không có mô tả)";

                    <div class="card-su-co @mucDoClass"
                         data-muc-do="@don.MucDo"
                         data-ten="@(don.NoiDung ?? "")"
                         data-phong="@soPhong"
                         data-nguoi="@tenNguoiGui">

                        <!-- HEADER CARD -->
                        <div class="card-su-co-header">
                            <div class="tieu-de-nhom">
                                <div class="bieu-tuong-loai hu-hong">
                                    <i class="fas fa-wrench"></i>
                                </div>
                                <div style="min-width:0;">
                                    <div class="ten-su-co" title="@noiDungHienThi">
                                        @(noiDungHienThi.Length > 40 ? noiDungHienThi.Substring(0, 40) + "..." : noiDungHienThi)
                                    </div>
                                    <div class="ma-don">#@don.IDDonDV</div>
                                </div>
                            </div>
                            <div class="nhom-badge">
                                <span class="badge @badgeMucDo">@don.MucDo</span>
                                <span class="badge @badgeTrangThai">@don.TrangThai_DV</span>
                            </div>
                        </div>

                        <!-- BODY CARD -->
                        <div class="card-su-co-body">
                            <div class="mo-ta-ngan">@noiDungHienThi</div>
                            <div class="thong-tin-nho">
                                <div class="hang-thong-tin">
                                    <i class="fas fa-door-open"></i>
                                    <div>
                                        <span class="nhan-hang">Phòng</span>
                                        <span>@soPhong</span>
                                    </div>
                                </div>
                                <div class="hang-thong-tin">
                                    <i class="fas fa-user"></i>
                                    <div>
                                        <span class="nhan-hang">Người gửi</span>
                                        <span>@tenNguoiGui</span>
                                    </div>
                                </div>
                                @if (don.ManagerXuLy != null)
                                {
                                    <div class="hang-thong-tin">
                                        <i class="fas fa-user-cog"></i>
                                        <div>
                                            <span class="nhan-hang">Người xử lý</span>
                                            <span>@don.ManagerXuLy.FullName</span>
                                        </div>
                                    </div>
                                }
                                @if (don.NgayXuLy.HasValue)
                                {
                                    <div class="hang-thong-tin">
                                        <i class="fas fa-calendar-check"></i>
                                        <div>
                                            <span class="nhan-hang">Ngày xử lý</span>
                                            <span>@don.NgayXuLy.Value.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- FOOTER CARD -->
                        <div class="card-su-co-footer">
                            <div class="thoi-gian-tao">
                                <i class="fas fa-clock"></i>
                                @ngayTaoStr
                            </div>
                            <button class="nut-xem-chitiet"
                                    onclick="moModalChiTiet(@don.IDDonDV)">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Trạng thái rỗng khi filter không có kết quả -->
            <div id="trang-thai-rong">
                <i class="fas fa-search"></i>
                <span>Không tìm thấy sự cố nào phù hợp</span>
            </div>

        </div><!-- Kết thúc noi-dung-trang -->
    </div><!-- Kết thúc khu-vuc-chinh -->
    <!-- ====================== MODAL CHI TIẾT ====================== -->
    <div class="lop-che-modal" id="modal-chi-tiet" onclick="dongModalNeuNhanNgoai(event, 'modal-chi-tiet')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3><i class="fas fa-tools"></i> Chi tiết sự cố / bảo trì</h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Banner mức độ -->
            <div id="modal-banner-muc-do" class="banner-muc-do"></div>

            <!-- Thông tin chi tiết từ DONDV model -->
            <div class="luoi-chi-tiet">
                <div class="o-chi-tiet">
                    <div class="nhan">Mã đơn</div>
                    <div class="gia-tri noi-bat" id="modal-ma-don">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Trạng thái</div>
                    <div id="modal-trang-thai">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Phòng</div>
                    <div class="gia-tri" id="modal-phong">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Người gửi</div>
                    <div class="gia-tri" id="modal-nguoi-gui">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Mức độ khẩn cấp</div>
                    <div id="modal-muc-do">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày tạo</div>
                    <div class="gia-tri" id="modal-ngay-tao">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Người xử lý</div>
                    <div class="gia-tri" id="modal-nguoi-xu-ly">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày xử lý</div>
                    <div class="gia-tri" id="modal-ngay-xu-ly">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Ngày hoàn thành</div>
                    <div class="gia-tri" id="modal-ngay-hoan-thanh">—</div>
                </div>
                <div class="o-chi-tiet">
                    <div class="nhan">Tổng chi phí</div>
                    <div class="gia-tri" id="modal-tong-tien" style="color:#059669;">—</div>
                </div>
                <div class="o-chi-tiet full">
                    <div class="nhan">Mô tả đầy đủ</div>
                    <div class="gia-tri" id="modal-noi-dung" style="font-weight:400;line-height:1.6;">—</div>
                </div>
                <div class="o-chi-tiet full" id="nhom-ghi-chu-xu-ly" style="display:none;">
                    <div class="nhan">Ghi chú xử lý</div>
                    <div class="gia-tri" id="modal-ghi-chu-xu-ly" style="font-weight:400;"></div>
                </div>
                <div class="o-chi-tiet full" id="nhom-ly-do-huy" style="display:none;">
                    <div class="nhan">Lý do hủy</div>
                    <div class="gia-tri" id="modal-ly-do-huy" style="color:#dc2626;font-weight:400;"></div>
                </div>
            </div>

            <!-- Ảnh biên lai (AnhBienLai) -->
            <div id="nhom-anh-bien-lai" style="display:none;">
                <p class="nhan-anh"><i class="fas fa-receipt"></i> Ảnh biên lai / chứng từ</p>
                <div class="khung-anh">
                    <img id="modal-anh-bien-lai" src="" alt="Ảnh biên lai" />
                </div>
            </div>

            <!-- Ảnh kết quả (AnhKetQua) -->
            <div id="nhom-anh-ket-qua" style="display:none;">
                <p class="nhan-anh"><i class="fas fa-image"></i> Ảnh kết quả xử lý</p>
                <div class="khung-anh">
                    <img id="modal-anh-ket-qua" src="" alt="Ảnh kết quả" />
                </div>
            </div>

            <!-- Không có ảnh nào -->
            <div id="khung-anh-placeholder" class="khung-anh" style="display:none;">
                <div class="anh-placeholder">
                    <i class="fas fa-image"></i>
                    <span>Chưa có ảnh đính kèm</span>
                </div>
            </div>

            <!-- Ghi chú xử lý (input để manager nhập) -->
            <div class="nhom-truong-nhap" id="nhom-nhap-ghi-chu" style="display:none;">
                <label class="nhan-truong-nhap">Ghi chú xử lý</label>
                <input type="text" class="truong-nhap" id="input-ghi-chu-xu-ly"
                       placeholder="Nhập ghi chú khi xử lý / hoàn thành..." />
            </div>

            <!-- Nhóm nút -->
            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-chi-tiet')">
                    <i class="fas fa-times"></i> Đóng
                </button>
                <button class="nut-xu-ly" id="nut-bat-dau-xu-ly" onclick="batDauXuLy()" style="display:none;">
                    <i class="fas fa-play"></i> Bắt đầu xử lý
                </button>
                <button class="nut-hoan-thanh" id="nut-hoan-thanh" onclick="hoanThanhXuLy()" style="display:none;">
                    <i class="fas fa-check-double"></i> Hoàn thành
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast-thong-bao">
        <i class="fas fa-check-circle"></i>
        <span id="toast-noi-dung">Thao tác thành công!</span>
    </div>

    <!-- ====================== DỮ LIỆU RAZOR → JS ====================== -->
    <!--
        Inject danh sách từ Model vào JS để modal hoạt động phía client
        mà không cần gọi thêm API.
        Controller cần Include: .Include(d => d.Tenant).Include(d => d.Phong).Include(d => d.ManagerXuLy)
    -->
    @Html.AntiForgeryToken()
    <script>
        // [LỖI 3 ĐÃ SỬA] Lấy CSRF token để gửi kèm các POST request
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // Dữ liệu được inject từ Razor Model
        // Dùng Html.Raw + Json.Serialize để tránh HTML-encode ký tự tiếng Việt
        const danhSachSuCo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.DanhSachSuCo.Select(don => new
                            {
                                id = don.IDDonDV,
                                noiDung = don.NoiDung ?? "",
                                phong = don.Phong?.SoPhong ?? "",
                                nguoiGui = don.Tenant?.FullName ?? "",
                                nguoiXuLy = don.ManagerXuLy?.FullName ?? "",
                                mucDo = don.MucDo,
                                trangThai = don.TrangThai_DV,
                                ngayTao = don.NgayTao.ToString("dd/MM/yyyy HH:mm"),
                                ngayXuLy = don.NgayXuLy.HasValue ? don.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "",
                                ngayHoanThanh = don.NgayHoanThanh.HasValue ? don.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm") : "",
                                tongTien = don.TongTien > 0 ? don.TongTien.ToString("N0") + " ₫" : "—",
                                ghiChuXuLy = don.GhiChuXuLy ?? "",
                                lyDoHuy = don.LyDoHuy ?? "",
                                anhBienLai = don.AnhBienLai ?? "",
                                anhKetQua = don.AnhKetQua ?? ""
                            })
                        ));

        // ====== NGÀY GIỜ HIỆN TẠI ======
        (function() {
        const ngay = new Date();
        const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
        document.getElementById('ngay-gio-hien-tai').textContent =
        `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
        })();

        // ====== BIẾN TRẠNG THÁI ======
        let idDangXuLy = null;
        let mucLocHienTai = 'tat-ca';
        let tuKhoaHienTai = '';

        // ====== LỌC THEO MỨC ĐỘ ======
        function loc(mucDo, phanTu) {
        // Xóa active tất cả nút filter
        document.querySelectorAll('.nut-filter').forEach(b => b.classList.remove('dang-loc'));
        phanTu.classList.add('dang-loc');
        mucLocHienTai = mucDo;
        apDungLoc();
        }

        // ====== TÌM KIẾM ======
        function timKiem(tuKhoa) {
        tuKhoaHienTai = tuKhoa.toLowerCase().trim();
        apDungLoc();
        }

        // ====== ÁP DỤNG LỌC + TÌM KIẾM ======
        function apDungLoc() {
        const cards = document.querySelectorAll('.card-su-co');
        let soHienThi = 0;

        cards.forEach(card => {
        const mucDo   = card.dataset.mucDo  || '';
        const ten     = card.dataset.ten    || '';
        const phong   = card.dataset.phong  || '';
        const nguoi   = card.dataset.nguoi  || '';

        const hopMucDo = mucLocHienTai === 'tat-ca' || mucDo === mucLocHienTai;
        const hopTuKhoa = !tuKhoaHienTai ||
        ten.toLowerCase().includes(tuKhoaHienTai) ||
        phong.toLowerCase().includes(tuKhoaHienTai) ||
        nguoi.toLowerCase().includes(tuKhoaHienTai);

        const hienThi = hopMucDo && hopTuKhoa;
        card.style.display = hienThi ? '' : 'none';
        if (hienThi) soHienThi++;
        });

        // Cập nhật số kết quả
        document.getElementById('so-ket-qua').innerHTML =
        `Hiển thị <strong>${soHienThi}</strong> sự cố`;

        // Hiện trạng thái rỗng nếu không có kết quả
        document.getElementById('trang-thai-rong').style.display =
        soHienThi === 0 ? 'block' : 'none';
        }

        // ====== MỞ MODAL CHI TIẾT ======
        function moModalChiTiet(id) {
        const don = danhSachSuCo.find(d => d.id === id);
        if (!don) return;

        idDangXuLy = id;

        // Điền thông tin
        document.getElementById('modal-ma-don').textContent    = '#' + don.id;
        document.getElementById('modal-phong').textContent     = don.phong || '—';
        document.getElementById('modal-nguoi-gui').textContent  = don.nguoiGui || '—';
        document.getElementById('modal-noi-dung').textContent   = don.noiDung || '(Không có mô tả)';
        document.getElementById('modal-ngay-tao').textContent   = don.ngayTao || '—';
        document.getElementById('modal-nguoi-xu-ly').textContent = don.nguoiXuLy || '—';
        document.getElementById('modal-ngay-xu-ly').textContent  = don.ngayXuLy || '—';
        document.getElementById('modal-ngay-hoan-thanh').textContent = don.ngayHoanThanh || '—';
        document.getElementById('modal-tong-tien').textContent  = don.tongTien || '—';

        // Badge mức độ
        const badgeMucDo = {
        'Thấp':     '<span class="badge thap">Thấp</span>',
        'Trung bình': '<span class="badge trung-binh">Trung bình</span>',
        'Khẩn cấp': '<span class="badge khan-cap">Khẩn cấp</span>'
        };
        document.getElementById('modal-muc-do').innerHTML = badgeMucDo[don.mucDo] || don.mucDo;

        // Badge trạng thái
        const badgeTT = {
        'Chờ xử lý':    '<span class="badge cho-xu-ly">Chờ xử lý</span>',
        'Đang xử lý':   '<span class="badge dang-xu-ly">Đang xử lý</span>',
        'Chờ thanh toán': '<span class="badge cho-thanh-toan">Chờ thanh toán</span>',
        'Thành công':   '<span class="badge thanh-cong">Thành công</span>',
        'Đã hủy':       '<span class="badge da-huy">Đã hủy</span>'
        };
        document.getElementById('modal-trang-thai').innerHTML = badgeTT[don.trangThai] || don.trangThai;

        // Banner mức độ
        const bannerEl = document.getElementById('modal-banner-muc-do');
        const bannerMap = {
        'Thấp':      { cls: 'thap',  icon: 'fa-info-circle',           text: 'Mức độ thấp — Xử lý trong thời gian bình thường' },
        'Trung bình':{ cls: 'trung', icon: 'fa-exclamation-circle',     text: 'Mức độ trung bình — Cần xử lý sớm' },
        'Khẩn cấp':  { cls: 'khan', icon: 'fa-exclamation-triangle',    text: 'KHẨN CẤP — Cần xử lý ngay lập tức!' }
        };
        const b = bannerMap[don.mucDo] || bannerMap['Trung bình'];
        bannerEl.className = `banner-muc-do ${b.cls}`;
        bannerEl.innerHTML = `<i class="fas ${b.icon}"></i> ${b.text}`;

        // Ghi chú xử lý
        if (don.ghiChuXuLy) {
        document.getElementById('nhom-ghi-chu-xu-ly').style.display = '';
        document.getElementById('modal-ghi-chu-xu-ly').textContent = don.ghiChuXuLy;
        } else {
        document.getElementById('nhom-ghi-chu-xu-ly').style.display = 'none';
        }

        // Lý do hủy
        if (don.lyDoHuy) {
        document.getElementById('nhom-ly-do-huy').style.display = '';
        document.getElementById('modal-ly-do-huy').textContent = don.lyDoHuy;
        } else {
        document.getElementById('nhom-ly-do-huy').style.display = 'none';
        }

        // Ảnh biên lai
        const coAnhBL = !!don.anhBienLai;
        document.getElementById('nhom-anh-bien-lai').style.display = coAnhBL ? '' : 'none';
        if (coAnhBL) document.getElementById('modal-anh-bien-lai').src = don.anhBienLai;

        // Ảnh kết quả
        const coAnhKQ = !!don.anhKetQua;
        document.getElementById('nhom-anh-ket-qua').style.display = coAnhKQ ? '' : 'none';
        if (coAnhKQ) document.getElementById('modal-anh-ket-qua').src = don.anhKetQua;

        // Placeholder nếu không có ảnh nào
        document.getElementById('khung-anh-placeholder').style.display =
        (!coAnhBL && !coAnhKQ) ? '' : 'none';

        // Hiện/ẩn nút hành động theo trạng thái
        const nutBatDau   = document.getElementById('nut-bat-dau-xu-ly');
        const nutHoanThanh = document.getElementById('nut-hoan-thanh');
        const nutNhapGC   = document.getElementById('nhom-nhap-ghi-chu');

        nutBatDau.style.display    = 'none';
        nutHoanThanh.style.display = 'none';
        nutNhapGC.style.display    = 'none';

        if (don.trangThai === 'Chờ xử lý') {
        nutBatDau.style.display  = '';
        nutNhapGC.style.display  = '';
        } else if (don.trangThai === 'Đang xử lý') {
        nutHoanThanh.style.display = '';
        nutNhapGC.style.display    = '';
        }

        document.getElementById('input-ghi-chu-xu-ly').value = '';
        document.getElementById('modal-chi-tiet').classList.add('hien');
        }

        // ====== BẮT ĐẦU XỬ LÝ ======
        // [LỖI 3 ĐÃ SỬA] Gọi backend thực sự thay vì chỉ cập nhật UI
        async function batDauXuLy() {
        const ghiChu = document.getElementById('input-ghi-chu-xu-ly').value;
        try {
        const res = await fetch('?handler=BatDauXuLy', {
        method: 'POST',
        headers: {'Content-Type':'application/json','RequestVerificationToken':csrfToken},
        body: JSON.stringify({ idDon: idDangXuLy, ghiChu })
        });
        const data = await res.json().catch(()=>({}));
        if (!res.ok) { hienToast(data.message||'Lỗi xử lý.','loi'); return; }
        } catch(e) { hienToast('Mất kết nối máy chủ.','loi'); return; }
        hienToast('Đã bắt đầu xử lý sự cố #'+idDangXuLy,'thanh-cong');
        dongModal('modal-chi-tiet');
        capNhatCardTrangThai(idDangXuLy,'Đang xử lý');
        }

        // ====== HOÀN THÀNH XỬ LÝ ======
        // [LỖI 3 ĐÃ SỬA] Gọi backend thực sự thay vì chỉ cập nhật UI
        async function hoanThanhXuLy() {
        const ghiChu = document.getElementById('input-ghi-chu-xu-ly').value;
        try {
        const res = await fetch('?handler=HoanThanh', {
        method: 'POST',
        headers: {'Content-Type':'application/json','RequestVerificationToken':csrfToken},
        body: JSON.stringify({ idDon: idDangXuLy, ghiChu })
        });
        const data = await res.json().catch(()=>({}));
        if (!res.ok) { hienToast(data.message||'Lỗi hoàn thành.','loi'); return; }
        } catch(e) { hienToast('Mất kết nối máy chủ.','loi'); return; }
        hienToast('Sự cố #'+idDangXuLy+' đã xử lý thành công!','thanh-cong');
        dongModal('modal-chi-tiet');
        capNhatCardTrangThai(idDangXuLy,'Thành công');
        }

        // Cập nhật badge trạng thái trên card ngay sau action (UI optimistic)
        function capNhatCardTrangThai(id, trangThaiMoi) {
        const badgeTT = {
        'Đang xử lý': 'dang-xu-ly',
        'Thành công':  'thanh-cong'
        };
        document.querySelectorAll('.card-su-co').forEach(card => {
        const nut = card.querySelector(`[onclick*="moModalChiTiet(${id})"]`);
        if (nut) {
        const badges = card.querySelectorAll('.badge');
        badges.forEach(b => {
        if (['cho-xu-ly','dang-xu-ly','thanh-cong','da-huy'].some(c => b.classList.contains(c))) {
        b.className = 'badge ' + (badgeTT[trangThaiMoi] || 'cho-xu-ly');
        b.textContent = trangThaiMoi;
        }
        });
        }
        });
        }

        // ====== HÀM TIỆN ÍCH ======
        function dongModal(id) { document.getElementById(id).classList.remove('hien'); }
        function dongModalNeuNhanNgoai(event, id) { if (event.target.id === id) dongModal(id); }
        function hienToast(noiDung, loai = '') {
        const toast = document.getElementById('toast-thong-bao');
        document.getElementById('toast-noi-dung').textContent = noiDung;
        toast.className = 'hien ' + loai;
        setTimeout(() => { toast.className = loai; }, 3000);
        }
        function dongMoSidebar() {
        const sb = document.getElementById('thanh-sidebar');
        sb.classList.toggle('an-sidebar');
        sb.classList.toggle('mo');
        }
        function chuyenTrang(ten, el) {
        document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
        el.classList.add('dang-chon');
        const map = {
        'trang-chu':          '/Manager/Manager',
        'quan-ly-phong':      '/Manager/ChiTietPhong',
        'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
        'hoa-don':            '/Manager/HoaDon',
        'su-co-bao-tri':      '/Manager/SuCoBaoTri',
        'bao-cao':            '/Manager/ThongKe',
        'cai-dat':            '/Manager/CaiDat',
        'phong-cua-toi':  '/KhachThue/KhachThue',
        };
        if (map[ten]) window.location.href = map[ten];
        }

        // ===== ĐỒNG BỘ BADGE SIDEBAR =====
        (async function loadBadgeSidebar() {
        try {
        const res = await fetch('/Api/BadgeCounts');
        if (!res.ok) return;
        const data = await res.json();
        const badgeDV = document.getElementById('badge-dichvu');
        const badgeSC = document.getElementById('badge-suco');
        if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
        if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
        } catch (e) { console.warn('Không thể load badge sidebar:', e); }
        })();
    </script>
</body>
</html>
