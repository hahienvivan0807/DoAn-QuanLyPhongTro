            </div>
            <div class="hang-form">
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Số phòng *</label>
                    <!-- ⚠️ CẦN CAN THIỆP: Validate số phòng không trùng -->
                    <input class="truong-nhap" type="text" id="so-phong" placeholder="VD: 101, 202..." />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Loại phòng *</label>
                    <select class="truong-nhap chon-lua" id="loai-phong">
                        <option value="">-- Chọn loại --</option>
                        <option>Phòng đơn</option>
                        <option>Phòng đôi</option>
                        <option>Phòng cao cấp</option>
                    </select>
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Diện tích (m²)</label>
                    <input class="truong-nhap" type="number" id="dien-tich" placeholder="VD: 15" />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Giá thuê (đồng/tháng) *</label>
                    <!-- ⚙️ BACKEND: Giá sẽ lưu vào bảng phong trong DB -->
                    <input class="truong-nhap" type="number" id="gia-thue" placeholder="VD: 3500000" />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Tầng</label>
                    <select class="truong-nhap chon-lua" id="tang">
                        <option>Tầng 1</option>
                        <option>Tầng 2</option>
                        <option>Tầng 3</option>
                        <option>Tầng 4</option>
                    </select>
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Trạng thái</label>
                    <select class="truong-nhap chon-lua" id="trang-thai-phong-moi">
                        <option>Còn trống</option>
                        <option>Đang thuê</option>
                        <option>Bảo trì</option>
                    </select>
                </div>
            </div>
            <div class="nhom-truong-nhap" style="margin-top:14px;">
                <label class="nhan-truong-nhap">Ghi chú</label>
                <textarea class="truong-nhap" rows="2" id="ghi-chu-phong" placeholder="Tiện nghi, lưu ý đặc biệt..."></textarea>
            </div>
            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-them-phong')">Hủy</button>
                <!-- ⚙️ BACKEND: Gọi API POST /api/phong với dữ liệu form -->
                <button class="nut-luu" onclick="luuPhongMoi()"><i class="fas fa-save"></i> Lưu phòng</button>
            </div>
        </div>
    </div>


    <!-- =============================================
     MODAL: BÁO SỰ CỐ
     ⚙️ BACKEND: POST /api/su-co khi lưu
============================================= -->
    <div class="lop-che-modal" id="modal-bao-su-co" onclick="dongModalNeuNhanNgoai(event, 'modal-bao-su-co')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3><i class="fas fa-tools" style="color:#ef4444;margin-right:8px;"></i>Ghi nhận sự cố mới</h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-bao-su-co')">✕</button>
            </div>
            <div class="hang-form">
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Phòng *</label>
                    <select class="truong-nhap chon-lua" id="phong-su-co">
                        <!-- ⚙️ BACKEND: Load danh sách phòng từ API GET /api/phong -->
                        <option>-- Chọn phòng --</option>
                        <option>Phòng 101</option>
                        <option>Phòng 201</option>
                        <option>Phòng 301</option>
                    </select>
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Mức độ *</label>
                    <select class="truong-nhap chon-lua" id="muc-do-su-co">
                        <option>Thấp</option>
                        <option>Trung bình</option>
                        <option>Khẩn cấp</option>
                    </select>
                </div>
            </div>
            <div class="nhom-truong-nhap" style="margin-top:14px;">
                <label class="nhan-truong-nhap">Mô tả sự cố *</label>
                <textarea class="truong-nhap" rows="3" id="mo-ta-su-co" placeholder="Mô tả chi tiết sự cố..."></textarea>
            </div>
            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-bao-su-co')">Hủy</button>
                <button class="nut-luu" style="background:linear-gradient(135deg,#ef4444,#f97316);" onclick="luuSuCo()">
                    <i class="fas fa-save"></i> Ghi nhận
                </button>
            </div>
        </div>
    </div>


    <!-- =============================================
     JAVASCRIPT - XỬ LÝ TƯƠNG TÁC
============================================= -->
    <script>
            // ===== CẬP NHẬT NGÀY GIỜ =====
            function capNhatNgayGio() {
              const ngay = new Date();
              const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
              document.getElementById('ngay-gio-hien-tai').textContent =
                `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
            }
            capNhatNgayGio();

            // ===== BIỂU ĐỒ DOANH THU Chart.js =====
            // ⚙️ BACKEND: Thay mảng duLieuDoanhThu bằng dữ liệu thật từ API GET /api/doanh-thu?nam=2025
            const duLieuDoanhThu = [42, 38, 51, 47, 55, 58.5, 0, 0, 0, 0, 0, 0]; // đơn vị triệu đồng
            const ctx = document.getElementById('bieu-do-doanh-thu').getContext('2d');

            // Tạo gradient nền cho biểu đồ
            const grd = ctx.createLinearGradient(0, 0, 0, 200);
            grd.addColorStop(0, 'rgba(26,86,219,0.25)');
            grd.addColorStop(1, 'rgba(26,86,219,0.0)');

            new Chart(ctx, {
              type: 'line',
              data: {
                labels: ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'],
                datasets: [{
                  label: 'Doanh thu (triệu đồng)',
                  data: duLieuDoanhThu,
                  borderColor: '#1a56db',
                  backgroundColor: grd,
                  borderWidth: 2.5,
                  pointBackgroundColor: '#fff',
                  pointBorderColor: '#1a56db',
                  pointBorderWidth: 2,
                  pointRadius: 5,
                  pointHoverRadius: 7,
                  fill: true,
                  tension: 0.4,
                }]
              },
              options: {
                responsive: true, maintainAspectRatio: true,
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    backgroundColor: '#1e293b',
                    titleColor: '#94a3b8', bodyColor: '#fff',
                    padding: 10, borderRadius: 8,
                    callbacks: { label: ctx => ` ${ctx.raw} triệu đồng` }
                  }
                },
                scales: {
                  x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                  y: {
                    grid: { color: '#f1f5f9' },
                    ticks: { font: { size: 11 }, callback: val => val + 'M' },
                    beginAtZero: true
                  }
                }
              }
            });

            // ===== CÁC HÀM ĐIỀU HƯỚNG & TƯƠNG TÁC =====

            // Chuyển trang khi click menu sidebar
            function chuyenTrang(tenTrang, phanTu) {
              document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
              phanTu.classList.add('dang-chon');
              // Bản đồ tên trang → đường dẫn Razor Page
              const bangDieuHuong = {
                'trang-chu':           '/Manager',
                'quan-ly-phong':       '/Manager/ChiTietPhong',
                'quan-ly-nguoi-thue':  '/QuanLyNguoiThue',
                'hoa-don':             '/HoaDon',
                'su-co-bao-tri':       '/SuCoBaoTri',
                'bao-cao':             '/BaoCao',
                'cai-dat':             '/CaiDat',
              };
              const duongDan = bangDieuHuong[tenTrang];
              if (duongDan) {
                window.location.href = duongDan;
              } else {
                console.log('Chưa có trang:', tenTrang);
              }
            }

            // Đóng/mở sidebar trên mobile
            function dongMoSidebar() {
                document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            // Mở modal thêm phòng
            function moModalThemPhong() {
              document.getElementById('modal-them-phong').classList.add('hien');
            }

            // Mở modal báo sự cố
            function moModalBaoSuCo() {
              document.getElementById('modal-bao-su-co').classList.add('hien');
            }

            // Đóng modal theo id
            function dongModal(idModal) {
              document.getElementById(idModal).classList.remove('hien');
            }

            // Đóng modal khi nhấn vùng tối bên ngoài
            function dongModalNeuNhanNgoai(event, idModal) {
              if (event.target.id === idModal) dongModal(idModal);
            }

            // Lưu phòng mới – ⚙️ BACKEND: Gọi API POST /api/phong
            function luuPhongMoi() {
              const soPhong = document.getElementById('so-phong').value;
              const giaThue = document.getElementById('gia-thue').value;
              if (!soPhong || !giaThue) { alert('Vui lòng điền đầy đủ thông tin bắt buộc!'); return; }
              // ⚙️ BACKEND: fetch('/api/phong', { method:'POST', body: JSON.stringify({...}) })
              alert(`Đã lưu phòng ${soPhong} thành công! (Kết nối backend để lưu thật)`);
              dongModal('modal-them-phong');
            }

            // Lưu sự cố – ⚙️ BACKEND: Gọi API POST /api/su-co
            function luuSuCo() {
              const moTa = document.getElementById('mo-ta-su-co').value;
              if (!moTa) { alert('Vui lòng mô tả sự cố!'); return; }
              // ⚙️ BACKEND: fetch('/api/su-co', { method:'POST', body: JSON.stringify({...}) })
              alert('Đã ghi nhận sự cố! (Kết nối backend để lưu thật)');
              dongModal('modal-bao-su-co');
            }

            // Nhắc thanh toán – ⚙️ BACKEND: Gửi SMS/email qua API thông báo
            function nhacNhoThanhToan(soPhong) {
              alert(`Đã gửi nhắc nhở thanh toán tới người thuê phòng ${soPhong}! (Kết nối backend/SMS API)`);
            }

            // Các hàm xem chi tiết – điều hướng thật sang trang tương ứng
            function xemChiTietPhong() { window.location.href = 'Manager/ChiTietPhong'; }
            function xemPhongDangThue() { window.location.href = '/ChiTietPhong?trangThai=dang-thue'; }
            function xemPhongTrong() { window.location.href = '/ChiTietPhong?trangThai=trong'; }
            function xemDoanhThu() { window.location.href = '/BaoCao'; }
            function xemBaoCaoDoanhThu() { window.location.href = '/BaoCao'; }
            function xemTatCaSuCo() { window.location.href = '/SuCoBaoTri'; }
            function xemTatCaHoaDon() { window.location.href = '/HoaDon'; }
            function xemTatCaPhong() { window.location.href = '/ChiTietPhong'; }
            function xemChiTietPhongCuThe(soPhong) { window.location.href = '/ChiTietPhong?soPhong=' + soPhong; }
            function xemHoaDon(soPhong) { window.location.href = '/HoaDon?soPhong=' + soPhong; }
            function moThongBao() { alert('Mở danh sách thông báo (5 chưa đọc)'); }
            function moMenuAdmin() { alert('Menu tài khoản: Đổi mật khẩu / Đăng xuất'); }
            function moThongTinAdmin() { alert('Thông tin quản trị viên'); }
            function timKiem(tuKhoa) { console.log('Tìm kiếm:', tuKhoa); /* ⚙️ BACKEND: gọi API tìm kiếm */ }
            function thayDoiNam(nam) { console.log('Đổi năm biểu đồ:', nam); /* ⚙️ BACKEND: reload data biểu đồ */ }
    </script>
    </body>
</html>

