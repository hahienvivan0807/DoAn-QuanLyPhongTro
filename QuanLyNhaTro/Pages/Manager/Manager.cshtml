@page
@model QuanLyNhaTro.Pages.ManagerModel
@using System.Text.Json
@{
    Layout = null;
    // Serialize mảng doanh thu thành JSON để truyền vào Chart.js
    var doanhThuJson = JsonSerializer.Serialize(Model.DoanhThuTheoThang);
    // Chữ cái đầu tên người dùng để hiển thị avatar mặc định
    var initials = Model.TenNguoiDung?.Length > 0 ? Model.TenNguoiDung[0].ToString().ToUpper() : "A";
    // Tỉ lệ lấp đầy dạng chuỗi
    var tiLeLapDay = Model.ThongKeTong.TiLeLapDay.ToString("0.##");
    // Doanh thu tháng hiện tại dạng "XX.XM"
    var doanhThuThang = (Model.ThongKeTong.DoanhThuThangNay / 1_000_000m).ToString("0.#") + "M";
    // Tháng hiện tại
    var thangHienTai = DateTime.Now.Month;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Quản Lý Nhà Trọ</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="/js/QuanLy/QuanLy-core.js"></script>
    <!-- Font Awesome - để hiển thị icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="~/css/Manager/Manager.css" rel="stylesheet" />

</head>
<body>
    <!-- =============================================
     SIDEBAR - THANH ĐIỀU HƯỚNG
============================================= -->
    <nav id="thanh-sidebar">

        <!-- Logo + Tên hệ thống -->
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <!-- ===== NHÓM MENU CHÍNH ===== -->
        <div class="nhan-nhom">Tổng quan</div>

        <div class="menu-item dang-chon" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('phong-cua-toi', this)">
            <i class="fas fa-door-open"></i>
            <span>Phòng của tôi</span>
        </div>

        <!-- ===== NHÓM QUẢN LÝ ===== -->
        <div class="nhan-nhom">Quản lý</div>

        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i>
            <span>Quản lý phòng trọ</span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i>
            <span>Quản lý dịch vụ và tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Hóa đơn & Thu tiền</span>
        </div>

        <!-- ===== NHÓM HỖ TRỢ ===== -->
        <div class="nhan-nhom">Hỗ trợ</div>

        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('thong-ke', this)">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê & Báo cáo</span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </div>

        <!-- Thông tin admin dưới đáy sidebar -->
        <div class="admin-sidebar" onclick="moThongTinAdmin()">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    @initials
                }
            </div>
            <div class="ten-admin">
                <strong>@Model.TenNguoiDung</strong>
                <span>@Model.ChucVu</span>
            </div>
        </div>

    </nav><!-- Kết thúc SIDEBAR -->
    <!-- =============================================
     KHU VỰC CHÍNH
============================================= -->
    <div id="khu-vuc-chinh">

        <!-- ===== HEADER ===== -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Dashboard Quản Lý</div>
                    <div class="duong-dan">Trang chủ / Tổng quan</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="o-tim-kiem">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê..." oninput="timKiem(this.value)" />
                </div>

                <div class="tb-panel-wrap" id="tbPanelWrap">
                    <button class="nut-thong-bao" id="btnBell" onclick="tbToggle()">
                        <i class="fas fa-bell"></i>
                        @if (Model.SoThongBaoChuaDoc > 0)
                        {
                            <span class="so-thong-bao" id="bell-badge">@Model.SoThongBaoChuaDoc</span>
                        }
                        else
                        {
                            <span class="so-thong-bao" id="bell-badge" style="display:none">0</span>
                        }
                    </button>

                    <!-- Panel thông báo dropdown -->
                    <div class="tb-panel" id="tbPanel">
                        <div class="tb-panel-header">
                            <h4>
                                <i class="fas fa-bell" style="color:var(--mau-chu-de);"></i>
                                Thông báo
                                @if (Model.SoThongBaoChuaDoc > 0)
                                {
                                    <span>@Model.SoThongBaoChuaDoc</span>
                                }
                            </h4>
                            <button class="tb-doc-tat" onclick="tbDocTatCa()">Đánh dấu đã đọc</button>
                        </div>

                        <div class="tb-list" id="tbList">
                            @if (!Model.DanhSachThongBao.Any())
                            {
                                <div class="tb-trong">
                                    <i class="fas fa-bell-slash" style="font-size:28px;margin-bottom:8px;display:block;"></i>
                                    Không có thông báo nào
                                </div>
                            }
                            @foreach (var tb in Model.DanhSachThongBao)
                            {
                                var loaiIcon = tb.LoaiTB switch
                                {
                                    "ChuTro" => "loai-chutro",
                                    "HoaDon" => "loai-hoadon",
                                    "SuCo" => "loai-suco",
                                    _ => "loai-he-thong"
                                };
                                var loaiIco = tb.LoaiTB switch
                                {
                                    "ChuTro" => "fa-user-tie",
                                    "HoaDon" => "fa-file-invoice-dollar",
                                    "SuCo" => "fa-tools",
                                    _ => "fa-info-circle"
                                };
                                var loaiBadge = tb.LoaiTB switch
                                {
                                    "ChuTro" => "chutro",
                                    "HoaDon" => "hoadon",
                                    "SuCo" => "suco",
                                    _ => "hethong"
                                };
                                var loaiLabel = tb.LoaiTB switch
                                {
                                    "ChuTro" => "Chủ trọ",
                                    "HoaDon" => "Hóa đơn",
                                    "SuCo" => "Sự cố",
                                    _ => "Hệ thống"
                                };
                                var thoiGianTB = (DateTime.Now - tb.NgayTao).TotalMinutes < 60
                                    ? $"{(int)(DateTime.Now - tb.NgayTao).TotalMinutes} phút trước"
                                    : (DateTime.Now - tb.NgayTao).TotalHours < 24
                                        ? $"{(int)(DateTime.Now - tb.NgayTao).TotalHours} giờ trước"
                                        : tb.NgayTao.ToString("dd/MM/yyyy");
                                <div class="tb-item @(tb.DaDoc ? "da-doc" : "chua-doc")"
                                     onclick="tbXemChiTiet(@tb.IDThongBao)"
                                     data-id="@tb.IDThongBao">
                                    <div class="tb-item-dot"></div>
                                    <div class="tb-item-icon @loaiIcon">
                                        <i class="fas @loaiIco"></i>
                                    </div>
                                    <div class="tb-item-body">
                                        <div class="tb-item-tieu-de">@tb.TieuDe</div>
                                        <div class="tb-item-noi-dung">@tb.NoiDung</div>
                                        <div class="tb-item-meta">
                                            <span class="tb-item-time"><i class="fas fa-clock" style="font-size:10px;margin-right:3px;"></i>@thoiGianTB</span>
                                            <span class="tb-item-loai @loaiBadge">@loaiLabel</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="tb-panel-footer">
                            <button class="tb-xem-tat-ca" onclick="tbDongPanel()">
                                <i class="fas fa-times" style="margin-right:4px;"></i>Đóng
                            </button>
                        </div>
                    </div>
                </div>

                <div class="thong-tin-admin" id="mgrHeaderWrap">
                    <button onclick="mgrToggleMenu()" id="mgrHeaderBtn"
                            style="display:flex;align-items:center;gap:10px;cursor:pointer;
                        padding:6px 12px;border-radius:24px;border:none;background:none;
                        font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-xanh-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien">
                            @if (!string.IsNullOrEmpty(Model.Avatar))
                            {
                                <img src="@Model.Avatar" alt="Avatar"
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                            }
                            else
                            {

                                @initials
                            }
                        </div>
                        <div>
                            <div class="ten" id="mgr-header-ten">@Model.TenNguoiDung</div>
                            <div class="chuc-vu">@Model.ChucVu</div>
                        </div>
                        <i class="fas fa-chevron-down" id="mgrChevron"
                           style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;transition:transform 0.2s;"></i>
                    </button>

                    <div class="mgr-dropdown" id="mgrDropdown">
                        <div class="mgr-dd-header">
                            <div class="mgr-dd-avatar">@initials</div>
                            <div>
                                <div class="mgr-dd-name">@Model.TenNguoiDung</div>
                                <div class="mgr-dd-sub" id="mgr-dd-email">Đang tải...</div>
                                <span class="mgr-dd-badge">
                                    <i class="fas fa-user-shield" style="font-size:8px;"></i>
                                    Quản lý
                                </span>
                            </div>
                        </div>

                        <div class="mgr-dd-body">
                            <button class="mgr-item" onclick="mgrMoDoiMatKhau()">
                                <div class="mgr-item-icon blue"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đổi mật khẩu</div>
                                    <div class="mgr-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>
                            <div class="mgr-divider"></div>
                            <button class="mgr-item danger" onclick="mgrXacNhanDangXuat()">
                                <div class="mgr-item-icon red"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đăng xuất</div>
                                    <div class="mgr-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header><!-- Kết thúc HEADER -->
        <!-- ===============================================
       NỘI DUNG DASHBOARD CHÍNH
  ============================================= -->
        <main id="noi-dung-dashboard">

            <!-- Dòng tiêu đề + nút thêm mới -->
            <div class="hang-chao-mung">
                <div>
                    <h2>Xin chào, @Model.TenNguoiDung! 👋</h2>
                    <p id="ngay-gio-hien-tai"></p>
                </div>
            </div>

            <!-- =============================================
         HÀNG 1: 4 CARD THỐNG KÊ TỔNG QUAN
    ============================================= -->
            <div class="hang-thong-ke">

                <!-- Card 1: Tổng số phòng -->
                <div class="card-thong-ke mau-xanh" onclick="xemChiTietPhong()">
                    <div class="card-noi-dung">
                        <div class="bieu-tuong-card"><i class="fas fa-building"></i></div>
                        <div class="so-lieu">
                            <div class="con-so">@Model.ThongKeTong.TongSoPhong</div>
                            <div class="ten-thong-ke">Tổng số phòng</div>
                            <span class="ty-le-thay-doi tang">↑ +@Model.ThongKeTong.PhongDangThue đang thuê</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Phòng đang được thuê -->
                <div class="card-thong-ke mau-xanh-la" onclick="xemPhongDangThue()">
                    <div class="card-noi-dung">
                        <div class="bieu-tuong-card"><i class="fas fa-user-check"></i></div>
                        <div class="so-lieu">
                            <div class="con-so">@Model.ThongKeTong.PhongDangThue</div>
                            <div class="ten-thong-ke">Phòng đang thuê</div>
                            <span class="ty-le-thay-doi tang">↑ @tiLeLapDay% lấp đầy</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Phòng còn trống -->
                <div class="card-thong-ke mau-cam" onclick="xemPhongTrong()">
                    <div class="card-noi-dung">
                        <div class="bieu-tuong-card"><i class="fas fa-door-closed"></i></div>
                        <div class="so-lieu">
                            <div class="con-so">@Model.ThongKeTong.PhongConTrong</div>
                            <div class="ten-thong-ke">Phòng còn trống</div>
                            <span class="ty-le-thay-doi giam">↓ @Model.ThongKeTong.PhongDangSua đang bảo trì</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Doanh thu tháng này -->
                <div class="card-thong-ke mau-tim" onclick="xemDoanhThu()">
                    <div class="card-noi-dung">
                        <div class="bieu-tuong-card"><i class="fas fa-coins"></i></div>
                        <div class="so-lieu">
                            <div class="con-so" style="font-size:20px;">@doanhThuThang</div>
                            <div class="ten-thong-ke">Doanh thu tháng @thangHienTai</div>
                            @if (Model.ThongKeTong.TangTruongDoanhThu >= 0)
                            {
                                <span class="ty-le-thay-doi tang">↑ +@Model.ThongKeTong.TangTruongDoanhThu.ToString("0.#")% so tháng trước</span>
                            }
                            else
                            {
                                <span class="ty-le-thay-doi giam">↓ @Model.ThongKeTong.TangTruongDoanhThu.ToString("0.#")% so tháng trước</span>
                            }
                        </div>
                    </div>
                </div>

            </div><!-- Kết thúc HÀNG 1 -->
            <!-- =============================================
         HÀNG 2: BIỂU ĐỒ DOANH THU + SỰ CỐ MỚI NHẤT
    ============================================= -->
            <div class="hang-bieu-do">

                <!-- ===== Card biểu đồ doanh thu theo tháng ===== -->
                <div class="card-bieu-do">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-chart-line"></i> Biểu đồ doanh thu theo tháng</h3>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <select class="truong-nhap chon-lua" style="padding:5px 10px;font-size:12px;width:90px;" onchange="thayDoiNam(this.value)">
                                <option>@Model.NamBieuDo</option>
                                <option>@(Model.NamBieuDo - 1)</option>
                            </select>
                            <button class="nut-xem-them" onclick="xemBaoCaoDoanhThu()">Báo cáo đầy đủ</button>
                        </div>
                    </div>
                    <canvas id="bieu-do-doanh-thu" height="110"></canvas>
                </div>

                <!-- ===== Card sự cố mới nhất ===== -->
                <div class="card-thong-bao">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-exclamation-circle" style="color:#ef4444;"></i> Sự cố mới nhất</h3>
                        <button class="nut-xem-them" onclick="xemTatCaSuCo()">Xem tất cả</button>
                    </div>

                    @foreach (var suCo in Model.SuCoMoiNhat)
                    {
                        var dotMau = suCo.MucDo == "Khẩn cấp" ? "do"
                                   : suCo.TrangThai_DV == "Thành công" ? "xanh"
                                   : "vang";
                        var thoiGian = (DateTime.Now - suCo.NgayTao).TotalMinutes < 60
                            ? $"{(int)(DateTime.Now - suCo.NgayTao).TotalMinutes} phút trước"
                            : (DateTime.Now - suCo.NgayTao).TotalHours < 24
                                ? $"{(int)(DateTime.Now - suCo.NgayTao).TotalHours} giờ trước"
                                : "Hôm qua";
                        <div class="muc-thong-bao">
                            <div class="dot-trang-thai @dotMau"></div>
                            <div class="noi-dung-thong-bao">
                                <div class="tieu-de-thong-bao">Phòng @suCo.Phong.SoPhong – @suCo.LoaiDV</div>
                                <div class="mo-ta-thong-bao">@suCo.NoiDung</div>
                            </div>
                            <div class="thoi-gian">@thoiGian</div>
                        </div>
                    }

                    <button style="width:100%;margin-top:14px;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;border:none;border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;" onclick="moModalBaoSuCo()">
                        <i class="fas fa-plus"></i> Ghi nhận sự cố mới
                    </button>
                </div>

            </div><!-- Kết thúc HÀNG 2 -->
            <!-- =============================================
         HÀNG 3: HÓA ĐƠN SẮP ĐẾN HẠN + DANH SÁCH PHÒNG
    ============================================= -->
            <div class="hang-bang-du-lieu">

                <!-- ===== Card bảng hóa đơn sắp đến hạn ===== -->
                <div class="card-bang">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-file-invoice-dollar" style="color:#7c3aed;"></i> Hóa đơn sắp đến hạn</h3>
                        <button class="nut-xem-them" onclick="xemTatCaHoaDon()">Xem tất cả</button>
                    </div>

                    <table class="bang-hoa-don">
                        <thead>
                            <tr>
                                <th>Phòng</th>
                                <th>Người thuê</th>
                                <th>Số tiền</th>
                                <th>Hạn ngày</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hd in Model.HoaDonSapDenHan)
                            {
                                <tr>
                                    <td><strong>P.@hd.SoPhong</strong></td>
                                    <td>@hd.TenNguoiThue</td>
                                    <td style="font-weight:700;color:@(hd.TrangThai == "Đã hoàn thành" ? "#16a34a" : "var(--mau-chu-de)");">
                                        @hd.TongCong.ToString("N0")đ
                                    </td>
                                    <td>@hd.HanDong.ToString("dd/MM/yyyy")</td>
                                    <td><span class="trang-thai-thanh-toan @hd.CssClass">@hd.TrangThai</span></td>
                                    <td><button class="nut-hanh-dong" onclick="@hd.NutOnClick">@hd.NutHanhDong</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ===== Card danh sách phòng trống ===== -->
                <div class="card-phong">
                    <div class="tieu-de-card">
                        <h3><i class="fas fa-door-open" style="color:#059669;"></i> Tình trạng phòng</h3>
                        <button class="nut-xem-them" onclick="xemTatCaPhong()">Tất cả phòng</button>
                    </div>

                    <div class="danh-sach-phong">
                        @foreach (var phong in Model.PhongConTrong)
                        {
                            var badgeCss = phong.TrangThai == "Trống" ? "trong"
                                         : phong.TrangThai == "Đã thuê" ? "thue"
                                         : "sua";
                            var badgeText = phong.TrangThai == "Trống" ? "Còn trống"
                                          : phong.TrangThai == "Đã thuê" ? "Đã thuê"
                                          : "Đang sửa";
                            <div class="muc-phong" onclick="xemChiTietPhongCuThe('P.@phong.SoPhong')">
                                <div>
                                    <div class="ten-phong">Phòng @phong.SoPhong</div>
                                    <div class="loai-phong">Khu @phong.Khu • @phong.DienTich m²</div>
                                </div>
                                <div style="text-align:right;">
                                    <div class="gia-phong">@((phong.GiaPhongFix / 1_000_000m).ToString("0.#"))M/th</div>
                                    <span class="trang-thai-phong @badgeCss">@badgeText</span>
                                </div>
                            </div>
                        }
                    </div>

                </div><!-- Kết thúc card phòng -->

            </div><!-- Kết thúc HÀNG 3 -->
            <!-- =============================================
         HÀNG 4: THÔNG BÁO TỪ CHỦ TRỌ
    ============================================= -->
            <div class="card-thong-bao-chu-tro">
                <div class="tieu-de-card" style="margin-bottom:0;">
                    <h3>
                        <i class="fas fa-user-tie" style="color:#d97706;"></i>
                        Thông báo từ chủ trọ
                        @if (Model.SoThongBaoChuTroChuaDoc > 0)
                        {
                            <span style="margin-left:8px;background:#ef4444;color:#fff;font-size:11px;
                                font-weight:700;border-radius:9999px;padding:1px 8px;">
                                @Model.SoThongBaoChuTroChuaDoc mới
                            </span>
                        }
                    </h3>
                    <button class="nut-xem-them" onclick="tbToggle()">
                        <i class="fas fa-bell" style="margin-right:4px;"></i>Xem tất cả
                    </button>
                </div>

                @if (!Model.ThongBaoChuTroMoiNhat.Any())
                {
                    <div style="text-align:center;padding:28px;color:var(--mau-chu-phu);font-size:13px;">
                        <i class="fas fa-bell-slash" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                        Chưa có thông báo nào từ chủ trọ
                    </div>
                }
                else
                {
                    <div class="tb-chu-tro-list">
                        @foreach (var tb in Model.ThongBaoChuTroMoiNhat)
                        {
                            var initCT = tb.TenNguoiGui?.Length > 0 ? tb.TenNguoiGui[0].ToString().ToUpper() : "C";
                            var thoiGianCT = (DateTime.Now - tb.NgayTao).TotalMinutes < 60
                                ? $"{(int)(DateTime.Now - tb.NgayTao).TotalMinutes} phút trước"
                                : (DateTime.Now - tb.NgayTao).TotalHours < 24
                                    ? $"{(int)(DateTime.Now - tb.NgayTao).TotalHours} giờ trước"
                                    : tb.NgayTao.ToString("dd/MM HH:mm");
                            <div class="tb-chu-tro-item @(tb.DaDoc ? "" : "chua-doc")"
                                 onclick="tbXemChiTiet(@tb.IDThongBao)">
                                <div class="tb-ct-avatar">@initCT</div>
                                <div class="tb-ct-body">
                                    <div class="tb-ct-tieu-de">
                                        @tb.TieuDe
                                        @if (!tb.DaDoc)
                                        {
                                            <span class="chua-doc-badge"></span>
                                        }
                                    </div>
                                    <div class="tb-ct-nguoi">
                                        <i class="fas fa-user" style="font-size:10px;margin-right:3px;"></i>@tb.TenNguoiGui
                                        @if (!string.IsNullOrEmpty(tb.SoPhongNguoiGui))
                                        {
                                            <span style="margin-left:6px;"><i class="fas fa-door-open" style="font-size:10px;margin-right:3px;"></i>P.@tb.SoPhongNguoiGui</span>
                                        }
                                    </div>
                                    <div class="tb-ct-noi-dung">@tb.NoiDung</div>
                                </div>
                                <div class="tb-ct-time">@thoiGianCT</div>
                            </div>
                        }
                    </div>
                }
            </div><!-- Kết thúc HÀNG 4 -->

