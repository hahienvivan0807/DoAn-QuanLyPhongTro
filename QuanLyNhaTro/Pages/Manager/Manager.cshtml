        <script>

            // ===== CẬP NHẬT NGÀY GIỜ =====
            function capNhatNgayGio() {
            const ngay = new Date();
            const tuan = ['Chủ nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
            document.getElementById('ngay-gio-hien-tai').textContent =
            `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth()+1} năm ${ngay.getFullYear()}`;
            }
            capNhatNgayGio();

            // ===== DỮ LIỆU PHÒNG TỪ SERVER (cho modal danh sách phòng) =====
            const roomData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.TatCaPhong.Select(p => new
                                        {
                                            id = p.IDPhong,
                                            soPhong = p.SoPhong,
                                            khu = (int)p.Khu,
                                            dienTich = p.DienTich,
                                            gia = p.GiaPhongFix,
                                            trangThai = p.TrangThai
                                        })
                                    ));

            // ===== BIỂU ĐỒ DOANH THU Chart.js — dữ liệu từ server =====
            const duLieuDoanhThu = @Html.Raw(doanhThuJson); // đơn vị triệu đồng
            const ctx = document.getElementById('bieu-do-doanh-thu').getContext('2d');

            const grd = ctx.createLinearGradient(0, 0, 0, 200);
            grd.addColorStop(0, 'rgba(26,86,219,0.25)');
            grd.addColorStop(1, 'rgba(26,86,219,0.0)');

            new Chart(ctx, {
            type: 'line',
            data: {
            labels: ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'],
            datasets: [{
            label: 'Doanh thu (triệu đồng)',
            data: duLieuDoanhThu,
            borderColor: '#1a56db',
            backgroundColor: grd,
            borderWidth: 2.5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#1a56db',
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7,
            fill: true,
            tension: 0.4,
            }]
            },
            options: {
            responsive: true, maintainAspectRatio: true,
            plugins: {
            legend: { display: false },
            tooltip: {
            backgroundColor: '#1e293b',
            titleColor: '#94a3b8', bodyColor: '#fff',
            padding: 10, borderRadius: 8,
            callbacks: { label: ctx => ` ${ctx.raw} triệu đồng` }
            }
            },
            scales: {
            x: { grid: { display: false }, ticks: { font: { size: 11 } } },
            y: {
            grid: { color: '#f1f5f9' },
            ticks: { font: { size: 11 }, callback: val => val + 'M' },
            beginAtZero: true
            }
            }
            }
            });

            // ===== CÁC HÀM ĐIỀU HƯỚNG & TƯƠNG TÁC =====

            function chuyenTrang(tenTrang, phanTu) {
            document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
            phanTu.classList.add('dang-chon');
            const bangDieuHuong = {
            'trang-chu':           '/Manager/Manager',
            'quan-ly-phong':       '/Manager/ChiTietPhong',
            'quan-ly-nguoi-thue':  '/Manager/QuanLyDichVu',
            'hoa-don':             '/Manager/HoaDon',
            'su-co-bao-tri':       '/Manager/SuCoBaoTri',
            'thong-ke':             '/Manager/ThongKe',
            'cai-dat':             '/Manager/CaiDat',
            'phong-cua-toi':        '/KhachThue/KhachThue',
            };
            const duongDan = bangDieuHuong[tenTrang];
            if (duongDan) {
            window.location.href = duongDan;
            } else {
            console.log('Chưa có trang:', tenTrang);
            }
            }

            function dongMoSidebar() {
            document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            function moModalThemPhong() {
            document.getElementById('modal-them-phong').classList.add('hien');
            }

            function moModalBaoSuCo() {
            document.getElementById('modal-bao-su-co').classList.add('hien');
            }

            function dongModal(idModal) {
            document.getElementById(idModal).classList.remove('hien');
            }

            function dongModalNeuNhanNgoai(event, idModal) {
            if (event.target.id === idModal) dongModal(idModal);
            }

            function luuPhongMoi() {
            const soPhong = document.getElementById('so-phong').value;
            const giaThue = document.getElementById('gia-thue').value;
            if (!soPhong || !giaThue) { alert('Vui lòng điền đầy đủ thông tin bắt buộc!'); return; }
            alert(`Đã lưu phòng ${soPhong} thành công! (Kết nối backend để lưu thật)`);
            dongModal('modal-them-phong');
            }

            function luuSuCo() {
            const moTa = document.getElementById('mo-ta-su-co').value;
            if (!moTa) { alert('Vui lòng mô tả sự cố!'); return; }
            alert('Đã ghi nhận sự cố! (Kết nối backend để lưu thật)');
            dongModal('modal-bao-su-co');
            }

            function nhacNhoThanhToan(soPhong) {
            alert(`Đã gửi nhắc nhở thanh toán tới người thuê phòng ${soPhong}!`);
            }

            function xemChiTietPhong() { window.location.href = 'Manager/ChiTietPhong'; }
            function xemPhongDangThue() { window.location.href = '/ChiTietPhong?trangThai=dang-thue'; }
            function xemPhongTrong() { window.location.href = '/ChiTietPhong?trangThai=trong'; }
            function xemDoanhThu() { window.location.href = '/BaoCao'; }
            function xemBaoCaoDoanhThu() { window.location.href = '/BaoCao'; }
            function xemTatCaSuCo() { window.location.href = '/SuCoBaoTri'; }
            function xemTatCaHoaDon() { window.location.href = '/HoaDon'; }
            function xemChiTietPhongCuThe(soPhong) { window.location.href = '/ChiTietPhong?soPhong=' + soPhong; }
            function xemHoaDon(soPhong) { window.location.href = '/HoaDon?soPhong=' + soPhong; }
            function moThongBao() { tbToggle(); }

            // ===== HỆ THỐNG THÔNG BÁO =====
            let currentTbId = null;

            // Dữ liệu thông báo từ server (để dùng trong JS)
            const danhSachTB = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.DanhSachThongBao.Select(tb => new
                        {
                            id = tb.IDThongBao,
                            tieuDe = tb.TieuDe,
                            noiDung = tb.NoiDung,
                            loaiTB = tb.LoaiTB,
                            daDoc = tb.DaDoc,
                            ngayTao = tb.NgayTao.ToString("dd/MM/yyyy HH:mm"),
                            nguoiGui = tb.TenNguoiGui ?? "Hệ thống",
                            soPhong = tb.SoPhongNguoiGui ?? ""
                        })
                    ));

            function tbToggle() {
            const panel = document.getElementById('tbPanel');
            panel.classList.toggle('show');
            // đóng dropdown admin nếu đang mở
            const dd = document.getElementById('mgrDropdown');
            if (dd) dd.classList.remove('show');
            }

            function tbDongPanel() {
            document.getElementById('tbPanel').classList.remove('show');
            }

            // Đóng panel khi click ngoài
            document.addEventListener('click', function(e) {
            const wrap = document.getElementById('tbPanelWrap');
            if (wrap && !wrap.contains(e.target)) {
            document.getElementById('tbPanel').classList.remove('show');
            }
            });

            function tbXemChiTiet(id) {
            const tb = danhSachTB.find(x => x.id === id);
            if (!tb) return;
            currentTbId = id;

            // Gán nội dung modal
            document.getElementById('mctb-tieu-de').textContent = tb.tieuDe;
            document.getElementById('mctb-noi-dung').textContent = tb.noiDung || '(Không có nội dung)';
            document.getElementById('mctb-nguoi-gui').textContent = tb.nguoiGui;
            document.getElementById('mctb-ngay-tao').textContent = tb.ngayTao;

            // Icon + loại
            const iconMap = { ChuTro:'fa-user-tie', HoaDon:'fa-file-invoice-dollar', SuCo:'fa-tools' };
            const classMap = { ChuTro:'loai-chutro', HoaDon:'loai-hoadon', SuCo:'loai-suco' };
            const labelMap = { ChuTro:'Chủ trọ', HoaDon:'Hóa đơn', SuCo:'Sự cố' };
            const badgeMap = { ChuTro:'chutro', HoaDon:'hoadon', SuCo:'suco' };

            const loai = tb.loaiTB;
            document.getElementById('mctb-icon-i').className = 'fas ' + (iconMap[loai] || 'fa-info-circle');
            const iconEl = document.getElementById('mctb-icon');
            iconEl.className = 'tb-detail-icon ' + (classMap[loai] || 'loai-he-thong');
            document.getElementById('mctb-loai-text').textContent = labelMap[loai] || 'Hệ thống';
            document.getElementById('mctb-loai-text').className = 'tb-item-loai ' + (badgeMap[loai] || 'hethong');
            document.getElementById('mctb-phan-loai').textContent = labelMap[loai] || 'Hệ thống';

            // Phòng
            const rowPhong = document.getElementById('mctb-row-phong');
            if (tb.soPhong) {
            document.getElementById('mctb-phong').textContent = 'Phòng ' + tb.soPhong;
            rowPhong.style.display = 'flex';
            } else {
            rowPhong.style.display = 'none';
            }

            // Nút đã đọc
            const btnDoc = document.getElementById('mctb-btn-doc');
            if (tb.daDoc) {
            btnDoc.innerHTML = '<i class="fas fa-check-double"></i> Đã đọc';
            btnDoc.disabled = true;
            btnDoc.style.opacity = '0.5';
            } else {
            btnDoc.innerHTML = '<i class="fas fa-check"></i> Đánh dấu đã đọc';
            btnDoc.disabled = false;
            btnDoc.style.opacity = '1';
            }

            // Mở modal
            document.getElementById('modal-chi-tiet-tb').classList.add('hien');
            tbDongPanel();

            // Tự động đánh dấu đã đọc nếu chưa
            if (!tb.daDoc) {
            tbDanhDauDaDoc(id, true);
            }
            }

            async function tbDanhDauDaDoc(id, tuDong = false) {
            try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const res = await fetch(`?handler=MarkRead&id=${id}`, {
            method: 'POST',
            headers: {
            'RequestVerificationToken': token || '',
            'X-CSRF-TOKEN': token || ''
            }
            });
            if (res.ok) {
            // Cập nhật UI
            const tb = danhSachTB.find(x => x.id === id);
            if (tb) tb.daDoc = true;

            // Cập nhật item trong list
            const item = document.querySelector(`.tb-item[data-id="${id}"]`);
            if (item) {
            item.classList.remove('chua-doc');
            item.classList.add('da-doc');
            item.querySelector('.tb-item-dot').style.background = 'transparent';
            }

            // Giảm badge
            const badge = document.getElementById('bell-badge');
            const soHienTai = parseInt(badge.textContent) || 0;
            if (soHienTai > 1) {
            badge.textContent = soHienTai - 1;
            } else {
            badge.style.display = 'none';
            }

            if (!tuDong) {
            const btnDoc = document.getElementById('mctb-btn-doc');
            btnDoc.innerHTML = '<i class="fas fa-check-double"></i> Đã đọc';
            btnDoc.disabled = true;
            btnDoc.style.opacity = '0.5';
            }
            }
            } catch (e) { console.warn('Lỗi đánh dấu đã đọc:', e); }
            }

            async function tbDocTatCa() {
            try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const res = await fetch(`?handler=MarkAllRead`, {
            method: 'POST',
            headers: {
            'RequestVerificationToken': token || '',
            'X-CSRF-TOKEN': token || ''
            }
            });
            if (res.ok) {
            danhSachTB.forEach(tb => tb.daDoc = true);
            document.querySelectorAll('.tb-item.chua-doc').forEach(el => {
            el.classList.remove('chua-doc');
            el.classList.add('da-doc');
            const dot = el.querySelector('.tb-item-dot');
            if (dot) dot.style.background = 'transparent';
            });
            const badge = document.getElementById('bell-badge');
            if (badge) badge.style.display = 'none';
            }
            } catch (e) { console.warn('Lỗi đọc tất cả:', e); }
            }
            function moMenuAdmin() { alert('Menu tài khoản: Đổi mật khẩu / Đăng xuất'); }
            function moThongTinAdmin() { alert('Thông tin quản trị viên'); }
            function xemTatCaPhong() {
            document.getElementById('overlay-danh-sach-phong').style.display = 'flex';
            }
            function dongModalPhong(event) {
            if (event.target.id === 'overlay-danh-sach-phong')
            document.getElementById('overlay-danh-sach-phong').style.display = 'none';
            }
            function timKiem(tuKhoa) { console.log('Tìm kiếm:', tuKhoa); }
            function thayDoiNam(nam) { console.log('Đổi năm biểu đồ:', nam); }

            // ===== ĐỒNG BỘ BADGE SIDEBAR (gọi API chung, không phụ thuộc từng trang) =====
            (async function loadBadgeSidebar() {
            try {
            const res = await fetch('/Api/BadgeCounts');
            if (!res.ok) return;
            const data = await res.json();

            const badgeDV = document.getElementById('badge-dichvu');
            const badgeSC = document.getElementById('badge-suco');

            if (badgeDV) {
            badgeDV.textContent = data.dichVuMoi;
            badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none';
            }
            if (badgeSC) {
            badgeSC.textContent = data.suCoChoXuLy;
            badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none';
            }
            } catch (e) {
            console.warn('Không thể load badge sidebar:', e);
            }
            })();
        </script>
    </body>
</html>
