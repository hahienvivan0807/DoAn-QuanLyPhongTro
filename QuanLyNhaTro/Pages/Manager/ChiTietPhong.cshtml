                <!-- Thẻ 2: Phòng đang thuê -->
                <div class="the-thong-ke-nhanh dang-thue" onclick="locTheoTrangThai('dang-thue')">
                    <div class="bieu-tuong-the"><i class="fas fa-user-check"></i></div>
