@page "/Manager/ChiTietPhong"
@model QuanLyNhaTro.Pages.ChiTietPhongModel
@{
    Layout = null;

    string CssClass(string tt) => tt switch
    {
        "Đã thuê" => "dang-thue",
        "Đang sửa" => "bao-tri",
        _ => "con-trong"
    };

    string BadgeText(string tt) => tt switch
    {
        "Đã thuê" => "● Đang thuê",
        "Đang sửa" => "● Bảo trì",
        _ => "● Còn trống"
    };

    string FormatGia(decimal gia)
    {
        if (gia >= 1_000_000m)
            return (gia / 1_000_000m).ToString("0.#") + "M/th";
        return gia.ToString("N0") + "đ/th";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <script src="/js/QuanLy/QuanLy-core.js" defer></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Lý Phòng Trọ – Manager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="~/css/Manager/ChiTietPhong.css" rel="stylesheet" />
</head>
<body>

    <!-- ============================================================
     SIDEBAR – GIỮ NGUYÊN, KHÔNG SỬA
    ============================================================ -->
    <nav id="thanh-sidebar">
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('phong-cua-toi', this)">
            <i class="fas fa-door-open"></i>
            <span>Phòng của tôi</span>
        </div>

        <div class="nhan-nhom">Quản lý</div>
        <div class="menu-item dang-chon" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i>
            <span>Quản lý dịch vụ và tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn &amp; Thu tiền</span>
        </div>

        <div class="nhan-nhom">Hỗ trợ</div>
        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i><span>Thống kê &amp; Báo cáo</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="admin-sidebar" onclick="moThongTinAdmin()">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
                {
                    <img src="@Model.CurrentUser.Avatar" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    @(Model.CurrentUser?.FullName?.Length > 0 ? Model.CurrentUser.FullName[0].ToString().ToUpper() : "M")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.CurrentUser?.FullName ?? "Manager")</strong>
                <span>@(Model.CurrentUser?.Roles ?? "Quản lý")</span>
            </div>
        </div>
    </nav><!-- / SIDEBAR -->
    <!-- ============================================================
     KHU VỰC CHÍNH
    ============================================================ -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Quản Lý Phòng Trọ</div>
                    <div class="duong-dan">Trang chủ / Quản lý phòng trọ</div>
                </div>
            </div>
            <div class="header-phai">
                <div class="o-tim-kiem-header">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê..." oninput="timKiemToanCuc(this.value)" />
                </div>
                <button class="nut-thong-bao" onclick="moThongBao()">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>
                <div class="thong-tin-admin-header" id="mgrHeaderWrap">
                    <button onclick="mgrToggleMenu()" id="mgrHeaderBtn"
                            style="display:flex;align-items:center;gap:10px;cursor:pointer;
                        padding:6px 12px;border-radius:24px;border:none;background:none;
                        font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-xanh-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div class="anh-dai-dien">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "M")</div>
                        <div>
                            <div style="font-size:13px;font-weight:600;">@(Model.CurrentUser?.FullName ?? "Manager")</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">@(Model.CurrentUser?.Roles ?? "Quản lý")</div>
                        </div>
                        <i class="fas fa-chevron-down" id="mgrChevron" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;transition:transform 0.2s;"></i>
                    </button>
                    <div class="mgr-dropdown" id="mgrDropdown">
                        <div class="mgr-dd-header">
                            <div class="mgr-dd-avatar">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "M")</div>
                            <div>
                                <div class="mgr-dd-name">@(Model.CurrentUser?.FullName ?? "Manager")</div>
                                <div class="mgr-dd-sub">@(Model.CurrentUser?.Email ?? Model.CurrentUser?.Phone ?? "")</div>
                                <span class="mgr-dd-badge"><i class="fas fa-user-shield" style="font-size:8px;"></i> Quản lý</span>
                            </div>
                        </div>
                        <div class="mgr-dd-body">
                            <button class="mgr-item" onclick="mgrMoDoiMatKhau()">
                                <div class="mgr-item-icon blue"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đổi mật khẩu</div>
                                    <div class="mgr-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>
                            <div class="mgr-divider"></div>
                            <button class="mgr-item danger" onclick="mgrXacNhanDangXuat()">
                                <div class="mgr-item-icon red"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đăng xuất</div>
                                    <div class="mgr-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header><!-- / HEADER -->
        <!-- NỘI DUNG TRANG -->
        <main id="noi-dung-trang">

            <!-- Tiêu đề trang + badge vai trò (KHÔNG có nút Thêm phòng) -->
            <div class="hang-tieu-de-trang">
                <div>
                    <h2>Phòng Được Phân Công 🏠</h2>
                    <p>Danh sách phòng trọ trong phạm vi quản lý của bạn</p>
                </div>
                <span class="badge-quyen-han">
                    <i class="fas fa-shield-alt"></i> Chỉ xem – Không chỉnh sửa
                </span>
            </div>

            <!-- HÀNG THỐNG KÊ NHANH -->
            <div class="hang-thong-ke-nhanh">
                <div class="the-thong-ke-nhanh tat-ca" onclick="locTheoTrangThai('tat-ca')">
                    <div class="bieu-tuong-the"><i class="fas fa-building"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-tong-phong">@Model.TongSoPhong</div>
                        <div class="ten-the">Phòng phụ trách</div>
                    </div>
                </div>
                <div class="the-thong-ke-nhanh dang-thue" onclick="locTheoTrangThai('dang-thue')">
                    <div class="bieu-tuong-the"><i class="fas fa-user-check"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-phong-dang-thue">@Model.SoPhongDangThue</div>
                        <div class="ten-the">Đang được thuê</div>
                    </div>
                </div>
                <div class="the-thong-ke-nhanh con-trong" onclick="locTheoTrangThai('con-trong')">
                    <div class="bieu-tuong-the"><i class="fas fa-door-closed"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-phong-con-trong">@Model.SoPhongConTrong</div>
                        <div class="ten-the">Còn trống</div>
                    </div>
                </div>
            </div>

            <!-- THANH LỌC + TÌM KIẾM -->
            <div class="thanh-loc-tim-kiem">
                <div class="o-tim-kiem-phong">
                    <i class="fas fa-search"></i>
                    <input type="text" id="o-nhap-tim-kiem" placeholder="Tìm theo số phòng, tên người thuê..." oninput="timKiemPhong(this.value)" />
                </div>
                <div class="nhom-nut-loc">
                    <button class="nut-loc dang-chon-loc" id="nut-loc-tat-ca" onclick="locTheoTrangThai('tat-ca')">
                        <i class="fas fa-th-large"></i> Tất cả
                    </button>
                    <button class="nut-loc" id="nut-loc-dang-thue" onclick="locTheoTrangThai('dang-thue')">
                        <i class="fas fa-user-check"></i> Đang thuê
                    </button>
                    <button class="nut-loc" id="nut-loc-con-trong" onclick="locTheoTrangThai('con-trong')">
                        <i class="fas fa-door-closed"></i> Còn trống
                    </button>
                    <button class="nut-loc" id="nut-loc-bao-tri" onclick="locTheoTrangThai('bao-tri')">
                        <i class="fas fa-tools"></i> Bảo trì
                    </button>
                </div>
                <select class="chon-sap-xep" id="chon-sap-xep" onchange="sapXepPhong(this.value)">
                    <option value="so-phong-tang">Số phòng ↑</option>
                    <option value="so-phong-giam">Số phòng ↓</option>
                    <option value="gia-tang">Giá tăng dần</option>
                    <option value="gia-giam">Giá giảm dần</option>
                </select>
            </div>

            <div class="ket-qua-loc" id="ket-qua-loc">
                Hiển thị <strong id="so-ket-qua">@Model.TongSoPhong</strong> phòng
            </div>

            <!-- ========================================
             LƯỚI DANH SÁCH PHÒNG
             Manager: CHỈ có nút [Chi tiết] và [Hợp đồng], KHÔNG có Sửa/Xóa
            ======================================== -->
            <div class="luoi-danh-sach-phong" id="luoi-danh-sach-phong">

                @foreach (var vm in Model.DanhSachPhong)
                {
                    var cssClass = CssClass(vm.Phong.TrangThai);
                    var badgeText = BadgeText(vm.Phong.TrangThai);
                    var tenNguoi = vm.HopDongHienTai?.Tenant?.FullName ?? "";
                    var hanHD = vm.HopDongHienTai?.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "";
                    var initials = !string.IsNullOrEmpty(tenNguoi) ? tenNguoi[0].ToString().ToUpper() : "";

                    var (bgStyle, iconClass, iconStyle) = cssClass switch
                    {
                        "con-trong" => ("background:linear-gradient(135deg,#fef9c3,#fde68a);",
                                        "fas fa-bed", "color:#d97706;"),
                        "bao-tri" => ("background:linear-gradient(135deg,#fee2e2,#fca5a5);",
                                        "fas fa-tools", "color:#dc2626;"),
                        _ => (vm.Phong.Khu >= 3
                                            ? "background:linear-gradient(135deg,#e0f2fe,#bae6fd);"
                                            : "",
                                        vm.Phong.Khu >= 3 ? "fas fa-crown" : "fas fa-bed",
                                        vm.Phong.Khu >= 3 ? "color:#0284c7;" : "")
                    };

                    <div class="phong-item trang-thai-@cssClass"
                         data-id-phong="@vm.Phong.IDPhong"
                         data-so-phong="@vm.Phong.SoPhong"
                         data-trang-thai="@cssClass"
                         data-gia="@((long)vm.Phong.GiaPhongFix)"
                         data-nguoi-thue="@tenNguoi">
                        <div class="anh-phong" style="@bgStyle">
                            <i class="@iconClass icon-phong" style="@iconStyle"></i>
                            <span class="badge-so-phong">P.@vm.Phong.SoPhong</span>
                            <span class="badge-trang-thai @cssClass">@badgeText</span>
                        </div>
                        <div class="noi-dung-phong">
                            <div class="hang-ten-phong">
                                <span class="ten-phong-item">Phòng @vm.Phong.SoPhong</span>
                                <span class="gia-phong-item">@FormatGia(vm.Phong.GiaPhongFix)</span>
                            </div>
                            <div class="hang-thong-tin-phong">
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-expand-arrows-alt"></i>
                                    @(vm.Phong.DienTich.HasValue ? $"{vm.Phong.DienTich:0.#}m²" : "—")
                                </span>
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-layer-group"></i> Khu @vm.Phong.Khu
                                </span>
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-users"></i> Tối đa @vm.Phong.soluong người
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(tenNguoi))
                            {
                                <div class="nguoi-thue-hien-tai">
                                    <div class="anh-nguoi-thue">@initials</div>
                                    <div>
                                        <div class="ten-nguoi-thue">@tenNguoi</div>
                                        <div class="han-hop-dong">
                                            @(!string.IsNullOrEmpty(hanHD) ? $"Hợp đồng đến: {hanHD}" : "Hợp đồng đang hiệu lực")
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div style="height:46px;"></div>
                            }

                            <!-- Manager: CHỈ 2 nút, KHÔNG có Sửa / Xóa -->
                            <div class="hang-nut-thao-tac">
                                <button class="nut-xem-chi-tiet"
                                        onclick="moModalChiTiet(this.closest('.phong-item').dataset.idPhong, this.closest('.phong-item').dataset.soPhong)">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </button>
                                <button class="nut-hop-dong"
                                        onclick="moModalHopDong(this.closest('.phong-item').dataset.idPhong, this.closest('.phong-item').dataset.soPhong)">
                                    <i class="fas fa-file-contract"></i> Hợp đồng
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div><!-- / LƯỚI DANH SÁCH PHÒNG -->

        </main><!-- / NỘI DUNG TRANG -->
    </div><!-- / KHU VỰC CHÍNH -->
    <!-- ============================================================
     MODAL 1: CHI TIẾT PHÒNG (Người ở + Cơ sở vật chất)
    ============================================================ -->
    <div class="lop-phu-modal" id="modal-chi-tiet-phong"
         onclick="if(event.target.id === 'modal-chi-tiet-phong') dongModal('modal-chi-tiet-phong')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3>
                    <i class="fas fa-door-open" style="color:var(--mau-chu-de);"></i>
                    <span id="ct-ten-phong">Chi tiết phòng</span>
                </h3>
                <button class="nut-dong-modal" type="button" onclick="dongModal('modal-chi-tiet-phong')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="than-modal" id="ct-noi-dung">
                <div class="loading-spinner">
                    <div class="spinner"></div> Đang tải...
                </div>
            </div>

            <div class="chan-modal">
                <button type="button" class="nut-hanh-dong-modal trang" onclick="dongModal('modal-chi-tiet-phong')">
                    <i class="fas fa-times"></i> Đóng
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================
     MODAL 2: HỢP ĐỒNG CƠ BẢN (Chỉ thông tin giới hạn)
    ============================================================ -->
    <div class="lop-phu-modal" id="modal-hop-dong"
         onclick="if(event.target.id === 'modal-hop-dong') dongModal('modal-hop-dong')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3>
                    <i class="fas fa-file-contract" style="color:#059669;"></i>
                    <span id="hd-ten-phong">Hợp đồng phòng</span>
                </h3>
                <button class="nut-dong-modal" type="button" onclick="dongModal('modal-hop-dong')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="than-modal" id="hd-noi-dung">
                <div class="loading-spinner">
                    <div class="spinner"></div> Đang tải...
                </div>
            </div>

            <div class="chan-modal">
                <button type="button" class="nut-hanh-dong-modal trang" onclick="dongModal('modal-hop-dong')">
                    <i class="fas fa-times"></i> Đóng
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================
     MODAL: ĐỔI MẬT KHẨU
    ============================================================ -->
    <div class="lop-phu-modal" id="modal-doi-mat-khau"
         onclick="if(event.target.id==='modal-doi-mat-khau') dongModal('modal-doi-mat-khau')">
        <div class="hop-modal" style="max-width:440px;">
            <div class="tieu-de-modal">
                <h3><i class="fas fa-key" style="color:var(--mau-chu-de);margin-right:8px;"></i>Đổi mật khẩu</h3>
                <button class="nut-dong-modal" type="button" onclick="dongModal('modal-doi-mat-khau')">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form method="post" asp-page-handler="ChangePassword" id="form-doi-mat-khau">
                @Html.AntiForgeryToken()
                <div class="than-modal">
                    <div class="mk-alert" id="doi-mk-alert"></div>
                    <div class="nhom-truong-nhap-mk">
                        <label class="nhan-truong-nhap-mk">Mật khẩu hiện tại *</label>
                        <div class="mk-input-wrap">
                            <input class="truong-nhap-mk" type="password" id="old-password" name="oldPassword" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                            <button type="button" class="mk-eye-btn" onclick="togglePwd('old-password',this)"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>
                    <div class="nhom-truong-nhap-mk">
                        <label class="nhan-truong-nhap-mk">Mật khẩu mới *</label>
                        <div class="mk-input-wrap">
                            <input class="truong-nhap-mk" type="password" id="new-password" name="newPassword" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                            <button type="button" class="mk-eye-btn" onclick="togglePwd('new-password',this)"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>
                    <div class="nhom-truong-nhap-mk">
                        <label class="nhan-truong-nhap-mk">Xác nhận mật khẩu mới *</label>
                        <div class="mk-input-wrap">
                            <input class="truong-nhap-mk" type="password" id="confirm-password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <button type="button" class="mk-eye-btn" onclick="togglePwd('confirm-password',this)"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>
                </div>
                <div class="chan-modal">
                    <button type="submit" class="nut-hanh-dong-modal xanh">
                        <i class="fas fa-save"></i> Cập nhật
                    </button>
                    <button type="button" class="nut-hanh-dong-modal trang" onclick="dongModal('modal-doi-mat-khau')">Hủy</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="alert-success" style="position:fixed;top:20px;right:24px;z-index:9999;
            background:#dcfce7;border:1px solid #86efac;color:#15803d;border-radius:12px;
            padding:12px 20px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,0.1);
            display:flex;align-items:center;gap:8px;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
        <script>setTimeout(function(){ var el = document.getElementById('alert-success'); if(el) el.remove(); }, 4000);</script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="alert-error" style="position:fixed;top:20px;right:24px;z-index:9999;
            background:#fee2e2;border:1px solid #fca5a5;color:#dc2626;border-radius:12px;
            padding:12px 20px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,0.1);
            display:flex;align-items:center;gap:8px;">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
        <script>setTimeout(function(){ var el = document.getElementById('alert-error'); if(el) el.remove(); }, 5000);</script>
    }

    <!-- ============================================================
     SCRIPT
    ============================================================ -->
    <script>
        // ================================================================
        // HELPER: Format tiền
        // ================================================================
        function formatGia(gia) {
        if (gia >= 1000000) return (gia / 1000000).toFixed(1).replace('.0', '') + 'M/th';
        return Number(gia).toLocaleString('vi-VN') + 'đ/th';
        }

        // ================================================================
        // MODAL UTILITIES
        // ================================================================
        function dongModal(idModal) {
        document.getElementById(idModal).classList.remove('hien');
        }

        // ================================================================
        // HANDLER 1: MỞ MODAL CHI TIẾT PHÒNG
        // Gọi GET ?handler=RoomDetail&idPhong=xxx
        // Hiển thị: Danh sách người đang ở + Cơ sở vật chất (MoTa)
        // ================================================================
        function moModalChiTiet(idPhong, soPhong) {
        var modal = document.getElementById('modal-chi-tiet-phong');
        var noiDung = document.getElementById('ct-noi-dung');
        var tieuDe = document.getElementById('ct-ten-phong');

        tieuDe.textContent = 'Chi tiết Phòng ' + soPhong;
        noiDung.innerHTML = '<div class="loading-spinner"><div class="spinner"></div> Đang tải...</div>';
        modal.classList.add('hien');

        fetch('?handler=RoomDetail&idPhong=' + idPhong, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
        if (data.error) {
        noiDung.innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">' + data.error + '</p>';
        return;
        }
        var p = data.phong;
        var html = '';

        // ── Thông tin cơ bản phòng ──
        html += '<div class="luoi-thong-tin-modal">';
        html += '  <div class="muc-thong-tin"><div class="nhan">Số phòng</div><div class="gia-tri">Phòng ' + p.soPhong + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Khu</div><div class="gia-tri">Khu ' + p.khu + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Diện tích</div><div class="gia-tri">' + p.dienTich + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Số người tối đa</div><div class="gia-tri">' + p.soLuongToiDa + ' người</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Giá thuê</div><div class="gia-tri" style="color:var(--mau-chu-de);">' + formatGia(p.giaPhong) + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Trạng thái</div><div class="gia-tri">' + p.trangThai + '</div></div>';
        html += '</div>';

        // ── Cơ sở vật chất (MoTa) ──
        html += '<div class="tieu-de-section"><i class="fas fa-couch" style="margin-right:6px;"></i>Cơ sở vật chất</div>';
        html += '<div style="background:var(--mau-nen);border-radius:10px;padding:14px 16px;font-size:13px;color:var(--mau-chu);line-height:1.7;">';
        html += p.coSoVatChat;
        html += '</div>';

        // ── Danh sách người đang ở ──
        html += '<div class="tieu-de-section" style="margin-top:20px;"><i class="fas fa-users" style="margin-right:6px;"></i>Người đang ở</div>';
        if (!data.danhSachNguoiO || data.danhSachNguoiO.length === 0) {
        html += '<div class="trong-phong-empty"><i class="fas fa-bed" style="font-size:24px;margin-bottom:8px;display:block;"></i>Phòng đang trống</div>';
        } else {
        data.danhSachNguoiO.forEach(function(nguoi) {
        var hoTen = nguoi.hoTen || '?';
        var initial = hoTen.trim().length > 0 ? hoTen.trim()[0].toUpperCase() : '?';
        html += '<div class="item-nguoi-o">';
        html += '  <div class="avatar">' + initial + '</div>';
        html += '  <div class="info-nguoi">';
        html += '    <div class="ten">' + hoTen;
        if (nguoi.isChinhChu) html += '<span class="tag-chinh-chu">Chính chủ</span>';
        html += '    </div>';
        html += '    <div class="sub">' + (nguoi.quanHe || 'Người ở') + (nguoi.soDienThoai ? ' · ' + nguoi.soDienThoai : '') + '</div>';
        html += '  </div>';
        html += '</div>';
        });
        }

        // ── Lịch sử người ở (chỉ hiển thị khi có dữ liệu) ──
        if (data.lichSuNguoiO && data.lichSuNguoiO.length > 0) {
        html += '<div class="tieu-de-section" style="margin-top:20px;"><i class="fas fa-history" style="margin-right:6px;"></i>Lịch sử người ở</div>';
        html += '<div style="background:var(--mau-trang);border:1px solid var(--mau-vien);border-radius:10px;overflow:hidden;">';
        html += '<table class="bang-lich-su">';
        html += '<thead><tr>';
        html += '<th>Họ tên</th><th>Quan hệ</th><th>Ngày vào</th><th>Ngày ra</th>';
        html += '</tr></thead><tbody>';
        data.lichSuNguoiO.forEach(function(nguoi) {
        html += '<tr>';
        html += '<td>' + (nguoi.hoTen || '—');
        if (nguoi.isChinhChu) html += '<span class="tag-chinh-chu" style="margin-left:5px;">Chính chủ</span>';
        html += '</td>';
        html += '<td>' + (nguoi.quanHe || '—') + '</td>';
        html += '<td>' + (nguoi.ngayVao || '—') + '</td>';
        html += '<td>' + (nguoi.ngayRa  || '—') + '</td>';
        html += '</tr>';
        });
        html += '</tbody></table></div>';
        }

        noiDung.innerHTML = html;
        })
        .catch(function() {
        noiDung.innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">Lỗi kết nối. Vui lòng thử lại.</p>';
        });
        }

        // ================================================================
        // HANDLER 2: MỞ MODAL HỢP ĐỒNG CƠ BẢN
        // Gọi GET ?handler=BasicContract&idPhong=xxx
        // Chỉ hiển thị: Tên người thuê, Ngày HH, Tiền cọc, Giá thuê
        // ẨN: Ghi chú, điều khoản, thông tin thanh lý
        // ================================================================
        function moModalHopDong(idPhong, soPhong) {
        var modal = document.getElementById('modal-hop-dong');
        var noiDung = document.getElementById('hd-noi-dung');
        var tieuDe = document.getElementById('hd-ten-phong');

        tieuDe.textContent = 'Hợp đồng Phòng ' + soPhong;
        noiDung.innerHTML = '<div class="loading-spinner"><div class="spinner"></div> Đang tải...</div>';
        modal.classList.add('hien');

        fetch('?handler=BasicContract&idPhong=' + idPhong, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
        if (data.error) {
        noiDung.innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">' + data.error + '</p>';
        return;
        }
        if (!data.coHopDong) {
        noiDung.innerHTML = '<div class="trong-phong-empty" style="padding:32px 20px;"><i class="fas fa-file-slash" style="font-size:28px;margin-bottom:10px;display:block;"></i>Phòng chưa có hợp đồng hiệu lực</div>';
        return;
        }
        var html = '';

        // Ô nổi bật: Người thuê
        html += '<div class="hop-dong-info-box">';
        html += '  <div class="label">Người thuê chính</div>';
        html += '  <div class="value">' + data.tenNguoiThue + '</div>';
        html += '  <div class="sub">' + (data.sdtNguoiThue || '') + '</div>';
        html += '</div>';

        // Grid thông tin cơ bản
        html += '<div class="luoi-thong-tin-modal">';
        html += '  <div class="muc-thong-tin"><div class="nhan">Ngày bắt đầu</div><div class="gia-tri">' + data.ngayBatDau + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Ngày hết hạn</div><div class="gia-tri">' + data.ngayKetThuc + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Giá thuê / tháng</div><div class="gia-tri" style="color:var(--mau-chu-de);">' + formatGia(data.giaThue) + '</div></div>';
        html += '  <div class="muc-thong-tin"><div class="nhan">Tiền cọc</div><div class="gia-tri">' + Number(data.tienCoc).toLocaleString('vi-VN') + 'đ</div></div>';
        html += '</div>';

        // Lưu ý vai trò
        html += '<div style="background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:10px 14px;font-size:12px;color:#92400e;display:flex;gap:8px;align-items:center;">';
        html += '  <i class="fas fa-info-circle"></i>';
        html += '  <span>Bạn chỉ xem được thông tin cơ bản của hợp đồng. Các điều khoản chi tiết do Quản trị viên quản lý.</span>';
        html += '</div>';

        noiDung.innerHTML = html;
        })
        .catch(function() {
        noiDung.innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">Lỗi kết nối. Vui lòng thử lại.</p>';
        });
        }

        // ================================================================
        // LỌC THEO TRẠNG THÁI
        // ================================================================
        function locTheoTrangThai(trangThai) {
        document.querySelectorAll('.nut-loc').forEach(function(b) { b.classList.remove('dang-chon-loc'); });
        var idNut = 'nut-loc-' + trangThai;
        var nutChon = document.getElementById(idNut);
        if (nutChon) nutChon.classList.add('dang-chon-loc');

        var items = document.querySelectorAll('.phong-item');
        var count = 0;
        items.forEach(function(item) {
        var tt = item.dataset.trangThai;
        var hien = (trangThai === 'tat-ca' || tt === trangThai);
        item.style.display = hien ? '' : 'none';
        if (hien) count++;
        });
        document.getElementById('so-ket-qua').textContent = count;
        }

        // ================================================================
        // TÌM KIẾM
        // ================================================================
        function timKiemPhong(tuKhoa) {
        tuKhoa = tuKhoa.toLowerCase().trim();
        var items = document.querySelectorAll('.phong-item');
        var count = 0;
        items.forEach(function(item) {
        var soPhong = (item.dataset.soPhong || '').toLowerCase();
        var nguoiThue = (item.dataset.nguoiThue || '').toLowerCase();
        var hien = soPhong.includes(tuKhoa) || nguoiThue.includes(tuKhoa);
        item.style.display = hien ? '' : 'none';
        if (hien) count++;
        });
        document.getElementById('so-ket-qua').textContent = count;
        }

        function timKiemToanCuc(tuKhoa) {
        document.getElementById('o-nhap-tim-kiem').value = tuKhoa;
        timKiemPhong(tuKhoa);
        }

        // ================================================================
        // SẮP XẾP
        // ================================================================
        function sapXepPhong(kieuSapXep) {
        var luoi = document.getElementById('luoi-danh-sach-phong');
        var items = Array.from(luoi.querySelectorAll('.phong-item'));
        items.sort(function(a, b) {
        if (kieuSapXep === 'so-phong-tang') return (a.dataset.soPhong || '').localeCompare(b.dataset.soPhong || '', 'vi', { numeric: true });
        if (kieuSapXep === 'so-phong-giam') return (b.dataset.soPhong || '').localeCompare(a.dataset.soPhong || '', 'vi', { numeric: true });
        if (kieuSapXep === 'gia-tang') return Number(a.dataset.gia) - Number(b.dataset.gia);
        if (kieuSapXep === 'gia-giam') return Number(b.dataset.gia) - Number(a.dataset.gia);
        return 0;
        });
        items.forEach(function(item) { luoi.appendChild(item); });
        }

        // ================================================================
        // DROPDOWN HEADER MANAGER
        // ================================================================
        function mgrToggleMenu() {
        var dd = document.getElementById('mgrDropdown');
        var chev = document.getElementById('mgrChevron');
        dd.classList.toggle('show');
        chev.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : 'rotate(0deg)';
        }
        document.addEventListener('click', function(e) {
        var wrap = document.getElementById('mgrHeaderWrap');
        if (wrap && !wrap.contains(e.target)) {
        var dd = document.getElementById('mgrDropdown');
        var chev = document.getElementById('mgrChevron');
        if (dd) dd.classList.remove('show');
        if (chev) chev.style.transform = 'rotate(0deg)';
        }
        });
        function mgrMoDoiMatKhau() {
        var dd = document.getElementById('mgrDropdown');
        if (dd) dd.classList.remove('show');
        document.getElementById('modal-doi-mat-khau').classList.add('hien');
        }
        function mgrXacNhanDangXuat() {
        if (confirm('Bạn có chắc muốn đăng xuất không?')) {
        window.location.href = '/Account/Index';
        }
        }
        function moThongTinAdmin() { mgrToggleMenu(); }

        // ================================================================
        // TOGGLE PASSWORD
        // ================================================================
        function togglePwd(inputId, btn) {
        var inp = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'fas fa-eye-slash';
        } else {
        inp.type = 'password';
        icon.className = 'fas fa-eye';
        }
        }

        // ================================================================
        // SIDEBAR
        // ================================================================
        function dongMoSidebar() {
        document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
        }

        // ================================================================
        // ĐIỀU HƯỚNG
        // ================================================================
        function chuyenTrang(tenTrang, phanTu) {
        document.querySelectorAll('.menu-item').forEach(function(m) { m.classList.remove('dang-chon'); });
        phanTu.classList.add('dang-chon');
        var bangDieuHuong = {
        'trang-chu':          '/Manager/Manager',
        'quan-ly-phong':      '/Manager/QuanLyPhong',
        'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
        'hoa-don':            '/Manager/HoaDon',
        'su-co-bao-tri':      '/Manager/SuCoBaoTri',
        'bao-cao':            '/Manager/ThongKe',
        'cai-dat':            '/Manager/CaiDat',
        'phong-cua-toi':   '/KhachThue/KhachThue',
        };
        var duongDan = bangDieuHuong[tenTrang];
        if (duongDan) window.location.href = duongDan;
        }

        function moThongBao() { alert('Mở danh sách thông báo'); }

        // ================================================================
        // ĐỒNG BỘ BADGE SIDEBAR
        // ================================================================
        (function loadBadgeSidebar() {
        fetch('/Api/BadgeCounts')
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(data) {
        if (!data) return;
        var badgeDV = document.getElementById('badge-dichvu');
        var badgeSC = document.getElementById('badge-suco');
        if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
        if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
        })
        .catch(function(e) { console.warn('Không thể load badge sidebar:', e); });
        })();
    </script>

</body>
</html>
