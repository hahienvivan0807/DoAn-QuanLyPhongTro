    </div>


    <!-- ============================================================
     MODAL: THÊM / CHỈNH SỬA PHÒNG
     ⚙️ BACKEND: POST /api/phong (thêm mới) hoặc PUT /api/phong/{id} (chỉnh sửa)
============================================================ -->
    <div class="lop-che-modal" id="modal-them-chinh-sua-phong" onclick="dongModalNeuNhanNgoai(event,'modal-them-chinh-sua-phong')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3 id="tieu-de-modal-phong">
                    <i class="fas fa-door-open" style="color:var(--mau-chu-de);margin-right:8px;"></i>Thêm phòng mới
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-them-chinh-sua-phong')">✕</button>
            </div>

            <div class="hang-form-modal">
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Số phòng *</label>
                    <!-- ⚙️ BACKEND: Validate số phòng không trùng -->
                    <input class="truong-nhap" type="text" id="nhap-so-phong" placeholder="VD: 101, 202..." />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">SĐT Người thuê *</label>
                    <select class="truong-nhap" id="nhap-loai-phong">
                        <option value="">-- Chọn loại --</option>
                        <option value="phong-don">Phòng đơn</option>
                        <option value="phong-doi">Phòng đôi</option>
                        <option value="phong-cao-cap">Phòng cao cấp</option>
                    </select>
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Diện tích (m²)</label>
                    <input class="truong-nhap" type="number" id="nhap-dien-tich" placeholder="VD: 15" />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Giá thuê (đồng/tháng) *</label>
                    <!-- ⚙️ BACKEND: Lưu vào bảng phong -->
                    <input class="truong-nhap" type="number" id="nhap-gia-thue" placeholder="VD: 3500000" />
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Tầng</label>
                    <select class="truong-nhap" id="nhap-tang">
                        <option value="1">Tầng 1</option>
                        <option value="2">Tầng 2</option>
                        <option value="3">Tầng 3</option>
                        <option value="4">Tầng 4</option>
                    </select>
                </div>
                <div class="nhom-truong-nhap">
                    <label class="nhan-truong-nhap">Trạng thái</label>
                    <select class="truong-nhap" id="nhap-trang-thai">
                        <option value="con-trong">Còn trống</option>
                        <option value="dang-thue">Đang thuê</option>
                        <option value="bao-tri">Bảo trì</option>
                    </select>
                </div>
            </div>

            <div class="nhom-truong-nhap" style="margin-top:14px;">
                <label class="nhan-truong-nhap">Ghi chú / Tiện nghi</label>
                <textarea class="truong-nhap" rows="2" id="nhap-ghi-chu" placeholder="Máy lạnh, WC riêng, ban công..."></textarea>
            </div>

            <div class="nhom-nut-modal">
                <button class="nut-huy" onclick="dongModal('modal-them-chinh-sua-phong')">Hủy</button>
                <!-- ⚙️ BACKEND: Gọi API lưu phòng -->
                <button class="nut-luu" onclick="luuPhong()">
                    <i class="fas fa-save"></i> Lưu phòng
                </button>
            </div>
        </div>
    </div>


    <!-- ============================================================
     JAVASCRIPT – XỬ LÝ TƯƠNG TÁC
============================================================ -->
    <script>
            // ========================================================
            // BIẾN TRẠNG THÁI TOÀN CỤC
            // ========================================================
            let trangThaiLocHienTai = 'tat-ca';   // Bộ lọc đang được chọn
            let tuKhoaTimKiemHienTai = '';         // Từ khóa tìm kiếm hiện tại
            let phongDangChon = null;              // Phòng đang xem chi tiết

            // ========================================================
            // HÀM: ĐÓNG / MỞ SIDEBAR (mobile)
            // ========================================================
            function dongMoSidebar() {
              document.getElementById('thanh-sidebar').classList.toggle('mo');
            }

            // ========================================================
            // HÀM: CHUYỂN TRANG (điều hướng Razor Pages)
            // ========================================================
            function chuyenTrang(tenTrang, phanTu) {
              document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
              phanTu.classList.add('dang-chon');
              const bangDieuHuong = {
                'trang-chu':           '/Manager/Manager',
                'quan-ly-phong':       '/ChiTietPhong',
                'quan-ly-nguoi-thue':  '/Manager/QuanLyDichVu',
                'hoa-don':             '/HoaDon',
                'su-co-bao-tri':       '/SuCoBaoTri',
                'bao-cao':             '/BaoCao',
                'cai-dat':             '/CaiDat',
              };
              const duongDan = bangDieuHuong[tenTrang];
              if (duongDan) window.location.href = duongDan;
            }

            // ========================================================
            // HÀM: LỌC PHÒNG THEO TRẠNG THÁI
            // (Gọi khi bấm nút lọc hoặc bấm thẻ thống kê)
            // ========================================================
            function locTheoTrangThai(trangThai) {
              trangThaiLocHienTai = trangThai;

              // Cập nhật nút lọc đang được chọn
              document.querySelectorAll('.nut-loc').forEach(nut => nut.classList.remove('dang-chon-loc'));
              const nutTuongUng = document.getElementById('nut-loc-' + trangThai);
              if (nutTuongUng) nutTuongUng.classList.add('dang-chon-loc');

              // Áp dụng lọc kết hợp với tìm kiếm
              apDungLocVaTimKiem();
            }

            // ========================================================
            // HÀM: TÌM KIẾM PHÒNG
            // (Gọi khi người dùng gõ vào ô tìm kiếm)
            // ========================================================
            function timKiemPhong(tuKhoa) {
              tuKhoaTimKiemHienTai = tuKhoa.toLowerCase().trim();
              apDungLocVaTimKiem();
            }

            // ========================================================
            // HÀM: ÁP DỤNG LỌC + TÌM KIẾM (xử lý chính)
            // Kết hợp cả bộ lọc trạng thái và từ khóa tìm kiếm
            // ========================================================
            function apDungLocVaTimKiem() {
              const tatCaPhong = document.querySelectorAll('.phong-item');
              let soHienThi = 0;

              tatCaPhong.forEach(phong => {
                const trangThaiPhong = phong.dataset.trangThai;        // vd: "dang-thue"
                const soPhong       = phong.dataset.soPhong.toLowerCase(); // vd: "101"
                const nguoiThue     = (phong.dataset.nguoiThue || '').toLowerCase();

                // Kiểm tra điều kiện lọc trạng thái
                const hopLoc = (trangThaiLocHienTai === 'tat-ca') || (trangThaiPhong === trangThaiLocHienTai);

                // Kiểm tra điều kiện tìm kiếm (theo số phòng hoặc tên người thuê)
                const hopTimKiem = (tuKhoaTimKiemHienTai === '')
                  || soPhong.includes(tuKhoaTimKiemHienTai)
                  || nguoiThue.includes(tuKhoaTimKiemHienTai);

                // Hiển thị hoặc ẩn card phòng
                if (hopLoc && hopTimKiem) {
                  phong.style.display = '';
                  soHienThi++;
                } else {
                  phong.style.display = 'none';
                }
              });

              // Cập nhật dòng kết quả tìm kiếm
              document.getElementById('so-ket-qua').textContent = soHienThi;

              // Hiện thông báo "không có kết quả" nếu cần
              const thongBao = document.getElementById('thong-bao-khong-co-ket-qua');
              thongBao.style.display = (soHienThi === 0) ? 'flex' : 'none';
            }

            // ========================================================
            // HÀM: SẮP XẾP PHÒNG
            // (Gọi khi thay đổi dropdown sắp xếp)
            // ========================================================
            function sapXepPhong(kieuSapXep) {
              const luoi = document.getElementById('luoi-danh-sach-phong');
              const danhSachPhong = Array.from(luoi.querySelectorAll('.phong-item'));

              danhSachPhong.sort((a, b) => {
                const soA  = parseInt(a.dataset.soPhong);
                const soB  = parseInt(b.dataset.soPhong);
                const giaA = parseInt(a.dataset.gia);
                const giaB = parseInt(b.dataset.gia);

                if (kieuSapXep === 'so-phong-tang') return soA - soB;
                if (kieuSapXep === 'so-phong-giam') return soB - soA;
                if (kieuSapXep === 'gia-tang')      return giaA - giaB;
                if (kieuSapXep === 'gia-giam')      return giaB - giaA;
                return 0;
              });

              // Chèn lại các card vào lưới theo thứ tự mới
              danhSachPhong.forEach(phong => luoi.appendChild(phong));
            }

            // ========================================================
            // HÀM: XEM CHI TIẾT PHÒNG
            // (Gọi khi click vào card phòng hoặc nút "Xem chi tiết")
            // ========================================================
            function xemChiTietPhong(phanTuPhong) {
              phongDangChon = phanTuPhong;

              // Lấy dữ liệu từ data attributes của card
              const soPhong   = phanTuPhong.dataset.soPhong;
              const trangThai = phanTuPhong.dataset.trangThai;
              const gia       = parseInt(phanTuPhong.dataset.gia);
              const nguoiThue = phanTuPhong.dataset.nguoiThue || 'Chưa có người thuê';

              // ⚙️ BACKEND: Gọi GET /api/phong/{soPhong} để lấy dữ liệu đầy đủ

              // Điền thông tin vào modal
              document.getElementById('ct-ten-phong').textContent    = 'Phòng ' + soPhong;
              document.getElementById('ct-gia-phong').textContent    = formatGia(gia) + '/tháng';
              document.getElementById('ct-nguoi-thue').textContent   = nguoiThue;
              document.getElementById('ct-trang-thai').textContent   = formatTrangThai(trangThai);

              // Lấy thêm thông tin từ các element trong card
              const thongTinItems = phanTuPhong.querySelectorAll('.thong-tin-nhap');
              if (thongTinItems[0]) document.getElementById('ct-dien-tich').textContent = thongTinItems[0].textContent.trim();
              if (thongTinItems[1]) document.getElementById('ct-tang').textContent      = thongTinItems[1].textContent.trim();
              if (thongTinItems[2]) document.getElementById('ct-loai-phong').textContent = thongTinItems[2].textContent.trim();

              // Cập nhật badge trạng thái
              const badge = document.getElementById('badge-ct-trang-thai');
              badge.className = 'badge-trang-thai ' + trangThai;
              badge.textContent = '● ' + formatTrangThai(trangThai);

              // Hiện modal
              document.getElementById('modal-chi-tiet-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: MỞ MODAL THÊM PHÒNG MỚI
            // ========================================================
            function moModalThemPhong() {
              // Đặt lại tiêu đề modal về "Thêm mới"
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-door-open" style="color:var(--mau-chu-de);margin-right:8px;"></i>Thêm phòng mới';
              // Xóa dữ liệu form cũ
              document.getElementById('nhap-so-phong').value  = '';
              document.getElementById('nhap-gia-thue').value  = '';
              document.getElementById('nhap-dien-tich').value = '';
              document.getElementById('nhap-ghi-chu').value   = '';
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: MỞ MODAL CHỈNH SỬA PHÒNG
            // (Gọi khi bấm nút chỉnh sửa trên card hoặc trong modal chi tiết)
            // ========================================================
            function chinhSuaPhong(event, soPhong) {
              event.stopPropagation(); // Ngăn sự kiện click lan lên card

              // ⚙️ BACKEND: GET /api/phong/{soPhong} để load dữ liệu điền vào form
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-pen" style="color:var(--mau-chu-de);margin-right:8px;"></i>Chỉnh sửa phòng ' + soPhong;
              document.getElementById('nhap-so-phong').value = soPhong;
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
              dongModal('modal-chi-tiet-phong');
            }

            function chinhSuaPhongTuChiTiet() {
              if (!phongDangChon) return;
              dongModal('modal-chi-tiet-phong');
              const soPhong = phongDangChon.dataset.soPhong;
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-pen" style="color:var(--mau-chu-de);margin-right:8px;"></i>Chỉnh sửa phòng ' + soPhong;
              document.getElementById('nhap-so-phong').value = soPhong;
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: LƯU PHÒNG (thêm mới hoặc cập nhật)
            // ⚙️ BACKEND: POST hoặc PUT /api/phong
            // ========================================================
            function luuPhong() {
              const soPhong = document.getElementById('nhap-so-phong').value.trim();
              const giaThue = document.getElementById('nhap-gia-thue').value.trim();

              if (!soPhong || !giaThue) {
                alert('Vui lòng điền đầy đủ thông tin bắt buộc (*)!');
                return;
              }
              // ⚙️ BACKEND: fetch('/api/phong', { method:'POST', body: JSON.stringify({...}) })
              alert(`Đã lưu phòng ${soPhong} thành công!\n(Kết nối backend để lưu vào database)`);
              dongModal('modal-them-chinh-sua-phong');
            }

            // ========================================================
            // HÀM: XÓA PHÒNG
            // ⚙️ BACKEND: DELETE /api/phong/{soPhong}
            // ========================================================
            function xoaPhong(event, soPhong) {
              event.stopPropagation(); // Ngăn click lan lên card
              const xacNhan = confirm(`Bạn có chắc muốn xóa phòng ${soPhong} không?\nHành động này không thể hoàn tác!`);
              if (xacNhan) {
                // ⚙️ BACKEND: fetch(`/api/phong/${soPhong}`, { method: 'DELETE' })
                alert(`Đã xóa phòng ${soPhong}! (Kết nối backend để xóa thật)`);
              }
            }

            function xoaPhongTuChiTiet() {
              if (!phongDangChon) return;
              const soPhong = phongDangChon.dataset.soPhong;
              dongModal('modal-chi-tiet-phong');
              const xacNhan = confirm(`Bạn có chắc muốn xóa phòng ${soPhong} không?`);
              if (xacNhan) {
                alert(`Đã xóa phòng ${soPhong}! (Kết nối backend để xóa thật)`);
              }
            }

            // ========================================================
            // HÀM: TẠO HÓA ĐƠN TỪ CHI TIẾT PHÒNG
            // ⚙️ BACKEND: Chuyển trang tạo hóa đơn với soPhong được điền sẵn
            // ========================================================
            function taoHoaDon() {
              if (!phongDangChon) return;
              const soPhong = phongDangChon.dataset.soPhong;
              // ⚙️ BACKEND: window.location.href = '/HoaDon?taoMoi=true&soPhong=' + soPhong;
              alert(`Chuyển đến trang tạo hóa đơn cho phòng ${soPhong}`);
              dongModal('modal-chi-tiet-phong');
            }

            // ========================================================
            // HÀM: ĐÓNG MODAL
            // ========================================================
            function dongModal(idModal) {
              document.getElementById(idModal).classList.remove('hien');
            }

            function dongModalNeuNhanNgoai(event, idModal) {
              if (event.target.id === idModal) dongModal(idModal);
            }

            // ========================================================
            // HÀM: TÌM KIẾM TOÀN CỤC (ô tìm kiếm trên header)
            // ========================================================
            function timKiemToanCuc(tuKhoa) {
              // Đồng bộ với ô tìm kiếm trong thanh lọc
              document.getElementById('o-nhap-tim-kiem').value = tuKhoa;
              timKiemPhong(tuKhoa);
            }

            // ========================================================
            // HÀM HỖ TRỢ: FORMAT GIÁ TIỀN
            // ========================================================
            function formatGia(gia) {
              if (gia >= 1000000) return (gia / 1000000).toFixed(1).replace('.0','') + 'M';
              return gia.toLocaleString('vi-VN') + 'đ';
            }

            // ========================================================
            // HÀM HỖ TRỢ: FORMAT TRẠNG THÁI
            // ========================================================
            function formatTrangThai(trangThai) {
              const bangDich = {
                'dang-thue': 'Đang thuê',
                'con-trong': 'Còn trống',
                'bao-tri':   'Bảo trì',
              };
              return bangDich[trangThai] || trangThai;
            }

            // ========================================================
            // CÁC HÀM GIAO DIỆN PHỤ
            // ========================================================
            function moThongBao()     { alert('Mở danh sách thông báo (5 chưa đọc)'); }
            function moMenuAdmin()    { alert('Menu tài khoản: Đổi mật khẩu / Đăng xuất'); }
            function moThongTinAdmin(){ alert('Thông tin quản trị viên'); }

    </script>

</body>
</html>



