    <div class="lop-che-modal" id="modal-chi-tiet-phong" onclick="dongModalNeuNhanNgoai(event,'modal-chi-tiet-phong')">
        <div class="hop-modal-chi-tiet">
            <!-- Ảnh minh họa phòng -->
            <div class="anh-phong-chi-tiet" id="anh-phong-chi-tiet">
                <i class="fas fa-bed icon-lon"></i>
                <span class="badge-trang-thai dang-thue" id="badge-ct-trang-thai">● Đang thuê</span>
            </div>

            <div class="noi-dung-chi-tiet">
                <!-- Tiêu đề + giá -->
                <div class="hang-tieu-de-chi-tiet">
                    <div>
                        <div class="ten-phong-chi-tiet" id="ct-ten-phong">Phòng 101</div>
                        <div style="font-size:13px;color:var(--mau-chu-phu);margin-top:2px;">Mã phòng: P.101</div>
                    </div>
                    <div style="text-align:right;">
                        <div class="gia-phong-chi-tiet" id="ct-gia-phong">3.5M/tháng</div>
                        <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet-phong')" style="margin-top:4px;">✕</button>
                    </div>
                </div>

                <!-- Lưới thông tin chi tiết -->
                <div class="luoi-thong-tin-chi-tiet">
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-expand-arrows-alt"></i> Diện tích</div>
                        <div class="gia-tri" id="ct-dien-tich">18 m²</div>
                    </div>
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-layer-group"></i> Tầng</div>
                        <div class="gia-tri" id="ct-tang">Tầng 1</div>
                    </div>
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-tag"></i> Loại phòng</div>
                        <div class="gia-tri" id="ct-loai-phong">Phòng đôi</div>
                    </div>
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-circle"></i> Trạng thái</div>
                        <div class="gia-tri" id="ct-trang-thai">Đang thuê</div>
                    </div>
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-user"></i> Người thuê</div>
                        <div class="gia-tri" id="ct-nguoi-thue">Nguyễn Văn Bình</div>
                    </div>
                    <div class="o-thong-tin">
                        <div class="nhan"><i class="fas fa-calendar"></i> Hạn hợp đồng</div>
                        <div class="gia-tri" id="ct-han-hop-dong">31/12/2025</div>
                    </div>
                </div>

                <!-- Lịch sử thuê -->
                <div class="tieu-de-phan"><i class="fas fa-history" style="color:var(--mau-chu-de);"></i> Lịch sử thuê phòng</div>
                <div id="ct-lich-su-thue">
                    <!-- ⚙️ BACKEND: Load lịch sử thuê theo soPhong từ DB -->
                    <div class="lich-su-thue-item">
                        <div class="dot"></div>
                        <div>
                            <div class="ten-nguoi">Nguyễn Văn Bình</div>
                            <div class="thoi-gian-thue">01/01/2025 → Hiện tại</div>
                        </div>
                    </div>
                    <div class="lich-su-thue-item">
                        <div class="dot" style="background:#94a3b8;"></div>
                        <div>
                            <div class="ten-nguoi" style="color:var(--mau-chu-phu);">Trần Văn An</div>
                            <div class="thoi-gian-thue">05/2024 → 12/2024</div>
                        </div>
                    </div>
                </div>

                <!-- Nút hành động trong chi tiết -->
                <div class="hang-nut-chi-tiet">
                    <button class="nut-hanh-dong-chinh xanh-duong" onclick="chinhSuaPhongTuChiTiet()">
                        <i class="fas fa-pen"></i> Chỉnh sửa phòng
                    </button>
                    <button class="nut-hanh-dong-chinh xanh" onclick="taoHoaDon()">
                        <i class="fas fa-file-invoice-dollar"></i> Tạo hóa đơn
                    </button>
                    <button class="nut-hanh-dong-chinh do" onclick="xoaPhongTuChiTiet()">
                        <i class="fas fa-trash"></i> Xóa phòng
                    </button>
                </div>
