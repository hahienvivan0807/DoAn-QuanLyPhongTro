@page "/Manager/ChiTietPhong"
@model QuanLyNhaTro.Pages.ChiTietPhongModel
@{
    Layout = null;

    // Helper: map TrangThai DB → CSS class
    string CssClass(string tt) => tt switch
    {
        "Đã thuê" => "dang-thue",
        "Đang sửa" => "bao-tri",
        _ => "con-trong"
    };

    // Helper: map TrangThai DB → CSS class (badge text)
    string BadgeText(string tt) => tt switch
    {
        "Đã thuê" => "● Đang thuê",
        "Đang sửa" => "● Bảo trì",
        _ => "● Còn trống"
    };

    // Helper: format giá
    string FormatGia(decimal gia)
    {
        if (gia >= 1_000_000m)
            return (gia / 1_000_000m).ToString("0.#") + "M/th";
        return gia.ToString("N0") + "đ/th";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Lý Phòng Trọ – Chi Tiết Phòng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
            /* ============================================================
                                                                   BIẾN MÀU & THIẾT LẬP TOÀN CỤC
                                                   ============================================================ */
            :root {
                --mau-sidebar: #0d1b3e;
                --mau-sidebar-dam: #091429;
                --mau-chu-de: #1a56db;
                --mau-chu-de-sang: #3b82f6;
                --mau-nen: #f0f4f8;
                --mau-trang: #ffffff;
                --mau-chu: #1e293b;
                --mau-chu-phu: #64748b;
                --mau-vien: #e2e8f0;
                --mau-xanh-nhat: #eff6ff;
                --mau-xanh-trung: #dbeafe;
                --bong-card: 0 4px 24px rgba(26,86,219,0.10);
                --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
                --mau-xanh-la: #059669;
                --mau-cam: #d97706;
                --mau-do: #dc2626;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ============================================================
                                                                   SIDEBAR
                                                   ============================================================ */
            #thanh-sidebar {
                width: 220px;
                min-width: 220px;
                background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
                display: flex;
                flex-direction: column;
                height: 100vh;
                position: relative;
                z-index: 100;
                box-shadow: 4px 0 24px rgba(0,0,0,0.18);
                overflow-y: auto;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
            }

                #thanh-sidebar.an-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            /* Ẩn nhãn nhóm khi thu gọn */
            .nhan-nhom {
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
            }

            #thanh-sidebar.thu-gon .nhan-nhom {
                opacity: 0;
                max-height: 0;
                padding: 0;
            }

            /* Ẩn text trong menu item khi thu gọn */
            .menu-item span:not(.huy-hieu-menu) {
                transition: opacity 0.2s ease, max-width 0.35s ease;
                max-width: 160px;
                overflow: hidden;
                display: inline-block;
            }

            #thanh-sidebar.thu-gon .menu-item span:not(.huy-hieu-menu) {
                opacity: 0;
                max-width: 0;
            }

            #thanh-sidebar.thu-gon .huy-hieu-menu {
                opacity: 0;
                width: 0;
                overflow: hidden;
                padding: 0;
            }

            /* Căn giữa icon khi thu gọn */
            #thanh-sidebar.thu-gon .menu-item {
                padding: 10px 0;
                justify-content: center;
                border-radius: 10px;
                margin: 2px 8px;
            }

            #thanh-sidebar.thu-gon .admin-sidebar {
                justify-content: center;
            }

            .logo-sidebar {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 28px 20px 24px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .logo-sidebar .bieu-tuong {
                    width: 60px;
                    height: 60px;
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background: transparent;
                }

                    .logo-sidebar .bieu-tuong img {
                        width: 100%;
                        height: 100%;
                        object-fit: contain;
                        border-radius: 10px;
                    }

                .logo-sidebar .ten-logo {
                    color: #fff;
                    line-height: 1.3;
                }

                    .logo-sidebar .ten-logo strong {
                        display: block;
                        font-size: 13px;
                        letter-spacing: 0.5px;
                        line-height: 1;
                        margin-bottom: -1px;
                    }

                    .logo-sidebar .ten-logo span {
                        font-size: 11px;
                        color: rgba(255,255,255,0.45);
                        line-height: 1;
                    }

            .nhan-nhom {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                padding: 18px 20px 6px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 10px 20px;
                color: rgba(255,255,255,0.65);
                cursor: pointer;
                border-radius: 0 30px 30px 0;
                margin: 2px 10px 2px 0;
                transition: all 0.2s;
                font-size: 14px;
                text-decoration: none;
                position: relative;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(59,130,246,0.15);
                    color: #fff;
                }

                .menu-item.dang-chon {
                    background: linear-gradient(90deg, rgba(26,86,219,0.85), rgba(59,130,246,0.6));
                    color: #fff;
                    font-weight: 600;
                    box-shadow: 0 4px 16px rgba(26,86,219,0.3);
                }

                    .menu-item.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 70%;
                        width: 4px;
                        background: #60a5fa;
                        border-radius: 0 4px 4px 0;
                    }

            .huy-hieu-menu {
                margin-left: auto;
                background: #ef4444;
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 1px 7px;
                min-width: 20px;
                text-align: center;
            }

            .admin-sidebar {
                margin-top: auto;
                padding: 18px 16px;
                border-top: 1px solid rgba(255,255,255,0.07);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
            }

                .admin-sidebar .anh-admin {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 16px;
                    border: 2px solid rgba(255,255,255,0.2);
                }

                .admin-sidebar .ten-admin strong {
                    display: block;
                    color: #fff;
                    font-size: 10px;
                    line-height: 1.3;
                    margin: 0;
                }

                .admin-sidebar .ten-admin span {
                    color: rgba(255,255,255,0.45);
                    font-size: 11px;
                    line-height: 1.2;
                    display: block;
                }

            /* ============================================================
                                                           KHU VỰC CHÍNH
                                       ============================================================ */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* ===== HEADER ===== */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid var(--mau-vien);
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                flex-shrink: 0;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .nut-ham-menu {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 20px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: background 0.2s;
            }

                .nut-ham-menu:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-trang {
                font-size: 16px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .duong-dan {
                font-size: 12px;
                color: var(--mau-chu-phu);
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .o-tim-kiem-header {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1px solid var(--mau-vien);
                border-radius: 24px;
                padding: 7px 16px;
                transition: all 0.2s;
            }

                .o-tim-kiem-header:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                }

                .o-tim-kiem-header input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 180px;
                }

                .o-tim-kiem-header i {
                    color: var(--mau-chu-phu);
                    font-size: 13px;
                }

            .nut-thong-bao {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: 50%;
                transition: all 0.2s;
            }

                .nut-thong-bao:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .so-thong-bao {
                position: absolute;
                top: 2px;
                right: 2px;
                background: #ef4444;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            .thong-tin-admin-header {
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                padding: 6px 12px;
                border-radius: 24px;
                transition: background 0.2s;
            }

                .thong-tin-admin-header:hover {
                    background: var(--mau-xanh-nhat);
                }

            .anh-dai-dien {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, #1a56db, #60a5fa);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 14px;
                font-weight: 700;
            }

            /* ============================================================
                                                                   NỘI DUNG TRANG QUẢN LÝ PHÒNG
                                                                ============================================================ */
            #noi-dung-trang {
                flex: 1;
                overflow-y: auto;
                padding: 24px 28px;
            }

            /* --- Dòng tiêu đề trang --- */
            .hang-tieu-de-trang {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
            }

                .hang-tieu-de-trang h2 {
                    font-size: 20px;
                    font-weight: 800;
                }

                .hang-tieu-de-trang p {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            .nut-them-phong {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 10px 20px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
            }

                .nut-them-phong:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            /* --- Hàng thống kê nhanh (3 thẻ nhỏ) --- */
            .hang-thong-ke-nhanh {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-bottom: 22px;
            }

            .the-thong-ke-nhanh {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 18px 20px;
                box-shadow: var(--bong-card);
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid transparent;
                transition: all 0.25s;
                cursor: pointer;
                position: relative;
                overflow: hidden;
            }

                .the-thong-ke-nhanh::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    border-radius: 14px 14px 0 0;
                }

                .the-thong-ke-nhanh:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--bong-card-hover);
                }

                .the-thong-ke-nhanh.tat-ca::before {
                    background: linear-gradient(90deg,#1a56db,#60a5fa);
                }

                .the-thong-ke-nhanh.tat-ca {
                    border-color: #dbeafe;
                }

                    .the-thong-ke-nhanh.tat-ca .bieu-tuong-the {
                        background: #eff6ff;
                        color: #1a56db;
                    }

                .the-thong-ke-nhanh.dang-thue::before {
                    background: linear-gradient(90deg,#059669,#34d399);
                }

                .the-thong-ke-nhanh.dang-thue {
                    border-color: #d1fae5;
                }

                    .the-thong-ke-nhanh.dang-thue .bieu-tuong-the {
                        background: #ecfdf5;
                        color: #059669;
                    }

                .the-thong-ke-nhanh.con-trong::before {
                    background: linear-gradient(90deg,#f59e0b,#fbbf24);
                }

                .the-thong-ke-nhanh.con-trong {
                    border-color: #fef3c7;
                }

                    .the-thong-ke-nhanh.con-trong .bieu-tuong-the {
                        background: #fffbeb;
                        color: #d97706;
                    }

            .bieu-tuong-the {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .so-lieu-the .con-so {
                font-size: 26px;
                font-weight: 800;
                line-height: 1;
            }

            .so-lieu-the .ten-the {
                font-size: 12px;
                color: var(--mau-chu-phu);
                margin-top: 3px;
            }

            /* --- Thanh lọc + tìm kiếm --- */
            .thanh-loc-tim-kiem {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 16px 20px;
                box-shadow: var(--bong-card);
                border: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 20px;
                flex-wrap: wrap;
            }

            /* Ô tìm kiếm trong thanh lọc */
            .o-tim-kiem-phong {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                padding: 9px 14px;
                flex: 1;
                min-width: 200px;
                transition: all 0.2s;
            }

                .o-tim-kiem-phong:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                }

                .o-tim-kiem-phong input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 100%;
                }

            /* Nhóm nút lọc */
            .nhom-nut-loc {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
            }

            .nut-loc {
                border: 1.5px solid var(--mau-vien);
                background: var(--mau-trang);
                color: var(--mau-chu-phu);
                border-radius: 8px;
                padding: 8px 14px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 5px;
            }

                .nut-loc:hover, .nut-loc.dang-chon-loc {
                    background: var(--mau-xanh-nhat);
                    border-color: var(--mau-chu-de-sang);
                    color: var(--mau-chu-de);
                }

            .chon-sap-xep {
                border: 1.5px solid var(--mau-vien);
                background: var(--mau-trang);
                color: var(--mau-chu);
                border-radius: 8px;
                padding: 9px 12px;
                font-size: 12px;
                cursor: pointer;
                outline: none;
            }

            /* Kết quả lọc */
            .ket-qua-loc {
                font-size: 13px;
                color: var(--mau-chu-phu);
                margin-bottom: 16px;
            }

            /* ============================================================
                                                           LƯỚI DANH SÁCH PHÒNG
                                       ============================================================ */
            .luoi-danh-sach-phong {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 20px;
            }

            .phong-item {
                background: var(--mau-trang);
                border-radius: 16px;
                overflow: hidden;
                box-shadow: var(--bong-card);
                border: 1.5px solid var(--mau-vien);
                cursor: pointer;
                transition: all 0.25s;
            }

                .phong-item:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--bong-card-hover);
                    border-color: var(--mau-chu-de-sang);
                }

            .anh-phong {
                height: 110px;
                background: linear-gradient(135deg, #dbeafe, #bfdbfe);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

            .icon-phong {
                font-size: 38px;
                color: #1a56db;
                opacity: 0.7;
            }

            .badge-so-phong {
                position: absolute;
                top: 10px;
                left: 12px;
                background: rgba(255,255,255,0.9);
                color: var(--mau-chu);
                font-size: 11px;
                font-weight: 700;
                border-radius: 6px;
                padding: 3px 8px;
            }

            .badge-trang-thai {
                position: absolute;
                top: 10px;
                right: 12px;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 3px 9px;
            }

                .badge-trang-thai.dang-thue {
                    background: #d1fae5;
                    color: #059669;
                }

                .badge-trang-thai.con-trong {
                    background: #fef3c7;
                    color: #d97706;
                }

                .badge-trang-thai.bao-tri {
                    background: #fee2e2;
                    color: #dc2626;
                }

            .noi-dung-phong {
                padding: 14px 16px 16px;
            }

            .hang-ten-phong {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 8px;
            }

            .ten-phong-item {
                font-size: 15px;
                font-weight: 700;
            }

            .gia-phong-item {
                font-size: 13px;
                font-weight: 700;
                color: var(--mau-chu-de);
            }

            .hang-thong-tin-phong {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-bottom: 10px;
            }

            .thong-tin-nhap {
                font-size: 11px;
                color: var(--mau-chu-phu);
                background: var(--mau-nen);
                border-radius: 6px;
                padding: 3px 8px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .nguoi-thue-hien-tai {
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--mau-xanh-nhat);
                border-radius: 10px;
                padding: 8px 10px;
                margin-bottom: 10px;
            }

            .anh-nguoi-thue {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: linear-gradient(135deg,#1a56db,#60a5fa);
                color: #fff;
                font-size: 13px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .ten-nguoi-thue {
                font-size: 12px;
                font-weight: 600;
            }

            .han-hop-dong {
                font-size: 11px;
                color: var(--mau-chu-phu);
            }

            .hang-nut-thao-tac {
                display: flex;
                gap: 6px;
            }

            .nut-xem-chi-tiet {
                flex: 1;
                background: var(--mau-xanh-nhat);
                border: 1.5px solid var(--mau-xanh-trung);
                color: var(--mau-chu-de);
                border-radius: 8px;
                padding: 7px 0;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                transition: all 0.2s;
            }

                .nut-xem-chi-tiet:hover {
                    background: var(--mau-chu-de);
                    color: #fff;
                    border-color: var(--mau-chu-de);
                }

            .nut-chinh-sua, .nut-xoa {
                width: 34px;
                height: 34px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                transition: all 0.2s;
            }

            .nut-chinh-sua {
                background: #fff;
                color: var(--mau-chu-phu);
            }

                .nut-chinh-sua:hover {
                    background: #fef3c7;
                    border-color: #d97706;
                    color: #d97706;
                }

            .nut-xoa {
                background: #fff;
                color: var(--mau-chu-phu);
            }

                .nut-xoa:hover {
                    background: #fee2e2;
                    border-color: #dc2626;
                    color: #dc2626;
                }

            /* ============================================================
                                                                   MODAL CHI TIẾT PHÒNG
                                                                ============================================================ */
            .lop-phu-modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 1000;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

                .lop-phu-modal.hien {
                    display: flex;
                }

            .hop-modal {
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.25);
                width: 100%;
                max-width: 540px;
                max-height: 90vh;
                overflow-y: auto;
                animation: hienModal 0.25s ease;
            }

            @@keyframes hienModal {
                from {
                    opacity: 0;
                    transform: scale(0.95) translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .tieu-de-modal {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px 24px 16px;
                border-bottom: 1px solid var(--mau-vien);
            }

                .tieu-de-modal h3 {
                    font-size: 16px;
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            .nut-dong-modal {
                background: none;
                border: none;
                font-size: 20px;
                color: var(--mau-chu-phu);
                cursor: pointer;
                padding: 4px;
                border-radius: 6px;
                transition: all 0.2s;
            }

                .nut-dong-modal:hover {
                    background: var(--mau-nen);
                    color: var(--mau-do);
                }

            .than-modal {
                padding: 20px 24px;
            }

            .luoi-thong-tin-chi-tiet {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
                margin-bottom: 16px;
            }

            .muc-thong-tin {
                background: var(--mau-nen);
                border-radius: 10px;
                padding: 12px 14px;
            }

                .muc-thong-tin .nhan {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                    font-weight: 500;
                    margin-bottom: 4px;
                }

                .muc-thong-tin .gia-tri {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--mau-chu);
                }

            .chan-modal {
                display: flex;
                gap: 10px;
                padding: 16px 24px 20px;
                border-top: 1px solid var(--mau-vien);
                flex-wrap: wrap;
            }

            .nut-hanh-dong-modal {
                flex: 1;
                min-width: 100px;
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                transition: all 0.2s;
                border: none;
            }

                .nut-hanh-dong-modal.xanh {
                    background: linear-gradient(135deg,var(--mau-chu-de),var(--mau-chu-de-sang));
                    color: #fff;
                }

                    .nut-hanh-dong-modal.xanh:hover {
                        box-shadow: 0 4px 14px rgba(26,86,219,0.35);
                    }

                .nut-hanh-dong-modal.trang {
                    background: var(--mau-trang);
                    color: var(--mau-chu);
                    border: 1.5px solid var(--mau-vien);
                }

                    .nut-hanh-dong-modal.trang:hover {
                        background: var(--mau-nen);
                    }

                .nut-hanh-dong-modal.do {
                    background: #fee2e2;
                    color: var(--mau-do);
                    border: 1.5px solid #fca5a5;
                }

                    .nut-hanh-dong-modal.do:hover {
                        background: var(--mau-do);
                        color: #fff;
                    }

            /* ============================================================
                                                                   MODAL THÊM / CHỈNH SỬA PHÒNG
                                                                ============================================================ */
            .hop-modal-lon {
                max-width: 520px;
            }

            .hang-form-modal {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
                margin-bottom: 16px;
            }

            .nhom-truong-nhap {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                .nhom-truong-nhap label {
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--mau-chu);
                }

                    .nhom-truong-nhap label .bat-buoc {
                        color: var(--mau-do);
                        margin-left: 2px;
                    }

                .nhom-truong-nhap input,
                .nhom-truong-nhap select,
                .nhom-truong-nhap textarea {
                    border: 1.5px solid var(--mau-vien);
                    border-radius: 8px;
                    padding: 9px 12px;
                    font-size: 13px;
                    outline: none;
                    transition: border-color 0.2s;
                    background: var(--mau-trang);
                    color: var(--mau-chu);
                    font-family: inherit;
                }

                    .nhom-truong-nhap input:focus,
                    .nhom-truong-nhap select:focus,
                    .nhom-truong-nhap textarea:focus {
                        border-color: var(--mau-chu-de-sang);
                    }

                .nhom-truong-nhap textarea {
                    resize: vertical;
                    min-height: 70px;
                }

                .nhom-truong-nhap.rong-day {
                    grid-column: 1 / -1;
                }

            /* ============================================================
                                                                   SCROLLBAR
                                                                ============================================================ */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* ============================================================
                                                                   RESPONSIVE
                                                                ============================================================ */
            @@media (max-width: 1024px) {
                .hang-thong-ke-nhanh {
                    grid-template-columns: 1fr 1fr 1fr;
                }
            }

            @@media (max-width: 768px) {
                #thanh-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

                    #thanh-sidebar.mo {
                        width: 220px;
                        min-width: 220px;
                    }

                .hang-thong-ke-nhanh {
                    grid-template-columns: 1fr;
                }

                .luoi-danh-sach-phong {
                    grid-template-columns: 1fr;
                }

                .hang-form-modal {
                    grid-template-columns: 1fr;
                }

                .luoi-thong-tin-chi-tiet {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <!-- ============================================================
     SIDEBAR – THANH ĐIỀU HƯỚNG
============================================================ -->
    <nav id="thanh-sidebar">

        <!-- Logo + Tên hệ thống -->
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <!-- ===== NHÓM MENU CHÍNH ===== -->
        <div class="nhan-nhom">Tổng quan</div>

        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </div>

        <!-- ===== NHÓM QUẢN LÝ ===== -->
        <div class="nhan-nhom">Quản lý</div>

        <div class="menu-item dang-chon" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i>
            <span>Quản lý phòng trọ</span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i>
            <span>Quản lý dịch vụ và tiện ích</span>
            @if (Model.SoDonDVChoXuLy > 0)
            {
                <span class="huy-hieu-menu">@Model.SoDonDVChoXuLy</span>
            }
        </div>

        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i>
            <span>Hóa đơn &amp; Thu tiền</span>
        </div>

        <!-- ===== NHÓM HỖ TRỢ ===== -->
        <div class="nhan-nhom">Hỗ trợ</div>

        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i>
            <span>Sự cố / Bảo trì</span>
            @if (Model.SoDonBaoTriChoXuLy > 0)
            {
                <span class="huy-hieu-menu">@Model.SoDonBaoTriChoXuLy</span>
            }
        </div>

        <div class="menu-item" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i>
            <span>Thống kê &amp; Báo cáo</span>
        </div>

        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i>
            <span>Cài đặt hệ thống</span>
        </div>

        <!-- Thông tin admin dưới đáy sidebar -->
        <div class="admin-sidebar" onclick="moThongTinAdmin()">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
                {
                    <img src="@Model.CurrentUser.Avatar" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    @(Model.CurrentUser?.FullName?.Length > 0 ? Model.CurrentUser.FullName[0].ToString().ToUpper() : "A")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
                <span>@(Model.CurrentUser?.Roles ?? "Quản trị viên")</span>
            </div>
        </div>

    </nav><!-- / SIDEBAR -->
    <!-- ============================================================
     KHU VỰC CHÍNH
============================================================ -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Quản Lý Phòng Trọ</div>
                    <div class="duong-dan">Trang chủ / Quản lý phòng trọ</div>
                </div>
            </div>
            <div class="header-phai">
                <div class="o-tim-kiem-header">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm phòng, người thuê..." oninput="timKiemToanCuc(this.value)" />
                </div>
                <button class="nut-thong-bao" onclick="moThongBao()">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>
                <div class="thong-tin-admin-header" onclick="moMenuAdmin()">
                    <div class="anh-dai-dien">@(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")</div>
                    <div>
                        <div style="font-size:13px;font-weight:600;">@(Model.CurrentUser?.FullName ?? "Admin")</div>
                        <div style="font-size:11px;color:var(--mau-chu-phu);">@(Model.CurrentUser?.Roles ?? "Quản trị viên")</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header><!-- / HEADER -->
        <!-- NỘI DUNG TRANG -->
        <main id="noi-dung-trang">

            <!-- Tiêu đề trang + nút thêm phòng -->
            <div class="hang-tieu-de-trang">
                <div>
                    <h2>Danh Sách Phòng Trọ 🏠</h2>
                    <p>Quản lý toàn bộ phòng trọ – xem, lọc và tìm kiếm nhanh chóng</p>
                </div>
                <button class="nut-them-phong" onclick="moModalThemPhong()">
                    <i class="fas fa-plus"></i> Thêm phòng mới
                </button>
            </div>

            <!-- ========================================
         HÀNG THỐNG KÊ NHANH (3 thẻ)
    ======================================== -->
            <div class="hang-thong-ke-nhanh">

                <!-- Thẻ 1: Tổng số phòng -->
                <div class="the-thong-ke-nhanh tat-ca" onclick="locTheoTrangThai('tat-ca')">
                    <div class="bieu-tuong-the"><i class="fas fa-building"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-tong-phong">@Model.TongSoPhong</div>
                        <div class="ten-the">Tổng số phòng</div>
                    </div>
                </div>

                <!-- Thẻ 2: Phòng đang thuê -->
                <div class="the-thong-ke-nhanh dang-thue" onclick="locTheoTrangThai('dang-thue')">
                    <div class="bieu-tuong-the"><i class="fas fa-user-check"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-phong-dang-thue">@Model.SoPhongDangThue</div>
                        <div class="ten-the">Đang được thuê</div>
                    </div>
                </div>

                <!-- Thẻ 3: Phòng còn trống -->
                <div class="the-thong-ke-nhanh con-trong" onclick="locTheoTrangThai('con-trong')">
                    <div class="bieu-tuong-the"><i class="fas fa-door-closed"></i></div>
                    <div class="so-lieu-the">
                        <div class="con-so" id="so-phong-con-trong">@Model.SoPhongConTrong</div>
                        <div class="ten-the">Còn trống</div>
                    </div>
                </div>

            </div><!-- / HÀNG THỐNG KÊ NHANH -->
            <!-- ========================================
         THANH LỌC + TÌM KIẾM
    ======================================== -->
            <div class="thanh-loc-tim-kiem">

                <!-- Ô tìm kiếm phòng -->
                <div class="o-tim-kiem-phong">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           id="o-nhap-tim-kiem"
                           placeholder="Tìm theo số phòng, tên người thuê..."
                           oninput="timKiemPhong(this.value)" />
                </div>

                <!-- Nhóm nút lọc theo trạng thái -->
                <div class="nhom-nut-loc">
                    <button class="nut-loc dang-chon-loc" id="nut-loc-tat-ca" onclick="locTheoTrangThai('tat-ca')">
                        <i class="fas fa-th-large"></i> Tất cả
                    </button>
                    <button class="nut-loc" id="nut-loc-dang-thue" onclick="locTheoTrangThai('dang-thue')">
                        <i class="fas fa-user-check"></i> Đang thuê
                    </button>
                    <button class="nut-loc" id="nut-loc-con-trong" onclick="locTheoTrangThai('con-trong')">
                        <i class="fas fa-door-closed"></i> Còn trống
                    </button>
                    <button class="nut-loc" id="nut-loc-bao-tri" onclick="locTheoTrangThai('bao-tri')">
                        <i class="fas fa-tools"></i> Bảo trì
                    </button>
                </div>

                <!-- Dropdown sắp xếp -->
                <select class="chon-sap-xep" id="chon-sap-xep" onchange="sapXepPhong(this.value)">
                    <option value="so-phong-tang">Số phòng ↑</option>
                    <option value="so-phong-giam">Số phòng ↓</option>
                    <option value="gia-tang">Giá tăng dần</option>
                    <option value="gia-giam">Giá giảm dần</option>
                </select>

            </div><!-- / THANH LỌC TÌM KIẾM -->
            <!-- Thông báo số kết quả -->
            <div class="ket-qua-loc" id="ket-qua-loc">
                Hiển thị <strong id="so-ket-qua">@Model.TongSoPhong</strong> phòng
            </div>


            <!-- ========================================
         LƯỚI DANH SÁCH PHÒNG
    ======================================== -->
            <div class="luoi-danh-sach-phong" id="luoi-danh-sach-phong">

                @foreach (var vm in Model.DanhSachPhong)
                {
                    var cssClass = CssClass(vm.Phong.TrangThai);
                    var badgeText = BadgeText(vm.Phong.TrangThai);
                    var tenNguoi = vm.HopDongHienTai?.Tenant?.FullName ?? "";
                    var hanHD = vm.HopDongHienTai?.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "";
                    var initials = !string.IsNullOrEmpty(tenNguoi) ? tenNguoi[0].ToString().ToUpper() : "";

                    // Kiểu icon + màu nền ảnh theo tầng / trạng thái
                    var (bgStyle, iconClass, iconStyle) = cssClass switch
                    {
                        "con-trong" => ("background:linear-gradient(135deg,#fef9c3,#fde68a);",
                                        "fas fa-bed", "color:#d97706;"),
                        "bao-tri" => ("background:linear-gradient(135deg,#fee2e2,#fca5a5);",
                                        "fas fa-tools", "color:#dc2626;"),
                        _ => (vm.Phong.Tang >= 3
                                            ? "background:linear-gradient(135deg,#e0f2fe,#bae6fd);"
                                            : "",
                                        vm.Phong.Tang >= 3 ? "fas fa-crown" : "fas fa-bed",
                                        vm.Phong.Tang >= 3 ? "color:#0284c7;" : "")
                    };

                    <div class="phong-item trang-thai-@cssClass"
                         data-so-phong="@vm.Phong.SoPhong"
                         data-trang-thai="@cssClass"
                         data-gia="@((long)vm.Phong.GiaPhongFix)"
                         data-nguoi-thue="@tenNguoi"
                         onclick="xemChiTietPhong(this)">
                        <div class="anh-phong" style="@bgStyle">
                            <i class="@iconClass icon-phong" style="@iconStyle"></i>
                            <span class="badge-so-phong">P.@vm.Phong.SoPhong</span>
                            <span class="badge-trang-thai @cssClass">@badgeText</span>
                        </div>
                        <div class="noi-dung-phong">
                            <div class="hang-ten-phong">
                                <span class="ten-phong-item">Phòng @vm.Phong.SoPhong</span>
                                <span class="gia-phong-item">@FormatGia(vm.Phong.GiaPhongFix)</span>
                            </div>
                            <div class="hang-thong-tin-phong">
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-expand-arrows-alt"></i>
                                    @(vm.Phong.DienTich.HasValue ? $"{vm.Phong.DienTich:0.#}m²" : "—")
                                </span>
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-layer-group"></i> Tầng @vm.Phong.Tang
                                </span>
                                <span class="thong-tin-nhap">
                                    <i class="fas fa-tag"></i>
                                    @(string.IsNullOrEmpty(vm.Phong.MoTa) ? "Phòng trọ" : vm.Phong.MoTa)
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(tenNguoi))
                            {
                                <div class="nguoi-thue-hien-tai">
                                    <div class="anh-nguoi-thue">@initials</div>
                                    <div>
                                        <div class="ten-nguoi-thue">@tenNguoi</div>
                                        <div class="han-hop-dong">
                                            @(!string.IsNullOrEmpty(hanHD) ? $"Hợp đồng đến: {hanHD}" : "Hợp đồng đang hiệu lực")
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- spacer khi không có người thuê để giữ chiều cao nhất quán -->
                                <div style="height:46px;"></div>
                            }

                            <div class="hang-nut-thao-tac">
                                <button class="nut-xem-chi-tiet" onclick="xemChiTietPhong(this.closest('.phong-item'))">
                                    <i class="fas fa-eye"></i> Xem chi tiết
                                </button>
                                <button class="nut-chinh-sua" onclick="chinhSuaPhong(event,'@vm.Phong.SoPhong')">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button class="nut-xoa" onclick="xoaPhong(event,'@vm.Phong.SoPhong')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div><!-- / LƯỚI DANH SÁCH PHÒNG -->

        </main><!-- / NỘI DUNG TRANG -->
    </div><!-- / KHU VỰC CHÍNH -->
    <!-- ============================================================
     MODAL: CHI TIẾT PHÒNG
============================================================ -->
    <div class="lop-phu-modal" id="modal-chi-tiet-phong" onclick="dongModalNeuNhanNgoai(event,'modal-chi-tiet-phong')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3 id="tieu-de-modal-chi-tiet">
                    <i class="fas fa-door-open" style="color:var(--mau-chu-de);"></i>
                    <span id="ct-ten-phong">Phòng 101</span>
                    <span id="badge-ct-trang-thai" class="badge-trang-thai dang-thue" style="font-size:11px;position:static;margin-left:8px;">● Đang thuê</span>
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-chi-tiet-phong')">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="than-modal">
                <div class="luoi-thong-tin-chi-tiet">
                    <div class="muc-thong-tin">
                        <div class="nhan">Giá thuê / tháng</div>
                        <div class="gia-tri" id="ct-gia-phong">—</div>
                    </div>
                    <div class="muc-thong-tin">
                        <div class="nhan">Người thuê hiện tại</div>
                        <div class="gia-tri" id="ct-nguoi-thue">—</div>
                    </div>
                    <div class="muc-thong-tin">
                        <div class="nhan">Diện tích</div>
                        <div class="gia-tri" id="ct-dien-tich">—</div>
                    </div>
                    <div class="muc-thong-tin">
                        <div class="nhan">Tầng</div>
                        <div class="gia-tri" id="ct-tang">—</div>
                    </div>
                    <div class="muc-thong-tin">
                        <div class="nhan">Loại phòng</div>
                        <div class="gia-tri" id="ct-loai-phong">—</div>
                    </div>
                    <div class="muc-thong-tin">
                        <div class="nhan">Trạng thái</div>
                        <div class="gia-tri" id="ct-trang-thai">—</div>
                    </div>
                </div>
            </div>
            <div class="chan-modal">
                <button class="nut-hanh-dong-modal xanh" onclick="taoHoaDon()">
                    <i class="fas fa-file-invoice-dollar"></i> Tạo hóa đơn
                </button>
                <button class="nut-hanh-dong-modal trang" onclick="chinhSuaPhongTuChiTiet()">
                    <i class="fas fa-pen"></i> Chỉnh sửa
                </button>
                <button class="nut-hanh-dong-modal do" onclick="xoaPhongTuChiTiet()">
                    <i class="fas fa-trash"></i> Xóa phòng
                </button>
            </div>
        </div>
    </div><!-- / MODAL CHI TIẾT -->
    <!-- ============================================================
     MODAL: THÊM / CHỈNH SỬA PHÒNG
============================================================ -->
    <div class="lop-phu-modal" id="modal-them-chinh-sua-phong" onclick="dongModalNeuNhanNgoai(event,'modal-them-chinh-sua-phong')">
        <div class="hop-modal hop-modal-lon">
            <div class="tieu-de-modal">
                <h3 id="tieu-de-modal-phong">
                    <i class="fas fa-door-open" style="color:var(--mau-chu-de);margin-right:8px;"></i>Thêm phòng mới
                </h3>
                <button class="nut-dong-modal" onclick="dongModal('modal-them-chinh-sua-phong')">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="than-modal">
                <div class="hang-form-modal">
                    <div class="nhom-truong-nhap">
                        <label>Số phòng <span class="bat-buoc">*</span></label>
                        <input type="text" id="nhap-so-phong" placeholder="VD: 101, A01..." />
                    </div>
                    <div class="nhom-truong-nhap">
                        <label>Giá thuê (VNĐ/tháng) <span class="bat-buoc">*</span></label>
                        <input type="number" id="nhap-gia-thue" placeholder="VD: 3500000" />
                    </div>
                    <div class="nhom-truong-nhap">
                        <label>Diện tích (m²)</label>
                        <input type="number" id="nhap-dien-tich" placeholder="VD: 18" step="0.1" />
                    </div>
                    <div class="nhom-truong-nhap">
                        <label>Tầng <span class="bat-buoc">*</span></label>
                        <select id="nhap-tang">
                            <option value="1">Tầng 1</option>
                            <option value="2">Tầng 2</option>
                            <option value="3">Tầng 3</option>
                            <option value="4">Tầng 4</option>
                            <option value="5">Tầng 5</option>
                        </select>
                    </div>
                    <div class="nhom-truong-nhap">
                        <label>Trạng thái</label>
                        <select id="nhap-trang-thai">
                            <option value="Trống">Còn trống</option>
                            <option value="Đã thuê">Đang thuê</option>
                            <option value="Đang sửa">Bảo trì</option>
                        </select>
                    </div>
                    <div class="nhom-truong-nhap rong-day">
                        <label>Mô tả / Ghi chú</label>
                        <textarea id="nhap-ghi-chu" placeholder="Mô tả về phòng, tiện nghi..."></textarea>
                    </div>
                </div>
            </div>
            <div class="chan-modal">
                <button class="nut-hanh-dong-modal xanh" onclick="luuPhong()">
                    <i class="fas fa-save"></i> Lưu phòng
                </button>
                <button class="nut-hanh-dong-modal trang" onclick="dongModal('modal-them-chinh-sua-phong')">
                    Hủy
                </button>
            </div>
        </div>
    </div><!-- / MODAL THÊM/CHỈNH SỬA -->

    <script>

            // ========================================================
            // BIẾN TOÀN CỤC
            // ========================================================
            let phongDangChon = null;

            // ========================================================
            // HÀM: ĐÓNG/MỞ SIDEBAR
            // ========================================================
            function dongMoSidebar() {
              document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            // ========================================================
            // HÀM: LỌC THEO TRẠNG THÁI
            // ========================================================
            function locTheoTrangThai(trangThai) {
              const tatCaPhong = document.querySelectorAll('.phong-item');
              let dem = 0;

              tatCaPhong.forEach(p => {
                const hienThi = trangThai === 'tat-ca' || p.dataset.trangThai === trangThai;
                p.style.display = hienThi ? '' : 'none';
                if (hienThi) dem++;
              });

              document.getElementById('so-ket-qua').textContent = dem;

              // Cập nhật nút lọc active
              document.querySelectorAll('.nut-loc').forEach(b => b.classList.remove('dang-chon-loc'));
              const nutTuongUng = document.getElementById('nut-loc-' + trangThai);
              if (nutTuongUng) nutTuongUng.classList.add('dang-chon-loc');
            }

            // ========================================================
            // HÀM: TÌM KIẾM PHÒNG
            // ========================================================
            function timKiemPhong(tuKhoa) {
              const kw = tuKhoa.toLowerCase().trim();
              const tatCaPhong = document.querySelectorAll('.phong-item');
              let dem = 0;

              tatCaPhong.forEach(p => {
                const soPhong   = (p.dataset.soPhong   || '').toLowerCase();
                const nguoiThue = (p.dataset.nguoiThue || '').toLowerCase();
                const hienThi   = !kw || soPhong.includes(kw) || nguoiThue.includes(kw);
                p.style.display = hienThi ? '' : 'none';
                if (hienThi) dem++;
              });

              document.getElementById('so-ket-qua').textContent = dem;
            }

            // ========================================================
            // HÀM: SẮP XẾP PHÒNG
            // ========================================================
            function sapXepPhong(kieu) {
              const luoi = document.getElementById('luoi-danh-sach-phong');
              const ds   = Array.from(luoi.querySelectorAll('.phong-item'));

              ds.sort((a, b) => {
                switch (kieu) {
                  case 'so-phong-tang': return a.dataset.soPhong.localeCompare(b.dataset.soPhong, 'vi', { numeric: true });
                  case 'so-phong-giam': return b.dataset.soPhong.localeCompare(a.dataset.soPhong, 'vi', { numeric: true });
                  case 'gia-tang':      return parseInt(a.dataset.gia) - parseInt(b.dataset.gia);
                  case 'gia-giam':      return parseInt(b.dataset.gia) - parseInt(a.dataset.gia);
                  default: return 0;
                }
              });

              ds.forEach(p => luoi.appendChild(p));
            }

            // ========================================================
            // HÀM: XEM CHI TIẾT PHÒNG
            // ========================================================
            function xemChiTietPhong(phanTuPhong) {
              phongDangChon = phanTuPhong;

              const soPhong   = phanTuPhong.dataset.soPhong;
              const trangThai = phanTuPhong.dataset.trangThai;
              const gia       = parseInt(phanTuPhong.dataset.gia);
              const nguoiThue = phanTuPhong.dataset.nguoiThue || 'Chưa có người thuê';

              document.getElementById('ct-ten-phong').textContent    = 'Phòng ' + soPhong;
              document.getElementById('ct-gia-phong').textContent    = formatGia(gia) + '/tháng';
              document.getElementById('ct-nguoi-thue').textContent   = nguoiThue;
              document.getElementById('ct-trang-thai').textContent   = formatTrangThai(trangThai);

              const thongTinItems = phanTuPhong.querySelectorAll('.thong-tin-nhap');
              if (thongTinItems[0]) document.getElementById('ct-dien-tich').textContent  = thongTinItems[0].textContent.trim();
              if (thongTinItems[1]) document.getElementById('ct-tang').textContent       = thongTinItems[1].textContent.trim();
              if (thongTinItems[2]) document.getElementById('ct-loai-phong').textContent = thongTinItems[2].textContent.trim();

              const badge = document.getElementById('badge-ct-trang-thai');
              badge.className = 'badge-trang-thai ' + trangThai;
              badge.textContent = '● ' + formatTrangThai(trangThai);

              document.getElementById('modal-chi-tiet-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: MỞ MODAL THÊM PHÒNG MỚI
            // ========================================================
            function moModalThemPhong() {
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-door-open" style="color:var(--mau-chu-de);margin-right:8px;"></i>Thêm phòng mới';
              document.getElementById('nhap-so-phong').value  = '';
              document.getElementById('nhap-gia-thue').value  = '';
              document.getElementById('nhap-dien-tich').value = '';
              document.getElementById('nhap-ghi-chu').value   = '';
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: MỞ MODAL CHỈNH SỬA PHÒNG
            // ========================================================
            function chinhSuaPhong(event, soPhong) {
              event.stopPropagation();
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-pen" style="color:var(--mau-chu-de);margin-right:8px;"></i>Chỉnh sửa phòng ' + soPhong;
              document.getElementById('nhap-so-phong').value = soPhong;
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
              dongModal('modal-chi-tiet-phong');
            }

            function chinhSuaPhongTuChiTiet() {
              if (!phongDangChon) return;
              dongModal('modal-chi-tiet-phong');
              const soPhong = phongDangChon.dataset.soPhong;
              document.getElementById('tieu-de-modal-phong').innerHTML =
                '<i class="fas fa-pen" style="color:var(--mau-chu-de);margin-right:8px;"></i>Chỉnh sửa phòng ' + soPhong;
              document.getElementById('nhap-so-phong').value = soPhong;
              document.getElementById('modal-them-chinh-sua-phong').classList.add('hien');
            }

            // ========================================================
            // HÀM: LƯU PHÒNG
            // ========================================================
            function luuPhong() {
              const soPhong = document.getElementById('nhap-so-phong').value.trim();
              const giaThue = document.getElementById('nhap-gia-thue').value.trim();

              if (!soPhong || !giaThue) {
                alert('Vui lòng điền đầy đủ thông tin bắt buộc (*)!');
                return;
              }
              alert(`Đã lưu phòng ${soPhong} thành công!\n(Kết nối backend để lưu vào database)`);
              dongModal('modal-them-chinh-sua-phong');
            }

            // ========================================================
            // HÀM: XÓA PHÒNG
            // ========================================================
            function xoaPhong(event, soPhong) {
              event.stopPropagation();
              const xacNhan = confirm(`Bạn có chắc muốn xóa phòng ${soPhong} không?\nHành động này không thể hoàn tác!`);
              if (xacNhan) {
                alert(`Đã xóa phòng ${soPhong}! (Kết nối backend để xóa thật)`);
              }
            }

            function xoaPhongTuChiTiet() {
              if (!phongDangChon) return;
              const soPhong = phongDangChon.dataset.soPhong;
              dongModal('modal-chi-tiet-phong');
              const xacNhan = confirm(`Bạn có chắc muốn xóa phòng ${soPhong} không?`);
              if (xacNhan) {
                alert(`Đã xóa phòng ${soPhong}! (Kết nối backend để xóa thật)`);
              }
            }

            // ========================================================
            // HÀM: TẠO HÓA ĐƠN TỪ CHI TIẾT PHÒNG
            // ========================================================
            function taoHoaDon() {
              if (!phongDangChon) return;
              const soPhong = phongDangChon.dataset.soPhong;
              alert(`Chuyển đến trang tạo hóa đơn cho phòng ${soPhong}`);
              dongModal('modal-chi-tiet-phong');
            }

            // ========================================================
            // HÀM: ĐÓNG MODAL
            // ========================================================
            function dongModal(idModal) {
              document.getElementById(idModal).classList.remove('hien');
            }

            function dongModalNeuNhanNgoai(event, idModal) {
              if (event.target.id === idModal) dongModal(idModal);
            }

            // ========================================================
            // HÀM: TÌM KIẾM TOÀN CỤC (ô tìm kiếm trên header)
            // ========================================================
            function timKiemToanCuc(tuKhoa) {
              document.getElementById('o-nhap-tim-kiem').value = tuKhoa;
              timKiemPhong(tuKhoa);
            }

            // ========================================================
            // HÀM HỖ TRỢ: FORMAT GIÁ TIỀN
            // ========================================================
            function formatGia(gia) {
              if (gia >= 1000000) return (gia / 1000000).toFixed(1).replace('.0','') + 'M';
              return gia.toLocaleString('vi-VN') + 'đ';
            }

            // ========================================================
            // HÀM HỖ TRỢ: FORMAT TRẠNG THÁI
            // ========================================================
            function formatTrangThai(trangThai) {
              const bangDich = {
                'dang-thue': 'Đang thuê',
                'con-trong': 'Còn trống',
                'bao-tri':   'Bảo trì',
              };
              return bangDich[trangThai] || trangThai;
            }

            // ========================================================
            // HÀM: CHUYỂN TRANG QUA SIDEBAR (đồng nhất với Manager)
            // ========================================================
            function chuyenTrang(tenTrang, phanTu) {
                document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
                phanTu.classList.add('dang-chon');
                const bangDieuHuong = {
                    'trang-chu':          '/Manager/Manager',
                    'quan-ly-phong':      '/Manager/ChiTietPhong',
                    'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
                    'hoa-don':            '/Manager/HoaDon',
                    'su-co-bao-tri':      '/SuCoBaoTri',
                    'bao-cao':            '/BaoCao',
                    'cai-dat':            '/CaiDat',
                };
                const duongDan = bangDieuHuong[tenTrang];
                if (duongDan) window.location.href = duongDan;
                else console.log('Chưa có trang:', tenTrang);
            }

            // ========================================================
            // HÀM: ĐÓNG / MỞ SIDEBAR
            // ========================================================
            function dongMoSidebar() {
                document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            // ========================================================
            // CÁC HÀM GIAO DIỆN PHỤ
            // ========================================================
            function moThongBao()     { alert('Mở danh sách thông báo'); }
            function moMenuAdmin()    { alert('Menu tài khoản: Đổi mật khẩu / Đăng xuất'); }
            function moThongTinAdmin(){ alert('Thông tin quản trị viên'); }

    </script>

</body>
</html>
