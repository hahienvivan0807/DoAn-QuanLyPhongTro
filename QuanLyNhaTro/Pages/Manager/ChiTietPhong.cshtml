@page "/Manager/ChiTietPhong"
@model QuanLyNhaTro.Pages.ChiTietPhongModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Lý Phòng Trọ – Chi Tiết Phòng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
            /* ============================================================
                                                       BIẾN MÀU & THIẾT LẬP TOÀN CỤC
                                       ============================================================ */
            :root {
                --mau-sidebar: #0d1b3e;
                --mau-sidebar-dam: #091429;
                --mau-chu-de: #1a56db;
                --mau-chu-de-sang: #3b82f6;
                --mau-nen: #f0f4f8;
                --mau-trang: #ffffff;
                --mau-chu: #1e293b;
                --mau-chu-phu: #64748b;
                --mau-vien: #e2e8f0;
                --mau-xanh-nhat: #eff6ff;
                --mau-xanh-trung: #dbeafe;
                --bong-card: 0 4px 24px rgba(26,86,219,0.10);
                --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
                --mau-xanh-la: #059669;
                --mau-cam: #d97706;
                --mau-do: #dc2626;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ============================================================
                                                       SIDEBAR
                                       ============================================================ */
            #thanh-sidebar {
                width: 220px;
                min-width: 220px;
                background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
                display: flex;
                flex-direction: column;
                height: 100vh;
                position: relative;
                z-index: 100;
                box-shadow: 4px 0 24px rgba(0,0,0,0.18);
                overflow-y: auto;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
            }

                #thanh-sidebar.an-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            /* Ẩn nhãn nhóm khi thu gọn */
            .nhan-nhom {
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
            }

            #thanh-sidebar.thu-gon .nhan-nhom {
                opacity: 0;
                max-height: 0;
                padding: 0;
            }

            /* Ẩn text trong menu item khi thu gọn */
            .menu-item span:not(.huy-hieu-menu) {
                transition: opacity 0.2s ease, max-width 0.35s ease;
                max-width: 160px;
                overflow: hidden;
                display: inline-block;
            }

            #thanh-sidebar.thu-gon .menu-item span:not(.huy-hieu-menu) {
                opacity: 0;
                max-width: 0;
            }

            #thanh-sidebar.thu-gon .huy-hieu-menu {
                opacity: 0;
                width: 0;
                overflow: hidden;
                padding: 0;
            }

            /* Căn giữa icon khi thu gọn */
            #thanh-sidebar.thu-gon .menu-item {
                padding: 10px 0;
                justify-content: center;
                border-radius: 10px;
                margin: 2px 8px;
            }

            #thanh-sidebar.thu-gon .admin-sidebar {
                justify-content: center;
            }

            .logo-sidebar {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 28px 20px 24px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .logo-sidebar .bieu-tuong {
                    width: 42px;
                    height: 42px;
                    background: var(--mau-chu-de);
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 20px;
                    color: #fff;
                }

                .logo-sidebar .ten-logo strong {
                    display: block;
                    font-size: 13px;
                    color: #fff;
                    letter-spacing: 0.5px;
                }

                .logo-sidebar .ten-logo span {
                    font-size: 11px;
                    color: rgba(255,255,255,0.45);
                }

            .nhan-nhom {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                padding: 18px 20px 6px;
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
            }

            #thanh-sidebar.thu-gon .nhan-nhom {
                opacity: 0;
                max-height: 0;
                padding: 0;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 11px 20px;
                color: rgba(255,255,255,0.65);
                cursor: pointer;
                border-radius: 0 30px 30px 0;
                margin: 2px 10px 2px 0;
                transition: background 0.2s, color 0.2s, box-shadow 0.2s;
                font-size: 14px;
                font-weight: 400;
                text-decoration: none;
                position: relative;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(59,130,246,0.15);
                    color: #fff;
                }

                .menu-item.dang-chon {
                    background: linear-gradient(90deg, rgba(26,86,219,0.85), rgba(59,130,246,0.6));
                    color: #fff;
                    font-weight: 600;
                    box-shadow: 0 4px 16px rgba(26,86,219,0.35);
                }

                    .menu-item.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 70%;
                        width: 4px;
                        background: #60a5fa;
                        border-radius: 0 4px 4px 0;
                    }

            .huy-hieu-menu {
                margin-left: auto;
                background: #ef4444;
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 1px 7px;
                min-width: 20px;
                text-align: center;
            }

            .admin-sidebar {
                margin-top: auto;
                padding: 18px 16px;
                border-top: 1px solid rgba(255,255,255,0.07);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
            }

                .admin-sidebar .anh-admin {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 16px;
                    border: 2px solid rgba(255,255,255,0.2);
                }

                .admin-sidebar .ten-admin strong {
                    display: block;
                    color: #fff;
                    font-size: 13px;
                }

                .admin-sidebar .ten-admin span {
                    color: rgba(255,255,255,0.45);
                    font-size: 11px;
                }

            /* ============================================================
                                                      KHU VỰC CHÍNH
                                       ============================================================ */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* ===== HEADER ===== */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid var(--mau-vien);
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                flex-shrink: 0;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .nut-ham-menu {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 20px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: background 0.2s;
            }

                .nut-ham-menu:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-trang {
                font-size: 16px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .duong-dan {
                font-size: 12px;
                color: var(--mau-chu-phu);
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .o-tim-kiem {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1px solid var(--mau-vien);
                border-radius: 24px;
                padding: 7px 16px;
                transition: all 0.2s;
            }

                .o-tim-kiem:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                }

                .o-tim-kiem input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 180px;
                    color: var(--mau-chu);
                }

                .o-tim-kiem i {
                    color: var(--mau-chu-phu);
                    font-size: 13px;
                }

            .nut-thong-bao {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: 50%;
                transition: all 0.2s;
            }

                .nut-thong-bao:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .so-thong-bao {
                position: absolute;
                top: 2px;
                right: 2px;
                background: #ef4444;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            .thong-tin-admin {
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                padding: 6px 12px;
                border-radius: 24px;
                transition: background 0.2s;
            }

                .thong-tin-admin:hover {
                    background: var(--mau-xanh-nhat);
                }

                .thong-tin-admin .anh-dai-dien {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 14px;
                    font-weight: 700;
                }

                .thong-tin-admin .ten {
                    font-size: 13px;
                    font-weight: 600;
                }

                .thong-tin-admin .chuc-vu {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                }

            /* ============================================================
                                                       NỘI DUNG TRANG QUẢN LÝ PHÒNG
                                       ============================================================ */
            #noi-dung-trang {
                flex: 1;
                overflow-y: auto;
                padding: 24px 28px;
            }

            /* --- Dòng tiêu đề trang --- */
            .hang-tieu-de-trang {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
            }

                .hang-tieu-de-trang h2 {
                    font-size: 20px;
                    font-weight: 800;
                }

                .hang-tieu-de-trang p {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            .nut-them-phong {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 10px 20px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
            }

                .nut-them-phong:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            /* --- Hàng thống kê nhanh (3 thẻ nhỏ) --- */
            .hang-thong-ke-nhanh {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-bottom: 22px;
            }

            .the-thong-ke-nhanh {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 18px 20px;
                box-shadow: var(--bong-card);
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid transparent;
                transition: all 0.25s;
                cursor: pointer;
                position: relative;
                overflow: hidden;
            }

                .the-thong-ke-nhanh::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    border-radius: 14px 14px 0 0;
                }

                .the-thong-ke-nhanh:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--bong-card-hover);
                }

                .the-thong-ke-nhanh.tat-ca::before {
                    background: linear-gradient(90deg,#1a56db,#60a5fa);
                }

                .the-thong-ke-nhanh.tat-ca {
                    border-color: #dbeafe;
                }

                    .the-thong-ke-nhanh.tat-ca .bieu-tuong-the {
                        background: #eff6ff;
                        color: #1a56db;
                    }

                .the-thong-ke-nhanh.dang-thue::before {
                    background: linear-gradient(90deg,#059669,#34d399);
                }

                .the-thong-ke-nhanh.dang-thue {
                    border-color: #d1fae5;
                }

                    .the-thong-ke-nhanh.dang-thue .bieu-tuong-the {
                        background: #ecfdf5;
                        color: #059669;
                    }

                .the-thong-ke-nhanh.con-trong::before {
                    background: linear-gradient(90deg,#f59e0b,#fbbf24);
                }

                .the-thong-ke-nhanh.con-trong {
                    border-color: #fef3c7;
                }

                    .the-thong-ke-nhanh.con-trong .bieu-tuong-the {
                        background: #fffbeb;
                        color: #d97706;
                    }

            .bieu-tuong-the {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .so-lieu-the .con-so {
                font-size: 26px;
                font-weight: 800;
                line-height: 1;
            }

            .so-lieu-the .ten-the {
                font-size: 12px;
                color: var(--mau-chu-phu);
                margin-top: 3px;
            }

            /* --- Thanh lọc + tìm kiếm --- */
            .thanh-loc-tim-kiem {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 16px 20px;
                box-shadow: var(--bong-card);
                border: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 20px;
                flex-wrap: wrap;
            }

            /* Ô tìm kiếm trong thanh lọc */
            .o-tim-kiem-phong {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                padding: 9px 14px;
                flex: 1;
                min-width: 200px;
                transition: all 0.2s;
            }

                .o-tim-kiem-phong:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
                }

                .o-tim-kiem-phong input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 100%;
                    font-family: 'Be Vietnam Pro', sans-serif;
                }

                .o-tim-kiem-phong i {
                    color: var(--mau-chu-phu);
                    font-size: 14px;
                    flex-shrink: 0;
                }

            /* Nhóm nút lọc (Tab: Tất cả / Đang thuê / Còn trống / Bảo trì) */
            .nhom-nut-loc {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
            }

            .nut-loc {
                padding: 8px 16px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                border: 1.5px solid var(--mau-vien);
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                transition: all 0.2s;
                white-space: nowrap;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-loc:hover {
                    border-color: var(--mau-chu-de-sang);
                    color: var(--mau-chu-de);
                    background: var(--mau-xanh-nhat);
                }

                .nut-loc.dang-chon-loc {
                    background: var(--mau-chu-de);
                    color: #fff;
                    border-color: var(--mau-chu-de);
                    box-shadow: 0 3px 10px rgba(26,86,219,0.3);
                }

            /* Dropdown sắp xếp */
            .chon-sap-xep {
                padding: 9px 14px;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 600;
                border: 1.5px solid var(--mau-vien);
                background: var(--mau-nen);
                color: var(--mau-chu);
                cursor: pointer;
                outline: none;
                font-family: 'Be Vietnam Pro', sans-serif;
                transition: border-color 0.2s;
            }

                .chon-sap-xep:focus {
                    border-color: var(--mau-chu-de-sang);
                }

            /* --- Kết quả tìm kiếm (thông báo số lượng) --- */
            .ket-qua-loc {
                font-size: 13px;
                color: var(--mau-chu-phu);
                margin-bottom: 14px;
            }

                .ket-qua-loc strong {
                    color: var(--mau-chu);
                }

            /* ============================================================
                                                       LƯỚI DANH SÁCH PHÒNG
                                                    ============================================================ */
            .luoi-danh-sach-phong {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 18px;
            }

            /* --- Mỗi card phòng --- */
            .phong-item {
                background: var(--mau-trang);
                border-radius: 16px;
                border: 1px solid var(--mau-vien);
                box-shadow: var(--bong-card);
                overflow: hidden;
                transition: all 0.25s;
                cursor: pointer;
                position: relative;
            }

                .phong-item:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--bong-card-hover);
                    border-color: var(--mau-chu-de-sang);
                }

                /* Vệt màu trên đầu mỗi card theo trạng thái */
                .phong-item::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    border-radius: 16px 16px 0 0;
                }

                .phong-item.trang-thai-dang-thue::before {
                    background: linear-gradient(90deg,#059669,#34d399);
                }

                .phong-item.trang-thai-con-trong::before {
                    background: linear-gradient(90deg,#f59e0b,#fbbf24);
                }

                .phong-item.trang-thai-bao-tri::before {
                    background: linear-gradient(90deg,#ef4444,#f97316);
                }

            /* Phần ảnh / minh họa phòng */
            .anh-phong {
                height: 140px;
                background: linear-gradient(135deg, #e0e7ff 0%, #bfdbfe 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                .anh-phong .icon-phong {
                    font-size: 48px;
                    opacity: 0.35;
                    color: #1a56db;
                }

            /* Badge trạng thái nổi trên ảnh */
            .badge-trang-thai {
                position: absolute;
                top: 10px;
                right: 10px;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 700;
                backdrop-filter: blur(4px);
            }

                .badge-trang-thai.dang-thue {
                    background: rgba(5,150,105,0.9);
                    color: #fff;
                }

                .badge-trang-thai.con-trong {
                    background: rgba(217,119,6,0.9);
                    color: #fff;
                }

                .badge-trang-thai.bao-tri {
                    background: rgba(220,38,38,0.9);
                    color: #fff;
                }

            /* Badge số phòng */
            .badge-so-phong {
                position: absolute;
                top: 10px;
                left: 10px;
                background: rgba(15,23,42,0.75);
                color: #fff;
                font-size: 12px;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 8px;
                backdrop-filter: blur(4px);
            }

            /* Phần nội dung thông tin phòng */
            .noi-dung-phong {
                padding: 16px;
            }

            .hang-ten-phong {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 8px;
            }

            .ten-phong-item {
                font-size: 16px;
                font-weight: 800;
            }

            .gia-phong-item {
                font-size: 15px;
                font-weight: 800;
                color: var(--mau-chu-de);
            }

            /* Hàng thông tin chi tiết (diện tích, loại, tầng) */
            .hang-thong-tin-phong {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-bottom: 12px;
            }

            .thong-tin-nhap {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 12px;
                color: var(--mau-chu-phu);
                background: var(--mau-nen);
                padding: 4px 9px;
                border-radius: 6px;
            }

                .thong-tin-nhap i {
                    font-size: 11px;
                    color: var(--mau-chu-de);
                }

            /* Người thuê hiện tại (nếu đang thuê) */
            .nguoi-thue-hien-tai {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 10px;
                border-radius: 8px;
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
                margin-bottom: 12px;
            }

                .nguoi-thue-hien-tai .anh-nguoi-thue {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    background: linear-gradient(135deg,#059669,#34d399);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 12px;
                    font-weight: 700;
                    flex-shrink: 0;
                }

                .nguoi-thue-hien-tai .ten-nguoi-thue {
                    font-size: 12px;
                    font-weight: 700;
                    color: #065f46;
                }

                .nguoi-thue-hien-tai .han-hop-dong {
                    font-size: 11px;
                    color: #6b7280;
                }

            /* Hàng nút thao tác dưới card */
            .hang-nut-thao-tac {
                display: flex;
                gap: 8px;
                margin-top: 4px;
            }

            .nut-xem-chi-tiet {
                flex: 1;
                padding: 8px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                background: var(--mau-xanh-nhat);
                color: var(--mau-chu-de);
                border: 1.5px solid var(--mau-xanh-trung);
                cursor: pointer;
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-xem-chi-tiet:hover {
                    background: var(--mau-xanh-trung);
                }

            .nut-chinh-sua {
                padding: 8px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                border: 1.5px solid var(--mau-vien);
                cursor: pointer;
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-chinh-sua:hover {
                    background: var(--mau-vien);
                    color: var(--mau-chu);
                }

            .nut-xoa {
                padding: 8px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                background: #fff5f5;
                color: #dc2626;
                border: 1.5px solid #fecaca;
                cursor: pointer;
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-xoa:hover {
                    background: #fee2e2;
                }

            /* Thông báo không có kết quả */
            .khong-co-ket-qua {
                display: none;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 60px 20px;
                color: var(--mau-chu-phu);
                text-align: center;
                grid-column: 1 / -1;
            }

                .khong-co-ket-qua i {
                    font-size: 48px;
                    margin-bottom: 14px;
                    opacity: 0.3;
                }

                .khong-co-ket-qua p {
                    font-size: 15px;
                    font-weight: 600;
                }

                .khong-co-ket-qua span {
                    font-size: 13px;
                }

            /* ============================================================
                                                       MODAL POPUP
                                                    ============================================================ */
            .lop-che-modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(4px);
            }

                .lop-che-modal.hien {
                    display: flex;
                }

            .hop-modal {
                background: var(--mau-trang);
                border-radius: 20px;
                padding: 28px;
                width: 560px;
                max-width: 95vw;
                box-shadow: 0 20px 60px rgba(0,0,0,0.2);
                animation: hienModal 0.3s ease;
                max-height: 90vh;
                overflow-y: auto;
            }

            @@keyframes hienModal {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            .tieu-de-modal {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }

                .tieu-de-modal h3 {
                    font-size: 17px;
                    font-weight: 800;
                }

            .nut-dong-modal {
                background: none;
                border: none;
                font-size: 20px;
                cursor: pointer;
                color: var(--mau-chu-phu);
                border-radius: 50%;
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
            }

                .nut-dong-modal:hover {
                    background: var(--mau-nen);
                    color: var(--mau-chu);
                }

            /* Form trong modal */
            .hang-form-modal {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            .nhom-truong-nhap {
                margin-bottom: 4px;
            }

            .nhan-truong-nhap {
                display: block;
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 6px;
                color: var(--mau-chu);
            }

            .truong-nhap {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                font-size: 13px;
                outline: none;
                transition: border-color 0.2s;
                color: var(--mau-chu);
                font-family: 'Be Vietnam Pro', sans-serif;
                background: #fff;
            }

                .truong-nhap:focus {
                    border-color: var(--mau-chu-de-sang);
                    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
                }

            .nhom-nut-modal {
                display: flex;
                gap: 10px;
                justify-content: flex-end;
                margin-top: 20px;
            }

            .nut-huy {
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                border: none;
                padding: 10px 20px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-huy:hover {
                    background: var(--mau-vien);
                }

            .nut-luu {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                padding: 10px 24px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-luu:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            /* ============================================================
                                                       MODAL CHI TIẾT PHÒNG (hiển thị đầy đủ thông tin 1 phòng)
                                                    ============================================================ */
            .hop-modal-chi-tiet {
                background: var(--mau-trang);
                border-radius: 20px;
                padding: 0;
                width: 640px;
                max-width: 95vw;
                box-shadow: 0 20px 60px rgba(0,0,0,0.2);
                animation: hienModal 0.3s ease;
                max-height: 90vh;
                overflow-y: auto;
            }

            .anh-phong-chi-tiet {
                height: 180px;
                background: linear-gradient(135deg, #e0e7ff, #bfdbfe);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                border-radius: 20px 20px 0 0;
            }

                .anh-phong-chi-tiet .icon-lon {
                    font-size: 64px;
                    opacity: 0.3;
                    color: #1a56db;
                }

            .noi-dung-chi-tiet {
                padding: 24px;
            }

            /* Hàng tiêu đề chi tiết */
            .hang-tieu-de-chi-tiet {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 16px;
            }

            .ten-phong-chi-tiet {
                font-size: 22px;
                font-weight: 800;
            }

            .gia-phong-chi-tiet {
                font-size: 20px;
                font-weight: 800;
                color: var(--mau-chu-de);
            }

            /* Lưới thông tin chi tiết */
            .luoi-thong-tin-chi-tiet {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-bottom: 18px;
            }

            .o-thong-tin {
                background: var(--mau-nen);
                border-radius: 10px;
                padding: 12px 14px;
            }

                .o-thong-tin .nhan {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .o-thong-tin .gia-tri {
                    font-size: 14px;
                    font-weight: 700;
                    margin-top: 3px;
                }

            /* Phần lịch sử thuê */
            .tieu-de-phan {
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 10px;
                padding-bottom: 8px;
                border-bottom: 1px solid var(--mau-vien);
            }

            .lich-su-thue-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 0;
                border-bottom: 1px dashed var(--mau-vien);
            }

                .lich-su-thue-item:last-child {
                    border-bottom: none;
                }

                .lich-su-thue-item .dot {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--mau-chu-de);
                    flex-shrink: 0;
                }

                .lich-su-thue-item .ten-nguoi {
                    font-size: 13px;
                    font-weight: 600;
                }

                .lich-su-thue-item .thoi-gian-thue {
                    font-size: 12px;
                    color: var(--mau-chu-phu);
                }

            /* Nút thao tác trong modal chi tiết */
            .hang-nut-chi-tiet {
                display: flex;
                gap: 10px;
                margin-top: 20px;
                flex-wrap: wrap;
            }

            .nut-hanh-dong-chinh {
                flex: 1;
                padding: 11px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                border: none;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-hanh-dong-chinh.xanh {
                    background: linear-gradient(135deg,#059669,#34d399);
                    color: #fff;
                }

                    .nut-hanh-dong-chinh.xanh:hover {
                        box-shadow: 0 4px 14px rgba(5,150,105,0.4);
                    }

                .nut-hanh-dong-chinh.xanh-duong {
                    background: linear-gradient(135deg,var(--mau-chu-de),var(--mau-chu-de-sang));
                    color: #fff;
                }

                    .nut-hanh-dong-chinh.xanh-duong:hover {
                        box-shadow: 0 4px 14px rgba(26,86,219,0.4);
                    }

                .nut-hanh-dong-chinh.do {
                    background: linear-gradient(135deg,#ef4444,#f97316);
                    color: #fff;
                }

                    .nut-hanh-dong-chinh.do:hover {
                        box-shadow: 0 4px 14px rgba(239,68,68,0.4);
                    }

            /* ============================================================
                                                       SCROLLBAR
                                                    ============================================================ */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* ============================================================
                                                       RESPONSIVE
                                                    ============================================================ */
            @@media (max-width: 1024px) {
                .hang-thong-ke-nhanh {
                    grid-template-columns: 1fr 1fr 1fr;
                }
            }

            @@media (max-width: 768px) {
                #thanh-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

                    #thanh-sidebar.mo {
                        width: 220px;
                        min-width: 220px;
                    }

                .hang-thong-ke-nhanh {
                    grid-template-columns: 1fr;
                }

                .luoi-danh-sach-phong {
                    grid-template-columns: 1fr;
                }

                .hang-form-modal {
                    grid-template-columns: 1fr;
                }

                .luoi-thong-tin-chi-tiet {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

