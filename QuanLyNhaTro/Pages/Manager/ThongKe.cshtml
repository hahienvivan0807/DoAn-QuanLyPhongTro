// ====== 5. BIỂU ĐỒ CỘT NGANG TRẠNG THÁI HÓA ĐƠN ======
(function () {
    const d = duLieuBieuDo.trangThaiHoaDon;
    new Chart(document.getElementById('bieu-do-hoadon').getContext('2d'), {
