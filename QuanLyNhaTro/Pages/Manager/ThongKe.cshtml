@page "/Manager/ThongKe"
@model QuanLyNhaTro.Pages.Manager.ThongKeModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thống Kê & Báo Cáo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        /* ===== BIẾN MÀU — kế thừa hệ thống ===== */
        :root {
            --mau-sidebar: #0d1b3e;
            --mau-sidebar-dam: #091429;
            --mau-chu-de: #1a56db;
            --mau-chu-de-sang: #3b82f6;
            --mau-nen: #f0f4f8;
            --mau-trang: #ffffff;
            --mau-chu: #1e293b;
            --mau-chu-phu: #64748b;
            --mau-vien: #e2e8f0;
            --mau-xanh-nhat: #eff6ff;
            --mau-xanh-trung: #dbeafe;
            --bong-card: 0 4px 24px rgba(26,86,219,0.10);
            --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
            background: var(--mau-nen);
            color: var(--mau-chu);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ====================== SIDEBAR ====================== */
        #thanh-sidebar {
            width: 220px; min-width: 220px;
            background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
            display: flex; flex-direction: column;
            height: 100vh; position: relative; z-index: 100;
            box-shadow: 4px 0 24px rgba(0,0,0,0.18);
            overflow-y: auto;
            transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
        }
        #thanh-sidebar.an-sidebar { width: 0; min-width: 0; overflow: hidden; }
        .nhan-nhom {
            font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3); text-transform: uppercase;
            padding: 18px 20px 6px 20px;
        }
        .logo-sidebar {
            display: flex; align-items: center; gap: 12px;
            padding: 28px 20px 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }
        .logo-sidebar .bieu-tuong {
            width: 60px; height: 60px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden; background: transparent;
        }
        .logo-sidebar .bieu-tuong img { width: 100%; height: 100%; object-fit: contain; border-radius: 10px; }
        .logo-sidebar .ten-logo strong { display: block; font-size: 13px; letter-spacing: 0.5px; color: #fff; }
        .logo-sidebar .ten-logo span { font-size: 11px; color: rgba(255,255,255,0.45); }
        .menu-item {
            display: flex; align-items: center; gap: 13px;
            padding: 11px 20px; color: rgba(255,255,255,0.65);
            cursor: pointer; border-radius: 0 30px 30px 0;
            margin: 2px 10px 2px 0;
            transition: all 0.2s; font-size: 14px; text-decoration: none; position: relative;
        }
        .menu-item i { width: 20px; text-align: center; font-size: 15px; }
        .menu-item:hover { background: rgba(59,130,246,0.15); color: #fff; }
        .menu-item.dang-chon {
            background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
            color: #fff; font-weight: 600; box-shadow: 0 4px 16px rgba(26,86,219,0.3);
        }
        .menu-item.dang-chon::before {
            content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
            height: 70%; width: 4px; background: #60a5fa; border-radius: 0 4px 4px 0;
        }
        .huy-hieu-menu {
            margin-left: auto; background: #ef4444; color: #fff;
            font-size: 10px; font-weight: 700; border-radius: 20px;
            padding: 1px 7px; min-width: 20px; text-align: center;
        }
        .admin-sidebar {
            margin-top: auto; padding: 18px 16px;
            border-top: 1px solid rgba(255,255,255,0.07);
            display: flex; align-items: center; gap: 10px; cursor: pointer;
        }
        .admin-sidebar .anh-admin {
            width: 38px; height: 38px; border-radius: 50%;
            background: linear-gradient(135deg, #1a56db, #60a5fa);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 16px; border: 2px solid rgba(255,255,255,0.2);
        }
        .admin-sidebar .ten-admin strong { display: block; color: #fff; font-size: 13px; }
        .admin-sidebar .ten-admin span { color: rgba(255,255,255,0.45); font-size: 11px; }

        /* ====================== HEADER ====================== */
        #khu-vuc-chinh { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        #thanh-header {
            background: var(--mau-trang); padding: 0 28px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid var(--mau-vien);
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); flex-shrink: 0;
        }
        .header-trai { display: flex; align-items: center; gap: 16px; }
        .nut-ham-menu {
            background: none; border: none; cursor: pointer; font-size: 20px;
            color: var(--mau-chu-phu); padding: 6px; border-radius: 8px; transition: background 0.2s;
        }
        .nut-ham-menu:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
        .tieu-de-trang { font-size: 16px; font-weight: 700; color: var(--mau-chu); }
        .duong-dan { font-size: 12px; color: var(--mau-chu-phu); }
        .header-phai { display: flex; align-items: center; gap: 16px; }
        .nut-thong-bao {
            position: relative; background: none; border: none; cursor: pointer;
            font-size: 18px; color: var(--mau-chu-phu); padding: 8px; border-radius: 50%; transition: all 0.2s;
        }
        .nut-thong-bao:hover { background: var(--mau-xanh-nhat); color: var(--mau-chu-de); }
        .so-thong-bao {
            position: absolute; top: 2px; right: 2px; background: #ef4444; color: #fff;
            font-size: 9px; font-weight: 700; border-radius: 50%;
            width: 16px; height: 16px; display: flex; align-items: center; justify-content: center;
            border: 2px solid #fff;
        }
        .thong-tin-admin {
            display: flex; align-items: center; gap: 10px; cursor: pointer;
            padding: 6px 12px; border-radius: 24px; transition: background 0.2s;
        }
        .thong-tin-admin:hover { background: var(--mau-xanh-nhat); }
        .thong-tin-admin .anh-dai-dien {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #1a56db, #60a5fa);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 14px; font-weight: 700;
        }
        .thong-tin-admin .ten { font-size: 13px; font-weight: 600; }
        .thong-tin-admin .chuc-vu { font-size: 11px; color: var(--mau-chu-phu); }

        /* ====================== NỘI DUNG ====================== */
        #noi-dung-trang { flex: 1; overflow-y: auto; padding: 24px 28px; }

        .hang-tieu-de {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
            flex-wrap: wrap; gap: 12px;
        }
        .hang-tieu-de h2 { font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 10px; }
        .hang-tieu-de h2 i { color: var(--mau-chu-de); }
        .hang-tieu-de p { font-size: 13px; color: var(--mau-chu-phu); margin-top: 2px; }

        /* ====================== BỘ LỌC THỜI GIAN ====================== */
        .thanh-loc-tg {
            display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        }
        .nut-loc-tg {
            padding: 8px 16px; border-radius: 24px;
            border: 1.5px solid var(--mau-vien);
            background: var(--mau-trang); font-size: 12px; font-weight: 600;
            color: var(--mau-chu-phu); cursor: pointer; transition: all 0.2s;
        }
        .nut-loc-tg:hover { border-color: var(--mau-chu-de-sang); color: var(--mau-chu-de); background: var(--mau-xanh-nhat); }
        .nut-loc-tg.dang-chon {
            background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
            color: #fff; border-color: transparent;
            box-shadow: 0 4px 12px rgba(26,86,219,0.3);
        }
        .nhan-cap-nhat {
            font-size: 11px; color: var(--mau-chu-phu);
            display: flex; align-items: center; gap: 5px; margin-left: auto;
        }

        /* ====================== LƯỚI THỐNG KÊ TỔNG QUAN ====================== */
        .luoi-tong-quan {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .card-tq {
            background: var(--mau-trang);
            border-radius: 16px;
            padding: 20px;
            box-shadow: var(--bong-card);
            border: 1px solid var(--mau-vien);
            display: flex; align-items: center; gap: 16px;
            position: relative; overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: default;
        }
        .card-tq:hover { transform: translateY(-2px); box-shadow: var(--bong-card-hover); }
        .card-tq::after {
            content: ''; position: absolute; top: 0; left: 0; right: 0;
            height: 3px; border-radius: 16px 16px 0 0;
        }
        .card-tq.xanh::after    { background: linear-gradient(90deg, #1a56db, #3b82f6); }
        .card-tq.xanh-la::after { background: linear-gradient(90deg, #059669, #34d399); }
        .card-tq.cam::after     { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
        .card-tq.do::after      { background: linear-gradient(90deg, #dc2626, #ef4444); }
        .card-tq.tim::after     { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
        .card-tq.hong::after    { background: linear-gradient(90deg, #db2777, #f472b6); }
        .card-tq.xanh-duong::after { background: linear-gradient(90deg, #0891b2, #22d3ee); }
        .card-tq.xam::after     { background: linear-gradient(90deg, #475569, #94a3b8); }

        .icon-tq {
            width: 52px; height: 52px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; flex-shrink: 0;
        }
        .icon-tq.xanh     { background: #eff6ff; color: #1a56db; }
        .icon-tq.xanh-la  { background: #f0fdf4; color: #059669; }
        .icon-tq.cam      { background: #fffbeb; color: #d97706; }
        .icon-tq.do       { background: #fff1f2; color: #dc2626; }
        .icon-tq.tim      { background: #f5f3ff; color: #7c3aed; }
        .icon-tq.hong     { background: #fdf2f8; color: #db2777; }
        .icon-tq.xanh-duong { background: #ecfeff; color: #0891b2; }
        .icon-tq.xam      { background: #f8fafc; color: #475569; }

        .info-tq .so-tq {
            font-size: 28px; font-weight: 800; line-height: 1.1;
        }
        .info-tq .so-tq.xanh     { color: #1a56db; }
        .info-tq .so-tq.xanh-la  { color: #059669; }
        .info-tq .so-tq.cam      { color: #d97706; }
        .info-tq .so-tq.do       { color: #dc2626; }
        .info-tq .so-tq.tim      { color: #7c3aed; }
        .info-tq .so-tq.hong     { color: #db2777; }
        .info-tq .so-tq.xanh-duong { color: #0891b2; }
        .info-tq .so-tq.xam      { color: #475569; }
        .info-tq .nhan-tq {
            font-size: 12px; color: var(--mau-chu-phu); margin-top: 3px; font-weight: 500;
        }
        .info-tq .phan-tram {
            font-size: 11px; margin-top: 4px; font-weight: 600;
            display: flex; align-items: center; gap: 4px;
        }
        .info-tq .phan-tram.tang { color: #059669; }
        .info-tq .phan-tram.giam { color: #dc2626; }

        /* ====================== LƯỚI 2 CỘT BIỂU ĐỒ ====================== */
        .luoi-bieu-do {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        .luoi-bieu-do-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .card-bieu-do {
            background: var(--mau-trang);
            border-radius: 16px;
            padding: 22px;
            box-shadow: var(--bong-card);
            border: 1px solid var(--mau-vien);
        }
        .tieu-de-card {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 18px;
        }
        .tieu-de-card h3 {
            font-size: 14px; font-weight: 700;
            display: flex; align-items: center; gap: 8px;
        }
        .tieu-de-card h3 i { color: var(--mau-chu-de); font-size: 14px; }
        .tieu-de-card .nhan-nho {
            font-size: 11px; color: var(--mau-chu-phu);
            background: var(--mau-nen); padding: 4px 10px; border-radius: 20px;
        }
        .khung-bieu-do { position: relative; }

        /* ====================== LƯỚI 3 CỘT DƯỚI ====================== */
        .luoi-duoi {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        /* ====================== BẢNG TOP PHÒNG ====================== */
        .bang-top { width: 100%; border-collapse: collapse; }
        .bang-top th {
            font-size: 11px; font-weight: 700; color: var(--mau-chu-phu);
            text-transform: uppercase; letter-spacing: 0.5px;
            padding: 0 0 10px 0; border-bottom: 1.5px solid var(--mau-vien);
            text-align: left;
        }
        .bang-top th:last-child { text-align: right; }
        .bang-top td {
            padding: 10px 0; border-bottom: 1px solid var(--mau-vien);
            font-size: 13px; vertical-align: middle;
        }
        .bang-top tr:last-child td { border-bottom: none; }
        .bang-top td:last-child { text-align: right; }
        .so-thu-tu {
            width: 24px; height: 24px; border-radius: 8px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 800; margin-right: 8px;
        }
        .so-thu-tu.vang { background: #fef3c7; color: #d97706; }
        .so-thu-tu.bac  { background: #f1f5f9; color: #64748b; }
        .so-thu-tu.dong { background: #fff7ed; color: #c2410c; }
        .so-thu-tu.khac { background: var(--mau-nen); color: var(--mau-chu-phu); }
        .ten-phong-top { font-weight: 700; color: var(--mau-chu); }
        .tien-top { font-weight: 800; color: var(--mau-chu-de); }

        /* ====================== DANH SÁCH HOẠT ĐỘNG GẦN ĐÂY ====================== */
        .ds-hoat-dong { list-style: none; }
        .ds-hoat-dong li {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 10px 0; border-bottom: 1px solid var(--mau-vien);
        }
        .ds-hoat-dong li:last-child { border-bottom: none; }
        .icon-hoat-dong {
            width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 14px;
        }
        .icon-hoat-dong.hd   { background: #eff6ff; color: #1a56db; }
        .icon-hoat-dong.dv   { background: #f0fdf4; color: #059669; }
        .icon-hoat-dong.sc   { background: #fff1f2; color: #dc2626; }
        .icon-hoat-dong.hop  { background: #f5f3ff; color: #7c3aed; }
        .noi-dung-hd .tieu-de-hd {
            font-size: 13px; font-weight: 600; color: var(--mau-chu); line-height: 1.3;
        }
        .noi-dung-hd .thoi-gian-hd {
            font-size: 11px; color: var(--mau-chu-phu); margin-top: 2px;
        }

        /* ====================== TRẠNG THÁI PHÒNG MINI ====================== */
        .ds-trang-thai-phong {
            display: flex; flex-direction: column; gap: 10px;
        }
        .hang-tt-phong {
            display: flex; align-items: center; gap: 10px;
        }
        .nhan-tt {
            font-size: 12px; font-weight: 600; color: var(--mau-chu); flex: 1;
            display: flex; align-items: center; gap: 8px;
        }
        .diem-tt {
            width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
        }
        .diem-tt.xanh-la { background: #10b981; }
        .diem-tt.xanh    { background: #3b82f6; }
        .diem-tt.cam     { background: #f59e0b; }
        .thanh-tt {
            flex: 2; height: 8px; background: var(--mau-nen);
            border-radius: 10px; overflow: hidden;
        }
        .thanh-tt-fill {
            height: 100%; border-radius: 10px;
            transition: width 0.8s cubic-bezier(.4,0,.2,1);
        }
        .thanh-tt-fill.xanh-la { background: linear-gradient(90deg, #059669, #34d399); }
        .thanh-tt-fill.xanh    { background: linear-gradient(90deg, #1a56db, #3b82f6); }
        .thanh-tt-fill.cam     { background: linear-gradient(90deg, #d97706, #fbbf24); }
        .so-tt { font-size: 12px; font-weight: 700; color: var(--mau-chu); min-width: 28px; text-align: right; }

        /* ====================== HOÁ ĐƠN TRẠNG THÁI ====================== */
        .ds-tt-hoadon { display: flex; flex-direction: column; gap: 8px; }
        .hang-tt-hoadon {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--mau-nen); border-radius: 10px; padding: 10px 14px;
        }
        .ten-tt-hoadon { font-size: 12px; font-weight: 600; color: var(--mau-chu); }
        .so-tt-hoadon { font-size: 16px; font-weight: 800; }
        .so-tt-hoadon.chua-dong { color: #d97706; }
        .so-tt-hoadon.da-hoan-thanh { color: #059669; }
        .so-tt-hoadon.qua-han { color: #dc2626; }
        .so-tt-hoadon.cho-duyet { color: #7c3aed; }

        /* ====================== BADGE ====================== */
        .badge {
            padding: 3px 10px; border-radius: 20px; font-size: 11px;
            font-weight: 600; white-space: nowrap; display: inline-block;
        }
        .badge.dang-thue   { background: #dcfce7; color: #16a34a; }
        .badge.trong       { background: #dbeafe; color: #1d4ed8; }
        .badge.dang-sua    { background: #fef3c7; color: #d97706; }

        /* ====================== DOANH THU THÁNG NÀY ====================== */
        .card-doanh-thu-noi-bat {
            background: linear-gradient(135deg, #1a56db 0%, #3b82f6 50%, #0891b2 100%);
            border-radius: 16px; padding: 22px;
            box-shadow: 0 8px 32px rgba(26,86,219,0.3);
            color: #fff; position: relative; overflow: hidden;
        }
        .card-doanh-thu-noi-bat::before {
            content: ''; position: absolute; top: -40px; right: -40px;
            width: 160px; height: 160px; border-radius: 50%;
            background: rgba(255,255,255,0.07);
        }
        .card-doanh-thu-noi-bat::after {
            content: ''; position: absolute; bottom: -60px; right: 20px;
            width: 200px; height: 200px; border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }
        .dt-noi-bat-nhan { font-size: 12px; opacity: 0.8; font-weight: 600; margin-bottom: 8px; }
        .dt-noi-bat-so { font-size: 26px; font-weight: 800; margin-bottom: 4px; position: relative; z-index: 1; }
        .dt-noi-bat-phu { font-size: 11px; opacity: 0.7; margin-bottom: 16px; }
        .dt-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: relative; z-index: 1; }
        .dt-mini-item {
            background: rgba(255,255,255,0.15); border-radius: 10px; padding: 10px;
        }
        .dt-mini-item .nhan { font-size: 10px; opacity: 0.75; margin-bottom: 4px; }
        .dt-mini-item .gia-tri { font-size: 13px; font-weight: 700; }

        /* ====================== SCROLLBAR ====================== */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* ====================== RESPONSIVE ====================== */
        @@media (max-width: 1400px) {
            .luoi-tong-quan { grid-template-columns: repeat(4, 1fr); }
        }
        @@media (max-width: 1200px) {
            .luoi-tong-quan { grid-template-columns: repeat(2, 1fr); }
            .luoi-bieu-do { grid-template-columns: 1fr; }
            .luoi-duoi { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 900px) {
            .luoi-bieu-do-2 { grid-template-columns: 1fr; }
            .luoi-duoi { grid-template-columns: 1fr; }
        }
        @@media (max-width: 768px) {
            #thanh-sidebar { width: 0; min-width: 0; overflow: hidden; }
            #thanh-sidebar.mo { width: 220px; min-width: 220px; }
            #noi-dung-trang { padding: 16px; }
            .luoi-tong-quan { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 480px) {
            .luoi-tong-quan { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- ====================== SIDEBAR ====================== -->
<nav id="thanh-sidebar">
    <div class="logo-sidebar">
        <div class="bieu-tuong">
            <img src="~/images/LogoBaNam.png" alt="Logo" />
        </div>
        <div class="ten-logo">
            <strong>Nhà Trọ Bà Năm</strong>
            <span>Quản lý hệ thống</span>
        </div>
    </div>

    <div class="nhan-nhom">Tổng quan</div>
    <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
        <i class="fas fa-home"></i><span>Trang chủ</span>
    </div>

    <div class="nhan-nhom">Quản lý</div>
    <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
        <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
    </div>
    <div class="menu-item" onclick="chuyenTrang('quan-ly-dich-vu', this)">
        <i class="fas fa-users"></i><span>Dịch vụ & Tiện ích</span>
    </div>
    <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
        <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn & Thu tiền</span>
    </div>

    <div class="nhan-nhom">Hỗ trợ</div>
    <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
        <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
        @if (Model.SoSuCoChoXuLy > 0)
        {
            <span class="huy-hieu-menu">@Model.SoSuCoChoXuLy</span>
        }
    </div>
    <div class="menu-item dang-chon" onclick="chuyenTrang('bao-cao', this)">
        <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
    </div>
    <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
        <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
    </div>

    <div class="admin-sidebar">
        <div class="anh-admin">
            @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
            {
                <img src="@Model.CurrentUser.Avatar"
                     style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="Avatar" />
            }
            else
            {
                @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
            }
        </div>
        <div class="ten-admin">
            <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
            <span>@(Model.CurrentUser?.Roles ?? "Quản trị viên")</span>
        </div>
    </div>
</nav>

<!-- ====================== KHU VỰC CHÍNH ====================== -->
<div id="khu-vuc-chinh">

    <!-- HEADER -->
    <header id="thanh-header">
        <div class="header-trai">
            <button class="nut-ham-menu" onclick="dongMoSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <div>
                <div class="tieu-de-trang">Thống Kê & Báo Cáo</div>
                <div class="duong-dan">Trang chủ / Báo cáo / Thống kê</div>
            </div>
        </div>
        <div class="header-phai">
            <button class="nut-thong-bao">
                <i class="fas fa-bell"></i>
                @if (Model.SoThongBaoChuaDoc > 0)
                {
                    <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                }
            </button>
            <div class="thong-tin-admin">
                <div class="anh-dai-dien">
                    @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                </div>
                <div>
                    <div class="ten">@(Model.CurrentUser?.FullName ?? "Admin")</div>
                    <div class="chuc-vu">@(Model.CurrentUser?.Roles ?? "Quản trị viên")</div>
                </div>
                <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
            </div>
        </div>
    </header>

    <!-- NỘI DUNG TRANG -->
    <div id="noi-dung-trang">

        <!-- ====== TIÊU ĐỀ + BỘ LỌC THỜI GIAN ====== -->
        <div class="hang-tieu-de">
            <div>
                <h2><i class="fas fa-chart-bar"></i> Thống Kê & Báo Cáo</h2>
                <p id="ngay-gio-hien-tai">Đang tải...</p>
            </div>
            <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                <div class="thanh-loc-tg">
                    <button class="nut-loc-tg" onclick="locThoiGian('hom-nay', this)">Hôm nay</button>
                    <button class="nut-loc-tg" onclick="locThoiGian('7-ngay', this)">7 ngày</button>
                    <button class="nut-loc-tg dang-chon" id="nut-thang-nay" onclick="locThoiGian('thang-nay', this)">Tháng này</button>
                    <button class="nut-loc-tg" onclick="locThoiGian('nam-nay', this)">Năm nay</button>
                </div>
                <div class="nhan-cap-nhat">
                    <i class="fas fa-sync-alt" style="font-size:10px;"></i>
                    Cập nhật: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")
                </div>
            </div>
        </div>

        <!-- ====== THỐNG KÊ TỔNG QUAN (8 CARD) ====== -->
        <div class="luoi-tong-quan" id="luoi-tong-quan">
            <!-- 1. Tổng phòng -->
            <div class="card-tq xanh">
                <div class="icon-tq xanh"><i class="fas fa-building"></i></div>
                <div class="info-tq">
                    <div class="so-tq xanh" id="tk-tong-phong">@Model.TongSoPhong</div>
                    <div class="nhan-tq">Tổng số phòng</div>
                </div>
            </div>
            <!-- 2. Phòng đang thuê -->
            <div class="card-tq xanh-la">
                <div class="icon-tq xanh-la"><i class="fas fa-door-closed"></i></div>
                <div class="info-tq">
                    <div class="so-tq xanh-la" id="tk-phong-thue">@Model.PhongDangThue</div>
                    <div class="nhan-tq">Phòng đang thuê</div>
                    <div class="phan-tram tang" id="tk-tile-lapday">
                        <i class="fas fa-arrow-up"></i> @Model.TiLeLapDay.ToString("0.0")% lấp đầy
                    </div>
                </div>
            </div>
            <!-- 3. Phòng trống -->
            <div class="card-tq xanh-duong">
                <div class="icon-tq xanh-duong"><i class="fas fa-door-open"></i></div>
                <div class="info-tq">
                    <div class="so-tq xanh-duong" id="tk-phong-trong">@Model.PhongConTrong</div>
                    <div class="nhan-tq">Phòng còn trống</div>
                </div>
            </div>
            <!-- 4. Phòng đang sửa -->
            <div class="card-tq cam">
                <div class="icon-tq cam"><i class="fas fa-tools"></i></div>
                <div class="info-tq">
                    <div class="so-tq cam" id="tk-phong-sua">@Model.PhongDangSua</div>
                    <div class="nhan-tq">Phòng đang sửa</div>
                </div>
            </div>
            <!-- 5. Doanh thu tháng này -->
            <div class="card-tq xanh">
                <div class="icon-tq xanh"><i class="fas fa-money-bill-wave"></i></div>
                <div class="info-tq">
                    <div class="so-tq xanh" style="font-size:18px;" id="tk-dt-thang">@Model.DoanhThuThangNay.ToString("N0")₫</div>
                    <div class="nhan-tq">Doanh thu tháng này</div>
                    @if (Model.TangTruongDoanhThu >= 0)
                    {
                        <div class="phan-tram tang"><i class="fas fa-arrow-up"></i> +@Model.TangTruongDoanhThu.ToString("0.0")% so tháng trước</div>
                    }
                    else
                    {
                        <div class="phan-tram giam"><i class="fas fa-arrow-down"></i> @Model.TangTruongDoanhThu.ToString("0.0")% so tháng trước</div>
                    }
                </div>
            </div>
            <!-- 6. Người thuê -->
            <div class="card-tq tim">
                <div class="icon-tq tim"><i class="fas fa-users"></i></div>
                <div class="info-tq">
                    <div class="so-tq tim" id="tk-nguoi-thue">@Model.SoNguoiThue</div>
                    <div class="nhan-tq">Người thuê hiện tại</div>
                </div>
            </div>
            <!-- 7. Hóa đơn chưa đóng -->
            <div class="card-tq cam">
                <div class="icon-tq cam"><i class="fas fa-file-invoice"></i></div>
                <div class="info-tq">
                    <div class="so-tq cam" id="tk-hd-chua-dong">@Model.HoaDonChuaDong</div>
                    <div class="nhan-tq">Hóa đơn chưa đóng</div>
                    @if (Model.HoaDonQuaHan > 0)
                    {
                        <div class="phan-tram giam"><i class="fas fa-exclamation-triangle"></i> @Model.HoaDonQuaHan quá hạn</div>
                    }
                </div>
            </div>
            <!-- 8. Sự cố / đơn DV chờ xử lý -->
            <div class="card-tq do">
                <div class="icon-tq do"><i class="fas fa-exclamation-circle"></i></div>
                <div class="info-tq">
                    <div class="so-tq do" id="tk-don-cho">@Model.DonDVChoXuLy</div>
                    <div class="nhan-tq">Đơn DV chờ xử lý</div>
                    @if (Model.DonDVKhanCap > 0)
                    {
                        <div class="phan-tram giam"><i class="fas fa-fire"></i> @Model.DonDVKhanCap khẩn cấp</div>
                    }
                </div>
            </div>
        </div>

        <!-- ====== HÀNG 1: BIỂU ĐỒ DOANH THU + TRẠNG THÁI PHÒNG ====== -->
        <div class="luoi-bieu-do">
            <!-- Biểu đồ doanh thu 12 tháng -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-chart-line"></i> Doanh Thu Theo Tháng</h3>
                    <span class="nhan-nho">Năm @DateTime.Now.Year</span>
                </div>
                <div class="khung-bieu-do" style="height:260px;">
                    <canvas id="bieu-do-doanh-thu"></canvas>
                </div>
            </div>
            <!-- Trạng thái phòng + Doanh thu nổi bật -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <!-- Card doanh thu nổi bật -->
                <div class="card-doanh-thu-noi-bat">
                    <div class="dt-noi-bat-nhan"><i class="fas fa-chart-bar"></i> DOANH THU NĂM NAY</div>
                    <div class="dt-noi-bat-so">@Model.DoanhThuNamNay.ToString("N0")₫</div>
                    <div class="dt-noi-bat-phu">Tổng @Model.SoHoaDonDaDong hóa đơn đã thanh toán</div>
                    <div class="dt-mini-grid">
                        <div class="dt-mini-item">
                            <div class="nhan">Tiền phòng</div>
                            <div class="gia-tri">@Model.TongTienPhongNam.ToString("N0")₫</div>
                        </div>
                        <div class="dt-mini-item">
                            <div class="nhan">Điện & Nước</div>
                            <div class="gia-tri">@Model.TongTienDienNuocNam.ToString("N0")₫</div>
                        </div>
                        <div class="dt-mini-item">
                            <div class="nhan">Dịch vụ</div>
                            <div class="gia-tri">@Model.TongTienDVNam.ToString("N0")₫</div>
                        </div>
                        <div class="dt-mini-item">
                            <div class="nhan">Tháng tốt nhất</div>
                            <div class="gia-tri">@Model.ThangTotNhat</div>
                        </div>
                    </div>
                </div>
                <!-- Trạng thái phòng -->
                <div class="card-bieu-do" style="flex:1;">
                    <div class="tieu-de-card" style="margin-bottom:14px;">
                        <h3><i class="fas fa-door-open"></i> Trạng Thái Phòng</h3>
                    </div>
                    <div class="ds-trang-thai-phong">
                        @{
                            int tongPhong = Model.TongSoPhong > 0 ? Model.TongSoPhong : 1;
                        }
                        <div class="hang-tt-phong">
                            <div class="nhan-tt"><span class="diem-tt xanh-la"></span>Đang thuê</div>
                            <div class="thanh-tt">
                                <div class="thanh-tt-fill xanh-la" style="width:@((Model.PhongDangThue * 100 / tongPhong).ToString())%"></div>
                            </div>
                            <div class="so-tt">@Model.PhongDangThue</div>
                        </div>
                        <div class="hang-tt-phong">
                            <div class="nhan-tt"><span class="diem-tt xanh"></span>Còn trống</div>
                            <div class="thanh-tt">
                                <div class="thanh-tt-fill xanh" style="width:@((Model.PhongConTrong * 100 / tongPhong).ToString())%"></div>
                            </div>
                            <div class="so-tt">@Model.PhongConTrong</div>
                        </div>
                        <div class="hang-tt-phong">
                            <div class="nhan-tt"><span class="diem-tt cam"></span>Đang sửa</div>
                            <div class="thanh-tt">
                                <div class="thanh-tt-fill cam" style="width:@((Model.PhongDangSua * 100 / tongPhong).ToString())%"></div>
                            </div>
                            <div class="so-tt">@Model.PhongDangSua</div>
                        </div>
                    </div>
                    <!-- Biểu đồ tròn trạng thái phòng -->
                    <div class="khung-bieu-do" style="height:130px;margin-top:14px;">
                        <canvas id="bieu-do-phong"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====== HÀNG 2: BIỂU ĐỒ ĐƠN DV + CƠ CẤU DOANH THU ====== -->
        <div class="luoi-bieu-do-2">
            <!-- Biểu đồ cột loại đơn DV -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-concierge-bell"></i> Thống Kê Đơn Dịch Vụ</h3>
                    <span class="nhan-nho">Theo loại & trạng thái</span>
                </div>
                <div class="khung-bieu-do" style="height:220px;">
                    <canvas id="bieu-do-dich-vu"></canvas>
                </div>
            </div>
            <!-- Biểu đồ cơ cấu doanh thu -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-chart-pie"></i> Cơ Cấu Doanh Thu</h3>
                    <span class="nhan-nho">Tháng @DateTime.Now.Month/@DateTime.Now.Year</span>
                </div>
                <div class="khung-bieu-do" style="height:220px;">
                    <canvas id="bieu-do-co-cau"></canvas>
                </div>
            </div>
        </div>

        <!-- ====== HÀNG 3: TOP PHÒNG + HĐ TRẠNG THÁI + HOẠT ĐỘNG GẦN ĐÂY ====== -->
        <div class="luoi-duoi">
            <!-- TOP 5 PHÒNG DOANH THU CAO -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-trophy"></i> Top Phòng Doanh Thu</h3>
                    <span class="nhan-nho">Năm @DateTime.Now.Year</span>
                </div>
                @if (Model.TopPhongDoanhThu.Any())
                {
                    <table class="bang-top">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Phòng</th>
                                <th>Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var p in Model.TopPhongDoanhThu)
                            {
                                string sttClass = stt == 1 ? "vang" : stt == 2 ? "bac" : stt == 3 ? "dong" : "khac";
                                <tr>
                                    <td><span class="so-thu-tu @sttClass">@stt</span></td>
                                    <td>
                                        <span class="ten-phong-top">Phòng @p.SoPhong</span>
                                        <br><small style="color:var(--mau-chu-phu);font-size:11px;">@p.SoHoaDon hóa đơn</small>
                                    </td>
                                    <td><span class="tien-top">@p.TongDoanhThu.ToString("N0")₫</span></td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p style="font-size:13px;color:var(--mau-chu-phu);text-align:center;padding:20px 0;">Chưa có dữ liệu</p>
                }
            </div>

            <!-- TRẠNG THÁI HÓA ĐƠN -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-file-invoice-dollar"></i> Trạng Thái Hóa Đơn</h3>
                    <span class="nhan-nho">Tháng này</span>
                </div>
                <div class="ds-tt-hoadon">
                    <div class="hang-tt-hoadon">
                        <div>
                            <div class="ten-tt-hoadon">✅ Đã hoàn thành</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">Đã thanh toán đầy đủ</div>
                        </div>
                        <div class="so-tt-hoadon da-hoan-thanh">@Model.HoaDonDaHoanThanh</div>
                    </div>
                    <div class="hang-tt-hoadon">
                        <div>
                            <div class="ten-tt-hoadon">🕐 Chưa đóng</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">Đang chờ thanh toán</div>
                        </div>
                        <div class="so-tt-hoadon chua-dong">@Model.HoaDonChuaDong</div>
                    </div>
                    <div class="hang-tt-hoadon">
                        <div>
                            <div class="ten-tt-hoadon">🔍 Chờ duyệt</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">Đã chuyển khoản, chờ xác nhận</div>
                        </div>
                        <div class="so-tt-hoadon cho-duyet">@Model.HoaDonChoDuyet</div>
                    </div>
                    <div class="hang-tt-hoadon">
                        <div>
                            <div class="ten-tt-hoadon">⚠️ Quá hạn</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">Đã qua hạn đóng</div>
                        </div>
                        <div class="so-tt-hoadon qua-han">@Model.HoaDonQuaHan</div>
                    </div>
                </div>
                <!-- Mini biểu đồ hóa đơn -->
                <div class="khung-bieu-do" style="height:100px;margin-top:14px;">
                    <canvas id="bieu-do-hoadon"></canvas>
                </div>
            </div>

            <!-- HOẠT ĐỘNG GẦN ĐÂY -->
            <div class="card-bieu-do">
                <div class="tieu-de-card">
                    <h3><i class="fas fa-history"></i> Hoạt Động Gần Đây</h3>
                    <span class="nhan-nho">10 gần nhất</span>
                </div>
                <ul class="ds-hoat-dong">
                    @foreach (var hd in Model.HoatDongGanDay)
                    {
                        <li>
                            <div class="icon-hoat-dong @hd.CssClass">
                                <i class="fas @hd.Icon"></i>
                            </div>
                            <div class="noi-dung-hd">
                                <div class="tieu-de-hd">@hd.TieuDe</div>
                                <div class="thoi-gian-hd">@hd.ThoiGian</div>
                            </div>
                        </li>
                    }
                    @if (!Model.HoatDongGanDay.Any())
                    {
                        <li><div style="font-size:13px;color:var(--mau-chu-phu);padding:12px 0;">Chưa có hoạt động nào</div></li>
                    }
                </ul>
            </div>
        </div>

    </div><!-- Kết thúc noi-dung-trang -->
</div><!-- Kết thúc khu-vuc-chinh -->

<!-- ====================== DỮ LIỆU RAZOR → JS (Chart.js) ====================== -->
<script>
// Inject dữ liệu từ Model ra JS để vẽ Chart
const duLieuBieuDo = {
    doanhThuTheoThang: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang)),
    loaiDonDV:         @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeLoaiDonDV)),
    coCauDoanhThu: {
        tienPhong: @Model.DoanhThuThangNay_TienPhong,
        tienDien:  @Model.DoanhThuThangNay_TienDien,
        tienNuoc:  @Model.DoanhThuThangNay_TienNuoc,
        tienDV:    @Model.DoanhThuThangNay_TienDV
    },
    trangThaiPhong: {
        dangThue:  @Model.PhongDangThue,
        conTrong:  @Model.PhongConTrong,
        dangSua:   @Model.PhongDangSua
    },
    trangThaiHoaDon: {
        daHoanThanh: @Model.HoaDonDaHoanThanh,
        chuaDong:    @Model.HoaDonChuaDong,
        choDuyet:    @Model.HoaDonChoDuyet,
        quaHan:      @Model.HoaDonQuaHan
    }
};

// ====== NGÀY GIỜ ======
(function () {
    const ngay = new Date();
    const tuan = ['Chủ nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
    document.getElementById('ngay-gio-hien-tai').textContent =
        `${tuan[ngay.getDay()]}, ${ngay.getDate()} tháng ${ngay.getMonth() + 1} năm ${ngay.getFullYear()}`;
})();

// ====== CHART DEFAULTS ======
Chart.defaults.font.family = "'Segoe UI', sans-serif";
Chart.defaults.font.size = 11;

// ====== 1. BIỂU ĐỒ DOANH THU 12 THÁNG ======
(function () {
    const nhans = ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'];
    const data = duLieuBieuDo.doanhThuTheoThang; // mảng 12 phần tử

    const ctx = document.getElementById('bieu-do-doanh-thu').getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 260);
    grad.addColorStop(0, 'rgba(26,86,219,0.25)');
    grad.addColorStop(1, 'rgba(26,86,219,0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: nhans,
            datasets: [{
                label: 'Doanh thu (₫)',
                data: data,
                borderColor: '#1a56db',
                backgroundColor: grad,
                borderWidth: 2.5,
                pointBackgroundColor: '#1a56db',
                pointRadius: 4,
                pointHoverRadius: 6,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ' ' + ctx.parsed.y.toLocaleString('vi-VN') + '₫'
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.04)' },
                    ticks: {
                        callback: v => v >= 1000000
                            ? (v / 1000000).toFixed(0) + 'M'
                            : v >= 1000 ? (v / 1000).toFixed(0) + 'K' : v
                    }
                },
                x: { grid: { display: false } }
            }
        }
    });
})();

// ====== 2. BIỂU ĐỒ TRÒN TRẠNG THÁI PHÒNG ======
(function () {
