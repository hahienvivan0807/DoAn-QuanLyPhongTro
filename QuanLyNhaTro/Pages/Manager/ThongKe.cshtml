@page "/Manager/ThongKe"
@model QuanLyNhaTro.Pages.Manager.ThongKeModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhập Liệu Thống Kê</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Manager/ThongKe.css" />
</head>
<body>

    <!-- ====================== SIDEBAR ====================== -->
    <nav id="thanh-sidebar">
        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('phong-cua-toi', this)">
            <i class="fas fa-door-open"></i>
            <span>Phòng của tôi</span>
        </div>

        <div class="nhan-nhom">Quản lý</div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-dich-vu', this)">
            <i class="fas fa-users"></i><span>Dịch vụ & Tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn & Thu tiền</span>
        </div>

        <div class="nhan-nhom">Hỗ trợ</div>
        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>
        <div class="menu-item dang-chon" onclick="chuyenTrang('bao-cao', this)">
            <i class="fas fa-chart-bar"></i><span>Thống kê & Báo cáo</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="admin-sidebar">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.Avatar))
                {
                    <img src="@Model.CurrentUser.Avatar"
                         style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="Avatar" />
                }
                else
                {
                    @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                }
            </div>
            <div class="ten-admin">
                <strong>@(Model.CurrentUser?.FullName ?? "Admin")</strong>
                <span>@(Model.CurrentUser?.Roles ?? "Quản trị viên")</span>
            </div>
        </div>
    </nav>

    <!-- ====================== KHU VỰC CHÍNH ====================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Nhập Liệu Thống Kê</div>
                    <div class="duong-dan">Trang chủ / Báo cáo / Nhập liệu</div>
                </div>
            </div>
            <div class="header-phai">
                <button class="nut-thong-bao">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>
                <div class="thong-tin-admin">
                    <div class="anh-dai-dien">
                        @(Model.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div>
                        <div class="ten">@(Model.CurrentUser?.FullName ?? "Admin")</div>
                        <div class="chuc-vu">@(Model.CurrentUser?.Roles ?? "Quản trị viên")</div>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;"></i>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG TRANG -->
        <div id="noi-dung-trang">

            <!-- ====== TIÊU ĐỀ ====== -->
            <div class="hang-tieu-de">
                <div>
                    <h2><i class="fas fa-database"></i> Nhập Liệu Thống Kê</h2>
                    <p>Cập nhật thủ công dữ liệu tổng quan và doanh thu theo tháng vào hệ thống</p>
                </div>
                <div style="font-size:12px;color:var(--mau-chu-phu);display:flex;align-items:center;gap:6px;">
                    <i class="fas fa-clock" style="color:var(--mau-chu-de);"></i>
                    Cập nhật lần cuối:
                    @* Dữ liệu tính trực tiếp từ DB, hiển thị thời điểm tải trang *@
                    <span>@DateTime.Now.ToString("HH:mm dd/MM/yyyy")</span>
                </div>
            </div>

            <!-- ====== THÔNG BÁO THÀNH CÔNG / LỖI ====== -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-thanh-cong" id="alert-success">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button class="alert-close" onclick="dongAlert('alert-success')">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-loi" id="alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button class="alert-close" onclick="dongAlert('alert-error')">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }

            <!-- ====== CARD THỐNG KÊ TỔNG QUAN (CHỈ ĐỌC) ====== -->
            <div class="card-tong-quan">
                <div class="card-tong-quan-header">
                    <h3><i class="fas fa-tachometer-alt"></i> Thống Kê Tổng Quan</h3>
                    <span class="nhan-tu-dong">Tự động từ DB</span>
                </div>
                <div class="card-tong-quan-body">

                    <!-- Nhóm: Phòng -->
                    <div class="nhan-nhom-tq">
                        <i class="fas fa-door-open"></i> Trạng thái phòng
                    </div>
                    <div class="luoi-mini-card">
                        <div class="mini-card">
                            <div class="mini-card-nhan">Tổng số phòng</div>
                            <div class="mini-card-gia-tri">@Model.TongSoPhong</div>
                            <div class="mini-card-don-vi">phòng</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Đang thuê</div>
                            <div class="mini-card-gia-tri">@Model.PhongDangThue</div>
                            <div class="mini-card-don-vi">phòng</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Còn trống</div>
                            <div class="mini-card-gia-tri">@Model.PhongConTrong</div>
                            <div class="mini-card-don-vi">phòng</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Đang sửa</div>
                            <div class="mini-card-gia-tri">@Model.PhongDangSua</div>
                            <div class="mini-card-don-vi">phòng</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Tỉ lệ lấp đầy</div>
                            <div class="mini-card-gia-tri">@Model.TiLeLapDay.ToString("N2")</div>
                            <div class="mini-card-don-vi">%</div>
                        </div>
                    </div>

                    <!-- Nhóm: Doanh thu -->
                    <div class="nhan-nhom-tq">
                        <i class="fas fa-money-bill-wave"></i> Doanh thu
                    </div>
                    <div class="luoi-mini-card">
                        <div class="mini-card">
                            <div class="mini-card-nhan">DT tháng này</div>
                            <div class="mini-card-gia-tri">@Model.DoanhThuThangNay.ToString("N0")</div>
                            <div class="mini-card-don-vi">₫</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">DT tháng trước</div>
                            <div class="mini-card-gia-tri">@Model.DoanhThuThangTruoc.ToString("N0")</div>
                            <div class="mini-card-don-vi">₫</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Tăng trưởng</div>
                            @{
                                /* Màu xanh nếu >= 0, đỏ nếu < 0; hiển thị dấu +/- */
                                var ttClass = Model.TangTruongDoanhThu >= 0 ? "mau-xanh" : "mau-do";
                                var ttDau = Model.TangTruongDoanhThu >= 0 ? "+" : "";
                            }
                            <div class="mini-card-gia-tri @ttClass">@(ttDau)@Model.TangTruongDoanhThu.ToString("N2")</div>
                            <div class="mini-card-don-vi">%</div>
                        </div>
                    </div>

                    <!-- Nhóm: Hóa đơn -->
                    <div class="nhan-nhom-tq">
                        <i class="fas fa-file-invoice"></i> Hóa đơn
                    </div>
                    <div class="luoi-mini-card">
                        <div class="mini-card">
                            <div class="mini-card-nhan">Chưa đóng</div>
                            <div class="mini-card-gia-tri">@Model.HoaDonChuaDong</div>
                            <div class="mini-card-don-vi">hóa đơn</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Sắp đến hạn</div>
                            <div class="mini-card-gia-tri">@Model.HoaDonSapDenHan</div>
                            <div class="mini-card-don-vi">hóa đơn</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Quá hạn</div>
                            @{
                                /* Màu đỏ nếu > 0 */
                                var hdqhClass = Model.HoaDonQuaHan > 0 ? "mau-do" : "";
                            }
                            <div class="mini-card-gia-tri @hdqhClass">@Model.HoaDonQuaHan</div>
                            <div class="mini-card-don-vi">hóa đơn</div>
                        </div>
                    </div>

                    <!-- Nhóm: Dịch vụ -->
                    <div class="nhan-nhom-tq">
                        <i class="fas fa-tools"></i> Đơn dịch vụ
                    </div>
                    <div class="luoi-mini-card">
                        <div class="mini-card">
                            <div class="mini-card-nhan">Chờ xử lý</div>
                            <div class="mini-card-gia-tri">@Model.DonDVChoXuLy</div>
                            <div class="mini-card-don-vi">đơn</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-nhan">Khẩn cấp</div>
                            @{
                                /* Màu đỏ nếu > 0 */
                                var dvkcClass = Model.DonDVKhanCap > 0 ? "mau-do" : "";
                            }
                            <div class="mini-card-gia-tri @dvkcClass">@Model.DonDVKhanCap</div>
                            <div class="mini-card-don-vi">đơn</div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- Kết thúc card tổng quan -->
            <!-- ====== LƯỚI 1 CỘT: FORM 2 ====== -->
            <div class="luoi-form">

                <!-- ========== FORM 2: THÊM/CẬP NHẬT THONGKE_DOANHTHU_THANG ========== -->
                <div class="card-form">
                    <div class="card-form-header">
                        <h3><i class="fas fa-calendar-alt"></i> Doanh Thu Theo Tháng</h3>
                        <span class="nhan-cap-nhat">Thêm mới / Cập nhật</span>
                    </div>
                    <div class="card-form-body">
                        <form method="post" asp-page-handler="UpdateDoanhThu">
                            @Html.AntiForgeryToken()

                            <!-- Nhóm: Kỳ -->
                            <div class="nhan-nhom-form">
                                <i class="fas fa-calendar-check"></i> Chọn kỳ nhập liệu
                            </div>
                            <div class="nhom-form luoi-input">
                                <div>
                                    <label for="DoanhThuThangInput_Thang">Tháng <span style="color:#ef4444;">*</span></label>
                                    <select id="DoanhThuThangInput_Thang" name="DoanhThuThangInput.Thang" class="truong-nhap">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            if (m == (int)Model.DoanhThuThangInput.Thang)
                                            {
                                                <option value="@m" selected>Tháng @m</option>
                                            }
                                            else
                                            {
                                                <option value="@m">Tháng @m</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_Nam">Năm <span style="color:#ef4444;">*</span></label>
                                    <input id="DoanhThuThangInput_Nam" name="DoanhThuThangInput.Nam"
                                           type="number" min="2000" max="2100" class="truong-nhap"
                                           value="@Model.DoanhThuThangInput.Nam" />
                                </div>
                            </div>

                            <!-- Nhóm: Chi tiết doanh thu — readonly, tính sẵn từ HDTHANG -->
                            <div class="nhan-nhom-form">
                                <i class="fas fa-coins"></i> Chi tiết doanh thu
                            </div>
                            <div class="nhom-form luoi-input">
                                <div>
                                    <label for="DoanhThuThangInput_TongTienPhong">Tổng tiền phòng (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_TongTienPhong" name="DoanhThuThangInput.TongTienPhong"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               readonly
                                               value="@Model.DoanhThuThangInput.TongTienPhong" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_TongTienDien">Tổng tiền điện (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_TongTienDien" name="DoanhThuThangInput.TongTienDien"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               readonly
                                               value="@Model.DoanhThuThangInput.TongTienDien" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_TongTienNuoc">Tổng tiền nước (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_TongTienNuoc" name="DoanhThuThangInput.TongTienNuoc"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               readonly
                                               value="@Model.DoanhThuThangInput.TongTienNuoc" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_TongTienDV">Tổng tiền dịch vụ (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_TongTienDV" name="DoanhThuThangInput.TongTienDV"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               readonly
                                               value="@Model.DoanhThuThangInput.TongTienDV" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Nhóm: Tổng kết — TongCong và SoHoaDonDaDong readonly, ChiPhiThang nhập tay -->
                            <div class="nhan-nhom-form">
                                <i class="fas fa-calculator"></i> Tổng kết tháng
                            </div>
                            <div class="nhom-form luoi-input ba-cot">
                                <div>
                                    <label for="DoanhThuThangInput_TongCong">Tổng cộng (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_TongCong" name="DoanhThuThangInput.TongCong"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               readonly
                                               value="@Model.DoanhThuThangInput.TongCong" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_SoHoaDonDaDong">Số HĐ đã đóng</label>
                                    <input id="DoanhThuThangInput_SoHoaDonDaDong" name="DoanhThuThangInput.SoHoaDonDaDong"
                                           type="number" min="0" class="truong-nhap"
                                           readonly
                                           value="@Model.DoanhThuThangInput.SoHoaDonDaDong" />
                                </div>
                                <div>
                                    <label for="DoanhThuThangInput_ChiPhiThang">Chi phí tháng (₫)</label>
                                    <div class="wrapper-don-vi">
                                        <input id="DoanhThuThangInput_ChiPhiThang" name="DoanhThuThangInput.ChiPhiThang"
                                               type="number" min="0" step="1000" class="truong-nhap don-vi"
                                               value="@Model.DoanhThuThangInput.ChiPhiThang" />
                                        <span class="don-vi-hien-thi">₫</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Gợi ý -->
                            <div style="background:var(--mau-xanh-nhat);border:1px solid var(--mau-xanh-trung);
                                border-radius:10px;padding:10px 14px;font-size:12px;
                                color:var(--mau-chu-de);margin-top:6px;display:flex;align-items:center;gap:8px;">
                                <i class="fas fa-info-circle"></i>
                                <span>
                                    Các ô tiền phòng, điện, nước, dịch vụ, tổng cộng và số HĐ đã đóng được tính sẵn từ hóa đơn tháng này.
                                    Chỉ nhập tay ô <strong>Chi phí tháng</strong> rồi bấm lưu.
                                </span>
                            </div>

                            <button type="submit" class="nut-submit chinh">
                                <i class="fas fa-save"></i> Lưu Doanh Thu Tháng
                            </button>
                        </form>
                    </div>
                </div>

            </div><!-- Kết thúc luoi-form -->
            <!-- ====== BẢNG LỊCH SỬ DOANH THU THÁNG ====== -->
            <div class="card-bang">
                <div class="card-bang-header">
                    <h3><i class="fas fa-history"></i> Lịch Sử Doanh Thu Theo Tháng</h3>
                    <span class="nhan-so">@Model.DanhSachDoanhThuThang.Count bản ghi</span>
                </div>

                @if (Model.DanhSachDoanhThuThang.Any())
                {
                    <div style="overflow-x:auto;">
                        <table class="bang-lich-su">
                            <thead>
                                <tr>
                                    <th>Kỳ</th>
                                    <th>Tiền phòng</th>
                                    <th>Điện</th>
                                    <th>Nước</th>
                                    <th>Dịch vụ</th>
                                    <th>Tổng cộng</th>
                                    <th>Chi phí</th>
                                    <th>HĐ đã đóng</th>
                                    <th>Cập nhật</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.DanhSachDoanhThuThang)
                                {
                                    <tr>
                                        <td>
                                            <span class="chip-thang">
                                                <i class="fas fa-calendar-alt" style="font-size:10px;"></i>
                                                T@(row.Thang)/@(row.Nam)
                                            </span>
                                        </td>
                                        <td class="so-tien">@row.TongTienPhong.ToString("N0")₫</td>
                                        <td>@row.TongTienDien.ToString("N0")₫</td>
                                        <td>@row.TongTienNuoc.ToString("N0")₫</td>
                                        <td>@row.TongTienDV.ToString("N0")₫</td>
                                        <td>
                                            <strong style="color:var(--mau-chu-de);">
                                                @row.TongCong.ToString("N0")₫
                                            </strong>
                                        </td>
                                        <td style="color:#dc2626;">@row.ChiPhiThang.ToString("N0")₫</td>
                                        <td>
                                            <span class="so-hoa-don">@row.SoHoaDonDaDong HĐ</span>
                                        </td>
                                        <td style="font-size:11px;color:var(--mau-chu-phu);white-space:nowrap;">
                                            @row.NgayCapNhat.ToString("dd/MM/yy HH:mm")
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="DeleteDoanhThu"
                                                  onsubmit="return confirm('Xóa dữ liệu tháng @(row.Thang)/@(row.Nam)?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@row.IDThongKe" />
                                                <button type="submit" class="nut-xoa">
                                                    <i class="fas fa-trash-alt"></i> Xóa
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="trong-rong">
                        <i class="fas fa-table"></i>
                        <p>Chưa có dữ liệu doanh thu theo tháng nào được ghi nhận.</p>
                    </div>
                }
            </div>

        </div><!-- Kết thúc noi-dung-trang -->
    </div><!-- Kết thúc khu-vuc-chinh -->
    <!-- ====================== JAVASCRIPT ====================== -->
    <script>
            // ====== Đóng alert ======
            function dongAlert(id) {
                const el = document.getElementById(id);
                if (el) {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(-8px)';
                    el.style.transition = 'all 0.25s ease';
                    setTimeout(() => el.remove(), 260);
                }
            }

            // Tự động ẩn alert sau 6 giây
            setTimeout(() => dongAlert('alert-success'), 6000);
            setTimeout(() => dongAlert('alert-error'), 8000);

            // ====== Sidebar / Chuyển trang ======
            function dongMoSidebar() {
                const sb = document.getElementById('thanh-sidebar');
                sb.classList.toggle('an-sidebar');
                sb.classList.toggle('mo');
            }

            function chuyenTrang(ten, el) {
                document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
                el.classList.add('dang-chon');
                const map = {
                    'trang-chu':       '/Manager/Manager',
                    'quan-ly-phong':   '/Manager/ChiTietPhong',
                    'quan-ly-dich-vu': '/Manager/QuanLyDichVu',
                    'hoa-don':         '/Manager/HoaDon',
                    'su-co-bao-tri':   '/Manager/SuCoBaoTri',
                    'bao-cao':         '/Manager/ThongKe',
                    'cai-dat':         '/Manager/CaiDat',
                    'phong-cua-toi':   '/KhachThue/KhachThue',
                };
                if (map[ten]) window.location.href = map[ten];
            }

            // ===== ĐỒNG BỘ BADGE SIDEBAR =====
            (async function loadBadgeSidebar() {
                try {
                    const res = await fetch('/Api/BadgeCounts');
                    if (!res.ok) return;
                    const data = await res.json();
                    const badgeDV = document.getElementById('badge-dichvu');
                    const badgeSC = document.getElementById('badge-suco');
                    if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
                    if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
                } catch (e) { console.warn('Không thể load badge sidebar:', e); }
            })();
    </script>
</body>
</html>
