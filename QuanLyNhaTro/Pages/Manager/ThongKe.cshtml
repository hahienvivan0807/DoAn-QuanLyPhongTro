// ====== BỘ LỌC THỜI GIAN (reload page với query param) ======
function locThoiGian(loai, el) {
    document.querySelectorAll('.nut-loc-tg').forEach(b => b.classList.remove('dang-chon'));
    el.classList.add('dang-chon');
    // Reload page với filter param để Razor xử lý
    window.location.href = '?filter=' + loai;
}

// ====== SIDEBAR / CHUYỂN TRANG ======
function dongMoSidebar() {
    const sb = document.getElementById('thanh-sidebar');
    sb.classList.toggle('an-sidebar');
    sb.classList.toggle('mo');
}
function chuyenTrang(ten, el) {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
    el.classList.add('dang-chon');
    const map = {
        'trang-chu':          '/Manager/Manager',
        'quan-ly-phong':      '/Manager/ChiTietPhong',
        'quan-ly-dich-vu':    '/Manager/QuanLyDichVu',
        'hoa-don':            '/Manager/HoaDon',
        'su-co-bao-tri':      '/Manager/SuCoBaoTri',
        'bao-cao':            '/Manager/ThongKe',
        'cai-dat':            '/CaiDat',
    };
    if (map[ten]) window.location.href = map[ten];
}

// Active đúng nút filter khi load (theo query param)
(function () {
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter') || 'thang-nay';
    document.querySelectorAll('.nut-loc-tg').forEach(b => b.classList.remove('dang-chon'));
    const mapBtn = {
        'hom-nay':   0, '7-ngay': 1, 'thang-nay': 2, 'nam-nay': 3
    };
    const btns = document.querySelectorAll('.nut-loc-tg');
    const idx = mapBtn[filter] ?? 2;
    if (btns[idx]) btns[idx].classList.add('dang-chon');
})();
</script>
