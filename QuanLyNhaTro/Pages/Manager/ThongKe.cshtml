                { label: 'Đang xử lý', data: dataDangXL, backgroundColor: '#dbeafe', borderColor: '#1d4ed8', borderWidth: 1.5, borderRadius: 4 },
                { label: 'Thành công', data: dataTC,     backgroundColor: '#dcfce7', borderColor: '#16a34a', borderWidth: 1.5, borderRadius: 4 },
                { label: 'Đã hủy',    data: dataHuy,    backgroundColor: '#fee2e2', borderColor: '#dc2626', borderWidth: 1.5, borderRadius: 4 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { padding: 10, usePointStyle: true } }
            },
            scales: {
                x: { stacked: false, grid: { display: false } },
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { stepSize: 1 } }
            }
        }
    });
})();

// ====== 4. BIỂU ĐỒ BÁNH CƠ CẤU DOANH THU THÁNG ======
(function () {
