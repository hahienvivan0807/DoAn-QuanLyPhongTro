                    nutFooter = `<button class="nut-phu" onclick="inHoaDon(${hd.id})"><i class="fas fa-print"></i> In hóa đơn</button>`;
                } else {
                    nutFooter = `<button class="nut-phu" onclick="dongModal('modal-chi-tiet')">Đóng</button>`;
                }

                document.getElementById('modal-noi-dung').innerHTML = `
                    <div class="hang-thong-tin">
                        <div class="muc-thong-tin"><div class="nhan">Trạng thái</div><div class="gia-tri"><span class="nhan-trang-thai ${nhanCls}">${nhanText}</span></div></div>
                        <div class="muc-thong-tin"><div class="nhan">Hạn thanh toán</div><div class="gia-tri">${hd.hanNop}</div></div>
                        <div class="muc-thong-tin"><div class="nhan">Số điện thoại</div><div class="gia-tri">${hd.soDienThoai}</div></div>
                        <div class="muc-thong-tin"><div class="nhan">Ngày thanh toán</div><div class="gia-tri">${hd.ngayNop || '—'}</div></div>
                    </div>

                    <table class="bang-chi-phi">
                        <thead>
                            <tr>
                                <th>Khoản mục</th>
                                <th style="text-align:right">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><i class="fas fa-home" style="color:var(--mau-chu-de);margin-right:8px"></i>Tiền phòng</td><td style="text-align:right;font-weight:600">${dinhDangTien(hd.tienPhong)}</td></tr>
                            <tr><td><i class="fas fa-bolt" style="color:#f97316;margin-right:8px"></i>Tiền điện</td><td style="text-align:right;font-weight:600">${dinhDangTien(hd.tienDien)}</td></tr>
                            <tr><td><i class="fas fa-tint" style="color:#3b82f6;margin-right:8px"></i>Tiền nước</td><td style="text-align:right;font-weight:600">${dinhDangTien(hd.tienNuoc)}</td></tr>
                            <tr><td><i class="fas fa-concierge-bell" style="color:#8b5cf6;margin-right:8px"></i>Dịch vụ chung</td><td style="text-align:right;font-weight:600">${dinhDangTien(hd.tienDichVu)}</td></tr>
