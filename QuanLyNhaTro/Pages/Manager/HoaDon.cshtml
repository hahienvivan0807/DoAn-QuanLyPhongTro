            // ===== XÁC NHẬN THANH TOÁN =====
            function xacNhanThanhToan(id) {
                const hd = danhSachHoaDon.find(h => h.id === id);
                if (!hd) return;
                // ⚙️ BACKEND: fetch('/api/hoa-don/xac-nhan', { method:'POST', body: JSON.stringify({ id }) })
                hd.trangThai = 'hoan-thanh';
                hd.ngayNop = new Date().toLocaleDateString('vi-VN') + ' ' + new Date().toLocaleTimeString('vi-VN');
                dongModal('modal-chi-tiet');
                renderTatCaPanel(danhSachHoaDon);
                hienToast('Đã xác nhận thanh toán phòng ' + hd.soPhong + ' thành công!', 'thanh-cong');
            }

            function tuChoiXacNhan(id) {
                const hd = danhSachHoaDon.find(h => h.id === id);
                if (!hd) return;
                // ⚙️ BACKEND: fetch('/api/hoa-don/tu-choi', { method:'POST', body: JSON.stringify({ id }) })
                hd.trangThai = 'qua-han';
                hd.anhChuyenKhoan = null;
                dongModal('modal-chi-tiet');
                renderTatCaPanel(danhSachHoaDon);
                hienToast('Đã từ chối – đã thông báo lại cho khách phòng ' + hd.soPhong, 'canh-bao');
            }

            function xacNhanThuTien(id) {
                const hd = danhSachHoaDon.find(h => h.id === id);
