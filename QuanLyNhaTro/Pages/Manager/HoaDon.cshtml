                    'qua-han': { text: '⚠ Quá hạn', cls: 'qua-han' },
                    'sap-den': { text: '⏰ Sắp đến hạn', cls: 'sap-den' },
                    'cho-xac-nhan': { text: '🖼 Chờ xác nhận', cls: 'cho-xac-nhan' },
                    'hoan-thanh': { text: '✅ Đã thanh toán', cls: 'hoan-thanh' },
                };
                return map[tt] || { text: tt, cls: '' };
            }

