            }
            function renderTheoLoai(ds, idEl, loai) {
                const loc = ds.filter(h => h.trangThai === loai);
                const el = document.getElementById(idEl);
                el.innerHTML = loc.length ? loc.map(renderTheHoaDon).join('') : '<div class="trong-rong"><i class="fas fa-check-circle"></i><p>Không có hóa đơn nào trong mục này</p></div>';
            }

            function renderTatCaPanel(ds) {
                renderTatCa(ds);
                renderTheoLoai(ds, 'dsQuaHan', 'qua-han');
                renderTheoLoai(ds, 'dsSapDen', 'sap-den');
                renderTheoLoai(ds, 'dsChoXacNhan', 'cho-xac-nhan');
                renderTheoLoai(ds, 'dsHoanThanh', 'hoan-thanh');
            }

            // ===== CHỌN TAB =====
            function chonTab(ten) {
                document.querySelectorAll('.tab-nut').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
                document.getElementById('tab-' + ten).classList.add('active');
                document.getElementById('panel-' + ten).classList.add('active');
            }

            // ===== LỌC THEO TỪ KHÓA =====
            function locDanhSach(tuKhoa) {
                const kw = tuKhoa.toLowerCase();
                const loc = danhSachHoaDon.filter(h =>
                    h.soPhong.toLowerCase().includes(kw) ||
                    h.tenNguoiThue.toLowerCase().includes(kw)
                );
                renderTatCaPanel(loc);
            }

            // ===== MỞ CHI TIẾT HÓA ĐƠN =====
