            .muc-thong-tin .gia-tri {
                font-size: 14px;
                font-weight: 600;
            }

            .bang-chi-phi {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 18px;
            }

                .bang-chi-phi th {
                    background: var(--mau-nen);
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    color: var(--mau-chu-phu);
                    padding: 10px 14px;
                    text-align: left;
                }

                .bang-chi-phi td {
                    padding: 10px 14px;
                    font-size: 13px;
                    border-bottom: 1px solid var(--mau-vien);
                }

                .bang-chi-phi tr:last-child td {
                    border-bottom: none;
                }

                .bang-chi-phi .hang-tong td {
                    font-weight: 800;
                    font-size: 15px;
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tong-tien-to {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                border-radius: 14px;
                padding: 18px 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                color: #fff;
                margin-bottom: 20px;
            }

                .tong-tien-to .nhan-tong {
                    font-size: 14px;
                    opacity: 0.85;
                }

                .tong-tien-to .so-tong {
                    font-size: 26px;
                    font-weight: 800;
                }

            /* ===== PHẦN XÁC NHẬN CHUYỂN KHOẢN ===== */
            .khung-xac-nhan {
                background: #fefce8;
                border: 1.5px solid #fde047;
                border-radius: 14px;
                padding: 18px 20px;
                margin-bottom: 18px;
            }

                .khung-xac-nhan .tieu-de-xn {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    font-size: 14px;
                    font-weight: 700;
                    color: #ca8a04;
                    margin-bottom: 14px;
                }

                .khung-xac-nhan .anh-ck {
                    width: 100%;
                    border-radius: 10px;
                    border: 1px solid #fde047;
                    max-height: 260px;
                    object-fit: contain;
                    background: #fff;
                    display: block;
                    margin-bottom: 12px;
                    cursor: zoom-in;
                }

                .khung-xac-nhan .thoi-gian-gui {
                    font-size: 12px;
                    color: #ca8a04;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

            .nut-xac-nhan-to {
                background: linear-gradient(135deg, #22c55e, #16a34a);
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 12px 24px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                justify-content: center;
                box-shadow: 0 4px 14px rgba(34,197,94,0.35);
                transition: all 0.2s;
            }

                .nut-xac-nhan-to:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(34,197,94,0.45);
                }

            .nut-tu-choi {
                background: #fff;
                color: #ef4444;
                border: 1.5px solid #ef4444;
                border-radius: 10px;
                padding: 12px 24px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                justify-content: center;
                transition: all 0.2s;
                margin-top: 8px;
            }

                .nut-tu-choi:hover {
                    background: #fee2e2;
                }

            /* ===== MODAL XEM ẢNH LỚN ===== */
            .modal-anh {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 2000;
                background: rgba(0,0,0,0.88);
                align-items: center;
                justify-content: center;
            }

                .modal-anh.hien {
                    display: flex;
                }

                .modal-anh img {
                    max-width: 90vw;
                    max-height: 90vh;
                    border-radius: 10px;
                    box-shadow: 0 0 60px rgba(0,0,0,0.5);
                }

                .modal-anh .nut-dong-anh {
                    position: absolute;
                    top: 24px;
                    right: 32px;
                    background: rgba(255,255,255,0.12);
                    border: none;
                    color: #fff;
                    font-size: 24px;
                    cursor: pointer;
                    border-radius: 50%;
                    width: 44px;
                    height: 44px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                    .modal-anh .nut-dong-anh:hover {
                        background: rgba(255,255,255,0.22);
                    }

            /* ===== MODAL GỬI NHẮC NHỞ ===== */
            .modal-nhac .modal-hop {
                width: 480px;
            }

            .nhom-chon {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-bottom: 18px;
            }

            .chon-kieu-nhac {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 12px 16px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                cursor: pointer;
                transition: all 0.2s;
            }

                .chon-kieu-nhac:hover {
                    border-color: var(--mau-chu-de-sang);
                    background: var(--mau-xanh-nhat);
                }

                .chon-kieu-nhac input[type="radio"] {
                    margin-top: 2px;
                    accent-color: var(--mau-chu-de);
                }

                .chon-kieu-nhac .noi-dung-chon .ten-kieu {
                    font-size: 13px;
                    font-weight: 700;
                }

                .chon-kieu-nhac .noi-dung-chon .mo-ta-kieu {
                    font-size: 12px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            .vung-nhap {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                font-size: 13px;
                outline: none;
                resize: vertical;
                min-height: 90px;
                font-family: inherit;
                transition: border-color 0.2s;
            }

                .vung-nhap:focus {
                    border-color: var(--mau-chu-de-sang);
                }

            /* ===== TOAST THÔNG BÁO ===== */
            #toast {
                position: fixed;
                bottom: 28px;
                right: 28px;
                z-index: 9999;
                background: #1e293b;
                color: #fff;
                border-radius: 12px;
                padding: 14px 20px;
                font-size: 13px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 10px;
                box-shadow: 0 8px 32px rgba(0,0,0,0.2);
                transform: translateY(80px);
                opacity: 0;
                transition: all 0.3s cubic-bezier(.4,0,.2,1);
                pointer-events: none;
            }

                #toast.hien {
                    transform: translateY(0);
                    opacity: 1;
                }

                #toast.thanh-cong {
                    background: #22c55e;
                }

                #toast.canh-bao {
                    background: #f97316;
                }

                #toast.loi {
                    background: #ef4444;
                }
    </style>
</head>
