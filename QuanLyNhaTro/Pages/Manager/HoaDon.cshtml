@page "/Manager/HoaDon"
@model QuanLyNhaTro.Pages.Manager.HoaDonModel
@{
    Layout = null;
}
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hóa Đơn - Quản Lý Nhà Trọ</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            /* ===== BIẾN MÀU TOÀN CỤC (giống Manager) ===== */
            :root {
                --mau-sidebar: #0d1b3e;
                --mau-sidebar-dam: #091429;
                --mau-chu-de: #1a56db;
                --mau-chu-de-sang: #3b82f6;
                --mau-nen: #f0f4f8;
                --mau-trang: #ffffff;
                --mau-chu: #1e293b;
                --mau-chu-phu: #64748b;
                --mau-vien: #e2e8f0;
                --mau-xanh-nhat: #eff6ff;
                --mau-xanh-trung: #dbeafe;
                --bong-card: 0 4px 24px rgba(26,86,219,0.10);
                --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
                --mau-cam: #f97316;
                --mau-do: #ef4444;
                --mau-xanh-la: #22c55e;
                --mau-vang: #eab308;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ===== SIDEBAR (copy từ Manager) ===== */
            #thanh-sidebar {
                width: 220px;
                min-width: 220px;
                background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
                display: flex;
                flex-direction: column;
                height: 100vh;
                position: relative;
                z-index: 100;
                box-shadow: 4px 0 24px rgba(0,0,0,0.18);
                overflow-y: hidden;
                transition: width 0.35s cubic-bezier(.4,0,.2,1), min-width 0.35s cubic-bezier(.4,0,.2,1);
            }

                #thanh-sidebar.an-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            .logo-sidebar {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 28px 20px 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .logo-sidebar .bieu-tuong {
                    width: 60px;
                    height: 60px;
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background: transparent;
                }

                    .logo-sidebar .bieu-tuong img {
                        width: 100%;
                        height: 100%;
                        object-fit: contain;
                        border-radius: 10px;
                    }

                .logo-sidebar .ten-logo {
                    color: #fff;
                }

                    .logo-sidebar .ten-logo strong {
                        display: block;
                        font-size: 13px;
                        letter-spacing: 0.5px;
                    }

                    .logo-sidebar .ten-logo span {
                        font-size: 11px;
                        color: rgba(255,255,255,0.45);
                    }

            .nhan-nhom {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                padding: 18px 20px 6px 20px;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 9px 20px;
                color: rgba(255,255,255,0.65);
                cursor: pointer;
                border-radius: 0 30px 30px 0;
                margin: 2px 10px 2px 0;
                transition: all 0.2s;
                font-size: 14px;
                text-decoration: none;
                position: relative;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(59,130,246,0.15);
                    color: #fff;
                }

                .menu-item.dang-chon {
                    background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
                    color: #fff;
                    font-weight: 600;
                    box-shadow: 0 4px 16px rgba(26,86,219,0.3);
                }

                    .menu-item.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 70%;
                        width: 4px;
                        background: #60a5fa;
                        border-radius: 0 4px 4px 0;
                    }

            .huy-hieu-menu {
                margin-left: auto;
                background: #ef4444;
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 1px 7px;
                min-width: 20px;
                text-align: center;
            }

            .admin-sidebar {
                margin-top: auto;
                padding: 18px 16px;
                border-top: 1px solid rgba(255,255,255,0.07);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
            }

                .admin-sidebar .anh-admin {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 16px;
                    border: 2px solid rgba(255,255,255,0.2);
                }

                .admin-sidebar .ten-admin strong {
                    display: block;
                    color: #fff;
                    font-size: 10px;
                }

                .admin-sidebar .ten-admin span {
                    color: rgba(255,255,255,0.45);
                    font-size: 11px;
                }

            /* ===== KHU VỰC CHÍNH ===== */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* ===== HEADER ===== */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid var(--mau-vien);
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                flex-shrink: 0;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .nut-ham-menu {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 20px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: background 0.2s;
            }

                .nut-ham-menu:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-trang {
                font-size: 16px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .duong-dan {
                font-size: 12px;
                color: var(--mau-chu-phu);
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .o-tim-kiem {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-nen);
                border: 1px solid var(--mau-vien);
                border-radius: 24px;
                padding: 7px 16px;
                transition: all 0.2s;
            }

                .o-tim-kiem:focus-within {
                    border-color: var(--mau-chu-de-sang);
                    background: #fff;
                }

                .o-tim-kiem input {
                    border: none;
                    background: none;
                    outline: none;
                    font-size: 13px;
                    width: 180px;
                }

                .o-tim-kiem i {
                    color: var(--mau-chu-phu);
                    font-size: 13px;
                }

            .nut-thong-bao {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: 50%;
                transition: all 0.2s;
            }

                .nut-thong-bao:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .so-thong-bao {
                position: absolute;
                top: 2px;
                right: 2px;
                background: #ef4444;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            .thong-tin-admin {
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                padding: 6px 12px;
                border-radius: 24px;
                transition: background 0.2s;
            }

                .thong-tin-admin:hover {
                    background: var(--mau-xanh-nhat);
                }

                .thong-tin-admin .anh-dai-dien {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 14px;
                    font-weight: 700;
                }

                .thong-tin-admin .ten {
                    font-size: 13px;
                    font-weight: 600;
                }

                .thong-tin-admin .chuc-vu {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                }

            /* ===== NỘI DUNG TRANG HÓA ĐƠN ===== */
            #noi-dung-hoa-don {
                flex: 1;
                overflow-y: auto;
                padding: 24px 28px;
            }

            .hang-chao-mung {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
            }

                .hang-chao-mung h2 {
                    font-size: 20px;
                    font-weight: 800;
                }

                .hang-chao-mung p {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            .nhom-nut {
                display: flex;
                gap: 10px;
            }

            .nut-chinh {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 10px 20px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
            }

                .nut-chinh:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            .nut-phu {
                background: var(--mau-trang);
                color: var(--mau-chu);
                border: 1px solid var(--mau-vien);
                border-radius: 10px;
                padding: 10px 20px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
            }

                .nut-phu:hover {
                    background: var(--mau-xanh-nhat);
                    border-color: var(--mau-chu-de-sang);
                }

            /* ===== TABS LỌC HÓA ĐƠN ===== */
            .tab-loc {
                display: flex;
                gap: 8px;
                margin-bottom: 20px;
                border-bottom: 2px solid var(--mau-vien);
                padding-bottom: 0;
            }

            .tab-nut {
                padding: 10px 20px;
                border: none;
                background: none;
                font-size: 13px;
                font-weight: 600;
                color: var(--mau-chu-phu);
                cursor: pointer;
                border-bottom: 3px solid transparent;
                margin-bottom: -2px;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 8px;
                border-radius: 8px 8px 0 0;
            }

                .tab-nut:hover {
                    color: var(--mau-chu-de);
                    background: var(--mau-xanh-nhat);
                }

                .tab-nut.active {
                    color: var(--mau-chu-de);
                    border-bottom-color: var(--mau-chu-de);
                }

                .tab-nut .dem {
                    background: var(--mau-xanh-trung);
                    color: var(--mau-chu-de);
                    font-size: 10px;
                    font-weight: 700;
                    border-radius: 20px;
                    padding: 1px 7px;
                    min-width: 20px;
                    text-align: center;
                }

                .tab-nut.active .dem {
                    background: var(--mau-chu-de);
                    color: #fff;
                }

                .tab-nut.do .dem {
                    background: #fee2e2;
                    color: #ef4444;
                }

                .tab-nut.do.active .dem {
                    background: #ef4444;
                    color: #fff;
                }

                .tab-nut.cam .dem {
                    background: #fff7ed;
                    color: #f97316;
                }

                .tab-nut.cam.active .dem {
                    background: #f97316;
                    color: #fff;
                }

                .tab-nut.xanh-la .dem {
                    background: #f0fdf4;
                    color: #22c55e;
                }

                .tab-nut.xanh-la.active .dem {
                    background: #22c55e;
                    color: #fff;
                }

                .tab-nut.vang .dem {
                    background: #fefce8;
                    color: #ca8a04;
                }

                .tab-nut.vang.active .dem {
                    background: #ca8a04;
                    color: #fff;
                }

            /* ===== BẢNG THỐNG KÊ HÓA ĐƠN ===== */
            .hang-thong-ke {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 16px;
                margin-bottom: 22px;
            }

            .card-tk {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 18px 20px;
                box-shadow: var(--bong-card);
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid transparent;
                transition: all 0.25s;
                cursor: pointer;
            }

                .card-tk:hover {
                    box-shadow: var(--bong-card-hover);
                    transform: translateY(-2px);
                }

                .card-tk .bieu-tuong-card {
                    width: 46px;
                    height: 46px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 20px;
                    flex-shrink: 0;
                }

                .card-tk .noi-dung-card .so {
                    font-size: 24px;
                    font-weight: 800;
                    line-height: 1;
                }

                .card-tk .noi-dung-card .nhan {
                    font-size: 12px;
                    color: var(--mau-chu-phu);
                    margin-top: 4px;
                }

                .card-tk.tong .bieu-tuong-card {
                    background: var(--mau-xanh-trung);
                    color: var(--mau-chu-de);
                }

                .card-tk.tong .so {
                    color: var(--mau-chu-de);
                }

                .card-tk.qua-han .bieu-tuong-card {
                    background: #fee2e2;
                    color: #ef4444;
                }

                .card-tk.qua-han .so {
                    color: #ef4444;
                }

                .card-tk.sap-den .bieu-tuong-card {
                    background: #fff7ed;
                    color: #f97316;
                }

                .card-tk.sap-den .so {
                    color: #f97316;
                }

                .card-tk.hoan-thanh .bieu-tuong-card {
                    background: #f0fdf4;
                    color: #22c55e;
                }

                .card-tk.hoan-thanh .so {
                    color: #22c55e;
                }

            /* ===== PANEL NỘI DUNG TAB ===== */
            .panel {
                display: none;
            }

                .panel.active {
                    display: block;
                }

            /* ===== THANH CÔNG CỤ ===== */
            .thanh-cong-cu {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 16px;
                gap: 12px;
            }

            .nhom-loc {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
            }

            .chon-thang {
                padding: 8px 14px;
                border: 1px solid var(--mau-vien);
                border-radius: 8px;
                font-size: 13px;
                background: var(--mau-trang);
                color: var(--mau-chu);
                cursor: pointer;
                outline: none;
            }

            .o-tim-kiem-nho {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--mau-trang);
                border: 1px solid var(--mau-vien);
                border-radius: 8px;
                padding: 8px 14px;
            }

                .o-tim-kiem-nho input {
                    border: none;
                    outline: none;
                    font-size: 13px;
                    width: 200px;
                }

                .o-tim-kiem-nho i {
                    color: var(--mau-chu-phu);
                    font-size: 12px;
                }

            /* ===== DANH SÁCH HÓA ĐƠN ===== */
            .ds-hoa-don {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .the-hoa-don {
                background: var(--mau-trang);
                border-radius: 14px;
                padding: 18px 20px;
                box-shadow: var(--bong-card);
                border: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 16px;
                cursor: pointer;
                transition: all 0.2s;
                position: relative;
            }

                .the-hoa-don:hover {
                    box-shadow: var(--bong-card-hover);
                    border-color: var(--mau-chu-de-sang);
                    transform: translateY(-1px);
                }

                .the-hoa-don .so-phong-hd {
                    width: 52px;
                    height: 52px;
                    border-radius: 12px;
                    background: var(--mau-xanh-trung);
                    color: var(--mau-chu-de);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 16px;
                    font-weight: 800;
                    flex-shrink: 0;
                }

                .the-hoa-don.qua-han .so-phong-hd {
                    background: #fee2e2;
                    color: #ef4444;
                }

                .the-hoa-don.sap-den .so-phong-hd {
                    background: #fff7ed;
                    color: #f97316;
                }

                .the-hoa-don.hoan-thanh .so-phong-hd {
                    background: #f0fdf4;
                    color: #22c55e;
                }

                .the-hoa-don.cho-xac-nhan .so-phong-hd {
                    background: #fefce8;
                    color: #ca8a04;
                }

            .thong-tin-hd {
                flex: 1;
                min-width: 0;
            }

                .thong-tin-hd .dong-1 {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 5px;
                }

                .thong-tin-hd .ten-phong {
                    font-size: 15px;
                    font-weight: 700;
                }

                .thong-tin-hd .ten-nguoi-thue {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                }

                .thong-tin-hd .dong-2 {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                }

                    .thong-tin-hd .dong-2 span {
                        font-size: 12px;
                        color: var(--mau-chu-phu);
                        display: flex;
                        align-items: center;
                        gap: 4px;
                    }

                    .thong-tin-hd .dong-2 i {
                        font-size: 11px;
                    }

            .nhan-trang-thai {
                font-size: 11px;
                font-weight: 700;
                border-radius: 20px;
                padding: 3px 10px;
                white-space: nowrap;
                flex-shrink: 0;
            }

                .nhan-trang-thai.qua-han {
                    background: #fee2e2;
                    color: #ef4444;
                }

                .nhan-trang-thai.sap-den {
                    background: #fff7ed;
                    color: #f97316;
                }

                .nhan-trang-thai.hoan-thanh {
                    background: #f0fdf4;
                    color: #22c55e;
                }

                .nhan-trang-thai.cho-xac-nhan {
                    background: #fefce8;
                    color: #ca8a04;
                }

                .nhan-trang-thai.chua-gui {
                    background: var(--mau-xanh-trung);
                    color: var(--mau-chu-de);
                }

            .so-tien-hd {
                text-align: right;
                flex-shrink: 0;
                min-width: 110px;
            }

                .so-tien-hd .tien {
                    font-size: 17px;
                    font-weight: 800;
                    color: var(--mau-chu-de);
                }

                    .so-tien-hd .tien.do {
                        color: #ef4444;
                    }

                .so-tien-hd .ky {
                    font-size: 11px;
                    color: var(--mau-chu-phu);
                    margin-top: 2px;
                }

            .nhom-nut-hd {
                display: flex;
                gap: 8px;
                flex-shrink: 0;
            }

            .nut-hd {
                padding: 7px 14px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                border: 1px solid;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 5px;
            }

                .nut-hd.nhac {
                    border-color: #f97316;
                    color: #f97316;
                    background: #fff7ed;
                }

                    .nut-hd.nhac:hover {
                        background: #f97316;
                        color: #fff;
                    }

                .nut-hd.xem {
                    border-color: var(--mau-chu-de-sang);
                    color: var(--mau-chu-de);
                    background: var(--mau-xanh-nhat);
                }

                    .nut-hd.xem:hover {
                        background: var(--mau-chu-de);
                        color: #fff;
                    }

                .nut-hd.xac-nhan {
                    border-color: #22c55e;
                    color: #22c55e;
                    background: #f0fdf4;
                }

                    .nut-hd.xac-nhan:hover {
                        background: #22c55e;
                        color: #fff;
                    }

            /* ===== EMPTY STATE ===== */
            .trong-rong {
                text-align: center;
                padding: 60px 20px;
                color: var(--mau-chu-phu);
            }

                .trong-rong i {
                    font-size: 48px;
                    opacity: 0.2;
                    margin-bottom: 16px;
                    display: block;
                }

                .trong-rong p {
                    font-size: 15px;
                }

            /* ===== MODAL CHI TIẾT HÓA ĐƠN ===== */
            .modal-nen {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,0.5);
                z-index: 1000;
                align-items: center;
                justify-content: center;
            }

                .modal-nen.hien {
                    display: flex;
                }

            .modal-hop {
                background: var(--mau-trang);
                border-radius: 20px;
                width: 640px;
                max-width: 95vw;
                max-height: 90vh;
                overflow-y: auto;
                box-shadow: 0 24px 80px rgba(0,0,0,0.22);
                animation: truotLen 0.28s cubic-bezier(.4,0,.2,1);
            }

            @@keyframes truotLen {
                from {
                    opacity: 0;
                    transform: translateY(24px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 22px 28px 18px;
                border-bottom: 1px solid var(--mau-vien);
