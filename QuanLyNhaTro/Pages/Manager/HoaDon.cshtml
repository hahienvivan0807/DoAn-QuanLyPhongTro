            function hienToast(noiDung, loai = '') {
                const el = document.getElementById('toast');
                const icon = loai === 'thanh-cong' ? '✅' : loai === 'canh-bao' ? '⚠️' : loai === 'loi' ? '❌' : 'ℹ️';
                el.innerHTML = `${icon} ${noiDung}`;
                el.className = 'hien ' + loai;
                setTimeout(() => { el.className = loai; }, 3000);
            }

            // ===== ĐIỀU HƯỚNG SIDEBAR =====
            function chuyenTrang(tenTrang, phanTu) {
                document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
                phanTu.classList.add('dang-chon');
                const bangDieuHuong = {
                    'trang-chu':          '/Manager/Manager',
                    'quan-ly-phong':      '/Manager/ChiTietPhong',
                    'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
                    'hoa-don':            '/Manager/HoaDon',
                    'su-co-bao-tri':      '/SuCoBaoTri',
                    'bao-cao':            '/BaoCao',
                    'cai-dat':            '/CaiDat',
                };
                const duongDan = bangDieuHuong[tenTrang];
                if (duongDan) window.location.href = duongDan;
            }

            function dongMoSidebar() {
                document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            function dongModal(id) {
                document.getElementById(id).classList.remove('hien');
            }

            function dongModalNeuNhanNgoai(event, id) {
                if (event.target.id === id) dongModal(id);
            }

            function moThongBao() { alert('Thông báo: 3 hóa đơn chờ xác nhận'); }
            function moMenuAdmin() { alert('Menu tài khoản'); }
            function moThongTinAdmin() { alert('Thông tin quản trị viên'); }
            function timKiem(kw) { locDanhSach(kw); }

            // ===== KHỞI ĐỘNG =====
            renderTatCaPanel(danhSachHoaDon);
    </script>
</body>
</html>
