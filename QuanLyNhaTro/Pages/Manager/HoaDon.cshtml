                    font-size: 18px;
                    font-weight: 800;
                }

            .nut-dong-modal {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: all 0.2s;
            }

                .nut-dong-modal:hover {
                    background: #fee2e2;
                    color: #ef4444;
                }

            .modal-body {
                padding: 24px 28px;
            }

            .modal-footer {
                padding: 18px 28px;
                border-top: 1px solid var(--mau-vien);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
