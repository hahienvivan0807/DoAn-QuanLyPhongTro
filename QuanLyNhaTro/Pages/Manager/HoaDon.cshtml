            .hang-thong-tin {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
                margin-bottom: 22px;
            }

            .muc-thong-tin .nhan {
                font-size: 11px;
                color: var(--mau-chu-phu);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.8px;
