                    nutHanh = `
                        <button class="nut-hd xac-nhan" onclick="event.stopPropagation(); moChiTiet(${hd.id})">
                            <i class="fas fa-check-double"></i> Xem & Xác nhận
                        </button>`;
                } else {
                    nutHanh = `
                        <button class="nut-hd xem" onclick="event.stopPropagation(); moChiTiet(${hd.id})">
                            <i class="fas fa-eye"></i> Chi tiết
                        </button>`;
                }

                return `
                <div class="the-hoa-don ${hd.trangThai}" onclick="moChiTiet(${hd.id})">
