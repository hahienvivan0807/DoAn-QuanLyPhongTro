                const hd = danhSachHoaDon.find(h => h.id === id);
                if (!hd) return;

                const tong = tinhTong(hd);
                const { text: nhanText, cls: nhanCls } = layNhanTrangThai(hd.trangThai);

                document.getElementById('modal-tieu-de').textContent = `Phòng ${hd.soPhong} – ${hd.tenNguoiThue}`;
