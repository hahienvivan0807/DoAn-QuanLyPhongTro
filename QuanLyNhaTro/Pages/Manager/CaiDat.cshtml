@page
@model QuanLyNhaTro.Pages.Manager.CaiDatModel
@{
    Layout = null;
    var initials = Model.ChuCaiDaiDien;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nhà Trọ Bà Năm – Cài đặt hệ thống</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
            /* ===================================================
                   BIẾN MÀU TOÀN CỤC  –  đồng bộ Manager.cshtml
                =================================================== */
            :root {
                --mau-sidebar: #0d1b3e;
                --mau-sidebar-dam: #091429;
                --mau-chu-de: #1a56db;
                --mau-chu-de-sang: #3b82f6;
                --mau-nen: #f0f4f8;
                --mau-trang: #ffffff;
                --mau-chu: #1e293b;
                --mau-chu-phu: #64748b;
                --mau-vien: #e2e8f0;
                --mau-xanh-nhat: #eff6ff;
                --mau-xanh-trung: #dbeafe;
                --mau-xanh-la: #059669;
                --mau-xanh-la-nhat: #d1fae5;
                --mau-cam: #d97706;
                --mau-cam-nhat: #fef3c7;
                --mau-do: #dc2626;
                --mau-do-nhat: #fee2e2;
                --mau-tim-nhat: #ede9fe;
                --bong-card: 0 4px 24px rgba(26,86,219,0.10);
                --bong-card-hover: 0 8px 32px rgba(26,86,219,0.18);
            }

            /* ===================================================
                   RESET & CƠ BẢN
                =================================================== */
            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', 'SVN-Gilroy', sans-serif;
                background: var(--mau-nen);
                color: var(--mau-chu);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ===================================================
                   SIDEBAR  –  copy chính xác từ Manager.cshtml
                =================================================== */
            #thanh-sidebar {
                width: 220px;
                min-width: 220px;
                background: linear-gradient(180deg, #0d1b3e 0%, #091429 100%);
                display: flex;
                flex-direction: column;
                height: 100vh;
                position: relative;
                z-index: 100;
                box-shadow: 4px 0 24px rgba(0,0,0,0.18);
                overflow-y: auto;
                overflow-x: hidden;
                transition: width .35s cubic-bezier(.4,0,.2,1), min-width .35s cubic-bezier(.4,0,.2,1);
            }

                #thanh-sidebar.an-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

            .nhan-nhom {
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
            }

            .logo-sidebar {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 28px 20px 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .logo-sidebar .bieu-tuong {
                    width: 60px;
                    height: 60px;
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background: transparent;
                    flex-shrink: 0;
                }

                    .logo-sidebar .bieu-tuong img {
                        width: 100%;
                        height: 100%;
                        object-fit: contain;
                        border-radius: 10px;
                    }

                .logo-sidebar .ten-logo strong {
                    display: block;
                    font-size: 13px;
                    color: #fff;
                    letter-spacing: 0.5px;
                }

                .logo-sidebar .ten-logo span {
                    font-size: 11px;
                    color: rgba(255,255,255,0.45);
                }

            .nhan-nhom {
                transition: opacity 0.2s ease, max-height 0.3s ease;
                max-height: 40px;
                overflow: hidden;
                /* giữ nguyên các thuộc tính cũ bên dưới */
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                padding: 18px 20px 6px 20px;
                white-space: nowrap;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 11px 20px;
                color: rgba(255,255,255,0.65);
                cursor: pointer;
                border-radius: 0 30px 30px 0;
                margin: 2px 10px 2px 0;
                transition: all 0.2s;
                font-size: 14px;
                text-decoration: none;
                position: relative;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                    flex-shrink: 0;
                }

                .menu-item:hover {
                    background: rgba(59,130,246,0.15);
                    color: #fff;
                }

                .menu-item.dang-chon {
                    background: linear-gradient(90deg, rgba(26,86,219,0.85) 0%, rgba(59,130,246,0.6) 100%);
                    color: #fff;
                    font-weight: 700;
                    box-shadow: 0 4px 16px rgba(26,86,219,0.3);
                    font-weight: 600;
                }

                    .menu-item.dang-chon::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        height: 70%;
                        width: 4px;
                        background: #60a5fa;
                        border-radius: 0 4px 4px 0;
                    }

            .huy-hieu-menu {
                margin-left: auto;
                background: #ef4444;
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                border-radius: 20px;
                padding: 1px 7px;
                min-width: 20px;
                text-align: center;
            }

            /* Admin footer bottom của sidebar */
            .admin-sidebar {
                margin-top: auto;
                padding: 18px 16px;
                border-top: 1px solid rgba(255,255,255,0.07);
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                white-space: nowrap;
            }

                .admin-sidebar .anh-admin {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #1a56db, #60a5fa);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 16px;
                    font-weight: 800;
                    border: 2px solid rgba(255,255,255,0.2);
                    flex-shrink: 0;
                }

                .admin-sidebar .ten-admin strong {
                    display: block;
                    color: #fff;
                    font-size: 10px;
                }

                .admin-sidebar .ten-admin span {
                    color: rgba(255,255,255,0.45);
                    font-size: 11px;
                }

            /* ===================================================
                   KHU VỰC CHÍNH
                =================================================== */
            #khu-vuc-chinh {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* ===== HEADER  –  đồng bộ Manager.cshtml ===== */
            #thanh-header {
                background: var(--mau-trang);
                padding: 0 28px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid var(--mau-vien);
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                flex-shrink: 0;
            }

            .header-trai {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .nut-ham-menu {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 20px;
                color: var(--mau-chu-phu);
                padding: 6px;
                border-radius: 8px;
                transition: background 0.2s;
            }

                .nut-ham-menu:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .tieu-de-trang {
                font-size: 16px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .duong-dan {
                font-size: 12px;
                color: var(--mau-chu-phu);
            }

            .header-phai {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .hdr-date {
                font-size: 12px;
                font-weight: 600;
                color: var(--mau-chu-phu);
                background: var(--mau-nen);
                padding: 6px 12px;
                border-radius: 20px;
                border: 1px solid var(--mau-vien);
            }

            .nut-thong-bao {
                position: relative;
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: var(--mau-chu-phu);
                padding: 8px;
                border-radius: 50%;
                transition: all 0.2s;
            }

                .nut-thong-bao:hover {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

            .so-thong-bao {
                position: absolute;
                top: 2px;
                right: 2px;
                background: #ef4444;
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

            /* Admin header dropdown – copy từ Manager.cshtml */
            .thong-tin-admin {
                position: relative;
            }

            .mgr-dropdown {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                width: 240px;
                background: var(--mau-trang);
                border-radius: 14px;
                border: 1px solid var(--mau-vien);
                overflow: hidden;
                box-shadow: 0 8px 32px rgba(13,27,62,0.14), 0 2px 8px rgba(13,27,62,0.06);
                z-index: 999;
                transform-origin: top right;
                transform: scale(0.92) translateY(-8px);
                opacity: 0;
                pointer-events: none;
                transition: transform .18s cubic-bezier(0.34,1.56,0.64,1), opacity .15s ease;
            }

                .mgr-dropdown.show {
                    transform: scale(1) translateY(0);
                    opacity: 1;
                    pointer-events: all;
                }

            .mgr-dd-header {
                padding: 14px 16px 12px;
                border-bottom: 1px solid var(--mau-vien);
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .mgr-dd-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 16px;
                font-weight: 700;
                border: 2px solid rgba(255,255,255,0.2);
            }

            .mgr-dd-name {
                font-size: 13px;
                font-weight: 700;
                color: var(--mau-chu);
            }

            .mgr-dd-sub {
                font-size: 11px;
                color: var(--mau-chu-phu);
                margin-top: 2px;
            }

            .mgr-dd-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: 0.4px;
                padding: 2px 8px;
                border-radius: 9999px;
                margin-top: 4px;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
            }

            .mgr-dd-body {
                padding: 6px;
            }

            .mgr-item {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 9px 12px;
                border-radius: 9px;
                cursor: pointer;
                transition: background 0.14s;
                border: none;
                background: none;
                width: 100%;
                font-family: inherit;
                text-align: left;
            }

                .mgr-item:hover {
                    background: var(--mau-nen);
                }

            .mgr-item-icon {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

                .mgr-item-icon.blue {
                    background: var(--mau-xanh-nhat);
                    color: var(--mau-chu-de);
                }

                .mgr-item-icon.red {
                    background: #fef2f2;
                    color: #dc2626;
                }

            .mgr-item-label {
                font-size: 13px;
                font-weight: 600;
                color: var(--mau-chu);
            }

            .mgr-item-sub {
                font-size: 10.5px;
                color: var(--mau-chu-phu);
                margin-top: 1px;
            }

            .mgr-item.danger:hover {
                background: #fef2f2;
            }

                .mgr-item.danger:hover .mgr-item-label {
                    color: #dc2626;
                }

            .mgr-divider {
                height: 1px;
                background: var(--mau-vien);
                margin: 4px 0;
            }

            /* ===================================================
                   NỘI DUNG CHÍNH
                =================================================== */
            #noi-dung-chinh {
                flex: 1;
                overflow-y: auto;
                padding: 28px 32px;
            }

            .hang-tieu-de-trang {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
            }

                .hang-tieu-de-trang h2 {
                    font-size: 22px;
                    font-weight: 800;
                }

                .hang-tieu-de-trang p {
                    font-size: 13px;
                    color: var(--mau-chu-phu);
                    margin-top: 3px;
                }

            /* ===================================================
                   GRID CÀI ĐẶT  –  2 cột giống Tenant
                =================================================== */
            .cai-dat-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 22px;
                max-width: 1000px;
            }

            /* Card chung */
            .card-cai-dat {
                background: var(--mau-trang);
                border-radius: 18px;
                box-shadow: var(--bong-card);
                border: 1px solid var(--mau-vien);
                position: relative;
                overflow: hidden;
                transition: box-shadow 0.22s;
            }

                .card-cai-dat:hover {
                    box-shadow: var(--bong-card-hover);
                }

                .card-cai-dat::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    border-radius: 18px 18px 0 0;
                }

                .card-cai-dat.accent-xanh::before {
                    background: linear-gradient(90deg, #1a56db, #60a5fa);
                }

                .card-cai-dat.accent-do::before {
                    background: linear-gradient(90deg, #dc2626, #f87171);
                }

                .card-cai-dat.accent-tim::before {
                    background: linear-gradient(90deg, #7c3aed, #a78bfa);
                }

                .card-cai-dat.accent-cam::before {
                    background: linear-gradient(90deg, #d97706, #fbbf24);
                }

                .card-cai-dat.full-width {
                    grid-column: 1 / -1;
                }

            .card-cd-header {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 20px 22px 16px;
                border-bottom: 1px solid var(--mau-vien);
            }

            .card-cd-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .icon-xanh {
                background: var(--mau-xanh-nhat);
                color: var(--mau-chu-de);
            }

            .icon-do {
                background: var(--mau-do-nhat);
                color: var(--mau-do);
            }

            .icon-tim {
                background: var(--mau-tim-nhat);
                color: #7c3aed;
            }

            .icon-cam {
                background: var(--mau-cam-nhat);
                color: var(--mau-cam);
            }

            .card-cd-header h3 {
                font-size: 15px;
                font-weight: 800;
                color: var(--mau-chu);
            }

            .card-cd-header p {
                font-size: 12px;
                color: var(--mau-chu-phu);
                margin-top: 2px;
            }

            .card-cd-body {
                padding: 22px;
            }

            /* ===================================================
                   FORM INPUT
                =================================================== */
            .nhom-truong {
                margin-bottom: 16px;
            }

            .nhan-truong {
                display: block;
                font-size: 12px;
                font-weight: 700;
                color: var(--mau-chu);
                margin-bottom: 7px;
                letter-spacing: 0.2px;
            }

            .truong-nhap {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                font-family: 'Be Vietnam Pro', sans-serif;
                font-size: 13.5px;
                font-weight: 500;
                color: var(--mau-chu);
                background: var(--mau-nen);
                transition: border-color 0.2s, box-shadow 0.2s;
                outline: none;
            }

                .truong-nhap:focus {
                    border-color: var(--mau-chu-de);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
                }

                .truong-nhap::placeholder {
                    color: #b0bec5;
                }

            /* Mật khẩu với icon mắt */
            .mat-khau-wrap {
                position: relative;
            }

                .mat-khau-wrap .truong-nhap {
                    padding-right: 44px;
                }

            .nut-mat {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: var(--mau-chu-phu);
                font-size: 15px;
                padding: 4px;
                transition: color 0.2s;
            }

                .nut-mat:hover {
                    color: var(--mau-chu-de);
                }

            .mat-khau-hint {
                margin-top: 6px;
                font-size: 11.5px;
                color: var(--mau-chu-phu);
            }

            /* Thanh độ mạnh */
            .do-manh-wrap {
                margin-top: 10px;
            }

            .do-manh-label {
                font-size: 11.5px;
                font-weight: 700;
                color: var(--mau-chu-phu);
                margin-bottom: 5px;
            }

            .do-manh-bar {
                display: flex;
                gap: 4px;
            }

            .do-manh-seg {
                flex: 1;
                height: 5px;
                border-radius: 4px;
                background: var(--mau-vien);
                transition: background 0.3s;
            }

                .do-manh-seg.yeu {
                    background: var(--mau-do);
                }

                .do-manh-seg.trung {
                    background: var(--mau-cam);
                }

                .do-manh-seg.manh {
                    background: var(--mau-xanh-la);
                }

            .divider {
                height: 1px;
                background: var(--mau-vien);
                margin: 18px 0;
            }

            /* ===================================================
                   NÚT HÀNH ĐỘNG
                =================================================== */
            .nhom-nut {
                display: flex;
                gap: 10px;
                margin-top: 6px;
            }

            .nut-chinh {
                flex: 1;
                padding: 11px 18px;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                border-radius: 10px;
                font-family: 'Be Vietnam Pro', sans-serif;
                font-size: 13.5px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 4px 14px rgba(26,86,219,0.28);
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

                .nut-chinh:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.38);
                }

                .nut-chinh:active {
                    transform: none;
                }

            .nut-phu {
                padding: 11px 18px;
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                border: 1.5px solid var(--mau-vien);
                border-radius: 10px;
                font-family: 'Be Vietnam Pro', sans-serif;
                font-size: 13.5px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .nut-phu:hover {
                    border-color: var(--mau-chu-de);
                    color: var(--mau-chu-de);
                    background: var(--mau-xanh-nhat);
                }

            .nut-dang-xuat {
                width: 100%;
                padding: 13px 18px;
                background: linear-gradient(135deg, #dc2626, #ef4444);
                color: #fff;
                border: none;
                border-radius: 12px;
                font-family: 'Be Vietnam Pro', sans-serif;
                font-size: 14px;
                font-weight: 800;
                cursor: pointer;
                box-shadow: 0 4px 16px rgba(220,38,38,0.28);
                transition: all 0.22s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                letter-spacing: 0.3px;
            }

                .nut-dang-xuat:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(220,38,38,0.38);
                }

                .nut-dang-xuat:active {
                    transform: none;
                }

            /* Cảnh báo đăng xuất */
            .canh-bao-dang-xuat {
                background: var(--mau-do-nhat);
                border: 1px solid #fca5a5;
                border-radius: 10px;
                padding: 12px 16px;
                margin-bottom: 18px;
                display: flex;
                align-items: flex-start;
                gap: 10px;
            }

                .canh-bao-dang-xuat i {
                    color: var(--mau-do);
                    font-size: 15px;
                    margin-top: 1px;
                    flex-shrink: 0;
                }

                .canh-bao-dang-xuat p {
                    font-size: 12.5px;
                    color: #991b1b;
                    font-weight: 600;
                    line-height: 1.5;
                }

            /* Toggle switch */
            .hang-toggle {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 12px 0;
                border-bottom: 1px solid var(--mau-vien);
            }

                .hang-toggle:last-child {
                    border-bottom: none;
                }

            .toggle-info h4 {
                font-size: 13.5px;
                font-weight: 700;
            }

            .toggle-info p {
                font-size: 12px;
                color: var(--mau-chu-phu);
                margin-top: 2px;
            }

            .toggle-switch {
                position: relative;
                width: 44px;
                height: 24px;
                flex-shrink: 0;
            }

                .toggle-switch input {
                    opacity: 0;
                    width: 0;
                    height: 0;
                }

            .toggle-rail {
                position: absolute;
                inset: 0;
                background: var(--mau-vien);
                border-radius: 999px;
                cursor: pointer;
                transition: background 0.3s;
            }

                .toggle-rail::before {
                    content: '';
                    position: absolute;
                    left: 3px;
                    top: 3px;
                    width: 18px;
                    height: 18px;
                    border-radius: 50%;
                    background: #fff;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
                    transition: transform 0.3s;
                }

            .toggle-switch input:checked + .toggle-rail {
                background: var(--mau-chu-de);
            }

                .toggle-switch input:checked + .toggle-rail::before {
                    transform: translateX(20px);
                }

            /* Thông báo inline */
            .thong-bao-inline {
                display: none;
                border-radius: 10px;
                padding: 11px 16px;
                margin-top: 14px;
                font-size: 13px;
                font-weight: 700;
                align-items: center;
                gap: 8px;
            }

                .thong-bao-inline.hien {
                    display: flex;
                    animation: fadeInSlide 0.3s ease;
                }

            .tb-xanh {
                background: var(--mau-xanh-la-nhat);
                border: 1px solid #6ee7b7;
                color: #065f46;
            }

            .tb-do {
                background: var(--mau-do-nhat);
                border: 1px solid #fca5a5;
                color: #991b1b;
            }

            .tb-cam {
                background: var(--mau-cam-nhat);
                border: 1px solid #fcd34d;
                color: #92400e;
            }

            @@keyframes fadeInSlide {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            /* Card thông tin hồ sơ */
            .thong-tin-hang {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 11px 0;
                border-bottom: 1px solid var(--mau-vien);
                font-size: 13px;
            }

                .thong-tin-hang:last-child {
                    border-bottom: none;
                }

                .thong-tin-hang .nhan {
                    color: var(--mau-chu-phu);
                    font-weight: 600;
                }

                .thong-tin-hang .gia-tri {
                    font-weight: 700;
                    color: var(--mau-chu);
                }

            /* Badge vai trò */
            .badge-vai-tro {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 3px 10px;
                border-radius: 9999px;
                font-size: 11px;
                font-weight: 700;
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
            }

            /* Avatar lớn */
            .avatar-lon {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                background: linear-gradient(135deg, #1a56db, #60a5fa);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 28px;
                font-weight: 800;
                border: 3px solid rgba(26,86,219,0.2);
                flex-shrink: 0;
            }

            /* ===================================================
                   MODAL XÁC NHẬN ĐĂNG XUẤT & ĐỔI MẬT KHẨU
                =================================================== */
            .lop-che-modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(4px);
            }

                .lop-che-modal.hien {
                    display: flex;
                }

            .hop-modal {
                background: #fff;
                border-radius: 20px;
                padding: 28px;
                width: 460px;
                max-width: 95vw;
                box-shadow: 0 20px 60px rgba(0,0,0,0.2);
                animation: hienModal 0.3s ease;
            }

            .hop-modal-sm {
                width: 380px;
            }

            .tieu-de-modal {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }

                .tieu-de-modal h3 {
                    font-size: 17px;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            .nut-dong-modal {
                background: none;
                border: none;
                font-size: 18px;
                cursor: pointer;
                color: var(--mau-chu-phu);
                border-radius: 50%;
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
            }

                .nut-dong-modal:hover {
                    background: var(--mau-nen);
                    color: var(--mau-chu);
                }

            .nhom-truong-nhap {
                margin-bottom: 14px;
            }

            .nhan-truong-nhap {
                display: block;
                font-size: 12px;
                font-weight: 700;
                margin-bottom: 7px;
                color: var(--mau-chu);
            }

            .nhom-nut-modal {
                display: flex;
                gap: 10px;
                justify-content: flex-end;
                margin-top: 20px;
            }

            .nut-huy {
                background: var(--mau-nen);
                color: var(--mau-chu-phu);
                border: none;
                padding: 10px 20px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 700;
                transition: all 0.2s;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-huy:hover {
                    background: var(--mau-vien);
                }

            .nut-luu {
                background: linear-gradient(135deg, var(--mau-chu-de), var(--mau-chu-de-sang));
                color: #fff;
                border: none;
                padding: 10px 24px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 700;
                box-shadow: 0 4px 12px rgba(26,86,219,0.3);
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 7px;
                font-family: 'Be Vietnam Pro', sans-serif;
            }

                .nut-luu:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(26,86,219,0.4);
                }

            /* Trường nhập trong modal (dùng chung class .truong-nhap) */
            .modal-pw-wrap {
                position: relative;
            }

                .modal-pw-wrap .truong-nhap {
                    padding-right: 44px;
                }

            .modal-pw-toggle {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: var(--mau-chu-phu);
                font-size: 14px;
                padding: 4px;
                transition: color 0.2s;
            }

                .modal-pw-toggle:hover {
                    color: var(--mau-chu-de);
                }

            @@keyframes hienModal {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            /* ===================================================
                   SCROLLBAR
                =================================================== */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 3px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* ===================================================
                   RESPONSIVE
                =================================================== */
            @@media (max-width: 900px) {
                .cai-dat-grid {
                    grid-template-columns: 1fr;
                }

                .card-cai-dat.full-width {
                    grid-column: auto;
                }
            }

            @@media (max-width: 640px) {
                #thanh-sidebar {
                    width: 0;
                    min-width: 0;
                    overflow: hidden;
                }

                    #thanh-sidebar.mo {
                        width: 220px;
                        min-width: 220px;
                    }

                #noi-dung-chinh {
                    padding: 16px;
                }
            }
    </style>
</head>
<body>

    <!-- ==================================================
     SIDEBAR  –  đồng bộ chính xác từ Manager.cshtml
================================================== -->
    <nav id="thanh-sidebar">

        <div class="logo-sidebar">
            <div class="bieu-tuong">
                <img src="~/images/LogoBaNam.png" alt="Logo Nhà Trọ Bà Năm" />
            </div>
            <div class="ten-logo">
                <strong>Nhà Trọ Bà Năm</strong>
                <span>Quản lý hệ thống</span>
            </div>
        </div>

        <div class="nhan-nhom">Tổng quan</div>
        <div class="menu-item" onclick="chuyenTrang('trang-chu', this)">
            <i class="fas fa-home"></i><span>Trang chủ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('phong-cua-toi', this)">
            <i class="fas fa-door-open"></i>
            <span>Phòng của tôi</span>
        </div>

        <div class="nhan-nhom">Quản lý</div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-phong', this)">
            <i class="fas fa-door-open"></i><span>Quản lý phòng trọ</span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('quan-ly-nguoi-thue', this)">
            <i class="fas fa-users"></i><span>Quản lý dịch vụ và tiện ích</span>
            <span class="huy-hieu-menu" id="badge-dichvu" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('hoa-don', this)">
            <i class="fas fa-file-invoice-dollar"></i><span>Hóa đơn &amp; Thu tiền</span>
        </div>

        <div class="nhan-nhom">Hỗ trợ</div>
        <div class="menu-item" onclick="chuyenTrang('su-co-bao-tri', this)">
            <i class="fas fa-tools"></i><span>Sự cố / Bảo trì</span>
            <span class="huy-hieu-menu" id="badge-suco" style="display:none"></span>
        </div>
        <div class="menu-item" onclick="chuyenTrang('thong-ke', this)">
            <i class="fas fa-chart-bar"></i><span>Thống kê &amp; Báo cáo</span>
        </div>

        <div class="menu-item dang-chon" onclick="chuyenTrang('cai-dat', this)">
            <i class="fas fa-cog"></i><span>Cài đặt hệ thống</span>
        </div>

        <div class="admin-sidebar">
            <div class="anh-admin">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="Avatar"
                         style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {

                    @initials
                }
            </div>
            <div class="ten-admin">
                <strong>@Model.TenNguoiDung</strong>
                <span>@Model.ChucVu</span>
            </div>
        </div>
    </nav>

    <!-- ==================================================
     KHU VỰC CHÍNH
================================================== -->
    <div id="khu-vuc-chinh">

        <!-- HEADER -->
        <header id="thanh-header">
            <div class="header-trai">
                <button class="nut-ham-menu" onclick="dongMoSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <div class="tieu-de-trang">Cài đặt hệ thống</div>
                    <div class="duong-dan">Trang chủ / Cài đặt</div>
                </div>
            </div>

            <div class="header-phai">
                <div class="hdr-date" id="headerDate"></div>

                <button class="nut-thong-bao">
                    <i class="fas fa-bell"></i>
                    @if (Model.SoThongBaoChuaDoc > 0)
                    {
                        <span class="so-thong-bao">@Model.SoThongBaoChuaDoc</span>
                    }
                </button>

                <!-- Admin Dropdown – đồng bộ Manager.cshtml -->
                <div class="thong-tin-admin" id="mgrHeaderWrap">
                    <button onclick="mgrToggleMenu()" id="mgrHeaderBtn"
                            style="display:flex;align-items:center;gap:10px;cursor:pointer;
                        padding:6px 12px;border-radius:24px;border:none;background:none;
                        font-family:inherit;transition:background 0.2s;"
                            onmouseover="this.style.background='var(--mau-xanh-nhat)'"
                            onmouseout="this.style.background='none'">
                        <div style="width:36px;height:36px;border-radius:50%;
                            background:linear-gradient(135deg,#1a56db,#60a5fa);
                            display:flex;align-items:center;justify-content:center;
                            color:#fff;font-size:14px;font-weight:800;">
                            @if (!string.IsNullOrEmpty(Model.Avatar))
                            {
                                <img src="@Model.Avatar" alt="Avatar"
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                            }
                            else
                            {

                                @initials
                            }
                        </div>
                        <div>
                            <div style="font-size:13px;font-weight:700;">@Model.TenNguoiDung</div>
                            <div style="font-size:11px;color:var(--mau-chu-phu);">@Model.ChucVu</div>
                        </div>
                        <i class="fas fa-chevron-down" id="mgrChevron"
                           style="font-size:11px;color:var(--mau-chu-phu);margin-left:4px;transition:transform 0.2s;"></i>
                    </button>

                    <div class="mgr-dropdown" id="mgrDropdown">
                        <div class="mgr-dd-header">
                            <div class="mgr-dd-avatar">@initials</div>
                            <div>
                                <div class="mgr-dd-name">@Model.TenNguoiDung</div>
                                <div class="mgr-dd-sub">@Model.Email</div>
                                <span class="mgr-dd-badge">
                                    <i class="fas fa-user-shield" style="font-size:8px;"></i>
                                    @Model.ChucVu
                                </span>
                            </div>
                        </div>
                        <div class="mgr-dd-body">
                            <button class="mgr-item" onclick="mgrMoDoiMatKhau()">
                                <div class="mgr-item-icon blue"><i class="fas fa-key"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đổi mật khẩu</div>
                                    <div class="mgr-item-sub">Cập nhật mật khẩu đăng nhập</div>
                                </div>
                            </button>
                            <div class="mgr-divider"></div>
                            <button class="mgr-item danger" onclick="mgrXacNhanDangXuat()">
                                <div class="mgr-item-icon red"><i class="fas fa-sign-out-alt"></i></div>
                                <div>
                                    <div class="mgr-item-label">Đăng xuất</div>
                                    <div class="mgr-item-sub">Thoát khỏi hệ thống</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH -->
        <main id="noi-dung-chinh">

            <div class="hang-tieu-de-trang">
                <div>
                    <h2>⚙️ Cài đặt hệ thống</h2>
                    <p>Quản lý bảo mật, tuỳ chỉnh tài khoản và cấu hình hệ thống</p>
                </div>
            </div>

            <!-- CSRF token dùng chung cho tất cả fetch POST -->
            @Html.AntiForgeryToken()

            <div class="cai-dat-grid">

                <!-- ================================================
           CARD 1: ĐỔI MẬT KHẨU
      ================================================ -->
                <div class="card-cai-dat accent-xanh">
                    <div class="card-cd-header">
                        <div class="card-cd-icon icon-xanh"><i class="fas fa-lock"></i></div>
                        <div>
                            <h3>Đổi mật khẩu</h3>
                            <p>Cập nhật mật khẩu đăng nhập của bạn</p>
                        </div>
                    </div>
                    <div class="card-cd-body">

                        <!-- Mật khẩu hiện tại -->
                        <div class="nhom-truong">
                            <label class="nhan-truong">Mật khẩu hiện tại</label>
                            <div class="mat-khau-wrap">
                                <input class="truong-nhap" type="password" id="card-mk-hien-tai"
                                       placeholder="Nhập mật khẩu hiện tại..." />
                                <button class="nut-mat" type="button"
                                        onclick="batTatMat('card-mk-hien-tai', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="nhom-truong">
                            <label class="nhan-truong">Mật khẩu mới</label>
                            <div class="mat-khau-wrap">
                                <input class="truong-nhap" type="password" id="card-mk-moi"
                                       placeholder="Nhập mật khẩu mới..."
                                       oninput="kiemTraDoManh(this.value, 'card')" />
                                <button class="nut-mat" type="button"
                                        onclick="batTatMat('card-mk-moi', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mat-khau-hint">Ít nhất 6 ký tự, nên có chữ hoa, số và ký tự đặc biệt.</div>
                            <div class="do-manh-wrap" id="card-thanh-do-manh" style="display:none;">
                                <div class="do-manh-label" id="card-nhan-do-manh">Độ mạnh: —</div>
                                <div class="do-manh-bar">
                                    <div class="do-manh-seg" id="card-seg1"></div>
                                    <div class="do-manh-seg" id="card-seg2"></div>
                                    <div class="do-manh-seg" id="card-seg3"></div>
                                    <div class="do-manh-seg" id="card-seg4"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="nhom-truong">
                            <label class="nhan-truong">Xác nhận mật khẩu mới</label>
                            <div class="mat-khau-wrap">
                                <input class="truong-nhap" type="password" id="card-mk-xac-nhan"
                                       placeholder="Nhập lại mật khẩu mới..." />
                                <button class="nut-mat" type="button"
                                        onclick="batTatMat('card-mk-xac-nhan', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="nhom-nut">
                            <button class="nut-phu" type="button" onclick="xoaFormMatKhau('card')">
                                <i class="fas fa-times"></i> Hủy
                            </button>
                            <button class="nut-chinh" type="button" onclick="luuMatKhau('card')">
                                <i class="fas fa-shield-alt"></i> Cập nhật mật khẩu
                            </button>
                        </div>

                        <div class="thong-bao-inline tb-xanh" id="card-tb-mk">
                            <i class="fas fa-check-circle"></i>
                            <span id="card-tb-mk-msg">Mật khẩu đã được cập nhật!</span>
                        </div>

                    </div>
                </div>

                <!-- ================================================
           CARD 2: BẢO MẬT & QUYỀN RIÊNG TƯ
      ================================================ -->
                <div class="card-cai-dat accent-tim">
                    <div class="card-cd-header">
                        <div class="card-cd-icon icon-tim"><i class="fas fa-shield-alt"></i></div>
                        <div>
                            <h3>Bảo mật &amp; Quyền riêng tư</h3>
                            <p>Tuỳ chỉnh cài đặt bảo mật tài khoản</p>
                        </div>
                    </div>
                    <div class="card-cd-body">

                        <div class="hang-toggle">
                            <div class="toggle-info">
                                <h4>Xác thực 2 bước</h4>
                                <p>Yêu cầu mã OTP khi đăng nhập từ thiết bị mới</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="toggle-2fa" />
                                <span class="toggle-rail"></span>
                            </label>
                        </div>

                        <div class="hang-toggle">
                            <div class="toggle-info">
                                <h4>Thông báo đăng nhập</h4>
                                <p>Gửi email khi phát hiện đăng nhập bất thường</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="toggle-login-notif" checked />
                                <span class="toggle-rail"></span>
                            </label>
                        </div>

                        <div class="hang-toggle">
                            <div class="toggle-info">
                                <h4>Nhắc nhở hóa đơn quá hạn</h4>
                                <p>Thông báo khi có hóa đơn chưa được duyệt</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="toggle-hoadon" checked />
                                <span class="toggle-rail"></span>
                            </label>
                        </div>

                        <div class="hang-toggle">
                            <div class="toggle-info">
                                <h4>Cảnh báo sự cố khẩn cấp</h4>
                                <p>Nhận thông báo ngay khi có sự cố mức độ cao</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="toggle-suco" checked />
                                <span class="toggle-rail"></span>
                            </label>
                        </div>

                        <div class="hang-toggle">
                            <div class="toggle-info">
                                <h4>Báo cáo doanh thu tự động</h4>
                                <p>Gửi tổng kết doanh thu vào cuối mỗi tháng</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="toggle-baocao" />
                                <span class="toggle-rail"></span>
                            </label>
                        </div>

                        <div style="margin-top:18px;">
                            <button class="nut-chinh" type="button" onclick="luuBaoMat()" style="width:100%;">
                                <i class="fas fa-save"></i> Lưu cài đặt bảo mật
                            </button>
                            <div class="thong-bao-inline tb-cam" id="tb-bao-mat" style="margin-top:12px;">
                                <i class="fas fa-info-circle"></i>
                                <span>Tính năng đang được phát triển!</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ================================================
           CARD 3: THÔNG TIN TÀI KHOẢN (full width)
      ================================================ -->
                <div class="card-cai-dat accent-cam full-width">
                    <div class="card-cd-header">
                        <div class="card-cd-icon icon-cam"><i class="fas fa-user-cog"></i></div>
                        <div>
                            <h3>Thông tin tài khoản</h3>
                            <p>Thông tin hồ sơ và phiên đăng nhập hiện tại của bạn</p>
                        </div>
                    </div>
                    <div class="card-cd-body">
                        <div style="display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap;">

                            <!-- Avatar + tên -->
                            <div style="display:flex;flex-direction:column;align-items:center;gap:10px;min-width:120px;">
                                <div class="avatar-lon">@initials</div>
                                <span class="badge-vai-tro">
                                    <i class="fas fa-user-shield" style="font-size:9px;"></i>
                                    @Model.ChucVu
                                </span>
                            </div>

                            <!-- Chi tiết -->
                            <div style="flex:1;min-width:260px;">
                                <div class="thong-tin-hang">
                                    <span class="nhan"><i class="fas fa-user" style="width:16px;margin-right:6px;"></i>Họ và tên</span>
                                    <span class="gia-tri">@Model.TenNguoiDung</span>
                                </div>
                                <div class="thong-tin-hang">
                                    <span class="nhan"><i class="fas fa-envelope" style="width:16px;margin-right:6px;"></i>Email</span>
                                    <span class="gia-tri">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</span>
                                </div>
                                <div class="thong-tin-hang">
                                    <span class="nhan"><i class="fas fa-desktop" style="width:16px;margin-right:6px;"></i>Thiết bị</span>
                                    <span class="gia-tri">Trình duyệt Web</span>
                                </div>
                                <div class="thong-tin-hang">
                                    <span class="nhan"><i class="fas fa-clock" style="width:16px;margin-right:6px;"></i>Đăng nhập lúc</span>
                                    <span class="gia-tri" id="gio-dang-nhap">--:--</span>
                                </div>
                                <div class="thong-tin-hang">
                                    <span class="nhan"><i class="fas fa-bell" style="width:16px;margin-right:6px;"></i>Thông báo chưa đọc</span>
                                    <span class="gia-tri" style="color:var(--mau-do);font-weight:800;">
                                        @Model.SoThongBaoChuaDoc thông báo
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ================================================
           CARD 4: ĐĂNG XUẤT (full width)
      ================================================ -->
                <div class="card-cai-dat accent-do full-width">
                    <div class="card-cd-header">
                        <div class="card-cd-icon icon-do"><i class="fas fa-sign-out-alt"></i></div>
                        <div>
                            <h3>Đăng xuất tài khoản</h3>
                            <p>Kết thúc phiên quản lý hiện tại của bạn</p>
                        </div>
                    </div>
                    <div class="card-cd-body">

                        <div class="canh-bao-dang-xuat">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>Khi đăng xuất, phiên quản lý sẽ kết thúc. Tất cả thay đổi chưa lưu sẽ bị mất. Đảm bảo bạn đã lưu mọi công việc trước khi thoát.</p>
                        </div>

                        <div style="display:flex;gap:16px;margin-bottom:20px;flex-wrap:wrap;">
                            <div style="flex:1;min-width:180px;background:var(--mau-nen);border:1px solid var(--mau-vien);border-radius:10px;padding:12px 16px;">
                                <div style="font-size:11px;color:var(--mau-chu-phu);font-weight:700;margin-bottom:4px;">THIẾT BỊ</div>
                                <div style="font-size:13px;font-weight:700;">
                                    <i class="fas fa-desktop" style="color:var(--mau-chu-de);margin-right:6px;"></i>Trình duyệt Web
                                </div>
                            </div>
                            <div style="flex:1;min-width:180px;background:var(--mau-nen);border:1px solid var(--mau-vien);border-radius:10px;padding:12px 16px;">
                                <div style="font-size:11px;color:var(--mau-chu-phu);font-weight:700;margin-bottom:4px;">ĐĂNG NHẬP LÚC</div>
                                <div style="font-size:13px;font-weight:700;">
                                    <i class="fas fa-clock" style="color:var(--mau-cam);margin-right:6px;"></i>
                                    <span id="gio-dang-nhap-card">--:--</span>
                                </div>
                            </div>
                            <div style="flex:1;min-width:180px;background:var(--mau-nen);border:1px solid var(--mau-vien);border-radius:10px;padding:12px 16px;">
                                <div style="font-size:11px;color:var(--mau-chu-phu);font-weight:700;margin-bottom:4px;">TÀI KHOẢN</div>
                                <div style="font-size:13px;font-weight:700;">
                                    <i class="fas fa-user-shield" style="color:var(--mau-xanh-la);margin-right:6px;"></i>
                                    @Model.TenNguoiDung
                                </div>
                            </div>
                        </div>

                        <button class="nut-dang-xuat" type="button" onclick="xacNhanDangXuat()">
                            <i class="fas fa-sign-out-alt"></i>
                            Đăng xuất khỏi hệ thống quản lý
                        </button>

                    </div>
                </div>

            </div><!-- /cai-dat-grid -->
        </main>
    </div><!-- /khu-vuc-chinh -->
    <!-- ==================================================
     MODAL: ĐỔI MẬT KHẨU  (từ Header Dropdown)
================================================== -->
    <div class="lop-che-modal" id="modal-doi-mat-khau"
         onclick="dongModalNeuNhanNgoai(event,'modal-doi-mat-khau')">
        <div class="hop-modal">
            <div class="tieu-de-modal">
                <h3><i class="fas fa-key" style="color:var(--mau-chu-de);"></i> Đổi mật khẩu</h3>
                <button class="nut-dong-modal" type="button"
                        onclick="dongModal('modal-doi-mat-khau')">
                    ✕
                </button>
            </div>

            <!-- Mật khẩu hiện tại -->
            <div class="nhom-truong-nhap">
                <label class="nhan-truong-nhap">Mật khẩu hiện tại *</label>
                <div class="modal-pw-wrap">
                    <input class="truong-nhap" type="password" id="modal-mk-hien-tai"
                           placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                    <button type="button" class="modal-pw-toggle"
                            onclick="batTatMat('modal-mk-hien-tai', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Mật khẩu mới -->
            <div class="nhom-truong-nhap">
                <label class="nhan-truong-nhap">Mật khẩu mới *</label>
                <div class="modal-pw-wrap">
                    <input class="truong-nhap" type="password" id="modal-mk-moi"
                           placeholder="Tối thiểu 6 ký tự"
                           autocomplete="new-password"
                           oninput="kiemTraDoManh(this.value, 'modal')" />
                    <button type="button" class="modal-pw-toggle"
                            onclick="batTatMat('modal-mk-moi', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <div class="do-manh-wrap" id="modal-thanh-do-manh" style="display:none;margin-top:8px;">
                    <div class="do-manh-label" id="modal-nhan-do-manh">Độ mạnh: —</div>
                    <div class="do-manh-bar">
                        <div class="do-manh-seg" id="modal-seg1"></div>
                        <div class="do-manh-seg" id="modal-seg2"></div>
                        <div class="do-manh-seg" id="modal-seg3"></div>
                        <div class="do-manh-seg" id="modal-seg4"></div>
                    </div>
                </div>
            </div>

            <!-- Xác nhận mật khẩu -->
            <div class="nhom-truong-nhap">
                <label class="nhan-truong-nhap">Xác nhận mật khẩu mới *</label>
                <div class="modal-pw-wrap">
                    <input class="truong-nhap" type="password" id="modal-mk-xac-nhan"
                           placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="modal-pw-toggle"
                            onclick="batTatMat('modal-mk-xac-nhan', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="thong-bao-inline tb-xanh" id="modal-tb-mk" style="margin-bottom:4px;">
                <i class="fas fa-check-circle"></i>
                <span id="modal-tb-mk-msg"></span>
            </div>

            <div class="nhom-nut-modal">
                <button type="button" class="nut-huy"
                        onclick="dongModal('modal-doi-mat-khau')">
                    Hủy
                </button>
                <button type="button" class="nut-luu" id="btn-modal-luu"
                        onclick="luuMatKhau('modal')">
                    <i class="fas fa-save"></i> Cập nhật
                </button>
            </div>
        </div>
    </div>

    <!-- ==================================================
     MODAL: XÁC NHẬN ĐĂNG XUẤT
================================================== -->
    <div class="lop-che-modal" id="modal-dang-xuat"
         onclick="dongModalNeuNhanNgoai(event,'modal-dang-xuat')">
        <div class="hop-modal hop-modal-sm">
            <div style="text-align:center;margin-bottom:24px;">
                <div style="width:64px;height:64px;border-radius:50%;background:#fee2e2;
                    display:flex;align-items:center;justify-content:center;
                    margin:0 auto 16px;font-size:28px;color:#dc2626;">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;">Xác nhận đăng xuất</h3>
                <p style="font-size:13.5px;color:var(--mau-chu-phu);line-height:1.6;">
                    Bạn có chắc muốn đăng xuất khỏi tài khoản
                    <strong>@Model.TenNguoiDung</strong> không?
                </p>
            </div>
            <div style="display:flex;gap:12px;">
                <button onclick="dongModal('modal-dang-xuat')"
                        style="flex:1;padding:12px;background:var(--mau-nen);border:1.5px solid var(--mau-vien);
                    border-radius:10px;font-family:'Be Vietnam Pro',sans-serif;
                    font-size:14px;font-weight:700;cursor:pointer;color:var(--mau-chu-phu);transition:all 0.2s;"
                        onmouseover="this.style.borderColor='var(--mau-chu-de)';this.style.color='var(--mau-chu-de)'"
                        onmouseout="this.style.borderColor='var(--mau-vien)';this.style.color='var(--mau-chu-phu)'">
                    <i class="fas fa-times" style="margin-right:6px;"></i>Hủy bỏ
                </button>
                <button onclick="thucHienDangXuat()"
                        style="flex:1;padding:12px;background:linear-gradient(135deg,#dc2626,#ef4444);
                    color:#fff;border:none;border-radius:10px;
                    font-family:'Be Vietnam Pro',sans-serif;
                    font-size:14px;font-weight:800;cursor:pointer;
                    box-shadow:0 4px 14px rgba(220,38,38,0.3);transition:all 0.2s;"
                        onmouseover="this.style.transform='translateY(-2px)'"
                        onmouseout="this.style.transform='none'">
                    <i class="fas fa-sign-out-alt" style="margin-right:6px;"></i>Đăng xuất
                </button>
            </div>
        </div>
    </div>

    <style>
            @@keyframes hienModal {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }
    </style>


    <!-- ==================================================
     JAVASCRIPT
================================================== -->
    <script>
            /* ============================================================
               TIỆN ÍCH CHUNG
            ============================================================ */

            // Ngày giờ header
            function capNhatNgayGio() {
              const days = ['CN','T2','T3','T4','T5','T6','T7'];
              const now  = new Date();
              const dd   = String(now.getDate()).padStart(2,'0');
              const mm   = String(now.getMonth()+1).padStart(2,'0');
              document.getElementById('headerDate').textContent =
                `${days[now.getDay()]}, ${dd}/${mm}/${now.getFullYear()}`;

              const hh = String(now.getHours()).padStart(2,'0');
              const mn = String(now.getMinutes()).padStart(2,'0');
              const tStr = `${hh}:${mn} hôm nay`;
              const el1 = document.getElementById('gio-dang-nhap');
              const el2 = document.getElementById('gio-dang-nhap-card');
              if (el1) el1.textContent = tStr;
              if (el2) el2.textContent = tStr;
            }
            capNhatNgayGio();

            // Toggle sidebar
            function dongMoSidebar() {
              document.getElementById('thanh-sidebar').classList.toggle('an-sidebar');
            }

            // Điều hướng menu
            function chuyenTrang(ten, el) {
              document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('dang-chon'));
              el.classList.add('dang-chon');
              const bang = {
                'trang-chu':          '/Manager/Manager',
                'quan-ly-phong':      '/Manager/ChiTietPhong',
                'quan-ly-nguoi-thue': '/Manager/QuanLyDichVu',
                'hoa-don':            '/Manager/HoaDon',
                'su-co-bao-tri':      '/Manager/SuCoBaoTri',
                'thong-ke':            '/Manager/ThongKe',
                'cai-dat':            '/Manager/CaiDat',
                'phong-cua-toi':   '/KhachThue/KhachThue',
              };
              if (bang[ten]) window.location.href = bang[ten];
            }

            // Modal helpers
            function dongModal(id) {
              document.getElementById(id).classList.remove('hien');
            }
            function dongModalNeuNhanNgoai(e, id) {
              if (e.target.id === id) dongModal(id);
            }


            /* ============================================================
               ADMIN HEADER DROPDOWN
            ============================================================ */
            function mgrToggleMenu() {
              const dd  = document.getElementById('mgrDropdown');
              const chv = document.getElementById('mgrChevron');
              dd.classList.toggle('show');
              chv.style.transform = dd.classList.contains('show') ? 'rotate(180deg)' : '';
            }

            // Đóng dropdown khi click bên ngoài
            document.addEventListener('click', e => {
              const wrap = document.getElementById('mgrHeaderWrap');
              if (wrap && !wrap.contains(e.target)) {
                const dd = document.getElementById('mgrDropdown');
                dd.classList.remove('show');
                document.getElementById('mgrChevron').style.transform = '';
              }
            });

            // Mở modal đổi mật khẩu từ dropdown
            function mgrMoDoiMatKhau() {
              document.getElementById('mgrDropdown').classList.remove('show');
              document.getElementById('modal-doi-mat-khau').classList.add('hien');
              // Reset form
              xoaFormMatKhau('modal');
            }

            // Đăng xuất từ dropdown
            function mgrXacNhanDangXuat() {
              document.getElementById('mgrDropdown').classList.remove('show');
              xacNhanDangXuat();
            }


            /* ============================================================
               ĐỔI MẬT KHẨU  –  dùng chung cho card và modal
               prefix = 'card' | 'modal'
            ============================================================ */

            // Toggle hiện/ẩn mật khẩu
            function batTatMat(inputId, btn) {
              const inp  = document.getElementById(inputId);
              const icon = btn.querySelector('i');
              if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
              } else {
                inp.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
              }
            }

            // Kiểm tra độ mạnh mật khẩu – hỗ trợ cả 'card' và 'modal'
            function kiemTraDoManh(val, prefix) {
              const thanh = document.getElementById(`${prefix}-thanh-do-manh`);
              const nhan  = document.getElementById(`${prefix}-nhan-do-manh`);
              const segs  = [1,2,3,4].map(i => document.getElementById(`${prefix}-seg${i}`));

              if (!val) { thanh.style.display = 'none'; return; }
              thanh.style.display = 'block';

              let diem = 0;
              if (val.length >= 6)           diem++;
              if (/[A-Z]/.test(val))        diem++;
              if (/[0-9]/.test(val))        diem++;
              if (/[^A-Za-z0-9]/.test(val)) diem++;

              const cls  = ['','yeu','yeu','trung','manh'];
              const ten  = ['','Yếu','Yếu','Trung bình','Mạnh'];
              const mauTen = ['','#dc2626','#dc2626','#d97706','#059669'];

              segs.forEach((s, i) => {
                s.className = 'do-manh-seg';
                if (i < diem) s.classList.add(cls[diem]);
              });
              nhan.textContent = `Độ mạnh: ${ten[diem]}`;
              nhan.style.color = mauTen[diem];
            }

            // Lưu mật khẩu qua AJAX – dùng chung bởi card và modal
            async function luuMatKhau(prefix) {
              const ids = {
                hienTai:  `${prefix}-mk-hien-tai`,
                moi:      `${prefix}-mk-moi`,
                xacNhan:  `${prefix}-mk-xac-nhan`,
                tb:       `${prefix}-tb-mk`,
                tbMsg:    `${prefix}-tb-mk-msg`,
              };

              const hienTai = document.getElementById(ids.hienTai).value;
              const moi     = document.getElementById(ids.moi).value;
              const xacNhan = document.getElementById(ids.xacNhan).value;

              // Validate phía client
              if (!hienTai) {
                hienThongBao(ids.tb, ids.tbMsg, 'Vui lòng nhập mật khẩu hiện tại!', 'loi');
                return;
              }
              if (moi.length < 6) {
                hienThongBao(ids.tb, ids.tbMsg, 'Mật khẩu mới phải có ít nhất 6 ký tự!', 'loi');
                return;
              }
              if (moi !== xacNhan) {
                hienThongBao(ids.tb, ids.tbMsg, 'Mật khẩu xác nhận không khớp!', 'loi');
                return;
              }

              // Lấy CSRF token
              const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

              const formData = new FormData();
              formData.append('MatKhauHienTai', hienTai);
              formData.append('MatKhauMoi',     moi);
              formData.append('MatKhauXacNhan', xacNhan);
              if (token) formData.append('__RequestVerificationToken', token);

              // Vô hiệu hóa nút trong lúc chờ
              const btnId = prefix === 'card' ? null : 'btn-modal-luu';
              const btn   = btnId ? document.getElementById(btnId) : null;
              if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...'; }

              try {
                const res  = await fetch('/Manager/CaiDat?handler=DoiMatKhau', {
                  method: 'POST',
                  body:   formData,
                });
                const data = await res.json();

                if (data.success) {
                  hienThongBao(ids.tb, ids.tbMsg, data.message, 'ok');
                  xoaFormMatKhau(prefix);
                  // Đóng modal nếu đang ở modal
                  if (prefix === 'modal') {
                    setTimeout(() => dongModal('modal-doi-mat-khau'), 2000);
                  }
                } else {
                  hienThongBao(ids.tb, ids.tbMsg, data.message, 'loi');
                }
              } catch {
                hienThongBao(ids.tb, ids.tbMsg, 'Có lỗi kết nối, vui lòng thử lại!', 'loi');
              } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Cập nhật'; }
              }
            }

            // Hiển thị thông báo inline
            function hienThongBao(tbId, msgId, msg, loai) {
              const tb  = document.getElementById(tbId);
              const msgEl = document.getElementById(msgId);
              if (!tb || !msgEl) return;

              // Reset classes
              tb.classList.remove('tb-xanh','tb-do','tb-cam');
              if      (loai === 'ok')  { tb.classList.add('tb-xanh'); tb.querySelector('i').className = 'fas fa-check-circle'; }
              else if (loai === 'loi') { tb.classList.add('tb-do');   tb.querySelector('i').className = 'fas fa-times-circle'; }
              else                     { tb.classList.add('tb-cam');  tb.querySelector('i').className = 'fas fa-info-circle'; }

              msgEl.textContent = msg;
              tb.classList.add('hien');
              setTimeout(() => tb.classList.remove('hien'), 4500);
            }

            // Xoá form mật khẩu sau khi cập nhật
            function xoaFormMatKhau(prefix) {
              ['hien-tai','moi','xac-nhan'].forEach(suf => {
                const inp = document.getElementById(`${prefix}-mk-${suf}`);
                if (!inp) return;
                inp.value = '';
                inp.type  = 'password';
                // Reset icon mắt
                const iconBtn = inp.parentElement.querySelector('i');
                if (iconBtn) iconBtn.className = 'fas fa-eye';
              });
              // Ẩn thanh độ mạnh
              const thanh = document.getElementById(`${prefix}-thanh-do-manh`);
              if (thanh) thanh.style.display = 'none';
            }


            /* ============================================================
               BẢO MẬT TOGGLES
            ============================================================ */
            function luuBaoMat() {
              const tb  = document.getElementById('tb-bao-mat');
              const msg = tb.querySelector('span');
              if (msg) msg.textContent = 'Tính năng đang được phát triển!';
              tb.classList.add('hien');
              setTimeout(() => tb.classList.remove('hien'), 3500);
            }


            /* ============================================================
               ĐĂNG XUẤT
            ============================================================ */
            function xacNhanDangXuat() {
              document.getElementById('modal-dang-xuat').classList.add('hien');
            }
            function thucHienDangXuat() {
              // Thực tế: gọi endpoint logout xóa cookie/session
              window.location.href = '/Index';
            }

            // ===== ĐỒNG BỘ BADGE SIDEBAR =====
            (async function loadBadgeSidebar() {
              try {
                const res = await fetch('/Api/BadgeCounts');
                if (!res.ok) return;
                const data = await res.json();
                const badgeDV = document.getElementById('badge-dichvu');
                const badgeSC = document.getElementById('badge-suco');
                if (badgeDV) { badgeDV.textContent = data.dichVuMoi; badgeDV.style.display = data.dichVuMoi > 0 ? 'inline' : 'none'; }
                if (badgeSC) { badgeSC.textContent = data.suCoChoXuLy; badgeSC.style.display = data.suCoChoXuLy > 0 ? 'inline' : 'none'; }
              } catch (e) { console.warn('Không thể load badge sidebar:', e); }
            })();
    </script>

</body>
</html>
